-- Everything below was read from the game's own client code; the server is not visible, so distance / timing rules are
-- the ones the client enforces. Each feature is one toggle; trips take the lock above and pause the egg meanwhile.
local TapSeq = 0
local function Tap()
    if not TapEvent then return end
    TapSeq += 1
    TapEvent:FireServer({ Auto = false, ClientSequence = TapSeq })
end

-- runs fn(alive) in a loop while the toggle is on; fn is called again every `every` seconds
local function LoopToggle(name, every, fn)
    local token = 0
    Main:CreateToggle({
        Name = name,
        CurrentValue = false,
        Callback = function(Value)
            token += 1
            local my = token
            if not Value then return end
            task.spawn(function()
                local function alive() return my == token and not Killed end
                while alive() do
                    local ok, err = pcall(fn, alive)
                    if not ok then warn("[" .. name .. "] " .. tostring(err)) Status(name .. " error: " .. tostring(err)) end
                    if alive() then task.wait(every) end
                end
            end)
        end,
    })
end

-- a trip: lock + pause the egg + come back to where you were (island first, then the exact spot).
-- While the egg opener is on, "home" is always the egg itself (see the egg keeper below).
local EggHome = nil -- { island = ..., pos = Vector3 }
local function GoHome(island, pos)
    if EggWanted and EggHome then island, pos = EggHome.island, EggHome.pos end
    if island and CurrentIsland() ~= island then TravelTo(island) end
    if pos then TeleportTo(pos + Vector3.new(0, 1, 0), 0.4) end
end

local function Trip(who, body)
    Status(who .. ": starting trip")
    if not Acquire(who) then return end
    HoldEgg(true)
    local hrp = GetHrp()
    local home, homeIsland = hrp and hrp.Position, CurrentIsland()
    local ok, err = pcall(body)
    if not ok then warn("[" .. who .. "] " .. tostring(err)) Status(who .. " error: " .. tostring(err)) end
    Status(who .. ": going back to " .. tostring(homeIsland))
    GoHome(homeIsland, home)
    HoldEgg(false)
    Release(who)
    Status(who .. ": done")
end

-- ── egg keeper: the Void egg is on Shadow Realm (LaunchEggConfig.Void.Island); if you are on another island or more
-- than 25 studs from it, or the server answers "TooFar", travel there and stand in front of the egg ──
local function EggIsland()
    local cfg = LaunchEggConfig and LaunchEggConfig[EGG]
    return (cfg and (cfg.Island or (cfg.Zone ~= "Spawn" and nil))) or "Spawn"
end

local function EggModel()
    local eggs = workspace:FindFirstChild("Eggs")
    return eggs and eggs:FindFirstChild(EGG)
end

local function EggStandPos(m)
    local cf = m:GetPivot()
    return cf.Position + cf.LookVector * 7 + Vector3.new(0, 2, 0)
end

local function GoToEgg()
    Status("egg: going to the " .. EGG .. " egg on " .. EggIsland())
    if not TravelTo(EggIsland()) then return false end
    local m = WaitFor(EggModel, 15)
    if not m then Status("egg: workspace.Eggs." .. EGG .. " not found on " .. tostring(CurrentIsland())) return false end
    local pos = EggStandPos(m)
    TeleportTo(pos, 0.8)
    EggHome = { island = CurrentIsland(), pos = pos }
    EggTooFar = false
    Status("egg: at the " .. EGG .. " egg")
    return true
end

task.spawn(function()
    while not Killed do
        task.wait(1)
        if EggWanted and BusyBy == nil then
            local m = EggModel()
            local hrp = GetHrp()
            local far = EggTooFar or CurrentIsland() ~= EggIsland() or not m
                or (hrp and (hrp.Position - EggStandPos(m)).Magnitude > 25)
            if far and Acquire("egg", 5) then
                HoldEgg(true)
                pcall(GoToEgg)
                HoldEgg(false)
                Release("egg")
                task.wait(2)
            end
        end
    end
end)

-- ── breakables: Void Crystal, Crystal Cluster, Glow Mushroom, ... (HoneyPot ingredients) ──
-- Breakables are hit by ordinary taps while you stand within TapRange (14 studs) of their edge. Your own island
-- breakable spawns when you come within 100 studs of its spot (workspace.IslandBreakableSpots has one Vector3
-- attribute per spot) and it is off cooldown (Data.IslandBreakables[spot] = ready time). It hops away when hit.
local IslandBreakableConfig = Req({ "Shared", "Game", "IslandBreakableConfig" })
local SPOT_ORDER = { "ShadowRelm", "CrystalCave", "Mushroom", "Desert", "Autumn", "SkyIsland" } -- Void Crystal first

local function SpotCfg(id)
    local spots = IslandBreakableConfig and IslandBreakableConfig.Spots
    if type(spots) ~= "table" then return nil end
    if type(spots[id]) == "table" then return spots[id] end
    for _, v in pairs(spots) do if type(v) == "table" and v.Id == id then return v end end
    return nil
end

local function BreakableUsable(m)
    if not (m:IsA("Model") and m:GetAttribute("BreakableBroken") ~= true and m:GetAttribute("BreakableDespawned") ~= true) then return false end
    local owner = m:GetAttribute("BreakableOwner")
    if owner ~= nil and owner ~= LocalPlayer.UserId then return false end
    return (m:GetAttribute("BreakableHealth") or 0) > 0
end

local function FindBreakable(typeMatch)
    for _, m in ipairs(CollectionService:GetTagged("Breakable")) do
        local t = m:GetAttribute("BreakableType")
        if type(t) == "string" and typeMatch(t) and BreakableUsable(m) then return m end
    end
    return nil
end

-- stands next to the breakable and taps it until it is gone; returns true when broken
local function BreakIt(m, alive)
    local t0 = os.clock()
    while alive() and m.Parent and os.clock() - t0 < 120 do
        if m:GetAttribute("BreakableBroken") == true or (m:GetAttribute("BreakableHealth") or 0) <= 0 then return true end
        local rest, size = m:GetAttribute("BreakableRest"), m:GetAttribute("BreakableSize")
        local hrp = GetHrp()
        if typeof(rest) == "CFrame" and typeof(size) == "Vector3" and hrp then
            local d = (hrp.Position - rest.Position) * Vector3.new(1, 0, 1)
            local horiz = math.max(d.Magnitude - math.max(size.X, size.Z) * 0.5, 0)
            local vert = math.abs(hrp.Position.Y - (rest.Position.Y - size.Y * 0.5))
            if horiz > 10 or vert > 10 then
                TeleportTo(rest.Position + Vector3.new(0, size.Y * 0.5 + 2, 0) + rest.LookVector * (math.max(size.X, size.Z) * 0.5 + 5), 0.25)
            end
            Tap()
        end
        task.wait(0.11) -- GameConfig.ClickFxInterval; server HitInterval 0.1
    end
    return false
end

LoopToggle("Auto Breakables (Void Crystal, clusters, mushrooms...)", 3, function(alive)
    local data = GetData()
    if not (data and IslandBreakableConfig) then Status("Breakables: config / data not ready") return end
    local spotsFolder = workspace:FindFirstChild("IslandBreakableSpots")
    local anyReady = false
    for _, id in ipairs(SPOT_ORDER) do
        if not alive() then return end
        local cfg = SpotCfg(id)
        local pos = spotsFolder and spotsFolder:GetAttribute(id)
        if cfg and (typeof(pos) == "Vector3" or (cfg.Island and CurrentIsland() ~= cfg.Island)) then
            local unlocked = true
            pcall(function() unlocked = IslandBreakableConfig.IsUnlocked(data, cfg) end)
            local ready = 0
            pcall(function() ready = IslandBreakableConfig.GetReadyAt(data, id) end)
            if unlocked and (ready or 0) <= Now() then
                anyReady = true
                Trip("breakable", function()
                    if not TravelTo(cfg.Island) then return end
                    local sf = WaitFor(function() return workspace:FindFirstChild("IslandBreakableSpots") end, 10)
                    pos = (sf and sf:GetAttribute(id)) or pos
                    if typeof(pos) ~= "Vector3" then warn("[Breakable] " .. id .. ": spot position not published yet") return end
                    TeleportTo(pos + Vector3.new(0, 4, 0), 0.5)
                    local m
                    for _ = 1, 40 do -- the server spawns your instance once you are near the spot
                        m = FindBreakable(function(t) return t == cfg.Type end)
                        if m or not alive() then break end
                        task.wait(0.25)
                    end
                    if m then
                        if BreakIt(m, alive) then print("[Breakable] broke " .. tostring(m:GetAttribute("BreakableTitle") or id)) end
                        task.wait(1.5)
                    else
                        warn("[Breakable] " .. id .. ": no breakable appeared (island locked or still on cooldown?)")
                    end
                end)
            end
        end
    end
    if not anyReady then Status("Breakables: all on cooldown or locked") end
end)

-- ── dig site (Autumn) ──
-- DigService.RF.Begin() -> session { Id, Round = { Epoch, Phase, Speed, Width, Center, Sequence }, Remaining, ... }
-- then Hit(Id, Round.Sequence, serverTime) when DigConfig.IsHit(round, serverTime); 10 digs per hour.
local DigConfig = Req({ "Shared", "Minigames", "DigConfig" })
local DigWorld = Req({ "Shared", "Minigames", "DigWorld" })

-- The game's own DigController:Activate() does Begin / Hit with the right timing (and draws the bar), so we just stand
-- in the zone and call it whenever the cursor is inside the target. It answers { Error = "Busy" | "TooSoon" | ... }.
local DigController, DigRewardPopup
pcall(function() DigController = require(ReplicatedStorage.Controllers.Minigames.DigController) end)

LoopToggle("Auto Dig Site", 5, function(alive)
    local data = GetData()
    if not (data and DigConfig and DigController) then warn("[Dig] DigConfig / DigController not found") return end
    local left, waitFor = 0, 0
    pcall(function() left, waitFor = DigConfig.Allowance(data.Digging or {}, os.time()) end)
    if (left or 0) <= 0 then Status(string.format("Dig: no digs left, %d min until reset", math.ceil((waitFor or 0) / 60))) return end
    Trip("dig", function()
        if not TravelTo("Autumn") then return end
        local zone = WaitFor(function()
            local site
            pcall(function() site = DigWorld and DigWorld.GetSite() end)
            local autumn = Island("Autumn")
            site = site or (autumn and autumn:FindFirstChild("Digsite"))
            return site and site:FindFirstChild("DigZone")
        end, 15)
        if not zone then warn("[Dig] dig site not found on Autumn") return end
        TeleportTo(zone.Position + Vector3.new(0, 2, 0), 0.8)
        local lastWhy, idle = nil, 0
        while alive() do
            local l = 0
            pcall(function() l = DigConfig.Allowance((GetData() or data).Digging or {}, os.time()) end)
            if (l or 0) <= 0 then print("[Dig] out of digs for this hour") break end
            local s = DigController:GetState()
            local fire = true
            if type(s) == "table" and type(s.Round) == "table" then
                -- "perfect" = cursor within the inner 40 % of the target (DigController uses Width * 0.4 / 2);
                -- the hit time is passed to the server, so this is exact, not latency-dependent
                local now = Now()
                local r = s.Round
                local ok, d = pcall(function() return math.abs(DigConfig.Cursor(r, now) - r.Center) end)
                fire = ok and now >= (r.Epoch or 0) and d <= r.Width * 0.4 / 2 * 0.85
            end
            if fire then
                local r = DigController:Activate()
                local why = type(r) == "table" and r.Error or nil
                if why == "NotAtDigsite" then
                    TeleportTo(zone.Position + Vector3.new(0, 2, 0), 0.5)
                elseif why and why ~= "Busy" and why ~= "TooSoon" and why ~= "Revealing" and why ~= "StaleRound" then
                    if why ~= lastWhy then warn("[Dig] " .. Dump(r)) lastWhy = why end
                    if why == "Cooldown" or why == "MenuOpen" or why == "Typing" then idle += 1 end
                    if idle > 20 then break end
                    task.wait(0.5)
                elseif type(r) == "table" and r.Complete then
                    print("[Dig] " .. tostring(r.Reward) .. " x" .. tostring(r.Amount))
                    task.wait(1.7)
                    pcall(function() DigRewardPopup:Close() end)
                end
            end
            task.wait()
        end
    end)
end)

