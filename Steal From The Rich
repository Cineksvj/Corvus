local function travel(target)
	local root = rootPart()
	if not root then
		return false
	end
	leaveTreadmill()
	local mode = Options.TravelMode and Options.TravelMode.Value or "Fly"
	if mode == "Teleport" then
		root.CFrame = CFrame.new(target) * root.CFrame.Rotation
		root.AssemblyLinearVelocity = Vector3.zero
		task.wait(0.15)
		return true
	end
	local speed = Options.TravelSpeed and Options.TravelSpeed.Value or 350
	local started = os.clock()
	local limit = (target - root.Position).Magnitude / math.max(speed, 1) + 6
	while alive() and os.clock() - started < limit do
		root = rootPart()
		if not root then
			return false
		end
		local position = root.Position
		local delta = target - position
		local distance = delta.Magnitude
		if distance < 1.5 then
			break
		end
		local dt = RunService.Heartbeat:Wait()
		local step = math.min(distance, speed * dt)
		root.CFrame = CFrame.new(position + delta.Unit * step) * root.CFrame.Rotation
		root.AssemblyLinearVelocity = Vector3.zero
	end
	root = rootPart()
	if root then
		root.CFrame = CFrame.new(target) * root.CFrame.Rotation
		root.AssemblyLinearVelocity = Vector3.zero
	end
	return true
end

