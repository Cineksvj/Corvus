	if not folder then
		return nil
	end
	local own = folder:FindFirstChild("PersonalTreadmill_" .. LocalPlayer.UserId)
	if own then
		return own
	end
	for _, child in ipairs(folder:GetChildren()) do
		if child:GetAttribute("OwnerUserId") == LocalPlayer.UserId or child:GetAttribute("RiderUserId") == LocalPlayer.UserId then
			return child
		end
	end
	return nil
end

local function mountTreadmill()
	if onTreadmill() then
		return true
	end
	local treadmill = myTreadmill()
	local belt = treadmill and treadmill:FindFirstChild("Belt", true)
	if not belt then
		setStatus("Treadmill not found")
		return false
	end
	setStatus("Going on the treadmill")
	travel(belt.Position + Vector3.new(0, belt.Size.Y / 2 + 3, 0))
	for _, d in ipairs(treadmill:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled then
			triggerPrompt(d)
			break
		end
	end
	local root = rootPart()
	if firetouchinterest and root then
		pcall(firetouchinterest, root, belt, 0)
		task.wait()
		pcall(firetouchinterest, root, belt, 1)
	end
	local waited = 0
	while not onTreadmill() and waited < 2 do
		waited += task.wait(0.1) or 0.1
	end
	return onTreadmill()
end

