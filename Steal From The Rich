local function trailTick()
	if not TrailState.known then
		fire("TRAIL_STATE")
		return
	end
	local cash = money()
	for _, trail in ipairs(Trails) do
		if not TrailState.Owned[trail.Id] then
			if (trail.Cost or math.huge) <= cash then
				fire("TRAIL_BUY", trail.Id)
				task.wait(0.5)
				fire("TRAIL_STATE")
			end
			break
		end
	end
	if Toggles.AutoEquipTrail and Toggles.AutoEquipTrail.Value then
		local best
		for _, trail in ipairs(Trails) do
			if TrailState.Owned[trail.Id] and (not best or (trail.Multiplier or 0) > (best.Multiplier or 0)) then
				best = trail
			end
		end
		if best and TrailState.Equipped ~= best.Id then
			fire("TRAIL_EQUIP", best.Id)
			TrailState.Equipped = best.Id
		end
	end
end

