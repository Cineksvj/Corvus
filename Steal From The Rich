local PlotFullUntil = 0

local function findSpot(floor)
	local occupied = {}
	for _, child in ipairs(floor:GetChildren()) do
		if child.Name == "AppraisingCrate" or child.Name == "ItemStand" then
			table.insert(occupied, child:GetPivot().Position)
		end
	end
	local halfX, halfZ = floor.Size.X / 2 - 3, floor.Size.Z / 2 - 3
	local top = floor.Size.Y / 2
	for x = -halfX, halfX, 3.5 do
		for z = -halfZ, halfZ, 3.5 do
			local world = floor.CFrame:PointToWorldSpace(Vector3.new(x, top, z))
			local free = true
			for _, p in ipairs(occupied) do
				local dx, dz = p.X - world.X, p.Z - world.Z
				if dx * dx + dz * dz < 16 then
					free = false
					break
				end
			end
			if free then
				return world
			end
		end
	end
	return nil
end

local function goToPlot(floor)
	local root = rootPart()
	if not root then
		return
	end
	local local_ = floor.CFrame:PointToObjectSpace(root.Position)
	if math.abs(local_.X) < floor.Size.X / 2 + 10 and math.abs(local_.Z) < floor.Size.Z / 2 + 10 and math.abs(local_.Y) < 20 then
		return
	end
	travel(floor.Position + Vector3.new(0, floor.Size.Y / 2 + 4, 0))
end

local function placeCrates()
	if os.clock() < PlotFullUntil then
		return false
	end
	local crates = toolsWith("CrateUid")
	if #crates == 0 then
		return false
	end
	local floor = myFloor()
	local hum = humanoid()
	if not (floor and hum and Remotes.re_PLACE_AT) then
		return false
	end
	setStatus("Placing crates on your plot")
	goToPlot(floor)
	for _, tool in ipairs(crates) do
		if not alive() then
			break
		end
		local spot = findSpot(floor)
		if not spot then
			PlotFullUntil = os.clock() + 20
			setStatus("Plot is full")
			break
		end
		pcall(hum.EquipTool, hum, tool)
		task.wait(0.25)
		Remotes.re_PLACE_AT:FireServer(spot, 0)
		local function stillMine()
			return tool.Parent ~= nil and (tool:IsDescendantOf(LocalPlayer) or tool.Parent == character())
		end
		local waited = 0
		while stillMine() and waited < 2 do
			waited += task.wait(0.1) or 0.1
		end
		if not stillMine() then
			Session.placed += 1
		else
			PlotFullUntil = os.clock() + 20
			break
		end
	end
	pcall(hum.UnequipTools, hum)
	return true
end

local function readyCrates(floor)
	local list = {}
	for _, child in ipairs(floor:GetChildren()) do
		if child.Name == "AppraisingCrate" then
			for _, d in ipairs(child:GetDescendants()) do
				if d:IsA("ProximityPrompt") and d.Enabled then
					table.insert(list, d)
					break
				end
			end
		end
	end
	return list
end

local function openCrates()
	local floor = myFloor()
	if not floor then
		return false
	end
	local prompts = readyCrates(floor)
	if #prompts == 0 then
		return false
	end
	setStatus("Opening " .. #prompts .. " crate" .. (#prompts == 1 and "" or "s"))
	for _, prompt in ipairs(prompts) do
		if not alive() then
			break
		end
		local part = prompt.Parent
		if part and part:IsA("BasePart") then
			travel(part.Position + Vector3.new(0, 3, 0))
		end
		if triggerPrompt(prompt) then
			Session.opened += 1
		end
		task.wait(0.3)
	end
	return true
end

