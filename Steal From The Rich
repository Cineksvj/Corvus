local function crateInfo(crate)
	local area = crate:GetAttribute("AreaId")
	local rarity = crate:GetAttribute("CrateTier") or crate:GetAttribute("Rarity")
	local nameArea, nameRarity = crate.Name:match("^Crate_([^_]+)_([^_]+)_")
	return area or nameArea, rarity or nameRarity
end

local function stealPrompt(crate)
	for _, d in ipairs(crate:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled and (d.ActionText == "Steal" or d.ActionText == "") then
			return d
		end
	end
	return nil
end

local function zoneAllowed(areaId)
	local area = AreaById[areaId]
	if Toggles.SmartZones and Toggles.SmartZones.Value and area then
		local level = tonumber(LocalPlayer:GetAttribute("SpeedLevel")) or 0
		if (area.RecommendedSpeed or 0) > level then
			return false
		end
	end
	for label, id in pairs(ZoneByLabel) do
		if id == areaId then
			return selected(Options.StealZones, label)
		end
	end
	return false
end

local function pickCrate()
	local folder = workspace:FindFirstChild("Crates")
	local root = rootPart()
	if not (folder and root) then
		return nil
	end
	local best, bestScore
	local priority = Options.StealPriority and Options.StealPriority.Value or "Best Rarity"
	for _, crate in ipairs(folder:GetChildren()) do
		if crate:GetAttribute("IsCrate") ~= false and crate:IsA("Model") then
			local area, rarity = crateInfo(crate)
			if area and rarity and zoneAllowed(area) and selected(Options.StealRarities, rarity) then
				local prompt = stealPrompt(crate)
				if prompt then
					local distance = (crate:GetPivot().Position - root.Position).Magnitude
					local score
					if priority == "Nearest" then
						score = -distance
					else
						local rank = (AreaById[area] and AreaById[area].Order or 0) * 10
						for i, tier in ipairs(AreaById[area] and AreaById[area].CrateTiers or {}) do
							if tier == rarity then
								rank += i
							end
						end
						score = rank * 100000 - distance
					end
					if not bestScore or score > bestScore then
						best, bestScore = { crate = crate, prompt = prompt, area = area, rarity = rarity }, score
					end
				end
			end
		end
	end
	return best
end

local function returnToSafety()
	setStatus("Bringing the crate home")
	travel(safeSpot())
	local waited = 0
	while carrying() and waited < 4 do
		waited += task.wait(0.1) or 0.1
	end
end

local function stealOnce()
	if carrying() then
		returnToSafety()
		return true
	end
	local target = pickCrate()
	if not target then
		setStatus("No crate matches your filters")
		return false
	end
	setStatus("Stealing " .. target.rarity .. " crate in " .. (AreaById[target.area] and AreaById[target.area].DisplayName or target.area))
	local part = target.prompt.Parent
	local position = part:IsA("BasePart") and part.Position or target.crate:GetPivot().Position
	travel(position + Vector3.new(0, 3, 0))
	if not (target.prompt.Parent and target.prompt.Enabled) then
		return true
	end
	triggerPrompt(target.prompt)
	local waited = 0
	while not carrying() and waited < 2.5 do
		waited += task.wait(0.1) or 0.1
	end
	if carrying() then
		returnToSafety()
	end
	return true
end

