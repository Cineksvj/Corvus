local function sellQuote()
	if not Remotes.rf_SELL_QUOTE then
		return nil
	end
	local ok, quote = pcall(function()
		return Remotes.rf_SELL_QUOTE:InvokeServer()
	end)
	return ok and type(quote) == "table" and quote or nil
end

local LastSell = 0
local function sellNow(force)
	if not Remotes.re_SELL_DO then
		return false
	end
	local mode = Options.SellMode and Options.SellMode.Value or "All"
	if Toggles.PlaceBestBeforeSell and Toggles.PlaceBestBeforeSell.Value then
		placeBest()
	end
	local quote = sellQuote()
	if quote then
		if mode == "All" and (tonumber(quote.AllCount) or 0) <= 0 then
			return false
		end
		if mode == "Held" and not quote.HeldLabel then
			return false
		end
	elseif not force then
		return false
	end
	setStatus("Selling (" .. mode .. ")")
	local root = rootPart()
	local back = root and root.Position
	local teleport = Toggles.SellTeleport and Toggles.SellTeleport.Value
	if teleport then
		travel(sellerSpot())
		task.wait(0.2)
	end
	local before = money()
	Remotes.re_SELL_DO:FireServer(mode == "Held" and "held" or "all")
	task.wait(1)
	local gained = money() - before
	if gained > 0 then
		Session.earned += gained
	end
	Session.sold += mode == "All" and (quote and tonumber(quote.AllCount) or 1) or 1
	if teleport and back and Toggles.SellReturn and Toggles.SellReturn.Value then
		travel(back)
	end
	LastSell = os.clock()
	return true
end

