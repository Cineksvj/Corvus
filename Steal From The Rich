-- Main worker: one task at a time so movement never fights itself
task.spawn(function()
	while alive() do
		local ok, err = pcall(function()
			if not rootPart() then
				setStatus("Waiting for character")
				return
			end
			if carrying() and on("AutoSteal") then
				returnToSafety()
				return
			end
			if on("AutoPlace") and #toolsWith("CrateUid") > 0 and os.clock() >= PlotFullUntil then
				if placeCrates() then
					return
				end
			end
			if on("AutoOpen") then
				local floor = myFloor()
				if floor and #readyCrates(floor) > 0 then
					openCrates()
					return
				end
			end
			if on("AutoSell") and os.clock() - LastSell >= (Options.SellInterval and Options.SellInterval.Value or 30) then
				LastSell = os.clock()
				if sellNow(false) then
					return
				end
			end
			if on("AutoSteal") then
				if stealOnce() then
					return
				end
			end
			if on("AutoTreadmill") then
				if not onTreadmill() then
					mountTreadmill()
				else
					setStatus("Training on the treadmill")
				end
				return
			end
			setStatus("Idle")
		end)
		if not ok then
			setStatus("Error: " .. tostring(err))
		end
		task.wait(0.25)
	end
end)

-- Background upgrades and claims (no movement needed)
task.spawn(function()
	local last = { index = 0, trails = 0, best = 0, slot = 0, plot = 0, tread = 0 }
	while alive() do
		pcall(function()
			local now = os.clock()
			local floor = myFloor()
			if on("AutoIndex") and now - last.index > 10 then
				last.index = now
				fire("INDEX_CLAIM_ALL")
			end
			if on("AutoTrails") and now - last.trails > 4 then
				last.trails = now
				trailTick()
			end
			if on("AutoEquipBest") and now - last.best > 15 then
				last.best = now
				task.spawn(placeBest)
			end
			if floor and on("AutoBuySlot") and now - last.slot > 6 and Remotes.re_PLOT_UPGRADE then
				last.slot = now
				Remotes.re_PLOT_UPGRADE:FireServer(floor, true)
			end
			if floor and on("AutoUpgradePlot") and now - last.plot > 3 and Remotes.re_PLOT_UPGRADE then
				if canAfford(signOf(floor, "UpgradeSignBoard")) then
					last.plot = now
					Remotes.re_PLOT_UPGRADE:FireServer(floor)
				end
			end
			if floor and on("AutoUpgradeTreadmill") and now - last.tread > 3 and Remotes.re_TREADMILL_UPGRADE then
				if canAfford(signOf(floor, "TreadmillSignBoard")) then
					last.tread = now
					Remotes.re_TREADMILL_UPGRADE:FireServer(floor)
				end
			end
		end)
		task.wait(0.5)
	end
end)

