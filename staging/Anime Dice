	function N.rankTable(kind)
		return if kind == "trait" then N.G.Traits else N.G.Grades
	end
	function N.rankNames(kind)
		local list = {}
		for name, data in pairs(N.rankTable(kind)) do
			if type(data) == "table" and (tonumber(data.incomeMultiplier) or 0) > 0 then
				table.insert(list, { name = name, mult = tonumber(data.incomeMultiplier) or 1 })
			end
		end
		table.sort(list, function(a, b)
			return a.mult < b.mult
		end)
		local names = {}
		for _, item in ipairs(list) do
			table.insert(names, item.name)
		end
		return names
	end
	function N.rankMult(kind, name)
		local data = name and N.rankTable(kind)[name]
		return if type(data) == "table" then tonumber(data.incomeMultiplier) or 1 else 1
	end
	function N.protected(kind, name)
		if not name then
			return false
		end
		local list = N.field(if kind == "trait" then "ProtectedTraits" else "ProtectedGrades", {}) or {}
		return list[name] == true
	end
	function N.rerollPick(kind)
		local target = N.rankMult(kind, optionText(if kind == "trait" then "TraitTarget" else "GradeTarget", ""))
		local limit = math.floor(optionNumber(if kind == "trait" then "TraitUnits" else "GradeUnits", 3))
		local count = 0
		for _, info in ipairs(N.units()) do
			if info.slot then
				count += 1
				if count > limit then
					break
				end
				local current = if kind == "trait" then info.trait else info.grade
				if N.rankMult(kind, current) < target and not N.protected(kind, current) and not N.opUnitExcluded(info) then
					return info
				end
			end
		end
		return nil
	end
	N.Reroll = { at = -1e9 }
	function N.rerollStep()
		if os.clock() - N.Reroll.at < 0.35 then
			return false
		end
		for _, kind in ipairs({ "trait", "grade" }) do
			local toggle = if kind == "trait" then "AutoTrait" else "AutoGrade"
			local token = if kind == "trait" then "Trait Reroll" else "Gems"
			local reserve = math.floor(optionNumber(if kind == "trait" then "TraitReserve" else "GradeReserve", 0))
			if on(toggle) and N.amount(token) > reserve and not N.opExcluded(if kind == "trait" then "Trait Rerolls" else "Gems") then
				local info = N.rerollPick(kind)
				if info then
					N.Reroll.at = os.clock()
					fire(if kind == "trait" then R.trait else R.grade, info.key)
					if kind == "trait" then
						Session.traitRolls += 1
					else
						Session.gradeRolls += 1
					end
					N.UnitCache.at = -1e9
					return true
				end
			end
		end
		return false
	end
