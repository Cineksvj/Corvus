	-- Draws the slot tiles: swaps a model only when the unit on a slot changes, sets text only when it changed.
	local function unitModel(name)
		local assets = ReplicatedStorage:FindFirstChild("Assets")
		local models = assets and assets:FindFirstChild("Models")
		local units = models and models:FindFirstChild("Units")
		local base = units and (units:FindFirstChild(name) or units:FindFirstChild((string.gsub(name, "^%a+%s+", ""))))
		if not base then
			return nil
		end
		local wasArchivable = base.Archivable
		base.Archivable = true
		local ok, model = pcall(base.Clone, base)
		base.Archivable = wasArchivable
		if not ok or not model then
			return nil
		end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BaseScript") or d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") or d:IsA("Light") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.Anchored = true
			end
		end
		-- Characters face -Z, the camera looks from the front, so turn the model around.
		pcall(function()
			model:PivotTo(CFrame.Angles(0, math.pi, 0))
		end)
		return model
	end
	local function setText(tile, key, label, value)
		if tile.texts[key] ~= value then
			tile.texts[key] = value
			label.Text = value
		end
	end
	function N.drawSlots()
		local unlocked = 0
		local models = on("SlotModels")
		local mult = N.buff("Money Multiplier", 1) or 1
		local money = N.money()
		for i, tile in pairs(N.SlotTiles or {}) do
			local info = N.slotUnit(i)
			local open = N.slotUnlocked(i)
			if open then
				unlocked += 1
			end
			local key = if info and models then info.name else "none"
			if tile.model ~= key then
				tile.model = key
				if tile.object then
					tile.object:Destroy()
					tile.object = nil
				end
				local model = info and models and unitModel(info.name)
				if model then
					model.Parent = tile.view
					tile.object = model
					local ok, cf, size = pcall(model.GetBoundingBox, model)
					if ok then
						local reach = math.max(size.X, size.Y * 0.9, size.Z)
						tile.camera.CFrame = CFrame.new(cf.Position + Vector3.new(0, size.Y * 0.05, reach * 1.45), cf.Position)
					end
				end
			end
			local allowed = N.slotLevelAllowed(i)
			if tile.allowed ~= allowed then
				tile.allowed = allowed
				tile.check.Text = if allowed then "\u{2713}" else ""
				tile.check.BackgroundColor3 = if allowed then Color3.fromRGB(96, 214, 150) else Color3.fromRGB(70, 70, 76)
			end
			local strokeColor
			if not open then
				local ok, need = pcall(N.G.Plot.GetSlotRebirthRequirement, i)
				setText(tile, "name", tile.name, '<font color="#fab428"><b>Locked</b></font>')
				setText(tile, "line1", tile.line1, "Opens at Rebirth " .. (if ok then tostring(need) else "?"))
				setText(tile, "line2", tile.line2, "")
				strokeColor = Color3.fromRGB(80, 70, 40)
			elseif not info then
				setText(tile, "name", tile.name, '<font transparency="0.4">Empty</font>')
				setText(tile, "line1", tile.line1, '<font transparency="0.4">Equip Best fills it</font>')
				setText(tile, "line2", tile.line2, "")
			else
				local price = N.levelPrice(info)
				setText(tile, "name", tile.name, "<b>" .. (if info.mutation then info.mutation .. " " else "") .. info.name .. "</b>")
				setText(tile, "line1", tile.line1, string.format('<font color="%s">%s</font>  <font color="#60d696">$%s/s</font>', N.rarityColor(info.rarity), info.rarity, formatNumber(info.income * mult)))
				setText(tile, "line2", tile.line2, string.format("Lv <b>%d</b>  \u{00B7}  <font color=\"%s\">$%s</font>  \u{00B7}  pays back %s", info.level, if money >= price then "#60d696" else "#9a9aa2", formatNumber(price), N.longTime(price / math.max(N.levelGain(info), 1e-9))))
				local ok, color = pcall(Color3.fromHex, N.rarityColor(info.rarity))
				strokeColor = if ok then color else nil
			end
			if strokeColor and tile.stroke.Color ~= strokeColor then
				tile.stroke.Color = strokeColor
			end
		end
		if Labels.SlotsTop then
			local ranking = {}
			for index, option in ipairs(N.levelOptions()) do
				if index > 5 then
					break
				end
				table.insert(ranking, string.format("%d. slot %d %s Lv %d: $%s, +$%s/s, pays back %s", index, option.info.slot, option.info.name, option.info.level + 1, formatNumber(option.price), formatNumber(option.gain), N.longTime(option.payback)))
			end
			local textValue = string.format(
				"<b>%d/%d</b> slots open  \u{00B7}  plot <b>$%s/s</b>  \u{00B7}  levels bought <b>%d</b>\n<b>Best upgrades</b> (%s):\n%s\n<font transparency=\"0.4\">\u{2713} on a tile = Auto Level may use it, \u{25B2} = one level now</font>",
				unlocked,
				N.maxSlots(),
				formatNumber(N.plotIncome()),
				Session.levels,
				optionText("LevelStrategy", "Fastest payback"),
				if #ranking > 0 then table.concat(ranking, "\n") else "nothing to level"
			)
			if N.SlotTopText ~= textValue then
				N.SlotTopText = textValue
				Labels.SlotsTop:SetText(textValue)
			end
		end
	end
	task.spawn(function()
		local uiErrorAt = -1e9
		local function group(fn)
			local ok, err = xpcall(fn, debug.traceback)
			if not ok and os.clock() - uiErrorAt > 30 then
				uiErrorAt = os.clock()
				local lines = {}
				for line in string.gmatch(tostring(err), "[^\n]+") do
					if #lines < 6 then
						table.insert(lines, (string.gsub(line, "^%s+", "")))
					end
				end
				log("ERROR", "ui", table.concat(lines, " | "))
			end
		end
		local frame = 0
		while alive() do
			frame += 1
			local started = os.clock()
			group(UIQueue.flush)
			if frame % 3 == 0 then
				local I = N.InfoText
				if shown(Tabs.Main) or shown(Tabs.Roll) then
					group(function()
						Labels.Status:SetText(Status)
						Labels.Info:SetText(I.info or "-")
						Labels.Recent:SetText(I.recent or "-")
						Labels.Dice:SetText(I.dice or "-")
							Labels.UpNext:SetText(I.spend or "-")
					end)
				end
				if shown(Tabs.Plot) then
					group(function()
						Labels.Plot:SetText(I.plot or "-")
						Labels.Sell:SetText(I.sell or "-")
					end)
				end
				if frame % 9 == 0 and shown(Tabs.Slots) then
					group(N.drawSlots)
				end
				if shown(Tabs.Upgrades) then
					group(function()
						Labels.Upgrades:SetText(I.upgrades or "-")
						Labels.Rebirth:SetText(I.rebirth or "-")
						Labels.Shop:SetText(I.shop or "-")
						Labels.Spend:SetText(I.spend or "-")
					end)
				end
				if shown(Tabs.Towers) then
					group(function()
						Labels.Tower:SetText(I.tower or "-")
						Labels.TowerOdds:SetText(I.towerOdds or "-")
					end)
				end
				if shown(Tabs.Items) or shown(Tabs.Rewards) then
					group(function()
						Labels.Rewards:SetText(I.rewards or "-")
						Labels.Quests:SetText(I.quests or "-")
						Labels.Reroll:SetText(I.reroll or "-")
					end)
				end
				if shown(Tabs.Stats) then
					group(N.drawStats)
				end
				if Labels.Perf and shown(Tabs.Misc) then
					group(function()
						Labels.Perf:SetText(Debug.perfText())
					end)
				end
			end
			Perf.work.ui = (Perf.work.ui or 0) + (os.clock() - started)
			task.wait(0.1)
		end
	end)
	task.spawn(function()
		local windowStart = os.clock()
		while alive() do
			task.wait(5)
			pcall(function()
				if os.clock() - windowStart >= 30 then
					local span = os.clock() - windowStart
					windowStart = os.clock()
					local hub, parts = 0, {}
					for key, seconds in pairs(Perf.work) do
						hub += seconds
						table.insert(parts, key .. " " .. math.floor(seconds * 1000) .. "ms")
					end
					table.sort(parts)
					local ping, memory = "?", "?"
					pcall(function()
						ping = tostring(math.floor(LocalPlayer:GetNetworkPing() * 1000))
					end)
					pcall(function()
						memory = tostring(math.floor(game:GetService("Stats"):GetTotalMemoryUsageMb()))
					end)
					Perf.last = {
						fps = if Perf.time > 0 then Perf.frames / Perf.time else 0,
						worst = Perf.worst,
						hitches = Perf.hitches,
						freezes = Perf.freezes,
						hub = hub,
						span = span,
						ping = ping,
						memory = memory,
					}
					log("PERF", Debug.perfText(), "|", table.concat(parts, ", "))
					Perf.frames, Perf.time, Perf.worst, Perf.hitches, Perf.freezes = 0, 0, 0, 0, 0
					table.clear(Perf.work)
					flushLog(false)
				end
				if Log.statusAt and os.clock() - Log.statusAt > 600 and Log.stuckAt ~= Log.statusAt and anyAutoOn() then
					Log.stuckAt = Log.statusAt
					logProblem("Stuck for 10 minutes on: " .. tostring(Status))
				end
			end)
		end
	end)
	pcall(function()
		Tabs.Main:Show()
	end)
	do
		local key = "RightControl"
		pcall(function()
			if Options.MenuKeybind and Options.MenuKeybind.Value then
				key = tostring(Options.MenuKeybind.Value)
			end
		end)
		notify(
			"Corvus",
			if Library.IsMobile then "Loaded and ready. The round Corvus button opens and closes the hub." else "Loaded. Press " .. key .. " to hide or show the menu.",
			5
		)
	end
	-- One-time toast after the Auto Farm Everything redesign (flag file, shows once).
	do
		local flag = "Corvus/AD_farm_redesign_seen.txt"
		local seen = true
		pcall(function()
			seen = isfile(flag)
		end)
		if not seen then
			pcall(function()
				if makefolder and isfolder and not isfolder("Corvus") then
					makefolder("Corvus")
				end
				writefile(flag, "1")
			end)
			notify("Auto Farm Everything", "Auto Farm Everything is now one full automatic switch on Main. Pick what it must never touch in Exclude.", 8)
		end
	end
	if Library.ShowWizard and not N.setupDone() then
		task.delay(1.5, function()
			if on("AutoRoll") or on("AutoFarmBest") or on("AutoTower") or on("AutoUpgrade") then
				N.markSetupDone()
				return
			end
			if alive() then
				pcall(N.openWizard)
			end
		end)
	end
end
end, debug.traceback)
Boot.CorvusBooting = nil
if not BootOk then
	local report = "[Corvus] Anime Dice failed to start:\n" .. tostring(BootError)
	warn(report)
	Boot.CorvusLastError = report
	local copied = pcall(setclipboard, report)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "Corvus error",
			Text = if copied
				then "Hub failed to start. The error is copied, paste it to Cinek."
				else "Hub failed to start. Press F9 and send the red [Corvus] line.",
			Duration = 20,
		})
	end)
end
