	function N.gearScore(cfg, focus)
		local weights = GearWeights[focus] or GearWeights.Luck
		local score = 0
		for buff, data in pairs(type(cfg.buffs) == "table" and cfg.buffs or {}) do
			local amount = tonumber(data.amount) or 0
			local gain = if data.bucket == "multiplier" then amount - 1 elseif data.bucket == "percentage" then amount else amount / 20
			score += gain * (weights[buff] or 0.1)
		end
		return score
	end
	function N.gearStep()
		if not on("AutoGear") then
