                        Value = Value,
                        RawValue = RawValue,
                        FormattedValue = FormattedValue,
                        IsDisabled = IsDisabled,
                        ValueImage = GetValueImage(Value, RawValue),
                        SortKey = Key,
                        MatchScore = MatchScore,
                        Order = #Pending + 1,
                    }
    
                    table.insert(Pending, Entry)
