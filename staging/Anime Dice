			writefile(OPFile, HttpService:JSONEncode({ remember = on("RememberFarm"), op = on("RememberFarm") and on("AutoFarmBest") }))
		end)
	end
	function N.restoreOP()
		local ok, data = pcall(function()
			return HttpService:JSONDecode(readfile(OPFile))
		end)
		if not ok or type(data) ~= "table" or data.remember ~= true or not alive() then
			return
		end
		N.OPRestoring = true
		pcall(function()
			Toggles.RememberFarm:SetValue(true)
			if data.op == true and not on("AutoFarmBest") then
				N.OPConfirmed = true
				Toggles.AutoFarmBest:SetValue(true)
				N.OPConfirmed = false
				log("OP restored (Remember Auto Farm Everything)")
			end
		end)
		N.OPRestoring = false
	end
	task.delay(6.5, N.restoreOP)
