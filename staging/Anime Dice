	daily = "DailyRewardService/RE/Claim",
	group = "GroupRewardService/RE/Claim",
	offline = "OfflineEarningsService/RE/Claim",
	quest = "QuestService/RE/Claim",
	questBuy = "QuestService/RE/Buy",
	code = "CodesService/RE/RedeemCode",
	boost = "BoostService/RE/Use",
	spin = "SpinService/RE/Use",
	gear = "GearService/RE/Equip",
	trait = "TraitService/RE/Roll",
	grade = "GradeService/RE/Roll",
	teamBest = "Towers/RE/EquipBestTowerTeam",
	autoTower = "Towers/RE/SetAutoTower",
	playTower = "Towers/RF/PlayTower",
	floor = "Towers/RF/CompleteTowerFloor",
	cancelTower = "Towers/RF/CancelTower",
}
do
	local R = N.R
	-- Rolling: the server only allows one roll per "Roll Duration" (2.5 s base, less with Roll Speed). The game's
	-- own auto roll waits for the whole animation on top of that; Corvus asks again the moment the server allows it.
	N.Roll = { autoOffAt = -1e9, nextAt = 0, fullSince = nil, margin = 0.04, clean = 0, rejectStreak = 0, lastAt = -1e9, lastCount = 0 }
	function N.rollDuration()
		return math.max(N.buff("Roll Duration", 2.5) or 2.5, 0.2)
	end
	function N.inventoryFull()
		N.units()
		local rolls = math.max(N.buff("Rolls", 1) or 1, 1)
		-- The server hands out the units of a roll 1.33 roll durations after the call, so the last roll is still on
		-- its way and needs room too (otherwise its units could arrive in a full storage).
		local pending = 0
		if os.clock() - N.Roll.lastAt < N.rollDuration() * 1.4 + 0.3 then
			pending = N.Roll.lastCount
		end
		return N.UnitCache.count + pending + (rolls - 1) >= N.storage()
	end
	function N.noteRoll(name, mutation)
		local cfg = N.entry(name)
		if not cfg then
			return
		end
		local chance = tonumber(N.call(cfg.chance, { mutation = mutation })) or 0
		local info = {
			name = name,
			mutation = mutation,
			chance = chance,
			rarity = tostring(N.call(cfg.getRarity, { mutation = mutation }) or cfg.rarity or "Common"),
		}
		table.insert(Session.recent, 1, info)
		while #Session.recent > 6 do
			table.remove(Session.recent)
		end
		if chance > Session.bestChance then
			Session.bestChance = chance
			Session.best = N.unitText(info)
		end
		if N.Events.rolled then
			pcall(N.Events.rolled, info)
		end
	end
	function N.spinStep()
		if not on("AutoSpin") or N.opExcluded("Spins") then
			return
		end
		for _, entry in pairs(N.field("ActiveEntries", {}) or {}) do
			local cfg = type(entry) == "table" and N.entry(entry.name)
			if cfg and cfg.kind == "Spin" then
				return
			end
		end
		for _, name in ipairs({ "Jackpot Spin", "Lucky Spin" }) do
			if selected(Options.SpinTypes, name) and N.amount(name) > 0 then
				fire(R.spin, name)
				Session.spins += 1
				task.wait(0.4)
				return
			end
		end
	end
	function N.rollStep()
		local Roll = N.Roll
		if N.field("AutoRoll", false) == true and os.clock() - Roll.autoOffAt > 5 then
			Roll.autoOffAt = os.clock()
			fire(R.autoRoll, false)
		end
		if N.inventoryFull() then
			Roll.fullSince = Roll.fullSince or os.clock()
			setStatus(string.format("Unit storage is full (%d/%d)%s", N.UnitCache.count, N.storage(), if on("AutoSell") then ", selling" else ", turn on Auto Sell"))
			if on("AutoSell") then
				N.sellStep(true)
			end
			task.wait(1)
			return
		end
		Roll.fullSince = nil
		N.spinStep()
		local wait = Roll.nextAt - os.clock()
		if wait > 0 then
			task.wait(wait)
			if not on("AutoRoll") or N.manualRunning() then
				return
			end
		end
		local started = os.clock()
		Session.rollCalls += 1
		local ok, results = invoke(R.roll, 8)
		if ok and type(results) == "table" and #results > 0 then
			Session.rolls += #results
			for _, result in ipairs(results) do
				if type(result) == "table" then
					N.noteRoll(result.result, result.mutation)
				end
			end
			Roll.nextAt = started + N.rollDuration() + Roll.margin
			Roll.lastAt, Roll.lastCount = started, #results
			Roll.rejectStreak = 0
			Roll.clean += 1
			if Roll.clean >= 60 then
				Roll.clean = 0
				Roll.margin = math.max(0.04, Roll.margin - 0.01)
			end
			setStatus(string.format("Rolling  \u{00B7}  %s rolls this session", formatNumber(Session.rolls)))
		else
			Session.rejected += 1
			-- Refused: the server timer was not over yet (ping jitter). Wait a little longer next time, and back
			-- off when it keeps refusing so no calls are wasted.
			Roll.clean = 0
			Roll.rejectStreak += 1
			if Roll.rejectStreak == 1 then
				Roll.margin = math.min(Roll.margin + 0.03, 0.3)
			end
			Roll.nextAt = os.clock() + math.min(0.1 * 2 ^ (Roll.rejectStreak - 1), 3)
		end
	end
	-- Plot: the server pays out a slot's balance on request from anywhere, no walking needed.
	N.Plot = { equipAt = -1e9, levelAt = -1e9 }
	function N.collectStep()
		local total = 0
		for slot, info in pairs(N.slots()) do
			local balance = type(info) == "table" and tonumber(info.balance) or 0
			local index = tonumber(slot)
			if balance > 0 and index and N.slotUnlocked(index) then
				fire(R.collect, index)
				total += balance
			end
		end
		if total > 0 then
			Session.collected += total
		end
		return total
	end
	-- True when a unit that is not on the plot earns more than one that is (or a slot is empty).
	-- Equip Best modes:
	--   Current income: the game's own Equip Best (income right now, levels included).
	--   Same level: true strength, income compared at an equal level, so a new strong unit wins over an old
	--     levelled weak one (its levels stay on that unit in the backpack).
	--   Rarity first: highest rarity, then income right now.
	N.EquipModes = { "Current income", "Same level (true strength)", "Rarity first" }
	function N.equipValue(info, mode)
		mode = mode or optionText("EquipMode", "Current income")
		if mode == "Same level (true strength)" then
			return info.baseIncome, info.income
		elseif mode == "Rarity first" then
			return N.rarityRank(info.rarity), info.income
		end
		return info.income, 0
	end
	function N.plotWanted()
		local list = table.clone(N.units())
		local mode = optionText("EquipMode", "Current income")
		table.sort(list, function(a, b)
			local a1, a2 = N.equipValue(a, mode)
			local b1, b2 = N.equipValue(b, mode)
			if a1 ~= b1 then
				return a1 > b1
			end
			if a2 ~= b2 then
				return a2 > b2
			end
			return tostring(a.key) < tostring(b.key)
		end)
		local wanted = {}
		for i = 1, math.min(#N.unlockedSlots(), #list) do
			wanted[i] = list[i]
		end
		return wanted
	end
	function N.plotNeedsBetter()
		for _, info in ipairs(N.plotWanted()) do
			if not info.slot then
				return true, info
			end
		end
		return false, nil
	end
	-- Places one unit: hold it (UnitService.Equip), then interact with the slot. Cash on the slot is collected
	-- first because the game resets the slot balance when the unit changes.
	function N.placeUnit(info, slot)
		N.Plot.equipAt = os.clock()
		fire(R.collect, slot)
		local ok, held = invoke(R.holdUnit, 8, info.key)
		if not ok or held == false then
			logProblem("Could not pick up " .. N.unitText(info) .. " for slot " .. slot)
			return false
		end
		task.wait(0.6)
		fire(R.interactSlot, slot)
		task.wait(0.6)
		return true
	end
	function N.equipStep()
		if os.clock() - N.Plot.equipAt < 4 then
			return false
		end
		local need, unit = N.plotNeedsBetter()
		if not need then
			return false
		end
		N.Plot.equipAt = os.clock()
		if optionText("EquipMode", "Current income") == "Current income" then
			fire(R.equipBest)
			Session.equips += 1
			log("EQUIP best, new on plot:", N.unitText(unit))
			N.UnitCache.at = -1e9
			return true
		end
		-- Free slots: empty ones and the ones holding a unit that is not wanted. Wanted units already on the
		-- plot stay where they are.
		local wanted = N.plotWanted()
		local keep = {}
		for _, info in ipairs(wanted) do
			if info.slot then
				keep[info.slot] = true
			end
		end
		local free = {}
		for _, slot in ipairs(N.unlockedSlots()) do
			if not keep[slot] then
				table.insert(free, slot)
			end
		end
		local placed = 0
		for _, info in ipairs(wanted) do
			if not info.slot and #free > 0 then
				local slot = table.remove(free, 1)
				if N.placeUnit(info, slot) then
					placed += 1
					log("EQUIP", optionText("EquipMode", "?"), N.unitText(info), "on slot", slot)
				end
			end
		end
		N.UnitCache.at = -1e9
		N.Data.at = -1e9
		Session.equips += placed
		return placed > 0
	end
	function N.slotUnit(index)
		local _, byKey = N.units()
		local slot = N.slots()[tostring(index)]
		local info = type(slot) == "table" and slot.unitId and byKey[slot.unitId]
		return if info and info.slot == index then info else nil
	end
	function N.slotLevelAllowed(index)
		local option = Options.LevelSlots
		if not option or type(option.Value) ~= "table" then
			return true
		end
		return option.Value["Slot " .. tostring(index)] == true
	end
	function N.levelSlotNow(index)
		local info = N.slotUnit(index)
		if not info then
			notify("Slot " .. index, "No unit on this slot", 3)
			return
		end
		local price = N.levelPrice(info)
		if N.money() < price then
			notify("Slot " .. index, "Needs $" .. formatNumber(price), 3)
			return
		end
		fire(N.R.levelUp, index)
		Session.levels += 1
		N.UnitCache.at = -1e9
	end
	function N.levelPrice(info)
		local cfg = N.entry(info.name)
		local base = cfg and tonumber(N.call(cfg.income, { mutation = info.mutation })) or 0
		return math.floor(base * 1.6 ^ (info.level - 1))
	end
	-- Level maths: price = base x 1.6^(level-1) grows exponentially, while each level adds a flat 25% of the
	-- level-1 income (already multiplied by trait, grade and money buffs). The payback time price / gain is the
	-- honest measure: buying the shortest payback first is the optimal greedy order for income per cash.
	function N.levelGain(info)
		return info.income / (1 + 0.25 * (info.level - 1)) * 0.25 * (N.buff("Money Multiplier", 1) or 1)
	end
	function N.levelOptions(strategyOverride)
		local list = {}
		for _, info in ipairs(N.units()) do
			if info.slot and N.slotLevelAllowed(info.slot) then
				local price = N.levelPrice(info)
				local gain = N.levelGain(info)
				if price > 0 and gain > 0 then
					table.insert(list, { info = info, price = price, gain = gain, payback = price / gain })
				end
			end
		end
		local strategy = strategyOverride or optionText("LevelStrategy", "Fastest payback")
		table.sort(list, function(a, b)
			if strategy == "Cheapest first" then
				return a.price < b.price
			elseif strategy == "Strongest unit first" then
				return a.info.income > b.info.income
			end
			if math.abs(a.payback - b.payback) > 1e-6 then
				return a.payback < b.payback
			end
			return a.info.income > b.info.income
		end)
		return list
	end
	function N.levelPick(ignoreBudget)
		local budget = N.money() * (if ignoreBudget then 1 else math.clamp(optionNumber("LevelBudget", 50), 1, 100) / 100)
		local options = N.levelOptions()
		local first = options[1]
		if not first then
			return nil
		end
		-- Fastest payback waits for the best option instead of buying a worse one that happens to be affordable,
		-- unless the best one takes over 10x longer to pay back than the affordable one is worth waiting for.
		if first.price <= budget then
			return first.info, first
		end
		if optionText("LevelStrategy", "Fastest payback") ~= "Fastest payback" then
			for _, option in ipairs(options) do
				if option.price <= budget then
					return option.info, option
				end
			end
			return nil
		end
		local wait = (first.price - N.money()) / math.max(N.plotIncome(), 1)
		for _, option in ipairs(options) do
			if option.price <= budget and option.payback <= first.payback * 3 and wait > option.payback then
				return option.info, option
			end
		end
		return nil
	end
	function N.buyBestLevel()
		local info = N.levelPick(true)
		if not info then
			notify("Slots", "Nothing affordable right now", 3)
			return false
		end
		fire(R.levelUp, info.slot)
		Session.levels += 1
		N.UnitCache.at = -1e9
		return true
	end
	function N.levelStep()
		if not on("AutoLevel") or on("SmartSpend") or os.clock() - N.Plot.levelAt < 0.3 then
			return false
		end
		local info = N.levelPick()
		if not info then
			return false
		end
		N.Plot.levelAt = os.clock()
		fire(R.levelUp, info.slot)
		Session.levels += 1
		N.UnitCache.at = -1e9
		return true
	end
	-- Selling: never the plot, the tower team, locked units or what the filters keep.
	N.Sell = { at = -1e9, gameAt = -1e9 }
	N.GameSellValues = {
		Off = 0,
		["Below 1 in 100"] = 100,
		["Below 1 in 1K"] = 1000,
		["Below 1 in 10K"] = 10000,
		["Below 1 in 100K"] = 100000,
		["Below 1 in 1M"] = 1000000,
		["Below 1 in 10M"] = 10000000,
	}
	N.GameSellNames = { "Off", "Below 1 in 100", "Below 1 in 1K", "Below 1 in 10K", "Below 1 in 100K", "Below 1 in 1M", "Below 1 in 10M" }
	-- With high luck the game stops rolling plain low units but still rolls their Silver/Gold versions, so nearly
	-- every roll is "mutated". Only the mutations picked in Keep Mutations are protected, the rest is judged by value.
	N.MutationNames = { "Silver", "Gold", "Emerald", "Diamond", "Ruby", "Rainbow" }
	-- relax 1 (storage full, rolling blocked): the extra best units are not kept any more.
	-- relax 2: mutations picked in Keep Mutations may go too. Plot, team, locked and rare units are never sold.
	function N.sellPlan(relax)
		relax = relax or 0
		local list = N.units()
		local keepTop = #N.unlockedSlots() + (if relax >= 1 then 0 else math.floor(optionNumber("KeepExtra", 4)))
		local keepRank = N.rarityRank(optionText("KeepRarity", "Celestial"))
		local plan = {}
		local why = { best = 0, plot = 0, team = 0, locked = 0, mutation = 0, rarity = 0, op = 0 }
		for i, info in ipairs(list) do
			local reason = if i <= keepTop
				then "best"
				elseif info.slot ~= nil then "plot"
				elseif info.team then "team"
				elseif info.locked then "locked"
				elseif N.opUnitExcluded(info) then "op"
				elseif relax < 2 and info.mutation and selected(Options.KeepMutations, info.mutation) then "mutation"
				elseif keepRank > 0 and N.rarityRank(info.rarity) >= keepRank then "rarity"
				else nil
			if reason then
				why[reason] += 1
			else
				table.insert(plan, info)
			end
		end
		if relax == 0 then
			N.Sell.why = why
		end
		return plan
	end
	function N.sellStep(force)
		if not on("AutoSell") then
			return false
		end
		local due = force or N.UnitCache.count >= N.storage() * math.clamp(optionNumber("SellAt", 80), 10, 100) / 100 or os.clock() - N.Sell.at > 180
		if not due or os.clock() - N.Sell.at < 3 then
			return false
		end
		N.Sell.at = os.clock()
		local relax = 0
		if N.Roll.fullSince then
			local stuck = os.clock() - N.Roll.fullSince
			-- Extra copies earn nothing while rolling is blocked (new drops refill any slot a rebirth opens), so they go
			-- at once. Kept mutations are the player's own protection and only go after 2 minutes.
			relax = if stuck > 120 then 2 else 1
		end
		local plan = N.sellPlan(relax)
		if relax > 0 and #plan > 0 then
			log("SELL storage stuck, selling kept units too (relax " .. relax .. ")", #plan)
		end
		if #plan == 0 then
			local why = N.Sell.why or {}
			local text = string.format(
				"nothing to sell, kept: %d best, %d on plot, %d team, %d locked, %d by mutation, %d by rarity, %d excluded",
				why.best or 0, why.plot or 0, why.team or 0, why.locked or 0, why.mutation or 0, why.rarity or 0, why.op or 0
			)
			if text ~= N.Sell.lastWhy then
				N.Sell.lastWhy = text
				log("SELL", text)
			end
			return false
		end
		local sold, cash = 0, 0
		for first = 1, #plan, 100 do
			local keys = {}
			for i = first, math.min(first + 99, #plan) do
				table.insert(keys, plan[i].key)
			end
			if not on("AutoSell") then
				break
			end
			local ok, price = invoke(R.sell, 10, keys)
			if ok then
				sold += #keys
				cash += tonumber(price) or 0
			end
			task.wait(0.2)
		end
		Session.sold += sold
		Session.soldCash += cash
		N.UnitCache.at = -1e9
		log("SOLD", sold, "units for", cash)
		if N.Events.sold then
			pcall(N.Events.sold, sold, cash)
		end
		return sold > 0
	end
	function N.gameSellStep()
		local want = N.GameSellValues[optionText("GameAutoSell", "Off")] or 0
		if want ~= 0 and N.opAnyUnitExcluded() then
			if not N.opLogged["Game auto sell"] then
				N.opLogged["Game auto sell"] = true
				log("OP exclude", "Game auto sell off (excluded units)")
			end
			want = 0
		end
		local have = tonumber(N.field("AutoSell", 0)) or 0
		if want ~= have and os.clock() - N.Sell.gameAt > 5 then
			N.Sell.gameAt = os.clock()
			fire(R.autoSell, want)
		end
	end
	-- Shopping: rebirth first when affordable (keeps units and upgrades), then the best dice, then upgrades.
	N.Shop = { at = -1e9, log = {}, failed = {} }
	local function shopNote(text)
		table.insert(N.Shop.log, 1, os.date("%H:%M") .. "  " .. text)
		while #N.Shop.log > 5 do
			table.remove(N.Shop.log)
		end
		log("SHOP", text)
	end
	N.shopNote = shopNote
	function N.nextRebirth()
		local ok, data = pcall(N.G.Rebirths.GetNext, N.rebirth())
		return if ok and type(data) == "table" then data else nil
	end
	function N.rebirthStep()
		if not on("AutoRebirth") or on("SmartSpend") then
			return false
		end
		local nextData = N.nextRebirth()
		local cost = nextData and tonumber(nextData.cost)
		if not cost or N.money() < cost then
			return false
		end
		local before = N.rebirth()
		fire(R.rebirth)
		if waitFor(function()
			N.Data.at = -1e9
			return N.rebirth() > before
		end, 2.5) then
			Session.rebirths += 1
			shopNote("Rebirth " .. N.rebirth())
			if N.Events.rebirth then
				pcall(N.Events.rebirth, N.rebirth())
			end
		end
		return true
	end
	function N.diceList()
		local list = {}
		local ok, all = pcall(N.G.Dice.GetAll)
		for name, data in pairs(if ok and type(all) == "table" then all else {}) do
			if type(data) == "table" then
				table.insert(list, { name = name, luck = tonumber(data.luck) or 0, price = tonumber(data.price), rarity = data.rarity })
			end
		end
		table.sort(list, function(a, b)
			return a.luck < b.luck
		end)
		return list
	end
	function N.ownsDice(name)
		local owned = N.field("OwnedDice", {}) or {}
		return name == "Basic" or owned[name] == true
	end
	function N.farmActive()
		return on("AutoFarmBest")
	end
	function N.diceStep()
		local list = N.diceList()
		local current = N.field("Dice", "Basic")
		if on("AutoEquipDice") then
			local best
			for _, dice in ipairs(list) do
				if N.ownsDice(dice.name) then
					best = dice
				end
			end
			-- Normal farm mode keeps the dice the player picked: we only switch from Basic or from a dice we equipped ourselves.
			local pinned = false
			if pinned and N.dicePin ~= current then
				N.dicePin = current
				log("DICE", "keeping your pick", tostring(current))
			end
			if best and best.name ~= current and not pinned then
				N.lastAutoDice = best.name
				fire(R.equipDice, best.name)
				task.wait(0.6)
				return true
			end
		end
		if not on("AutoBuyDice") or on("SmartSpend") then
			return false
		end
		local money = N.money()
		for i = #list, 1, -1 do
			local dice = list[i]
			if dice.price and not N.ownsDice(dice.name) and dice.price <= money and (N.Shop.failed[dice.name] or 0) < os.clock() then
				fire(R.buyDice, dice.name)
				if waitFor(function()
					N.Data.at = -1e9
					return N.ownsDice(dice.name)
				end, 2) then
					Session.bought += 1
					shopNote("Bought the " .. dice.name .. " dice")
					if N.Events.bought then
						pcall(N.Events.bought, dice.name .. " Dice", dice.price)
					end
				else
					N.Shop.failed[dice.name] = os.clock() + 30
				end
				return true
			end
		end
		return false
	end
	function N.upgradeCategory(name)
		return string.match(name, "^(.-)%s+[IVXL]+$") or name
	end
	N.UpgradeCategories = { "Money", "Luck", "Fortune", "Roll Speed", "Unit Storage", "Sell", "Damage", "Health", "Walkspeed", "Grade Luck", "Trait Luck" }
	-- The tree never changes, so each parent is looked up once (the game's GetParent scans the whole tree).
	N.Tree = { parents = {}, children = nil }
	function N.treeParent(name)
		local cached = N.Tree.parents[name]
		if cached == nil then
			local ok, parent = pcall(N.G.Tree.GetParent, name)
			cached = if ok and parent ~= nil then parent else false
			N.Tree.parents[name] = cached
		end
		return if cached then cached else nil
	end
	function N.treeChildren(name)
		local T = N.Tree
		if not T.children then
			local map = {}
			for upgrade in pairs(N.G.Upgrades) do
				local parent = N.treeParent(upgrade)
				if parent then
					map[parent] = map[parent] or {}
					table.insert(map[parent], upgrade)
				end
			end
			for _, children in pairs(map) do
				table.sort(children)
			end
			T.children = map
		end
		return T.children[name] or {}
	end
	function N.upgradeAvailable()
		local owned = N.field("Upgrades", {}) or {}
		local list = {}
		for name, data in pairs(N.G.Upgrades) do
			if name ~= "Start" and type(data) == "table" and not owned[name] then
				local parent = N.treeParent(name)
				if parent == nil or parent == "Start" or owned[parent] then
					table.insert(list, { name = name, price = tonumber(data.price) or math.huge, category = N.upgradeCategory(name) })
				end
			end
		end
		table.sort(list, function(a, b)
			return a.price < b.price
		end)
		return list
	end
	-- Priority branches (Roll Speed, Luck, Fortune by default) are saved for: other upgrades are only bought while
	-- they cost at most 5% of the next priority one, so cheap stuff still goes but never stalls the saving.
	function N.upgradeNext()
		local priorityPrice
		local list = {}
		for _, upgrade in ipairs(N.upgradeAvailable()) do
			if allows(Options.UpgradeCats, upgrade.category) and (N.Shop.failed[upgrade.name] or 0) < os.clock() then
				upgrade.priority = selected(Options.UpgradeFirst, upgrade.category)
				if upgrade.priority and not priorityPrice then
					priorityPrice = upgrade.price
				end
				table.insert(list, upgrade)
			end
		end
		for _, upgrade in ipairs(list) do
			if upgrade.priority or not priorityPrice or upgrade.price <= priorityPrice * 0.05 then
				return upgrade, priorityPrice
			end
		end
		return nil, priorityPrice
	end
	function N.upgradeStep()
		if not on("AutoUpgrade") or on("SmartSpend") then
			return false
		end
		local money = N.money()
		local upgrade = N.upgradeNext()
		if upgrade then
			do
				if upgrade.price > money then
					return false
				end
				fire(R.upgrade, upgrade.name)
				if waitFor(function()
					N.Data.at = -1e9
					return (N.field("Upgrades", {}) or {})[upgrade.name] == true
				end, 2) then
					Session.bought += 1
					shopNote("Bought " .. upgrade.name)
					if N.Events.bought then
						pcall(N.Events.bought, upgrade.name, upgrade.price)
					end
				else
					N.Shop.failed[upgrade.name] = os.clock() + 30
				end
				return true
			end
		end
		return false
	end
	function N.shopStep()
		return N.rebirthStep() or N.diceStep() or N.upgradeStep()
	end
end
do
