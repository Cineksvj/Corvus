do
	-- Profit engine v2 (CLAUDE.md.txt 8.00). Every way to spend cash or tickets is an option with a cost C and an
	-- expected extra plot income dI ($/s). Options are bought in falling dI/C order (the exchange argument).
	--   Rolls: the server rolls with weights luck/chance over every unit and mutation with chance/luck >= 1
	--     (RollUtil.RollUnit). The hub rebuilds that distribution and computes the expected plot income after K more
	--     drops exactly: top-S sum = integral over v of E[min(S, plot units >= v + Poisson(K * P(drop >= v)))].
	--     For small K that is drops/s * E[max(0, drop - weakest slot)], the value of the next rolls that beat the
	--     worst slot; for large K it saturates at the best units the luck can give.
	--   Luck, dice, roll speed, storage, money and rebirth all change (luck, drops/s, money multiplier, slots), so
	--     they are all valued by the same function: the plot income they lead to over time minus the plot income
	--     without them.
	--   Time: dI is averaged over the rolling 24 h horizon, weighted by e^(-rho t), where rho is the
	--     measured return of the cash the hub reinvested (gain/$ of recent purchases). A constant gain keeps its
	--     value, a gain that only arrives later (luck) is worth less when money compounds fast.
	--   Slot levels stay on the unit, so a level is only worth the time its unit is expected to stay on the plot
	--     (Poisson odds that enough better drops arrive to push it out).
	--   Rebirth wipes all cash: the excess above its cost is spent first, and it is only done when its gain per $
	--     destroyed beats what that cash would buy.
	--   Saving: when the best option is too expensive, a cheaper one is bought on the way only when it shortens the
	--     wait for the best one: (price - cash + C) / (income + dI) < (price - cash) / income.
	--   Horizon: rolling 24 h from now. Options that cannot pay back within it are skipped (rebirth is progress and stays).
	-- All rates (drops/s, cash/s, sold $/s, storage blocked time, tickets/s) are measured live.
	N.Spend = {
		at = -1e9,
		nextAt = 0,
		collectAt = -1e9,
		last = "",
		plan = {},
		cache = {},
		cacheCount = 0,
		failed = {},
		top = nil,
		spent = 0,
		ticketsSpent = 0,
		luckCache = {},
		luckCount = 0,
		retGain = 0,
		retPrice = 0,
		retAt = 0,
		planAt = -1e9,
		planBest = "",
		ticketAt = -1e9,
		ticketBest = "",
		ticketLast = "",
		rates = { at = nil, mark = nil, blocked = 0, episodes = 0, lastFull = nil },
	}
	local Sp = N.Spend
	N.DayLength = 86400
	local Samples = 8
	-- Every unit/mutation outcome with its chance and level-1 income (before money buffs), sorted by income.
	function N.rollOutcomes()
		if Sp.outcomes then
			return Sp.outcomes
		end
		local list = {}
		local ok, units = pcall(N.G.Entry.entriesOfKind, "Unit")
		local mutations = N.tableOr(N.G.Mutations)
		for name, cfg in pairs(if ok and type(units) == "table" then units else {}) do
			if type(cfg) == "table" and type(cfg.chance) == "function" then
				local base = tonumber(N.call(cfg.chance)) or 0
				if base > 0 then
					table.insert(list, { name = name, chance = base, income = tonumber(N.call(cfg.income, { level = 1 })) or 0 })
					for mutation, data in pairs(mutations) do
						local mult = tonumber(type(data) == "table" and data.chance) or 0
						if mult > 0 then
							table.insert(list, {
								name = name,
								mutation = mutation,
								chance = base * mult,
								income = tonumber(N.call(cfg.income, { mutation = mutation, level = 1 })) or 0,
							})
						end
					end
				end
			end
		end
		table.sort(list, function(a, b)
			return a.income < b.income
		end)
		Sp.outcomes = list
		return list
	end
	-- Drop distribution at a luck: incomes from high to low with q = P(drop income >= that income).
	local function luckTable(luck)
		luck = math.max(luck, 1)
		local key = string.format("%.6g", luck)
		local cached = Sp.luckCache[key]
		if cached then
			return cached
		end
		local outcomes = N.rollOutcomes()
		local total = 0
		for _, o in ipairs(outcomes) do
			if o.chance / luck >= 1 then
				total += luck / o.chance
			end
		end
		local levels = {}
		if total > 0 then
			local tail = 0
			for i = #outcomes, 1, -1 do
				local o = outcomes[i]
				if o.chance / luck >= 1 then
					tail += (luck / o.chance) / total
					local last = levels[#levels]
					if last and last.income == o.income then
						last.q = math.min(tail, 1)
					else
						table.insert(levels, { income = o.income, q = math.min(tail, 1) })
					end
				end
			end
		end
		if Sp.luckCount > 200 then
			table.clear(Sp.luckCache)
			Sp.luckCount = 0
		end
		Sp.luckCount += 1
		Sp.luckCache[key] = levels
		return levels
	end
	N.luckTable = luckTable
	-- P(drop income > v)
	local function qAbove(levels, v)
		local q = 0
		for _, level in ipairs(levels) do
			if level.income > v then
				q = level.q
			else
				break
			end
		end
		return q
	end
	-- E[min(S, c + X)], X ~ Poisson(lambda): how many of the S slots hold a unit worth at least v.
	local function expectedFilled(slots, count, lambda)
		if count >= slots then
			return slots
		end
		if lambda <= 0 then
			return count
		end
		local need = slots - count
		-- Numerical cut only: P(X < need) is below 1e-20 here.
		if lambda - need > 10 * math.sqrt(lambda) + 10 then
			return slots
		end
		local p = math.exp(-lambda)
		local short = 0
		for j = 0, need - 1 do
			short += (need - j) * p
			p = p * lambda / (j + 1)
		end
		return slots - short
	end
	-- P(X <= n), X ~ Poisson(lambda)
	local function poissonAtMost(lambda, n)
		if n < 0 then
			return 0
		end
		if lambda <= 0 then
			return 1
		end
		local p = math.exp(-lambda)
		local sum = p
		for j = 1, n do
			p = p * lambda / j
			sum += p
		end
		return math.min(sum, 1)
	end
	-- Merges the drop distribution, the plot units (high to low) and an optional one-off extra drop (spin) into
	-- the steps of the income integral. Stops once the plot alone fills every slot.
	local function buildProfile(levels, plot, slots, extra)
		local v, c, q, qe = {}, {}, {}, {}
		local li, pi, ei = 1, 1, 1
		local count, tail, tailExtra = 0, 0, 0
		while true do
			local top = 0
			if levels[li] and levels[li].income > top then
				top = levels[li].income
			end
			if plot[pi] and plot[pi] > top then
				top = plot[pi]
			end
			if extra and extra[ei] and extra[ei].income > top then
				top = extra[ei].income
			end
			if top <= 0 then
				break
			end
			while levels[li] and levels[li].income >= top do
				tail = levels[li].q
				li += 1
			end
			while plot[pi] and plot[pi] >= top do
				count += 1
				pi += 1
			end
			while extra and extra[ei] and extra[ei].income >= top do
				tailExtra = extra[ei].q
				ei += 1
			end
			table.insert(v, top)
			table.insert(c, count)
			table.insert(q, tail)
			table.insert(qe, tailExtra)
			if count >= slots then
				break
			end
		end
		return { v = v, c = c, q = q, qe = qe }
	end
	-- Expected plot income (level-1 incomes, before money buffs) after `drops` more drops.
	local function plotAfter(profile, drops, slots)
		local v, c, q, qe = profile.v, profile.c, profile.q, profile.qe
		local total = 0
		for k = 1, #v do
			local width = v[k] - (v[k + 1] or 0)
			local filled
			if c[k] >= slots then
				filled = slots
			else
				local lambda = drops * q[k]
				filled = expectedFilled(slots, c[k], lambda)
				if qe[k] > 0 then
					filled = qe[k] * expectedFilled(slots, c[k] + 1, lambda) + (1 - qe[k]) * filled
				end
			end
			total += width * filled
		end
		return total
	end
	-- Plot units (incomes before money buffs, high to low) and the slot count.
	local function currentPlot()
		local mult = math.max(N.buff("Money Multiplier", 1) or 1, 1e-9)
		local plot = {}
		for _, info in ipairs(N.units()) do
			if info.slot then
				table.insert(plot, info.income / mult)
			end
		end
		table.sort(plot, function(a, b)
			return a > b
		end)
		return plot, math.max(#N.unlockedSlots(), 1), mult
	end
	-- Expected plot income (before money buffs) that `rolls` more drops add at luck L.
	function N.rollValue(luck, rolls)
		local plot, slots = currentPlot()
		local profile = buildProfile(luckTable(luck), plot, slots, nil)
		return math.max(plotAfter(profile, rolls, slots) - plotAfter(profile, 0, slots), 0)
	end
	-- Sum of one buff bucket over the upgrades you own (luck base, money percent, sell percent).
	local function bucketSum(buffName, bucket)
		local total = 0
		for name in pairs(N.field("Upgrades", {}) or {}) do
			local data = N.G.Upgrades[name]
			local buff = type(data) == "table" and type(data.buffs) == "table" and data.buffs[buffName]
			if buff and buff.bucket == bucket then
				total += tonumber(buff.amount) or 0
			end
		end
		return total
	end
	-- Rolling 24 h horizon: always the next 24 hours from now (the hub farms forever, nothing counts down).
	function N.horizonLeft()
		return N.DayLength
	end
	function N.diceLuck(name)
		local dice = N.call(N.G.Dice.Get, name)
		return tonumber(type(dice) == "table" and dice.luck) or 1
	end
	-- Live rates, exponential moving averages over about 5 minutes (prior: the game formula).
	function N.measureRates()
		local R = Sp.rates
		local now = os.clock()
		local mark = {
			rolls = Session.rolls,
			cash = N.money() + N.pendingBalance() + Sp.spent,
			sold = Session.soldCash,
			tickets = N.amount("Tickets") + Sp.ticketsSpent,
		}
		if R.at and R.mark then
			local dt = now - R.at
			if dt < 0.5 then
				return R
			end
			local a = 1 - math.exp(-dt / 300)
			local function ema(old, value)
				return old + a * (value - old)
			end
			if on("AutoRoll") and not N.manualRunning() then
				local rollsBuff = math.max(N.buff("Rolls", 1) or 1, 1)
				R.rolls = ema(R.rolls or rollsBuff / (N.rollDuration() + N.Roll.margin), math.max(mark.rolls - R.mark.rolls, 0) / dt)
				local full = N.Roll.fullSince
				R.blocked = ema(R.blocked, if full then 1 else 0)
				R.episodes = ema(R.episodes, (if full and full ~= R.lastFull then 1 else 0) / dt)
				R.lastFull = full
			end
			R.cash = ema(R.cash or N.plotIncome(), math.max(mark.cash - R.mark.cash, 0) / dt)
			R.sold = ema(R.sold or 0, math.max(mark.sold - R.mark.sold, 0) / dt)
			R.tickets = ema(R.tickets or 0, math.max(mark.tickets - R.mark.tickets, 0) / dt)
		end
		R.at, R.mark = now, mark
		return R
	end
	-- Discount points: quantiles of e^(-rho t) on [0, T]. A constant gain averages to itself.
	local function samplePoints(rho, T)
		local list = {}
		local mass = 1 - math.exp(-rho * T)
		for i = 1, Samples do
			local u = (i - 0.5) / Samples
			table.insert(list, if mass < 1e-9 then u * T else -math.log(1 - u * mass) / rho)
		end
		return list
	end
	-- Everything the gain maths needs, read once per planning round.
	function N.spendContext()
		local now = os.clock()
		local R = Sp.rates
		local plot, slots, mult = currentPlot()
		local duration = N.rollDuration()
		local rollsBuff = math.max(N.buff("Rolls", 1) or 1, 1)
		local fullRate = rollsBuff / (duration + N.Roll.margin)
		local left = N.horizonLeft()
		-- Return of the reinvested cash: gain/$ of recent purchases, fading over about 10 minutes.
		local fade = math.exp(-math.max(now - Sp.retAt, 0) / 600)
		Sp.retGain *= fade
		Sp.retPrice *= fade
		Sp.retAt = now
		local rho = math.max(if Sp.retPrice > 0 then Sp.retGain / Sp.retPrice else 0, 1 / left)
		local buffLuck = N.buff("Luck", 1) or 1
		local diceLuck = N.diceLuck(tostring(N.field("Dice", "Basic")))
		local ctx = {
			income = math.max(N.plotIncome(), 1e-9),
			cashRate = math.max(R.cash or N.plotIncome(), N.plotIncome(), 1e-9),
			money = N.money(),
			mult = mult,
			plot = plot,
			slots = slots,
			buffLuck = buffLuck,
			diceLuck = diceLuck,
			luck = diceLuck * buffLuck,
			duration = duration,
			rollsBuff = rollsBuff,
			fullRate = fullRate,
			rate = R.rolls or fullRate * (1 - R.blocked),
			blocked = R.blocked,
			episodes = R.episodes,
			luckBase = 1 + bucketSum("Luck", "base"),
			moneyPercent = 1 + bucketSum("Money Multiplier", "percentage"),
			sellPercent = 1 + bucketSum("Sell Multiplier", "percentage"),
			sellRate = R.sold or 0,
			left = left,
			rho = rho,
			samples = samplePoints(rho, left),
			profiles = {},
			values = {},
		}
		return ctx
	end
	-- Discounted average plot income (before money buffs) at a luck and drop rate.
	local function valueOf(ctx, luck, rate, change)
		local plot = change and change.plot or ctx.plot
		local slots = change and change.slots or ctx.slots
		local extraLuck = change and change.extraLuck
		local tag = (change and change.tag or "") .. "|" .. (if extraLuck then string.format("%.6g", extraLuck) else "")
		local key = string.format("%.6g|%.6g|", luck, rate) .. tag
		local hit = ctx.values[key]
		if hit then
			return hit
		end
		local profileKey = string.format("%.6g|", luck) .. tag
		local profile = ctx.profiles[profileKey]
		if not profile then
			profile = buildProfile(luckTable(luck), plot, slots, if extraLuck then luckTable(extraLuck) else nil)
			ctx.profiles[profileKey] = profile
		end
		local sum = 0
		for _, t in ipairs(ctx.samples) do
			sum += plotAfter(profile, rate * t, slots)
		end
		local value = sum / #ctx.samples
		ctx.values[key] = value
		return value
	end
	-- Extra $/s of a change: { luck, rate, moneyRatio, plot, slots, extraLuck, tag }.
	function N.changeGain(ctx, change)
		local after = valueOf(ctx, change.luck or ctx.luck, change.rate or ctx.rate, change)
		local before = valueOf(ctx, ctx.luck, ctx.rate, nil)
		return ((change.moneyRatio or 1) * after - before) * ctx.mult
	end
	-- Share of the horizon a plot unit is expected to stay on the plot (better drops push it out).
	local function survival(ctx, info)
		local v = info.income / ctx.mult
		local rank = 1
		for _, other in ipairs(ctx.plot) do
			if other > v then
				rank += 1
			end
		end
		local q = qAbove(luckTable(ctx.luck), v)
		local sum = 0
		for _, t in ipairs(ctx.samples) do
			sum += poissonAtMost(ctx.rate * t * q, ctx.slots - rank)
		end
		return sum / #ctx.samples
	end
	local function newDelta()
		return { money = 0, luck = 0, duration = 0, sell = 0, storage = 0 }
	end
	local function addUpgrade(into, name)
		local data = N.G.Upgrades[name]
		local buffs = type(data) == "table" and type(data.buffs) == "table" and data.buffs or {}
		for buffName, buff in pairs(buffs) do
			local amount = tonumber(buff.amount) or 0
			if buffName == "Money Multiplier" and buff.bucket == "percentage" then
				into.money += amount
			elseif buffName == "Luck" and buff.bucket == "base" then
				into.luck += amount
			elseif buffName == "Roll Duration" then
				into.duration += amount
			elseif buffName == "Sell Multiplier" and buff.bucket == "percentage" then
				into.sell += amount
			elseif buffName == "Unit Storage" then
				into.storage += amount
			end
			-- Damage, health, walkspeed, trait/grade luck: no cash (towers pay boosts, gems and rerolls), worth 0 on
			-- their own; they are bought only when they open a branch that pays (path lookahead).
		end
	end
	-- Extra $/s from a summed change of buffs.
	local function deltaGain(d, ctx)
		local change = {}
		if d.luck ~= 0 then
			change.luck = ctx.luck * (ctx.luckBase + d.luck) / math.max(ctx.luckBase, 1e-9)
		end
		local rate = ctx.rate
		if d.duration ~= 0 then
			rate = rate * ctx.duration / math.max(ctx.duration + d.duration, 0.2)
		end
		if d.storage ~= 0 then
			-- Each time the storage fills, `storage` more drops fit before rolling stops (measured fills per second),
			-- never more than the drops that were blocked.
			rate += math.min(ctx.blocked * ctx.fullRate, d.storage * ctx.episodes)
		end
		if rate ~= ctx.rate then
			change.rate = rate
		end
		if d.money ~= 0 then
			change.moneyRatio = (ctx.moneyPercent + d.money) / math.max(ctx.moneyPercent, 1e-9)
		end
		local gain = 0
		if change.luck or change.rate or change.moneyRatio then
			gain = N.changeGain(ctx, change)
		end
		if d.sell ~= 0 then
			gain += ctx.sellRate * d.sell / math.max(ctx.sellPercent, 1e-9)
		end
		return gain
	end
	-- Best payback of buying `head` and then walking down its children (max 3 steps): returns payback and the
	-- upgrade that makes it worth it.
	local function bestPath(head, ctx, owned)
		local d = newDelta()
		addUpgrade(d, head.name)
		local gain = deltaGain(d, ctx)
		local best, via = if gain > 0 then head.price / gain else math.huge, nil
		local function walk(name, depth, price, sum)
			for _, child in ipairs(N.treeChildren(name)) do
				local data = N.G.Upgrades[child]
				if type(data) == "table" and not owned[child] and allows(Options.UpgradeCats, N.upgradeCategory(child)) then
					local total = price + (tonumber(data.price) or math.huge)
					local nextSum = table.clone(sum)
					addUpgrade(nextSum, child)
					local g = deltaGain(nextSum, ctx)
					if g > 0 and total / g < best then
						best, via = total / g, child
					end
					if depth < 3 then
						walk(child, depth + 1, total, nextSum)
					end
				end
			end
		end
		walk(head.name, 1, head.price, d)
		return best, via
	end
	-- The next rebirth: luck and money multipliers, plus the slots it opens filled with the best spare units.
	local function rebirthChange(ctx, nextData, current)
		local moneyRatio = (tonumber(nextData.moneyMultiplier) or 1) / math.max(tonumber(current.moneyMultiplier) or 1, 1e-9)
		local luckRatio = (tonumber(nextData.luckMultiplier) or 1) / math.max(tonumber(current.luckMultiplier) or 1, 1e-9)
		local rebirth = N.rebirth()
		local opened = 0
		for i = 1, N.maxSlots() do
			local ok, need = pcall(N.G.Plot.GetSlotRebirthRequirement, i)
			if ok and type(need) == "number" and need > rebirth and need <= rebirth + 1 then
				opened += 1
			end
		end
		local plot = ctx.plot
		if opened > 0 then
			plot = table.clone(ctx.plot)
			local left = opened
			for _, info in ipairs(N.units()) do
				if not info.slot and left > 0 then
					table.insert(plot, info.income / ctx.mult)
					left -= 1
				end
			end
			table.sort(plot, function(a, b)
				return a > b
			end)
		end
		return { luck = ctx.luck * luckRatio, moneyRatio = moneyRatio, plot = plot, slots = ctx.slots + opened, tag = "rebirth" }
	end
	function N.spendOptions()
		local list = {}
		local now = os.clock()
		local ctx = N.spendContext()
		Sp.ctx = ctx
		local owned = N.field("Upgrades", {}) or {}
		local function add(kind, name, price, gain, buy, done, progress)
			if price and price > 0 and gain and gain > 0 and (Sp.failed[name] or 0) <= now then
				local payback = price / gain
				-- Rolling 24 h horizon: what cannot pay back within it is skipped, unless it is progress that counts on
				-- its own (rebirth).
				if payback <= ctx.left or progress then
					local option = { kind = kind, name = name, price = price, gain = gain, payback = payback, ratio = gain / price, buy = buy, done = done }
					table.insert(list, option)
					return option
				end
			end
			return nil
		end
		-- Always ranked by payback here, whatever the Level Strategy says (that one only drives Auto Level).
		for i, option in ipairs(N.levelOptions("Fastest payback")) do
			if i > 8 then
				break
			end
			local info = option.info
			local key, slot, before = info.key, info.slot, info.level
			add("Level", string.format("Slot %d %s Lv %d", slot, info.name, before + 1), option.price, option.gain * survival(ctx, info), function()
				fire(N.R.levelUp, slot)
			end, function()
				local item = N.inventory()[key]
				local attrs = type(item) == "table" and item.attributes
				return (tonumber(type(attrs) == "table" and attrs.level) or 1) > before
			end)
		end
		if allows(Options.SpendOn, "Dice") then
			for _, dice in ipairs(N.diceList()) do
				if dice.price and not N.ownsDice(dice.name) and dice.luck > ctx.diceLuck then
					local name = dice.name
					add("Dice", name .. " Dice", dice.price, N.changeGain(ctx, { luck = dice.luck * ctx.buffLuck }), function()
						fire(N.R.buyDice, name)
					end, function()
						return N.ownsDice(name)
					end)
				end
			end
		end
		if allows(Options.SpendOn, "Upgrades") then
			for _, upgrade in ipairs(N.upgradeAvailable()) do
				if allows(Options.UpgradeCats, upgrade.category) and (Sp.failed[upgrade.name] or 0) <= now then
					local payback, via = bestPath(upgrade, ctx, owned)
					if payback < math.huge then
						local name = upgrade.name
						local option = add("Upgrade", name, upgrade.price, upgrade.price / payback, function()
							fire(N.R.upgrade, name)
						end, function()
							return (N.field("Upgrades", {}) or {})[name] == true
						end)
						if option and via then
							option.label = name .. " (opens " .. via .. ")"
						end
					end
				end
			end
		end
		if allows(Options.SpendOn, "Rebirth") then
			local nextData = N.nextRebirth()
			local current = N.call(N.G.Rebirths.Get, N.rebirth())
			if nextData and type(current) == "table" then
				local gain = N.changeGain(ctx, rebirthChange(ctx, nextData, current))
				local before = N.rebirth()
				local cost = math.max(tonumber(nextData.cost) or 0, 1)
				local option = add("Rebirth", "Rebirth " .. (before + 1), cost, gain, function()
					fire(N.R.rebirth)
				end, function()
					return N.rebirth() > before
				end, true)
				if option then
					option.need = cost
				end
			end
		end
		table.sort(list, function(a, b)
			return a.ratio > b.ratio
		end)
		return list
	end
	local function canPay(option, money)
		return option.price <= money
	end
	-- Returns the option to buy now (or nil), the option the hub is working towards and the seconds to afford it.
	function N.spendPick()
		local list = N.spendOptions()
		Sp.plan = list
		local best = list[1]
		Sp.top = best
		if not best then
			Sp.last = "Nothing pays back within 24 hours"
			return nil, nil, 0
		end
		local money = N.money()
		local income = Sp.ctx.cashRate
		if best.kind == "Rebirth" and money >= best.price then
			-- A rebirth wipes all cash: first spend what is above its cost on anything that pays back in time.
			for _, option in ipairs(list) do
				if option.kind ~= "Rebirth" and option.price <= money - best.price then
					return option, best, 0
				end
			end
			-- Nothing fits: rebirth only when its gain per $ destroyed beats what that cash would buy.
			local alt
			for _, option in ipairs(list) do
				if option.kind ~= "Rebirth" then
					alt = option
					break
				end
			end
			if not alt or best.gain / money >= alt.ratio then
				return best, best, 0
			end
			best = alt
			Sp.top = alt
		end
		if canPay(best, money) then
			return best, best, 0
		end
		local wait = (best.price - money) / income
		-- Saving: a cheaper option is bought on the way only when it shortens the wait for the best one.
		for _, option in ipairs(list) do
			if option ~= best and canPay(option, money) then
				local kept = if option.kind == "Rebirth" then 0 else money - option.price
				if (best.price - kept) / (income + option.gain) < wait then
					return option, best, wait
				end
			end
		end
		Sp.last = string.format("Saving for %s ($%s, %s)", best.label or best.name, formatNumber(best.price), N.longTime(wait))
		return nil, best, wait
	end
	local function short(x)
		return string.format("%.3g", x)
	end
	-- PLAN log line: when the target changes, else once a minute.
	function N.planLog(target, wait, pick)
		local list = Sp.plan or {}
		local ctx = Sp.ctx
		local name = if target then target.label or target.name else "none"
		local now = os.clock()
		if not ctx or (name == Sp.planBest and now - Sp.planAt < 60) then
			return
		end
		Sp.planBest, Sp.planAt = name, now
		local alts = {}
		for _, option in ipairs(list) do
			if option ~= target and #alts < 2 then
				table.insert(alts, string.format("%s %s", option.label or option.name, short(option.ratio)))
			end
		end
		log(
			string.format(
				"PLAN best=%s gain/$=%s eta=%ds alt=%s | buy=%s drops/s=%s blocked=%d%% income=%s/s rho=%s left=%.1fh",
				name,
				if target then short(target.ratio) else "0",
				math.floor(wait or 0),
				if #alts > 0 then table.concat(alts, ", ") else "none",
				if pick then pick.label or pick.name else "wait",
				short(ctx.rate),
				math.floor(ctx.blocked * 100 + 0.5),
				formatNumber(ctx.cashRate),
				short(ctx.rho),
				ctx.left / 3600
			)
		)
	end
	-- Cash that is still sitting on the plot slots.
	function N.pendingBalance()
		local total = 0
		for slot, info in pairs(N.slots()) do
			local index = tonumber(slot)
			local balance = type(info) == "table" and tonumber(info.balance) or 0
			if balance > 0 and index and N.slotUnlocked(index) then
				total += balance
			end
		end
		return total
	end
	function N.spendStep()
		if not on("SmartSpend") then
			return false
		end
		local now = os.clock()
		if now < Sp.nextAt then
			return false
		end
		-- Nothing bought: plan again in 2 seconds (the plan only changes when cash or the game state does).
		Sp.nextAt = now + 2
		N.measureRates()
		local pick, target, wait = N.spendPick()
		N.planLog(target, wait, pick)
		if not pick then
			-- The cash for the next purchase may already be waiting on the plot.
			local top = Sp.top
			if top and on("AutoCollect") and now - Sp.collectAt > 1.5 then
				local pending = N.pendingBalance()
				if pending > 0 and top.price <= N.money() + pending then
					Sp.collectAt = now
					N.collectStep()
					N.Data.at = -1e9
					Sp.nextAt = now + 0.3
				end
			end
			return false
		end
		Sp.at = now
		local cashBefore = N.money()
		pick.buy()
		local gone = waitFor(function()
			N.Data.at = -1e9
			return pick.done()
		end, if pick.kind == "Rebirth" then 3 else 2)
		N.UnitCache.at = -1e9
		N.Data.at = -1e9
		table.clear(Sp.cache)
		Sp.cacheCount = 0
		if not gone then
			Sp.failed[pick.name] = os.clock() + 30
			Sp.last = string.format("%s did not go through, trying something else", pick.name)
			log("SPEND failed", pick.kind, pick.name, "price", pick.price, "cash", N.money())
			Sp.nextAt = os.clock() + 0.3
			return true
		end
		local paid = if pick.kind == "Rebirth" then math.max(cashBefore, pick.price) else pick.price
		Sp.spent += paid
		Sp.retGain += pick.gain
		Sp.retPrice += paid
		if pick.kind == "Level" then
			Session.levels += 1
		else
			Session.bought += 1
		end
		Sp.nextAt = 0
		Sp.last = string.format("Bought %s for $%s (pays back in %s)", pick.label or pick.name, formatNumber(paid), N.longTime(paid / pick.gain))
		log("SPEND", pick.kind, pick.label or pick.name, "price", paid, "gain/s", pick.gain, "gain/$", short(pick.gain / paid), "payback", math.floor(paid / pick.gain))
		table.insert(N.Shop.log, 1, pick.name)
		while #N.Shop.log > 5 do
			table.remove(N.Shop.log)
		end
		if pick.kind == "Rebirth" then
			Session.rebirths += 1
			if N.Events.rebirth then
				pcall(N.Events.rebirth, N.rebirth())
			end
		elseif pick.kind ~= "Level" and N.Events.bought then
			pcall(N.Events.bought, pick.name, pick.price)
		end
		return true
	end
	-- Tickets (quest shop): gamepasses and Lucky Spins on the same dI per ticket scale. Tickets earn nothing
	-- themselves, so the best dI/ticket is always bought first and saved for (Smith's rule).
	function N.ticketOptions(ctx)
		local list = {}
		local passes = N.tableOr(N.G.Monetization).Gamepasses
		if on("AutoTicketPasses") and type(passes) == "table" then
			for _, name in ipairs(N.TicketPasses) do
				local data = passes[name]
				if not N.ownsPass(name) and type(data) == "table" and type(data.buffs) == "table" then
					local change = {}
					for buffName, buff in pairs(data.buffs) do
						local amount = tonumber(buff.amount) or 0
						if buffName == "Luck" and buff.bucket == "multiplier" then
							change.luck = (change.luck or ctx.luck) * amount
						elseif buffName == "Money Multiplier" and buff.bucket == "multiplier" then
							change.moneyRatio = (change.moneyRatio or 1) * amount
						elseif buffName == "Roll Duration" then
							change.rate = (change.rate or ctx.rate) * ctx.duration / math.max(ctx.duration + amount, 0.2)
						elseif buffName == "Rolls" then
							change.rate = (change.rate or ctx.rate) * (ctx.rollsBuff + amount) / ctx.rollsBuff
						end
					end
					local price = N.ticketPrice(name)
					local gain = N.changeGain(ctx, change)
					if price < math.huge and gain > 0 then
						table.insert(list, { name = name, price = price, gain = gain, ratio = gain / price })
					end
				end
			end
		end
		if on("AutoTicketSpins") then
			local spin = N.entry("Lucky Spin")
			local mult = tonumber(spin and spin.luckMultiplier)
			local price = N.ticketPrice("Lucky Spin")
			if mult and price < math.huge then
				local gain = N.changeGain(ctx, { extraLuck = ctx.luck * mult, tag = "spin" })
				if gain > 0 then
					table.insert(list, { name = "Lucky Spin", price = price, gain = gain, ratio = gain / price })
				end
			end
		end
		table.sort(list, function(a, b)
			return a.ratio > b.ratio
		end)
		return list
	end
	function N.ticketStep()
		if N.opExcluded("Tickets") then
			return false
		end
		N.measureRates()
		local ctx = N.spendContext()
		local list = N.ticketOptions(ctx)
		local best = list[1]
		if not best then
			return false
		end
		local tickets = N.amount("Tickets")
		local wait = if best.price <= tickets then 0 else (best.price - tickets) / math.max(Sp.rates.tickets or 0, 1e-9)
		local now = os.clock()
		if best.name ~= Sp.ticketBest or now - Sp.ticketAt > 120 then
			Sp.ticketBest, Sp.ticketAt = best.name, now
			local alt = list[2]
			log(string.format("PLAN tickets best=%s gain/ticket=%s eta=%s alt=%s", best.name, short(best.ratio), if wait < 1e8 then math.floor(wait) .. "s" else "never", if alt then alt.name .. " " .. short(alt.ratio) else "none"))
		end
		if best.price > tickets then
			Sp.ticketLast = string.format("Saving tickets for %s (%d/%d)", best.name, tickets, best.price)
			return false
		end
		fire(N.R.questBuy, best.name)
		Sp.ticketsSpent += best.price
		Sp.ticketLast = "Bought " .. best.name .. " with tickets"
		log("TICKETS bought", best.name, "price", best.price, "gain/s", best.gain)
		return true
	end
	function N.spendText()
		local rows = {}
		for i, option in ipairs(Sp.plan or {}) do
			if i > 6 then
				break
			end
			table.insert(rows, string.format("%d. %s (costs $%s, pays itself back in %s)", i, option.label or option.name, formatNumber(option.price), N.longTime(option.payback)))
		end
		return (if #rows > 0 then table.concat(rows, "\n") else "Nothing worth buying yet") .. (if Sp.last ~= "" then "\n" .. Sp.last else "")
	end
end
-- Towers are fought on the server: PlayTower starts a run with your tower team, every CompleteTowerFloor plays out
-- one floor and the server refuses the next call until the fight animation time has passed.
N.Tower = { running = false, name = nil, floor = 0, best = {}, lastText = "", teamAt = -1e9, autoOffAt = -1e9, rewards = {} }
do
	local T = N.Tower
	local R = N.R
	function N.towerList()
		local list = {}
		local ok, all = pcall(N.G.Towers.GetAll)
		for name, data in pairs(if ok and type(all) == "table" then all else {}) do
			if type(data) == "table" then
				table.insert(list, { name = name, order = tonumber(data.order) or 99, maxFloors = tonumber(data.maxFloors), data = data })
			end
		end
		table.sort(list, function(a, b)
			return a.order < b.order
		end)
		return list
	end
	function N.towerNames()
		local names = { "Best I can finish" }
		for _, tower in ipairs(N.towerList()) do
			table.insert(names, tower.name)
		end
		return names
	end
	-- The team the server will use: the saved tower team, or the 4 hardest hitters if none is saved yet.
	function N.towerTeam()
		local _, byKey = N.units()
		local team = {}
		local saved = N.field("TowerTeam", {}) or {}
		for i = 1, 4 do
			local info = saved[i] and byKey[saved[i]]
			if info then
				table.insert(team, info)
			end
		end
		if #team == 0 then
			local list = table.clone(N.units())
			table.sort(list, function(a, b)
				return a.damage > b.damage
			end)
			for i = 1, math.min(4, #list) do
				table.insert(team, list[i])
			end
		end
		local damageMult = N.buff("Damage Multiplier", 1) or 1
		local healthMult = N.buff("Health Multiplier", 1) or 1
		local out = {}
		for _, info in ipairs(team) do
			table.insert(out, { damage = info.damage * damageMult, health = info.health * healthMult })
		end
		return out
	end
	-- Same fight rules as the server: one hit each way per exchange, the next member steps in when one falls.
	function N.simulateTower(tower, team)
		local data = tower.data
		local floor, member = 1, 1
		local hp = {}
		for i, unit in ipairs(team) do
			hp[i] = unit.health
		end
		local cap = tower.maxFloors or 400
		local steps = 0
		while member <= #team and floor <= cap and steps < 20000 do
			local enemy = tonumber(N.call(data.enemyHealth, floor)) or math.huge
			local hit = tonumber(N.call(data.enemyDamage, floor)) or math.huge
			while member <= #team and steps < 20000 do
				steps += 1
				enemy -= team[member].damage
				if enemy <= 0 then
					break
				end
				hp[member] -= hit
				if hp[member] <= 0 then
					member += 1
				end
			end
			if member > #team then
				break
			end
			floor += 1
		end
		local cleared = floor - 1
		return cleared, tower.maxFloors ~= nil and cleared >= tower.maxFloors
	end
	function N.pickTower()
		local want = optionText("TowerPick", "Best I can finish")
		local list = N.towerList()
		if want ~= "Best I can finish" then
			for _, tower in ipairs(list) do
				if tower.name == want then
					return tower, nil
				end
			end
		end
		local team = N.towerTeam()
		if #team == 0 then
			return nil, "You need units for a tower team"
		end
		local pick, easiest
		for _, tower in ipairs(list) do
			if tower.maxFloors then
				local cleared, finished = N.simulateTower(tower, team)
				T.best[tower.name] = cleared
				easiest = easiest or tower
				if finished then
					pick = tower
				end
			end
		end
		return pick or easiest, nil
	end
	function N.sequenceWait(sequence)
		local refs = N.G.TowerRefs
		local waits = type(refs.ActionWaitTime) == "table" and refs.ActionWaitTime or {}
		local starts = type(refs.FloorStartedWaitTime) == "table" and refs.FloorStartedWaitTime or {}
		local total = 0
		for i, step in ipairs(sequence) do
			if step.action == "floorStarted" then
				local previous = sequence[i - 1]
				if i == 1 then
					total += if step.floor ~= 1 then tonumber(starts.transition) or 0.38 else tonumber(starts.initial) or 0.76
				elseif previous and previous.action == "memberDefeated" then
					total += tonumber(starts.transition) or 0.38
				else
					total += tonumber(starts.repeated) or 0
				end
			else
				total += tonumber(waits[step.action]) or 0.62
			end
		end
		return total
	end
	function N.towerRun()
		if T.running then
			return false
		end
		local tower, problem = N.pickTower()
		if not tower then
			T.lastText = problem or "No tower found"
			return false
		end
		if N.field("AutoTower", "") ~= "" and os.clock() - T.autoOffAt > 10 then
			T.autoOffAt = os.clock()
			fire(R.autoTower, false)
		end
		if on("TowerEquipTeam") and os.clock() - T.teamAt > 60 then
			T.teamAt = os.clock()
			fire(R.teamBest)
			task.wait(1.2)
		end
		local ok, started = invoke(R.playTower, 10, tower.name)
		if not ok or started ~= true then
			T.lastText = "Could not start " .. tower.name .. " (needs a tower team, retrying)"
			task.wait(3.5)
			return false
		end
		T.running, T.name, T.floor = true, tower.name, 0
		Session.towerRuns += 1
		local rewards = {}
		local finished, misses = false, 0
		-- An error in the loop must never leave T.running stuck on (the tower would never run again).
		local loopOk, loopError = pcall(function()
			while alive() and on("AutoTower") do
				local okFloor, sequence = invoke(R.floor, 10)
				if not okFloor or type(sequence) ~= "table" then
					misses += 1
					if misses > 40 then
						break
					end
					task.wait(0.25)
				else
					misses = 0
					local ended = false
					for _, step in ipairs(sequence) do
						if step.action == "floorCompleted" then
							T.floor = tonumber(step.floor) or T.floor + 1
							Session.towerFloors += 1
							for name, amount in pairs(type(step.rewards) == "table" and step.rewards or {}) do
								rewards[name] = (rewards[name] or 0) + (tonumber(amount) or 0)
							end
						elseif step.action == "ended" then
							ended = true
						end
					end
					setStatus(string.format("%s  \u{00B7}  floor %d", tower.name, T.floor))
					task.wait(N.sequenceWait(sequence) + 0.05)
					if ended then
						finished = tower.maxFloors ~= nil and T.floor >= tower.maxFloors
						break
					end
				end
			end
		end)
		if not loopOk then
			log("ERROR", "tower run", tostring(loopError))
		end
		if not on("AutoTower") or not loopOk then
			invoke(R.cancelTower, 5)
		end
		if finished then
			Session.towerClears += 1
		end
		local parts = {}
		for name, amount in pairs(rewards) do
			table.insert(parts, formatNumber(amount) .. "x " .. name)
		end
		table.sort(parts)
		T.rewards = parts
		T.lastText = string.format("%s: reached floor %d%s", tower.name, T.floor, if finished then " (cleared)" else "")
		log("TOWER", T.lastText, table.concat(parts, ", "))
		if N.Events.tower then
			pcall(N.Events.tower, tower.name, T.floor, finished, parts)
		end
		T.running = false
		return true
	end
end
