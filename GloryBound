-- groupbox:AddBars({ Columns = 12, Text = "...", Height = 64 }) -> bars:Set({ {label, value}, ... })
-- Metal columns normalised to the max, last column bright, hover shows "label · value".
function Groupbox:AddBars(props)
    props = props or {}
    local n = math.clamp(tonumber(props.Columns) or 12, 2, 48)
    local H = tonumber(props.Height) or 64
    local hasTitle = type(props.Text) == "string" and props.Text ~= ""
    local holder = makeRow(self, H + (hasTitle and 18 or 0) + 4, "Bars")
    if hasTitle then
        text({ Name = "Title", Text = props.Text, TextSize = T(11, 12), FontFace = Fonts.InterMed or Fonts.Sans, TextColor3 = Colors.Smoke, Size = UDim2.new(1, 0, 0, 14), Parent = holder })
    end
    local area = new("Frame", {
        Name = "Area",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, H),
        Position = UDim2.new(0, 0, 0, hasTitle and 18 or 0),
        Parent = holder,
    })
    -- Bench: slate columns on a 1 px rule, the newest column saffron (the chart's needle).
    -- Hairline columns, no gradient, no corners: the same language as the hero sparkline.
    local base = new("Frame", { Name = "Base", BackgroundColor3 = Colors.Outline, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, 0), Parent = area })
    local tip = text({
        Name = "Tip",
        Text = "",
        TextSize = 12,
        FontFace = Fonts.OswaldMed or Fonts.Display or Fonts.Mono,
        TextColor3 = Colors.Amber,
        TextXAlignment = Enum.TextXAlignment.Right,
        Size = UDim2.new(1, 0, 0, 14),
        Position = UDim2.new(0, 0, 0, hasTitle and 2 or -14),
        Parent = holder,
    })
    local bars = {}
    for i = 1, n do
        local b = new("Frame", {
            Name = "B" .. i,
            BackgroundColor3 = i == n and Colors.Amber or Colors.Smoke,
            BackgroundTransparency = i == n and 0 or 0.5,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.new((i - 1) / n, 2, 1, -1),
            Size = UDim2.new(1 / n, -4, 0.04, 0),
            Parent = area,
        })
        b.MouseEnter:Connect(function()
            local l, v = b:GetAttribute("L"), b:GetAttribute("V")
            tip.Text = (l and (tostring(l) .. ": ") or "") .. tostring(v or "")
        end)
        b.MouseLeave:Connect(function() tip.Text = "" end)
        bars[i] = b
    end
    local api = { Type = "Bars", Instance = holder, Bars = bars }
    function api:Set(list, fmt)
        list = type(list) == "table" and list or {}
        local maxv = 0
        for _, d in ipairs(list) do
            local v = tonumber(type(d) == "table" and d.value or d) or 0
            if v > maxv then maxv = v end
        end
        for i = 1, n do
            local idx = #list - n + i
            local d = list[idx]
            local b = bars[i]
            if d ~= nil then
                local v = tonumber(type(d) == "table" and d.value or d) or 0
                local h = maxv > 0 and math.max(0.04, v / maxv) or 0.04
                local target = UDim2.new(1 / n, -2, h, 0)
                if b.Size ~= target then tween(b, 0.3, nil, { Size = target }) end
                b:SetAttribute("L", type(d) == "table" and d.label or nil)
                b:SetAttribute("V", type(fmt) == "function" and fmt(v) or tostring(v))
                if not b.Visible then b.Visible = true end
            elseif b.Visible then
                b.Visible = false
            end
        end
    end
    table.insert(self._controls, api)
    return api
end

