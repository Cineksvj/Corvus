-- armor: the save's OwnedArmor = { [uid] = armorId }, EquippedArmor = { [slot] = uid }; Defs.Armor.byId[id] = { slot,
-- rarity, vitality (Armor.VitalityTable[slot][rarity], HP_PER_VITALITY each) }. ArmorEquip(uid) is lobby-only
-- (ChestController: "Prison only"). The highest-vitality owned piece per slot, one equip per 2 s.
local ArmorDef
pcall(function() ArmorDef = require(Shared:WaitForChild("Defs", 10):WaitForChild("Armor", 10)) end)
local function armorStep(now)
	if not cfg.armor or not N.inLobby or type(ArmorDef) ~= "table" or type(ArmorDef.byId) ~= "table" or now - st.armorAt < 2 then
		return
	end
	local owned, eq = st.data.OwnedArmor, st.data.EquippedArmor
	if type(owned) ~= "table" then
		return
	end
	eq = type(eq) == "table" and eq or {}
	local function vitOf(uid)
		local id = uid and owned[uid]
		id = type(id) == "table" and id.id or id
		local def = type(id) == "string" and ArmorDef.byId[id]
		return def and num(def.vitality) or -1, def
	end
	local best = {}
	for uid in pairs(owned) do
		local v, def = vitOf(uid)
		if def and def.slot and cfg.gearSlots[def.slot] and (not best[def.slot] or v > best[def.slot].vit) then
			best[def.slot] = { uid = uid, vit = v }
		end
	end
	for slot, b in pairs(best) do
		local cur = eq[slot]
		if b.uid ~= cur and b.vit > (vitOf(cur)) then
			st.armorAt = now
			if N.fire("ArmorEquip", b.uid) then
				st.armorEquips += 1
				log("ARMOR equip", slot, "vitality", b.vit, "uid", tostring(b.uid))
			end
			return
		end
	end
end
-- weapons: the save's OwnedWeapons = { [id] = true }, SelectedWeapons = { [kit] = id }; Defs.Weapons.byId[id] = { class,
-- kit, damage, critChance, critMult, attackSpeed }. WeaponEquip(id) selects it for its kit. Best = the expected hit
-- (damage x crit) per attack time (attackSpeed shortens it: Bow of Apollo 0.28 -> cooldownMult 0.72), per class picked
local WeaponDef
pcall(function() WeaponDef = require(Shared:WaitForChild("Defs", 10):WaitForChild("Weapons", 10)) end)
function N.weaponScore(def)
	local crit = math.clamp(num(def.critChance), 0, 1) * math.max(0, num(def.critMult, 1) - 1)
	return num(def.damage) * (1 + crit) / math.max(0.2, 1 - num(def.attackSpeed))
end
local function weaponStep(now)
	if not cfg.armor or not N.inLobby or type(WeaponDef) ~= "table" or type(WeaponDef.byId) ~= "table" or now - st.weaponAt < 2 then
		return
	end
	local owned, sel = st.data.OwnedWeapons, st.data.SelectedWeapons
	if type(owned) ~= "table" then
		return
	end
	sel = type(sel) == "table" and sel or {}
	local best = {}
	for id, have in pairs(owned) do
		local def = have and WeaponDef.byId[id]
		if def and def.class and def.kit and cfg.gearSlots[def.class] then
			local s = N.weaponScore(def)
			if not best[def.kit] or s > best[def.kit].score then
				best[def.kit] = { id = id, score = s }
			end
		end
	end
	for kit, b in pairs(best) do
		local cur = sel[kit] and WeaponDef.byId[sel[kit]]
		if b.id ~= sel[kit] and b.score > (cur and N.weaponScore(cur) or -1) + 0.01 and now - (st.weaponTried[b.id] or -99) > 30 then
			st.weaponAt = now
			st.weaponTried[b.id] = now -- a refused equip (kit rule) is not spammed
			if N.fire("WeaponEquip", b.id) then
				st.weaponEquips += 1
				log("WEAPON equip", kit, b.id, string.format("score %.1f", b.score))
			end
			return
		end
	end
end
