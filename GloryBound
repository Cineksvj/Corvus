-- arrow) and the fire->CombatFx round trip. Probe (round 2): every hop size incl. 40 st / chains is on the server in <= 0.3 s.
local lagEst, rttEst, waveDesync = 0.35, 0.25, 0
local watched = setmetatable({}, { __mode = "k" })
local lastHitAt = setmetatable({}, { __mode = "k" }) -- os.clock() of our last registered hit per mob (hit-stun hold)
local fxCredAt = setmetatable({}, { __mode = "k" }) -- per mob: the last arrow credited by CombatFx / by Health, the last burn tick
local hpCredAt = setmetatable({}, { __mode = "k" })
local burnAt = setmetatable({}, { __mode = "k" })
local function creditHit(i, now, via)
	local s = table.remove(pending, i)
	lastHitAt[s.target] = now
	stats.hits += 1
	waveHitShots += 1
	waveFx[via] += 1
	if s.nonStop then nonStopHits += 1 end
	if s.charged then chargedHits += 1 end
end
local function watch(m)
	if watched[m] or not m:IsA("Model") then return end
	watched[m] = true
	local last = tonumber(m:GetAttribute("Health")) or 0
	m:GetAttributeChangedSignal("Health"):Connect(function()
		local h = tonumber(m:GetAttribute("Health")) or 0
		if h < last and run then
			stats.dmgDealt += last - h; waveDmgDealt += last - h
			local now = os.clock()
			-- the CombatFx hit of this blow came first (it credited the arrow) or it is a burn tick: nothing to credit
			if now - (fxCredAt[m] or -9) > 0.4 and now - (burnAt[m] or -9) > 0.3 then
				for i, s in ipairs(pending) do -- the oldest unresolved arrow at this mob: hit
					if s.target == m then hpCredAt[m] = now creditHit(i, now, "hp") break end
				end
			end
		end
		last = h
	end)
end
for _, m in ipairs(CS:GetTagged("Enemy")) do watch(m) end
