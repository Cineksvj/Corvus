local lastHp, lastWave, waveShots, waveDmg, waveBlinks, waveStart = nil, nil, 0, 0, 0, 0
-- hit register (owner: every single point of damage gets a cause, and a rule that makes that cause never repeat).
-- one line per hp drop: who, with what, its state/distance now and 0.5 s earlier, what we were doing, the last hop, the last
-- server reset, where the server had us; cause from a closed list. Console + gb_hits.log (survives the lobby teleport).
local waveCauses, hitLog = {}, {}
getgenv().GB_Hits = hitLog
local waveObj = { maxProg = 0 }
local lastObjKind, lastInObj, lastWhy = nil, false, nil
local function hist(m, now, ago) -- the youngest velHist sample at least `ago` s old
	local h, best = velHist[m], nil
	if h then for _, s in ipairs(h) do if now - s.at >= ago then best = s end end end
	return best
end
local lastTc -- the last frame's contact time of the threat (hit register)
local function logHit(dmg, hrp, now)
	local list = enemies()
	local me0 = hrp.Position
	local mv = moves[#moves]
	local sinceHop = mv and now - mv.at or 99
	-- 00:13-00:24: 9 x "unknown_source" with srvOff ~30 and the hop 0.02-0.17 s old: the blow landed on the spot we had just
	-- left (the server still had us there) and the search around the NEW spot found nobody. Search where the server had us
	local me = (mv and sinceHop < lagEst + 0.3) and mv.from or me0
	local ph = lastPlayerHit and now - lastPlayerHit.at < 0.6 and lastPlayerHit or nil
	local att, ad, kind
	-- the CombatFx playerHit names the attack: the mob with that AttackKind nearest to where the server had us
	if ph and type(ph.kind) == "string" then
		for _, m in ipairs(list) do
			if m:GetAttribute("AttackKind") == ph.kind then
				local d = flat(rootOf(m).Position - me).Magnitude
				if not ad or d < ad then att, ad = m, d end
			end
		end
		if att then
			local a = threatOf(att).atk[ph.kind]
			kind = (a and a.kind == "projectile") and "projectile" or "melee"
		end
	end
	-- else: a melee swing near us; else the nearest mob within 8 st; else an archer mid-shot; else a volley ring
	for _, m in ipairs(att and {} or list) do
		local st, t = m:GetAttribute("AIState"), threatOf(m)
		local d = flat(rootOf(m).Position - me).Magnitude
		local wr = 0
		for _, r in pairs(t.windup) do wr = math.max(wr, r) end
		if not t.archer and (st == "Attack" or st == "Recover" or st == "Windup") and d < math.max(t.reach + CFG.meleePad + 10, wr + 6) and (not ad or d < ad) then att, ad, kind = m, d, "melee" end
	end
	if not att then for _, m in ipairs(list) do local d = flat(rootOf(m).Position - me).Magnitude if d < 8 and (not ad or d < ad) then att, ad, kind = m, d, "melee?" end end end
	if not att then
		for _, m in ipairs(list) do
			local st, t = m:GetAttribute("AIState"), threatOf(m)
			local d = flat(rootOf(m).Position - me).Magnitude
			if t.archer and (st == "Attack" or st == "Recover" or st == "Windup") and d < 80 and (not ad or d < ad) then att, ad, kind = m, d, "projectile" end
		end
	end
	if not att then kind = hazardAt(me, hazards()) and "volley" or "unknown" end
	local t = att and threatOf(att)
	local old = att and hist(att, now, 0.5)
	local spotD = mv and att and mv.dists and mv.dists[att]
	local sinceReset = now - lastResetAt
	local srvOff = (lastServer.pos and now - lastServer.at < 1.5) and flat(lastServer.pos - me0).Magnitude or -1
	-- a boss mech that just landed (ImpactAt / EchoAt within the last 0.8 s) is the cause whoever stands next to us
	local mechHit
	do
		local srv = workspace:GetServerTimeNow()
		for _, f in ipairs(CS:GetTagged("BossMech")) do
			local tv = f:FindFirstChild("Target")
			tv = tv and tv.Value
			if tv == nil or tv == LP or tv == LP.Character then
				for _, k in ipairs({ "ImpactAt", "EchoAt" }) do
					local at = tonumber(f:GetAttribute(k))
					if at and srv - at > -0.1 and srv - at < 0.8 then mechHit = "mech_" .. tostring(f:GetAttribute("Kind")) .. (k == "EchoAt" and "_echo" or "") end
				end
			end
		end
	end
	local cause
	if mechHit then cause = mechHit
	elseif kind == "volley" then cause = "volley_standing"
	elseif kind == "projectile" then cause = "arrow_standing"
	elseif kind == "unknown" then cause = "unknown_source"
	elseif sinceReset < 1.5 then cause = "reset_into_pack"
	elseif sinceHop < lagEst + 0.3 then cause = "hop_too_late"
	elseif sinceHop < 2.5 and spotD and spotD < t.reach + CFG.meleePad + t.speed * 0.5 then cause = "spot_in_reach"
	elseif ad > t.reach + CFG.meleePad + 2 and t.windup[att:GetAttribute("AttackKind") or ""] then cause = "aoe_landed"
	elseif ad > t.reach + CFG.meleePad + 2 then cause = "reach_longer_than_table"
	elseif lastInObj then cause = "objective_held_in_reach"
	else cause = "stood_in_reach" end
	waveCauses[cause] = (waveCauses[cause] or 0) + 1
	local gs = RepS:FindFirstChild("GameState")
	local line = string.format("%s r%s:%s -%d %s | by %s%s %s/%s state %s (0.5s ago %s at %.0f st) dist %.0f reach %s zone %s | stage %s why %s tc %s obj %s%s | hop %.2fs ago (%s, spot->mob %s) reset %.1fs ago srvOff %.0f lag %.2f | fx %s, dash %.2fs ago (Q used %d, last by line %s, R in %.1f s)",
		os.date("%H:%M:%S"), tostring(gs and gs:GetAttribute("Round")), tostring(gs and gs:GetAttribute("Challenge")), dmg, cause,
		att and att.Name or "-", (att and att:GetAttribute("Champion") == true) and "(champ)" or "", kind, att and tostring(att:GetAttribute("AttackKind")) or "-",
		att and tostring(att:GetAttribute("AIState")) or "-", old and tostring(old.st) or "?", old and flat(old.pos - me).Magnitude or -1, ad or -1,
		t and string.format("%.0f", t.reach) or "-", t and string.format("%.0f", t.zone) or "-", tostring(getgenv().GB_Stage), tostring(lastWhy), lastTc and string.format("%.2f", lastTc) or "-",
		tostring(lastObjKind), lastInObj and "(in station)" or "",
		sinceHop, mv and tostring(mv.stage) or "-", spotD and string.format("%.0f", spotD) or "-", sinceReset, srvOff, lagEst,
		ph and (tostring(ph.kind) .. (ph.blocked and " blocked" or "") .. (ph.parry and (" parry " .. tostring(ph.parry)) or "")) or "-", now - lastDashAt, (function() local u = 0 for _, d in ipairs(dashTimes) do if now - d < CFG.dashCd then u += 1 end end return u end)(),
		tostring(getgenv().GB_DashLine), math.max(0, (tonumber(LP:GetAttribute("AbilityReadyAt")) or 0) - workspace:GetServerTimeNow()))
	hitLog[#hitLog + 1] = line
	print("[GB] hit " .. line)
	pcall(function()
		if isfile and isfile("gb_hits.log") then appendfile("gb_hits.log", line .. "\n") else writefile("gb_hits.log", line .. "\n") end
	end)
end
-- the emergency / kite hop: the spot that buys the longest time before any mob (lagEst ahead) has us inside its zone, off the
-- lane of a lunge / charge winding up at us, inside the eye zone while the eye runs (its emergency pull follows the zone)
local function kiteHop(hrp, list, target, hz, obj, threat, why, closeSoon, now)
	ST("kite")
	local w = (why == "close" and closeSoon) and "closeSoon" or why or "outside"
	stats.why[w] = (stats.why[w] or 0) + 1
	-- eye: EVERY emergency hop stays inside the zone (pickSpot: -2500 outside it, minHop capped at its width), the zone
	-- where it will be when the hop lands; a hop out = progress decay + the way back. Leap is the one exception
	local eye = obj and obj.kind == "eye" and why ~= "leap"
	local pull = ((why == "reach" or why == "leap") and not eye) and nil or obj
	if eye then pull = { kind = "eye", pos = obj.center + obj.vel * (lagEst + 0.3), r = CFG.eyeRadius } end
	local tz = threat and threatOf(threat)
	local champ = threat and threat:GetAttribute("Champion") == true
	-- a mob next to us: at least 14 st (fast / lunging mobs: their zone + 4), never a 5 st shuffle beside it
	local minHop = (why == "leap" and 18) or (tz and (why == "reach" or why == "close" or why == "windup") and math.min(champ and CFG.hop * 1.5 or CFG.hop, math.max(champ and 20 or 14, tz.speed * 1.3, tz.zone + 4))) or nil
	if eye and minHop then minHop = math.min(minHop, pull.r * 2 - 2) end
	-- a charge / lunge hits along its line: the spot leaves the lane (mob -> through us, range + 14, half width 7),
	-- a hop straight back along it is still inside it (r6 / r9 boar: -14, -10)
	local hzk = hz
	if why == "windup" and threat then
		local tr0 = rootOf(threat)
		local rng = tz.windup[threat:GetAttribute("AttackKind") or ""] or (threat:GetAttribute("AIState") == "Charge" and flat(tr0.AssemblyLinearVelocity).Magnitude * 1.5 or 0)
		local along = flat(hrp.Position - tr0.Position)
		if along.Magnitude > 1 and rng > 0 then
			hzk = table.clone(hz)
			hzk[#hzk + 1] = { a = tr0.Position, b = tr0.Position + along.Unit * (rng + 14), w = 7 }
		end
	end
	spot = pickSpot(list, target, hrp.Position, hzk, pull, minHop, why == "leap" and 22 or nil, nil, why ~= "close" or closeSoon)
	ST("kite2")
	lastBlink = now
	stats.blinks += 1
	waveBlinks += 1
	moveTo(hrp, spot, now)
end
