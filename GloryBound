local function makeRow(groupbox, height, name)
    local row = new("Frame", {
        Name = name or "Row",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, height or 28),
        LayoutOrder = groupbox:_next(),
        Parent = groupbox.Body,
    })
    groupbox._statRow = nil   -- a stat tile after any other control starts a fresh pair
    return row
