			if window.ActiveTab == tab then return end
			Library:NewTween(nameLabel, 0.12, { TextColor3 = Colors.textMid })
			Library:PaintGlassIcon(iconLabel, "idle")
		end)
		entry.MouseButton1Down:Connect(function()
			if rawget(tab, "_spinning") ~= true then tiltTo(-10, 0.08) end
		end)
		entry.MouseButton1Up:Connect(function()
			if rawget(tab, "_spinning") ~= true then tiltTo(iconHover and 12 or 0, 0.3, Enum.EasingStyle.Back) end
		end)
		entry.MouseButton1Click:Connect(function()
			window:SelectTab(tab)
		end)
		if barEntry then
			barEntry.MouseButton1Click:Connect(function() window:SelectTab(tab) end)
		end

		-- Register
		self.Tabs[tabName] = tab
		table.insert(self.TabOrder, tab)
		Library.Tabs[tabName] = tab

		-- Initial focus: the very first tab added, unless a primary tab (opts.Primary or
		-- tab:SetPrimary) claims it. Hubs yield between tabs, so the pick is remembered
		-- across frames and a later tab never re-picks.
		local shouldPick = false
		if primary and not self._primaryLocked then
			shouldPick = true
			self._primaryLocked = true
		elseif not self._initialPicked and not self._primaryLocked then
			shouldPick = true
			self._initialPicked = true
		end
		if shouldPick then
			self._pendingActive = tab
			if not self._pendingActiveScheduled then
				self._pendingActiveScheduled = true
				task.defer(function()
					self._pendingActiveScheduled = false
					local t = self._pendingActive
					self._pendingActive = nil
					if t and (t.Primary or not self._primaryLocked) then
						self:SelectTab(t, true)
					end
				end)
			end
		end

		return tab
	end

	-- Touch tab bar word: bone + saffron needle while active, slate in a hairline box otherwise
	local function paintBarWord(t, on, instant)
		if not t or not t.BarEntry then return end
		local d = instant and 0 or 0.12
		Library:NewTween(t.BarName, d, { TextColor3 = on and Colors.moon or Colors.textMid }, Enum.EasingStyle.Linear)
		Library:NewTween(t.BarStroke, d, { Color = on and Colors.moon or Colors.hairlineStrong, Transparency = on and 0.5 or 0 }, Enum.EasingStyle.Linear)
		Library:NewTween(t.BarNeedle, instant and 0 or 0.18, { Size = UDim2.new(1, -8, 0, on and 2 or 0) }, Enum.EasingStyle.Back)
		if on then
			-- keep the active word inside the bar's view
			pcall(function()
				local k = mainScale.Scale > 0 and mainScale.Scale or 1
				local x = (t.BarEntry.AbsolutePosition.X - tabBar.AbsolutePosition.X) / k + tabBar.CanvasPosition.X
				local w = t.BarEntry.AbsoluteSize.X / k
				local vw = tabBar.AbsoluteSize.X / k
				if x < tabBar.CanvasPosition.X then
					tabBar.CanvasPosition = Vector2.new(math.max(0, x - 6), 0)
				elseif x + w > tabBar.CanvasPosition.X + vw then
					tabBar.CanvasPosition = Vector2.new(math.max(0, x + w - vw + 6), 0)
				end
			end)
		end
	end

	-- -------------------- window:FitHeight(instant)
	-- critique 2026-11-01 (round 11, "ragged column bottoms, Info 45 % empty"): the window hugs
	-- the tab it shows. The page's own height (both columns, AutomaticSize) plus the chrome
	-- around it, between 420 and the size the hub asked for; a 0.22 s Quint settle on a tab
	-- change and a short one when the page grows (a feed row, a label). Off once He drags the
	-- grip (his size wins for the session) and on touch (the window is the screen there).
	fitHeightOn = opts.FitHeight ~= false and not touch   -- (declared above the resize grip)
	-- owner 2026-11-01 ("caly hub krotszy, jak w Info"): the window never grows past FitMax
	-- however long the page is; the page scrolls inside. FitMax = false lifts the cap. 450 -> 500
	-- (owner 2026-11-01 batch D: Community and Server at once beside the compact sidebar).
	local fitMax = (opts.FitMax == false) and math.huge or (tonumber(opts.FitMax) or 500)
	local fitPending = false
	function window:FitHeight(instant)
		if not fitHeightOn or main.Parent == nil then return end
		if rawget(self, "_animating") then return end   -- the minimize / restore frame tween owns Size
		local tab = self.ActiveTab
		if not tab or not tab.Scroll or not tab.Content then return end
		local k = mainScale.Scale > 0 and mainScale.Scale or 1
		local contentH = tab.Content.AbsoluteSize.Y / k
		if contentH <= 0 then return end
		local chrome = (main.AbsoluteSize.Y - tab.Scroll.AbsoluteSize.Y) / k
		if chrome <= 0 then return end
		-- the opening Size is where the window starts; FitMax is the ceiling a long page may grow it to
		local maxH = math.max(420, Size.Y.Offset, fitMax)
		local want = math.clamp(math.ceil(contentH + chrome + 4), 420, maxH)
		if math.abs(main.AbsoluteSize.Y / k - want) < 2 then return end
		local target = UDim2.fromOffset(main.Size.X.Offset, want)
		if instant or rawget(Library, "LowEffects") == true then
			main.Size = target
		else
			Library:NewTween(main, 0.22, { Size = target }, Enum.EasingStyle.Quint)
		end
	end
	function window:_scheduleFit(instant)
		if not fitHeightOn or fitPending then return end
		fitPending = true
		task.delay(instant and 0 or 0.08, function()
			fitPending = false
			pcall(self.FitHeight, self, instant)
		end)
	end
	function window:SetFitHeight(on)
		fitHeightOn = on == true and not touch
		if fitHeightOn then self:_scheduleFit(false) end
	end

	-- -------------------- window:SelectTab(tab | name, instant)
	function window:SelectTab(tab, instant)
		if type(tab) == "string" then tab = self.Tabs[tab] end
		if not tab then return end
		if self.ActiveTab == tab then return end
		local previous = self.ActiveTab
		pcall(paintBarWord, previous, false, instant)
		pcall(paintBarWord, tab, true, instant)
		if previous and previous.Pages then
			pcall(function() previous.Pages.Visible = false end)
			if previous.EntryName then pcall(function() Library:NewTween(previous.EntryName, instant and 0 or 0.15, { TextColor3 = Colors.textMid }) end) end
			if previous.EntryIcon then pcall(Library.PaintGlassIcon, Library, previous.EntryIcon, "idle", instant) end
			if previous.EntryPlate then pcall(Library.PaintIconPlate, Library, previous.EntryPlate, "idle", instant) end
			if previous.EntryNeedle then pcall(function() Library:NewTween(previous.EntryNeedle, instant and 0 or 0.07, { Size = UDim2.new(0, 2, 0, 0) }) end) end
		end
		if tab.EntryNeedle then
			-- the needle drops in with mass (Back-out): in fast, settle with a little overshoot
			pcall(function() Library:NewTween(tab.EntryNeedle, instant and 0 or 0.18, { Size = UDim2.new(0, 2, 0, 14) }, Enum.EasingStyle.Back) end)
		end
		if tab.Pages then
			pcall(function()
				tab.Pages.Visible = true
				-- content slides in from the side of the list it came from (a tab lower in the
				-- sidebar rises from below, a higher one drops from above) and fades up out of the
				-- window colour: a veil over the page, so no CanvasGroup re-render per frame
				if not instant and rawget(Library, "LowEffects") ~= true then
					-- owner 2026-11-01 ("extra extra super animations when switching tabs"): the page
					-- rises from 14 px below when the tab is lower in the list (drops from above when it
					-- is higher) on a Quint while a window-coloured veil lifts off it; the cards come out
					-- one after another (revealCards), the title crossfades, the tab's icon pops
					local function idx(t) for i, x in ipairs(self.TabOrder) do if x == t then return i end end return 0 end
					local dir = (previous and idx(tab) < idx(previous)) and -1 or 1
					tab.Pages.Position = UDim2.new(0, 0, 0, dir * 14)
					Library:NewTween(tab.Pages, 0.28, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
					local veil = Library:New("Frame", {
						Name = "PageVeil",
						BackgroundColor3 = Colors.window,
						BackgroundTransparency = 0.1,
						BorderSizePixel = 0,
						Size = UDim2.new(1, 0, 1, 0),
						ZIndex = 40,
						Parent = tab.Pages,
					})
					local tw = TweenService:Create(veil, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 })
					tw.Completed:Once(function() veil:Destroy() end)
					tw:Play()
					pcall(revealCards, tab)
					if previous then
						pcall(Library.PlaySound, Library, "tab")
					end
				else
					tab.Pages.Position = UDim2.new(0, 0, 0, 0)
					if not instant and previous then pcall(Library.PlaySound, Library, "tab") end
				end
			end)
		end
		if tab.EntryName then pcall(function() Library:NewTween(tab.EntryName, instant and 0 or 0.15, { TextColor3 = Colors.text }) end) end
		if tab.EntryPlate then pcall(Library.PaintIconPlate, Library, tab.EntryPlate, "active", instant) end
		if tab.EntryIcon then
			pcall(Library.PaintGlassIcon, Library, tab.EntryIcon, "active", instant)
		end
		if not instant and rawget(Library, "LowEffects") ~= true then
			-- the picked tab's icon takes one full turn (owner 2026-11-01: rotation, not a scale pop),
			-- then settles on its hover tilt or on zero
			pcall(function()
				local icon = tab.EntryIcon
				if not icon then return end
				rawset(tab, "_spinning", true)
				icon.Rotation = 0
				Library:NewTween(icon, 0.55, { Rotation = 360 }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
				task.delay(0.56, function()
					if not icon.Parent then return end
					rawset(tab, "_spinning", nil)
					local rest = rawget(tab, "_iconRest")
					local deg = type(rest) == "function" and rest() or 0
					icon.Rotation = 0
					if deg ~= 0 then Library:NewTween(icon, 0.15, { Rotation = deg }) end
				end)
			end)
		end
		self.ActiveTab = tab
		-- Hubs poll Library.ActiveTab / Library.Toggled to skip repainting hidden tabs
		rawset(Library, "ActiveTab", tab)
		if rawget(Library, "Toggled") == nil then rawset(Library, "Toggled", true) end

		if self.TabTitle then
			pcall(function()
				local tl = self.TabTitle
				local name = tostring(tab.Name or "")
				if instant or rawget(Library, "LowEffects") == true or tl.Text == "" then
					tl.Text = name
					return
				end
				-- the title crossfades: the old word fades in 70 ms, the new one rises 5 px into place
				local base = rawget(self, "_titleBase") or tl.Position
				rawset(self, "_titleBase", base)
				Library:NewTween(tl, 0.07, { TextTransparency = 1 }, Enum.EasingStyle.Linear)
				task.delay(0.08, function()
					if self.ActiveTab ~= tab then return end
					tl.Text = name
					tl.Position = base + UDim2.fromOffset(0, 5)
					Library:NewTween(tl, 0.2, { TextTransparency = 0, Position = base }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
				end)
			end)
		end

		-- Move pill
		if self.Sidebar and self.Sidebar.MovePillTo and tab.Entry then
			pcall(self.Sidebar.MovePillTo, tab.Entry, instant)
		end
		pcall(function() self:RefreshMiniPager(tab) end)
		-- the window follows the page's height (see FitHeight); the page reports its growth once
		if tab.Content and not tab._fitConn then
			tab._fitConn = tab.Content:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
				if self.ActiveTab == tab then self:_scheduleFit(false) end
			end)
			Library:GiveSignal(tab._fitConn)
		end
		self:_scheduleFit(instant)
	end

	-- -------------------- window:RefreshMiniPager(tab)
	-- Header "◀ ● · · ▶" (mockup .pager-mini). Hidden for single-page tabs.
	function window:RefreshMiniPager(tab)
		local slot = self.MiniPagerSlot
		if not slot then return end
		for _, c in ipairs(slot:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		local n = (tab and tab.GetPages) and #tab:GetPages() or 0
		if n < 2 then slot.Visible = false return end
		slot.Visible = true
		local function arrow(txt, dir, order)
			local b = Library:New("TextButton", {
				Name = "Arrow",
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				Text = txt,
				FontFace = Fonts.Inter,
				TextSize = 11,
				TextColor3 = Colors.textMid,
				Size = UDim2.new(0, 12, 0, 16),
				LayoutOrder = order,
				ZIndex = 4,
				Parent = slot,
			})
			b.MouseButton1Click:Connect(function() tab:ShowPage(tab.CurrentPage + dir) end)
		end
		arrow("\226\151\128", -1, 0)
		for i = 1, n do
			local active = i == tab.CurrentPage
			local d = Library:New("Frame", {
				Name = "Dot" .. i,
				BackgroundColor3 = active and Colors.metalHi or Colors.border,
				BorderSizePixel = 0,
				Size = active and UDim2.new(0, 7, 0, 7) or UDim2.new(0, 5, 0, 5),
				LayoutOrder = i,
				ZIndex = 4,
				Parent = slot,
			})
			Library:Round(4).Parent = d
			if active then
				Library:ApplyGradient(d, "Metal", { Rotation = 135 })
				Library:Stroke(Colors.metalLo, 2, 0.7).Parent = d
			end
		end
		arrow("\226\150\182", 1, n + 1)
	end

	-- -------------------- tab:AddLeftGroupbox / AddRightGroupbox
	-- Both call Library:MakeGroupbox(column, { Name, Icon, LayoutOrder })
	-- and register the resulting Groupbox in tab.Groupboxes.
	function TabClass:AddLeftGroupbox(name, icon)
		-- name may be a props table ({ Name, Icon, Primary }) - Primary picks instrument/strip
		local extra = type(name) == "table" and name or nil
		if extra then name, icon = extra.Name, extra.Icon or icon end
		local col = (self.Columns[#self.Columns] and self.Columns[#self.Columns].Left) or self.LeftColumn
		local gb = Library:MakeGroupbox(col, {
			Name = name,
			Icon = icon,
			LayoutOrder = #col:GetChildren(),
			Primary = extra and extra.Primary,
		})
		if type(gb) == "table" then gb.Tab = self end
		table.insert(self.Groupboxes, gb)
		if type(name) == "string" and self.Groupboxes[name] == nil then self.Groupboxes[name] = gb end
		return gb
	end

	function TabClass:AddRightGroupbox(name, icon)
		local extra = type(name) == "table" and name or nil
		if extra then name, icon = extra.Name, extra.Icon or icon end
		local col = (self.Columns[#self.Columns] and self.Columns[#self.Columns].Right) or self.RightColumn
		local gb = Library:MakeGroupbox(col, {
			Name = name,
			Icon = icon,
			LayoutOrder = #col:GetChildren(),
			Primary = extra and extra.Primary,
		})
		if type(gb) == "table" then gb.Tab = self end
		table.insert(self.Groupboxes, gb)
		if type(name) == "string" and self.Groupboxes[name] == nil then self.Groupboxes[name] = gb end
		return gb
	end

	-- -------------------- tab:NewColumnRow(split) / tab:AddRow(split)
	-- A fresh two-column row on the CURRENT page (mockup stacks .grid-2 then .grid-2b).
	function TabClass:NewColumnRow(split)
		local pg = self.PageFrames[#self.PageFrames]
		local _r, l, r, entry = self._newColumnRow(pg, split)
		table.insert(self.Columns, { Left = l, Right = r, Page = #self.PageFrames, Entry = entry })
		self.LeftColumn  = l
		self.RightColumn = r
		return l, r
	end
	TabClass.AddRow = TabClass.NewColumnRow

	-- -------------------- tab:SetSplit(ratio)
	-- Re-proportion the current row (mockup .grid-2 is 1.9fr / 1fr = 0.655).
	function TabClass:SetSplit(ratio)
		ratio = math.clamp(tonumber(ratio) or 0.5, 0.2, 0.8)
		local cols = self.Columns[#self.Columns]
		if not cols then return self end
		if cols.Entry then cols.Entry.Split = ratio end
		if self.Window and self.Window.Narrow then return self end
		cols.Left.Size  = UDim2.new(ratio, -6, 0, 0)
		cols.Right.Size = UDim2.new(1 - ratio, -6, 0, 0)
		return self
	end

	-- -------------------- tab:AddTimeline() (A2 flight recorder)
	-- A strip at the bottom of the tab: the last 10 minutes of hub log lines as colour ticks
	-- (Library.TickerHistory). Hover a tick for the line. Repaints every 2 s while visible.
	local TICK_COLORS = {
		GRAB = Colors.metalMid, STEAL = Colors.metalMid, HATCH = Colors.metalMid, CATCH = Colors.metalMid, EGG = Colors.metalMid,
		BANK = Colors.good, SOLD = Colors.good, SELL = Colors.good, CLAIM = Colors.good, REBIRTH = Colors.good,
		BUY = Colors.moon, BOUGHT = Colors.moon, UPGRADE = Colors.moon, PLACE = Colors.moon, FUSE = Colors.moon, MERGE = Colors.moon,
		PROBLEM = Colors.bad, ERROR = Colors.bad,
		PLAN = Colors.muted, DECIDE = Colors.muted, STATUS = Colors.muted, MOVE = Colors.amber, STOP = Colors.amber, START = Colors.muted,
	}
	function TabClass:AddTimeline(opts)
		opts = opts or {}
		if self.Timeline then return self.Timeline end
		local WINDOW = tonumber(opts.Seconds) or 600
		local row = Library:New("Frame", {
			Name = "Timeline",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 34),
			LayoutOrder = 9000,
			ZIndex = 2,
			Parent = self.PagesHolder,
		})
		Library:New("TextLabel", {
			Name = "Eyebrow",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 10),
			FontFace = Fonts.InterMed or Fonts.Inter,
			Text = "F L I G H T   R E C O R D E R, last " .. math.floor(WINDOW / 60) .. " min",
			TextSize = 9,
			TextColor3 = Colors.muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 3,
			Parent = row,
		})
		local track = Library:New("Frame", {
			Name = "Track",
			BackgroundColor3 = Colors.well,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0, 1),
			Size = UDim2.new(1, 0, 0, 16),
			Position = UDim2.new(0, 0, 1, 0),
			ZIndex = 2,
			Parent = row,
		})
		Library:Round(3).Parent = track
		Library:Stroke(Colors.wellEdge, 1, 0).Parent = track
		local cursor = Library:New("Frame", {
			Name = "Now",
			BackgroundColor3 = Colors.metalMid,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(1, 0.5),
			Size = UDim2.new(0, 1, 1, -4),
			Position = UDim2.new(1, -4, 0.5, 0),
			ZIndex = 4,
			Parent = track,
		})
		local tip = Library:New("TextLabel", {
			Name = "Tip",
			BackgroundColor3 = Colors.well,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 0, 22),
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 0, -6),
			Text = "",
			FontFace = Fonts.Inter,
			TextSize = 11,
			TextColor3 = Colors.text,
			Visible = false,
			ZIndex = 12,
			Parent = row,
		})
		Library:Round(4).Parent = tip
		Library:Stroke(Colors.wellEdge, 1, 0).Parent = tip
		Library:Padding(0, 8, 0, 8).Parent = tip
		local pool = {}
		local function tick(i)
			local f = pool[i]
			if f then return f end
			f = Library:New("Frame", {
				Name = "T" .. i,
				BackgroundColor3 = Colors.muted,
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.new(0, 2, 0, 8),
				Position = UDim2.new(0, 0, 0.5, 0),
				Visible = false,
				ZIndex = 3,
				Parent = track,
			})
			Library:Round(1).Parent = f
			f.MouseEnter:Connect(function()
				local item = f:GetAttribute("Text")
				if not item then return end
				tip.Text = item
				tip.Position = UDim2.new(f.Position.X.Scale, 0, 0, -6)
				tip.Visible = true
			end)
			f.MouseLeave:Connect(function() tip.Visible = false end)
			pool[i] = f
			return f
		end
		local api = { Instance = row, Track = track }
		function api:Repaint()
			local hist = rawget(Library, "TickerHistory") or {}
			local now = os.clock()
			local t0 = now - WINDOW
			local n = 0
			for i = #hist, 1, -1 do
				local it = hist[i]
				if it.t < t0 then break end
				n += 1
				local f = tick(n)
				local x = math.clamp((it.t - t0) / WINDOW, 0, 1)
				f.Position = UDim2.new(x, 0, 0.5, 0)
				local col = TICK_COLORS[it.tag] or Colors.muted
				if f.BackgroundColor3 ~= col then f.BackgroundColor3 = col end
				local h = (it.tag == "PROBLEM" or it.tag == "ERROR" or it.tag == "BUY" or it.tag == "BANK" or it.tag == "SOLD") and 11 or 7
				f.Size = UDim2.new(0, 2, 0, h)
				f:SetAttribute("Text", it.clock .. "  " .. it.tag .. "  " .. it.text)
				if not f.Visible then f.Visible = true end
				if n >= 240 then break end
			end
			for i = n + 1, #pool do
				if pool[i].Visible then pool[i].Visible = false end
			end
		end
		task.spawn(function()
			while row.Parent and Library.Unloaded ~= true do
				if self.Pages and self.Pages.Visible and rawget(Library, "Toggled") ~= false then pcall(api.Repaint, api) end
				task.wait(2)
			end
		end)
		self.Timeline = api
		return api
	end

	-- -------------------- tab:GetPages()
	-- Pages that hold at least one groupbox (page 1 always counts). A trailing
	-- page created by AddPageBreak with nothing after it stays invisible.
	local function pageHasContent(pg)
		for _, row in ipairs(pg:GetChildren()) do
			if row:IsA("Frame") then
				for _, col in ipairs(row:GetChildren()) do
					if col:IsA("Frame") then
						for _, c in ipairs(col:GetChildren()) do
							if c:IsA("GuiObject") then return true end
						end
					end
				end
			end
		end
		return false
	end
	function TabClass:GetPages()
		local out = {}
		for i, pg in ipairs(self.PageFrames) do
			if i == 1 or pageHasContent(pg) then table.insert(out, pg) end
		end
		return out
	end

	-- -------------------- tab:NewPage()
	-- Pages are retired (owner 2026-10-19): a "page break" is just the next column row
	-- in one continuous scroll. Kept as an API so hub src keeps working unchanged.
	function TabClass:NewPage()
		return 1
	end

	-- -------------------- tab:GetPageTags() / tab:SetPageTags(list)
	-- Pager center text "zones · trainer · boost": explicit tags or the first
	-- groupbox title of every page, lower-cased.
	function TabClass:SetPageTags(list)
		self.PageTags = type(list) == "table" and list or {}
		pcall(function() if self._pagerApi and self._pagerApi.SetPageCount then self._pagerApi:SetPageCount(#self:GetPages(), self:GetPageTags()) end end)
		return self
	end
	function TabClass:GetPageTags()
		local tags = {}
		for i, pg in ipairs(self:GetPages()) do
			local t = self.PageTags[i]
			if not t then
				for _, row in ipairs(pg:GetChildren()) do
					if t then break end
					if row:IsA("Frame") then
						for _, col in ipairs(row:GetChildren()) do
							if col:IsA("Frame") then
								for _, gb in ipairs(col:GetChildren()) do
									if gb:IsA("Frame") and gb.Name:sub(1, 9) == "Groupbox_" then
										t = gb.Name:sub(10):lower(); break
									end
								end
							end
							if t then break end
						end
					end
				end
			end
			tags[i] = t or ("page " .. i)
		end
		return tags
	end

	-- -------------------- tab:ShowPage(n)
	-- Snap-flip: hide the old page, slide the new one in (0.4 s Quint), reset scroll.
	function TabClass:ShowPage(n)
		local pages = self:GetPages()
		local count = #pages
		n = math.clamp(tonumber(n) or 1, 1, count)
		if n == self.CurrentPage then return self end
		local dir = n > self.CurrentPage and 1 or -1
		local old = pages[self.CurrentPage]
		local new = pages[n]
		self.CurrentPage = n
		if old then old.Visible = false end
		if new then
			new.Visible = true
			new.Position = UDim2.new(0, 18 * dir, 0, 0)
			Library:NewTween(new, 0.4, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		end
		if self.Scroll then self.Scroll.CanvasPosition = Vector2.new(0, 0) end
		pcall(function() if self._pagerApi and self._pagerApi.SetPage then self._pagerApi:SetPage(n, true) end end)
		if self.Window and self.Window.ActiveTab == self then
			pcall(function() self.Window:RefreshMiniPager(self) end)
		end
		return self
	end

