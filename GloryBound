-- remotes: every call is FireServer on ReplicatedStorage.Remotes.<name> with the arg types of Shared.Net
N.Sent = { count = 0, last = "" }
local function remote(name)
	local r = Remotes:FindFirstChild(name)
	return r and r:IsA("RemoteEvent") and r or nil
end
function N.fire(name, ...)
	local r = remote(name)
	if not r then
		logProblem("remote missing: " .. tostring(name))
		return false
	end
	local ok, err = pcall(r.FireServer, r, ...)
	if not ok then
		logProblem(name .. ": " .. tostring(err))
		return false
	end
	N.Sent.count += 1
	N.Sent.last = name
	return true
end
local function hrp()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function hum()
