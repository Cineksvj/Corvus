			table.insert(rows, { key = c.code .. c.at, name = c.code, sub = c.text, value = c.result, nameColor = if c.result == "ok" then "good" elseif c.result == "used" then "muted" else nil })
		end
		Feeds.Codes:Set(rows)
	end
	Stats.Session:SetValue(N.fmtTime(now - sessionStart))
	Stats.Reps:SetValue(string.format("%d", st.trainReps))
	Stats.StrengthGain:SetValue(if st.strengthAtStart then N.fmtNum(N.num(d.Strength) - st.strengthAtStart) else "-")
	Stats.Opened:SetValue(string.format("%d", st.chestsOpened))
	Stats.Claims:SetValue(string.format("%d", st.claimed))
	Stats.SkillsBought:SetValue(string.format("%d", st.skillsBought))
	Stats.Sent:SetValue(string.format("%d", N.Sent.count))
	Stats.Cash:SetValue(N.fmtNum(d.Cash))
	Stats.Strength:SetValue(strength)
	Stats.Level:SetValue(N.fmtNum(d.Level))
	Stats.Rebirth:SetValue(N.fmtNum(d.Rebirth))
	Stats.Points:SetValue(N.fmtNum(d.SkillPoints))
	Stats.ChestsOwned:SetValue(string.format("%d", owned))
	Stats.Spins:SetValue(if st.daily then string.format("%d", N.spinsOf(st.daily)) else "-")
	Labels.Problems:SetText(if Log.problemCount > 0 then string.format("%d problems logged, last: %s", Log.problemCount, Log.lastProblem) else "")
