		-- Graphics (the hubs add their own "Performance" card with measured numbers)
		local perf = tab:AddRightGroupbox("Graphics", "monitor")
		local lag = { Enabled = false, Level = 2, Saved = setmetatable({}, { __mode = "k" }), Count = 0, Queue = {}, Token = 0, Quality = nil }
		local levels = { Light = 1, Balanced = 2, Ultra = 3 }
		local function remember(target, prop, value)
			local entry = lag.Saved[target]
			if not entry then entry = {}; lag.Saved[target] = entry end
			local ok, cur = pcall(function() return target[prop] end)
			if not ok or cur == value then return end
			if entry[prop] == nil then entry[prop] = { cur } end
			pcall(function() target[prop] = value end)
		end
		local function protected(target)
			local c = LocalPlayer.Character
			return c ~= nil and target:IsDescendantOf(c)
		end
		local function optimize(t)
			local lv = lag.Level
			if t:IsA("ParticleEmitter") or t:IsA("Trail") or t:IsA("Beam") or t:IsA("Smoke") or t:IsA("Fire") or t:IsA("Sparkles") then
				remember(t, "Enabled", false); lag.Count += 1
			elseif t:IsA("Explosion") then
				remember(t, "Visible", false)
			elseif t:IsA("BasePart") then
				remember(t, "CastShadow", false)
				if lv >= 2 then
					remember(t, "Reflectance", 0)
					if not protected(t) then remember(t, "Material", Enum.Material.SmoothPlastic) end
				end
				if lv >= 3 and t:IsA("MeshPart") and not protected(t) then remember(t, "TextureID", "") end
				lag.Count += 1
			elseif lv >= 2 and (t:IsA("Decal") or t:IsA("Texture")) and not protected(t) then
				remember(t, "Transparency", 1); lag.Count += 1
			elseif lv >= 2 and t:IsA("Light") then
				remember(t, "Enabled", false); lag.Count += 1
			end
		end
		local function applyGlobals()
			local Lighting = game:GetService("Lighting")
			remember(Lighting, "GlobalShadows", false)
			if lag.Level >= 2 then
				remember(Lighting, "FogEnd", 1e9)
				for _, child in ipairs(Lighting:GetChildren()) do
					if child:IsA("PostEffect") then
						remember(child, "Enabled", false)
					elseif child:IsA("Atmosphere") then
						remember(child, "Density", 0); remember(child, "Haze", 0); remember(child, "Glare", 0)
					elseif child:IsA("Clouds") then
						remember(child, "Enabled", false)
					end
				end
			end
			local terrain = Workspace:FindFirstChildOfClass("Terrain")
			if terrain then
				remember(terrain, "WaterWaveSize", 0); remember(terrain, "WaterWaveSpeed", 0); remember(terrain, "WaterReflectance", 0)
				if lag.Level >= 3 and typeof(sethiddenproperty) == "function" then pcall(sethiddenproperty, terrain, "Decoration", false) end
			end
			pcall(function()
				if lag.Quality == nil then lag.Quality = settings().Rendering.QualityLevel end
				settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
			end)
		end
		local function restore()
			lag.Token += 1
			for target, entry in pairs(lag.Saved) do
				for prop, box in pairs(entry) do
					pcall(function() target[prop] = box[1] end)
				end
			end
			table.clear(lag.Saved)
			table.clear(lag.Queue)
			if lag.Quality ~= nil then
				pcall(function() settings().Rendering.QualityLevel = lag.Quality end)
				lag.Quality = nil
			end
			lag.Count = 0
		end
