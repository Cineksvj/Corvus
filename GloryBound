-- B3: every notice also lands in the drawer (last 50); PROBLEM lines come in as "bad"
rawset(Library, "NotifyHistory", rawget(Library, "NotifyHistory") or {})
function Library:_pushNotice(text, kind)
	local h = Library.NotifyHistory
	table.insert(h, 1, { clock = os.date("%H:%M:%S"), text = tostring(text or ""), kind = kind or "info" })
	while #h > 50 do table.remove(h) end
	local bump = rawget(Library, "_noticeBump")
	if type(bump) == "function" then pcall(bump) end
end
-- Toast in the top-right of the screen (Copy Discord, config saved, ...)
function Library:Notify(text, seconds)
	local gui = rawget(Library, "ScreenGui")
	if not gui then return end
	local holder = gui:FindFirstChild("Toasts")
	if not holder then
		holder = Library:New("Frame", {
			Name = "Toasts",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -16, 0, 16),
			Size = UDim2.new(0, 300, 1, -32),
			ZIndex = 70,
			Parent = gui,
		})
		local l = Library:List(Enum.FillDirection.Vertical, 8, "right")
		l.Parent = holder
	end
	if type(text) == "table" then
		local t = text
		seconds = tonumber(t.Time) or tonumber(t.Duration) or seconds
		local parts = {}
		if t.Title then table.insert(parts, "<b>" .. tostring(t.Title) .. "</b>") end
		local body = t.Description or t.Content or t.Text or t.Message
		if body then table.insert(parts, tostring(body)) end
		text = table.concat(parts, ", ")
	end
	pcall(Library._pushNotice, Library, text, "info")
	-- owner 2026-10-31 night ("delete notifications"): the line goes to the logbook only; a hub
	-- that wants the toast back sets Library.Toasts = true
	if rawget(Library, "Toasts") ~= true then return end
	pcall(Library.PlaySound, Library, "notify")
	local toast = Library:New("Frame", {
		Name = "Toast",
		BackgroundColor3 = Colors.cardHi or Colors.surfaceAlt,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.new(0, 0, 0, 0),
		ZIndex = 71,
		Parent = holder,
	})
	if type(Library.CardSkin) == "function" then
		Library.CardSkin(toast, 8)
	else
		Library:Round(8).Parent = toast
		Library:Stroke(Colors.border, 1, 0).Parent = toast
	end
	Library:Padding(8, 12, 8, 12).Parent = toast
	Library:New("TextLabel", {
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.new(0, 0, 0, 0),
		Text = tostring(text or ""),
		FontFace = Fonts.Inter,
		TextSize = 12,
		TextColor3 = Colors.text,
		TextWrapped = true,
		RichText = true,
		ZIndex = 72,
		Parent = toast,
	})
	task.delay(tonumber(seconds) or 3, function()
		if toast and toast.Parent then
			Library:NewTween(toast, 0.2, { BackgroundTransparency = 1 })
			task.delay(0.22, function() pcall(function() toast:Destroy() end) end)
		end
	end)
end

-- ---------------------------------------------------------------- Stub-with-warn metatable
-- Fallback for anything hub src/* calls that we still forgot. Prints once per key.
-- Returns nil (not function) so `Library.X or {}` patterns resolve to {}, not function.
-- Optional hook fields hubs read before setting them are silent.
local SILENT_KEYS = {
	LoadLogger = true, StartFallback = true, StartLogged = true, OnCommandRegistered = true,
	FooterStats = true, ScreenGui = true, Theme = true, CurrentTheme = true, ActiveTab = true,
	Toggled = true, SetQuickBar = true, OnOptionChanged = true, OnUserToggle = true,
	DiagnosticsLabel = true, _Source = true, Windows = true, DiscordInvite = true,
	MirrorWatch = true, Base64Encode = true, ImportShareCode = true, AddCommand = true,
	AntiAfkBusy = true, RenderOverlayInfo = true, RejoinScript = true, AutoReconnectOn = true,
	AntiAfk = true, BlockRobuxPrompts = true, ToggleKeybind = true, LowEffects = true,
	_batchSuppress = true, _userOn = true, _historyChanged = true,
}
if not getmetatable(Library) then
	local warned = {}
	setmetatable(Library, {
		__index = function(_, k)
			if type(k) == "string" and k:sub(1, 3) ~= "Get" and not warned[k] and not SILENT_KEYS[k] then
				warned[k] = true
				warn("[Corvus][core] Library." .. tostring(k) .. " not registered")
			end
			return nil
		end,
	})
end
Library._silentKeys = SILENT_KEYS

