local eyeHist = {} -- ObjectivePos samples { at, p } of the eye zone over the last ~1.2 s (its velocity)
local function objective(from)
	if not CFG.objectives then return end
	local gs = RepS:FindFirstChild("GameState")
	if not gs then return end
	local rp = gs:GetAttribute("RoundPhase")
	if rp ~= "Combat" and rp ~= "Overtime" then return end
	local ch = gs:GetAttribute("Challenge")
	-- ObjectiveProgress 0..1: a filled eye / arrived chariot needs nobody standing in the pack any more (Eye: fillTime 28 s,
	-- limit 70 s, progress decays at half speed outside the zone)
	local prog = tonumber(gs:GetAttribute("ObjectiveProgress")) or 0
	-- 01:05 live: ObjectiveActive = false MID-objective (Volley progress 0.21, r3 Chariot "obj -" all wave, r21 Eye nil):
	-- it is not "over". Over = progress 1 or the ObjectiveEnd timestamp passed
	local oEnd = tonumber(gs:GetAttribute("ObjectiveEnd")) or 0
	if (ch == "Chariot" or ch == "Eye") and (prog >= 1 or (oEnd > 0 and workspace:GetServerTimeNow() > oEnd)) then ch = nil end
	if ch == "Chariot" then
		local c = findChariot()
		if os.clock() - (eyeLogAt or 0) > 5 then
			eyeLogAt = os.clock()
			local cp = c and pivotOf(c)
			print(string.format("[GB] chariot: progress %.2f, active %s, model %s, us %.0f st from it, end in %.0fs, E fires %d", prog, tostring(gs:GetAttribute("ObjectiveActive")), c and c:GetFullName() or "NONE", cp and flat(cp - from).Magnitude or -1, oEnd > 0 and oEnd - workspace:GetServerTimeNow() or -1, chariotFires))
		end
		local p, look
		if c then p, look = pivotOf(c) end
		if not p then
			p = gs:GetAttribute("ObjectivePos")
			if typeof(p) ~= "Vector3" or p.Magnitude < 1 then return end
		end
		-- station: 7 st AHEAD of the chariot (it drives toward the gate, so it comes to us and stays inside pushRadius 12 for
		-- ~16 st of travel); we only move again when the chariot centre is > chariotRadius from us (hops behind it every 3 st
		-- gave 71 hops / 1.4 shots per hop in r6)
		local fwd = look and flat(look).Magnitude > 0.1 and flat(look).Unit or (flat(p - from).Magnitude > 1 and flat(p - from).Unit or Vector3.new(1, 0, 0))
		local c0 = Vector3.new(p.X, CFG.floorY, p.Z)
		return { kind = "chariot", pos = c0 + fwd * 7, r = 4, center = c0, keep = CFG.chariotRadius }
	elseif ch == "Eye" then
		local p = gs:GetAttribute("ObjectivePos")
		if not (typeof(p) == "Vector3" and p.Magnitude > 1) and os.clock() - (eyeLogAt or 0) > 5 then
			eyeLogAt = os.clock()
			print(string.format("[GB] eye: no ObjectivePos (%s), active %s, progress %.2f, phase %s", tostring(p), tostring(gs:GetAttribute("ObjectiveActive")), prog, tostring(rp)))
		end
		if typeof(p) == "Vector3" and p.Magnitude > 1 then
			-- time budget: ObjectiveEnd is a server timestamp; the zone needs (1 - progress) * fillTime 28 s more of us inside.
			-- slack = seconds we can afford to spend outside (thinning the pack) before the limit bites
			local endAt = tonumber(gs:GetAttribute("ObjectiveEnd")) or 0
			local slack = endAt > 0 and (endAt - workspace:GetServerTimeNow()) - (1 - prog) * 28 - 6 or 0
			-- the zone DRIVES along the chariot path (Defs.Challenges Eye: ~3.9-4.5 st/s by round): r21 / r28 progress 0.04 -> 0.00,
			-- we stood where it had been. Its velocity from ObjectivePos over the last ~1 s; the station is eyeStation st AHEAD
			-- of it, so it comes to us and passes over us (17 st of travel = ~4 s inside per hop)
			local now = os.clock()
			local fp = flat(p)
			local lastS = eyeHist[#eyeHist]
			if not lastS or now - lastS.at > 0.1 then eyeHist[#eyeHist + 1] = { at = now, p = fp } end
			while #eyeHist > 2 and now - eyeHist[1].at > 1.2 do table.remove(eyeHist, 1) end
			local vel = Vector3.zero
			local o = eyeHist[1]
			if o and now - o.at > 0.4 then vel = (fp - o.p) / (now - o.at) end
			if vel.Magnitude > 15 then vel = Vector3.zero end -- a new zone (the marker jumped), not motion
			local c0 = Vector3.new(p.X, CFG.floorY, p.Z)
			local ahead = vel.Magnitude > 0.5 and vel.Unit * math.min(CFG.eyeStation, vel.Magnitude * 1.5) or Vector3.zero
			-- every 5 s: progress, the zone's speed, how far we are from its centre (in = within the server's 13)
			if now - (eyeLogAt or 0) > 5 then
				eyeLogAt = now
				local dc = flat(from - c0).Magnitude
				print(string.format("[GB] eye: progress %.2f, end in %.0fs, slack %.0fs, zone %.1f st/s, us %.0f st from centre (%s), active %s", prog, endAt > 0 and endAt - workspace:GetServerTimeNow() or -1, slack, vel.Magnitude, dc, dc <= 13 and "in" or "OUT", tostring(gs:GetAttribute("ObjectiveActive"))))
			end
			return { kind = "eye", pos = c0 + ahead, r = 5, center = c0, keep = CFG.eyeRadius, vel = vel, slack = slack }
		end
	end
	-- coin purses on the floor (Treasure wave, chariot treasure, anything tagged Purse): the nearest one nobody carries.
	-- a purse with Claim=E### is in a thief's hands and moves with him: chasing it starves the shooting (that is how
	-- the Treasure wave stalled and killed us) - kill the thief instead, it drops
	-- purses = every free one: an emergency hop that lands on one picks it up on the way (pickSpot, pursesNow)
	local best, bd, all = nil, nil, {}
	for _, m in ipairs(CS:GetTagged(CFG.purseTag)) do
		local p = pivotOf(m)
		local claim = m:GetAttribute("Claim")
		if p and m:GetAttribute("Taken") ~= true and (claim == nil or claim == "") then
			local q = Vector3.new(p.X, CFG.floorY, p.Z)
			all[#all + 1] = q
			local d = flat(p - from).Magnitude
			if not bd or d < bd then best, bd = q, d end
		end
	end
	if best then return { kind = "purse", pos = best, r = 2, purses = all } end
end
-- one hop (<= CFG.hop) from p toward target
local function hopToward(p, target)
	local v = flat(target - p)
	if v.Magnitude <= CFG.hop then return Vector3.new(target.X, CFG.floorY, target.Z) end
	local q = p + v.Unit * CFG.hop
	return Vector3.new(q.X, CFG.floorY, q.Z)
end

