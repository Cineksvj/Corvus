-- a metal (a darker and a paler step around it) kept as the "Custom" theme; the colour lives in
-- the AccentColor setting and the theme is rebuilt from it at boot. quiet = register only.
function Library:SetCustomAccent(c, quiet)
	if typeof(c) ~= "Color3" then return false end
	local h, s, v = c:ToHSV()
	local lo = Color3.fromHSV(h, math.min(1, s * 1.1), v * 0.72)
	local hi = Color3.fromHSV(h, s * 0.35, math.min(1, v * 1.15 + 0.1))
	Library.Themes["Custom"] = { Name = "Custom", Metal = ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, lo),
		ColorSequenceKeypoint.new(0.55, c),
		ColorSequenceKeypoint.new(1.00, hi),
	}) }
	if type(Library.SetSetting) == "function" then pcall(Library.SetSetting, Library, "AccentColor", c:ToHex()) end
	if not quiet then
		if type(rawget(Library, "SetTheme")) == "function" then Library:SetTheme("Custom") else Library:ApplyTheme("Custom") end
	end
	return true
end
-- owner 2026-11-01 ("once i did obsidian gold it stayed that way, next themes only changed the
-- toggles"): both tables were weak-keyed, and the GC collects the Lua proxy of a parented
-- Instance, so the registered gradients and the saved originals vanished between two theme
-- changes - the tinted gold failed the chrome test and stayed. Strong tables now; entries whose
-- Instance has left the tree are pruned on every repaint.
rawset(Library, "_themed", {})
function Library:RegisterThemed(g, kind)
	if typeof(g) == "Instance" then Library._themed[g] = kind or "metal" end
	return g
end
-- owner 2026-11-01 ("make themes work"): a theme used to repaint six registered gradients and
-- nothing the eye lands on. Now every light chrome colour in the window - the metal, the rim,
-- the grooves, the rails, the bone buttons, the glyph tint on the Lucide icons - is re-tinted
-- towards the theme's metal: one walk over the ScreenGui, the originals kept in a weak table so
-- Corvus Silver puts them back, and instances built later (lists, rows) tinted as they arrive.
-- Text is never tinted (the text greys share hexes with the metal), nor is pure white (the base
-- under a gradient), nor anything dark or already coloured (the game's own pictures and tints).
rawset(Library, "_themeOrig", {})
local GLYPH0 = Colors.glyph
local function isChrome(c)
	local _, sat, val = c:ToHSV()
	if val < 0.4 or sat > 0.2 then return false end
	if val > 0.985 and sat < 0.02 then return false end
	return true
end
local function tintTo(c, th)
	local _, _, val = c:ToHSV()
	return c:Lerp(Color3.fromHSV(th.h, th.s, val), 0.85)
end
-- RGB (owner 2026-11-01): a tint whose hue is a phase that runs with time plus the instance's
-- place on the screen (a diagonal band, RGB_SPAN of the spectrum across the screen), so one
-- rainbow slides over the whole hub. The walk's registry (every chrome colour with its base) is
-- the animator's list: each Heartbeat a slice of it is re-tinted from the base with the hue for
-- that instance; the registered metal / rail / groove gradients take a rainbow slice of the
-- silver metal. Nothing is walked again. A control's state paint goes through Library:ThemeSet,
-- which keeps the base in the registry and parks the instance while its tween runs.
-- one local for the whole RGB machinery (the library's files share one function's 200
-- registers): RGB.phase / hueAt / start / stop / SAT, the rest lives in this block
local RGB = {}
do
	local RGB_SAT, RGB_SPEED, RGB_SPAN, RGB_GRAD, RGB_SLICE = 0.62, 0.06, 0.7, 0.22, 360
	local rgbClock0 = os.clock()
	rawset(Library, "_themeBusy", {})
	local function rgbPhase()
		return ((os.clock() - rgbClock0) * RGB_SPEED) % 1
	end
	local function rgbHueAt(inst, phase)
		local p = inst
		if not p:IsA("GuiObject") then p = p.Parent end
		if not (p and p:IsA("GuiObject")) then return phase end
		local cam = Workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
		local ap = p.AbsolutePosition
		return (phase + (ap.X + ap.Y * 0.6) / math.max(1, vp.X + vp.Y * 0.6) * RGB_SPAN) % 1
	end
	local function evalSeq(seq, t)
		local kps = seq.Keypoints
		if t <= kps[1].Time then return kps[1].Value end
		for i = 2, #kps do
			local b = kps[i]
			if t <= b.Time then
				local a = kps[i - 1]
				local span = b.Time - a.Time
				return span > 0 and a.Value:Lerp(b.Value, (t - a.Time) / span) or b.Value
			end
		end
		return kps[#kps].Value
	end
	-- the sequence re-tinted with the hue running h0 -> h0 + RGB_GRAD along it, resampled at seven
	-- points so the run reads as a spectrum and not as one blend of two ends
	local function rgbSeq(base, h0, s)
		local pts = table.create(7)
		for i = 0, 6 do
			local t = i / 6
			local col = evalSeq(base, t)
			if isChrome(col) then col = tintTo(col, { h = (h0 + t * RGB_GRAD) % 1, s = s }) end
			pts[i + 1] = ColorSequenceKeypoint.new(t, col)
		end
		return ColorSequence.new(pts)
	end
	local rgbConn, rgbList, rgbCursor, rgbBases = nil, nil, 1, nil
	local function rgbStop()
		if rgbConn then rgbConn:Disconnect(); rgbConn = nil end
		rgbList, rgbCursor = nil, 1
	end
	local function rgbTick()
		local th = rawget(Library, "_themeTint")
		if not (th and th.rgb) then return end
		local phase = rgbPhase()
		th.h = phase
		local orig, themed, busy = Library._themeOrig, Library._themed, Library._themeBusy
		local now = os.clock()
		if not rgbList or rgbCursor > #rgbList then
			rgbList, rgbCursor = {}, 1
			for inst in pairs(orig) do
				if not themed[inst] then rgbList[#rgbList + 1] = inst end
			end
			for g in pairs(themed) do rgbList[#rgbList + 1] = g end
		end
		local last = math.min(#rgbList, rgbCursor + RGB_SLICE - 1)
		for i = rgbCursor, last do
			local inst = rgbList[i]
			local b = busy[inst]
			if b and b > now then
				continue
			end
			if b then busy[inst] = nil end
			if inst.Parent == nil then
				orig[inst] = nil
				themed[inst] = nil
				continue
			end
			pcall(function()
				local h = rgbHueAt(inst, phase)
				local kind = themed[inst]
				if kind then
					inst.Color = rgbSeq(rgbBases[kind] or rgbBases.metal, h, th.s)
					return
				end
				local rec = orig[inst]
				if not rec then return end
				local cls = inst.ClassName
				if cls == "UIGradient" then
					if rec.Color then inst.Color = rgbSeq(rec.Color, h, th.s) end
				elseif cls == "UIStroke" then
					if rec.Color then inst.Color = tintTo(rec.Color, { h = h, s = th.s }) end
				else
					local t2 = { h = h, s = th.s }
					if rec.BackgroundColor3 then inst.BackgroundColor3 = tintTo(rec.BackgroundColor3, t2) end
					if rec.ImageColor3 then inst.ImageColor3 = tintTo(rec.ImageColor3, t2) end
				end
			end)
		end
		rgbCursor = last + 1
	end
	local function rgbStart()
		if rgbConn then return end
		local metal = MetalColor135
		local rail = Gradients.SwitchOnBase or darkenSeq(metal, 0.14)
		local groove = type(Library.GrooveSequence) == "function" and Library.GrooveSequence(metal) or metal
		rgbBases = { metal = metal, rail = rail, groove = groove }
		rgbList, rgbCursor = nil, 1
		rgbConn = RunService.Heartbeat:Connect(rgbTick)
		if type(Library.GiveSignal) == "function" then pcall(Library.GiveSignal, Library, rgbConn) end
	end
	function Library:ThemeColor(c)
		local th = rawget(Library, "_themeTint")
		if th and typeof(c) == "Color3" and isChrome(c) then return tintTo(c, th) end
		return c
	end
	-- Library:ThemeSet(inst, prop, base[, dur, style]): write a colour the way the theme walk would
	-- (a chrome base is tinted, kept in the registry under its instance so a later theme re-tints
	-- it from this base; a dark or coloured base is written as it is and drops out of the registry).
	-- With dur the write is a tween, and the RGB animator leaves the instance alone until it ends.
	function Library:ThemeSet(inst, prop, base, dur, style)
		if typeof(inst) ~= "Instance" or typeof(base) ~= "Color3" then return end
		local th = rawget(Library, "_themeTint")
		local orig = Library._themeOrig
		local target = base
		if th and isChrome(base) then
			local rec = orig[inst]
			if not rec then rec = {}; orig[inst] = rec end
			rec[prop] = base
			if th.rgb then
				local ok, h = pcall(rgbHueAt, inst, th.h)
				target = tintTo(base, { h = ok and h or th.h, s = th.s })
			else
				target = tintTo(base, th)
			end
		else
			local rec = orig[inst]
			if rec and rec[prop] ~= nil then
				rec[prop] = nil
				if next(rec) == nil then orig[inst] = nil end
			end
		end
		dur = tonumber(dur) or 0
		if dur > 0 then
			if th and th.rgb then Library._themeBusy[inst] = os.clock() + dur + 0.05 end
			return Library:NewTween(inst, dur, { [prop] = target }, style)
		end
		inst[prop] = target
	end
	RGB.phase, RGB.hueAt, RGB.start, RGB.stop, RGB.SAT = rgbPhase, rgbHueAt, rgbStart, rgbStop, RGB_SAT
end
local function themeWalk(list, th)
	local orig = Library._themeOrig
	for _, inst in ipairs(list) do
		local ok = pcall(function()
			-- CorvusKeep = true: a colour that means something on its own (a theme card's swatches,
			-- owner 2026-11-02 "appearances change with the theme and they should not") stays as made
			if inst:GetAttribute("CorvusKeep") == true then return end
			local cls = inst.ClassName
			if cls == "UIGradient" then
				local o = orig[inst]
				if th then
					local base = (o and o.Color) or inst.Color
					local kps, changed = {}, false
					for _, kp in ipairs(base.Keypoints) do
						local c = kp.Value
						if isChrome(c) then c = tintTo(c, th); changed = true end
						kps[#kps + 1] = ColorSequenceKeypoint.new(kp.Time, c)
					end
					if changed then
						if not o then orig[inst] = { Color = base } end
						inst.Color = ColorSequence.new(kps)
					end
				elseif o and o.Color then
					inst.Color = o.Color
					orig[inst] = nil
				end
			elseif cls == "UIStroke" then
				local o = orig[inst]
				if th then
					local base = (o and o.Color) or inst.Color
					if isChrome(base) then
						if not o then orig[inst] = { Color = base } end
						inst.Color = tintTo(base, th)
					end
				elseif o and o.Color then
					inst.Color = o.Color
					orig[inst] = nil
				end
			elseif inst:IsA("GuiObject") then
				local o = orig[inst]
				if th then
					local rec = o or {}
					local bg = rec.BackgroundColor3 or inst.BackgroundColor3
					if (inst.BackgroundTransparency < 0.999 or inst:GetAttribute("CorvusTint") == true) and isChrome(bg) then
						rec.BackgroundColor3 = bg
						inst.BackgroundColor3 = tintTo(bg, th)
					end
					if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
						local ic = rec.ImageColor3 or inst.ImageColor3
						if isChrome(ic) then
							rec.ImageColor3 = ic
							inst.ImageColor3 = tintTo(ic, th)
						end
					end
					if next(rec) ~= nil then orig[inst] = rec end
				elseif o then
					if o.BackgroundColor3 then inst.BackgroundColor3 = o.BackgroundColor3 end
					if o.ImageColor3 then inst.ImageColor3 = o.ImageColor3 end
					orig[inst] = nil
				end
			end
		end)
		local _ = ok
	end
end
local function hookThemeGui(gui)
	if rawget(Library, "_themeGui") == gui then return end
	rawset(Library, "_themeGui", gui)
	local pending, queued, added = {}, false, 0
	local conn = gui.DescendantAdded:Connect(function(inst)
		if rawget(Library, "_themeTint") == nil then return end
		pending[#pending + 1] = inst
		if queued then return end
		queued = true
		task.defer(function()
			queued = false
			local list = pending
			pending = {}
			local th = rawget(Library, "_themeTint")
			if th then themeWalk(list, th) end
			-- the registry holds its instances strongly; every 300 added, the destroyed ones go
			-- (live 2026-11-01: 2030 entries, most of them old feed rows)
			added += #list
			if added >= 300 then
				added = 0
				local orig = Library._themeOrig
				for inst in pairs(orig) do
					if inst.Parent == nil then orig[inst] = nil end
				end
			end
		end)
	end)
	if type(Library.GiveSignal) == "function" then pcall(Library.GiveSignal, Library, conn) end
end
local function repaintTheme(name, metal)
	local gui = rawget(Library, "ScreenGui")
	if typeof(gui) ~= "Instance" then return end
	hookThemeGui(gui)
	-- every icon plate (sidebar tabs, the island's restore) keeps its state in CorvusPaint: after
	-- the walk each one is painted again from that state, so a colour the walk cannot carry (a
	-- text glyph, the white edge of the open tab on Silver) follows the theme at once
	local all = gui:GetDescendants()
	local function repaintStates()
		for _, inst in ipairs(all) do
			local state = inst:GetAttribute("CorvusPaint")
			if type(state) == "string" then
				pcall(Library.PaintIconPlate, Library, inst, state, true)
				local face = inst:FindFirstChild("Face")
				if face then
					-- the tile is renamed by its owner ("Icon" in the sidebar): the frame with the Img
					for _, tile in ipairs(face:GetChildren()) do
						if tile:IsA("Frame") and tile:FindFirstChild("Img") then pcall(Library.PaintGlassIcon, Library, tile, state, true) end
					end
				end
			end
		end
	end
	if name == "Corvus Silver" then
		RGB.stop()
		rawset(Library, "_themeTint", nil)
		Colors.glyph = GLYPH0
		local list = {}
		for inst in pairs(Library._themeOrig) do list[#list + 1] = inst end
		themeWalk(list, nil)
		table.clear(Library._themeOrig)
		repaintStates()
		return
	end
	for inst in pairs(Library._themeOrig) do
		if inst.Parent == nil then Library._themeOrig[inst] = nil end
	end
	local kps = metal.Keypoints
	local h, sat = kps[math.ceil(#kps / 2)].Value:ToHSV()
	local th = { h = h, s = sat }
	local def = Library.Themes[name]
	if type(def) == "table" and def.Rgb == true then
		th.rgb, th.h, th.s = true, RGB.phase(), RGB.SAT
	end
	rawset(Library, "_themeTint", th)
	Colors.glyph = tintTo(GLYPH0, th)
	themeWalk(all, th)
	repaintStates()
	if th.rgb then RGB.start() else RGB.stop() end
end
function Library:ApplyTheme(name, instant)
	local th = Library.Themes[name]
	if type(th) ~= "table" or typeof(th.Metal) ~= "ColorSequence" then return false end
	for k, v in pairs(Library.Themes["Corvus Silver"]) do if th[k] == nil then th[k] = v end end
	Library.Theme = th
	Library.ThemeName = name
	rawset(Library, "CurrentTheme", name)
	local metal = th.Metal
	local rail = th.Rail or (name == "Corvus Silver" and Gradients.SwitchOnBase) or darkenSeq(metal, 0.14)
	Gradients.Metal.Color = metal
	Gradients.MetalV.Color = metal
	Gradients.MetalBright.Color = metal
	Gradients.MetalFlat.Color = metal
	Gradients.SwitchOn = rail
	local kps = metal.Keypoints
	Colors.metalLo, Colors.metalMid, Colors.metalHi = kps[1].Value, kps[math.ceil(#kps / 2)].Value, kps[#kps].Value
	Colors.brushed, Colors.accent, Colors.Brushed = Colors.metalLo, Colors.metalLo, Colors.metalLo
	local dead = {}
	local groove = Library.GrooveSequence(metal)
	for g, kind in pairs(Library._themed) do
		if g.Parent then
			if kind == "groove" then
				g.Color = groove
			else
				g.Color = (kind == "rail") and rail or metal
			end
		else
			dead[#dead + 1] = g
		end
	end
	for _, g in ipairs(dead) do Library._themed[g] = nil end
	pcall(repaintTheme, name, metal)
	if type(Library.CorvusLog) == "function" then pcall(Library.CorvusLog, Library, "THEME " .. name) end
	return true
end
Library.OnThemeChange = function(name) Library:ApplyTheme(name) end

-- Apply gradient by name. Instance must be a GuiObject.
function Library:ApplyGradient(instance, name, over)
	if not instance then return nil end
	local tpl = Gradients[name] or Gradients.Metal
	local g = Instance.new("UIGradient")
	if name == "Metal" or name == "Metal135" or name == "MetalV" or name == "MetalBright" or name == "MetalFlat" or name == nil then
		Library:RegisterThemed(g, "metal")
	end
	g.Color    = tpl.Color    or MetalColor135
	g.Rotation = (over and over.Rotation) or tpl.Rotation or 0
	if over and over.Transparency then
		g.Transparency = over.Transparency
	elseif tpl.Transparency then
		g.Transparency = tpl.Transparency
	end
	if over and over.Offset then
		g.Offset = over.Offset
	end
	g.Enabled = true
	g.Parent = instance
	return g
end

-- ---------------------------------------------------------------- Instance helpers
-- Library:New(class, props, children)
--   Creates an Instance with props applied + optional children table.
--   Children may be:
--     * array of Instances -> parented to the new instance
--     * single Instance    -> parented
--     * table of {class, props} pairs -> recursively created
function Library:New(class, props, children)
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				pcall(function() inst[k] = v end)
			end
		end
	end
	if children then
		if typeof(children) == "Instance" then
			children.Parent = inst
		elseif type(children) == "table" then
			for _, c in ipairs(children) do
				if typeof(c) == "Instance" then
					c.Parent = inst
				elseif type(c) == "table" and c[1] then
					local sub = Library:New(c[1], c[2], c[3])
					sub.Parent = inst
				end
			end
		end
	end
	if props and props.Parent then
		pcall(function() inst.Parent = props.Parent end)
	end
	return inst
end
Library.NewInstance = Library.New

