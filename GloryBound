			return
		end
		if winding and t0 < oneWay + 0.12 and tryBlock(hrp, rootOf(threat).Position, now) then return end
		if hopAllowed and not winding then -- a mob standing in reach that is not swinging yet: out before it does
			kiteHop(hrp, list, target, hz, obj, threat, why, false, now)
			return
		end
		-- winding with contact further than the block window: hold (shoot), the block / dash comes next frame
	elseif threat and why == "close" and not melee then
		-- one mob left (champion / rival): its approach is not a blow - stand and shoot, its windup / charge is dodged (dash
		-- first, timed by tc). r5: 55 hops in 56 s vs one lion, 0.3 shots per hop
		local lone = #list == 1 and dashReady(now) and not (obj and obj.kind == "eye")
		if lone then
		elseif travelLeft(now) >= 30 and ((closeSoon and now - lastBlink > CFG.hopGap * 0.6) or (dwellOk and gapOk)) then
			kiteHop(hrp, list, target, hz, obj, threat, why, closeSoon, now)
			return
		end
		-- r24-r28: dogs / raiders 20-34 st/s crossed the "close" band while the hop gap (0.72 s) held us: spot_in_reach /
		-- hop_too_late with "why reach tc 0.00" 0.5-1 s after a hop. Contact sooner than a hop + 0.3 lands: out now (only the
		-- hop's own server catch-up gates it), dash if the hop is not allowed yet
		local urgent = closeSoon and tc < hopIn + 0.3
		if urgent and hopAllowed and travelLeft(now) >= 20 then
			kiteHop(hrp, list, target, hz, obj, threat, why, true, now)
			return
		end
		if not lone and closeSoon and dashReady(now) and (#dashTimes == 0 or urgent) and tryDash(hrp, bestDashDir(list, hrp.Position, hz, threat), now) then
			stats.why.dash = (stats.why.dash or 0) + 1
			nextShot = math.max(nextShot, now + 0.3)
			return
		end
	end
	-- melee: in reach of the target = swing (end of the frame); else one hop next to it (a long way: 40 st steps, the budget)
	if melee and target and CFG.autoTeleport then
		local tr = rootOf(target)
		local d = flat(tr.Position - hrp.Position).Magnitude
		local ts = target:GetAttribute("AIState")
		local tWinding = ts == "Windup" or ts == "Attack" or ts == "Charge"
		if d > meleeReach() - 2.5 and hopAllowed and not tWinding and travelLeft(now) >= 25 then
			ST("meleehop")
			local p
			if d > 45 then
				p = hrp.Position + flat(tr.Position - hrp.Position).Unit * 40
				if hazardAt(p, hz) or not inside(p, 1) then p = nil end
			else
				p = meleeSpot(list, target, hrp.Position, hz)
			end
			if p then
				spot = p
				lastBlink = now
				stats.blinks += 1
				waveBlinks += 1
				stats.why.meleeIn = (stats.why.meleeIn or 0) + 1
				moveTo(hrp, p, now)
				return
			end
		end
	end
	if not inside(hrp.Position, 1) and hopAllowed then
		kiteHop(hrp, list, target, hz, obj, nil, nil, false, now)
		return
	end
	-- no target but mobs alive (every one behind a statue/corpse/other mob): hop to where a line exists instead of waiting
	-- (round 15: 13 s without an arrow, lion 30 st away "line false", never moved)
	-- 00:47 stall: the only target 86 st away = a "far" hold every frame and no branch moved us: walk the hop toward it too
	local farT = target and flat(rootOf(target).Position - hrp.Position).Magnitude > CFG.sureMax
	if not melee and (not target or farT) and #list > 0 and now - lastShotAt > 1 and dwellOk and budgetOk and gapOk then
		ST("line")
		local nm, nd
		for _, m in ipairs(list) do local d = flat(rootOf(m).Position - hrp.Position).Magnitude if (skipUntil[m] or 0) <= now and (not nd or d < nd) then nm, nd = m, d end end
		if farT then nm, nd = target, flat(rootOf(target).Position - hrp.Position).Magnitude end
		if nm and nd < 140 then -- a mob 170 st away is not a line problem, it is walking in
			spot = pickSpot(list, nm, hrp.Position, hz, obj, nil, nil, 60)
			lastBlink = now
			stats.blinks += 1
			waveBlinks += 1
			moveTo(hrp, spot, now)
			return
		end
	end
	-- reset by the server: ~0.6 s after a hop it can put us back at a position from 4-7 s earlier (anti-teleport on the
	-- distance travelled in a window; 30 st hops mostly pass, 75-130 st hops every 0.6 s never do). Hopping back at once
	-- only re-triggers it: 14-24 resets / 20 s, 0-5 hits of 27 (r15). So: accept the place, the server body IS here now,
	-- shoot from it, and let the threat logic pick the next (short) hop from here.
	if spot and flat(hrp.Position - spot).Magnitude > 6 then
		ST("reset")
		stats.why.reset = (stats.why.reset or 0) + 1
		local back = flat(hrp.Position - spot).Magnitude
		spot = hrp.Position
		lastBlink = now
		lastResetAt = now
		if moves[#moves] then moves[#moves].reset = true end
		-- what the anti-teleport window looks like: our hop travel in the last 2 / 4 / 6 s before this reset (to size the budget)
		local t2, t4, t6, n6 = 0, 0, 0, 0
		for _, mv in ipairs(moves) do
			local age, d = now - mv.at, flat(mv.to - mv.from).Magnitude
			if age < 6 then t6 += d n6 += 1 end
			if age < 4 then t4 += d end
			if age < 2 then t2 += d end
		end
		print(string.format("[GB] reset: put back %.0f st (to y %.1f), travel last 2s %.0f / 4s %.0f / 6s %.0f st in %d hops, lag %.2f, %d mobs", back, hrp.Position.Y, t2, t4, t6, n6, lagEst, #list))
		-- arrows fired 0.15-0.4 s after a reset come back with no CombatFx at all (server dropped them, r16: 6 in a row at a
		-- standing raider): the reset is a teleport like ours, wait the same lagEst
		nextShot = math.max(nextShot, now + lagEst)
	end
	-- watchdog: a wave where we neither shoot nor move for 5 s is a logic hole - say what we see instead of dying quietly
	if now - lastShotAt > 5 and now - lastBlink > 5 and now - lastWatch > 5 then
		lastWatch = now
		local gs = RepS:FindFirstChild("GameState")
		print(string.format("[GB] idle: round %s %s %s | %d mobs, target %s, obj %s, threat %s/%s, hazards %d", tostring(gs and gs:GetAttribute("Round")), tostring(gs and gs:GetAttribute("Challenge")), tostring(gs and gs:GetAttribute("RoundPhase")), #list, target and target.Name or "-", obj and obj.kind or "-", threat and threat.Name or "-", tostring(why), #hz))
	end
	ST("shoot")
	-- stall watchdog: mobs around but no arrow for 3 s - print what blocks it (target/line/settle), once per 3 s
	if now - lastShotAt > 3 and now - lastWatch > 3 then
		lastWatch = now
		local nm, nd
		for _, m in ipairs(list) do local d = flat(rootOf(m).Position - hrp.Position).Magnitude if not nd or d < nd then nm, nd = m, d end end
		local gs0 = RepS:FindFirstChild("GameState")
		if nd and nd < 90 then print(string.format("[GB] stall: %d mobs, target %s, nearest %s %.0f st line %s, nextShot in %.2f, lastBlink %.2f ago, why %s, obj %s, tstate %s tvel %.0f | hp %.2f safe %s phase %s oa %s", #list, target and target.Name or "-", nm and nm.Name or "-", nd or -1, nm and tostring(clearLine(hrp.Position, nm)) or "-", nextShot - now, now - lastBlink, tostring(why), obj and obj.kind or "-", target and tostring(target:GetAttribute("AIState")) or "-", target and flat(rootOf(target).AssemblyLinearVelocity).Magnitude or 0,
			hum and hum.MaxHealth > 0 and hum.Health / hum.MaxHealth or -1, tostring(hpSafe), tostring(gs0 and gs0:GetAttribute("RoundPhase")), tostring(gs0 and gs0:GetAttribute("ObjectiveActive")))) end
	end
	fire()
end)

