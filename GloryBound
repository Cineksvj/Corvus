-- training: a TrainPrompt (ProximityPrompt, ActionText "Train") inside a machine model (attribute MachineId);
-- the server sets our attribute Training = MachineId on the prompt, then counts TrainRep(n) (<= 3/s, bank 15) while
-- we stay within 10 studs; TrainStop leaves. Boosted barbells (ObjectText "Boosted Barbell 1.5x") show "Unlock"
-- until BoostUnlocked, so only prompts whose ActionText is Train are used.
local prompts, promptsAt = {}, 0
local function scanPrompts()
	promptsAt = os.clock()
	table.clear(prompts)
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Name == "TrainPrompt" then
			local m = d.Parent
			for _ = 1, 8 do
				if not m or m == workspace then
					m = nil
					break
				end
				if m:IsA("Model") and m:GetAttribute("MachineId") ~= nil then
					break
				end
				m = m.Parent
			end
			if m then
				table.insert(prompts, { prompt = d, machine = m })
			end
		end
	end
end
local function machineBusy(m)
	local id = tostring(m:GetAttribute("MachineId"))
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p:GetAttribute("Training") == id then
			return true
		end
	end
	local occ = num(m:GetAttribute("Occupant"))
	return occ > 0 and occ ~= LocalPlayer.UserId
end
local function boostOf(entry)
	local b = num(entry.machine:GetAttribute("Boost"), 0)
	if b <= 0 then
		b = num(string.match(entry.prompt.ObjectText or "", "([%d%.]+)x"), 1)
	end
	return math.max(1, b)
end
local function pickMachine()
	if os.clock() - promptsAt > 30 or #prompts == 0 then
		scanPrompts()
	end
	local root = hrp()
	local best, bestKey
	for _, e in ipairs(prompts) do
		local pr, m = e.prompt, e.machine
		if pr.Parent and m.Parent and pr.ActionText == "Train" and not machineBusy(m) then
			local boost = cfg.trainBoost and boostOf(e) or 1
			local part = pr.Parent:IsA("BasePart") and pr.Parent or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
			if part then
				local dist = root and (part.Position - root.Position).Magnitude or 0
				local key = boost * 10000 - dist
				if not bestKey or key > bestKey then
					best, bestKey = { prompt = pr, machine = m, part = part, boost = boost }, key
				end
			end
		end
	end
	return best
end
local function isTraining()
	local t = LocalPlayer:GetAttribute("Training")
	return type(t) == "string" and t ~= ""
end
N.isTraining = isTraining
local function pressPrompt(pr)
	if type(fireproximityprompt) == "function" then
		local ok = pcall(fireproximityprompt, pr)
		if ok then
			return true
		end
	end
	local ok = pcall(function()
		pr:InputHoldBegin()
		task.wait(math.max(0.05, pr.HoldDuration))
		pr:InputHoldEnd()
	end)
	return ok
end
function N.trainStart()
	local now = os.clock()
	if now - st.trainTryAt < 3 then
		return false
	end
	st.trainTryAt = now
	local e = pickMachine()
	if not e then
		st.status = "No free barbell found"
		return false
	end
	local root = hrp()
	if not root then
		return false
	end
	local at = e.part.CFrame:PointToWorldSpace(Vector3.new(0, 0, 3))
	root.CFrame = CFrame.new(Vector3.new(at.X, e.part.Position.Y + 3, at.Z), e.part.Position)
	root.AssemblyLinearVelocity = Vector3.zero
	task.wait(0.35)
	pressPrompt(e.prompt)
	for _ = 1, 30 do
		if isTraining() then
			break
		end
		task.wait(0.1)
	end
	if not isTraining() then
		st.status = "The barbell did not take us (prompt " .. tostring(e.prompt.ActionText) .. ")"
		log("TRAIN prompt failed", e.machine.Name)
		return false
	end
	st.training = true
	st.trainStartAt = st.trainStartAt > 0 and st.trainStartAt or now
	st.trainMachine = e.machine.Name
	st.repAcc, st.repSentAt = 0, now
	st.strengthAtStart = st.strengthAtStart or num(st.data.Strength)
	log("TRAIN start", e.machine.Name, "boost", e.boost)
	return true
end
function N.trainStop(why)
	if st.training or isTraining() then
		N.fire("TrainStop")
		log("TRAIN stop", why or "")
	end
	st.training = false
	st.trainMachine = nil
end
-- the arena farm (gb_autokill) asks this before it queues: true = still busy in the lobby
-- lobby work that needs the lobby (the server refuses ChestOpen / ArmorEquip / Rebirth in the arena): with the arena farm
-- re-queueing at once, 11 owned chests stayed shut for hours (owner 2026-11-13 "auto open chests nie dziala"). The queue
-- waits up to 3 min per lobby visit while it is pending
function N.lobbyWork()
	if cfg.rebirth and (st.rebirthBusy or st.data.RebirthReady == true) then
		return "rebirth"
	end
	if cfg.chests then
		for _, c in ipairs(N.ownedChests()) do
			if cfg.chestTiers[c.tier] then
				return "chests"
			end
		end
	end
	return nil
end
function N.lobbyHold()
	if N.inLobby and N.lobbyWork() and os.clock() - st.lobbyEnter < 180 then
		return true
	end
	-- every other lobby switch (claims, codes, skills, gear, selling) gets 12 s of lobby ticks per visit before the queue
	if N.inLobby and (cfg.claim or cfg.codes or cfg.skills or cfg.armor or cfg.sellAuto) and os.clock() - st.lobbyEnter < 12 then
		return true
	end
	if not cfg.train or cfg.trainMinutes <= 0 or st.trainDone then
		return false
	end
	if st.trainStartAt <= 0 then
		return true
	end
	return os.clock() - st.trainStartAt < cfg.trainMinutes * 60
end
getgenv().GB_LobbyHold = function()
	local ok, v = pcall(N.lobbyHold)
	return ok and v == true
end
local function trainStep(now)
	if not cfg.train or not N.inLobby then
		if st.training then
			N.trainStop("toggle off")
		end
		return
	end
	-- rebirth priority: when ready (or already firing), stop training and yield to rebirthStep.
	-- without this trainStep keeps sending TrainRep / teleporting us back to the barbell mid-rebirth.
	if cfg.rebirth and (st.rebirthBusy or st.data.RebirthReady == true) then
		if st.training or isTraining() then
			N.trainStop("rebirth pending")
		end
		return
	end
	-- the farm wants the arena: let it queue once the training minutes are over (a fresh hub starts in the arena)
	if cfg.arena and not N.lobbyHold() and cfg.trainMinutes > 0 and st.trainStartAt > 0 then
		if st.training then
			N.trainStop("minutes done, arena next")
			st.trainDone = true
		end
		return
	end
	if not isTraining() then
		if st.training then
			st.training = false
			log("TRAIN dropped by the server, retry")
		end
		N.trainStart()
		return
	end
	st.training = true
	-- reps: repsPerSec spread over 0.5 s sends (the game sends every 0.5 s too, the server caps at 3/s)
	st.repAcc += cfg.repsPerSec * 0.1
	if now - st.repSentAt >= 0.5 and st.repAcc >= 1 then
		local n = math.floor(st.repAcc)
		st.repAcc -= n
		st.repSentAt = now
		if N.fire("TrainRep", n) then
			st.trainReps += n
		end
	end
end

