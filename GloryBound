		local d = Vector3.new(lv.X, 0, lv.Z); d = (d.Magnitude > 0.1) and d.Unit or Vector3.new(0, 0, -1)
		return (pcall(function()
			Step(hum, o + d * 0.5); Step(hum, Vector3.new(o.X, root.Position.Y, o.Z))
		end))
