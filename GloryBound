task.delay(3, function()
	local function show(value)
		if type(value) == "table" then
			local keys = {}
			for k, v in pairs(value) do
				table.insert(keys, tostring(if type(k) == "number" then v else k))
			end
			table.sort(keys)
			return "{" .. table.concat(keys, ",") .. "}"
		end
		return tostring(value)
	end
	local restored = {}
	for name, toggle in pairs(Toggles) do
		if toggle.Value == true and not toggle.Default then
			table.insert(restored, name)
		end
	end
	table.sort(restored)
	log("AUTOLOAD toggles=" .. (if #restored > 0 then table.concat(restored, ",") else "-"))
	local function hook(name, element)
		local run = element.RunChanged
		if type(run) ~= "function" or element.Type == "KeyPicker" or element.Type == "ColorPicker" then
			return
		end
		element.RunChanged = function(self, ...)
			if not N.quiet then
				log("CLICK", name .. "=" .. show(element.Value))
			end
			return run(self, ...)
		end
	end
	for name, toggle in pairs(Toggles) do
		hook(name, toggle)
	end
	for name, option in pairs(Options) do
		hook(name, option)
	end
end)

local sessionStart = os.clock()
local lastChestTop, lastClaimTop, lastCodeTop = nil, nil, nil
function N.upNext()
	local lines = {}
	local function add(text)
		table.insert(lines, "\u{2022} " .. text)
	end
	if N.inLobby then
		if cfg.train then
			add(st.training and ("Training: " .. (cfg.trainMinutes > 0 and (N.fmtTime(math.max(0, cfg.trainMinutes * 60 - (os.clock() - st.trainStartAt))) .. " left") or "until you switch it off")) or (st.trainDone and "Training done, the farm queues" or "Training: finding a barbell"))
		end
		if cfg.chests then
			local n = #N.ownedChests()
			add(n > 0 and ("Chests: " .. n .. " to open") or "Chests: none owned")
		end
		if cfg.buyChest then
			add("Buys " .. cfg.buyTier .. " chests above " .. N.fmtNum(cfg.cashReserve) .. " Cash")
		end
		if cfg.claim then
			add("Claims: next check in " .. math.max(0, math.ceil(60 - (os.clock() - st.dailyAt))) .. " s")
		end
		if cfg.codes then
			add(N.codesPending() and ("Codes: next one in " .. math.max(0, math.ceil(st.codeNextAt - os.clock())) .. " s") or "Codes: every pasted code is used")
		end
		if cfg.skills then
			add("Skills: " .. N.fmtNum(N.save("SkillPoints", 0)) .. " points, branch " .. cfg.skillBranch)
		end
		if cfg.rebirth then
			add(N.save("RebirthReady") == true and "Rebirth: ready, sending" or "Rebirth: waiting for the cap")
		end
		if cfg.arena then
			add(N.lobbyHold() and "Arena farm: waits for the training minutes" or "Arena farm: picks Archer and queues solo")
		end
	else
		if N.arenaOn then
			add("Dungeon farm: " .. tostring(getgenv().GB_Stage or "running"))
		end
		if cfg.train or cfg.chests or cfg.claim or cfg.skills then
			add("Lobby switches wait for the lobby")
		end
	end
	return if #lines > 0 then table.concat(lines, "\n") else "Nothing is on. Auto train and the Arena farm on Quick start do the most"
end
function N.refreshUI()
	local now = os.clock()
	local d = st.data
	local status = st.status
	if st.lastErr ~= "" and now - N.num(st.lastErrAt) < 20 then
		status = (if status == "" then "" else status .. "\n") .. "Last problem: " .. st.lastErr
	end
	Labels.Status:SetText(status)
	Labels.UpNext:SetText(N.upNext())
	local strength = N.fmtNum(d.Strength) .. " / " .. N.fmtNum(d.StrengthCap)
	Stats.NowStrength:SetValue(strength)
	Stats.NowCash:SetValue(N.fmtNum(d.Cash))
	local owned = #N.ownedChests()
	Stats.NowChests:SetValue(string.format("%d", owned))
	local gs = ReplicatedStorage:FindFirstChild("GameState")
	Stats.NowRound:SetValue(if gs and gs:GetAttribute("Round") then tostring(gs:GetAttribute("Round")) else "-")
	Labels.Train:SetText(if not N.inLobby then "Training works in the lobby" elseif st.training then string.format("On %s, %d reps sent, mult %s", tostring(st.trainMachine), st.trainReps, tostring(d.TrainingMult or "-")) elseif cfg.train then st.status else "")
	Labels.Chests:SetText(string.format("%d chests owned, %d opened this session", owned, st.chestsOpened))
	Labels.Skills:SetText(string.format("%s points, level %s", N.fmtNum(d.SkillPoints), N.fmtNum(d.Level)))
	Labels.Rebirth:SetText(string.format("Rebirth %s, %s", N.fmtNum(d.Rebirth), if d.RebirthReady == true then "READY" else "cap not reached"))
	Labels.Arena:SetText(N.arenaText())
	Labels.Claim:SetText(if N.inLobby then (if st.daily then string.format("Spins ready %d, calendar %s", N.spinsOf(st.daily), if type(st.daily.cal) == "table" and st.daily.cal.claimable then "ready" else "claimed") else "Daily state not received yet") else "Claims run in the lobby")
	if Feeds.Chests and N.ChestFeed[1] ~= lastChestTop then
		lastChestTop = N.ChestFeed[1]
		local rows = {}
		for _, c in ipairs(N.ChestFeed) do
			table.insert(rows, { key = c.name .. c.at, name = c.name, sub = c.sub, value = c.value, nameColor = if c.rarity == "Mythic" or c.rarity == "Legendary" then "good" else nil })
