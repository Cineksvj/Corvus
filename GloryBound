	-- Library:ResetHubOptions(ignore) - every toggle/option back to its Default (no prompt);
	-- Library:AskResetHubOptions(ignore) - the same behind a Yes/No dialog.
	function Library:AskResetHubOptions(ignore)
		Library:Confirm("Reset every hub option to its default? Saved configs stay on disk.", function()
			Library:ResetHubOptions(ignore)
		end)
	end
	function Library:ResetHubOptions(ignore)
		ignore = type(ignore) == "table" and ignore or {}
		do
			local n = 0
			Library._batchSuppress = true
			for idx, t in pairs(Library.Toggles or {}) do
				if type(idx) == "string" and type(t) == "table" and not ignore[idx] and type(t.SetValue) == "function" then
					pcall(function() t:SetValue(t.Default == true) end); n += 1
				end
			end
			for idx, o in pairs(Library.Options or {}) do
				if type(idx) == "string" and type(o) == "table" and not ignore[idx] and o.Default ~= nil and type(o.SetValue) == "function"
					and (o.Type == "Slider" or o.Type == "Dropdown" or o.Type == "Input" or o.Type == "KeyPicker" or o.Type == "WebhookBoard") then
					pcall(function() o:SetValue(o.Default) end); n += 1
				end
			end
			Library._batchSuppress = false
			Library._userOn = {}
			for _, tab in pairs(Library.Tabs or {}) do
				if type(tab) == "table" and type(tab._refreshNavPill) == "function" then pcall(tab._refreshNavPill, tab) end
			end
			if type(Library.CorvusLog) == "function" then pcall(Library.CorvusLog, Library, "RESET hub options n=" .. n) end
			Library:Notify("Hub options reset (" .. n .. ")", 3)
		end
	end

	-- -------------------- window:AddSettingsTab(opts)
	-- Hubs call this with { ThemeManager, SaveManager, Folder, MenuKeybind }. The Obsidian
	-- SaveManager addon is used only for its data side (Save/Load/Delete/autoload files);
	-- the UI is ours. One theme ships, so ThemeManager is not surfaced.
	function window:AddSettingsTab(opts)
		opts = opts or {}
		local SM = opts.SaveManager
		local smOk = type(SM) == "table" and type(rawget(SM, "Save")) == "function"
		local folder = "Corvus/" .. tostring(opts.Folder or Footprint)
		if smOk then
			pcall(function() SM:SetLibrary(Library) end)
			pcall(function() SM:IgnoreThemeSettings() end)
			pcall(function() SM:SetIgnoreIndexes({ "UIScale", "UIScaleUser", "AvatarSpin", "Anonymous", "Starfield", "LowEffects", "FocusBlur", "UISounds", "LoadingScreen", "Theme", "AccentColor", "Diagnostics", "BlockRobuxPrompts", "CorvusAntiAFK", "SaveManager_ConfigName", "SaveManager_ConfigList" }) end)
			pcall(function() SM:SetFolder(folder) end)
			pcall(function() SM:BuildFolderTree(true) end)
			if type(Library.HardenSaveManager) == "function" then pcall(Library.HardenSaveManager, Library, SM) end
			Library.SaveManager = SM
		end

		local tab = window:AddTab({ Name = opts.Name or "Settings", Icon = opts.Icon or "settings", Workflow = "setup", Order = opts.Order or 1 })

		-- Configuration
		local cfg = tab:AddLeftGroupbox("Configuration", "save")
		-- Auto save (owner 2026-11-01 "auto save option default on"): every change writes the
		-- "autosave" config two seconds later and the next start loads it, so nothing has to be
		-- saved by hand. The one toggle that starts ON (his explicit ask). It never shows in the
		-- list and never beats a "Load on start" config.
		local AUTOSAVE = "autosave"
		local autoSaveOn = true
		if type(Library.GetSetting) == "function" then
			local okA, vA = pcall(Library.GetSetting, Library, "AutoSave", true)
			autoSaveOn = not (okA and vA == false)
		end
		local autoSavePending, autoSaveReady = false, false
		local function scheduleAutoSave()
			if not (smOk and autoSaveOn and autoSaveReady) or autoSavePending then return end
			if rawget(Library, "ConfigLoading") == true then return end
			autoSavePending = true
			task.delay(2, function()
				autoSavePending = false
				if not (smOk and autoSaveOn) or Library.Unloaded == true then return end
				local ok, err = SM:Save(AUTOSAVE)
				if type(Library.CorvusLog) == "function" then
					pcall(Library.CorvusLog, Library, ok and "AUTOSAVE written" or ("AUTOSAVE failed: " .. tostring(err)))
				end
			end)
		end
		do
			local prev = rawget(Library, "OnOptionChanged")
			rawset(Library, "OnOptionChanged", function(o)
				if type(prev) == "function" then pcall(prev, o) end
				scheduleAutoSave()
			end)
		end
		local function rawNames()
			if not smOk then return {} end
			local ok, v = pcall(SM.RefreshConfigList, SM)
			return (ok and type(v) == "table") and v or {}
		end
		local function listNames()
			local out = {}
			for _, n in ipairs(rawNames()) do
				if n ~= AUTOSAVE then table.insert(out, n) end
			end
			return out
		end
		local nameInput = cfg:AddInput("SaveManager_ConfigName", { Text = "Config name", Placeholder = "e.g. farm", Default = "" })
		-- (owner 2026-11-01: the list opened as an empty black bar and the pill said "...") the
		-- empty list has a row that says so, the pill asks for a pick
		local list = cfg:AddDropdown("SaveManager_ConfigList", { Text = "Saved configs", Values = listNames(), AllowNull = true, Placeholder = "Pick a config", EmptyText = "No configs yet" })
		local autoLbl, autoTg
		-- the addon answers "none" (a string) when no autoload is set; here that is nil
		local function autoName()
			if not smOk then return nil end
			local ok, name = pcall(SM.GetAutoloadConfig, SM)
			if ok and type(name) == "string" and name ~= "" and name ~= "none" then return name end
			return nil
		end
		local function autoloadText()
			if not smOk then return "Configs need the addon, which did not load" end
			local name = autoName()
			if name then return "Loads " .. name .. " on start" end
			return ""
		end
