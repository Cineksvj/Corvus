-- ---------------------------------------------------------------- gethui / parent
local function getParentGui()
	-- 1) exploit path: gethui() -> hidden ui holder
	if type(gethui) == "function" then
		local ok, h = pcall(gethui)
		if ok and h then return h end
	end
	-- 2) direct CoreGui (works in Studio with LoadStringEnabled or in some executors)
	local ok, c = pcall(function() return CoreGui end)
	if ok and c then
		-- Try an inst parent probe
		local ok2 = pcall(function() local _ = c:GetChildren() end)
		if ok2 then return c end
	end
	-- 3) PlayerGui fallback
	if LocalPlayer then
		local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
		if pg then return pg end
	end
	return CoreGui
end

-- ---------------------------------------------------------------- Classes
-- Each class is a metatable with __index = self so method calls dispatch
-- correctly from both the shell and Agent B/C/D additions.
local WindowClass   = Library.Classes.Window   or {}
local TabClass      = Library.Classes.Tab      or {}
local GroupboxClass = Library.Classes.Groupbox or {}
WindowClass.__index   = WindowClass
TabClass.__index      = TabClass
GroupboxClass.__index = GroupboxClass
Library.Classes.Window   = WindowClass
Library.Classes.Tab      = TabClass
Library.Classes.Groupbox = GroupboxClass

-- ---------------------------------------------------------------- MakeGroupbox fallback
-- Agent B provides the real MakeGroupbox with controls. If it never ran (dev
-- bundle, stripped build), ship a stub that still renders a header + list
-- container so pages don't nil-crash. The stub returns a Groupbox with no-op
-- Add* members, each warning once.
if type(Library.MakeGroupbox) ~= "function" then
	local warnedKey = {}
	local function stubWarn(method)
		if warnedKey[method] then return end
		warnedKey[method] = true
		warn(string.format("[Corvus][core] groupbox:%s not registered (Agent B missing)", method))
	end

	function Library:MakeGroupbox(parent, props)
		props = props or {}
		local name  = props.Name or "Groupbox"
		local icon  = props.Icon
		local order = props.LayoutOrder or 1

		local root = Library:New("Frame", {
			Name = "Groupbox_" .. name,
			BackgroundColor3 = Colors.surface,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 40),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order,
			Parent = parent,
		})
		Library:Round(8).Parent = root
		Library:Stroke(Colors.border, 1, 0.3).Parent = root

		local pad = Library:Padding(10, 12, 10, 12)
		pad.Parent = root

		local list = Library:List(Enum.FillDirection.Vertical, 6, "left")
		list.Parent = root

		local header = Library:New("Frame", {
			Name = "Header",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 18),
			LayoutOrder = 0,
			Parent = root,
		})
		local hList = Library:List(Enum.FillDirection.Horizontal, 6, "left")
		hList.VerticalAlignment = Enum.VerticalAlignment.Center
		hList.Parent = header

		if icon then
			local ico = Library:New("TextLabel", {
				Name = "Icon",
				BackgroundTransparency = 1,
				Size = UDim2.new(0, 14, 0, 14),
				Text = tostring(icon),
				FontFace = Fonts.Mono or Fonts.Inter,
				TextSize = 12,
				TextColor3 = Colors.textMid,
				LayoutOrder = 0,
				Parent = header,
			})
			ico.TextXAlignment = Enum.TextXAlignment.Center
		end

		local title = Library:New("TextLabel", {
			Name = "Title",
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			Text = string.upper(name),
			FontFace = Fonts.InterMed or Fonts.Inter,
			TextSize = 10,
			TextColor3 = Colors.muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 1,
			Parent = header,
		})
		title.TextYAlignment = Enum.TextYAlignment.Center

		-- Container children stacked below the header
		local content = Library:New("Frame", {
			Name = "Content",
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0),
			LayoutOrder = 1,
			Parent = root,
		})
		local cList = Library:List(Enum.FillDirection.Vertical, 6, "left")
		cList.Parent = content

		local gb = setmetatable({
			Type = "Groupbox",
			Name = name,
			Icon = icon,
			Container = content,
			Header = header,
			Root = root,
		}, GroupboxClass)

		local function makeStub(method)
			return function(self2, idx, cfg)
				stubWarn(method)
				return self2
			end
		end
		for _, m in ipairs({
			"AddToggle", "AddDropdown", "AddSlider", "AddInput",
			"AddButton", "AddLabel", "AddKeyPicker", "AddColorPicker",
			"AddDivider", "AddDependencyBox",
		}) do
			if type(gb[m]) ~= "function" then
				gb[m] = makeStub(m)
			end
		end

		return gb
	end
end

-- ---------------------------------------------------------------- CreateWindow
-- Primary entry point. Builds the whole shell.
function Library:CreateWindow(opts)
	opts = opts or {}
	local Title     = opts.Title     or "Corvus"
	local Footprint = opts.Footprint or "CorvusHub"
	local Size      = opts.Size      or UDim2.new(0, 780, 0, 590)
	-- Touch layout (2026-10-19, DONE v2): a phone, or any viewport under 900 px wide, gets the
	-- window sized to the screen at scale 1 (the desktop window shrunk to fit gave 7 px labels),
	-- no sidebar (a tab bar under the topbar instead), stacked columns and 36 px controls.
	-- opts.Touch = true / false forces it; Library.Touch tells the controls.
	local vp0 = Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
	local touch = opts.Touch
	if touch == nil then touch = Library:IsMobile() or vp0.X < 900 end
	touch = touch == true
	-- owner 2026-11-03 ("make it the same ui as in laptop ... smaller by default on mobile ... better
	-- optimized for mobile"): a phone gets the laptop window - sidebar, two columns, status bar,
	-- draggable - in a window smaller than the screen at scale 1, with the touch sizes of the
	-- controls (Library.Touch: 36 px rows, 12 px text floor, finger-safe sliders). The full-screen
	-- tab-bar layout stays behind opts.TouchLayout = true. touchDevice = a phone; touch = that layout.
	local touchDevice = touch
	touch = touchDevice and opts.TouchLayout == true
	rawset(Library, "Touch", touchDevice)
	rawset(Library, "TouchLayout", touch)
	local TOUCH_INSET = 8
	if touch then
		Size = UDim2.new(0, math.max(300, vp0.X - TOUCH_INSET * 2), 0, math.max(240, vp0.Y - TOUCH_INSET * 2))
	elseif touchDevice then
		-- sized against the safe area once the ScreenGui exists (see PHONE_FILL below)
	elseif type(Library.GetSetting) == "function" then
		-- A5: a size the player dragged earlier wins over the hub default
		local okWs, ws = pcall(Library.GetSetting, Library, "WindowSize", nil)
		if okWs and type(ws) == "table" and tonumber(ws.w) and tonumber(ws.h) then
			Size = UDim2.new(0, math.clamp(ws.w, 540, 1600), 0, math.clamp(ws.h, 420, 1100))
		end
	end
	local Center    = opts.Center ~= false
	-- owner 2026-11-01 ("smoother and better without these squares"): the window itself moves,
	-- owner 2026-11-02 ("dragowanie mialo miec ten fajny efekt"): the outline with the corner
	-- brackets follows the pointer and the window glides after it on release; "classic" (the
	-- window itself on RenderStepped) stays an option, "none" locks it
	local DragMode  = opts.DragMode  or "ghost"

	-- -------------------- ScreenGui
	local parentGui = getParentGui()
	-- Kill ANY previous Corvus/Hub ScreenGui left behind in CoreGui/PlayerGui/RobloxGui/gethui
	-- so a hot-reload does not stack two hubs on top of each other.
	local scanRoots = {}
	table.insert(scanRoots, parentGui)
	pcall(function() table.insert(scanRoots, CoreGui) end)
	pcall(function()
		if LocalPlayer then
			local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
			if pg then table.insert(scanRoots, pg) end
		end
	end)
	pcall(function()
		local rg = CoreGui and CoreGui:FindFirstChild("RobloxGui")
		if rg then table.insert(scanRoots, rg) end
	end)
	pcall(function()
		if type(gethui) == "function" then
			local hui = select(2, pcall(gethui))
			if hui then table.insert(scanRoots, hui) end
		end
	end)
	local seen = {}
	for _, scanParent in ipairs(scanRoots) do
		if scanParent and not seen[scanParent] then
			seen[scanParent] = true
			pcall(function()
				for _, child in ipairs(scanParent:GetChildren()) do
					if child:IsA("ScreenGui") then
						local n = child.Name or ""
						if n == Footprint
							or n:find("^" .. Footprint)
							or n:find("Corvus")
							or n == "LinoriaLibSettings"
							or n == "CorvusHub"
							or n == "Hub"
						then
							pcall(function() child:Destroy() end)
						end
					end
				end
			end)
		end
	end
	-- Also wipe any stray Library.ScreenGui reference pointing at a dead instance
	if Library.ScreenGui and Library.ScreenGui.Parent then
		pcall(function() Library.ScreenGui:Destroy() end)
	end
	Library.ScreenGui = nil
	local screenGui = Library:New("ScreenGui", {
		Name = Footprint .. "_" .. tostring(os.time()),
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 10,
	})
	-- Protect from CoreGui destruction when supported
	if type(syn) == "table" and type(syn.protect_gui) == "function" then
		pcall(syn.protect_gui, screenGui)
	elseif type(protect_gui) == "function" then
		pcall(protect_gui, screenGui)
	end
	pcall(function() screenGui.Parent = parentGui end)
	Library.ScreenGui = screenGui
	-- phones (Discord 2026-11-02, "bugs with the frame"): the window kept 8 px from the raw screen
	-- edge, so on a notched phone its left edge, the state box and the first tab sat under the
	-- notch and the home bar; the gui keeps out of the device's unsafe areas (the top bar stays
	-- covered as before: its buttons sit over the state box, never over a tab) and the window is
	-- sized to that area, see touchArea
	if touchDevice then pcall(function() screenGui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets end) end
	local function touchArea()
		local a = screenGui.AbsoluteSize
		if a.X > 1 and a.Y > 1 then return a end
		return Camera and Camera.ViewportSize or vp0
	end

	-- -------------------- Main window frame
	-- Whole-window UIScale (owner 2026-10-19: text too small to read at 1x).
	-- owner 2026-11-01 ("125 % of today's 100 % is the new 100 %"): the window scale is a fixed
	-- base (1.43 on desktop: his 1.14 times 1.25) times a user factor the Settings slider shows
	-- as a percentage (setting UIScaleUser, 70-130 %, default 100 %). The old UIScale setting is
	-- not read any more.
	local SCALE_BASE = touchDevice and 1 or 1.43
	local userScale = tonumber(opts.Scale)
	if not userScale and type(Library.GetSetting) == "function" then
		local ok, v = pcall(Library.GetSetting, Library, "UIScaleUser", 1)
		if ok then userScale = tonumber(v) end
	end
	userScale = math.clamp(userScale or 1, 0.7, 1.3)
	rawset(Library, "UIScaleUser", userScale)
	rawset(Library, "UIScaleBase", SCALE_BASE)
	local uiScaleValue = SCALE_BASE * userScale
	if touch then
		-- phone: scale 1 (13 px is 13 logical px); SetUIScale zooms the content and shrinks the
		-- window in logical px so it always stays inside the screen
		uiScaleValue = math.clamp(tonumber(opts.Scale) or 1, 0.8, 1.6)
		local ta = touchArea()
		Size = UDim2.new(0, math.floor((ta.X - TOUCH_INSET * 2) / uiScaleValue), 0, math.floor((ta.Y - TOUCH_INSET * 2) / uiScaleValue))
	else
		if touchDevice then
			-- phone, laptop layout: the hub's window, never more than PHONE_FILL of the safe area, so
			-- the game stays visible around it and the window can be dragged aside
			local PHONE_FILL_X, PHONE_FILL_Y = 0.86, 0.9
			local ta = touchArea()
			Size = UDim2.new(0, math.floor(math.min(Size.X.Offset, ta.X * PHONE_FILL_X / uiScaleValue)), 0, math.floor(math.min(Size.Y.Offset, ta.Y * PHONE_FILL_Y / uiScaleValue)))
		end
		-- never larger than the viewport (windowed Roblox, small laptops): leave a 24 px margin
		local fit = math.min((vp0.X - 24) / math.max(1, Size.X.Offset), (vp0.Y - 24) / math.max(1, Size.Y.Offset))
		if fit > 0 and fit < uiScaleValue then uiScaleValue = math.max(0.6, fit) end
	end
	Library.UIScale = uiScaleValue
	local mainPos
	if touch then
		mainPos = UDim2.fromOffset(TOUCH_INSET, TOUCH_INSET)
	elseif Center then
		mainPos = UDim2.new(0.5, -Size.X.Offset * uiScaleValue / 2, 0.5, -Size.Y.Offset * uiScaleValue / 2)
	else
		mainPos = opts.Position or UDim2.new(0, 80, 0, 80)
	end

	-- Mockup .hub: #050506, 1px #1A1B21, radius 18, padding 14, grid 180px | 1fr gap 14
	local PAD, SIDEBAR_W, GAP = touch and 10 or 14, touch and 0 or 180, 14
	local main = Library:New("Frame", {
		Name = "Main",
		BackgroundColor3 = Colors.window,
		BackgroundTransparency = 0,   -- solid: the game never bleeds through the hub (owner 2026-10-19)
		BorderSizePixel = 0,
		Size = Size,
		Position = mainPos,
		Active = true,
		ClipsDescendants = true,
		Parent = screenGui,
	})
	-- Owner 2026-10-31 ("make the edges better"): a machined edge. 4 px corners, a strong hairline
	-- outside and a near-black line one px inside it, so the rim reads as a cut edge and not as a
	-- glow. The walking bezel light of 2026-10-19 (2 px, radius 18) lit one rounded corner: gone.
	-- owner 2026-10-31 night ("make these corners more round"): 12 px window, inner line one px in
	Library:Round(12).Parent = main
	-- owner 2026-10-31 night, second pass ("outline wokol huba bardzo AI-owo"): no turning light
	-- and no halo. The rim is the card edge at window scale: one 1 px stroke lit from above
	-- (bright at the top, steel in the middle, dark at the foot), the dark inner line one px
	-- inside it (below) and a soot drop under the window (built after the window scale), so
	-- the window sits on the game instead of floating in a glow. Nothing moves.
	local rimLight = Library:Stroke(hex("#BFC4CC"), 1, 0)
	rimLight.Name = "RimLight"
	rimLight.Parent = main
	Library:New("UIGradient", {
		Name = "Lit",
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, hex("#CDD2DA")),
			ColorSequenceKeypoint.new(0.42, hex("#737B8A")),
			ColorSequenceKeypoint.new(1, hex("#3C424D")),
		}),
		Parent = rimLight,
	})
	local rimSpins = {}   -- nothing spins any more; SetLowEffects still walks the list
	rawset(Library, "_rimSpins", rimSpins)
	do
		local innerEdge = Library:New("Frame", {
			Name = "InnerEdge",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 1, 0, 1),
			Size = UDim2.new(1, -2, 1, -2),
			ZIndex = 95,
			Parent = main,
		})
		Library:Round(11).Parent = innerEdge
		Library:Stroke(Colors.bg, 1, 0.2).Parent = innerEdge
	end
	local mainBezel = nil   -- BezelSweep(nil) is a no-op
	-- (the "studio light" discs of 09:00 lifted the whole window by ~8 %: owner 09:35 "hub za jasny" -> removed)
	-- Backdrop (owner 2026-10-20 "wiecej gradientow, plain granat wyglada chujowo"): the window body
	-- is a diagonal slate -> window -> near-black ramp plus a cool silver haze from the top-left
	-- and a faint counter-haze bottom-right. Average brightness stays at the window colour (the
	-- 09:35 "za jasny" rule); both derive from main.BackgroundColor3 so themes keep working.
	do
		local backdrop = Library:New("Frame", {
			Name = "Backdrop",
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 1, 0),
			ZIndex = 0,
			Parent = main,
		})
		Library:Round(12).Parent = backdrop
		local ramp = Library:New("UIGradient", { Rotation = 32, Parent = backdrop })
		local haze = Library:New("Frame", {
			Name = "Haze",
			BackgroundColor3 = hex("#9AA6BE"),
			BorderSizePixel = 0,
			-- full size: a 85 x 75 % frame left a hard edge in the sidebar (render 2026-10-31 night)
			Size = UDim2.new(1, 0, 1, 0),
			ZIndex = 0,
			Parent = backdrop,
		})
		Library:Round(12).Parent = haze   -- ClipsDescendants clips to the box, not the round: the hazes carry their own corners
		Library:New("UIGradient", {
			Rotation = 38,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.955),   -- owner 2026-11-01: a touch lighter, the stars read through it
				NumberSequenceKeypoint.new(0.3, 0.975),
				NumberSequenceKeypoint.new(0.6, 1),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = haze,
		})
		local counter = Library:New("Frame", {
			Name = "CounterHaze",
			BackgroundColor3 = hex("#6E7A94"),
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, 0, 1, 0),
			Size = UDim2.new(1, 0, 1, 0),
			ZIndex = 0,
			Parent = backdrop,
		})
		Library:Round(12).Parent = counter
		Library:New("UIGradient", {
			Rotation = -142,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.96),
				NumberSequenceKeypoint.new(0.6, 1),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = counter,
		})
		local function paintRamp()
			local w = main.BackgroundColor3
			ramp.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, w:Lerp(hex("#2A3140"), 0.22)),
				ColorSequenceKeypoint.new(0.5, w),
				ColorSequenceKeypoint.new(1, w:Lerp(Color3.new(0, 0, 0), 0.42)),
			})
		end
		paintRamp()
		main:GetPropertyChangedSignal("BackgroundColor3"):Connect(paintRamp)
	end
	local mainScale = Instance.new("UIScale")
	mainScale.Name = "UIScale"
	mainScale.Scale = uiScaleValue
	mainScale.Parent = main
	-- the drop: a frame under the window with the window's place, size and scale, two soot
	-- strokes outside its edge (2 px at 70 %, 6 px at 90 %), so the lit rim has something dark
	-- to stand on over a bright game. It follows the window and hides with it.
	local halo = Library:New("Frame", {
		Name = "Drop",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = main.AnchorPoint,
		Position = main.Position,
		Size = main.Size,
		ZIndex = 0,
		Visible = main.Visible,
		Parent = screenGui,
	})
	Library:Round(12).Parent = halo
	local haloScale = Instance.new("UIScale")
	haloScale.Scale = mainScale.Scale
	haloScale.Parent = halo
	for _, spec in ipairs({ { 2, 0.7 }, { 6, 0.9 } }) do
		local s = Library:Stroke(Colors.bg, spec[1], spec[2])
		s.Parent = halo
	end
	local function syncHalo()
		halo.AnchorPoint, halo.Position, halo.Size = main.AnchorPoint, main.Position, main.Size
		haloScale.Scale = mainScale.Scale
		halo.Visible = main.Visible and rawget(Library, "LowEffects") ~= true
	end
	for _, p in ipairs({ "Position", "Size", "AnchorPoint", "Visible" }) do
		Library:GiveSignal(main:GetPropertyChangedSignal(p):Connect(syncHalo))
	end
	Library:GiveSignal(mainScale:GetPropertyChangedSignal("Scale"):Connect(syncHalo))
	rawset(Library, "_syncHalo", syncHalo)
	syncHalo()
	local applyTouchRows   -- defined with the topbar: landscape phones fold the tab bar into it
	local function fitTouchWindow(s)
		-- touch: the window is the safe area minus the inset, in logical px of the current scale
		local vp = touchArea()
		main.Size = UDim2.fromOffset(math.floor((vp.X - TOUCH_INSET * 2) / s), math.floor((vp.Y - TOUCH_INSET * 2) / s))
		main.Position = UDim2.fromOffset(TOUCH_INSET, TOUCH_INSET)
		Size = main.Size
		if applyTouchRows then applyTouchRows(vp.Y / s < 500) end
	end
	-- the slider hands in the user factor; the applied scale is base x user, capped so the window
	-- stays inside the viewport (the same 24 px margin as at boot)
	function Library:SetUIScale(u)
		u = math.clamp(tonumber(u) or 1, 0.7, 1.3)
		rawset(Library, "UIScaleUser", u)
		local want = SCALE_BASE * u
		Library._wantedScale = want
		local s = want
		if not touch then
			local vp = Camera and Camera.ViewportSize or vp0
			local fit = math.min((vp.X - 24) / math.max(1, Size.X.Offset), (vp.Y - 24) / math.max(1, Size.Y.Offset))
			if fit > 0 then s = math.max(0.6, math.min(want, fit)) end
		end
		Library.UIScale = s
		mainScale.Scale = s
		if touch then fitTouchWindow(s) end
		if type(Library.SetSetting) == "function" then pcall(Library.SetSetting, Library, "UIScaleUser", u) end
	end
	-- Re-fit when the Roblox window is resized (fullscreen <-> windowed)
	rawset(Library, "_wantedScale", rawget(Library, "_wantedScale") or uiScaleValue)
	if Camera then
		Library:GiveSignal(Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			local vp = Camera.ViewportSize
			if touch then fitTouchWindow(mainScale.Scale > 0 and mainScale.Scale or 1) return end
			local want = Library._wantedScale or uiScaleValue
			local fit = math.min((vp.X - 24) / math.max(1, Size.X.Offset), (vp.Y - 24) / math.max(1, Size.Y.Offset))
			local s = math.max(0.6, math.min(want, fit))
			if math.abs(mainScale.Scale - s) > 0.01 then
				mainScale.Scale = s
				Library.UIScale = s
			end
			-- keep the window on screen
			local sz = Vector2.new(Size.X.Offset * s, Size.Y.Offset * s)
			local pos = main.AbsolutePosition - screenGui.AbsolutePosition
			local nx = math.clamp(pos.X, 0, math.max(0, vp.X - sz.X))
			local ny = math.clamp(pos.Y, 0, math.max(0, vp.Y - sz.Y))
			if nx ~= pos.X or ny ~= pos.Y then main.Position = UDim2.fromOffset(nx, ny) end
		end))
	end
	if touch then
		-- the safe area changes a frame after the viewport on rotation: refit on it too
		Library:GiveSignal(screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			fitTouchWindow(mainScale.Scale > 0 and mainScale.Scale or 1)
		end))
	end
	if touchDevice then
		-- the on-screen keyboard covers the lower half of a phone and the game moves no gui for it,
		-- so a box focused low on the page was typed into blind (Discord 2026-11-02): the page
		-- scrolls so the box sits 72 px under the page's top edge
		pcall(function()
			Library:GiveSignal(UserInputService.TextBoxFocused:Connect(function(tb)
				if not tb or not tb:IsDescendantOf(screenGui) then return end
				local page = tb:FindFirstAncestorWhichIsA("ScrollingFrame")
				while page and page.ScrollingDirection == Enum.ScrollingDirection.X do
					page = page.Parent and page.Parent:FindFirstAncestorWhichIsA("ScrollingFrame") or nil
				end
				if not page then return end
				local want = page.CanvasPosition.Y + (tb.AbsolutePosition.Y - page.AbsolutePosition.Y) - 72
				want = math.clamp(want, 0, math.max(0, page.AbsoluteCanvasSize.Y - page.AbsoluteSize.Y))
				if math.abs(want - page.CanvasPosition.Y) > 2 then
					Library:NewTween(page, 0.18, { CanvasPosition = Vector2.new(page.CanvasPosition.X, want) }, Enum.EasingStyle.Quad)
				end
