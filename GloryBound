		compactBtn.Text = v and "\194\187" or "\194\171"
		if not instant and type(Library.SetSetting) == "function" then pcall(Library.SetSetting, Library, "Compact", v) end
		-- after the 0.22 s width tween: the pill and the narrow check read final sizes
		task.delay(instant and 0 or 0.24, function()
			if self.Compact ~= v then return end
			if self.ActiveTab and self.ActiveTab.Entry then pcall(self.Sidebar.MovePillTo, self.ActiveTab.Entry, true) end
			local he = rawget(self, "_hoverEntry")
			if he then pcall(self.Sidebar.HoverEntry, he) end   -- the row resized under a still pointer
			pcall(self._updateNarrow, self)
		end)
		return self
	end
