-- the lobby and the arena are different servers: the hub queues itself for the next one and carries the switches
do
	local KeepOnTeleport = true
	local function queueSelf()
		local queue = queue_on_teleport or (typeof(syn) == "table" and syn.queue_on_teleport) or queueonteleport
		if type(queue) ~= "function" or INSTANCE.queued then
			return INSTANCE.queued == true
		end
		if type(clear_teleport_queue) == "function" then
			pcall(clear_teleport_queue)
		end
		INSTANCE.queued = pcall(
			queue,
			table.concat({
				"if not game:IsLoaded() then game.Loaded:Wait() end",
				"if game.PlaceId ~= " .. tostring(game.PlaceId) .. " then return end",
				LoaderScript,
			}, "\n")
		)
		log("TELEPORT loader queued", INSTANCE.queued)
		return INSTANCE.queued
	end
	if Tabs.Misc then
		pcall(function()
			local ExecBox = Tabs.Misc:AddRightGroupbox("Auto execute", "zap")
			ExecBox:AddToggle("KeepOnTeleport", {
				Text = "Keep after teleport",
				Default = true,
				Tooltip = "The game moves you between the lobby and the arena; the hub starts again there with the same switches",
				Callback = function(value)
					KeepOnTeleport = value
				end,
			})
			ExecBox:AddButton({
				Text = "Copy loader",
				Func = function()
					local copied = setclipboard and pcall(setclipboard, LoaderScript)
					notify("Loader", if copied then "Copied, put it in your executor's autoexec folder to start the hub on join" else LoaderScript, 6)
				end,
			})
		end)
	end
	Library:GiveSignal(LocalPlayer.OnTeleport:Connect(function(state)
		if state == Enum.TeleportState.Started and KeepOnTeleport then
			queueSelf()
			pcall(N.persistCarry)
			flushLog(true)
		end
	end))
	queueSelf()
	-- the switches of the hub that teleported us here (within 3 minutes)
	task.delay(1, function()
		local names = N.readCarry()
		if #names > 0 then
			N.quiet = true
			for _, name in ipairs(names) do
				pcall(N.setToggle, name, true)
			end
			N.quiet = false
			log("CARRY restored", table.concat(names, ","))
		end
	end)
end
