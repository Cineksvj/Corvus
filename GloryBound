local function hazardAt(p, hz)
	for _, h in ipairs(hz) do
		if h.ring then -- boss ring wave: everything outside the safe disc (centre ring, radius inner) is hit
			if flat(p - h.ring).Magnitude > h.inner then return h end
		elseif h.band then -- Glaucus vortex: a whirlpool orbiting the centre at Orbit, everything in the band it sweeps
			local d = flat(p - h.band).Magnitude
			if d > h.lo and d < h.hi then return h end
		elseif h.sector then -- Hydra tail sweep: a cone from the body along dir
			local v = flat(p - h.sector)
			local d = v.Magnitude
			if d < h.r and (d < 4 or v.Unit:Dot(h.dir) > h.cos) then return h end
		elseif h.a then -- lane: the path of a charge / lunge (segment a->b, half width w)
			local ab, ap = flat(h.b - h.a), flat(p - h.a)
			local L = ab.Magnitude
			local tt = L > 0.1 and math.clamp(ap:Dot(ab) / (L * L), 0, 1) or 0
			if (ap - ab * tt).Magnitude < h.w then return h end
		elseif flat(p - h.pos).Magnitude < h.r then return h end
	end
end
