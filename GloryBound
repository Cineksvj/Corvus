            ScaleType = Enum.ScaleType.Fit,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(28, 28),
            Parent = r,
        })
        local name = text({
            Name = "Name",
            Text = "",
            TextSize = 13,
            FontFace = Fonts.SansMed or Fonts.Sans,
            TextColor3 = Colors.text or Colors.Ink,
            Position = UDim2.new(0, 36, 0, 2),
            Size = UDim2.new(1, -36 - 96, 0, 16),
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = r,
        })
        local sub = text({
            Name = "Sub",
            Text = "",
            TextSize = 11,
            FontFace = Fonts.Sans,
            TextColor3 = Colors.glyph or Colors.muted or Colors.Smoke,
            Position = UDim2.new(0, 36, 0, 19),
            Size = UDim2.new(1, -36 - 96, 0, 14),
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = r,
        })
        sub.RichText = true
        -- owner 2026-11-01 ("the cash/s in last catches has weird font"): the value is body text
        -- in the medium weight, the Oswald numerals stay on the stat tiles
        local value = text({
            Name = "Value",
            Text = "",
            TextSize = 13,
            FontFace = Fonts.SansMed or Fonts.InterMed or Fonts.Sans,
            TextColor3 = Colors.text or Colors.Ink,
            TextXAlignment = Enum.TextXAlignment.Right,
            Position = UDim2.new(1, -92, 0, 1),
            Size = UDim2.new(0, 92, 0, 17),
            Parent = r,
        })
        local time = text({
            Name = "Time",
            Text = "",
            TextSize = 10,
            FontFace = Fonts.Mono or Fonts.Sans,
            TextColor3 = Colors.muted or Colors.Smoke,
            TextXAlignment = Enum.TextXAlignment.Right,
            Position = UDim2.new(1, -92, 0, 20),
            Size = UDim2.new(0, 92, 0, 13),
            Parent = r,
        })
        local rule = new("Frame", {
            Name = "Rule",
            BackgroundColor3 = Colors.WellEdge,
            BackgroundTransparency = 0.5,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 36, 1, -1),
            Size = UDim2.new(1, -36, 0, 1),
            Parent = r,
        })
        items[i] = { Row = r, Pic = pic, Name = name, Sub = sub, Value = value, Time = time, Rule = rule, Key = nil }
    end
    local empty = text({
        Name = "Empty",
        Text = props.Empty or "Nothing yet",
        TextSize = 12,
        FontFace = Fonts.Sans,
        TextColor3 = Colors.glyph or Colors.muted or Colors.Smoke,
        Size = UDim2.new(1, 0, 0, 24),
        Parent = holder,
    })
    local function setText(lbl, v)
        v = tostring(v == nil and "" or v)
        if lbl.Text ~= v then lbl.Text = v end
    end
    local function col(v, fallback)
        return typeof(v) == "Color3" and v or fallback
    end
    local fd = { Type = "Feed", Instance = holder, Rows = items }
    function fd:Set(list)
        list = type(list) == "table" and list or {}
        empty.Visible = #list == 0
        local n = 0
        for i, it in ipairs(items) do
            local d = list[i]
            if type(d) == "table" then
                n = i
                local key = d.key ~= nil and tostring(d.key) or (tostring(d.name) .. "|" .. tostring(d.value))
                local fresh = it.Key ~= key
                it.Key = key
                local icon = d.icon and tostring(d.icon) or ""
                if it.Pic.Image ~= icon then it.Pic.Image = icon end
                it.Pic.Visible = icon ~= ""
                it.Pic.ImageColor3 = col(d.iconColor, Color3.new(1, 1, 1))
                setText(it.Name, d.name)
                it.Name.TextColor3 = col(d.nameColor, Colors.text or Colors.Ink)
                setText(it.Sub, d.sub)
                setText(it.Value, d.value)
                it.Value.TextColor3 = col(d.valueColor, Colors.text or Colors.Ink)
                setText(it.Time, d.time)
                if not it.Row.Visible then it.Row.Visible = true end
                if fresh and i == 1 and rawget(Library, "LowEffects") ~= true then
                    it.Row.Position = UDim2.new(0, 0, 0, -6)
                    for _, l in ipairs({ it.Name, it.Sub, it.Value, it.Time }) do l.TextTransparency = 1 end
                    it.Pic.ImageTransparency = 1
                    tween(it.Row, 0.22, Enum.EasingStyle.Quint, { Position = UDim2.new(0, 0, 0, 0) })
                    for _, l in ipairs({ it.Name, it.Sub, it.Value, it.Time }) do tween(l, 0.22, nil, { TextTransparency = 0 }) end
                    tween(it.Pic, 0.22, nil, { ImageTransparency = 0 })
                end
            elseif it.Row.Visible then
                it.Row.Visible = false
                it.Key = nil
            end
        end
        for i, it in ipairs(items) do it.Rule.Visible = i < n end
        holder.Size = UDim2.new(1, 0, 0, math.max(24, n * FEED_ROW))
    end
    table.insert(self._controls, fd)
    return fd
end

-- ============================================================================
--                              CATALOG (the game's own shop, in the hub)
-- ============================================================================
-- groupbox:AddCatalog({ Height = 132, Empty = "Nothing here" }) -> cat:Set(items)
--   items[i] = { icon, name, tag, tagColor, line, status, statusColor, selected, dim,
--                action = { text, func } }
-- A horizontal strip of cards, scrolled sideways like the shop in the game (owner 2026-10-31
-- night: "dokladnie tak samo jak w grze, scroll poziomo"). Each card: a 56 px IconPlate with
-- the game's own picture - an image id, or the game's 3D Model rendered in a ViewportFrame
-- (TFF draws its foods that way, there are no 2D icons) - the name, a coloured tag (rarity),
-- one line (bait / price) and at the foot either a status word or a small action button.
-- Hover lifts the card, the selected card (equipped / current) carries the lit edge, a dim
-- card (locked) fades its text. Colours may be Color3 or one of "good" / "amber" / "bad" /
-- "muted" / "text".
local CAT_CARD_W, CAT_GAP, CAT_PLATE = 112, 8, 56
-- the model sits in the plate like the game frames it: 40 deg lens, a three-quarter view from
-- the front-right and a little above, the bounding sphere filling the frame, the game's own
-- soft lighting (ambient 0.78, white key from the top-left)
local CAT_VIEW_DIR = Vector3.new(0.55, 0.42, 0.72).Unit
local function catFitView(vp, model)
    local cf, size = model:GetBoundingBox()
    local radius = math.max(size.Magnitude / 2, 0.5)
    local dist = radius / math.sin(math.rad(20)) * 1.02
    local cam = vp:FindFirstChildOfClass("Camera") or new("Camera", { Parent = vp })
    cam.FieldOfView = 40
    cam.CFrame = CFrame.lookAt(cf.Position + CAT_VIEW_DIR * dist, cf.Position)
    vp.CurrentCamera = cam
end
local function catSetModel(tile, model)
    local view = tile:FindFirstChild("View")
    if not view then
        view = new("ViewportFrame", {
            Name = "View",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 1, 0),
            Ambient = Color3.new(0.78, 0.78, 0.78),
            LightColor = Color3.new(1, 1, 1),
            LightDirection = Vector3.new(-1, -1.5, -1),
            ZIndex = (tile.ZIndex or 1) + 2,
            Parent = tile,
        })
    end
    local src = model:GetFullName()
    if view:GetAttribute("Src") == src and view:FindFirstChildOfClass("Model") then view.Visible = true return end
    view:SetAttribute("Src", src)
    local old = view:FindFirstChildOfClass("Model")
    if old then old:Destroy() end
    local ok, clone = pcall(function() return model:Clone() end)
    if not ok or not clone then view.Visible = false return end
    for _, d in ipairs(clone:GetDescendants()) do
        if d:IsA("Highlight") or d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("ParticleEmitter") then d:Destroy() end
    end
    clone.Parent = view
    pcall(catFitView, view, clone)
    view.Visible = true
end
local function catColor(c, fallback)
    if typeof(c) == "Color3" then return c end
    if c == "good" then return Colors.good or Colors.Green end
    if c == "amber" then return Colors.amber or Colors.Amber end
    if c == "bad" then return Colors.bad or Colors.Red end
    if c == "muted" then return Colors.muted or Colors.Smoke end
    if c == "text" then return Colors.text or Colors.Ink end
    return fallback
end
-- swap the picture / glyph on a GlassIcon tile that already exists (cards are pooled)
local function catSetIcon(tile, name)
    local img = tile and tile:FindFirstChild("Img")
    local glyph = tile and tile:FindFirstChild("Glyph")
    if not img then return end
    local size = tile.Size.X.Offset > 0 and tile.Size.X.Offset or 26
    local view = tile:FindFirstChild("View")
    if typeof(name) == "Instance" and name:IsA("Model") then
        img.Visible = false
        if glyph then glyph.Visible = false end
        catSetModel(tile, name)
        return
    end
    if view then view.Visible = false end
    if type(name) == "string" and (name:match("^rbxassetid://%d+$") or name:match("^rbxthumb://") or name:match("^rbxasset://") or name:match("^https?://")) then
        if img.Image ~= name then img.Image = name end
        img.ImageColor3 = Color3.new(1, 1, 1)
        img.ImageTransparency = 0
        img.Size = UDim2.new(0, size, 0, size)
        img.Visible = true
        if glyph then glyph.Visible = false end
    elseif type(name) == "string" and name ~= "" and type(Library.ApplyLucideIcon) == "function" then
        local inner = math.floor(size * 0.72)
        img.Size = UDim2.new(0, inner, 0, inner)
        img.ImageColor3 = Colors.text or Colors.Ink
        Library:ApplyLucideIcon(img, name:lower())
        if glyph then glyph.Visible = false end
    else
        img.Visible = false
        if glyph then glyph.Visible = true end
    end
end

function Groupbox:AddCatalog(props)
    props = props or {}
    local H = math.max(120, tonumber(props.Height) or T(160, 172))
    local holder = makeRow(self, H, "Catalog")
    local strip = new("ScrollingFrame", {
        Name = "Strip",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollingDirection = Enum.ScrollingDirection.X,
        ScrollBarThickness = 0,
        ScrollBarImageTransparency = 1,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        ClipsDescendants = true,
        Parent = holder,
    })
    -- 2 px of air inside the clip: a card's 1 px edge is drawn outside its box and the first
    -- card's left edge and every card's top edge were cut (owner 2026-10-31 night)
    padding(strip, 2, 2, 2, 2)
    -- the wheel scrolls the strip sideways, one card per notch (Roblox maps the wheel to Y, so an
    -- X-only frame never moves by itself), and the page behind it stands still while the pointer
    -- is over the strip (owner 2026-10-31 late: "nie da sie scrollowac")
    -- (live 2026-10-31 night: the wheel over the strip reaches UserInputService with
    -- gameProcessed = true and the strip's own InputChanged never fires, so the step is taken
    -- from the service while the pointer is over the strip - MouseEnter / MouseLeave do fire)
    local outer, hovered = nil, false
    strip.MouseEnter:Connect(function()
        -- phones: a finger fires MouseEnter but not always MouseLeave, so the page stayed frozen
        -- after a touch on the strip (Discord 2026-11-02); nested X / Y frames pan on their own there
        if isTouch() then return end
        hovered = true
        outer = strip:FindFirstAncestorWhichIsA("ScrollingFrame")
        if outer then outer.ScrollingEnabled = false end
    end)
    strip.MouseLeave:Connect(function()
        hovered = false
        if outer then outer.ScrollingEnabled = true end
        outer = nil
    end)
    local function stepStrip(z)
        local maxX = math.max(0, strip.AbsoluteCanvasSize.X - strip.AbsoluteSize.X)
        local x = math.clamp(strip.CanvasPosition.X - z * (CAT_CARD_W + CAT_GAP), 0, maxX)
        tween(strip, 0.12, Enum.EasingStyle.Linear, { CanvasPosition = Vector2.new(x, 0) })
    end
    -- edge steps (critique 2026-11-01: the strip ends on a card edge with no hint of more): a
    -- 28 px soot fade at the right while there is more to the right, the same at the left once
    -- the strip has moved, each with a chevron and a click that moves one card. A shade, not a
    -- colour mask, so it never has to match the card gradient.
    local function edgeStep(side)
        local right = side == "Right"
        local f = new("TextButton", {
            Name = side .. "Shade",
            BackgroundColor3 = Colors.bg or Colors.window or Color3.new(0, 0, 0),
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = "",
            AnchorPoint = Vector2.new(right and 1 or 0, 0),
            Position = UDim2.new(right and 1 or 0, 0, 0, 0),
            Size = UDim2.new(0, 28, 1, 0),
            Visible = false,
            ZIndex = 6,
            Parent = holder,
        })
        new("UIGradient", {
            Rotation = right and 0 or 180,
            Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.45, 0.55), NumberSequenceKeypoint.new(1, 0.12) }),
            Parent = f,
        })
        local chev = makeChevron(f, 14, Colors.glyph or Colors.muted or Colors.Brushed, 7)
        chev.Position = UDim2.new(0.5, right and 3 or -3, 0.5, 0)
        chev.Rotation = right and -90 or 90
        f.MouseEnter:Connect(function()
            for _, t in ipairs(chev:GetChildren()) do if t.Name == "Tick" then tween(t, 0.1, nil, { BackgroundColor3 = Colors.text or Colors.Ink }) end end
        end)
        f.MouseLeave:Connect(function()
            for _, t in ipairs(chev:GetChildren()) do if t.Name == "Tick" then tween(t, 0.12, nil, { BackgroundColor3 = Colors.glyph or Colors.muted or Colors.Brushed }) end end
        end)
        f.MouseButton1Click:Connect(function() stepStrip(right and -1 or 1) end)
        return f
    end
    local shadeL, shadeR = edgeStep("Left"), edgeStep("Right")
    local function syncShades()
        local maxX = strip.AbsoluteCanvasSize.X - strip.AbsoluteSize.X
        local x = strip.CanvasPosition.X
        local r, l = maxX - x > 2, x > 2
        if shadeR.Visible ~= r then shadeR.Visible = r end
        if shadeL.Visible ~= l then shadeL.Visible = l end
    end
    for _, pn in ipairs({ "CanvasPosition", "AbsoluteCanvasSize", "AbsoluteSize" }) do
        strip:GetPropertyChangedSignal(pn):Connect(syncShades)
    end
    do
        local UIS = game:GetService("UserInputService")
        local conn = UIS.InputChanged:Connect(function(io)
            if not hovered or io.UserInputType ~= Enum.UserInputType.MouseWheel then return end
            if not strip.Parent or not strip.Visible then return end
            stepStrip(io.Position.Z)
        end)
        if type(Library.GiveSignal) == "function" then Library:GiveSignal(conn) end
        strip.Destroying:Connect(function() hovered = false conn:Disconnect() end)
    end
    local empty = text({
        Name = "Empty",
        Text = tostring(props.Empty or "Nothing here yet"),
        TextSize = 12,
        FontFace = Fonts.Sans,
        TextColor3 = Colors.muted or Colors.Smoke,
        Size = UDim2.new(1, 0, 0, 24),
        Parent = holder,
    })
    local cards = {}
    local function makeCard(i)
        local card = new("Frame", {
            Name = "Card" .. i,
            BackgroundColor3 = Colors.Well,
            BorderSizePixel = 0,
            Position = UDim2.new(0, (i - 1) * (CAT_CARD_W + CAT_GAP), 0, 0),
            Size = UDim2.new(0, CAT_CARD_W, 1, 0),
            Visible = false,
            Parent = strip,
        })
        corner(8, card)
        local edge = stroke(card, Colors.WellEdge, 1, 0)
        local plate, tile = Library:IconPlate(card, "", CAT_PLATE, CAT_PLATE - 4, card.ZIndex + 1)
        plate.AnchorPoint = Vector2.new(0.5, 0)
        plate.Position = UDim2.new(0.5, 0, 0, 8)
        local name = text({
            Name = "Name",
            Text = "",
            TextSize = 12,
            FontFace = Fonts.InterMed or Fonts.SansMed or Fonts.Sans,
            TextColor3 = Colors.text or Colors.Ink,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Position = UDim2.new(0, 6, 0, CAT_PLATE + 14),
            Size = UDim2.new(1, -12, 0, 16),
            ZIndex = 2,
            Parent = card,
        })
        local tag = text({
            Name = "Tag",
            Text = "",
            TextSize = 11,
            FontFace = Fonts.Sans,
            TextColor3 = Colors.muted or Colors.Smoke,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Position = UDim2.new(0, 6, 0, CAT_PLATE + 30),
            Size = UDim2.new(1, -12, 0, 14),
            ZIndex = 2,
            Parent = card,
        })
        local line = text({
            Name = "Line",
            Text = "",
            TextSize = 12,
            FontFace = Fonts.OswaldMed or Fonts.Display or Fonts.Sans,
            TextColor3 = Colors.textMid or TEXT_MID,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Position = UDim2.new(0, 6, 0, CAT_PLATE + 44),
            Size = UDim2.new(1, -12, 0, 14),
            ZIndex = 2,
            Parent = card,
        })
        local status = text({
            Name = "Status",
            Text = "",
            TextSize = 11,
            FontFace = Fonts.InterMed or Fonts.SansMed or Fonts.Sans,
            TextColor3 = Colors.muted or Colors.Smoke,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Position = UDim2.new(0, 6, 1, -26),
            Size = UDim2.new(1, -12, 0, 20),
            ZIndex = 2,
            Parent = card,
        })
        -- the action: a small raised button at the foot (bone fill, soot text), one click = one call
        local btn = new("TextButton", {
            Name = "Action",
            BackgroundColor3 = Colors.moon or Colors.Moon,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 1),
            Position = UDim2.new(0.5, 0, 1, -7),
            Size = UDim2.new(1, -16, 0, 22),
            Text = "",
            AutoButtonColor = false,
            Visible = false,
            ZIndex = 3,
            Parent = card,
        })
        corner(6, btn)
        local btnEdge = stroke(btn, Colors.WellEdge, 1, 1)
        local btnLabel = text({
            Name = "Label",
            Text = "",
            TextSize = 12,
            FontFace = Fonts.InterMed or Fonts.SansMed or Fonts.Sans,
            TextColor3 = Colors.window or Colors.VoidBase,
            TextXAlignment = Enum.TextXAlignment.Center,
            ZIndex = 4,
            Parent = btn,
        })
        local c = { Card = card, Edge = edge, Plate = plate, Tile = tile, Name = name, Tag = tag, Line = line, Status = status, Btn = btn, BtnLabel = btnLabel, BtnEdge = btnEdge, Primary = true, Func = nil, Selected = false }
        connectHover(card,
            function()
                tween(card, 0.09, Enum.EasingStyle.Linear, { BackgroundColor3 = Colors.WellHover })
                if not c.Selected then Edge.set(edge, "Color", Colors.metalLo or Colors.Brushed, 0.09, Enum.EasingStyle.Linear) end
            end,
            function()
                tween(card, 0.12, nil, { BackgroundColor3 = Colors.Well })
                if not c.Selected then Edge.set(edge, "Color", Colors.WellEdge, 0.12) end
            end
        )
        -- (critique 2026-10-31 night: a bone button on every card left the primary action
        -- meaningless) only action.primary wears the bone fill; the rest are well + hairline
        local function paintBtn(hover)
            if c.Primary then
                tween(btn, hover and 0.09 or 0.12, hover and Enum.EasingStyle.Linear or nil, { BackgroundColor3 = hover and (Colors.metalMid or Colors.Moon) or (Colors.moon or Colors.Moon) })
            else
                tween(btn, hover and 0.09 or 0.12, hover and Enum.EasingStyle.Linear or nil, { BackgroundColor3 = hover and (Colors.wellHover or Colors.WellHover) or Colors.Well })
                Edge.set(btnEdge, "Color", hover and (Colors.metalLo or Colors.Brushed) or Colors.WellEdge, 0.1)
            end
        end
        connectHover(btn, function() paintBtn(true) end, function() paintBtn(false) end)
        btn.MouseButton1Click:Connect(function()
            if type(c.Func) ~= "function" then return end
            -- press: the button dips for a frame, then the call runs off the UI thread
            btn.Size = UDim2.new(1, -18, 0, 20)
            tween(btn, 0.12, nil, { Size = UDim2.new(1, -16, 0, 22) })
            task.spawn(c.Func, c.Item)
        end)
        cards[i] = c
        return c
    end
    local cat = { Type = "Catalog", Instance = holder, Strip = strip, Cards = cards, Count = 0 }
    local function setText(lbl, v)
        v = tostring(v == nil and "" or v)
        if lbl.Text ~= v then lbl.Text = v end
    end
    function cat:Set(list)
        list = type(list) == "table" and list or {}
        local n = #list
        empty.Visible = n == 0
        strip.Visible = n > 0
        for i = 1, n do
            local d = list[i]
            local c = cards[i] or makeCard(i)
            c.Item = d
            setText(c.Name, d.name or "")
            setText(c.Tag, d.tag or "")
            c.Tag.TextColor3 = catColor(d.tagColor, Colors.muted or Colors.Smoke)
            setText(c.Line, d.line or "")
            local icon = d.icon
            if c.Icon ~= icon then
                c.Icon = icon
                catSetIcon(c.Tile, icon)
            end
            local act = type(d.action) == "table" and d.action or nil
            if act then
                c.Func = act.func
                setText(c.BtnLabel, act.text or "Buy")
                local prim = act.primary == true
                if c.Primary ~= prim then
                    c.Primary = prim
                    c.Btn.BackgroundColor3 = prim and (Colors.moon or Colors.Moon) or Colors.Well
                    c.BtnLabel.TextColor3 = prim and (Colors.window or Colors.VoidBase) or (Colors.textMid or TEXT_MID)
                    c.BtnEdge.Transparency = prim and 1 or 0
                end
                c.Btn.Visible = true
                c.Status.Visible = false
            else
                c.Func = nil
                c.Btn.Visible = false
                setText(c.Status, d.status or "")
                c.Status.TextColor3 = catColor(d.statusColor, Colors.muted or Colors.Smoke)
                c.Status.Visible = c.Status.Text ~= ""
            end
            local selected = d.selected == true
            if c.Selected ~= selected then
                c.Selected = selected
                Edge.set(c.Edge, "Color", selected and (Colors.metalMid or Colors.Moon) or Colors.WellEdge, 0)
                c.Edge.Thickness = selected and 1.5 or 1
                if type(Library.PaintIconPlate) == "function" then
                    pcall(Library.PaintIconPlate, Library, c.Plate, selected and "active" or "idle", true)
                end
            end
            local dim = d.dim == true and 0.5 or 0
            if c.Name.TextTransparency ~= dim then
                c.Name.TextTransparency, c.Tag.TextTransparency, c.Line.TextTransparency = dim, dim, dim
                local img = c.Tile and c.Tile:FindFirstChild("Img")
                if img then img.ImageTransparency = dim end
                local view = c.Tile and c.Tile:FindFirstChild("View")
                if view then view.ImageTransparency = dim end
            end
            if not c.Card.Visible then c.Card.Visible = true end
        end
        for i = n + 1, #cards do
            if cards[i].Card.Visible then cards[i].Card.Visible = false end
        end
        self.Count = n
        local w = n > 0 and (n * CAT_CARD_W + (n - 1) * CAT_GAP + 4) or 0
        local canvas = UDim2.new(0, w, 0, 0)
        if strip.CanvasSize ~= canvas then strip.CanvasSize = canvas end
    end
    -- scroll so the card at `index` is in view (the hub calls it for the equipped / current one)
    function cat:ShowCard(index)
        index = tonumber(index) or 1
        local x = math.max(0, (index - 1) * (CAT_CARD_W + CAT_GAP) - math.floor((strip.AbsoluteSize.X - CAT_CARD_W) / 2))
        tween(strip, 0.3, Enum.EasingStyle.Quint, { CanvasPosition = Vector2.new(x, 0) })
    end
    table.insert(self._controls, cat)
    return cat
end

