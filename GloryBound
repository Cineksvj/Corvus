-- CombatFx (the server's combat events, gb_CombatController.lua): our arrow's server origin (lag / desync), our hits on mobs,
-- blows on us (playerHit: kind / blocked / parry), blows our dash invuln ate (dodged), enemy arrows in the air (enemyArrow)
local fxSeen = {}
local lastPlayerHit, lastEnemyArrowAt = nil, 0
local incoming = {} -- enemy arrows that pass within 4 st of us: { at = arrival os.clock(), dir, o }
local function fxDump(p)
	local parts = {}
	for k, v in pairs(p) do
		local s
		if typeof(v) == "Vector3" then s = string.format("(%.1f,%.1f,%.1f)", v.X, v.Y, v.Z)
		elseif typeof(v) == "Instance" then s = v.Name
		else s = tostring(v) end
		parts[#parts + 1] = tostring(k) .. "=" .. s
	end
	table.sort(parts)
	return table.concat(parts, " ")
end
local function nearestEnemyTo(pos, maxD)
	local best, bd
	for _, m in ipairs(CS:GetTagged("Enemy")) do
		local r = m:IsA("Model") and rootOf(m)
		if r then
			local d = (r.Position - pos).Magnitude
			if d < maxD and (not bd or d < bd) then best, bd = m, d end
		end
	end
	return best
end
Remotes.CombatFx.OnClientEvent:Connect(function(p)
	if type(p) ~= "table" or not run then return end
	local kind = p.t
	-- the first 3 raw payloads of every kind acted on: field names checked live, not guessed
	if kind == "hit" or kind == "playerHit" or kind == "dodged" or kind == "blocked" or kind == "enemyArrow" then
		local n = fxSeen[kind] or 0
		if n < 3 then fxSeen[kind] = n + 1 print("[GB] fx " .. kind .. ": " .. fxDump(p)) end
	end
	local now = os.clock()
	if kind == "arrow" then
		if p.userId ~= LP.UserId then return end
		local ls = getgenv().GB_LastShot
		if not ls then return end
		lastServer.pos, lastServer.at = p.origin, now
		if now - ls.at > 1.5 then return end
		rttEst = math.clamp(rttEst * 0.8 + (now - ls.at) * 0.2, 0.1, 0.6)
		local err = (p.origin - ls.origin).Magnitude
		ls.err = err
		local sinceHop = ls.hopAt and (ls.at - ls.hopAt) or 99
		if err > 6 then
			waveDesync += 1
			ls.desync = true
			-- an arrow fired within 1.5 s of a server reset leaves from the reset position: that desync is the reset, not the
			-- hop - counting it drove lagEst to its 1.2 s cap (r29: lag 1.20, every hop followed by 1.2 s of silence)
			if ls.at - lastResetAt > 1.5 then lagEst = math.min(0.8, math.max(lagEst, sinceHop + 0.15)) end
		elseif sinceHop < lagEst + 0.3 then -- only an arrow fired soon after a hop says the wait is long enough
			lagEst = math.max(CFG.settle, lagEst - 0.05)
		end
	elseif kind == "hit" then
		-- ours: byUserId = us (nil = the client's own looksLikeMyHit guess; solo, so ours), the victim a mob, not a burn tick
		if typeof(p.pos) ~= "Vector3" or p.category == "Player" then return end
		if p.byUserId ~= nil and p.byUserId ~= LP.UserId then return end
		local m = nearestEnemyTo(p.pos, 14)
		if p.burn then if m then burnAt[m] = now end return end
		if p.blocked then waveFx.shield += 1 end
		if m and now - (hpCredAt[m] or -9) < 0.4 then return end -- the Health drop of this blow already credited it
		-- the oldest pending arrow at the mob that was hit; else the oldest one whose target stood within 12 st (it hit the
		-- mob in front of its target: still a hit)
		local pick
		for i, s in ipairs(pending) do if s.target == m then pick = i break end end
		if not pick then
			for i, s in ipairs(pending) do
				local rt = s.target and s.target.Parent and rootOf(s.target)
				if rt and (rt.Position - p.pos).Magnitude < 12 then pick = i break end
			end
		end
		if pick then
			if m then fxCredAt[m] = now end
			creditHit(pick, now, "fx")
		end
	elseif kind == "dodged" then
		-- DodgeFx: no userId and no bot = the local player
		if (p.userId == nil and p.bot == nil) or p.userId == LP.UserId then stats.dodged = (stats.dodged or 0) + 1 waveFx.dodged += 1 end
	elseif kind == "playerHit" then
		lastPlayerHit = { at = now, kind = p.kind, amount = p.amount, blocked = p.blocked, parry = p.parry }
		if p.blocked then waveFx.blocked += 1 end
		if p.parry then waveFx.parry += 1 end
	elseif kind == "enemyArrow" then
		-- an enemy arrow: origin o, direction d, speed s (62), range r (36). Aimed at where the server has us at release; one
		-- that passes within 4 st of us (or of the spot we just left, if that hop is not on the server before it) is dodged
		lastEnemyArrowAt = now
		local o, d = p.o, p.d
		if typeof(o) ~= "Vector3" or typeof(d) ~= "Vector3" or d.Magnitude < 1e-3 then return end
		local c = LP.Character
		local hrp = c and c:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local dir = d.Unit
		local spd = tonumber(p.s) or 62
		local rng = tonumber(p.r) or 36
		local mv = moves[#moves]
		local pts = { hrp.Position }
		if mv and now - mv.at < lagEst + 0.1 then pts[2] = mv.from end
		for i, q in ipairs(pts) do
			local rel = q - o
			local along = rel:Dot(dir)
			if along > -2 and along < rng + 4 and flat(rel - dir * along).Magnitude < 4 then
				local arrive = now + math.max(0, along) / spd
				if not (i == 2 and mv.at + lagEst < arrive - 0.05) then
					incoming[#incoming + 1] = { at = arrive, dir = dir, o = o }
					break
				end
			end
		end
	end
end)

-- the shot line from p to m must reach m first (the game's arrow is a raycast: corpses, statues, other mobs stop it)
local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude
rp.IgnoreWater = true
local function clearLine(p, m)
	local r = rootOf(m)
	if not r then return false end
	local origin = p + Vector3.new(0, 1.3, 0)
	local to = r.Position - origin
	rp.FilterDescendantsInstances = { LP.Character, workspace.CurrentCamera }
	local hit = workspace:Raycast(origin, to * 1.05, rp)
	return hit ~= nil and hit.Instance:IsDescendantOf(m)
end

-- threat scan: do we have to move right now? EVERY mob is scored and the most urgent one wins: a boss leap, then a blow on
-- its way (windup / arrow / a mob in reach) by its contact time, then a mob closing in by when it is inside its zone.
-- Returns the mob, why, and tc = s until its blow can land (server clock).
-- 00:13-00:24 (17 hits "why close"): the old scan returned the FIRST mob that matched, so a legionary walking in ("close")
-- hid the raider behind it winding up dash_stab at 10-13 st, and that blow was never dodged.
-- hits land on the SERVER body, which trails every hop: a "close" mob is moved away from before it is in its zone.
local leapDodged = setmetatable({}, { __mode = "k" })
local function danger(p, list)
	local serverNow = workspace:GetServerTimeNow()
	local bm, bwhy, btc, brank
	local function offer(m, why, tc, rank)
		if not brank or rank < brank or (rank == brank and tc < btc) then bm, bwhy, btc, brank = m, why, tc, rank end
	end
	for _, m in ipairs(list) do
		local t = threatOf(m)
		local r0 = rootOf(m)
		local d = flat(r0.Position - p).Magnitude
		local st = m:GetAttribute("AIState")
		local v = flat(r0.AssemblyLinearVelocity)
		local toUs = flat(p - r0.Position)
		local closing = toUs.Magnitude > 1 and v:Dot(toUs.Unit) or 0
		local spd = math.max(t.speed, v.Magnitude)
		-- boss mech "leap" (champions / rivals from round 5): MechJump..MechImpact = 1.3 s in the air, lands where we stood
		-- (radius 10 + knock 55). 23:58 r15: champion lion pounce = MechKind leap in Windup/Attack (not Cast). Seen live: a hop
		-- 0.8 s before impact still got landed on: ~0.55 s before. Once per jump (the main loop marks it when it acts)
		if (st == "Cast" or st == "Windup" or st == "Attack") and m:GetAttribute("MechKind") == "leap" then
			local jump, impact = tonumber(m:GetAttribute("MechJump")), tonumber(m:GetAttribute("MechImpact"))
			if jump and impact and serverNow > impact - CFG.leapHopAt and serverNow < impact - 0.2 and leapDodged[m] ~= jump then
				offer(m, "leap", impact - serverNow, 0)
			end
		end
		-- 23:55 r9: armored_boar tusk_charge in Charge 39 -> 21 st, hit at 21 st: a charging mob coming at us is a blow whose
		-- contact is when it covers the gap (the lane hazard in the hop moves us off its line, not just away)
		if st == "Charge" and toUs.Magnitude > 1 and v.Magnitude > 4 and v.Unit:Dot(toUs.Unit) > 0.8 and d < v.Magnitude * 1.5 + 12 then
			offer(m, "windup", math.max(0, d - t.reach) / v.Magnitude, 1)
		end
		if st == "Windup" or st == "Attack" then
			local ak = m:GetAttribute("AttackKind") or ""
			local a, r = t.atk[ak], t.windup[ak]
			local wend = tonumber(m:GetAttribute("WindupEnd"))
			local left = (st == "Attack" or not wend) and 0 or math.max(0, wend - serverNow)
			if r then
				if d < r + CFG.windupPad then
					if t.archer and a and a.kind == "projectile" then
						offer(m, "arrow", left + d / (a.speed > 0 and a.speed or 62), 1)
					else -- lunge / slam / breath: contact = WindupEnd + the lunge's travel to us
						offer(m, "windup", left + ((a and a.speed > 0) and math.max(0, d - 3) / a.speed or 0), 1)
					end
				end
			elseif d < t.reach + CFG.meleePad + 6 then -- a melee swing winding up next to us
				offer(m, "reach", left, 1)
			end
		end
		if d < t.reach + CFG.meleePad then
			-- 23:55 r9: a legionary at 7 st in Chase was "close", the swing came (-8). In the pad zone a Chase mob is "close" only
			-- while a hop still lands before it is in reach (dogs 21-31 st/s cross the pad in 0.1 s: "reach")
			if st == "Chase" and d > t.reach + 1 and (d - t.reach) / math.max(closing, 1) > lagEst + 0.3 then
				offer(m, "close", (d - t.reach) / math.max(closing, 1), 2)
			else
				offer(m, "reach", t.minWindup, 1)
			end
		elseif closing > 3 and d < t.zone + CFG.meleePad + spd * math.max(CFG.predict, lagEst + 0.4) then
			-- "close": only a mob actually coming at us (closing > 3 st/s), sorted by when it is inside its zone
			offer(m, "close", math.max(0, d - t.zone) / closing, 2)
		end
		if t.archer and d < CFG.archerKeep then offer(m, "archer", 1, 2) end
	end
	return bm, bwhy, btc
end

-- hop travel in the last `window` s (the server's anti-teleport window): what is left of the budget caps the next hop
local function travelLast(now, window)
	local t = 0
	for _, mv in ipairs(moves) do if now - mv.at < window then t += flat(mv.to - mv.from).Magnitude end end
	return t
end
local function travelLeft(now) return CFG.travelBudget - travelLast(now, CFG.travelWindow) end
-- free purses this frame (Treasure): every hop considers them, a safe spot on one picks it up on the way
local pursesNow = nil
-- blink spot: the candidate inside the ellipse that maximises the worst (distance - wanted gap) over all mobs,
-- preferring spots that keep the current target inside shot range with a clear line
local function pickSpot(list, target, from, hz, obj, minHop, maxHop, lineW, emergency)
	local c, ea, eb = arenaShape()
	local best, bestScore
	local left = travelLeft(os.clock())
	if emergency then left = math.max(left, minHop or 14, 30) end
	local tp = target and rootOf(target) and rootOf(target).Position
	local cands = {}
	if obj then -- around the objective first
		for _, r in ipairs({ obj.r * 0.5, obj.r }) do
			for i = 0, 11 do
				local a = i / 12 * math.pi * 2
				local p = Vector3.new(obj.pos.X + math.cos(a) * r, CFG.floorY, obj.pos.Z + math.sin(a) * r)
				if inside(p, CFG.edge) then cands[#cands + 1] = p end
			end
		end
	end
	for ring = 1, 3 do -- arena-wide
		local frac = CFG.edge * (ring / 3)
		for i = 0, 23 do
			local a = i / 24 * math.pi * 2
			cands[#cands + 1] = Vector3.new(c.X + math.cos(a) * ea * frac, CFG.floorY, c.Z + math.sin(a) * eb * frac)
		end
	end
	for _, r in ipairs({ CFG.hop * 0.55, CFG.hop, CFG.hop * 1.5 }) do -- short hops around us: the ones the server keeps up with (the 1.5x ring: the way out of a corner)
		for i = 0, 15 do
			local a = i / 16 * math.pi * 2
			local p = Vector3.new(from.X + math.cos(a) * r, CFG.floorY, from.Z + math.sin(a) * r)
			if inside(p, CFG.edge) then cands[#cands + 1] = p end
		end
	end
	if pursesNow then for _, pp in ipairs(pursesNow) do if inside(pp, CFG.edge) then cands[#cands + 1] = pp end end end
	-- the hop is on the server lagEst (0.55-0.8 s) later: every mob is scored from where it will be by then, not where it is
	-- (r39: 6 x spot_in_reach - spots 12-15 st from a legionary / brute that was 11-13 st away and closing)
	local lagAhead, spdOf = {}, {}
	for _, m in ipairs(list) do
		local r = rootOf(m)
		local v = flat(r.AssemblyLinearVelocity)
		lagAhead[m] = r.Position + v * lagEst
		spdOf[m] = math.max(threatOf(m).speed, v.Magnitude, 6) -- late rounds run ~1.5x the def speed
	end
	for _, p in ipairs(cands) do
		local worst = math.huge
		for _, m in ipairs(list) do
			local t = threatOf(m)
			local d = flat(lagAhead[m] - p).Magnitude
			-- score = seconds until the first mob is back in its zone (distance past zone / its speed): the spot that buys the
			-- longest dwell, not the nearest safe one. zone = lunge range for raiders / dogs (00:15-00:24: 6 x spot_in_reach,
			-- spot->mob 5-15 st, the old score counted their 5 st melee reach only)
			local tt = t.archer and (d - CFG.wantGapArcher) / 10 or (d - t.zone - CFG.meleePad) / spdOf[m]
			worst = math.min(worst, tt)
		end
		-- dwell is worth 8 points per second up to 6 s: with hops >= hopGap apart, a spot that buys 2 s more is worth a longer hop
		local s = math.min(worst, 6) * 8
		-- a purse under a safe spot (>= 1 s of dwell) is worth ~3 s of dwell: the hop collects it (pickupRadius 4.5)
		if pursesNow and worst >= 1 then
			for _, pp in ipairs(pursesNow) do if flat(pp - p).Magnitude < 2.5 then s += 25 break end end
		end
		local hopLen = flat(p - from).Magnitude
		-- a single 120 st hop is accepted (<= 0.4 s), but 75-130 st hops every ~0.6 s get RESET by the server to a position from
		-- 1-4 s earlier (r15: 24 resets / 20 s, 0 hits of 27). There is a speed budget over a window; <= 30 st per hop stays under it.
		if hopLen > CFG.hop then s -= (hopLen - CFG.hop) * 0.3 end
		-- stay off the wall: pinned at the edge by a champion we ping-ponged between three 30 st spots with him in the middle
		local ex, ez = (p.X - c.X) / ea, (p.Z - c.Z) / eb
		s += (1 - math.min(1, ex * ex + ez * ez)) * 10
		local hh = hz and hazardAt(p, hz)
		-- outside a due ring's safe disc outranks the travel budget (-3000): 08:33 r50 every kite hop under a spent budget
		-- landed outside it (-80 x 2 with "hop 1.2 s ago (kite2)")
		if hh then s -= hh.ring and 5000 or 1000 end
		if minHop and hopLen < minHop then s -= 1000 end
		if maxHop and hopLen > maxHop then s -= 1000 end
		-- the travel budget caps every hop (two uncapped 60 st emergency hops in 2 s = reset into the pack, r17: 82 dmg);
		-- an emergency keeps at least its minHop, hops stay hopGap apart so the budget is rarely below that
		if hopLen > left then s -= 3000 end
		if obj then
			local d = flat(p - obj.pos).Magnitude
			if d > obj.r then s -= (d - obj.r) * 3 end
			if obj.kind == "eye" and d > obj.r then s -= 2500 end -- never leave the zone for a better dwell
		end
		if tp then
			local dt = flat(tp - p).Magnitude
			if dt > CFG.shotMax then s -= (dt - CFG.shotMax) * 0.5 end
			if dt >= CFG.shotMin and dt <= CFG.shotMax and clearLine(p, target) then s += lineW or 8 end
		end
		if not bestScore or s > bestScore then best, bestScore = p, s end
	end
	return best or Vector3.new(c.X, CFG.floorY, c.Z)
end

-- an arrow in the air at us (direction dir): a short hop square to its line, the side away from everything else
local function sidestepSpot(list, from, dir)
	dir = flat(dir)
	if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) end
	local perp = Vector3.new(-dir.Z, 0, dir.X).Unit * CFG.sidestep
	local best, bestScore
	for _, p in ipairs({ from + perp, from - perp }) do
		p = Vector3.new(p.X, CFG.floorY, p.Z)
		if inside(p, CFG.edge) then
			local worst = math.huge
			for _, m in ipairs(list) do worst = math.min(worst, flat(rootOf(m).Position - p).Magnitude - threatOf(m).zone) end
			if not bestScore or worst > bestScore then best, bestScore = p, worst end
		end
	end
	return best
end

-- boss mechs (Config.BossMech, from round 5, every 12 s while we kite past FarDist 22): the server publishes each one as a
-- Folder tagged "BossMech" with Kind / StartAt / ImpactAt, ObjectValues Boss and Target, and Result once it is over.
--   leap:  lands on `Center` (set 0.55 s before impact, follows us until then), Radius 10 + 0.5/size, knock 55. r30: 4 x 60 dmg.
--   ring:  at ImpactAt everything OUTSIDE `Inner` (13 st of Center) is hit; EchoAt 1.5 s later hits INSIDE EchoInner (7).
--   leash: 5 s to get within `Safe` (14 st) + Radius of the boss, else at ImpactAt a 60 st pull into him + damage
--          (r30 "unknown_source -60" and "stood_in_reach by a brute that was 49 st away 0.5 s earlier").
local mechDone = setmetatable({}, { __mode = "k" })
local function mechList()
	local out = {}
	for _, f in ipairs(CS:GetTagged("BossMech")) do
		if f.Parent and f:GetAttribute("Result") == nil then
			local tv = f:FindFirstChild("Target")
			tv = tv and tv.Value
			if tv == nil or tv == LP or tv == LP.Character then
				local bv = f:FindFirstChild("Boss")
				bv = bv and bv.Value
				local br = bv and (bv:IsA("Model") and rootOf(bv) or bv:IsA("BasePart") and bv) or nil
				out[#out + 1] = { f = f, kind = f:GetAttribute("Kind"), boss = bv, bossPos = br and br.Position,
					startAt = tonumber(f:GetAttribute("StartAt")) or 0, impactAt = tonumber(f:GetAttribute("ImpactAt")) or 0,
					center = f:GetAttribute("Center"), radius = tonumber(f:GetAttribute("Radius")) or 2, inner = tonumber(f:GetAttribute("Inner")) or 13,
					safe = tonumber(f:GetAttribute("Safe")) or 14, echoAt = tonumber(f:GetAttribute("EchoAt")) or 0, echoInner = tonumber(f:GetAttribute("EchoInner")) or 0 }
			end
		end
	end
	return out
end
-- the point on the circle (centre c, radius r) farthest from every mob but the boss, inside the arena
local function ringSpot(c, r, list, boss)
	local best, bestD
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		local p = Vector3.new(c.X + math.cos(a) * r, CFG.floorY, c.Z + math.sin(a) * r)
		if inside(p, CFG.edge) then
			local worst = math.huge
			for _, m in ipairs(list) do
				if m ~= boss then worst = math.min(worst, flat(rootOf(m).Position - p).Magnitude - threatOf(m).zone) end
			end
			if not bestD or worst > bestD then best, bestD = p, worst end
		end
	end
	return best
end
-- returns the spot to hop to right now (and why), or nil; one hop per mech phase
local function mechMove(p, list, target, now)
	local serverNow = workspace:GetServerTimeNow()
	for _, mk in ipairs(mechList()) do
		local st = mechDone[mk.f] or {}
		mechDone[mk.f] = st
		if mk.kind == "leap" and typeof(mk.center) == "Vector3" and serverNow < mk.impactAt + 0.3 and not st.away then
			local keep = mk.radius + 8
			if flat(p - mk.center).Magnitude < keep then
				st.away = true
				if mk.boss then leapDodged[mk.boss] = tonumber(mk.boss:GetAttribute("MechJump")) or true end
				return pickSpot(list, target, p, { { pos = mk.center, r = keep } }, nil, 14, nil, nil, true), "mech_leap"
			end
		elseif mk.kind == "ring" and typeof(mk.center) == "Vector3" then
			local d = flat(p - mk.center).Magnitude
			if serverNow < mk.impactAt then
				-- inside the safe disc before the wave; hop when the hop can still land (lagEst) and once
				if d > mk.inner - 3 and mk.impactAt - serverNow < lagEst + 0.9 and not st.inn then
					st.inn = true
					return ringSpot(mk.center, math.max(4, mk.inner - 5), list, mk.boss) or p, "mech_ring_in"
				end
			elseif mk.echoAt > serverNow and mk.echoInner > 0 and d < mk.echoInner + 3 and not st.out then
				st.out = true
				return pickSpot(list, target, p, { { pos = mk.center, r = mk.echoInner + 4 } }, nil, 14, nil, nil, true), "mech_ring_out"
			end
		elseif mk.kind == "leash" and mk.bossPos and serverNow < mk.impactAt and not st.inn then
			local d = flat(p - mk.bossPos).Magnitude - mk.radius
			if d > mk.safe - 2 and mk.impactAt - serverNow < lagEst + 0.8 then
				st.inn = true
				return ringSpot(mk.bossPos, math.max(6, mk.safe + mk.radius - 4), list, mk.boss) or p, "mech_leash_in"
			end
		end
	end
	return nil
end

