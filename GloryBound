			[ruleV]   = { Position = UDim2.new(0, w - 1, 0, 0) },
			[userCard]   = { Size = UDim2.new(0, w, 1, 0) },
			[footerSlot] = { Size = UDim2.new(1, -w, 1, 0), Position = UDim2.new(0, w, 0, 0) },
		}
		for inst, g in pairs(goals) do
			if instant then
				for k, v in pairs(g) do inst[k] = v end
