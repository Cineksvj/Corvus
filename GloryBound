	return g
end

-- Library:NewTween(instance, time, props, style, dir) -> Tween (played immediately)
function Library:NewTween(instance, t, props, style, dir)
	t = t or 0.2
	-- instant: write the properties now (a 0 s tween still waits a frame, and the headless
	-- preview never plays tweens at all), then play the zero tween for callers holding it
	if t <= 0 then
		for k, v in pairs(props) do pcall(function() instance[k] = v end) end
	end
	local info = TweenInfo.new(
		t,
		style or Enum.EasingStyle.Quint,
		dir or Enum.EasingDirection.Out
	)
	local tw = TweenService:Create(instance, info, props)
	tw:Play()
	return tw
end
Library.Tween = Library.NewTween

-- Bench micro-detail 3: a state is a boxed word, not an icon. 10 px medium in a 1 px hairline
-- box, 2 px radius. kind = "live" (sage) | "changed" (saffron) | "bad" (brick) | nil (slate).
-- Returns the label and a paint(kind) function.
function Library:StateBox(parent, str, kind, height)
	local box = Library:New("TextLabel", {
		Name = "StateBox",
		BackgroundColor3 = Colors.surface,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 0, height or 16),
		Text = tostring(str or ""),
		FontFace = Fonts.InterMed or Fonts.Inter,
		TextSize = rawget(Library, "Touch") == true and 12 or 10,   -- touch: 12 px floor
		TextColor3 = Colors.muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = ((parent and parent.ZIndex) or 1) + 1,
		Parent = parent,
	})
	Library:Round(2).Parent = box
	local st = Library:Stroke(Colors.hairlineStrong, 1, 0)
	st.Parent = box
	Library:Padding(0, 6, 0, 6).Parent = box
	local function paint(k, instant)
		local c = (k == "live" and Colors.good) or (k == "changed" and Colors.needle) or (k == "bad" and Colors.bad) or Colors.muted
		local t = instant and 0 or 0.09
		Library:NewTween(box, t, { TextColor3 = c }, Enum.EasingStyle.Linear)
		Library:NewTween(st, t, { Color = k and c or Colors.hairlineStrong, Transparency = k and 0.35 or 0 }, Enum.EasingStyle.Linear)
	end
	paint(kind, true)
	return box, paint
end

