-- experimental: Perfect parry via Block(true, <attackContactTime>).
-- Config.Parry grades the parry by the gap between enemy contact and the client-supplied block time.
-- If the server trusts the arg, we pin the block time to the enemy's WindupEnd attribute: tier = Perfect = 0 dmg
-- (+ ReflectHitCap 0.0025 of max HP reflected). Only works vs the parryable attacks whitelist below.
-- Config.Parry.FlagPerfectRate 0.9 after FlagMinJudged 30 = the review flag; CFG.parryRate drops the rest.
local PARRYABLE = {
	cerberus = { triple_bite = true },
	minotaur = { bull_rush = true, horn_toss = true, labrys_cleave = true },
	raid_hydra = { hydraLunge = true },
	talos = { bronze_fist = true },
	trial_cacus = { cacus_club = true, cacus_rush = true },
	trial_glaucus = { glaucus_lunge = true, glaucus_sweep = true },
	trial_lycaon = { lycaon_claw = true, lycaon_lunge = true },
	war_lion = { charge = true, maul = true, pounce = true },
}
local parryHandled, parryJudged, parryPerfect = setmetatable({}, { __mode = "k" }), 0, 0
local blockR = Remotes:FindFirstChild("Block")
local function tryParry(m, now)
	if not CFG.perfectParry or not blockR then return end
	if parryHandled[m] then return end
	local id = m:GetAttribute("CreatureId") or m:GetAttribute("CreatureModelId") or m.Name:gsub("_E%d+$", "")
	local kind = m:GetAttribute("AttackKind")
	if not (id and kind and PARRYABLE[id] and PARRYABLE[id][kind]) then return end
	if m:GetAttribute("AIState") ~= "Windup" then return end
	local contact = tonumber(m:GetAttribute("WindupEnd"))
	if not contact then return end
	local srvNow = workspace:GetServerTimeNow()
	if contact <= srvNow or contact > srvNow + 1.5 then return end -- a stale one
	parryHandled[m] = contact
	-- intentionally miss some to keep perfectRate < CFG.parryRate < Config.Parry.FlagPerfectRate 0.9
	local wantRate = math.max(0, math.min(CFG.parryRate, 0.89))
	local curRate = parryJudged > 0 and parryPerfect / parryJudged or 0
	local doPerfect = curRate < wantRate or parryJudged < 4
	task.delay(math.max(0, contact - srvNow - 0.05), function()
		if not m.Parent then return end
		parryJudged += 1
		if doPerfect then
			-- block anchored to contact time: tier = Perfect
			pcall(blockR.FireServer, blockR, true, contact)
			parryPerfect += 1
		else
			-- intentional skip: no Block fired, the attack lands and the register notes it (stays "legit miss")
		end
		task.delay(0.12, function() pcall(blockR.FireServer, blockR, false, nil) end)
	end)
end
getgenv().GB_ParryStats = function() return parryJudged, parryPerfect, parryJudged > 0 and parryPerfect / parryJudged or 0 end

