local dashTimes, lastDashAt = {}, 0 -- dash charges used (os.clock()) and the last dash (declared here: moveTo ends a dash)
local function moveTo(hrp, spot, now)
	local from = hrp.Position
	-- 00:00 r16: a hop in the same tick as a dash kept the 80 st/s dash velocity for 0.2 s AFTER the teleport = 16 st off the
	-- chosen spot, into the next mob (8 x spot_in_reach with spot->mob 5-13 st). The hop ends the dash
	hrp.AssemblyLinearVelocity = Vector3.zero
	lastDashAt = 0
	dwellShots = 0
	waveHops += 1
	-- the draw is KEPT across a hop (23:30 log: hops every ~1.5 s + a 1.6 s draw = no release ever, 35 rounds of "stall"
	-- while the server auto-released the draw at MaxDrawHold into the air). A draw the server dropped on teleport costs one
	-- ignored release; chargeProbe then brings the quick shots back
	-- fly: every hop lifts to flyY, the LinearVelocity holds us there
	if CFG.fly then spot = Vector3.new(spot.X, CFG.floorY + CFG.flyY, spot.Z) end
	hrp.CFrame = CFrame.new(spot) * (hrp.CFrame - hrp.CFrame.Position)
	-- hit register: how far every mob was from the spot at hop time (was the spot already inside someone's reach?)
	local dists = {}
	for _, m in ipairs(curList) do local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart if r then dists[m] = flat(r.Position - spot).Magnitude end end
	-- travel in the last 4 s including this hop, and the hop count: the wave line buckets hops by it, reset or not (budget sizing)
	local len, t4, n4 = flat(spot - from).Magnitude, 0, 0
	for _, mv in ipairs(moves) do if now - mv.at < 4 then t4 += flat(mv.to - mv.from).Magnitude n4 += 1 end end
	moves[#moves + 1] = { at = now, to = spot, from = from, stage = getgenv().GB_Stage, dists = dists, len = len, t4 = t4 + len, n4 = n4 + 1 } -- stage = the branch that hopped
	if #moves > 150 then table.remove(moves, 1) end
end
-- per wave: hops by 4 s travel bucket, "passed/reset" - the server's anti-teleport window, measured instead of guessed
local function hopBuckets(since)
	local b = { { 40, 0, 0 }, { 60, 0, 0 }, { 80, 0, 0 }, { 100, 0, 0 }, { 120, 0, 0 }, { 1e9, 0, 0 } }
	for _, mv in ipairs(moves) do
		if mv.at >= since and mv.t4 then
			for _, k in ipairs(b) do if mv.t4 <= k[1] then k[mv.reset and 3 or 2] += 1 break end end
		end
	end
	local out, lo = {}, 0
	for _, k in ipairs(b) do
		if k[2] + k[3] > 0 then out[#out + 1] = string.format("%s-%s:%d/%d", lo, k[1] < 1e9 and k[1] or "", k[2], k[3]) end
		lo = k[1]
	end
	return table.concat(out, " ")
end
