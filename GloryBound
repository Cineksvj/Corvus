-- experimental: Fly (LinearVelocity counter-gravity). Floats us at CFG.floorY + CFG.flyY so ground mobs path to our
-- X/Z but swing through floor air where we are not. Shots still go: the server builds the arrow from HRP + facing;
-- height stays low enough (12 st) that the shot pitch to a floor mob stays inside Config.Combat.AimPitchClamp 35 deg.
-- Hover (CFrame anchor) was cofa'd to the floor by the server in 2026-11-12 tests; owner's /fly (physics BodyMover)
-- was NOT, which is why we go with LinearVelocity here.
local flyRig, flyChar, flyAtt = nil, nil, nil
local function rigFly(char)
	if flyRig and flyRig.Parent then pcall(game.Destroy, flyRig) end
	if flyAtt and flyAtt.Parent then pcall(game.Destroy, flyAtt) end
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	flyAtt = Instance.new("Attachment"); flyAtt.Name = "GB_FlyAtt"; flyAtt.Parent = hrp
	local lv = Instance.new("LinearVelocity")
	lv.Name = "GB_Fly"
	lv.Attachment0 = flyAtt
	lv.MaxAxesForce = Vector3.new(0, math.huge, 0)
	lv.VectorVelocity = Vector3.new(0, 0, 0) -- holds Y (counter-gravity)
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	lv.ForceLimitsEnabled = true
	lv.Parent = hrp
	-- keep the humanoid off the ground so mobs that look for a floor-touching player stay unsure
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end) end
	flyRig, flyChar = lv, char
end
local function unrigFly()
	if flyRig and flyRig.Parent then pcall(game.Destroy, flyRig) end
	if flyAtt and flyAtt.Parent then pcall(game.Destroy, flyAtt) end
	flyRig, flyAtt, flyChar = nil, nil, nil
end
-- per-frame lift: the server's anti-teleport cofa can drop us to an old floor position between hops,
-- and at 0.1 s polling a melee mob (speed 12-18 st/s) can close + swing before we come back up
local flyHook = RS.Heartbeat:Connect(function()
	if not CFG.fly then
		if flyRig then unrigFly() end
		return
	end
	local c = LP.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	if flyChar ~= c or not flyRig or not flyRig.Parent then rigFly(c) end
	local wantY = CFG.floorY + CFG.flyY
	if hrp.Position.Y < wantY - 0.2 then
		hrp.CFrame = CFrame.new(hrp.Position.X, wantY, hrp.Position.Z) * (hrp.CFrame - hrp.CFrame.Position)
		hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)
	end
end)
-- re-rig on respawn while fly is on
LP.CharacterAdded:Connect(function(c) if CFG.fly then task.wait(0.4); rigFly(c) end end)

