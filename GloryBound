			if typeof(Library.OnTabPrimary) == "function" then
				pcall(Library.OnTabPrimary, self, Flag)
				return
			end
			if typeof(Flag) == "string" then
				local t = Library.Toggles[Flag]
				if typeof(t) == "table" and typeof(t.OnChanged) == "function" then
					t:OnChanged(function(v)
						if typeof(Library.OnTabPrimaryState) == "function" then
							pcall(Library.OnTabPrimaryState, self, v == true)
