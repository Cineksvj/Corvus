-- ---------------------------------------------------------------- chevron
-- Lucide "chevron-down" in an ImageLabel; "v" text until the icon module resolves
-- (U+2304 is missing from BuilderSans and rendered as a tofu box).
-- Bench (bench3 note): the arrow is a tick, not a chevron. A 1 px stem with a stepped 5-3-1 px
-- head, drawn from frames, integer-placed so it never blurs. The holder rotates (open 180,
-- folded -90). Img / Glyph stay as hidden children for callers that look them up by name.
local function makeChevron(parent, size, color, z)
    size = size or 14
    color = color or Colors.Brushed
    local holder = new("Frame", {
        Name = "Chevron",
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(size, size),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Parent = parent,
        ZIndex = z or parent.ZIndex,
    })
    local zi = holder.ZIndex + 1
    -- owner 2026-10-31 evening ("strzalka wyglada okropnie"): a real chevron, two 2 px legs
    -- meeting at the bottom, instead of the stepped tick-arrow
    local leg = math.max(6, math.floor(size * 0.55))
    local function bar(dx, rot)
        return new("Frame", {
            Name = "Tick",
            BackgroundColor3 = color,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, dx, 0.5, 0),
            Size = UDim2.fromOffset(2, leg),
            Rotation = rot,
            ZIndex = zi,
            Parent = holder,
        })
    end
    local off = math.floor(leg * 0.3535)   -- leg/2 * sin45: the legs touch at the apex
    local l = bar(-off, -45); corner(1, l)
    local r = bar(off, 45); corner(1, r)
    local img = new("ImageLabel", {
        Name = "Img",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Image = "",
        ImageColor3 = color,
        ScaleType = Enum.ScaleType.Fit,
        Visible = false,
        Parent = holder,
        ZIndex = zi,
    })
    local glyph = new("TextLabel", {
        Name = "Glyph",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Text = "",
        FontFace = Fonts.Sans,
        TextSize = math.max(9, size - 3),
        TextColor3 = color,
        Visible = false,
        Parent = holder,
        ZIndex = zi,
    })
    return holder, img, glyph
end
