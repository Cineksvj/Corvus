-- ---------------------------------------------------------------- tooltip
-- pass 7: 350 ms hover delay, 0.12 s fade, wraps at 260 px, placed in the ScreenGui's own
-- space (minus its inset) and flipped left / up so it never runs off the screen edge.
local TIP_DELAY, TIP_MAX_W = 0.35, 260
local function attachTooltip(obj, textStr)
    if not textStr or textStr == "" then return end
    local tip, tipStroke, gen, mx, my = nil, nil, 0, 0, 0
    local function build()
        if tip then return end
        tip = new("TextLabel", {
            BackgroundColor3 = Colors.Well,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(0, 0),
            AutomaticSize = Enum.AutomaticSize.XY,
            Text = textStr,
            TextColor3 = Colors.Ink,
            TextTransparency = 1,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            FontFace = Fonts.Sans,
            TextSize = 12,
            Parent = Library.ScreenGui or obj,
            ZIndex = 60,
            Visible = false,
        })
        new("UISizeConstraint", { MaxSize = Vector2.new(TIP_MAX_W, math.huge), Parent = tip })
        padding(tip, 9, 9, 5, 5)
        corner(4, tip)
        tipStroke = stroke(tip, Colors.WellEdge, 1, 1)
    end
    local place
    local function watchSize()
        -- AutomaticSize resolves after the first frame: re-place once the real size lands
        tip:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() if tip.Visible then place() end end)
    end
    function place()
        if not tip then return end
        local gui = tip.Parent
        local off = (gui and gui:IsA("GuiBase2d")) and gui.AbsolutePosition or Vector2.zero
        local view = (gui and gui:IsA("GuiBase2d")) and gui.AbsoluteSize or Vector2.new(1920, 1080)
        local sz = tip.AbsoluteSize
        -- owner 2026-11-01 ("hover tips way too far from the mouse"): GetMouseLocation is in
        -- physical screen pixels (origin at the very top), AbsolutePosition in inset space
        -- (origin under the topbar), so the pointer is moved into inset space first and then
        -- into the gui's own space; with IgnoreGuiInset the two steps cancel out. The old
        -- "mx - off.Y" alone put the tip a topbar (58 px) below the pointer.
        local m = UserInputService:GetMouseLocation()
        local inset = GuiService:GetGuiInset()
        mx, my = m.X - inset.X - off.X, m.Y - inset.Y - off.Y
        local x, y = mx + 12, my + 14
        if view.X > 0 and x + sz.X > view.X - 6 then x = mx - sz.X - 10 end
        if view.Y > 0 and y + sz.Y > view.Y - 6 then y = my - sz.Y - 8 end
        tip.Position = UDim2.fromOffset(math.max(6, x), math.max(6, y))
    end
    local function hide()
        gen += 1
        if tip and tip.Visible then
            local g = gen
            tween(tip, 0.08, nil, { BackgroundTransparency = 1, TextTransparency = 1 })
            if tipStroke then tween(tipStroke, 0.08, nil, { Transparency = 1 }) end
            task.delay(0.09, function() if gen == g and tip then tip.Visible = false end end)
        end
    end
    obj.MouseEnter:Connect(function(x, y)
        mx, my = x, y
        gen += 1
        local g = gen
        task.delay(TIP_DELAY, function()
            if gen ~= g or not obj.Parent then return end
            if not tip then build() watchSize() end
            tip.Visible = true
            place()
            tween(tip, 0.12, nil, { BackgroundTransparency = 0, TextTransparency = 0 })
            if tipStroke then tween(tipStroke, 0.12, nil, { Transparency = 0 }) end
        end)
    end)
    obj.MouseLeave:Connect(hide)
    obj.MouseMoved:Connect(function(x, y)
        mx, my = x, y
        if tip and tip.Visible then place() end
    end)
    -- a press means the pointer is acting, not reading: drop the tip
    if obj:IsA("GuiButton") then obj.MouseButton1Down:Connect(hide) end
end

