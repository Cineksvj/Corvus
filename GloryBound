	local SIDEBAR_FULL, SIDEBAR_MINI = SIDEBAR_W, 56
	sidebar.ClipsDescendants = true   -- tab names must not spill over the content mid-tween
	local function applySidebarWidth(w, instant)
		local goals = {
			[sidebar] = { Size = UDim2.new(0, w, 1, -BOTTOM_H) },
			[content] = { Size = UDim2.new(1, -(w + PAD * 2), 1, -(HEADER_H + TAB_BAR_H + BOTTOM_H + PAD * 2)), Position = UDim2.new(0, w + PAD, 0, HEADER_H + TAB_BAR_H + PAD) },
