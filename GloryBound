-- skills: SkillUpgrade(nodeId) when Defs.Skills.canBuy(save.Skills, id, Level, SkillPoints) says ok; the chosen
-- branch (or every branch) in tier order, the Oath first
local function skillStep(now)
	if not cfg.skills or not N.inLobby or not SkillsDef or now - st.skillAt < 5 then
		return
	end
	local points = num(st.data.SkillPoints)
	if points <= 0 then
		return
	end
	local ranks = type(st.data.Skills) == "table" and st.data.Skills or {}
	local level = num(st.data.Level, 1)
	local list = {}
	for _, node in ipairs(SkillsDef.list or {}) do
		if node.id == SkillsDef.ORIGIN or cfg.skillBranch == "All" or node.branch == cfg.skillBranch then
			table.insert(list, node)
		end
	end
	table.sort(list, function(a, b)
		if a.tier ~= b.tier then
			return a.tier < b.tier
		end
		return (a.order or 0) < (b.order or 0)
	end)
	for _, node in ipairs(list) do
		local ok, can = pcall(SkillsDef.canBuy, ranks, node.id, level, points)
		if ok and can then
			st.skillAt = now
			if N.fire("SkillUpgrade", node.id) then
				st.skillsBought += 1
				log("SKILL", node.id, "rank", num(ranks[node.id]) + 1, "points", points)
			end
			return
		end
	end
	st.skillAt = now
end

-- rebirth: the save flag RebirthReady (Strength at its cap) -> Rebirth, which resets Strength and raises the cap.
-- The game only sends it within MaxActivationDistance + 4 of the shrine prompt (workspace.Lobby.Stations.RebirthShrine)
-- and off the barbell, so: leave the barbell, hop to the shrine, fire, hop back (training restarts itself).
local function shrinePrompt()
	local folder = workspace:FindFirstChild("Lobby")
	folder = folder and folder:FindFirstChild("Stations")
	folder = folder and folder:FindFirstChild("RebirthShrine")
	if not folder then
		return nil
	end
	local best, score = nil, 0
	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local s = d:GetAttribute("Opens") == "Rebirth" and 3 or (d.Name == "OpenPrompt" and 2 or 1)
			if s > score then
				best, score = d, s
			end
		end
	end
	local parent = best and best.Parent
	local pos = parent and (parent:IsA("BasePart") and parent.Position or (parent:IsA("Attachment") and parent.WorldPosition)) or nil
	return best, pos
end
local function rebirthStep(now)
	if not cfg.rebirth or not N.inLobby or st.rebirthBusy or now - st.rebirthAt < 30 then
		return
	end
	if st.data.RebirthReady ~= true then
		return
	end
	local prompt, pos = shrinePrompt()
	local root = hrp()
	if not (prompt and pos and root) then
		st.lastErr, st.lastErrAt = "Rebirth: the shrine prompt was not found", now
		st.rebirthAt = now
		return
	end
	st.rebirthAt = now
	st.rebirthBusy = true
	task.spawn(function()
		local ok, err = pcall(function()
			-- make sure trainStep cannot restart us: block it + drop the attribute first.
			st.trainTryAt = now + 10
			N.fire("TrainStop")
			st.training = false
			st.trainMachine = nil
			-- wait AT LEAST 1.2 s AND until the server drops the Training attribute (up to 3 s).
			-- "Rebirth locked: leave the training machine first" = server still sees us on the barbell.
			task.wait(1.2)
			for _ = 1, 18 do
				if not isTraining() then
					break
				end
				task.wait(0.1)
			end
			local back = root.CFrame
			local reach = math.max(4, num(prompt.MaxActivationDistance, 10)) - 2
			local dir = Vector3.new(back.Position.X - pos.X, 0, back.Position.Z - pos.Z)
			dir = dir.Magnitude > 1 and dir.Unit or Vector3.new(0, 0, 1)
			root.CFrame = CFrame.new(pos + dir * math.min(reach, 5) + Vector3.new(0, 2, 0), pos)
			root.AssemblyLinearVelocity = Vector3.zero
			-- give the server time to accept the new position before Rebirth validates distance.
			task.wait(1.2)
			-- one more TrainStop just before the fire: if the server somehow re-anchored us, drop it again.
			if isTraining() then
				N.fire("TrainStop")
				for _ = 1, 10 do
					if not isTraining() then break end
					task.wait(0.1)
				end
			end
			if N.fire("Rebirth") then
				st.rebirths += 1
				st.strengthAtStart = nil
				log("REBIRTH sent at the shrine", "rebirth", num(st.data.Rebirth), "strength", num(st.data.Strength))
			end
			task.wait(2.5)
			local r2 = hrp()
			if r2 then
				r2.CFrame = back
				r2.AssemblyLinearVelocity = Vector3.zero
			end
			st.trainTryAt = 0
		end)
		if not ok then
			logProblem("rebirth: " .. tostring(err))
		end
		st.rebirthBusy = false
	end)
end
