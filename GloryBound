-- claims: DailyState (calendar, wheel spins, daily/weekly quests, bonus) arrives after DailyAction("sync");
-- DailyAction("claim") = calendar, ("spin") = wheel, ("qclaim", key) = a quest or bonus, ("code", code) = a code.
-- PatchState {canClaim, claimed} -> PatchAction("claim") (the patch notes gift).
N.ClaimFeed = {}
local function claimed(what, key)
	st.claimed += 1
	table.insert(N.ClaimFeed, 1, { at = os.clock(), source = what, key = tostring(key or ""), value = "claimed" })
	if #N.ClaimFeed > 30 then
		table.remove(N.ClaimFeed)
	end
	log("CLAIM", what, key or "")
end
local function spinsOf(s)
	local w = type(s) == "table" and type(s.wheel) == "table" and s.wheel or {}
	return num(w.free) + num(w.edictFree) + num(w.bank) + num(w.paid)
end
N.spinsOf = spinsOf
local function dailyAction(a, b)
	st.dailyActAt = os.clock()
	return N.fire("DailyAction", a, b)
end
local function claimStep(now)
	if not N.inLobby then
		return
	end
	if cfg.claim and now - st.dailyAt > 60 and now - st.dailyActAt > 1.5 then
		st.dailyAt = now
		dailyAction("sync", nil)
		return
	end
	if cfg.claim and cfg.claimPatch and now - st.patchAt > 30 then
		local p = st.patch
		if type(p) == "table" and p.canClaim == true and not p.claimed then
			st.patchAt = now
			if N.fire("PatchAction", "claim") then
				claimed("patch notes", p.uid)
			end
		end
	end
	local s = st.daily
	if not cfg.claim or type(s) ~= "table" or s.lobby == false or now - st.dailyActAt < 1.5 then
		return
	end
	if cfg.claimCal and type(s.cal) == "table" and s.cal.claimable == true then
		s.cal.claimable = false
		if dailyAction("claim", nil) then
			claimed("calendar", s.cal.day or s.cal.streak)
		end
		return
	end
	if cfg.claimSpin and spinsOf(s) > 0 and now - st.spinAt > 12 then
		st.spinAt = now
		if dailyAction("spin", nil) then
			claimed("wheel spin", spinsOf(s))
		end
		return
	end
	if cfg.claimQuests then
		local q = type(s.quests) == "table" and s.quests or {}
		for _, list in ipairs({ q.daily, q.weekly }) do
			if type(list) == "table" then
				for _, quest in ipairs(list) do
					if type(quest) == "table" and quest.canClaim and quest.key then
						quest.canClaim = false
						if dailyAction("qclaim", tostring(quest.key)) then
							claimed("quest", quest.key)
						end
						return
					end
				end
			end
		end
		if type(q.bonus) == "table" then
			for key, b in pairs(q.bonus) do
				if type(b) == "table" and b.ready and not b.claimed then
					b.ready = false
					if dailyAction("qclaim", tostring(b.key or key)) then
						claimed("bonus", b.key or key)
					end
					return
				end
			end
		end
	end
end
do
	local r = remote("DailyState")
	if r then
		Library:GiveSignal(r.OnClientEvent:Connect(function(s)
			if type(s) == "table" then
				st.daily = s
			end
		end))
	end
	r = remote("PatchState")
	if r then
		Library:GiveSignal(r.OnClientEvent:Connect(function(s)
			if type(s) == "table" then
				st.patch = s
			end
		end))
	end
end

-- codes: the pasted list, one every codeEvery s, the server's answer remembered per account in Corvus/GB_codes_<id>.txt
N.Codes = { known = {}, status = {}, feed = {}, rev = 0 }
local CodesFile = "Corvus/GB_codes_" .. tostring(LocalPlayer.UserId) .. ".txt"
pcall(function()
	if type(isfile) == "function" and isfile(CodesFile) then
		for line in string.gmatch(readfile(CodesFile), "[^\r\n]+") do
			local code, status = string.match(line, "^(%S+)%s+(%S+)")
			if code then
				N.Codes.status[string.upper(code)] = status
			end
		end
	end
end)
local function saveCodes()
	pcall(function()
		local lines = {}
		for code, status in pairs(N.Codes.status) do
			table.insert(lines, code .. " " .. status)
		end
		table.sort(lines)
		if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder("Corvus") then
			makefolder("Corvus")
		end
		writefile(CodesFile, table.concat(lines, "\n"))
	end)
end
function N.codesPending()
	for _, code in ipairs(cfg.pastedCodes or {}) do
