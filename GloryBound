-- the brain, one tick every 100 ms (p06): every system is its own step, an error in one lands in the log only
function N.brain()
	local now = os.clock()
	N.inLobby = N.lobbyNow()
	if N.inLobby and not st.wasLobby then
		st.lobbyEnter = now
	end
	st.wasLobby = N.inLobby
	local steps = { trainStep, chestStep, claimStep, codesStep, skillStep, rebirthStep, sellStep, armorStep, weaponStep, skipStep, function(t) if N.reviveStep then N.reviveStep(t) end end }
	for _, step in ipairs(steps) do
		local ok, err = pcall(step, now)
		if not ok then
			local msg = tostring(err)
			if msg ~= st.lastErr then
				logProblem(msg)
			end
			st.lastErr, st.lastErrAt = msg, now
		end
	end
	motionStep()
	if N.inLobby then
		if st.training then
			st.status = string.format("Training on %s: %d reps sent, Strength %s / %s", tostring(st.trainMachine), st.trainReps, N.fmtNum(num(st.data.Strength)), N.fmtNum(num(st.data.StrengthCap)))
		elseif cfg.train and st.trainDone then
			st.status = "Training minutes done, waiting for the arena queue"
		elseif cfg.train then
			st.status = st.status ~= "" and st.status or "Looking for a barbell"
		else
			st.status = "Lobby"
		end
	else
		st.status = "Arena" .. (N.arenaOn and " (farm " .. tostring(getgenv().GB_Stage or "-") .. ")" or "")
	end
end
function N.fmtNum(n)
	n = num(n)
	if math.abs(n) >= 1e9 then
		return string.format("%.2fB", n / 1e9)
	elseif math.abs(n) >= 1e6 then
		return string.format("%.2fM", n / 1e6)
	elseif math.abs(n) >= 1e4 then
		return string.format("%.1fK", n / 1e3)
	end
	return string.format("%d", math.floor(n + 0.5))
end
function N.fmtTime(s)
	s = math.max(0, math.floor(num(s)))
	if s >= 3600 then
		return string.format("%dh %02dm", s // 3600, (s % 3600) // 60)
	end
	return string.format("%dm %02ds", s // 60, s % 60)
end
