		userAvatar.Position = v and UDim2.new(0.5, -9, 0, 0) or UDim2.new(0, 0, 0, 0)
		-- (the group words are gone, critique 2026-11-01; the grooves alone separate the groups)
		local innerW = SIDEBAR_MINI - sidebarPad.PaddingLeft.Offset - sidebarPad.PaddingRight.Offset
		local midPad = math.floor((innerW - 24) / 2)   -- the 24 px icon plate centred in the row
		for _, tab in pairs(self.Tabs) do
			if type(tab) == "table" and tab.Entry then
				if tab.EntryName then tab.EntryName.Visible = not v end
				if tab.EntryPad then
					tab.EntryPad.PaddingLeft = UDim.new(0, v and midPad or 10)
					tab.EntryPad.PaddingRight = UDim.new(0, v and midPad or 8)
				end
				if type(tab._refreshNavPill) == "function" then pcall(tab._refreshNavPill, tab) end
			end
