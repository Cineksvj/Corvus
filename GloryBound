local function signal()
    local sig = { _h = {} }
    function sig:Connect(fn)
        table.insert(self._h, fn)
        return { Disconnect = function()
            for i, f in ipairs(self._h) do
                if f == fn then table.remove(self._h, i); return end
            end
        end }
    end
    function sig:Fire(...)
        for _, fn in ipairs(self._h) do
            task.spawn(fn, ...)
        end
    end
    return sig
end
