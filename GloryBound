    corner(6).Parent = copyBtn
    padding(0, 14, 0, 14).Parent = copyBtn
    metalGradient(copyBtn, 135)
    stroke(Palette.SilverBrushed, 2, 0.8).Parent = copyBtn

    local function copyLink(onDone)
        local link = discordLink()
        local ok = pcall(function()
            if setclipboard then setclipboard(link) end
            if syn and syn.write_clipboard then syn.write_clipboard(link) end
            if toclipboard then toclipboard(link) end
        end)
        if onDone then onDone(ok) end
        if L and type(L.OpenDiscordInvite) == "function" then pcall(L.OpenDiscordInvite, L, link) end
    end
    copyBtn.MouseButton1Click:Connect(function()
        copyLink(function(ok)
            local orig = copyBtn.Text
            copyBtn.Text = ok and "Copied" or "No clipboard"
            task.delay(1.2, function() copyBtn.Text = orig end)
        end)
    end)
    if flat then
        -- the link line itself is the button: hover brightens it, click copies / opens the invite
        -- centred in the bar (owner 2026-10-20): the line sizes to its text, the dot rides 13 px left of it
        copyBtn.Visible = false
        text.AutomaticSize = Enum.AutomaticSize.X
        text.AnchorPoint = Vector2.new(0.5, 0.5)
        text.Position = UDim2.new(0.5, 7, 0.5, 0)
        text.Size = UDim2.new(0, 0, 1, 0)
        text.TextXAlignment = Enum.TextXAlignment.Center
        text.TextSize = 11
        text.TextTruncate = Enum.TextTruncate.None   -- auto-width: AtEnd cut "discord.gg/previ..."
        dot.Size = UDim2.new(0, 6, 0, 6)
        dot.Parent = text
        dot.Position = UDim2.new(0, -13, 0.5, 0)
        local hit = new("TextButton", {
            Name = "LinkHit",
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 5,
            Parent = text,
        })
        hit.MouseEnter:Connect(function() TweenService:Create(text, TweenInfo.new(0.1), { TextColor3 = Palette.SilverMoon }):Play() end)
        hit.MouseLeave:Connect(function() TweenService:Create(text, TweenInfo.new(0.12), { TextColor3 = Palette.SilverInk }):Play() end)
        hit.MouseButton1Click:Connect(function()
            copyLink(function(ok)
                text.Text = ok and "Invite copied" or "No clipboard"
                task.delay(1.2, function() if text.Parent then paint() end end)
            end)
        end)
    end

    local api = {
        Instance = bar,
        SetOnline  = function(_, n) online = n;  paint() end,
        SetMembers = function(_, n) members = n; paint() end,
        SetSession = function(_, n) session = n; paint() end,
    }
    if window then window.Footer = api end
    return api
end

-- =====================================================================
-- CONSTELLATION - per-toggle feature dot
-- =====================================================================
-- 9 fixed CORVUS anchor points (bird silhouette), + a feature dot for
-- each registered toggle at a deterministic position derived from its
-- name hash. When toggle is ON, we draw a thin accent line to the
-- nearest anchor (fade 0.3s). When OFF, line fades.
-- =====================================================================
local Constellation = {}
Widgets.Constellation = Constellation

-- 9 anchor points (percent-space, 0..1) for the CORVUS raven silhouette:
-- beak -> head -> back/wing -> tail -> feet, roughly a bird facing left.
Constellation.Anchors = {
    Vector2.new(0.08, 0.42), -- beak
    Vector2.new(0.18, 0.34), -- head
    Vector2.new(0.26, 0.30), -- top of back
    Vector2.new(0.42, 0.26), -- wing shoulder
    Vector2.new(0.58, 0.30), -- wingtip high
    Vector2.new(0.74, 0.40), -- wingtip low / back-tail
    Vector2.new(0.86, 0.52), -- tail tip
    Vector2.new(0.46, 0.58), -- belly
    Vector2.new(0.30, 0.70), -- feet
}

Constellation.Host = nil  -- Frame that visually hosts the sky; set by Agent A
Constellation.Dots = {}

-- Agent A calls this with its Constellation holder (which already draws the
-- mockup watermark: 7 stars + hairlines). We only add the feature-dot layer.
function Constellation.setHost(hostFrame)
    Constellation.Host = hostFrame
    if hostFrame and not hostFrame:FindFirstChild("CorvusAnchors") then
        new("Frame", {
            Name = "CorvusAnchors",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 1,
            Parent = hostFrame,
        })
    end
end

local function nearestAnchorIndex(fx, fy)
    local best, bestD2 = 1, math.huge
    for i, p in ipairs(Constellation.Anchors) do
        local dx, dy = p.X - fx, p.Y - fy
        local d2 = dx * dx + dy * dy
        if d2 < bestD2 then bestD2 = d2; best = i end
    end
    return best
end

-- Nearest watermark star (host-scale coords); falls back to the raven anchors.
local function nearestStarScale(host, fx, fy)
    local size = host.AbsoluteSize
    local best, bestD2 = nil, math.huge
    local wm = host:FindFirstChild("Watermark")
    if wm and size.X > 0 and size.Y > 0 then
        for _, c in ipairs(wm:GetChildren()) do
            if c.Name:sub(1, 4) == "Star" then
                local p = c.AbsolutePosition - host.AbsolutePosition + c.AbsoluteSize / 2
                local s = Vector2.new(p.X / size.X, p.Y / size.Y)
                local d2 = (s.X - fx) ^ 2 + (s.Y - fy) ^ 2
                if d2 < bestD2 then bestD2 = d2; best = s end
            end
        end
    end
    return best or Constellation.Anchors[nearestAnchorIndex(fx, fy)]
end

-- Draw a thin line between two scale-points using one rotated Frame.
local function makeLine(host, from, to)
    local line = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Palette.SilverBrushed,
        BackgroundTransparency = 0.7,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 0, 1),
        Parent = host,
    })
    -- Rotation pivots on the frame centre: anchor the line at its midpoint.
    local function layout()
        local hostAbs = host.AbsoluteSize
        local ax, ay = from.X * hostAbs.X, from.Y * hostAbs.Y
        local bx, by = to.X   * hostAbs.X, to.Y   * hostAbs.Y
        local dx, dy = bx - ax, by - ay
        local len = math.sqrt(dx * dx + dy * dy)
        local ang = math.deg(math.atan2(dy, dx))
        line.Position = UDim2.fromOffset((ax + bx) / 2, (ay + by) / 2)
        line.Size = UDim2.new(0, len, 0, 1)
        line.Rotation = ang
    end
    layout()
    host:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
    return line
end

function Constellation.register(flagName, _ownerFrame, toggle)
    if not Constellation.Host then
        -- Deferred: try again after a short pause (hub may still be building)
        task.delay(0.5, function()
            if Constellation.Host then
                Constellation.register(flagName, _ownerFrame, toggle)
            end
        end)
        return
    end
    local host = Constellation.Host
    local anchors = host:FindFirstChild("CorvusAnchors")
    if not anchors then return end

    -- Deterministic position from djb2 hash of the flag name, kept in the
    -- watermark band (right 55 % of the content column) so the sky stays one piece.
    local h = djb2(flagName or "")
    local fx = 0.38 + (h % 777) / 777 * 0.52
    local fy = 0.16 + ((math.floor(h / 777)) % 500) / 500 * 0.68

    local dot = new("Frame", {
        Name = "FeatureDot_" .. tostring(flagName),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(fx, fy),
        Size = UDim2.new(0, 2, 0, 2),
        BackgroundColor3 = Palette.SilverSmoke,
        BackgroundTransparency = 0.7,
        BorderSizePixel = 0,
        ZIndex = 1,
        Parent = anchors,
    })
    corner(2).Parent = dot

    local target = nearestStarScale(host, fx, fy)
    local line = nil

    -- Watermark-grade subtlety: the sky is a texture behind the cards, never a diagram.
    local function render(on)
        if on then
            if not line then
                line = makeLine(anchors, Vector2.new(fx, fy), target)
                line.BackgroundTransparency = 1
                tween(line, 0.30, nil, { BackgroundTransparency = 0.92 })
            end
            tween(dot, 0.30, nil, {
                BackgroundColor3 = Palette.SilverBrushed,
                BackgroundTransparency = 0.45,
            })
        else
            tween(dot, 0.30, nil, {
                BackgroundColor3 = Palette.SilverSmoke,
                BackgroundTransparency = 0.7,
            })
            if line then
                local l = line
                line = nil
                tween(l, 0.30, nil, { BackgroundTransparency = 1 })
                task.delay(0.4, function() if l then l:Destroy() end end)
            end
        end
    end

    render(toggle and toggle.Value)
    if toggle and toggle.OnChanged then
        toggle:OnChanged(render)
    end
    table.insert(Constellation.Dots, { flag = flagName, dot = dot, render = render, toggle = toggle })
end

