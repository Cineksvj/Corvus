local function InstallTabShim(Tab)
	if typeof(Tab) ~= "table" or Tab._CorvusShim then return Tab end
	Tab._CorvusShim = true

	if typeof(Tab.SetPrimary) ~= "function" then
		function Tab:SetPrimary(Flag: string?)
			self.PrimaryFlag = Flag
