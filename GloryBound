-- the save replica: StateSync {full=true,data={...}} once, then {patch={...}}; RequestSync asks for the full one
local function onStateSync(p)
	if type(p) ~= "table" then
		return
	end
	if p.full and type(p.data) == "table" then
		st.data = p.data
		st.loaded = true
		st.syncAt = os.clock()
	elseif type(p.patch) == "table" then
		for k, v in pairs(p.patch) do
			if type(k) == "string" then
				st.data[k] = v
			end
		end
	end
end
do
	local r = remote("StateSync")
	if r then
		Library:GiveSignal(r.OnClientEvent:Connect(onStateSync))
	end
	N.fire("RequestSync")
end
function N.save(key, d)
	local v = st.data[key]
	if v == nil then
		return d
	end
	return v
end

