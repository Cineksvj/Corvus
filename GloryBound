-- dash (see CFG.dash): 2 charges tracked here (the server has the truth; a refused dash just does nothing)
local function dashReady(now)
	if not CFG.dash or not Remotes:FindFirstChild("Dash") then return false end
	local used = 0
	for i = #dashTimes, 1, -1 do if now - dashTimes[i] < CFG.dashCd then used += 1 else table.remove(dashTimes, i) end end
	return used < CFG.dashCharges and now - lastDashAt > 0.5
end
-- the remote takes a FACING-relative dir (CombatController u135.fallback: forward = (0,0,-1)); we face the way we want
-- and send forward. The client body is ours to move: the game pushes it with DashPredict (LinearVelocity 80 st/s), we
-- set the velocity directly. 16 st outside the arena -> dash toward the centre instead
local Abil = req("Abilities")
-- phx = the equipped dash ABILITY instead (R, owner 2026-11-13 "R to phoenix, uzywaj do unikow"): Defs.Abilities phoenix_dash
-- kind dash, p.dist 28 st, cooldown 18 s, burns the path; AbilityCast(dir) like tryAbility, ready when AbilityReadyAt has
-- passed. Legit escapes use it only when Q has no charge left
local function tryDash(hrp, dir, now, phx)
	dir = flat(dir)
	if dir.Magnitude < 0.1 then return false end
	dir = dir.Unit
	if phx then
		local id = LP:GetAttribute("AbilityEquipped")
		local def = type(id) == "string" and type(Abil.byId) == "table" and Abil.byId[id] or nil
		local r = Remotes:FindFirstChild("AbilityCast")
		if not def or def.kind ~= "dash" or not r or (tonumber(LP:GetAttribute("AbilityReadyAt")) or 0) > workspace:GetServerTimeNow() or now - lastDashAt < 0.25 then return false end
		local dist = tonumber(def.p and def.p.dist) or 28
		if not inside(hrp.Position + dir * dist, 1) then
			local c = arenaShape()
			dir = flat(c - hrp.Position)
			if dir.Magnitude < 1 then return false end
			dir = dir.Unit
		end
		hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir)
		if not pcall(r.FireServer, r, dir) then return false end
		local att = hrp:FindFirstChild("RootAttachment") or hrp:FindFirstChildOfClass("Attachment")
		if att then
			local lv = Instance.new("LinearVelocity")
			lv.Name = "GBDash"
			lv.Attachment0 = att
			lv.RelativeTo = Enum.ActuatorRelativeTo.World
			lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
			lv.MaxAxesForce = Vector3.new(1e6, 0, 1e6)
			lv.VectorVelocity = dir * (dist / 0.25)
			lv.Parent = hrp
			task.delay(0.25, function() lv:Destroy() end)
		end
		lastDashAt = now
		getgenv().GB_DashLine = "R" .. tostring(debug.info(2, "l"))
		stats.phoenix = (stats.phoenix or 0) + 1
		print(string.format("[GB] phoenix dash (R) %.0f st", dist))
		return true
	end
	if not inside(hrp.Position + dir * 16, 1) then
		local c = arenaShape()
		dir = flat(c - hrp.Position)
		if dir.Magnitude < 1 then return false end
		dir = dir.Unit
	end
	hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir)
	if not pcall(Remotes.Dash.FireServer, Remotes.Dash, Vector3.new(0, 0, -1)) then return false end
	getgenv().GB_DashLine = "Q" .. tostring(debug.info(2, "l"))
	-- owner 2026-11-13 "nie uzywa dashu pod Q": one velocity write was eaten by the Humanoid (legit MoveTo) next frame - the
	-- charge went, the body barely moved. The game's own dash (CombatController pushCharacter "DashPredict") holds a
	-- LinearVelocity for DashDuration; same here: 16 st / 0.2 s, horizontal axes only, the walk is paused meanwhile
	hrp.AssemblyLinearVelocity = dir * 80 + Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
	local att = hrp:FindFirstChild("RootAttachment") or hrp:FindFirstChildOfClass("Attachment")
	local hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
	if hum then hum:Move(dir, false) end
	if att then
		local lv = Instance.new("LinearVelocity")
		lv.Name = "GBDash"
		lv.Attachment0 = att
		lv.RelativeTo = Enum.ActuatorRelativeTo.World
		lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
		lv.MaxAxesForce = Vector3.new(1e6, 0, 1e6)
		lv.VectorVelocity = dir * 80
		lv.Parent = hrp
		task.delay(0.2, function() lv:Destroy() end)
	end
	task.delay(0.2, function() if hrp.Parent then local v = hrp.AssemblyLinearVelocity hrp.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0) end end)
	dashTimes[#dashTimes + 1] = now
	lastDashAt = now
	stats.dashes = (stats.dashes or 0) + 1
	return true
end

-- block (the game's F, CombatController: Block(true, GetServerTimeNow()) on press, Block(false) on release): the last dodge,
-- raised right before a blow we can neither hop nor dash out of, facing the attacker. Config.Combat BlockReduction 0.7 inside
-- BlockCone 110; Config.Parry: raised <= ParryWindow 0.28 s before contact = parry (GoodReduce 0.9), <= PerfectWindow 0.1 =
-- perfect. A block that catches nothing locks blocking WhiffLock 0.7 s. Parry grading is flagged past FlagPerfectRate 0.9
-- after FlagMinJudged 30 judged, so blockMax per match stays under 30
local blockRemote = Remotes:FindFirstChild("Block")
local blockUntil, blockCount = 0, 0
local function tryBlock(hrp, from, now)
	if not CFG.block or not blockRemote or blockCount >= CFG.blockMax or now < blockUntil + 0.9 then return false end
	local dir = flat(from - hrp.Position)
	if dir.Magnitude > 0.1 then hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir.Unit) end
	if not pcall(blockRemote.FireServer, blockRemote, true, workspace:GetServerTimeNow()) then return false end
	blockCount += 1
	blockUntil = now + 0.3
	stats.blocks = (stats.blocks or 0) + 1
	waveFx.blocks += 1
	task.delay(0.3, function() pcall(blockRemote.FireServer, blockRemote, false, nil) end)
	return true
end

-- the dash direction: of 8 headings the 16 st endpoint that buys the most time before the first mob (lagEst ahead) is back
-- in reach, inside the arena, off hazards; the threat itself counts double
local function bestDashDir(list, from, hz, threat)
	local best, bestT
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local p = from + dir * 16
		if inside(p, 0.95) and not (hz and hazardAt(p, hz)) then
			local worst = math.huge
			for _, m in ipairs(list) do
				local t = threatOf(m)
				local r = rootOf(m)
				local v = flat(r.AssemblyLinearVelocity)
				local d = flat(r.Position + v * lagEst - p).Magnitude
				local tt = t.archer and (d - 20) / 10 or (d - t.zone - CFG.meleePad) / math.max(t.speed, v.Magnitude, 6)
				if m == threat then tt -= 0.3 end
				worst = math.min(worst, tt)
			end
			if not bestT or worst > bestT then best, bestT = dir, worst end
		end
	end
	return best or Vector3.new(1, 0, 0)
end

-- ability (see CFG.ability): Defs.Abilities.byId[id] = { kind, p = { range / radius } }; AbilityCast rate limit 3/s
local lastCastAt = 0
local function tryAbility(hrp, target, threat, now)
	if not CFG.ability or now - lastCastAt < 1 then return end
	local id = LP:GetAttribute("AbilityEquipped")
	local def = type(id) == "string" and type(Abil.byId) == "table" and Abil.byId[id] or nil
	if not def or def.kind == "dash" or def.kind == "teleport" or def.kind == "leap" then return end
	if (tonumber(LP:GetAttribute("AbilityReadyAt")) or 0) - workspace:GetServerTimeNow() > 0 then return end
	local m = threat or target
	if not m then return end
	local p = def.p or {}
	local dir = flat(rootOf(m).Position - hrp.Position)
	local d = dir.Magnitude
	if d < 1 then return end
	if def.kind == "circle" then if d > (p.radius or 9) * 0.85 then return end
	elseif def.kind == "rain" or def.kind == "mark" then if d > (p.radius or 40) then return end
	elseif def.kind == "buff" then if not threat then return end
	elseif d > (p.range or 12) then return end
	local r = Remotes:FindFirstChild("AbilityCast")
	if not r then return end
	dir = dir.Unit
	hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir)
	pcall(r.FireServer, r, dir)
	lastCastAt = now
	stats.casts = (stats.casts or 0) + 1
end

local skipUntil = setmetatable({}, { __mode = "k" })
local cur, curHp, curSince = nil, nil, 0
local function track(t, now)
	if t ~= cur then cur, curHp, curSince = t, hpOf(t), now return end
	local h = hpOf(t)
	if h < curHp then curHp, curSince = h, now
	elseif now - curSince > CFG.stuckAfter then skipUntil[t] = now + CFG.skipFor cur = nil end
end

-- every target with a clear line, best first (the shoot step takes the next sure one when the first is held)
-- boss weak window (BigFoe / BossBarsTouch): WeakEnd > server now = gold bar "Hit it now", Exposed = stunned after a wall
-- charge; both = every arrow / swing at that boss first. Warded = crimson bar (the boss shrugs hits off): last. The game's
-- gold square cursor (CombatController AssistMark) is only the aim-assist lock drawn on torsoOf - no headshot multiplier
-- exists (Formulas damage = base x crit chance x weaknesses[weapon class] x armor; no hit-part term)
-- (top-level locals are at the 200 register cap: weakBias lives in the two pickers, the melee one uses the same rule inline)
local function pickTargets(list, p, now)
	local function weakBias(m)
		if m:GetAttribute("Exposed") == true or (tonumber(m:GetAttribute("WeakEnd")) or 0) > workspace:GetServerTimeNow() then return -2e6 end
		if m:GetAttribute("Warded") == true then return 1e5 end
		return 0
	end
	local cands = {}
	for _, m in ipairs(list) do
		if (skipUntil[m] or 0) > now then continue end
		local d = flat(rootOf(m).Position - p).Magnitude
		if d < CFG.shotMin or d > 90 then continue end
		if not clearLine(p, m) then continue end
		local s = (CFG.focus == "lowest" and hpOf(m) * 1000 or 0) + d + (d > CFG.shotMax and 5000 or 0)
		if CFG.archersFirst and threatOf(m).archer then s -= 1e6 end
		if m.Name:find("undead_raider", 1, true) then s -= 5e5 end -- thieves run off with the purses: first
		s += weakBias(m)
		-- fast mobs (dogs 22-27 st/s) outrun every hop the budget allows (85 st / 4 s): they die before the slow ones
		if threatOf(m).speed >= 20 then s -= 3e5 end
		-- a fast mob past sureMaxFast is a "far" hold every frame (r2: 310 held frames): a slower / nearer one shoots now
		if threatOf(m).speed >= 15 and d > CFG.sureMaxFast then s += 4e5 end
		-- a Chase mob that is not moving (spawn walk-in, stuck) is an "accel" hold (r7: 638 held frames): others first
		if m:GetAttribute("AIState") == "Chase" and flat(rootOf(m).AssemblyLinearVelocity).Magnitude < 2 then s += 2e5 end
		cands[#cands + 1] = { m = m, s = s }
	end
	table.sort(cands, function(a, b) return a.s < b.s end)
	local out = {}
	for i, c in ipairs(cands) do out[i] = c.m end
	if #out == 0 then -- nothing clean (all skipped as "stuck", or too close): still shoot the nearest one with a line - a champion
		local best, bd -- alone in the arena was skipped for 6 s at a time and never died (round 10 overtime)
		for _, m in ipairs(list) do
			local d = flat(rootOf(m).Position - p).Magnitude
			if d > 3 and d <= 90 and (not bd or d < bd) and clearLine(p, m) then best, bd = m, d end
		end
		if best then out[1] = best end
	end
	return out
end

local function clampPitch(v)
	local f = flat(v)
	local m = f.Magnitude
	if m < 1e-4 then return nil end
	local lim = math.rad(35)
	local a = math.clamp(math.atan2(v.Y, m), -lim, lim)
	return f / m * math.cos(a) + Vector3.new(0, math.sin(a), 0)
end

-- velocity history per mob (last 0.5 s): "steady course" = the velocity 0.25-0.5 s ago points the same way at the same speed
local velHist = setmetatable({}, { __mode = "k" })
local function trackVel(list, now)
	for _, m in ipairs(list) do
		local h = velHist[m]
		if not h then h = {} velHist[m] = h end
		local r = rootOf(m)
		h[#h + 1] = { at = now, v = flat(r.AssemblyLinearVelocity), pos = r.Position, st = m:GetAttribute("AIState") }
		while #h > 0 and now - h[1].at > 0.6 do table.remove(h, 1) end
	end
end
local function steady(t, vel, now, flight, dist)
	local st = t:GetAttribute("AIState")
	-- Cast (boss leap: in the air, every arrow passed through) and Charge (lion 48 st/s then a 100 deg turn) are never sure
	-- Cast is mech only for the leap (airborne); a murmillo casting its net at 55 st stands still (r22: 3 s stalls, "tstate Cast tvel 0")
	-- 01:05 r5 Champion: a lion standing in Cast before its leap = 1169 held frames, 0.33 shots/s. Standing on the ground (3D
	-- speed < 2) with the jump further away than the arrow's flight + round trip (or already landed) is a still target
	if st == "Cast" and t:GetAttribute("MechKind") == "leap" then
		local rr = rootOf(t)
		local srv = workspace:GetServerTimeNow()
		local j, imp = tonumber(t:GetAttribute("MechJump")), tonumber(t:GetAttribute("MechImpact"))
		local grounded = rr and rr.AssemblyLinearVelocity.Magnitude < 2
		local before = j and j - srv > flight + rttEst + 0.1
		local landed = imp and srv > imp + 0.1
		if grounded and (before or landed) then return true, "still" end
		return false, "mech"
	end
	if st == "Charge" or st == "Spawning" then return false, "mech" end
	-- Attack / Recover are NOT still: a raider's attack is a lunge (0 -> 19 st/s inside the arrow's flight, aimErr 10 st).
	-- 00:05-00:16 the "standing far outside its reach = still" exception gave misses at aimErr 0.0: reverted, every Attack /
	-- Recover holds (the shoot step takes another target meanwhile)
	if st == "Attack" or st == "Recover" then return false, "mech" end
	-- Stunned: the arrow passes through (r27-28: aimErr 0.0, Health unchanged, 6 of 6) - wait for the stun to end
	if st == "Stunned" then return false, "mech" end
	-- our own hit stuns the mob for a moment and the NEXT arrow passes through it (23:55 r7-r8: 7 misses "Chase->Stunned",
	-- aimErr 0.4-0.9, line true, each right after a hit): an arrow that would ARRIVE < stunHold s after our last hit waits
	if now + flight - (lastHitAt[t] or -9) < CFG.stunHold then return false, "stun" end
	-- 23:50 r2-r5: 5 misses "vel 0->18..23, aimErr 6-10 st" = a Chase mob that has not started running yet: not still, about
	-- to accelerate. Still = standing in a non-chase state (Idle / Windup with time left / Taunt)
	if st == "Chase" and vel.Magnitude < 2 then return false, "accel" end
	-- a windup that ends inside the arrow's flight is a lunge (lion: Windup->Attack, aimErr 7.5 st at 42 st): only a windup
	-- with more time left than the flight + round trip is a standing target
	if st == "Windup" then
		-- a lunge / charge windup (dash_stab 24 -> 42 st/s inside the windup, aimErr 2.8) moves: the arrow passes beside it
		local ak = t:GetAttribute("AttackKind") or ""
		local tt = threatOf(t)
		if tt.windup[ak] and not tt.archer then return false, "mech" end
		local wend = tonumber(t:GetAttribute("WindupEnd"))
		if wend and wend - workspace:GetServerTimeNow() < flight + rttEst + 0.1 then return false, "mech" end
		return true, "still"
	end
	if vel.Magnitude < 2 then return true, "still" end
	local h = velHist[t]
	local old
	if h then for _, s in ipairs(h) do if now - s.at >= 0.25 then old = s.v break end end end
	if not old then return false, "nohist" end
	if old.Magnitude < 2 then return false, "accel" end
	local ang = math.deg(math.acos(math.clamp(old.Unit:Dot(vel.Unit), -1, 1)))
	if ang > CFG.sureTurn then return false, "turn" end
	if math.abs(old.Magnitude - vel.Magnitude) > 6 then return false, "speed" end
	return true, "course"
end
local waveHold = { turn = 0, speed = 0, accel = 0, nohist = 0, path = 0, far = 0, forced = 0, mech = 0, pack = 0, warmup = 0, stun = 0 }
-- returns false (and why) when the target is not a sure shot; forced = true shoots anyway
local lastShotAt = 0 -- os.clock() of our last arrow (declared here: shoot() reads it)
-- the real shot cooldown (CombatController fireBufferedQuick): Kits Archer bow_shot duration 0.42 (every 3rd shot inside
-- comboWindow 0.9 is bow_volley, 3 arrows, duration 0.5) x StatSheet.cooldownMult (weapon + skill attackSpeed: bow_apollo
-- 0.72 -> 0.33 s = 3 shots/s; the old fixed 2/s left a third of the rate unused) + CLIENT_SLACK 0.03 (+ 0.03 for jitter)
local cdmVal, cdmAt, cdmMod, comboN, comboAt = 1, -99, nil, 0, -99
local function cooldownMult()
	local now = os.clock()
	if now - cdmAt > 5 then
		cdmAt = now
		pcall(function()
			if not cdmMod and getloadedmodules then
				for _, m in ipairs(getloadedmodules()) do if m.Name == "ClientState" then cdmMod = m break end end
			end
			if not cdmMod then return end
			local cs = require(cdmMod)
			local st = type(cs.get) == "function" and cs.get() or cs
			local v = type(st) == "table" and type(st.StatSheet) == "table" and st.StatSheet.cooldownMult
			if type(v) == "number" and v >= 0.2 and v <= 1.5 then cdmVal = v end
		end)
	end
	return cdmVal
end
local function shotGap(volley) return (volley and 0.5 or 0.42) * cooldownMult() + 0.06 end
local function shoot(hrp, t, forced, now, alt)
	local r = rootOf(t)
	-- aim point: the game's own BowAimAssist (CombatController torsoOf) aims at Torso / UpperTorso, else root + 0.5
	local aimPart = (CFG.aim == "head" and t:FindFirstChild("Head")) or (CFG.aim == "torso" and (t:FindFirstChild("Torso") or t:FindFirstChild("UpperTorso"))) or nil
	if aimPart and not aimPart:IsA("BasePart") then aimPart = nil end
	-- Hydra (t3): only the heads take arrows (everyone else's hits land at y~21, our root-aimed ones on the body = 0 dmg).
	-- HeadMask "s11s1----": slot i alive when its char is "1"; aim at the alive Head<i> nearest to us
	local mask = t:GetAttribute("HeadMask")
	if type(mask) == "string" then
		local bd
		for i = 1, #mask do
			local hp = mask:sub(i, i) == "1" and t:FindFirstChild("Head" .. i, true)
			if hp and hp:IsA("BasePart") then
				local d = (hp.Position - hrp.Position).Magnitude
				if not bd or d < bd then aimPart, bd = hp, d end
			end
		end
	end
	local function aimPoint() return (aimPart and aimPart.Parent and aimPart.Position) or (CFG.aim == "torso" and r.Position + Vector3.new(0, 0.5, 0)) or r.Position end
	local tp = aimPoint()
	local f = flat(tp - hrp.Position)
	if f.Magnitude < 1 then return false, "close" end
	-- owner 23:50: "po teleportacji zawsze pierwszy strzal sie marnuje i trafia w stara pozycje" - the server body is still at
	-- the old spot for ~lagEst after a hop and the arrow leaves from there. Every branch (not just nonStop) holds the shot
	-- until the hop is on the server; forced shots too. moves[] covers every moveTo caller, lastBlink does not
	local mv0 = moves[#moves]
	-- owner 01:20 "po teleporcie 0.5 s przestoju": for most of lagEst the server still has us at the hop's START - the arrow
	-- leaves from there, so aim from there instead of waiting; hold only the switch-over (lagEst - 0.1 .. lagEst + 0.05)
	local base = hrp.Position
	if mv0 and now - mv0.at < lagEst + 0.05 then
		if mv0.from and not mv0.reset and now - mv0.at < lagEst - 0.1 then base = mv0.from
		else waveHold.warmup += 1 return false, "warmup" end
	end
	-- nonStop: the game's own CombatController fires Attack(seq, nil, true) at line 7144 when the auto-engage path
	-- picks a target - server auto-aim inside Config.Combat.AutoAimCone 35 deg, so our aim error / mob turn does not matter.
	-- At fly height the horizontal distance must be past flyShotMin or the server's cone misses the mob too.
	if CFG.charged and not nonStopDirAim then
		if not charging or charging.target ~= t then
			-- draw: face the target (the server builds the arrow origin from our facing at release)
			hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + f.Unit)
			seq += 1
			charging = { seq = seq, at = now, target = t }
			pcall(Remotes.Attack.FireServer, Remotes.Attack, seq, nil, true)
			return false, "draw"
		end
		local hold = now - charging.at
		if hold < CFG.chargeTime then return false, "draw" end
		local origin = hrp.Position + Vector3.new(0, 1.3, 0) + f.Unit
		local vel = flat(r.AssemblyLinearVelocity)
		local aimAt = tp + vel * ((tp - origin).Magnitude / 210 + CFG.lead + rttEst)
		local dir = clampPitch(aimAt - origin)
		if not dir then charging = nil return false, "close" end
		-- at full draw the arrow goes: only a target the arrow would pass through (Cast / Charge / Spawning = "mech")
		-- holds it, and at most 0.6 s more (the 1.6 st pierce radius forgives turns the quick arrow would not).
		-- MaxDrawHold 6 is the server's own cap: past 5 s the release goes wherever we face, so it goes now
		if CFG.sure and hold < CFG.chargeTime + 0.6 then
			local ok, why = steady(t, vel, now, (tp - origin).Magnitude / 210, f.Magnitude)
			if not ok and why == "mech" then waveHold[why] += 1 return false, why end
		end
		if hold > 5 then charging = nil return false, "draw" end
		hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat(dir))
		stats.shots += 1
		dwellShots += 1
		chargedShots += 1
		local flight = (tp - origin).Magnitude / 210
		local ls = { target = t, aimAt = aimAt, origin = origin, dir = dir, at = os.clock(), vel = vel, hp = hpOf(t),
			window = flight + rttEst + 0.5, tpos = tp, dist = flat(tp - origin).Magnitude, state = t:GetAttribute("AIState"), charged = true }
		getgenv().GB_LastShot = ls
		pending[#pending + 1] = ls
		task.delay(flight + rttEst, function()
			if r.Parent then ls.impactPos, ls.impactLine, ls.impactState = r.Position, clearLine(origin - Vector3.new(0, 1.3, 0), t), t:GetAttribute("AIState") end
		end)
		pcall(Remotes.AttackRelease.FireServer, Remotes.AttackRelease, charging.seq, math.min(hold, CFG.chargeTime), dir)
		charging = nil
		if chargedShots >= CFG.chargeProbe and chargedHits == 0 then
			CFG.charged = false
			print(string.format("[GB] charged: %d releases, 0 hits -> quick shots from now on", chargedShots))
		end
		return true
	end
	if CFG.nonStop then
		local minD = CFG.fly and CFG.flyShotMin or 6
		if f.Magnitude < minD then return false, "close" end
		-- owner: "the first shot after every teleport goes nowhere". The server body is still at the OLD spot for ~lagEst s
		-- after a hop and the auto-aim cone starts from there: hold the shot until the hop is on the server
		local mv = moves[#moves]
		if mv and now - mv.at < lagEst then waveHold.warmup += 1 return false, "warmup" end
		hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat(tp - hrp.Position)) -- face the target so server aim-cone covers it
		seq += 1
		stats.shots += 1
		dwellShots += 1
		local ls = { target = t, aimAt = tp, origin = hrp.Position, dir = flat(tp - hrp.Position).Unit, at = os.clock(),
			vel = flat(r.AssemblyLinearVelocity), hp = hpOf(t), window = 1, tpos = tp,
			dist = flat(tp - hrp.Position).Magnitude, state = t:GetAttribute("AIState"), nonStop = true }
		getgenv().GB_LastShot = ls
		pending[#pending + 1] = ls
		nonStopShots += 1
		if not nonStopDirAim and nonStopShots >= CFG.nonStopProbe and nonStopHits == 0 then
			nonStopDirAim = true
			print(string.format("[GB] nonStop: %d nil-aim shots, 0 hits -> facing aim from now on", nonStopShots))
		end
		pcall(Remotes.Attack.FireServer, Remotes.Attack, seq, nonStopDirAim and ls.dir or nil, true)
		return true
	end
	local fb = flat(tp - base)
	if fb.Magnitude < 1 then return false, "close" end
	local origin = base + Vector3.new(0, 1.3, 0) + fb.Unit
	local vel = flat(r.AssemblyLinearVelocity)
	-- r15-r16 misses "Chase->Windup vel 25->0 aimErr 0.9-2.8" / "Windup->Windup vel 12->0": a mob inside its attack range of us
	-- stops to wind up during the flight: Windup = no lead
	local tst = t:GetAttribute("AIState")
	local tth = threatOf(t)
	local flight = (tp - origin).Magnitude / 170
	local sureOk, sureWhy = true, nil
	if CFG.sure then sureOk, sureWhy = steady(t, vel, now, flight, f.Magnitude) end
	-- lead (2026-11-13): the RADIAL part (toward / away from us) follows the chase model - a chasing mob runs at US and stops
	-- at its own reach (00:07 r21: 27 misses "Chase->Chase turn 54-150 deg"); the TANGENTIAL part is a constant-velocity
	-- lead, full on a steady course, half otherwise. The pure chase model aimed every flanking / circling runner along the
	-- line to us (00:16: dogs 21-31 st/s, raiders, archers - aimErr 2-8 st)
	local tl = flight + CFG.lead + rttEst
	local toUs = flat(hrp.Position - tp)
	local u = toUs.Magnitude > 1 and toUs.Unit or Vector3.zero
	local vr = vel:Dot(u)
	local vt = vel - u * vr
	local tanK = (tst == "Windup" and 0) or (sureOk and 1 or 0.5)
	local radial = 0
	if tst ~= "Windup" then
		radial = vr * tl
		if vr > 0 then radial = math.min(radial, math.max(0, toUs.Magnitude - tth.reach - 1)) end
	end
	local leadV = u * radial + vt * (tl * tanK)
	if leadV.Magnitude > CFG.leadMax then leadV = leadV.Unit * CFG.leadMax end
	local aimAt = tp + leadV
	local dir = clampPitch(aimAt - origin)
	if not dir then return false, "close" end
	if CFG.sure then
		local ok, why = sureOk, sureWhy
		-- a forced shot still never goes at a mob in Cast / Charge / Spawning / Attack: those arrows pass through (r10: 4 of 4 misses)
		-- forced shots (sureWait) still never go at: mech / stun (pass through), accel (the mob starts running inside the
		-- flight: 23:53-23:55 "vel 0->24 aimErr 2.5-5.7" x5, all forced), anything past sureMax (a 0.5 st near-miss at 80 st)
		-- owner 01:17 "strzela raz na sekunde": a held arrow is 0 damage for sure, a doubtful one costs only the cooldown -
		-- forced (= no sure target anywhere this cooldown) fires at the best aim we have, whatever the state
		if not ok and not forced then waveHold[why] += 1 return false, why end
		if forced and f.Magnitude > 90 then waveHold.far += 1 return false, "far" end -- arrow range 95
		if not forced then
			-- point blank (2-3 st): the arrow spawns 1 st ahead of us, inside the mob, and the server ray starts inside the hitbox
			-- fast runners (raiders 20 st/s, dogs 22): 16 of 27 misses in r3 Chariot with aimErr ~1 st - only a short flight is sure
			local maxD = vel.Magnitude > 15 and CFG.sureMaxFast or CFG.sureMax
			-- fly: raise the floor to flyShotMin so the shot pitch (atan(flyY / f)) stays inside AimPitchClamp 35 deg
			local minD = CFG.fly and CFG.flyShotMin or 6
			if f.Magnitude > maxD or f.Magnitude < minD then waveHold.far += 1 return false, "far" end
			-- the tangential lead is the guess: how far off it can land (a quarter of the tangential run on a steady course,
			-- half otherwise) must stay inside the arrow radius 1.2 + half a body
			if vt.Magnitude * tl * (sureOk and 0.25 or 0.5) > 2.6 then waveHold.turn += 1 return false, "turn" end
			-- the path to the impact point: nothing (corpse, statue, another mob) between us and where the target will be
			rp.FilterDescendantsInstances = { LP.Character, workspace.CurrentCamera, t }
			if workspace:Raycast(origin, aimAt - origin, rp) then waveHold.path += 1 return false, "path" end
		else
			waveHold.forced += 1
		end
	end
	hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat(dir)) -- facing: the server builds the origin from it
	seq += 1
	stats.shots += 1
	dwellShots += 1
	local ls = { target = t, aimAt = aimAt, origin = origin, dir = dir, at = os.clock(), vel = vel, hp = hpOf(t),
		window = flight + rttEst + 0.5, tpos = tp, dist = flat(tp - origin).Magnitude, state = tst,
		forced = forced, alt = alt, vt = vt.Magnitude, tanK = tanK, elite = t:GetAttribute("Elite") }
	getgenv().GB_LastShot = ls
	pending[#pending + 1] = ls
	-- miss diagnosis: where the target (root, and the aim point in 3D) really was when the arrow should have arrived
	task.delay(flight + rttEst, function()
		if r.Parent then ls.impactPos, ls.impact3, ls.impactLine, ls.impactState = r.Position, aimPoint(), clearLine(origin - Vector3.new(0, 1.3, 0), t), t:GetAttribute("AIState") end
	end)
	pcall(Remotes.Attack.FireServer, Remotes.Attack, seq, dir, false)
	return true
end

-- melee swing: the next combo move when its cooldown is up (duration + recovery) x cooldownMult, the combo index resets
-- after the move's comboWindow. Held right after a hop until the server has us there (the swing hits from the server body)
local meleeNext, meleeI, meleeLast, meleeWin = 0, 0, -99, 0
meleeSwing = function(hrp, t, now)
	if now < meleeNext then return false end
	local mv = meleeMoves()
	if #mv == 0 then return false end
	local i = (now - meleeLast <= meleeWin) and (meleeI % #mv) + 1 or 1
	local m = mv[i]
	local r = rootOf(t)
	if not r then return false end
	local f = flat(r.Position - hrp.Position)
	local mv0 = moves[#moves]
	if mv0 and now - mv0.at < lagEst + 0.05 then waveHold.warmup += 1 return false end
	if f.Magnitude > (tonumber(m.range) or 9) + 0.5 then waveHold.far += 1 return false end
	local dir = f.Magnitude > 0.1 and f.Unit or flat(hrp.CFrame.LookVector).Unit
	hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir)
	seq += 1
	pcall(Remotes.Attack.FireServer, Remotes.Attack, seq, dir)
	local cdm = cooldownMult()
	meleeI, meleeLast = i, now
	meleeWin = (tonumber(m.duration) or 0.8) * cdm + (tonumber(m.comboWindow) or 1)
	meleeNext = now + ((tonumber(m.duration) or 0.8) + (tonumber(m.recovery) or 0)) * cdm + 0.06
	stats.shots += 1
	stats.swings = (stats.swings or 0) + 1
	dwellShots += 1
	return true
end
-- where to stand to swing: 5 st from the target, the side with no other mob in its reach (a winding one = worst), inside
-- the arena and off every hazard, the nearest such spot (short hops keep the anti-teleport budget)
meleeSpot = function(list, target, from, hz)
	local tr = rootOf(target)
	if not tr then return nil end
	local best, bs
	for k = 0, 11 do
		local a = k * math.pi / 6
		local p = tr.Position + Vector3.new(math.cos(a) * 5, 0, math.sin(a) * 5)
		p = Vector3.new(p.X, from.Y, p.Z)
		if inside(p, 1) and not hazardAt(p, hz) then
			local s = flat(p - from).Magnitude
			for _, m in ipairs(list) do
				local r = m ~= target and rootOf(m)
				if r then
					local t = threatOf(m)
					local d = flat(r.Position - p).Magnitude
					local st = m:GetAttribute("AIState")
					if (st == "Windup" or st == "Attack" or st == "Charge") and d < t.zone + CFG.meleePad then s += 1000
					elseif d < t.reach + 2 then s += 300 end
				end
			end
			if not bs or s < bs then best, bs = p, s end
		end
	end
	return best
end
