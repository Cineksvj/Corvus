-- revive (ReviveController dump): a downed player / Bot model carries Downed = true and a ProximityPrompt "ReviveP"
-- (HoldDuration ~2.25 s, Config.Revive.MaxDistance 10.5, CancelOnAction: a shot or dash cancels it). We go next to the
-- nearest one nobody is reviving yet (ReviverUserId 0) when no enemy stands within ReviveSafeRadius 10 of it, hold the
-- prompt, and tell the farm to hold still (getgenv().GB_Reviving) for the hold
local CS = game:GetService("CollectionService")
st.reviveUntil, st.revives = 0, 0
local function downedAllies()
	local out = {}
	local mid = LocalPlayer:GetAttribute("MatchId")
	for _, p in ipairs(Players:GetPlayers()) do
		local ch = p ~= LocalPlayer and p.Character
		if ch and ch:GetAttribute("Downed") == true and ch:GetAttribute("ReviveOffer") ~= true and (type(mid) ~= "string" or mid == "" or p:GetAttribute("MatchId") == mid) then
			table.insert(out, ch)
		end
	end
	for _, b in ipairs(CS:GetTagged("Bot")) do
		if b:IsA("Model") and b:IsDescendantOf(workspace) and (b:GetAttribute("Downed") == true or b:GetAttribute("CombatState") == "Downed") then
			table.insert(out, b)
		end
	end
	return out
end
local function enemyNear(pos, r)
	for _, m in ipairs(CS:GetTagged("Enemy")) do
		local root = m:IsA("Model") and (m.PrimaryPart or m:FindFirstChild("HumanoidRootPart"))
		local h = m:FindFirstChildOfClass("Humanoid")
		local s = m:GetAttribute("AIState")
		-- a charging / winding mob reaches further (boar tusk_charge 2026-11-13 09:44:43: -249 while holding a revive)
		local rr = (s == "Charge" or s == "Windup" or s == "Cast") and r * 2.5 or r
		if root and (not h or h.Health > 0) and s ~= "Dead" and (root.Position - pos).Magnitude < rr then
			return true
		end
	end
	return false
end
-- Glaucus net (TrialFx dump): a netted character carries Netted=<until>; its own HumanoidRootPart.BreakNet prompt frees
-- it, a teammate's HumanoidRootPart.CutNet prompt cuts them out before the harpoon (-144 -> downed) lands.
-- Both win over a revive; the farm stands still while GB_NetHold is ahead (a shot or dash cancels the hold)
st.netUntil = 0
local function netStep(now, char, hrp)
	if now < st.netUntil then
		return true
	end
	local function hold(prompt, what)
		local t = math.max(prompt.HoldDuration, 0.3) + 0.2
		st.netUntil = now + t + 0.2
		getgenv().GB_NetHold = os.clock() + t + 0.1
		log("NET " .. what, string.format("%.2fs", t))
		task.spawn(function()
			pcall(function() prompt:InputHoldBegin() end)
			local t0 = os.clock()
			while os.clock() - t0 < t and prompt.Parent and prompt.Enabled do
				task.wait(0.05)
			end
			pcall(function() prompt:InputHoldEnd() end)
			getgenv().GB_NetHold = 0
		end)
		return true
	end
	if char:GetAttribute("Netted") ~= nil then
		local p = hrp:FindFirstChild("BreakNet")
		if p and p:IsA("ProximityPrompt") then
			p.Enabled = true
			return hold(p, "break free")
		end
		return false
	end
	local best, bestD, bestP
	for _, pl in ipairs(Players:GetPlayers()) do
		local ch = pl ~= LocalPlayer and pl.Character
		local r = ch and ch:GetAttribute("Netted") ~= nil and ch:FindFirstChild("HumanoidRootPart")
		local p = r and r:FindFirstChild("CutNet")
		if p and p:IsA("ProximityPrompt") and p.Enabled then
			local d = (r.Position - hrp.Position).Magnitude
			if d < 60 and (not bestD or d < bestD) then
				best, bestD, bestP = r, d, p
			end
		end
	end
	if not best then
		return false
	end
	if bestD > math.min(bestP.MaxActivationDistance, 10) - 2 then
		local side = (hrp.Position - best.Position) * Vector3.new(1, 0, 1)
		side = side.Magnitude > 0.1 and side.Unit or Vector3.new(1, 0, 0)
		local spot = best.Position + side * 4
		local h = char:FindFirstChildOfClass("Humanoid")
		if cfg.dgTeleport and not cfg.legit then
			hrp.CFrame = CFrame.new(spot, best.Position)
		elseif h then
			h:MoveTo(spot)
		end
		st.netUntil = now + 0.2
		getgenv().GB_NetHold = os.clock() + 0.4
		return true
	end
	return hold(bestP, "cut " .. best.Parent.Name)
end
function N.reviveStep(now)
	if N.inLobby or not (cfg.revive or N.arenaWanted()) then
		return
	end
	do
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp and char:GetAttribute("Downed") ~= true and netStep(now, char, hrp) then
			return
		end
	end
	if not cfg.revive or now < st.reviveUntil then
		return
	end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local h = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not h or h.Health <= 0 or char:GetAttribute("Downed") == true then
		return
	end
	local best, bestD, bestPrompt
	for _, ch in ipairs(downedAllies()) do
		local root = ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart
		local prompt = ch:FindFirstChild("ReviveP", true)
		local taken = (tonumber(ch:GetAttribute("ReviverUserId")) or 0) ~= 0 and tonumber(ch:GetAttribute("ReviverUserId")) ~= LocalPlayer.UserId
		if root and prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled and not taken and not enemyNear(root.Position, 10) and not enemyNear(hrp.Position, 10) then
			local d = (root.Position - hrp.Position).Magnitude
			if not bestD or d < bestD then
				best, bestD, bestPrompt = root, d, prompt
			end
		end
	end
	if not best then
		return
	end
	local reach = math.min(bestPrompt.MaxActivationDistance, 10.5) - 2
	if bestD > reach then
		local side = (hrp.Position - best.Position) * Vector3.new(1, 0, 1)
		side = side.Magnitude > 0.1 and side.Unit or Vector3.new(1, 0, 0)
		local spot = best.Position + side * 4
		if cfg.dgTeleport then -- the farm's own teleports are on anyway: one hop next to them
			hrp.CFrame = CFrame.new(spot, best.Position)
			st.reviveUntil = now + 0.4 -- the server catches up before the hold
		else
			h:MoveTo(spot)
			st.reviveUntil = now + 0.25
		end
		getgenv().GB_Reviving = os.clock() + 0.6
		return
	end
	local hold = math.max(bestPrompt.HoldDuration, 0.5) + 0.25
	st.reviveUntil = now + hold + 0.3
	getgenv().GB_Reviving = os.clock() + hold + 0.2
	st.revives += 1
	log("REVIVE hold", best.Parent and best.Parent.Name or "?", string.format("%.0f st, %.2fs", bestD, hold))
	task.spawn(function()
		pcall(function() bestPrompt:InputHoldBegin() end)
		-- a mob coming at us mid-hold: let go, the farm dodges (it holds still only while GB_Reviving is ahead)
		local t0 = os.clock()
		while os.clock() - t0 < hold do
			task.wait(0.1)
			if enemyNear(hrp.Position, 6) then
				getgenv().GB_Reviving = 0
				st.reviveUntil = os.clock() + 3
				log("REVIVE let go: a mob is coming")
				break
			end
		end
		pcall(function() bestPrompt:InputHoldEnd() end)
	end)
end

-- the Dungeon / Lobby switches map onto the farm's own CFG flags; the farm runs while any of them is on
function N.arenaFlags()
	-- legit mode wins over Auto teleport: no teleport in the match, the farm walks + dashes instead
	return { kit = cfg.farmKit, legit = cfg.legit, autoQueue = cfg.arena, autoShoot = cfg.dgShoot, autoTeleport = cfg.dgTeleport and not cfg.legit, dash = cfg.dgDash, objectives = cfg.dgQuests }
end
function N.arenaWanted()
	return cfg.arena or cfg.dgShoot or cfg.dgTeleport or cfg.dgDash or cfg.dgQuests or cfg.legit
end
function N.arenaSync()
	local flags = N.arenaFlags()
	getgenv().GB_Flags = flags
	local g = getgenv().GB_CFG
	if N.arenaOn and type(g) == "table" then
		for k, v in pairs(flags) do
			g[k] = v
		end
	end
	if N.arenaWanted() then
		return N.arenaStart()
	end
	N.arenaStop()
	return true
end
function N.arenaStop()
	if type(getgenv().GB_Stop) == "function" then
		pcall(getgenv().GB_Stop)
	end
	if N.arenaOn then
		log("ARENA farm off")
	end
	N.arenaOn = false
end
function N.arenaText()
	local gs = ReplicatedStorage:FindFirstChild("GameState")
	local parts = {}
	if gs then
		local round = gs:GetAttribute("Round")
		if round then
			table.insert(parts, "Round " .. tostring(round) .. " " .. tostring(gs:GetAttribute("Challenge") or "") .. " " .. tostring(gs:GetAttribute("RoundPhase") or ""))
		end
	end
	local h = N.hum()
	if h and not N.inLobby then
		table.insert(parts, string.format("HP %d / %d", math.floor(h.Health), math.floor(h.MaxHealth)))
	end
	if N.arenaOn then
		table.insert(parts, "stage " .. tostring(getgenv().GB_Stage or "-"))
		if N.inLobby then
			table.insert(parts, N.lobbyWork() and ("queue waits for lobby work: " .. tostring(N.lobbyWork())) or N.lobbyHold() and ("queue waits for the training minutes (" .. N.fmtTime(cfg.trainMinutes * 60 - (os.clock() - math.max(st.trainStartAt, 1))) .. " left)") or "queues the next solo match")
		end
	end
	return table.concat(parts, "\n")
end

-- toggles carried over a teleport (the arena is another server, getgenv is wiped): written when the teleport starts,
-- read back by the fresh hub within 3 minutes
local CarryFile = "Corvus/GB_carry.txt"
function N.persistCarry()
	pcall(function()
		local on = {}
		for name, toggle in pairs(Toggles) do
			if toggle.Value == true then
				table.insert(on, name)
			end
		end
		if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder("Corvus") then
			makefolder("Corvus")
		end
		writefile(CarryFile, tostring(os.time()) .. "\n" .. table.concat(on, ","))
	end)
end
function N.readCarry()
	local names = {}
	pcall(function()
		if type(isfile) ~= "function" or not isfile(CarryFile) then
			return
		end
		local text = readfile(CarryFile)
		local at, list = string.match(text, "^(%d+)\n(.*)$")
		if not at or os.time() - tonumber(at) > 180 then
			return
		end
		for name in string.gmatch(list, "[^,]+") do
			table.insert(names, name)
		end
		delfile(CarryFile)
	end)
	return names
end
