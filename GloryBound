--                              BUTTON
-- ============================================================================
local Button = {}
Button.__index = Button

local function buildButton(parent, props, order)
    -- Default is Metal pill: hub buttons like "Stop Everything" / "Go Home" / "Copy Discord"
    -- read as action pills and match the mockup. Pass Variant="secondary" / "destructive"
    -- to drop out of the Metal fill.
    -- Default is the quiet outline (mockup only uses the Metal fill for "Copy Discord");
    -- pass Variant="primary" for the Metal pill, "destructive" for red.
    local variant = (props.Variant or "secondary"):lower()
    local destructive = variant == "destructive"
    local primary = variant == "primary"

    -- secondary / destructive = raised graphite (lighter top) so buttons read as buttons,
    -- primary = Metal pill. The gradient lives on a Fill frame UNDER a separate label: a
    -- UIGradient on the TextButton itself would tint the text too (text vanished, 2026-10-19).
    local btn = new("TextButton", {
        Name = "Button_" .. (props.Text or "x"),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = order or 0,
        Parent = parent,
    })
    -- Bench: flat. primary = bone fill + soot text, secondary = well + hairline, destructive =
    -- well + brick hairline + brick text. No gradient, no glow, no ripple: the press has physics.
    local FILL_IDLE  = primary and (Colors.moon or Colors.Moon) or Colors.Well
    local FILL_HOVER = primary and (Colors.metalMid or Colors.Moon) or Colors.WellHover
    local TEXT_IDLE  = primary and (Colors.window or Colors.VoidBase) or (destructive and Colors.Red or (Colors.textMid or Color3.fromRGB(214, 217, 224)))
    local fill = new("Frame", {
        Name = "Fill",
        BackgroundColor3 = FILL_IDLE,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = btn.ZIndex + 1,
        Parent = btn,
    })
    corner(6, fill)   -- owner 2026-10-31 evening: soft 6 px ("too square"), only the window edge stays sharp
    local label = new("TextLabel", {
        Name = "Label",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -8, 1, 0),
        Position = UDim2.new(0, 4, 0, 0),
        Text = props.Text or "Button",
        TextColor3 = TEXT_IDLE,
        FontFace = Fonts.SansMed,
        TextSize = T(13, 14),
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = btn.ZIndex + 3,
        Parent = btn,
    })
    -- A4 hold-to-confirm: props.Hold = seconds. A metal fill grows under the label while the
    -- button is held; releasing early cancels (shake + log), completing fires Func once.
    local holdSec = tonumber(props.Hold)
    local holdFill
    if holdSec and holdSec > 0 then
        -- saffron: the fill is "live" while the button is held
        holdFill = new("Frame", {
            Name = "HoldFill",
            BackgroundColor3 = Colors.needle or Colors.Amber,
            BackgroundTransparency = 0,
            BorderSizePixel = 0,
            Size = UDim2.new(0, 0, 1, 0),
            ZIndex = btn.ZIndex + 2,
            Parent = btn,
        })
        corner(6, holdFill)
    end

    local btnStroke
    if not primary then
        -- (critique 2026-10-31 night: a red ring at rest shouted on every Delete / Reset; the red
        -- text is the signal, the ring turns red only under the pointer)
        btnStroke = stroke(fill, Colors.WellEdge, 1, 0)
    end

    local scale = new("UIScale", { Scale = 1, Parent = btn })

    local b = setmetatable({
        Type = "Button",
        Instance = btn,
        _func = props.Func or function() end,
        _variant = variant,
        _doubleClick = props.DoubleClick,
        _hold = holdSec,
    }, Button)

    if holdFill then
        local holdTween, holding = nil, false
        local function cancelHold(reason)
            if not holding then return end
            holding = false
            if holdTween then holdTween:Cancel(); holdTween = nil end
            tween(holdFill, 0.15, nil, { Size = UDim2.new(0, 0, 1, 0) })
            if reason == "released" then
                -- shake: a quick rotation wobble (positions are layout-owned)
                task.spawn(function()
                    for _, r in ipairs({ -2, 2, -1, 0 }) do
                        btn.Rotation = r
                        task.wait(0.04)
                    end
                    btn.Rotation = 0
                end)
                if type(Library.CorvusLog) == "function" then pcall(Library.CorvusLog, Library, "CLICK hold cancelled " .. tostring(props.Text)) end
            end
        end
        btn.MouseButton1Down:Connect(function()
            if b._disabled or holding then return end
            holding = true
            holdFill.Size = UDim2.new(0, 0, 1, 0)
            label.TextColor3 = Colors.window or Colors.VoidBase
            holdTween = TweenService:Create(holdFill, TweenInfo.new(holdSec, Enum.EasingStyle.Linear), { Size = UDim2.new(1, 0, 1, 0) })
            local myTween = holdTween
            holdTween:Play()
            myTween.Completed:Once(function(state)
                if state ~= Enum.PlaybackState.Completed or not holding then return end
                holding = false
                holdTween = nil
                if type(Library.CorvusLog) == "function" then pcall(Library.CorvusLog, Library, "CLICK hold confirmed " .. tostring(props.Text)) end
                task.spawn(b._func)
                task.delay(0.25, function()
                    tween(holdFill, 0.2, nil, { Size = UDim2.new(0, 0, 1, 0) })
                    label.TextColor3 = TEXT_IDLE
                end)
            end)
        end)
        local function release()
            if holding then
                cancelHold("released")
                label.TextColor3 = TEXT_IDLE
            end
        end
        btn.MouseButton1Up:Connect(release)
        btn.MouseLeave:Connect(release)
        b.HoldFill = holdFill
    end

    local lastClick = 0
    btn.MouseButton1Click:Connect(function()
        if b._hold then return end   -- hold buttons fire from the hold timer only
        pcall(rawget(Library, "PlaySound"), Library, "click")
        if b._doubleClick then
            local now = tick()
            if now - lastClick < 0.4 then
                lastClick = 0
                task.spawn(b._func)
            else
                lastClick = now
                local orig = label.Text
                label.Text = "Click again..."
                task.delay(0.4, function()
                    if label.Text == "Click again..." then label.Text = orig end
                end)
            end
        else
            task.spawn(b._func)
        end
    end)

    -- press physics: in fast (70 ms to 0.97), settle with mass (180 ms Back-out)
    btn.MouseButton1Down:Connect(function()
        tween(scale, 0.07, nil, { Scale = 0.97 })
    end)
    btn.MouseButton1Up:Connect(function()
        tween(scale, 0.18, Enum.EasingStyle.Back, { Scale = 1 })
    end)

    connectHover(btn,
        function()
            if not b._flashing then tween(fill, 0.09, Enum.EasingStyle.Linear, { BackgroundColor3 = FILL_HOVER }) end
            if btnStroke then
                tween(btnStroke, 0.09, Enum.EasingStyle.Linear, {
                    Color = destructive and Colors.Red or (Colors.hairlineStrong or Colors.Outline),
                    Transparency = 0,
                })
            end
        end,
        function()
            if not b._flashing then tween(fill, 0.12, nil, { BackgroundColor3 = FILL_IDLE }) end
            if btnStroke then
                tween(btnStroke, 0.12, nil, {
                    Color = Colors.WellEdge,
                    Transparency = 0,
                })
            end
            tween(scale, 0.12, nil, { Scale = 1 })
        end
    )

    attachTooltip(btn, props.Tooltip)

    b.Label = label
    b.Fill = fill
    function b:SetText(s)
        if self._flashing then self._restText = s or "" else label.Text = s or "" end
    end
    -- b:Flash(text, kind, secs): a moment of confirmation on the button itself (owner 2026-11-01,
    -- Copy Discord invite: "a green button for a sec that says copied") - the fill turns the
    -- state colour ("good" green, "bad" red), the label says what happened in soot, then both
    -- come back. A second flash restarts the clock; SetText during a flash lands afterwards.
    local flashGen = 0
    function b:Flash(text, kind, secs)
        flashGen += 1
        local my = flashGen
        if not self._flashing then self._restText = label.Text end
        self._flashing = true
        local col = (kind == "bad" and (Colors.bad or Colors.Red)) or Colors.good or Colors.green or Color3.fromRGB(74, 222, 128)
        tween(fill, 0.09, Enum.EasingStyle.Linear, { BackgroundColor3 = col })
        label.Text = text or label.Text
        label.TextColor3 = Colors.window or Colors.VoidBase
        if btnStroke then btnStroke.Transparency = 1 end
        task.delay(tonumber(secs) or 1.2, function()
            if flashGen ~= my or not btn.Parent then return end
            self._flashing = false
            label.Text = self._restText or label.Text
            self._restText = nil
            label.TextColor3 = TEXT_IDLE
            if btnStroke then btnStroke.Transparency = 0 end
            tween(fill, 0.12, nil, { BackgroundColor3 = FILL_IDLE })
        end)
    end
    function b:SetFunc(fn) self._func = fn or function() end end
    function b:SetDisabled(v)
        self._disabled = v and true or false
        label.TextTransparency = v and 0.5 or 0
        fill.BackgroundTransparency = v and 0.4 or 0
    end

    return b
end

function Groupbox:AddButton(props)
    props = props or {}
    -- 36 px row = 28 px button + 8 px air, so stacked buttons never touch (touch: 40 px button)
    local row = makeRow(self, T(36, 48), "ButtonRow")
    padding(row, 0, 0, 4, 4)
    local layout = new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 8),
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = row,
    })

    local btn = buildButton(row, props, 1)
    btn.Instance.Size = UDim2.new(1, 0, 1, 0)

    function btn:AddButton(subProps)
        self.Instance.Size = UDim2.new(0.5, -4, 1, 0)
        local sub = buildButton(row, subProps, 2)
        sub.Instance.Size = UDim2.new(0.5, -4, 1, 0)
        return sub
    end

    table.insert(self._controls, btn)
    return btn
end

-- ============================================================================
--                              LABEL
-- ============================================================================
local Label = {}
Label.__index = Label

-- Label text scanner (owner 2026-10-20 "inteligentny skaner tekstu"): the facts a player hunts
-- for in a status line - amounts, levels, multipliers ("$20Qa", "8", "x128", "+$1.08Qa/h") -
-- get the bright ink + bold weight; the prose around them stays mid grey. Rich-text tags are
-- passed through untouched (digits inside color="#..." are never wrapped).
local SCAN_OPEN = '<font color="#F2F3F5"><b>'
local SCAN_CLOSE = "</b></font>"
local function scanSegment(seg)
    return (seg:gsub("%f[%w%$%+%-]([%+%-]?%$?x?%d[%d%.,]*%a?%a?)", function(tok)
        -- a lone "-" / trailing punctuation never gets wrapped on its own
        local core, tail = tok:match("^(.-)([%.,]*)$")
        if not core:find("%d") then return tok end
        return SCAN_OPEN .. core .. SCAN_CLOSE .. tail
    end))
end
local function scanText(s)
    if s == "" or not s:find("%d") then return s end
    local out, i = {}, 1
    while i <= #s do
        local a, b = s:find("<[^>]*>", i)
        if not a then table.insert(out, scanSegment(s:sub(i))) break end
        if a > i then table.insert(out, scanSegment(s:sub(i, a - 1))) end
        table.insert(out, s:sub(a, b))
        i = b + 1
    end
    return table.concat(out)
end

function Groupbox:AddLabel(props)
    props = props or {}
    local hero = props.Hero == true
    local mono = props.Mono == true
    local wrap = props.DoesWrap == true
    local scan = not hero and props.Scan ~= false
    local function paintText(s) return scan and scanText(s) or s end

    -- a wrapped row starts at one line (18) and grows; 36 left an empty half row under every
    -- one-line status (owner 2026-10-31 evening, the Extras card)
    local height = hero and 40 or (wrap and 18 or 22)
    local row = makeRow(self, height, "Label")
    if wrap then row.AutomaticSize = Enum.AutomaticSize.Y end

    local lbl = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, wrap and 0 or 1, wrap and 18 or 0),
        Text = paintText(tostring(props.Text or "")),
        TextColor3 = TEXT_MID,
        FontFace = hero and Fonts.Display or (mono and Fonts.Mono or Fonts.Sans),
        TextSize = hero and 30 or (mono and 12 or 13),
        TextXAlignment = hero and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = wrap,
        RichText = true,
        AutomaticSize = wrap and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
        Parent = row,
    })
    if hero then
        -- Metal gradient text fill: UIGradient on TextLabel colors text
        applyGradient(lbl, Gradients.Metal135, 135)
    end

    local l = setmetatable({
        Type = "Label",
        Instance = lbl,
        Row = row,
        _raw = tostring(props.Text or ""),
    }, Label)

    -- Placeholder rows ("-" / empty) stay collapsed until they get real text.
    local function placeholder(s)
        s = tostring(s or "")
        return s == "" or s == "-" or s == "\226\128\148"
    end
    function l:SetText(s)
        s = tostring(s or "")
        -- Hubs repaint status labels every few frames; only a real change may touch the
        -- tree (every Text write re-runs AutomaticSize up the whole column).
        if self._raw == s then return end
        self._raw = s
        self.Instance.Text = paintText(s)
        local vis = not placeholder(s)
        if self.Row.Visible ~= vis then self.Row.Visible = vis end
    end
    function l:Set(s) self:SetText(s) end
    row.Visible = not placeholder(props.Text)

    table.insert(self._controls, l)
    return l
end

