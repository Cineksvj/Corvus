				edge.Parent = row
				-- the gamepad glyph is the fallback; the game's picture sits on its own layer above it
				-- and takes over once it has loaded (owner 2026-11-02 "miniaturki gier, nie ikona pada";
				-- the old single ImageLabel lost the picture to the lucide flush)
				local icon = Library:New("ImageLabel", {
					Name = "Icon",
					BackgroundColor3 = Colors.window,
					BorderSizePixel = 0,
					Position = UDim2.new(0, 6, 0, 6),
					Size = UDim2.new(0, 44, 0, 44),
					Image = "",
					ImageColor3 = Colors.glyph,
					ScaleType = Enum.ScaleType.Fit,
					ZIndex = row.ZIndex + 1,
					Parent = row,
				})
				Library:New("UICorner", { CornerRadius = UDim.new(0, 8), Parent = icon })
				Library:New("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = icon })
				local pic = Library:New("ImageLabel", {
					Name = "Picture",
					BackgroundColor3 = Colors.window,
					BorderSizePixel = 0,
					Position = UDim2.new(0, 6, 0, 6),
					Size = UDim2.new(0, 44, 0, 44),
					Image = "",
					ScaleType = Enum.ScaleType.Crop,
					-- rendered from the start over the glyph, with no background: the engine only
					-- fetches (and flips IsLoaded for) an ImageLabel it draws, so a hidden or fully
					-- transparent one kept the gamepad glyph for ever (live 2026-11-02 on the alt,
					-- PreloadAsync did not help). Unloaded, it draws nothing and the glyph shows through.
					BackgroundTransparency = 1,
					Visible = true,
					ZIndex = row.ZIndex + 2,
					Parent = row,
