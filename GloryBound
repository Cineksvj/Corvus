-- per creature: how close it can hurt us standing still (melee + slam), and its windup attacks (lunge/charge/breath/projectile)
-- atk[id] = { kind, windup, speed, dist }: a blow's contact time is WindupEnd + its travel (lunge 42-46 st/s, bone arrow 62).
-- lunge = the farthest a lunge reaches from where it starts, zone = max(reach, lunge): how close a mob may get before a blow
-- can start at us (00:13-00:24: 14 x raider dash_stab / dog lunge_bite from 9-13 st, the old reach 5 called that "close")
local threatCache = {}
local function threatOf(m)
	local id = m:GetAttribute("CreatureId") or m:GetAttribute("CreatureModelId") or m.Name:gsub("_E%d+$", "")
	local scale = m:GetAttribute("Champion") == true and 1.5 or 1
	local key = id .. "|" .. scale
	if threatCache[key] then return threatCache[key] end
	local def = Creatures.byId and Creatures.byId[id]
	local t = { reach = 9 * scale, archer = false, windup = {}, speed = 12, lunge = 0, atk = {}, minWindup = 0.3 }
	if type(def) == "table" then t.speed = tonumber(def.runSpeed) or tonumber(def.walkSpeed) or 12 end
	if type(def) == "table" and type(def.attacks) == "table" then
		t.reach = 0
		local mw
		for _, a in ipairs(def.attacks) do
			local r = (tonumber(a.range) or 0) + (tonumber(a.radius) or 0)
			-- "slam" (range 8 + radius 9 on a brute, x1.5 for a champion = 25 st) is a windup attack like a lunge: counting it
			-- as standing reach made a champion brute a threat at 30 st, hop every 0.4 s, 0 hits for a minute
			if a.kind == "melee" then
				t.reach = math.max(t.reach, r * scale)
			elseif a.kind == "projectile" then
				t.archer = true
				t.windup[a.id] = r * scale
			else -- lunge / charge / breath: only dangerous while winding up at us
				t.windup[a.id] = r * scale
				if a.kind == "lunge" then t.lunge = math.max(t.lunge, math.max(r, (tonumber(a.distance) or 0) + 2) * scale) end
			end
			local w = tonumber(a.windup) or 0.5
			if a.id then t.atk[a.id] = { kind = a.kind, windup = w, speed = tonumber(a.speed) or 0, dist = (tonumber(a.distance) or 0) * scale } end
			mw = math.min(mw or w, w)
		end
		if mw then t.minWindup = mw end
		if t.reach == 0 then t.reach = (tonumber(def.attackRange) or 6) * scale end
	end
	t.zone = math.max(t.reach, t.lunge)
	threatCache[key] = t
	return t
end

local function arenaShape()
	local a = workspace:FindFirstChild("Arena")
	local c = a and a:GetAttribute("Center")
	local ea, eb = a and a:GetAttribute("EllipseA"), a and a:GetAttribute("EllipseB")
	return typeof(c) == "Vector3" and c or Vector3.new(0, 0, -1400), tonumber(ea) or 95, tonumber(eb) or 70
end
local function inside(p, frac)
	local c, ea, eb = arenaShape()
	local x, z = (p.X - c.X) / (ea * frac), (p.Z - c.Z) / (eb * frac)
	return x * x + z * z <= 1
end

