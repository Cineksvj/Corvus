-- the lit edge (owner 2026-11-01 "add outlines for slider and textbox and dropdowns too"): the
-- sidebar plate's own edge - a 1 px silver stroke under a top-lit gradient - round a control's
-- well. edgeState paints its three states: rest (the lit silver), hover (the ink, a step
-- brighter under the same light) and active (the light off, the needle silver whole: the focus
-- ring, the open pill, the held slider, the listening chip).
Edge.REST = Color3.fromHex("#BFC4CC")
Edge.LIT = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromHex("#5C6473")), ColorSequenceKeypoint.new(1, Color3.fromHex("#20242B")) })
function Edge.lit(parent, transparency)
    local e = stroke(parent, Edge.REST, 1, transparency or 0)
    new("UIGradient", { Name = "Lit", Rotation = 90, Color = Edge.LIT, Parent = e })
    return e
end
function Edge.state(e, state, dur)
    local lit = e:FindFirstChild("Lit")
    if state == "active" then
        if lit then lit.Enabled = false end
        Edge.set(e, "Color", Colors.needle or Colors.Brushed, dur or 0.14)
    else
        if lit then lit.Enabled = true end
        Edge.set(e, "Color", state == "hover" and (Colors.text or Colors.Ink) or Edge.REST, dur or 0.12)
    end
end
function Edge.error(e)
    local lit = e:FindFirstChild("Lit")
    if lit then lit.Enabled = false end
