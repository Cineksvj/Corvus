function Groupbox:AddColorPicker(idx, props)
    props = props or {}
    local row = makeRow(self, T(24, 36), "ColorPicker_" .. tostring(idx or props.Title or "x"))

    text({
        Name = "Label",
        Text = props.Title or "Color",
        TextSize = T(13, 14),
        FontFace = Fonts.Sans,
        TextColor3 = TEXT_MID,  -- one label style for every control (de-AI pass 3)
        Size = UDim2.new(1, -32, 1, 0),
        Parent = row,
    })

    local swatch = new("TextButton", {
        Name = "Swatch",
        BackgroundColor3 = props.Default or Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(T(24, 40), T(18, 28)),
        Text = "",
        AutoButtonColor = false,
        Parent = row,
    })
    corner(4, swatch)
    stroke(swatch, Colors.WellEdge, 1, 0)

    local cp = setmetatable({
        Type = "ColorPicker",
        Idx = idx,
        Value = props.Default or Color3.new(1, 1, 1),
        Transparency = props.Transparency or 0,
        Row = row,
        Swatch = swatch,
        Changed = signal(),
        _callback = props.Callback or function() end,
        _open = false,
        _popup = nil,
    }, ColorPicker)

    function cp:_refresh()
        self.Swatch.BackgroundColor3 = self.Value
    end

    function cp:SetValue(v, silent)
        local old = self.Value
        if typeof(v) == "Color3" then self.Value = v end
        self:_refresh()
        if not silent then
            task.spawn(self._callback, self.Value)
            self.Changed:Fire(self.Value)
            if Library.OnOptionChanged then Library.OnOptionChanged(self) end
            -- undo/redo: one entry per real change (same colour twice is not a change)
            if old ~= self.Value and type(rawget(Library, "_pushHistory")) == "function" then Library._pushHistory(self, old, self.Value) end
        end
    end

    function cp:_buildPopup()
        local gui = Library.ScreenGui or (LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui"))
        if not gui then return end
        local pos = swatch.AbsolutePosition
        local size = swatch.AbsoluteSize
        local guiPos = gui.AbsolutePosition
        local popup = new("Frame", {
            BackgroundColor3 = Colors.Slate,
            BackgroundTransparency = 0,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(180, 160),
            Position = UDim2.fromOffset(pos.X - guiPos.X - 160, pos.Y - guiPos.Y + size.Y + 4),
            Parent = gui,
            ZIndex = 60,
        })
        if type(Library.CardSkin) == "function" then
            Library.CardSkin(popup, 8)
            popup.BackgroundTransparency = 0
        else
            corner(8, popup)
            stroke(popup, Colors.Outline, 1, 0)
        end
        padding(popup, 10, 10, 10, 10)

        local grid = new("UIGridLayout", {
            CellSize = UDim2.fromOffset(22, 22),
            CellPadding = UDim2.fromOffset(4, 4),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = popup,
        })
        grid.FillDirectionMaxCells = 6

        for i, hex in ipairs(COLOR_GRID) do
            local c = Color3.fromHex(hex)
            local sw = new("TextButton", {
                BackgroundColor3 = c,
                BorderSizePixel = 0,
                LayoutOrder = i,
                Text = "",
                AutoButtonColor = false,
                Parent = popup,
                ZIndex = 61,
            })
            corner(4, sw)
            if c:FuzzyEq(cp.Value) then
                stroke(sw, Colors.Moon, 2, 0)
            else
                stroke(sw, Colors.Outline, 1, 0.4)
            end
            sw.MouseButton1Click:Connect(function()
                cp:SetValue(c)
                cp:Close()
            end)
        end

        self._popup = popup

        task.defer(function()
            local conn
            conn = UserInputService.InputBegan:Connect(function(input)
                if not self._open or not self._popup then conn:Disconnect(); return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local inset = game:GetService("GuiService"):GetGuiInset()   -- same frame as AbsolutePosition
                    local mx, my = input.Position.X + inset.X, input.Position.Y + inset.Y
                    local pp = popup.AbsolutePosition
                    local ps = popup.AbsoluteSize
                    local sw = swatch.AbsolutePosition
                    local ss = swatch.AbsoluteSize
                    local inPop = mx >= pp.X and mx <= pp.X + ps.X and my >= pp.Y and my <= pp.Y + ps.Y
                    local inSw = mx >= sw.X and mx <= sw.X + ss.X and my >= sw.Y and my <= sw.Y + ss.Y
                    if not inPop and not inSw then
                        self:Close()
                        conn:Disconnect()
                    end
                end
            end)
        end)
    end

    function cp:Open()
        if self._open then return end
        self._open = true
        self:_buildPopup()
    end

    function cp:Close()
        if not self._open then return end
        self._open = false
        if self._popup then
            local p = self._popup
            self._popup = nil
            p:Destroy()
        end
    end

    swatch.MouseButton1Click:Connect(function()
        if cp._open then cp:Close() else cp:Open() end
    end)

    cp:_refresh()

    if idx then Library.Options[idx] = cp end
    table.insert(self._controls, cp)
    return cp
end

