local function lobby(now)
	if not CFG.autoQueue then return end
	if CFG.kit and LP:GetAttribute("Kit") ~= CFG.kit then
		kitSince = nil
		if now - lastKit > 5 then
			lastKit = now
			pcall(Remotes.KitSelect.FireServer, Remotes.KitSelect, CFG.kit)
			print("[GB] kit ->", CFG.kit)
		end
		return -- never queue on the wrong kit: the match keeps the kit it was queued with
	end
	kitSince = kitSince or now
	if now - kitSince < 2 then return end
	-- the hub (gb_hub.lua) holds the queue while its lobby work runs (training minutes, chests, claims)
	local hold = getgenv().GB_LobbyHold
	if type(hold) == "function" and hold() then lastQueue = now - 13 return end
	if CFG.queue and now - lastQueue > 15 and LP:GetAttribute("Sparring") ~= true then
		lastQueue = now
		if CFG.solo then
			pcall(Remotes.QueueJoin.FireServer, Remotes.QueueJoin, CFG.queue, "solo")
		else
			pcall(Remotes.QueueJoin.FireServer, Remotes.QueueJoin, CFG.queue)
		end
	end
end

-- match over (won, lost, eliminated) -> continue back to the lobby, which queues the next one
local function matchOver(now)
	if not CFG.rejoin then return false end
	local gs = RepS:FindFirstChild("GameState")
	local phase = gs and gs:GetAttribute("Phase")
	-- seen live after a defeat: Phase=Waiting, ArenaState=Returning, LastResult=Defeat, CombatState=None
	local res = gs and gs:GetAttribute("LastResult")
	local over = phase == "Ending" or phase == "Done" or LP:GetAttribute("CombatState") == "Eliminated"
		or (phase ~= "InMatch" and ((type(res) == "string" and res ~= "") or (gs and gs:GetAttribute("ArenaState") == "Returning")))
	if not over then endSince = nil return false end
	endSince = endSince or now
	if now - endSince > 6 and now - lastLeave > 8 then
		lastLeave = now
		pcall(Remotes.LeaveMatch.FireServer, Remotes.LeaveMatch, "continue")
		print("[GB] match over -> continue")
	end
	return true
end

