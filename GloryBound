-- Michroma: display wordmark. Inter: body (BuilderSans). RobotoMono: numbers.
-- Each is preloaded best-effort; FontFace falls back to a built-in Enum.Font
-- if the asset path fails.
local Fonts = Library.Fonts or {}

local function tryAssetFont(assetPath, weight, style, fallbackEnum)
	-- Font.new may error if the asset path is wrong (Studio often is fine;
	-- exploit environments vary). Wrap in pcall.
	local ok, result = pcall(function()
		return Font.new(assetPath, weight or Enum.FontWeight.Regular, style or Enum.FontStyle.Normal)
	end)
	if ok and result then
		-- no PreloadAsync here: font family JSONs are not images and only log load errors
		return result
	end
	-- Fall back to a legacy Enum.Font wrapped via Font.fromEnum
	local ok2, result2 = pcall(function()
		return Font.fromEnum(fallbackEnum or Enum.Font.Gotham)
	end)
	if ok2 and result2 then return result2 end
	return nil
end

