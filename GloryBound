-- chests: the save's OwnedChests = { [uid] = tier or {tier=...} }; ChestOpen(uid) one per second (server cooldown 1 s),
-- ChestBuy(tier) with Cash (prices from Shared.Config.Chest.Prices)
N.ChestFeed = {}
local function ownedChests() -- N.ownedChests (lobbyWork sits above this file section)
	local out = {}
	local oc = st.data.OwnedChests
	if type(oc) == "table" then
		for uid, v in pairs(oc) do
			local tier = type(v) == "string" and v or (type(v) == "table" and (v.tier or v.Tier)) or nil
			if type(uid) == "string" and tier then
				table.insert(out, { uid = uid, tier = tier })
			end
		end
	end
	table.sort(out, function(a, b)
		return a.uid < b.uid
	end)
	return out
end
N.ownedChests = ownedChests
N.ownedChests = ownedChests
-- the chest reveal's buttons (ChestController v797 -> UI kit button { name = "OpenNext" / "Collect" }): found by name,
-- or by their label text, visible only
function N.revealButton(name, text)
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local cr = pg and pg:FindFirstChild("ChestReveal") -- only the chest reveal: other screens have their own "Collect"
	if not cr or (cr:IsA("ScreenGui") and not cr.Enabled) then
		return nil
	end
	for _, d in ipairs(cr:GetDescendants()) do
		local hit = d.Name == name or ((d:IsA("TextLabel") or d:IsA("TextButton")) and string.lower(d.Text) == text)
		if hit and d:IsA("GuiObject") then
			local btn = d:IsA("GuiButton") and d or d:FindFirstAncestorWhichIsA("GuiButton") or d:FindFirstChildWhichIsA("GuiButton", true)
			if btn and N.shownOnScreen(btn) then
				return btn
			end
		end
	end
	return nil
end
function N.shownOnScreen(g)
	if not g.Parent or not g.Visible then
		return false
	end
	local o = g.Parent
	while o do
		if o:IsA("LayerCollector") then
			return not o:IsA("ScreenGui") or o.Enabled
		end
		if o:IsA("GuiObject") and not o.Visible then
			return false
		end
		o = o.Parent
	end
	return false
end
-- fires the button's own handler: the first signal that has connections (the UI kit listens on Activated), so one click
-- never runs twice
function N.clickButton(btn)
	for _, sig in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Up" }) do
		local ok, conns = pcall(getconnections, btn[sig])
		if ok and type(conns) == "table" and #conns > 0 then
			for _, c in ipairs(conns) do
				pcall(function() c:Fire() end)
			end
			return true
		end
	end
	if firesignal then
		return (pcall(firesignal, btn.Activated))
	end
	return false
end
-- skip animations: the game's cutscenes each build a full-screen TextButton "Skip" whose Activated runs the module's
-- skip() - BossCutscene (u1.skip -> BossCutsceneSkip), RebirthCutscene (u1.skip, canSkip after 2 s), the chest reveal
-- (ChestReveal...Skip: skip = true while shaking / rising). They are collected as they are made and fired while visible.
-- The chest reveal's own Skip is left alone once Open next / Collect show (its tap there is the reveal's onTap)
local skipButtons = {}
do
	local pg = LocalPlayer:WaitForChild("PlayerGui", 10)
	local function add(d)
		if d.Name == "Skip" and d:IsA("GuiButton") then
			skipButtons[d] = true
		end
	end
	if pg then
		for _, d in ipairs(pg:GetDescendants()) do
			add(d)
		end
		Library:GiveSignal(pg.DescendantAdded:Connect(add))
	end
	st.skipAt, st.skips = 0, 0
end
local shownOnScreen = N.shownOnScreen
local function skipStep(now)
	if not cfg.skipAnim or now - st.skipAt < 0.3 then
		return
	end
	st.skipAt = now
	for b in pairs(skipButtons) do
		if not b.Parent then
			skipButtons[b] = nil
		elseif shownOnScreen(b) then
			local sg = b:FindFirstAncestorWhichIsA("ScreenGui")
			local chestDone = sg and sg.Name == "ChestReveal" and (N.revealButton("OpenNext", "open next") or N.revealButton("Collect", "collect"))
			if not chestDone and N.clickButton(b) then
				st.skips += 1
				if st.skips <= 3 or st.skips % 25 == 0 then
					log("SKIP", sg and sg.Name or b:GetFullName(), "x" .. st.skips)
				end
			end
		end
	end
end
local function chestStep(now)
	if not N.inLobby then
		return
	end
	-- the server rate-limits ChestOpen ("Slow down, gladiator."): st.chestGap grows on every refusal, shrinks back on results
	-- every ChestResult pops the game's reveal screen (ChestController onChestResult -> reveal) with Collect / Equip / Open
	-- next. It stays up until clicked, so the reveal's own buttons drive the flow: "Open next" while a picked tier
	-- is left (the game's own open path), "Collect" after the last one. ChestOpen is fired directly only when no reveal is up
	if cfg.chests and now - st.openAt > st.chestGap then
		local nextBtn, collectBtn = N.revealButton("OpenNext", "open next"), N.revealButton("Collect", "collect")
		local want = false
		for _, c in ipairs(ownedChests()) do
			if cfg.chestTiers[c.tier] then
				want = true
				break
			end
		end
		if nextBtn and want then
			st.openAt = now
			if N.clickButton(nextBtn) then
				log("CHEST open next", #ownedChests(), "left")
			end
			return
		elseif collectBtn then
			st.openAt = now
			if N.clickButton(collectBtn) then
				log("CHEST collect, reveal closed")
			end
			return
		end
		for _, c in ipairs(ownedChests()) do
			if cfg.chestTiers[c.tier] and now - num(st.opening[c.uid]) > 6 then
				st.opening[c.uid] = now
				st.openAt = now
				if N.fire("ChestOpen", c.uid) then
					log("CHEST open", c.tier, c.uid)
				end
				break
			end
		end
	end
	if cfg.buyChest and now - st.buyAt > 3 then
		local price = num(ChestPrices[cfg.buyTier], 0)
		local cash = num(st.data.Cash)
		if price > 0 and cash - price >= cfg.cashReserve and #ownedChests() < MaxChests then
			st.buyAt = now
			if N.fire("ChestBuy", cfg.buyTier) then
				log("CHEST buy", cfg.buyTier, "cash", cash)
			end
		end
	end
end
do
	local r = remote("ChestResult")
	if r then
		Library:GiveSignal(r.OnClientEvent:Connect(function(p)
			if type(p) ~= "table" then
				return
			end
			if p.ok and type(p.item) == "table" then
				st.chestsOpened += 1
				local item = p.item
				table.insert(N.ChestFeed, 1, {
					at = os.clock(),
					name = tostring(item.displayName or item.name or item.id or "?"),
					sub = tostring(item.rarity or "") .. (item.kind and (" " .. tostring(item.kind)) or ""),
					value = tostring(p.tier or ""),
					rarity = tostring(item.rarity or ""),
				})
				if #N.ChestFeed > 30 then
					table.remove(N.ChestFeed)
				end
				st.chestGap = math.max(1.2, st.chestGap * 0.9)
				log("CHEST result", p.tier, item.rarity, item.displayName or item.id)
			elseif p.bought or p.purchased then
				log("CHEST bought", p.tier, p.ok)
			elseif p.ok == false then
				local why = tostring(p.reason or p.error or "")
				if why:lower():find("slow") then
					st.chestGap = math.min(8, st.chestGap * 1.6 + 0.5)
					table.clear(st.opening) -- the refused one is retried at the new pace, not after 6 s
				end
				log("CHEST refused", why, string.format("gap %.1fs", st.chestGap))
			end
		end))
	end
end

