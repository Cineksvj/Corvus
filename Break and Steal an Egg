local function sheenPass(target, duration, offset)
    local g = target:FindFirstChild("SheenGradient")
    if not g then
        g = new("UIGradient", {
            Name = "SheenGradient",
            Parent = target,
            Rotation = 25,
            Transparency = NumberSequence.new({
