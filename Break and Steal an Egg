		local gotPoints, points = pcall(path.GetWaypoints, path)
		if not gotPoints or type(points) ~= "table" or #points == 0 then
			return nil, status
		end
		if status == "Success" or status == "ClosestNoPath" or status == "ClosestOutOfRange" then
			return points, status, path
		end
		return nil, status
	end
	-- Pathfinding answers NoPath on some clients (player clip 2026-11-03: "no path 1981" of 1981 - the character
	-- stood next to the eggs and never moved). Then the leg is walked straight with Humanoid:MoveTo - still the
	-- Humanoid's own walk at the game's speed - over ground checked by a ray every 4 studs, and it ends at the
	-- last grounded point before a gap or a drop of more than 25 studs (never off an edge, never over the void).
	-- points (waypoint-shaped), gap
	local function directPoints(from, to)
		local points = {}
		local distance = flat(from, to)
		local steps = math.max(1, math.ceil(distance / 4))
		local floorY = math.min(from.Y, to.Y) - 25
		for i = 1, steps do
			local t = i / steps
			local x, z = from.X + (to.X - from.X) * t, from.Z + (to.Z - from.Z) * t
			local y = groundAt(x, z, math.max(from.Y, to.Y) + 6, 12)
			if not y or y < floorY then
				return points, true
			end
			if i % 3 == 0 or i == steps then
				points[#points + 1] = { Position = Vector3.new(x, y + 2, z) }
			end
		end
		return points, false
	end
	N.directPoints = directPoints
	-- Walks one computed path with Humanoid:MoveTo, waypoint by waypoint. "done" | "blocked" | "stuck" | "stopped" |
	-- "flung" | "timeout" | "dead". A waypoint that asks for a jump sets Humanoid.Jump (the game's own jump).
	local function follow(points, path, keepGoing, deadline)
		local blocked = false
		local conn = nil
		if path then
			pcall(function()
				conn = path.Blocked:Connect(function()
					blocked = true
				end)
			end)
		end
		local result = "done"
		for index, wp in ipairs(points) do
			local root, hum = rootPart(), humanoid()
			if not root or not hum or not alive() then
				result = "dead"
				break
			end
			if index == 1 and flat(root.Position, wp.Position) < 2.5 then
				continue
			end
			if wp.Action and wp.Action.Name == "Jump" then
				pcall(function()
					hum.Jump = true
				end)
				N.Walk.jumps += 1
			end
			local goal = wp.Position
			pcall(hum.MoveTo, hum, goal)
			local began = os.clock()
			local lastCheck, lastPos, jumped = began, root.Position, false
			local limit = math.max(3, flat(root.Position, goal) / math.max(N.modeSpeed() * 0.5, 6) + 2)
			while true do
				task.wait()
				root = rootPart()
				if not root or not alive() then
					result = "dead"
					break
				end
				if flat(root.Position, goal) <= 3.2 then
					break
				end
				if blocked then
					result = "blocked"
					break
				end
				if keepGoing and not keepGoing() then
					result = "stopped"
					break
				end
				if N.flung() then
					result = "flung"
					break
				end
				local now = os.clock()
				if now > deadline then
					result = "timeout"
					break
				end
				if now - began > limit then
					result = "stuck"
					break
				end
				if now - lastCheck >= 1 then
					if flat(root.Position, lastPos) < 0.8 then
						if jumped then
							result = "stuck"
							break
						end
						jumped = true
						N.Walk.jumps += 1
						pcall(function()
							humanoid().Jump = true
						end)
						pcall(hum.MoveTo, hum, goal)
					else
						jumped = false
					end
					lastCheck, lastPos = now, root.Position
				end
			end
			if result ~= "done" then
				break
			end
		end
		if conn then
			pcall(conn.Disconnect, conn)
		end
		return result
	end
	-- The v1 hub (Obsidian library, worked for players) never used the pathfinder or Humanoid:MoveTo: "Humanoid:MoveTo
	-- runs far below your speed in this game". On the clients where the pathfinder answers NoPath the Humanoid also
	-- stands still on the straight walk (clip 2026-11-03: next to the eggs, never moving). Then the character goes over
	-- the same ray-checked grounded points the v1 way: at 97 % of your own WalkSpeed, feet on the floor (ground +
	-- stand height at every point), no noclip, never past the last grounded point before a gap. "done" / "stuck" /
	-- "stopped" / "flung" / "dead", like follow.
	local function groundGlide(points, keepGoing, speedFn, lift)
		N.Walk.glide += 1
		speedFn = speedFn or function()
			return math.max(N.walkSpeed() * 0.97, 8)
		end
		lift = lift or (N.standHeight() - 2)
		for _, wp in ipairs(points) do
			local p = wp.Position
			local done, why = glideTo(Vector3.new(p.X, p.Y + lift, p.Z), speedFn, keepGoing)
			if not done then
				if why == "stopped" or why == "flung" then
					return why
				end
				return if why == "no character" then "dead" else "stuck"
			end
		end
		return "done"
	end
	N.groundGlide = groundGlide
	-- The fast run: the pathfinder's waypoints (they sit on the floor and go around walls) when it finds the way,
	-- otherwise the straight ray-checked ground points (stops at the last grounded point before a gap). Never noclip,
	-- never a point without ground under it. true, or false + reason.
	function N.groundRun(target, keepGoing, speedFn)
		local root = rootPart()
		if not root then
			return false, "no character"
		end
		local points, status = computePath(root.Position, target)
		N.Walk.paths += 1
		local lift = N.standHeight()
		-- every waypoint must stand on ground: the run ends at the last grounded one (never over the void); checked
		-- when the start itself stands on something the ray sees (always in the game)
		if points and N.groundAt(root.Position.X, root.Position.Z, root.Position.Y + 6) then
			for i, wp in ipairs(points) do
				local p = wp.Position
				if not N.groundAt(p.X, p.Z, p.Y + 6) then
					points = table.move(points, 1, i - 1, 1, {})
					status = "Gap"
					break
				end
			end
			if #points == 0 then
				points = nil
			end
		end
		if not points then
			local gap
			points, gap = directPoints(root.Position, target)
			lift = N.standHeight() - 2
			if #points == 0 then
				N.Walk.noPath += 1
				N.Moves.refusedLegs = (N.Moves.refusedLegs or 0) + 1
				note("nopath", string.format("RUN no ground way to %s from %s (%s), target skipped", brief(target), brief(root.Position), tostring(status)))
				return false, "no path"
			end
			N.Walk.direct += 1
			status = if gap then "DirectGap" else "Direct"
		end
		local result = groundGlide(points, keepGoing, speedFn, lift)
		if result ~= "done" then
			return false, result
		end
		local after = rootPart()
		if after and flat(after.Position, target) <= 4 and math.abs(after.Position.Y - target.Y) <= 10 then
			return true
		end
		N.Walk.noPath += 1
		N.Moves.refusedLegs = (N.Moves.refusedLegs or 0) + 1
		note("short", string.format("RUN stopped %d studs short of %s (%s), target skipped", if after then math.floor(flat(after.Position, target)) else -1, brief(target), tostring(status)))
		return false, "no path"
	end
	-- true when the character stands at the target; false, reason otherwise ("no path", "stopped", "flung",
	-- "timeout", "no character"). Re-plans when the path is blocked or a waypoint times out.
	function N.walkTo(target, keepGoing)
		local W = N.Walk
		local root = rootPart()
		if not root or not target then
			return false, "no character"
		end
		local deadline = os.clock() + math.clamp(flat(root.Position, target) / math.max(N.modeSpeed() * 0.5, 8) + 30, 40, 300)
		local best, stalls = math.huge, 0
		while true do
			root = rootPart()
			if not root or not alive() then
				return false, "no character"
			end
			if flat(root.Position, target) <= 3.5 and math.abs(root.Position.Y - target.Y) <= 10 then
				return true
			end
			if keepGoing and not keepGoing() then
				return false, "stopped"
			end
			if N.flung() then
				return false, "flung"
			end
			if os.clock() > deadline then
				W.timeouts += 1
				note("timeout", string.format("WALK timeout towards %s from %s", brief(target), brief(root.Position)))
				return false, "timeout"
			end
			local points, status, path = computePath(root.Position, target)
			W.paths += 1
			if not points then
				local direct, gap = directPoints(root.Position, target)
				if #direct > 0 then
					W.direct += 1
					note("direct", string.format("WALK pathfinder %s to %s, walking straight over the ground%s", tostring(status), brief(target), if gap then " up to a gap" else ""))
					points, status, path = direct, if gap then "DirectGap" else "Direct", nil
				end
			end
			if not points then
				W.noPath += 1
				N.Moves.refusedLegs = (N.Moves.refusedLegs or 0) + 1
				note("nopath", string.format("WALK no path to %s from %s (%s), target skipped", brief(target), brief(root.Position), tostring(status)))
				return false, "no path"
			end
			local result = follow(points, path, keepGoing, deadline)
			if (status == "Direct" or status == "DirectGap") and (result == "stuck" or result == "blocked") then
				note("glide", string.format("WALK the Humanoid did not walk to %s, going along the ground at your WalkSpeed (v1 walk)", brief(target)))
				result = groundGlide(points, keepGoing)
			end
			if result == "stopped" or result == "flung" or result == "timeout" then
				return false, result
			elseif result == "dead" then
				return false, "no character"
			end
			root = rootPart()
			local after = if root then flat(root.Position, target) else math.huge
			if (status == "Success" or status == "Direct") and result == "done" and after <= 8 then
				return true
			end
			if after < best - 4 then
				best, stalls = after, 0
			else
				stalls += 1
			end
			if stalls >= 3 then
				W.noPath += 1
				N.Moves.refusedLegs = (N.Moves.refusedLegs or 0) + 1
				note("nocloser", string.format("WALK no way closer to %s (stuck at %s), target skipped", brief(target), if root then brief(root.Position) else "?"))
				return false, "no path"
			end
			W.repaths += 1
			if result == "blocked" or result == "stuck" then
				N.Moves.blocked += 1
			end
		end
	end
	function N.travelTo(target, opts)
		opts = opts or {}
		local root = rootPart()
		if not root or not target then
			return false
		end
		N.holdAt(nil)
		local mode = opts.mode or N.moveMode()
		local carrying = N.carrying()
		-- M4: a teleport with an animal blocks banking ("Anti-cheat blocked banking - you teleported!"), so carrying legs
		-- always glide.
		if mode == "Teleport" and carrying and (target - root.Position).Magnitude >= 0.5 then
			mode = "Fast"
			if not N.Moves.carrySaid then
				N.Moves.carrySaid = true
				log("MOVE carry rung=Fast (teleport blocks banking)")
			end
		end
		N.Moves.trip = (N.Moves.trip or 0) + 1
		-- Tp to eggs: empty legs hop (N.hopTo) while the probe has not rejected it; a failed leg finishes as a glide.
		-- never with an animal, and not within 1.5 s of a grab (Carrying replicates a moment after the prompt)
		if optionText("EggTravel", "Walk to eggs") == "Tp to eggs" and not carrying and not N.carrying() and os.clock() - (N.Moves.grabAt or -1e9) > 1.5 and not opts.mode and mode ~= "Teleport" and N.hopState() ~= "rejected" and (target - root.Position).Magnitude >= 30 then
			local arrived = N.hopTo(target, opts.look)
			if arrived then
				return true
			end
			root = rootPart()
			if not root then
				return false
			end
			if N.hopState() == "rejected" then
				setStatus("Tp to eggs refused by the server, walking to eggs")
			end
		end
		-- M5: empty legs >= 200 studs try a full teleport (probe: 3 tries once per PlaceVersion; accepted = used from then on).
		if mode == "Fast" and N.Moves.forceMode == "Teleport" and not carrying and not opts.mode and flat(root.Position, target) >= 200 then
			local T, state = N.Moves.tp, tpState()
			if state == "accepted" or (state == "unknown" and T.tries < 3 and os.clock() - T.lastAt > 30) then
				local probing = state == "unknown"
				local from = root.Position
				local saved = flat(from, target) / math.max(N.modeSpeed("Fast", false), 1)
				if probing then
					T.tries += 1
				end
				T.lastAt = os.clock()
				local acBefore = N.Moves.acAt
				Noclip.travel = true
				placeRoot(target, opts.look)
				task.wait(if probing then 1.5 else 0.6)
				Noclip.travel = false
				local now = rootPart()
				local held = now ~= nil and (now.Position - target).Magnitude <= 12 and N.Moves.acAt == acBefore
				if not held then
					tpReject(if N.Moves.acAt ~= acBefore then "anti-cheat line" else "pulled back")
					root = rootPart()
					if not root then
						return false
					end
				else
					if probing then
						T.ok += 1
						if T.ok >= 3 then
							T.result = "accepted"
							if N.ProbeMem then
								N.ProbeMem.set("move_teleport", "accepted")
							end
							log(string.format("PROBE move_teleport result=accepted gain=-%.1fs per leg tries=%d", saved, T.tries))
						end
					end
					return true
				end
			end
		end
		if mode == "Teleport" or (target - root.Position).Magnitude < 0.5 then
			local far = (target - root.Position).Magnitude > 20
			Noclip.travel = true
			local ok = placeRoot(target, opts.look)
			task.wait(0.05)
			Noclip.travel = false
			if far and mode == "Teleport" then
				-- The server pulls a teleport back a moment later: count it like a snapback so the ladder can step down.
				local trip = N.Moves.trip
				task.delay(0.6, function()
					local now = rootPart()
					if now and N.Moves.trip == trip and not N.flung() and (now.Position - target).Magnitude > 12 then
						noteSnap((now.Position - target).Magnitude)
					end
				end)
			end
			return ok
		end
		if mode == "Walk" then
			-- default: a real walk, no CFrame / velocity write (owner 2026-11-03). Glide / Fast / Teleport are opt-in ban risks.
			local startPos, startAt = root.Position, os.clock()
			local walkedOk, walkWhy = N.walkTo(target, opts.keepGoing)
			local after = rootPart()
			local walked = if after then flat(startPos, after.Position) else 0
			if walked > 30 then
				local took = math.max(os.clock() - startAt, 0.01)
				log(string.format("MOVE walk %d studs in %.1fs = %d/s (WalkSpeed %d, carrying %d)", walked, took, walked / took, N.walkSpeed(), if carrying then 1 else 0))
			end
			return walkedOk, walkWhy
		end
		-- Humanoid:MoveTo runs far below your speed in this game, so Fast glides along the ground at your own WalkSpeed (opt-in, ban risk).
		local speedFn = function()
			return N.modeSpeed(opts.mode or N.moveMode(), carrying)
		end
		local startPos, startAt = root.Position, os.clock()
		local area = if N.areaOf(root.Position) == "base" and N.areaOf(target) == "base" then "base" else "zone"
		N.Moves.legArea, N.Moves.lastArea = area, area
		-- Walls: the run goes around them (pathfinder waypoints); it never noclips (the Discord clip: through the plot
		-- wall and the hedge, then over the void = the "flying" bans).
		Noclip.travel = false
		local ok, why = N.groundRun(target, opts.keepGoing, speedFn)
		Noclip.travel = false
		N.Moves.legArea = nil
		if ok and opts.look then
			placeRoot(target, opts.look)
		end
		local after = rootPart()
		local walked = if after then flat(startPos, after.Position) else 0
		if walked > 30 then
			local took = math.max(os.clock() - startAt, 0.01)
			N.Moves.legArea = area
			log(string.format("MOVE %s %d studs in %.1fs = %d/s (WalkSpeed %d, boost %d%%, area %s, carrying %d)", mode, walked, took, walked / took, N.walkSpeed(), if mode == "Fast" then N.fastPct(carrying) else 97, area, if carrying then 1 else 0))
			N.Moves.legArea = nil
		end
		if ok and mode == "Fast" and not carrying then
			boostLegDone(startAt, walked, area)
		end
		return ok, why
	end
	function N.travelNear(target, within, opts)
		local root = rootPart()
		if not root or not target then
			return false
		end
		if flat(root.Position, target) <= within then
			return true
		end
		local dir = root.Position - target
		dir = Vector3.new(dir.X, 0, dir.Z)
		local spot = if dir.Magnitude > 0.5 then target + dir.Unit * math.max(within * 0.6, 2) else target + Vector3.new(2, 0, 0)
		return N.travelTo(N.standAt(spot), opts)
	end
end
