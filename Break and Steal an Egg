	window.SideTip = sideTip
	window.Compact = false
	window._rows = {}
	function window:SetNarrow(v)
		v = v == true
		if self.Narrow == v then return end
		self.Narrow = v
		for _, e in ipairs(self._rows) do
			if e.Row.Parent then
				if v then
					e.List.FillDirection = Enum.FillDirection.Vertical
					e.Left.Size  = UDim2.new(1, 0, 0, 0)
					e.Right.Size = UDim2.new(1, 0, 0, 0)
				else
					e.List.FillDirection = Enum.FillDirection.Horizontal
					e.Left.Size  = UDim2.new(e.Split, -COL_GAP / 2, 0, 0)
					e.Right.Size = UDim2.new(1 - e.Split, -COL_GAP / 2, 0, 0)
