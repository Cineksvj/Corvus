		if not on("AutoTrain") or N.carrying() then
			T.idleSince = nil
			return false
		end
		local now = os.clock()
		T.idleSince = T.idleSince or now
		if now - T.idleSince < 8 then
			return false
		end
		return N.startTrainBout(30, "nothing to farm in reach")
	end
