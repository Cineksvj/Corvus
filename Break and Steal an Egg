do
	-- One queue per webhook URL (Discord rate limits per webhook). Hook.queues[url] = { embed, ... }.
	local Hook = { queues = {}, sent = 0 }
	N.Hook = Hook
	local function httpRequest(options)
		local fn = (typeof(syn) == "table" and syn.request) or (typeof(http) == "table" and http.request) or http_request or request
		if type(fn) ~= "function" then
			return nil
		end
		local ok, response = pcall(fn, options)
		return if ok then response else nil
	end
	local function validWebhook(url)
		return type(url) == "string"
			and (
					url:find("^https://discord%.com/api/webhooks/")
					or url:find("^https://discordapp%.com/api/webhooks/")
					or url:find("^https://canary%.discord%.com/api/webhooks/")
					or url:find("^https://ptb%.discord%.com/api/webhooks/")
				)
				~= nil
	end
	local function postWebhook(url, payload)
		if not validWebhook(url) then
			return false, 0
		end
		local response = httpRequest({
			Url = url,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(payload),
		})
		local code = response and tonumber(response.StatusCode) or 0
		return code >= 200 and code < 300, code
	end
	local function playerField()
		if Toggles.WebhookHideName and Toggles.WebhookHideName.Value then
			return "Hidden"
		end
		return "||" .. LocalPlayer.Name .. "||"
	end
	-- Several webhooks, each with its own posts (owner 2026-11-02). With the library the Webhook tab holds a
	-- WebhookBoard (02_controls: Options.Webhooks.Value = { { url, events = { [Key] = true } }, ... },
	-- board:GetWebhooks() = the rows with an https URL, saved by configs). Without the board (the mock library)
	-- the same card is one URL box plus one "Posts" multi dropdown; N.webhooks() hides the difference.
	N.WebhookEvents = {
		{ Key = "steal", Text = "Animals grabbed" },
		{ Key = "huge", Text = "HUGE and TITANIC animals" },
		{ Key = "upgrade", Text = "Upgrades bought" },
		{ Key = "zone", Text = "New zones" },
		{ Key = "sale", Text = "Sales" },
		{ Key = "report", Text = "Farm report" },
	}
	function N.webhooks()
		local out = {}
		local board = Options.Webhooks
		if board and type(board.GetWebhooks) == "function" then
			for _, hook in ipairs(board:GetWebhooks()) do
				if validWebhook(hook.url) and type(hook.events) == "table" then
					table.insert(out, hook)
				end
			end
			return out
		end
		local url = Options.WebhookUrl and Options.WebhookUrl.Value
		if not validWebhook(url) then
			return out
		end
		local events = {}
		local picked = Options.WebhookPosts and Options.WebhookPosts.Value
		if type(picked) == "table" then
			for _, event in ipairs(N.WebhookEvents) do
				if picked[event.Text] == true or picked[event.Key] == true then
					events[event.Key] = true
				end
			end
		end
		table.insert(out, { url = url, events = events })
		return out
	end
	local function wants(hook, kinds)
		if type(kinds) == "string" then
			return hook.events[kinds] == true
		end
		for _, kind in ipairs(kinds) do
			if hook.events[kind] == true then
				return true
			end
		end
		return false
	end
	-- kinds: one event key or a list of them; the embed goes to every webhook that picked any of them.
	local function queueEmbed(kinds, embed)
		embed.footer = embed.footer or { text = "Corvus  \u{00B7}  " .. GameName }
		embed.timestamp = embed.timestamp or DateTime.now():ToIsoDate()
		for _, hook in ipairs(N.webhooks()) do
			if wants(hook, kinds) then
				local queue = Hook.queues[hook.url]
				if not queue then
					queue = {}
					Hook.queues[hook.url] = queue
				end
				if #queue < 30 then
					table.insert(queue, embed)
				end
			end
		end
	end
