				end
				local root, hum = rootPart(), humanoid()
				if not root or not hum or hum.Health <= 0 then
					return
				end
				local now = os.clock()
				local sig = string.format("%.0f|%.0f|%d|%d|%d", N.power(), N.cash(), Session.eggs, Session.hits, Session.banked)
