	local function colorOf(hex)
		local ok, color = pcall(Color3.fromHex, hex)
		if not ok then
			return 16762930
		end
		return math.floor(color.R * 255) * 65536 + math.floor(color.G * 255) * 256 + math.floor(color.B * 255)
	end
