			return false
		end
		local now = os.clock()
		local limit = if T.phase == "farm" then optionNumber("FarmMinutes", 10) else optionNumber("TrainMinutes", 5)
		if now - T.phaseSince >= limit * 60 then
			T.phase = if T.phase == "farm" then "train" else "farm"
