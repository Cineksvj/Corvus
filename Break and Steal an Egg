	if not N.underCap(index) then
		return false
	end
	local mode = optionText("ZoneMode", "Best zone")
	-- Best zone (default) collapses to a single target. With a non-empty ZonePick the highest ticked zone wins
	-- even when speed cannot open it yet (the pick is the player's intent). Without picks it is bestZone (highest
	-- -income zone your speed opens). Owner 2026-10-18 live: ticking every zone while leaving Best zone selected
	-- used to bounce the hub between zones 1-7-2 (chase + GRAB skip zone 1 animals never beat weakest); now it
	-- stays on the top one.
	if mode == "Best zone" then
		if N.zonePickActive() then
