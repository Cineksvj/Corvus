	at = -1e9,
	logAt = -1e9,
	hp = {},
	hpBroken = {},
	luck = {},
	size = {},
	seen = {},
	trip = {},
	wsRatio = 1,
	calib = 1,
	farmTime = 0,
	bankedAt = 0,
	activity = "farm",
	valid = {},
	summary = "",
	HatchDelay = 12,
	EggGap = 1.5,
	BankOverhead = 2,
	Horizon = 86400,
