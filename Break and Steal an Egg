		-- so the server opened a session and we only logged it. After ending the session, step off physically so the
		-- next tick does not open another one.
		if sessionWas then
			local _, hitbox = N.treadmill()
			local root = rootPart()
			local hum = humanoid()
			if root and hum and hitbox and (root.Position - hitbox.Position).Magnitude < 10 then
				pcall(function()
					hum.Sit = false
					hum:ChangeState(Enum.HumanoidStateType.Jumping)
				end)
				local away = (root.Position - hitbox.Position) * Vector3.new(1, 0, 1)
				local dir = if away.Magnitude > 0.1 then away.Unit else Vector3.new(0, 0, 1)
				pcall(function()
					hum:MoveTo(root.Position + dir * 14) -- a real step off the belt, no CFrame write
				end)
