						info.rarity,
						N.displayName(info.name),
						if info.bracket ~= "" then "  \u{00B7}  " .. info.bracket else "",
						if info.mine then "  \u{00B7}  yours" else ""
					),
					color,
					nil
				)
			end
		end
		if on("ESPPickups") then
			for _, info in ipairs(N.pickups()) do
