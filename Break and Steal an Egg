end

-- the theme-aware colour write (Library:ThemeSet, 01_core): a chrome colour is tinted the way the
-- theme walk tints it and kept in the registry under its instance, so the next theme - or the
-- moving RGB - re-tints it from this state's base; a dark colour is written as it is. Owner
-- 2026-11-01 ("fix themes for toggles when turning off and on etc."): before this a state paint
-- wrote the silver raw, and the walk kept re-tinting an OFF track from its ON base.
local Edge = {}   -- one local for the theme / edge helpers (the library's files share one function's registers)
function Edge.set(inst, prop, base, dur, style)
    if type(Library.ThemeSet) == "function" then
        return Library:ThemeSet(inst, prop, base, dur, style)
    end
    if (dur or 0) > 0 then return tween(inst, dur, style, { [prop] = base }) end
    inst[prop] = base
end

-- the lit edge (owner 2026-11-01 "add outlines for slider and textbox and dropdowns too"): the
-- sidebar plate's own edge - a 1 px silver stroke under a top-lit gradient - round a control's
-- well. edgeState paints its three states: rest (the lit silver), hover (the ink, a step
-- brighter under the same light) and active (the light off, the needle silver whole: the focus
-- ring, the open pill, the held slider, the listening chip).
Edge.REST = Color3.fromHex("#BFC4CC")
Edge.LIT = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromHex("#5C6473")), ColorSequenceKeypoint.new(1, Color3.fromHex("#20242B")) })
function Edge.lit(parent, transparency)
    local e = stroke(parent, Edge.REST, 1, transparency or 0)
    new("UIGradient", { Name = "Lit", Rotation = 90, Color = Edge.LIT, Parent = e })
    return e
end
function Edge.state(e, state, dur)
    local lit = e:FindFirstChild("Lit")
    if state == "active" then
        if lit then lit.Enabled = false end
        Edge.set(e, "Color", Colors.needle or Colors.Brushed, dur or 0.14)
    else
        if lit then lit.Enabled = true end
        Edge.set(e, "Color", state == "hover" and (Colors.text or Colors.Ink) or Edge.REST, dur or 0.12)
    end
end
function Edge.error(e)
    local lit = e:FindFirstChild("Lit")
    if lit then lit.Enabled = false end
    Edge.set(e, "Color", Colors.Red, 0.15)
    task.delay(0.3, function() Edge.state(e, "rest", 0.2) end)
end

local function applyGradient(parent, g, rotation)
    local u = new("UIGradient", {
        Parent = parent,
        Rotation = rotation or (type(g) == "table" and g.Rotation) or 0,
    })
    if typeof(g) == "ColorSequence" then
        u.Color = g
    elseif type(g) == "table" then
        if g.Color then u.Color = g.Color end
        if g.Transparency then u.Transparency = g.Transparency end
        if g.Rotation then u.Rotation = g.Rotation end
    end
    -- B5: metal / rail gradients repaint when the theme changes
    if type(rawget(Library, "RegisterThemed")) == "function" then
        if g == Gradients.SwitchOn or g == Gradients.SwitchOnBase then
            Library:RegisterThemed(u, "rail")
        elseif g == Gradients.Metal135 or g == Gradients.Metal then
            Library:RegisterThemed(u, "metal")
        end
    end
    return u
end

-- ---------------------------------------------------------------- signal mini
local function signal()
    local sig = { _h = {} }
    function sig:Connect(fn)
        table.insert(self._h, fn)
        return { Disconnect = function()
            for i, f in ipairs(self._h) do
                if f == fn then table.remove(self._h, i); return end
            end
        end }
    end
    function sig:Fire(...)
        for _, fn in ipairs(self._h) do
            task.spawn(fn, ...)
        end
    end
    return sig
end
Library.Signal = Library.Signal or signal

