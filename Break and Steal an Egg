            end)
        end

        tween(sheet, 0.25, Enum.EasingStyle.Quint, { Position = UDim2.new(0, 0, 0.5, 0) })

        backdrop.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local p = input.Position
                local sheetP = sheet.AbsolutePosition
                if p.Y < sheetP.Y then self:Close() end
            end
        end)

        self._menu = backdrop
    end

    pill.MouseButton1Click:Connect(function()
        if d._open then d:Close() else d:Open() end
    end)

    connectHover(pill,
        function() if not d._open then Edge.state(pillStroke, "hover", 0.09); tween(pill, 0.09, Enum.EasingStyle.Linear, { BackgroundColor3 = Colors.wellHover or Colors.WellHover }); tintChevron(CHEV_LIT) end end,
        function() if not d._open then Edge.state(pillStroke, "rest", 0.12); tween(pill, 0.12, nil, { BackgroundColor3 = Colors.well or Colors.Well }); tintChevron(CHEV_REST) end end
    )

    d:_refresh()

    if idx then Library.Options[idx] = d end
    table.insert(self._controls, d)
    return d
end

