	function N.weather()
		local A = N.tableOr(N.G.Weather.Attributes)
		local now = N.serverNow()
		local active = weatherDef(workspace:GetAttribute(if type(A.Id) == "string" then A.Id else "WeatherId"))
		if active then
			local endsAt = tonumber(workspace:GetAttribute(if type(A.EndsAt) == "string" then A.EndsAt else "WeatherEndsAt")) or now
			return {
				active = true,
				id = tostring(active.Id),
				name = tostring(active.DisplayName or active.Id),
				mult = tonumber(active.CashMult) or 1,
				mutation = if type(active.Mutation) == "string" then active.Mutation else nil,
				left = math.max(0, endsAt - now),
				icon = if type(active.Icon) == "string" then active.Icon else nil,
			}
		end
		local nextDef = weatherDef(workspace:GetAttribute(if type(A.NextId) == "string" then A.NextId else "WeatherNextId"))
		local nextAt = tonumber(workspace:GetAttribute(if type(A.NextAt) == "string" then A.NextAt else "WeatherNextAt"))
		if nextDef and nextAt then
			return {
				active = false,
				id = tostring(nextDef.Id),
				name = tostring(nextDef.DisplayName or nextDef.Id),
				mult = tonumber(nextDef.CashMult) or 1,
				mutation = if type(nextDef.Mutation) == "string" then nextDef.Mutation else nil,
				left = math.max(0, nextAt - now),
				icon = if type(nextDef.Icon) == "string" then nextDef.Icon else nil,
			}
		end
		return nil
	end
	function N.weatherText()
		local w = N.weather()
