	-- -------------------- A5: compact sidebar (56 px, icons only) + resizable window
	local SIDEBAR_FULL, SIDEBAR_MINI = SIDEBAR_W, 56
	sidebar.ClipsDescendants = true   -- tab names must not spill over the content mid-tween
	local function applySidebarWidth(w, instant)
		local goals = {
			[sidebar] = { Size = UDim2.new(0, w, 1, -BOTTOM_H) },
			[content] = { Size = UDim2.new(1, -(w + PAD * 2), 1, -(HEADER_H + TAB_BAR_H + BOTTOM_H + PAD * 2)), Position = UDim2.new(0, w + PAD, 0, HEADER_H + TAB_BAR_H + PAD) },
			[header]  = { Size = UDim2.new(1, -w, 0, HEADER_H), Position = UDim2.new(0, w, 0, 0) },
			[ruleV]   = { Position = UDim2.new(0, w - 1, 0, 0) },
			[userCard]   = { Size = UDim2.new(0, w, 1, 0) },
			[footerSlot] = { Size = UDim2.new(1, -w, 1, 0), Position = UDim2.new(0, w, 0, 0) },
		}
		for inst, g in pairs(goals) do
			if instant then
				for k, v in pairs(g) do inst[k] = v end
			else
				Library:NewTween(inst, 0.22, g, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
