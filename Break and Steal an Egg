		if not wanted then
			T.adminWaitAt = nil
			return false
		end
		local _, hitbox = N.adminTreadmill()
		local spot = N.standAt(hitbox.Position)
		if N.distanceTo(spot) > 4 then
			setStatus(string.format("Going to the Admin Treadmill (x%g)", mult))
			N.travelTo(spot)
		end
