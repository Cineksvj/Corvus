-- Corvus · Break and Steal an Egg version picker (owner 2026-11-03).
-- The public file "Break and Steal an Egg" is this picker. It runs the version the player picked last time
-- ("Break and Steal an Egg Old" = the Obsidian-era hub 83ce3e7, the default; "Break and Steal an Egg New" = the v2
-- hub) and puts one small button at the top of the screen that switches to the other one: it saves the pick,
-- closes the running hub and starts the other version in its place.
local Env = (type(getgenv) == "function" and getgenv()) or _G
local Repo = "https://raw.githubusercontent.com/Cineksvj/Corvus/refs/heads/main/"
local PICK_FILE = "Corvus/BSE_version.txt"
local FILES = { old = "Break and Steal an Egg Old", new = "Break and Steal an Egg New" }
local LABELS = { old = "Switch to newer version", new = "Switch to old version" }

local function readPick()
	local ok, text = pcall(function()
		if type(isfile) == "function" and isfile(PICK_FILE) then
			return readfile(PICK_FILE)
		end
		return nil
	end)
	text = ok and type(text) == "string" and text:lower():gsub("%s", "") or ""
	return if text == "new" then "new" else "old"
end

local function savePick(which)
	pcall(function()
		if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder("Corvus") then
			makefolder("Corvus")
		end
		writefile(PICK_FILE, which)
	end)
end

local function notify(text)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Corvus", Text = text, Duration = 5 })
	end)
end

-- both hubs keep their library in one of these; Unload closes the window and stops the hub's loops
local function runningLibrary()
	for _, lib in ipairs({ rawget(Env, "CorvusLibrary"), rawget(_G, "CorvusLibrary"), rawget(Env, "Library"), rawget(_G, "Library") }) do
		if type(lib) == "table" and type(lib.Unload) == "function" and not lib.Unloaded then
			return lib
		end
	end
	return nil
end

local function closeRunningHub()
	for _ = 1, 4 do
		local lib = runningLibrary()
		if not lib then
			break
		end
		pcall(lib.Unload, lib)
		task.wait(0.2)
	end
	Env.CorvusBooting = nil
	Env.CorvusLoaded = nil
end

local function guiParent()
	local ok, hui = pcall(function()
		return if type(gethui) == "function" then gethui() else nil
	end)
	if ok and hui then
		return hui
	end
	local okCore, core = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and core then
		return core
	end
	return game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end

local function fetch(which)
	local url = Repo .. FILES[which]:gsub(" ", "%%20") .. "?t=" .. tostring(os.time())
	local lastErr = "empty response"
	for attempt = 1, 4 do
		local ok, src = pcall(game.HttpGet, game, url)
		if ok and type(src) == "string" and #src > 10000 then
			return src
		end
		lastErr = ok and ("short response " .. tostring(type(src) == "string" and #src or src)) or tostring(src)
		task.wait(attempt)
	end
	return nil, lastErr
end

local start

local function showButton(which)
	local parent = guiParent()
	local old = parent:FindFirstChild("CorvusVersionSwitch")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "CorvusVersionSwitch"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 1000
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	end)
	local button = Instance.new("TextButton")
	button.Name = "Switch"
	button.AnchorPoint = Vector2.new(0.5, 0)
	button.Position = UDim2.new(0.5, 0, 0, 6)
	button.Size = UDim2.fromOffset(200, 30)
	button.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
	button.BackgroundTransparency = 0.1
	button.AutoButtonColor = true
	button.Font = Enum.Font.GothamMedium
	button.TextSize = 14
	button.TextColor3 = Color3.fromRGB(235, 235, 240)
	button.Text = LABELS[which]
	button.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = button
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = Color3.fromRGB(120, 110, 220)
	stroke.Transparency = 0.3
	stroke.Parent = button
	gui.Parent = parent

	local busy = false
	button.Activated:Connect(function()
		if busy then
			return
		end
		busy = true
		local other = if which == "old" then "new" else "old"
		button.Text = "Switching..."
		savePick(other)
		closeRunningHub()
		gui:Destroy()
		task.spawn(start, other)
	end)

	-- the player closed the hub (X / Unload): the button goes with it
	task.spawn(function()
		local seen = nil
		while gui.Parent do
			task.wait(2)
			local lib = runningLibrary()
			if lib then
				seen = lib
			elseif seen and not busy then
				gui:Destroy()
				break
			end
		end
	end)
end

start = function(which)
	local src, err = fetch(which)
	if not src then
		warn("[Corvus PICK] could not download the " .. which .. " version: " .. tostring(err))
		if which == "new" then
			notify("The newer version did not download, starting the old one")
			savePick("old")
			return start("old")
		end
		notify("Download failed, try again in a minute")
		return
	end
	local fn, compileErr = loadstring(src)
	if not fn then
		warn("[Corvus PICK] the " .. which .. " version did not compile: " .. tostring(compileErr))
		return
	end
	Env.CorvusBooting = nil
	print("[Corvus PICK] starting the " .. which .. " version")
	showButton(which)
	return fn()
end

return start(readPick())

--[[
The public loader refuses hub downloads under 10000 bytes (an empty or cut response from a slow executor), so this
file carries the notes below to stay above that size. They are not code.

How the switch works
- The pick is stored in workspace/Corvus/BSE_version.txt as "old" or "new". No file = "old".
- The button sits at the top centre of the screen, under the Roblox top bar (CoreUISafeInsets).
- Pressing it saves the other pick, calls Unload on the running hub's library (both versions close their window
  and stop their loops on Unload), clears the boot guard and starts the other version from the repo.
- If the newer version fails to download, the picker falls back to the old one and saves "old".
- When the player closes the hub, the button disappears too.

Updating
- tools/github_upload.py --public bse uploads the v2 build as "Break and Steal an Egg New" and bumps the Versions
  entry of "Break and Steal an Egg", so the loader reloads this picker, which then runs the player's pick.
- The old version is a fixed file ("Break and Steal an Egg Old"), the Obsidian-era hub 83ce3e7.

Why two versions
- Players asked for the older hub back (2026-11-03). Both stay available; the player chooses.

