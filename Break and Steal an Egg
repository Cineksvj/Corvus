			mode = "Fast"
		end
		if mode == "Fast" then
			-- Fast = your server WalkSpeed times the measured boost; snapbacks step it down to Walk.
			return math.max(N.walkSpeed() * N.fastPct(carrying) / 100, 18) * factor
		elseif mode == "Teleport" then
			return math.huge
		end
