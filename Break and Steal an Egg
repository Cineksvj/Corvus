	end
	task.spawn(function()
		local lastReport = os.clock()
		while alive() do
			task.wait(2.5)
			pcall(function()
				if not hookOn() then
					table.clear(Hook.queues)
					return
				end
				local every = (Options.WebhookReport and Options.WebhookReport.Value or 0) * 60
				if every > 0 and os.clock() - lastReport >= every then
					lastReport = os.clock()
					queueEmbed("report", reportEmbed("\u{2726}  Farm report"))
				end
				local live = {}
				for _, hook in ipairs(N.webhooks()) do
					live[hook.url] = true
				end
				-- one post per webhook per tick; a removed webhook loses its queue
				for url, queue in pairs(Hook.queues) do
					if not live[url] then
						Hook.queues[url] = nil
					else
						local embed = table.remove(queue, 1)
						if embed then
							embed.author = { name = GameName }
							if postWebhook(url, { username = "Corvus", allowed_mentions = { parse = {} }, embeds = { embed } }) then
