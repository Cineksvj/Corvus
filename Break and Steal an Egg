                for _, connection in DraggableLabel.Connections do
                    connection:Disconnect()
                end
            end
    
            local ElemIdx = table.find(Library.DraggableElements, Label)
            if ElemIdx then
                table.remove(Library.DraggableElements, ElemIdx)
            end
    
            if Label then
                Label:Destroy()
            end
        end
    
        return DraggableLabel
    end
    
