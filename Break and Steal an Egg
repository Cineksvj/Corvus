	function N.roundTripSpeed(walkSpeed)
		local mode = N.moveMode()
		if mode == "Walk" then
			return walkSpeed * 0.97
		end
		local carry = walkSpeed * N.fastBoost(true) / 100
		if N.emptyTeleport() then
			return 2 * carry
		end
		local empty = walkSpeed * N.fastBoost(false) / 100
