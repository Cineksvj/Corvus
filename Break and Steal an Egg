				local color = N.rarityColor(info.rarity)
				add(
					info.model,
					part,
					string.format(
						'<font color="%s"><b>%s %s</b></font>\n<font size="11">%s%s kg  \u{00B7}  %ds left</font>',
						color,
						info.rarity,
						info.name,
						if N.isMutated(info) then tostring(info.mutation) .. "  \u{00B7}  " else "",
						formatNumber(info.kg),
						math.max(math.floor(info.left), 0)
					),
					color,
					info.model
				)
			end
		end
