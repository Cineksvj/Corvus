						end
						return true
					end
					if not carriedOnHit then
						N.burstReject(why)
						setStatus("Instant steal: the guard drops the animal here, walking home from now on")
						F.carryZone, F.carryValue = nil, nil
						N.recoverDrop(carriedName)
						return true
					end
					if held then
						why = if N.Moves.acAt >= N.Dash.lastAt then "anti-cheat line" else "not banked in 3 s"
					end
					if why == "anti-cheat line" or why == "pulled back" or why == "not banked in 3 s" then
						N.burstReject(why)
						setStatus("Instant steal refused by the server, walking home")
					end
					if not N.carrying() then
						return true
					end
