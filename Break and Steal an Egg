-- after that the player's own choice sticks. Marked by a file so it never runs twice; the autoload config is saved with
-- the reset values, otherwise it would bring the risky values back on the next start.
do
	local FLAG = "Corvus/BSE_safe_walk_reset_v1.txt"
	function N.safeWalkMigration()
		if type(isfile) == "function" and isfile(FLAG) then
			return false
		end
		local reset = {}
		local function setSafe(group, name, safe)
			local item = group[name]
			if item and item.Value ~= safe then
				table.insert(reset, name .. "=" .. tostring(item.Value))
				pcall(item.SetValue, item, safe)
			end
		end
		setSafe(Options, "MoveMode", "Walk")
		setSafe(Options, "EggTravel", "Walk to eggs")
		setSafe(Toggles, "TravelNoclip", false)
		setSafe(Toggles, "TeleportSpeedCheck", false)
		setSafe(Toggles, "FallRescue", false)
		if type(writefile) == "function" then
			pcall(writefile, FLAG, "done")
		end
		if #reset > 0 then
			log("MIGRATE safe walking: reset " .. table.concat(reset, ", "))
			notify("Movement", "Risky movement options were reset to safe walking. You can turn them on again under Risky movement (ban risk).", 10)
			pcall(function()
				local name = SaveManager:GetAutoloadConfig()
				if type(name) == "string" and name ~= "" then
					SaveManager:Save(name)
				end
			end)
		end
		return true
	end
	task.delay(4, N.safeWalkMigration)
end
