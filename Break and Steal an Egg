                    ZIndex = 104,
                })
                lx = 60
            end
            new("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -lx, 1, 0),
                Position = UDim2.new(0, lx, 0, 0),
                RichText = tag ~= nil,
                Text = tag and (label .. ' <font color="#' .. (Colors.muted or Colors.Smoke):ToHex() .. '">' .. tostring(tag) .. "</font>") or label,
                TextColor3 = readableOn(col) or (self:_isSelected(v) and Colors.Moon or Colors.Ink),
                FontFace = Fonts.SansMed,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = opt,
                ZIndex = 104,
