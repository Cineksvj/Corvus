		return out
	end
	function N.hwEventOn(key)
		return N.hwActive()[key] ~= nil
	end
	local function bagEvent()
		local active = N.hwActive()
		return active.CandyHeist ~= nil or active.BloodMoon ~= nil
	end
	-- The zone a door or pile stands in: its own attribute, a "Zone<n>" ancestor, else the nearest zone model.
	local function zoneOf(part)
		local zone = N.zoneIndexOf(part:GetAttribute("ZoneIndex") or part:GetAttribute("Zone"))
		local node = part.Parent
		while node and node ~= workspace and not zone do
			zone = N.zoneIndexOf(node:GetAttribute("ZoneIndex") or node:GetAttribute("Zone")) or tonumber(string.match(node.Name, "^Zone_?(%d+)$"))
			node = node.Parent
		end
		if zone then
			return zone
		end
		local best, bestD
		for index in pairs(N.Cat.zones) do
			local zm = N.zoneModel(index)
			local ok, pivot = pcall(function()
				return zm:GetPivot().Position
			end)
			if ok and pivot then
				local d = flat(pivot, part.Position)
				if not bestD or d < bestD then
					best, bestD = index, d
				end
			end
		end
		return best or 1
	end
	local function pileMultiplier(part)
		for _, variant in ipairs(N.tableOr(cfg("CandyHeist").PileVariants)) do
			if type(variant) == "table" and variant.Name == part.Name then
				return tonumber(variant.CandyMultiplier) or 1
			end
		end
		return 1
	end
	-- Expected candy of one target: doors pay CandyCornByZone x TreatChance (the candy outcome weighs 60 % of the treats,
	-- the potions are worth as much again), piles pay PileCandyByZone x variant x the bag tier.
	local function candyValue(info)
		local zone = info.zone
		if info.kind == "door" then
			local byZone = N.tableOr(N.tableOr(HW.Rewards).CandyCornByZone)
			local base = tonumber(byZone[math.clamp(zone, 1, math.max(#byZone, 1))]) or 8
			return base * (tonumber(cfg("TrickOrTreat").TreatChance) or 0.5)
		end
		local byZone = N.tableOr(cfg("CandyHeist").PileCandyByZone)
		local base = tonumber(byZone[math.clamp(zone, 1, math.max(#byZone, 1))]) or 2
		local tier = 1
		local bag = N.candyBag()
		for _, t in ipairs(N.tableOr(cfg("CandyHeist").Tiers)) do
			if type(t) == "table" and (tonumber(t.At) or 0) <= bag then
				tier = tonumber(t.Multiplier) or tier
			end
		end
		return base * info.mult * tier
	end
	local function live(part)
		return part ~= nil and part.Parent ~= nil and part:IsA("BasePart") and not part:GetAttribute("Broken") and not part:GetAttribute("Hatching") and not part:GetAttribute("Despawning")
	end
	local function targetInfo(part, kind)
		if not live(part) then
			return nil
		end
		local hp = tonumber(part:GetAttribute("Health")) or tonumber(part:GetAttribute("MaxHealth")) or 1
		local info = {
			part = part,
			kind = kind,
			zone = zoneOf(part),
			hp = hp,
			max = tonumber(part:GetAttribute("MaxHealth")) or hp,
			hits = math.ceil(hp / N.damage()),
			position = part.Position,
			radius = N.radiusOf(part),
			mult = if kind == "pile" then pileMultiplier(part) else 1,
		}
		info.candy = candyValue(info)
		return info
	end
	-- Every door (House of Horrors) and pile (Candy Carnage / Blood Moon) of the running events that the player's speed
	-- can escape, scored by candy per second (hits at the swing gap plus the walk).
	function N.hwTargets()
		local active = N.hwActive()
		local list = {}
		local root = rootPart()
		local speed = math.max(N.modeSpeed(), 16)
		local function add(part, kind)
			if (H.failed[part] or 0) > os.clock() then
				return
			end
			local ok, info = pcall(targetInfo, part, kind)
			if not (ok and info) then
				return
			end
			if not N.canEscape(info.zone) then
				return
			end
			local walk = if root then flat(root.Position, info.position) / speed else 0
			info.seconds = info.hits * N.swingGap() * N.hitFactor() + walk + 1
			info.score = info.candy / info.seconds
			table.insert(list, info)
		end
		if active.TrickOrTreat then
			for _, part in ipairs(N.tagged(cfg("TrickOrTreat").Tag or "BreakableHalloweenDoor")) do
				add(part, "door")
			end
		end
		if active.CandyHeist or active.BloodMoon then
			for _, part in ipairs(N.tagged(cfg("CandyHeist").PileTag or "BreakableCandyPile")) do
				add(part, "pile")
			end
		end
		table.sort(list, function(a, b)
			return a.score > b.score
		end)
		return list
	end
	-- A Pumpkin King boss chasing this player (Blood Moon): TargetUserId on the boss model (PumpkinKingController
	-- checkContact 23137).
	function N.hwChased()
		for _, model in ipairs(N.tagged(cfg("BloodMoon").Pumpkin and cfg("BloodMoon").Pumpkin.Tag or "BloodMoonPumpkinKing")) do
			if model.Parent and model:GetAttribute("TargetUserId") == LocalPlayer.UserId then
				return model
			end
		end
		return nil
	end
	-- The bag is banked at the plot when it is nearly full (the server drops what does not fit), at 150 during the Blood
	-- Moon (a boss contact spills up to 60 % of it) and at once when a boss hunts the player.
	function N.hwBankDue()
		local bag = N.candyBag()
		if bag <= 0 or not bagEvent() then
			return false
		end
		if N.hwChased() then
			return true
		end
		local limit = if N.hwEventOn("BloodMoon") then 150 else math.floor(bagCapacity() * 0.9)
		return bag >= limit
	end
	local function bank()
		local bag, candy0 = N.candyBag(), N.candy()
		H.chased = N.hwChased() ~= nil
		log(string.format("HALLOWEEN bank going home bag=%d candy=%d%s", bag, candy0, if H.chased then " (a Pumpkin King is chasing)" else ""))
		if not N.goHome("Banking " .. bag .. " candy at the plot") then
			H.bankAt = os.clock() + 20
			return true
		end
		local banked = waitFor(function()
			return N.candyBag() < bag
		end, 4)
		local gain = N.candy() - candy0
		if banked then
			H.banked += 1
			H.bankedCandy += math.max(gain, 0)
			log(string.format("HALLOWEEN banked +%d candy (bag %d -> %d, candy %d)", gain, bag, N.candyBag(), N.candy()))
			if not H.probe.bank then
				H.probe.bank = true
				log(string.format("PROBE candy_heist_bank result=%s gain=+%d", if gain > 0 then "accepted" else "rejected", gain))
			end
		else
			H.bankAt = os.clock() + 15
			log(string.format("HALLOWEEN bank FAILED answer=bag %d -> %d at the plot (next try in 15 s)", bag, N.candyBag()))
		end
		return true
	end
	-- Breaks one door or pile: walks next to it, pickaxe out, hits at the swing gap until it breaks (same remote and pace
	-- as the eggs), then stays a moment so the game's own pickup collects the candy.
	local function breakTarget(info)
		local part = info.part
		local root = rootPart()
		local stand = info.position + Vector3.new(info.radius + 3, 0, 0)
		if root then
			local dir = Vector3.new(root.Position.X - info.position.X, 0, root.Position.Z - info.position.Z)
			if dir.Magnitude > 0.5 then
				stand = info.position + dir.Unit * (info.radius + 3)
			end
		end
		stand = N.standAt(stand, -12)
		local what = if info.kind == "door" then "haunted house" else "candy pile"
		setStatus(string.format("Halloween: going to a %s in zone %d (%d hits)", what, info.zone, info.hits))
		local keep = function()
			return live(part) and on("AutoHalloween") and not N.carrying()
		end
		if not N.travelTo(stand, { keepGoing = keep, look = info.position }) then
			if live(part) then
				H.failed[part] = os.clock() + 20
			end
			return false
		end
		if not N.equipPickaxe() then
			setStatus("Halloween: waiting for your pickaxe")
			task.wait(0.5)
			return false
		end
		N.holdAt(stand, 2)
		task.wait(N.hitSettle())
		local candy0 = N.candy() + N.candyBag()
		local hits, started = 0, os.clock()
		local budget = info.hits * 1.5 + 20
		local lastHp, progressAt = tonumber(part:GetAttribute("Health")) or math.huge, os.clock()
		while live(part) and on("AutoHalloween") and alive() and not N.carrying() and not N.flung() do
			local hpNow = tonumber(part:GetAttribute("Health")) or lastHp
			if hpNow < lastHp then
				lastHp, progressAt = hpNow, os.clock()
			end
			if os.clock() - progressAt > 10 or os.clock() - started > budget then
				log(string.format("HALLOWEEN gave up on the %s after %d hits", what, hits))
				H.failed[part] = os.clock() + 30
				break
			end
			if info.kind == "pile" and N.hwBankDue() then
				break
			end
			local wait = (N.Farm.backoffUntil or 0) - os.clock()
			if wait > 0 then
				task.wait(wait)
			end
			local here = rootPart()
			if not here then
				break
			end
			if math.max(flat(here.Position, part.Position) - info.radius, 0) > 6.5 then
				N.holdAt(nil)
				N.travelTo(stand, { keepGoing = keep, look = info.position })
				N.holdAt(stand, 2)
				task.wait(N.hitSettle())
			end
			local c = character()
			if not (c and c:FindFirstChild("Pickaxe")) then
				if not N.equipPickaxe() then
					break
				end
				task.wait(N.hitSettle())
			end
			N.Farm.hitId = (N.Farm.hitId or 0) + 1
			fire("EggHitRequest", part, N.Farm.hitId)
			N.Farm.lastHitAt = os.clock()
			hits += 1
			H.hits += 1
			setStatus(string.format("Halloween: breaking a %s  %s / %s HP", what, formatNumber(tonumber(part:GetAttribute("Health")) or 0), formatNumber(info.max)))
			task.wait(N.hitPace())
		end
		N.holdAt(nil)
		if hits > 0 and (part:GetAttribute("Broken") or part.Parent == nil or (tonumber(part:GetAttribute("Health")) or 1) <= 0) then
			H.broken += 1
			-- the candy pops 0.5 s after the break and flies to the player within 10 studs (CandyDrops CollectionDelay,
			-- CollectRadius): stay for it
			local gained = waitFor(function()
				return N.candy() + N.candyBag() > candy0
			end, 2.5)
			local gain = N.candy() + N.candyBag() - candy0
			log(string.format("HALLOWEEN %s broken zone %d hits %d candy %s", what, info.zone, hits, if gained then "+" .. gain else "+0 (a potion or a trick)"))
			if info.kind == "door" and not H.probe.door then
				H.probe.door = true
				log(string.format("PROBE trick_or_treat_door result=%s gain=+%d", if gained then "accepted" else "rejected", math.max(gain, 0)))
			end
		end
		return true
	end
	function N.hwStatusText()
		local active = N.hwActive()
		local names = {}
		local labels = N.tableOr(cfg("Schedule").Labels)
		for key, endsAt in pairs(active) do
			table.insert(names, string.format("%s (%s left)", tostring(labels[key] or key), clockText(math.max(endsAt - N.serverNow(), 0))))
		end
		table.sort(names)
		if #names == 0 then
			return string.format("no Halloween event running (every 30 min), %d candy", N.candy())
		end
		return string.format("%s, bag %d/%d, %d candy", table.concat(names, " + "), N.candyBag(), bagCapacity(), N.candy())
	end
	-- One slice of Halloween work for the main loop: bank first, then the best door or pile. False = nothing to do now.
	function N.halloweenStep()
		if not on("AutoHalloween") or N.carrying() then
			return false
		end
		if H.candyStart == nil then
			H.candyStart = N.candy()
		end
		if N.hwBankDue() and os.clock() >= H.bankAt then
			return bank()
		end
		local targets = N.hwTargets()
		local pick = targets[1]
		if not pick then
			-- the bag keeps its candy after the event: bank what is left at the plot (CashoutGrace 60 s)
			if N.candyBag() > 0 and not bagEvent() and os.clock() >= H.bankAt then
				return bank()
			end
			H.status = N.hwStatusText()
			if os.clock() - H.lastLog > 300 then
				H.lastLog = os.clock()
				log("HALLOWEEN idle " .. H.status)
			end
			return false
		end
		H.status = string.format("%d targets, best %s in zone %d worth %.0f candy", #targets, pick.kind, pick.zone, pick.candy)
		return breakTarget(pick)
	end

	-- ===== Halloween shop: Candy Corn buys the 15 minute potion worth the most cash per candy (N.Plan.potionValue, the
	-- same value model the Fallen Token shop used), only when that potion is not running and its card has stock.
	N.HalloweenPotions = {}
	do
		for card, potion in pairs(N.tableOr(N.G.HalloweenShop.Potions)) do
			if type(potion) == "table" and type(potion.PotionId) == "string" and tonumber(potion.Price) then
				table.insert(N.HalloweenPotions, { card = card, id = potion.PotionId, price = tonumber(potion.Price) })
			end
		end
		table.sort(N.HalloweenPotions, function(a, b)
			return a.price < b.price
		end)
	end
	local function potionNeeded(id)
		if id ~= "EggGrowth" then
			return true
		end
		for _, egg in ipairs(N.tagged("MergeEggPlaced")) do
			if egg:GetAttribute("OwnerUserId") == LocalPlayer.UserId and not N.eggGrown(egg) then
				return true
			end
		end
		return false
	end
	function N.hwStock(card)
		local prefix = N.tableOr(N.G.HalloweenShop.Stock).AttributePrefix or "HalloweenStock_"
		return tonumber(LocalPlayer:GetAttribute(prefix .. card))
	end
	function N.halloweenShopStep()
		if not on("AutoHalloweenShop") or (N.Shop.lastAt.halloween or 0) > os.clock() then
			return false
		end
		local candy = N.candy()
		if candy <= 0 then
			return false
		end
		local now = N.serverNow()
		local best, bestScore
		for _, potion in ipairs(N.HalloweenPotions) do
			local stock = N.hwStock(potion.card)
			if candy >= potion.price and (stock == nil or stock > 0) and potionNeeded(potion.id) and os.clock() - (H.shopAt[potion.id] or -1e9) > 30 then
				local ends = tonumber(LocalPlayer:GetAttribute("PotionEndsAt_" .. potion.id)) or 0
				if ends <= now + 20 then
					local ok, value = pcall(N.Plan.potionValue, potion.id)
					local score = (if ok and type(value) == "number" then value else 0) / potion.price
					if score > 0 and (not bestScore or score > bestScore) then
						best, bestScore = potion, score
					end
				end
			end
		end
		if not best then
			return false
		end
		H.shopAt[best.id] = os.clock()
		if not N.buyIntent("HalloweenShopRequest", best.id .. " potion", best.price, nil) then
			return false
		end
		local endsBefore = tonumber(LocalPlayer:GetAttribute("PotionEndsAt_" .. best.id)) or 0
		local ok, answer = invoke("HalloweenShopRequest", 5, "BuyPotion", best.card)
		local paid = waitFor(function()
			return N.candy() <= candy - best.price
		end, 3)
		local after = N.candy()
		if not (ok and answer == true and paid) then
			H.shopFailed += 1
			N.Shop.lastAt.halloween = os.clock() + 600
			log(string.format("HALLOWEEN shop %s potion FAILED answer=%s candy %d -> %d, next try in 10 min", best.id, tostring(answer), candy, after))
			return true
		end
		H.shopBought += 1
		waitFor(function()
			return (tonumber(LocalPlayer:GetAttribute("PotionEndsAt_" .. best.id)) or 0) > endsBefore
		end, 1.5)
		local ends = tonumber(LocalPlayer:GetAttribute("PotionEndsAt_" .. best.id)) or 0
		N.shopNote(string.format("Candy Corn: %s potion (worth $%s per candy)", best.id, formatNumber(math.floor(bestScore))))
		log(string.format("HALLOWEEN shop %s potion bought ok value=$%s per candy candy %d -> %d, runs %s more", best.id, formatNumber(math.floor(bestScore)), candy, after, N.longTime(math.max(ends - math.max(endsBefore, N.serverNow()), 0))))
		return true
	end
end
-- Merge Pets (MergeMachineRemote("Merge", {a, b, c}), MergeMachineController 31861-31893, decompiled 1352 client): three
-- owned animals of the SAME species (AnimalTool in Backpack/Character or a model in your own PlacedAnimals, candidateOwned
-- 30909) become one "<Animal> Egg" (answer OnClientEvent("Merged", animal, _, variant) 32009). The client shows the outcome
-- as the same species with WeightKg = the sum (31277-31282); variant odds = the Diamond share, then the Gold share of the
-- inputs (MergeConfig.VariantOdds 89879). Cash per animal grows faster than linear with weight (EggRewards
-- CashWeightMult = ratio^1.10..1.29 up to ratio 8, PlacedCashPerSecond 87692), so one merged animal earns +12..37 % more
-- than the three apart and frees two plot slots. Irreversible: own toggle only (OWNER_RULES 20/21), never the planner
-- alone; never Secret, locked, held, protected (Keep Mutated, Never Sell), never mutated inputs (the merged mutation is
-- unknown), placed ones only with "Also Use Placed Animals". The real weight/mutation is measured after the hatch
-- (MERGE result) and a lighter result than the sum lowers the model (kgFactor). Probe: merge_range (merge from where
-- the hub stands, else walk to workspace.EggMachine), remembered per PlaceVersion.
N.MergePets = { nextAt = 0, merged = 0, status = "-", offUntil = 0, pending = {}, event = nil, said = {}, probed = false, kgFactor = 1, results = 0 }
do
	local Z = N.MergePets
	local function say(key, text, every)
		local last = Z.said[key]
		if last and last.text == text and os.clock() - last.at < (every or 300) then
			return
		end
		Z.said[key] = { text = text, at = os.clock() }
		log(text)
	end
	N.onRemote("MergeMachineRemote", function(kind, animal, _, variant)
		if kind == "Merged" and type(animal) == "string" then
			Z.event = { at = os.clock(), animal = animal, variant = variant }
			log("MERGE merged event", animal, tostring(variant))
		end
	end)
	-- MergeConfig.GrowthSeconds (89914): 10 s x (kg/150)^0.88 above the pivot x rarity mult, capped at 7 days.
	function N.mergeGrowSeconds(kg, rarity)
		local M = N.G.Merge
		local base = tonumber(M.BaseGrowthSeconds) or 10
		local pivot = tonumber(M.GrowthKgPivot) or 150
		local expo = tonumber(M.GrowthKgExponent) or 0.88
		local cap = tonumber(M.MaxGrowthSeconds) or 604800
		local mults = type(M.GrowthRarityMultipliers) == "table" and M.GrowthRarityMultipliers or {}
		local scale = if kg > pivot then (kg / pivot) ^ expo else 1
		return math.min(base * scale * (tonumber(mults[rarity]) or 1), cap)
	end
	-- MergeConfig.VariantOdds: share of Diamond inputs, then of Gold inputs among the rest; the remainder keeps no variant.
	function N.mergeVariantOdds(variants)
		local odds, left = {}, 1
		local seen = 0
		for _, tier in ipairs({ "Diamond", "Gold" }) do
			for i = 1, 3 do
				if variants[i] == tier then
					seen += 1
				end
			end
			local p = left * math.min(seen / 3, 1)
			if p > 0 then
				odds[tier] = p
				left -= p
			end
		end
		return odds, math.max(left, 0)
	end
	-- Expected $/s of the merged animal: same species, kg = sum (x the measured kgFactor), variant by the odds.
	function N.mergedCash(name, parts)
		local kg, variants = 0, {}
		for i, part in ipairs(parts) do
			kg += tonumber(part.kg) or 0
			variants[i] = part.variant
		end
		local raw = kg
		kg *= Z.kgFactor
		local odds, none = N.mergeVariantOdds(variants)
		local cash = none * N.cashValue({ name = name, kg = kg })
		for tier, p in pairs(odds) do
			cash += p * N.cashValue({ name = name, kg = kg, variant = tier })
		end
		return cash, kg, raw
	end
	-- The best triple: per species the three weakest allowed copies; gain = merged value - parts - income lost while the
	-- egg grows. Only gains > 0.
	function N.mergePlan()
		local groups = {}
		for _, entry in ipairs(N.ownAnimals(on("ConsumePlaced"))) do
			if entry.mutation == nil and not N.consumeExcluded(entry, false) and (tonumber(entry.kg) or 0) > 0 then
				groups[entry.name] = groups[entry.name] or {}
				table.insert(groups[entry.name], entry)
			end
		end
		local H = N.Plan.Horizon or 86400
		local best, why = nil, "no species with three free copies"
		for name, list in pairs(groups) do
			if #list >= 3 then
				table.sort(list, function(a, b)
					return a.cash < b.cash
				end)
				local parts = { list[1], list[2], list[3] }
				local merged, kg, raw = N.mergedCash(name, parts)
				local partCash, cost, anyPlaced = 0, 0, false
				for _, part in ipairs(parts) do
					partCash += part.cash
					cost += N.consumeCost(part)
					anyPlaced = anyPlaced or part.placed == true
				end
				local grow = N.mergeGrowSeconds(kg, parts[1].rarity)
				local value = (if anyPlaced then merged * H else N.keepValue(merged)) - merged * grow
				-- a growing egg that takes a plot slot (PROBE egg_slot) keeps the weakest animal off the plot meanwhile
				if N.ProbeMem.get("egg_slot") == "takes" then
					value -= N.worstPlaced() * grow
				end
				local gain = value - cost
				if gain > 0 and (not best or gain > best.gain) then
					best = { name = name, parts = parts, merged = merged, kg = kg, raw = raw, partCash = partCash, grow = grow, gain = gain, value = value, cost = cost }
				elseif gain <= 0 and not best then
					why = string.format("%s x3 not worth it ($%s/s merged vs $%s/s apart)", N.displayName(name), formatNumber(math.floor(merged)), formatNumber(math.floor(partCash)))
				end
			end
		end
		return best, why
	end
	local function snapshot(name)
		local seen = setmetatable({}, { __mode = "k" })
		for _, entry in ipairs(N.ownAnimals(true)) do
			if entry.name == name then
				seen[entry.inst] = true
			end
		end
		return seen
	end
	-- After a merge egg of that species hatches, the new animal is read and compared with the model (MERGE result).
	function Z.checkResults()
		for name, pend in pairs(Z.pending) do
			if os.clock() - pend.at > 86400 then
				Z.pending[name] = nil
			else
				for _, entry in ipairs(N.ownAnimals(true)) do
					if entry.name == name and not pend.seen[entry.inst] then
						Z.pending[name] = nil
						Z.results += 1
						local kg = tonumber(entry.kg) or 0
						if pend.raw > 0 and kg > 0 then
							Z.kgFactor = math.clamp(kg / pend.raw, 0.5, 1.5)
						end
						log(string.format("MERGE result=%s kg=%s expected=%s mut=%s variant=%s cash=$%s/s expected=$%s/s", name, tostring(math.floor(kg * 100) / 100), tostring(math.floor(pend.raw * 100) / 100), tostring(entry.mutation), tostring(entry.variant), formatNumber(math.floor(entry.cash or 0)), formatNumber(math.floor(pend.cash))))
