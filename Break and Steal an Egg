-- Highest zone the current speed opens (no planner), used for the zone unlock events.
-- With a ZonePick active the loop is restricted to the picked zones; nothing picked and open falls back to zone 1.
function N.topZone()
	local power = N.power()
	local pickActive = N.zonePickActive()
	-- Owner 2026-10-20 bug: ZonePick=Mountains without enough power used to fall through
	-- to zone 1 (silent). The pick is the player's intent: honour it. If every picked zone
	-- is above power, return the highest ticked one and let the hub travel; guards may
	-- catch (that is the player's call), AntiCheat traps are already handled elsewhere.
	if pickActive then
		local topPick = N.topPickedZone()
		if topPick and power >= (N.Cat.zones[topPick] and N.Cat.zones[topPick].power or 0) then
			return topPick
		end
		-- Walk down the picks: highest ticked zone whose power is open.
		local best
		for index = #N.Cat.zones, 1, -1 do
			local zone = N.Cat.zones[index]
			if zone and N.zonePickHas(index) and not N.zonePenalized(index) and power >= zone.power then
				best = index
				break
			end
		end
		-- None open: still return the highest picked (user intent wins over the fallback-to-1).
		return best or topPick or 1
	end
	local best = 1
	for index, zone in ipairs(N.Cat.zones) do
		if power >= zone.power and not N.zonePenalized(index) and N.underCap(index) then
			best = index
		end
	end
	return best
end
function N.nextZone()
	local power = N.power()
	for _, zone in ipairs(N.Cat.zones) do
		if power < zone.power then
			return zone
		end
	end
	return nil
end
