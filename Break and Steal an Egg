				end
				if type(Library.CorvusLog) == "function" then pcall(Library.CorvusLog, Library, string.format("HUB resized %dx%d", main.Size.X.Offset, main.Size.Y.Offset)) end
			end
		end))
		main:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() pcall(window._updateNarrow, window) end)
		window.ResizeGrip = grip
	end
	task.defer(function()
		if type(Library.GetSetting) == "function" then
