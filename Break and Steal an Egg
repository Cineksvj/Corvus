				"<b>%s</b> now: x%s cash%s, ends in %s",
				w.name,
				multText(w.mult),
				if w.mutation then ", hatched animals can come out " .. tostring(w.mutation) else "",
				N.longTime(w.left)
			)
		end
		return string.format("Next: <b>%s</b> (x%s cash) in %s", w.name, multText(w.mult), N.longTime(w.left))
	end
