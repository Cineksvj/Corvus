	-- Discord report 2026-11-03 (ucupp, mobile): with Steal on the character glided off the plot through the side wall,
	-- out over the void, fell and was put back home (FallRescue), again and again. A straight line from a far plot to a
	-- zone can cross open sky; the old plan sank a point with no ground under it to a linear Y. Now: a point with no
	-- ground keeps the higher of the two ends (never below the ground it left), and when the straight line crosses a
	-- gap while the start stands on real ground, the trip goes through the nearest grounded anchor (SafeZone, plot, a
	-- zone hitbox) whose two halves both have ground. N.groundAt is used so the tests can stand in for the raycast.
	local function legPoints(from, to, out)
		local distance = flat(from, to)
		local legs = math.clamp(math.floor(distance / 80), 1, 60)
		local gaps = 0
		for i = 1, legs - 1 do
			local t = i / legs
			local x, z = from.X + (to.X - from.X) * t, from.Z + (to.Z - from.Z) * t
			local y = N.groundAt(x, z, math.max(from.Y, to.Y) + 40)
			if y then
				table.insert(out, Vector3.new(x, y + N.standHeight(), z))
			else
				gaps += 1
				table.insert(out, Vector3.new(x, math.max(from.Y, to.Y), z))
			end
