local function isTouch()
    -- the window decides once (Library.Touch in CreateWindow): a phone, or a viewport under 900 px
    local t = rawget(Library, "Touch")
    if t ~= nil then return t == true end
    local ok, mobile = pcall(function() return UserInputService.TouchEnabled and not UserInputService.MouseEnabled end)
    if ok and mobile then return true end
    local cam = workspace.CurrentCamera
    if cam and cam.ViewportSize.X < 900 then return true end
    return false
end
-- touch sizes: T(desktop, touch). Rows 36 px+, labels 12 px+ (DONE v2 cond. 1)
local function T(desk, touch)
    if isTouch() then return touch end
    return desk
end

-- ---------------------------------------------------------------- inst helper
local function new(class, props, children)
    local inst = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            if k ~= "Parent" then inst[k] = v end
        end
    end
    if children then
        for _, c in ipairs(children) do c.Parent = inst end
    end
    if props and props.Parent then inst.Parent = props.Parent end
    return inst
end
Library.New = Library.New or new

local function corner(radius, parent)
    return new("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function stroke(parent, color, thickness, transparency, mode)
    return new("UIStroke", {
        Color = color or Colors.Outline,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Border,
        LineJoinMode = Enum.LineJoinMode.Round,
        Parent = parent,
    })
end

local function padding(parent, l, r, t, b)
    t = t or l; r = r or l; b = b or t
    return new("UIPadding", {
        PaddingLeft = UDim.new(0, l),
        PaddingRight = UDim.new(0, r),
        PaddingTop = UDim.new(0, t),
        PaddingBottom = UDim.new(0, b),
        Parent = parent,
    })
end

local function listLayout(parent, dir, pad, horz, vert)
