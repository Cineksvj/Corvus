				R.pend.group = nil
				log(string.format("GROUP claim FAILED step=%s answer=%s (%s)", p.stage, if (R.at.group or -1e9) >= p.at then "the State is unchanged" else "no State reply", R.noteSince(p.at)))
				R.nextAt.group = os.clock() + 300
			end
			return false
		end
		local g = R.st.group
		if not g then
			ask("groupGet", 60, function()
				fire("GroupRewardRemote", "Get")
			end)
			return false
		end
		if g.claimed then
			sayOnce("group", "GROUP reward already claimed", 1e9)
			return false
		end
		if not g.inGroup then
			sayOnce("group", string.format("GROUP not claimable: the reward (+%s speed) needs the game's group (id %s), join it once and Corvus claims it", formatNumber(tonumber(N.G.Group.RewardSpeed) or 10000), tostring(N.G.Group.GroupId or "?")), 3600)
