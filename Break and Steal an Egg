	function N.sessionCard()
		local elapsed = math.max(os.clock() - Session.started, 1)
		local gained = N.cash() - Session.cashStart
		local perHour = math.max(gained, 0) / (elapsed / 3600)
		local lines = {
			"**Corvus** \194\183 " .. GameName,
			string.format("Session %dh %02dm \194\183 %s$%s (%s$%s/h)", elapsed // 3600, (elapsed % 3600) // 60,
				if gained >= 0 then "+" else "-", formatNumber(math.abs(gained)), "+", formatNumber(perHour)),
			string.format("Eggs %s \194\183 grabbed %s \194\183 banked %s \194\183 sold %s ($%s)",
				formatNumber(Session.eggs), formatNumber(Session.stolen), formatNumber(Session.banked), formatNumber(Session.sold), formatNumber(Session.soldCash)),
			string.format("Diamonds %s (%s%s this session)", formatNumber(N.diamonds()), if N.diamondsGained() >= 0 then "+" else "-", formatNumber(math.abs(N.diamondsGained()))),
			"Best grab: " .. tostring(Session.best or "none yet"),
		}
		return table.concat(lines, "\n")
	end
