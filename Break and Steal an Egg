			local root = rootPart()
			if guard and target and root then
				local from = root.Position
				setStatus(string.format("Instant steal: %d animal%s, taking the guard's hit", carried, if carried == 1 then "" else "s"))
				F.rideArmed = os.clock()
				local caughtBefore = Session.caught
				N.travelTo(N.standAt(guard.position), { keepGoing = function()
					return Session.caught == caughtBefore and N.carrying()
				end })
				local hit = waitFor(function()
					return Session.caught > caughtBefore or not N.carrying()
				end, 6)
				F.rideArmed = nil
				local why = nil
				-- Live 2026-11-02 (alt, Chicken, zone 1): Carrying is cleared the moment the guard touches you, 0.6 s before the
				-- "fling" remote - the server strips the carry on contact, nothing to ride home with.
				if Session.caught == caughtBefore and not N.carrying() then
					local at = rootPart()
					log(string.format("STEAL instant guard=%s touched=%s carried=no banked=none (the guard's touch dropped the animal before the fling)", tostring(guard.name), if at then brief(at.Position) else "?"))
					caughtStart = Session.caught + 1
					N.burstReject("the guard's touch dropped the animal")
					setStatus("Instant steal: the guard drops the animal here, walking home from now on")
					F.carryZone, F.carryValue = nil, nil
					waitFor(function()
						return Session.caught > caughtBefore
					end, 3)
					N.recoverDrop(carriedName)
					return true
				end
				if Session.caught > caughtBefore then
					local caughtPos = rootPart() and rootPart().Position or from
					task.wait(0.3)
					local carriedOnHit = N.carrying()
					local held = false
					if carriedOnHit then
						held, why = N.burstTo(target)
					else
						why = "the hit dropped the animal"
					end
					local now = rootPart()
					local landedAt = if now then brief(now.Position) else "?"
					local banked = carriedOnHit and held and waitFor(function()
						return not N.carrying()
					end, 3)
					caughtStart = Session.caught
					log(string.format("STEAL instant guard=%s caught=%s landed=%s carried=%s banked=%s (%s)", tostring(guard.name), brief(caughtPos), landedAt, if carriedOnHit then "yes" else "no", if banked then tostring(carriedName) else "none", tostring(why)))
					if banked then
						Session.banked += carried
						N.Plan.observeTrip(tripZone, os.clock() - tripStart)
						F.placeWanted = true
