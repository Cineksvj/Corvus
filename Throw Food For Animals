-- Share-code stubs so hubs calling Library:ImportShareCode / Base64Encode do not crash.
if typeof(Library.Base64Encode) ~= "function" then
	local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	function Library.Base64Encode(data)
		if typeof(data) ~= "string" then return "" end
		local out = {}
		for i = 1, #data, 3 do
			local a, b, c = string.byte(data, i), string.byte(data, i + 1) or 0, string.byte(data, i + 2) or 0
			local n = a * 65536 + b * 256 + c
			table.insert(out, string.sub(alphabet, math.floor(n / 262144) + 1, math.floor(n / 262144) + 1))
			table.insert(out, string.sub(alphabet, math.floor(n / 4096) % 64 + 1, math.floor(n / 4096) % 64 + 1))
			table.insert(out, (i + 1 <= #data) and string.sub(alphabet, math.floor(n / 64) % 64 + 1, math.floor(n / 64) % 64 + 1) or "=")
			table.insert(out, (i + 2 <= #data) and string.sub(alphabet, n % 64 + 1, n % 64 + 1) or "=")
		end
		return table.concat(out)
	end
end
