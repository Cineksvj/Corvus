					return
				elseif io.KeyCode == Enum.KeyCode.Up then
					selected = math.clamp(selected - 1, 1, math.max(1, math.min(8, #(results or {}))))
					paintSelection()
					return
				elseif io.KeyCode == Enum.KeyCode.Escape then
					closePalette()
					return
				end
			end
			if gp then return end
			if io.KeyCode == Enum.KeyCode.K and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
				Library:OpenCommandPalette()
			elseif io.KeyCode == Enum.KeyCode.Slash and (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift))
				and not UserInputService:GetFocusedTextBox() and main.Visible then
				Library:ShowShortcuts()
			end
		end))
	end

	-- -------------------- Undo / redo  [unique feature 1]
	-- Every non-silent SetValue on a toggle / slider / input / dropdown / keybind pushes
	-- { ctrl, from, to }. Ctrl+Z reverts the last one (Ctrl+Shift+Z redoes). HistoryBatch(label, fn)
	-- folds everything fn changes into ONE entry (config load = one undo). Nothing fires on launch.
	do
		local undoStack, redoStack = {}, {}
		local MAX = 60
		local batch, applying = nil, false
		local function fmt(v)
			if type(v) == "table" then
				local keys = {}
				for k, on in pairs(v) do if on then table.insert(keys, tostring(k)) end end
				table.sort(keys)
				return #keys == 0 and "none" or table.concat(keys, ", ")
			elseif typeof(v) == "EnumItem" then
				return v.Name
			elseif typeof(v) == "Color3" then
				return "#" .. v:ToHex()
			elseif type(v) == "boolean" then
				return v and "on" or "off"
			elseif v == nil or v == "" then
				return "empty"
			end
			return tostring(v)
		end
		local function clone(v)
			if type(v) == "table" then
				local c = {}
				for k, x in pairs(v) do c[k] = x end
				return c
			end
			return v
		end
		local function changed()
			if type(rawget(Library, "_historyChanged")) == "function" then pcall(Library._historyChanged) end
		end
		local function commit(group)
			table.insert(undoStack, group)
			while #undoStack > MAX do table.remove(undoStack, 1) end
			table.clear(redoStack)
			changed()
		end
		rawset(Library, "_pushHistory", function(ctrl, from, to)
			if applying or type(ctrl) ~= "table" then return end
			local entry = {
				ctrl = ctrl, from = clone(from), to = clone(to),
				label = string.format("%s %s \226\134\146 %s", tostring(ctrl.Text ~= "" and ctrl.Text or ctrl.Idx or "?"), fmt(from), fmt(to)),
			}
			if batch then
				table.insert(batch.entries, entry)
				return
			end
			commit({ label = entry.label, entries = { entry } })
		end)
		function Library:HistoryBatch(label, fn)
			if batch then return fn() end
			batch = { label = tostring(label or "Change"), entries = {} }
			local ok, err = pcall(fn)
			local b = batch
			batch = nil
			if #b.entries > 0 then
				b.label = string.format("%s (%d change%s)", b.label, #b.entries, #b.entries == 1 and "" or "s")
				commit(b)
			end
			if not ok then error(err, 0) end
			return b
		end
		local function apply(group, backwards)
			applying = true
			local n = #group.entries
			local from, to, step = 1, n, 1
			if backwards then from, to, step = n, 1, -1 end
			for i = from, to, step do
				local e = group.entries[i]
				-- not `backwards and e.from or e.to`: a toggle's `from` is false, which would fall through
				local v = e.to
				if backwards then v = e.from end
				pcall(function()
					if type(e.ctrl.SetValue) == "function" then e.ctrl:SetValue(clone(v)) end
				end)
			end
			applying = false
		end
		function Library:Undo()
			local g = table.remove(undoStack)
			if not g then
				Library:Notify("Nothing to undo", 2)
				return false
			end
			apply(g, true)
			table.insert(redoStack, g)
			changed()
			Library:Notify("Undid " .. g.label, 3)
			if type(Library.CorvusLog) == "function" then pcall(Library.CorvusLog, Library, "UNDO " .. g.label) end
			return true
		end
		function Library:Redo()
			local g = table.remove(redoStack)
			if not g then
				Library:Notify("Nothing to redo", 2)
				return false
			end
			apply(g, false)
			table.insert(undoStack, g)
			changed()
			Library:Notify("Redid " .. g.label, 3)
			return true
		end
		function Library:HistoryCount() return #undoStack, #redoStack end
		function Library:HistoryLast() return undoStack[#undoStack] and undoStack[#undoStack].label or nil end
		Library.Commands = Library.Commands or {}
		Library.Commands["Undo last change"] = { Func = function() Library:Undo() end, Group = "history" }
		Library.Commands["Redo"] = { Func = function() Library:Redo() end, Group = "history" }
		Library:GiveSignal(UserInputService.InputBegan:Connect(function(io, gp)
			if gp or io.KeyCode ~= Enum.KeyCode.Z then return end
			if not (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then return end
			if UserInputService:GetFocusedTextBox() or not main.Visible then return end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) then
				Library:Redo()
			else
				Library:Undo()
			end
		end))
	end

	-- -------------------- Keyboard tab navigation (pass 6): Ctrl+Tab / Ctrl+Shift+Tab cycle the
	-- sidebar order (wraps), Ctrl+1..9 jump. Hidden tabs (entry not visible) are skipped.
	do
		local digits = {
			[Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3,
			[Enum.KeyCode.Four] = 4, [Enum.KeyCode.Five] = 5, [Enum.KeyCode.Six] = 6,
			[Enum.KeyCode.Seven] = 7, [Enum.KeyCode.Eight] = 8, [Enum.KeyCode.Nine] = 9,
		}
		local function navTabs()
			local list = {}
			for _, t in ipairs(window.TabOrder) do
				if type(t) == "table" and (not t.Entry or t.Entry.Visible) then table.insert(list, t) end
			end
			return list
		end
		Library:GiveSignal(UserInputService.InputBegan:Connect(function(io)
			if io.UserInputType ~= Enum.UserInputType.Keyboard then return end
			if not (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then return end
			if UserInputService:GetFocusedTextBox() or not main.Visible then return end
			local list = navTabs()
			if #list == 0 then return end
			local target
			if io.KeyCode == Enum.KeyCode.Tab then
				local cur = 1
				for i, t in ipairs(list) do if t == window.ActiveTab then cur = i break end end
				local back = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
				target = list[((cur - 1 + (back and -1 or 1)) % #list) + 1]
			elseif digits[io.KeyCode] then
				target = list[digits[io.KeyCode]]
			end
			if target and target ~= window.ActiveTab then pcall(window.SelectTab, window, target) end
		end))
	end

	-- -------------------- Logbook  [unique feature 3]
	-- Click the ticker: the last 240 tagged lines (Library.TickerHistory, fed by PushTicker)
	-- grouped by the minute, each minute a rule with its tag counts sitting on the line.
	do
		local drawer, list, countLabel
		local function build()
			if drawer then return end
			drawer = Library:New("Frame", {
				Name = "Logbook",
				Size = UDim2.new(0, 440, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Visible = false,
				ZIndex = 50,
				Parent = screenGui,
			})
			cardSkin(drawer, 6)
			do local sc = Instance.new("UIScale"); sc.Scale = Library.UIScale or 1; sc.Parent = drawer end
			Library:Padding(10, 12, 12, 12).Parent = drawer
			Library:List(Enum.FillDirection.Vertical, 8, "left").Parent = drawer
			local head = Library:New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 0, ZIndex = 51, Parent = drawer })
			Library:New("TextLabel", {
				BackgroundTransparency = 1,
				Size = UDim2.new(0.5, 0, 1, 0),
				Text = "Logbook",
				FontFace = Fonts.OswaldMed or Fonts.Inter,
				TextSize = 14,
				TextColor3 = Colors.text,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 52,
				Parent = head,
			})
			-- owner 2026-11-01 ("the logbook needs an obvious close"): an X at the right of the head
			local closeBtn = Library:New("TextButton", {
				Name = "Close",
				BackgroundColor3 = Colors.well,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.new(0, 20, 0, 20),
				Text = "\195\151",
				FontFace = Fonts.InterMed or Fonts.Inter,
				TextSize = 15,
				TextColor3 = Colors.muted,
				ZIndex = 53,
				Parent = head,
			})
			Library:Round(5).Parent = closeBtn
			closeBtn.MouseEnter:Connect(function() Library:NewTween(closeBtn, 0.1, { BackgroundTransparency = 0, TextColor3 = Colors.text }) end)
			closeBtn.MouseLeave:Connect(function() Library:NewTween(closeBtn, 0.12, { BackgroundTransparency = 1, TextColor3 = Colors.muted }) end)
			closeBtn.MouseButton1Click:Connect(function() drawer.Visible = false end)
			countLabel = Library:New("TextLabel", {
				Name = "Count",
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -26, 0, 0),
				Size = UDim2.new(0.5, -26, 1, 0),
				Text = "",
				FontFace = Fonts.InterMed or Fonts.Inter,
				TextSize = 10,
				TextColor3 = Colors.muted,
				TextXAlignment = Enum.TextXAlignment.Right,
				ZIndex = 52,
				Parent = head,
			})
			list = Library:New("ScrollingFrame", {
				Name = "List",
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 320),
				CanvasSize = UDim2.new(0, 0, 0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollBarThickness = 0,
				ScrollBarImageColor3 = Colors.hairlineStrong,
				LayoutOrder = 1,
				ZIndex = 51,
				Parent = drawer,
			})
			Library:List(Enum.FillDirection.Vertical, 2, "left").Parent = list
		end
		local function refresh()
			for _, c in ipairs(list:GetChildren()) do
				if c:IsA("GuiObject") then c:Destroy() end
			end
			local hist = rawget(Library, "TickerHistory") or {}
			local n, order, lastMin, shown = #hist, 0, nil, 0
			for i = n, 1, -1 do
				local it = hist[i]
				local clock = tostring(it.clock or "")
				local minute = clock:sub(1, 5)
				if minute ~= lastMin then
					lastMin = minute
					local counts, tagsInOrder = {}, {}
					for j = i, 1, -1 do
						local jt = hist[j]
						if tostring(jt.clock or ""):sub(1, 5) ~= minute then break end
						if not counts[jt.tag] then counts[jt.tag] = 0; table.insert(tagsInOrder, jt.tag) end
						counts[jt.tag] += 1
					end
					local parts = {}
					for _, tg in ipairs(tagsInOrder) do
						table.insert(parts, counts[tg] > 1 and (tg .. " x" .. counts[tg]) or tg)
					end
					order += 1
					local hrow = Library:New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = order, ZIndex = 52, Parent = list })
					Library:New("TextLabel", {
						BackgroundTransparency = 1,
						Size = UDim2.new(0, 44, 1, 0),
						Text = minute,
						FontFace = Fonts.OswaldMed or Fonts.Inter,
						TextSize = 13,
						TextColor3 = Colors.text,
						TextXAlignment = Enum.TextXAlignment.Left,
						ZIndex = 53,
						Parent = hrow,
					})
					Library:New("Frame", { BackgroundColor3 = Colors.hairline, BorderSizePixel = 0, Position = UDim2.new(0, 50, 0.5, 0), Size = UDim2.new(1, -50, 0, 1), ZIndex = 53, Parent = hrow })
					-- the counts sit ON the rule (panel-coloured background breaks the line)
					Library:New("TextLabel", {
						BackgroundColor3 = Colors.surface,
						BackgroundTransparency = 0,
						BorderSizePixel = 0,
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, 0, 0.5, 0),
						AutomaticSize = Enum.AutomaticSize.X,
						Size = UDim2.new(0, 0, 0, 14),
						Text = "  " .. table.concat(parts, "   ") .. "  ",
						FontFace = Fonts.InterMed or Fonts.Inter,
						TextSize = 10,
						TextColor3 = Colors.muted,
						TextXAlignment = Enum.TextXAlignment.Right,
						ZIndex = 54,
						Parent = hrow,
					})
				end
				order += 1
				local bad = it.tag == "PROBLEM" or it.tag == "ERROR"
				local row = Library:New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = order, ZIndex = 52, Parent = list })
				Library:New("TextLabel", {
					BackgroundTransparency = 1,
					Size = UDim2.new(0, 44, 1, 0),
					Text = clock:sub(4, 8),
					FontFace = Fonts.Oswald or Fonts.Inter,
					TextSize = 11,
					TextColor3 = Colors.smoke,
					TextXAlignment = Enum.TextXAlignment.Right,
					ZIndex = 53,
					Parent = row,
				})
				local box = Library:StateBox(row, it.tag, bad and "bad" or nil, 16)
				box.AnchorPoint = Vector2.new(0, 0.5)
				box.Position = UDim2.new(0, 54, 0.5, 0)
				Library:New("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 124, 0, 0),
					Size = UDim2.new(1, -124, 1, 0),
					Text = tostring(it.text or ""),
					FontFace = Fonts.Inter,
					TextSize = 12,
					TextColor3 = bad and Colors.bad or Colors.textMid,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					ZIndex = 53,
					Parent = row,
				})
				shown += 1
				if shown >= 120 then break end
			end
			countLabel.Text = n == 0 and "" or string.format("%d events", n)
			if n == 0 then
				Library:New("TextLabel", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 34),
					Text = "Nothing logged yet. Turn an automation on and the hub narrates here.",
					FontFace = Fonts.Inter,
					TextSize = 12,
					TextColor3 = Colors.muted,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextWrapped = true,
					ZIndex = 52,
					Parent = list,
				})
			end
		end
		local function place()
			local p = headerLeft.AbsolutePosition - screenGui.AbsolutePosition
			drawer.Position = UDim2.new(0, p.X, 0, p.Y + headerLeft.AbsoluteSize.Y + 6)
		end
		local function toggle(state)
			build()
			local show = state
			if show == nil then show = not drawer.Visible end
			drawer.Visible = show
			if show then
				place()
				refresh()
			end
		end
		rawset(Library, "ToggleLogbook", function(_, state) return toggle(state) end)
		-- the whole 44 px topbar-left is the hit; in the landscape single row only its 96 px, so
		-- the tab words beside it stay tappable
		local hit = Library:New("TextButton", {
			Name = "TickerHit",
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Size = touchLandscape and UDim2.new(0, LAND_LEFT_W, 1, 0) or UDim2.new(0.55, 0, 1, 0),
			ZIndex = 4,
			Parent = header,
		})
		hit.MouseButton1Click:Connect(function() toggle() end)
		-- Escape, the X in the head, or a click anywhere outside the drawer (the ticker that opens
		-- it excepted) close it (owner 2026-11-01)
		local function inside(gui, pos)
			local p, sz = gui.AbsolutePosition, gui.AbsoluteSize
			return pos.X >= p.X and pos.X <= p.X + sz.X and pos.Y >= p.Y and pos.Y <= p.Y + sz.Y
		end
		Library:GiveSignal(UserInputService.InputBegan:Connect(function(io)
			if not (drawer and drawer.Visible) then return end
			if io.KeyCode == Enum.KeyCode.Escape then drawer.Visible = false return end
			if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
				local pos = Vector2.new(io.Position.X, io.Position.Y)
				if not inside(drawer, pos) and not inside(hit, pos) then drawer.Visible = false end
			end
		end))
		-- the header's drag handle (ZIndex 6) lies over the hit, so the hit never saw a click
		-- (found live 2026-11-01): a press on the handle that ends within 4 px, over the hit,
		-- is the click; a drag is not
		local dragHandle = header:FindFirstChild("DragHandle_Header")
		if dragHandle then
			local downAt
			dragHandle.InputBegan:Connect(function(io)
				if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
					downAt = Vector2.new(io.Position.X, io.Position.Y)
				end
			end)
			dragHandle.InputEnded:Connect(function(io)
				if not downAt then return end
				if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
					local was = downAt
					downAt = nil
					local up = Vector2.new(io.Position.X, io.Position.Y)
					if (up - was).Magnitude < 4 and inside(hit, up) then toggle() end
				end
			end)
		end
		Library.Commands = Library.Commands or {}
		Library.Commands["Open logbook"] = { Func = function() toggle(true) end, Group = "hub" }
	end

	-- Footer pill is part of the window chrome (mockup .footer): build it now,
	-- hubs refresh the numbers through Library:SetFooterStats.
	pcall(function()
		window:AddFooter({
			online  = Library.FooterStats and Library.FooterStats.online,
			members = Library.FooterStats and Library.FooterStats.members,
			session = Library.FooterStats and Library.FooterStats.session,
			discordLink = opts.Discord or opts.DiscordLink,
		})
	end)

	return window
end

-- ---------------------------------------------------------------- Starfield (ported from the Obsidian-era Corvus theme)
-- Twinkling stars on three parallax layers, a few sparkles / bright stars, silver
-- shooting stars. Tuned down from the original (48 stars, 2 sparkles, 3 bright,
-- a comet every 2.5-6 s) so it stays cheap next to the hub loops.
function Library:CreateStarfield(parent, opts)
	local Config = opts or {}
	local Rng = Random.new(Config.Seed or 7)
	local BaseZ = Config.ZIndex or 0
	local Accent = Config.Accent or Colors.metalLo
	local White = Color3.new(1, 1, 1)
	-- owner 2026-11-01 ("w starfield poza gui powinno sie ruszac wiecej bardziej mocniej wieksze
	-- kropki i wiecej comet"): the sky's pace, reach, dot sizes and comet size are knobs, so the
	-- window's sky can run hot while the touch field and the loader keep the old look
	local Knob = {
		Tempo = math.max(0.1, tonumber(Config.Tempo) or 1),   -- divides every wander / drift / flight time
		Reach = tonumber(Config.Reach) or 1,                   -- multiplies the wander and the layer sway
		Near = Config.NearSize or { 2, 3 },                    -- px range of a near star
		Far = Config.FarSize or { 1, 2 },                      -- px range of a far star
		Drifter = Config.DrifterSize or { 1, 2 },              -- px range of a drifter
		Comet = tonumber(Config.CometScale) or 1,              -- comet length / travel / thickness / head
		BurstMax = math.max(1, tonumber(Config.BurstMax) or 2),
		Brighten = tonumber(Config.Brighten) or 0,
	}

	local Field = { Enabled = true, Active = true, Destroyed = false, Running = false, Tweens = {}, Connections = {} }
	-- owner 2026-11-01 ("starfield from background to be inside too ... synchronise them both"):
	-- a field can have a mirror (Field:Mirror below): every layer cloned into a canvas inside
	-- another frame, each original paired with its twin, and every tween and write made here
	-- goes to both, so the twins move in step with the originals. Strong refs (a weak key on a
	-- parented Instance is collected with its Lua proxy); a comet's pair is dropped when it dies.
	local Twins = {}
	local Canvas = nil
	local Epoch = 0
	local TwinTween = {}
	TwinTween.__index = function(t, key)
		if key == "Play" or key == "Cancel" or key == "Pause" then
			return function(self)
				self._a[key](self._a)
				local b = rawget(self, "_b")
				if b then b[key](b) end
			end
		end
		return rawget(t, "_a")[key]
	end
	local function Tw(obj, info, props)
		local a = TweenService:Create(obj, info, props)
		local twin = Twins[obj]
		if not twin then return a end
		return setmetatable({ _a = a, _b = TweenService:Create(twin, info, props) }, TwinTween)
	end
	local function W(obj, prop, v)
		obj[prop] = v
		local twin = Twins[obj]
		if twin then twin[prop] = v end
	end
	Field.Twins = Twins

	-- No ClipsDescendants here: a clipped full-window subtree with two gradient bands cost
	-- ~3 ms/frame live (2026-10-19, 39 -> 45 fps). The window frame clips anyway; the bands
	-- get the corner radius themselves and comets/stars are kept inside the field.
	local Frame = Library:New("Frame", {
		Name = "Starfield",
		BackgroundTransparency = 1,
		ClipsDescendants = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = BaseZ,
		Parent = parent,
	})
	if Config.CornerRadius then Library:Round(Config.CornerRadius).Parent = Frame end
	Field.Frame = Frame

	-- two faint nebula bands (silver, not violet)
	local function Band(rotation, offset, peak, width)
		local band = Library:New("Frame", {
			Name = "Nebula",
			BackgroundColor3 = White,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			ZIndex = BaseZ,
			Parent = Frame,
		})
		if Config.CornerRadius then Library:Round(Config.CornerRadius).Parent = band end
		local g = Instance.new("UIGradient")
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Colors.metalLo),
			ColorSequenceKeypoint.new(0.5, Colors.metalMid),
			ColorSequenceKeypoint.new(1, Colors.metalLo),
		})
		g.Offset = offset
		g.Rotation = rotation
		g.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5 - width, 1),
			NumberSequenceKeypoint.new(0.5, peak),
			NumberSequenceKeypoint.new(0.5 + width, 1),
			NumberSequenceKeypoint.new(1, 1),
		})
		g.Parent = band
	end
	-- critique 2026-11-01 (round 11): the band lay dead-centre behind the cards and read as a
	-- stock light-leak wallpaper; it now sits behind the sidebar and the title, narrower and
	-- fainter, so at the content the lit rim is the only light
	if (Config.NebulaPeak or 0.94) < 1 then
		Band(28, Config.NebulaOffset or Vector2.new(-0.34, -0.26), Config.NebulaPeak or 0.94, Config.NebulaWidth or 0.22)
	end
	-- one band only: each is a full-window alpha layer (~1 ms on a GPU-bound client)

	local Layers = {}
	for i, depth in ipairs({ 10, 24, 17 }) do
		local frame = Library:New("Frame", { Name = "Layer" .. i, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = BaseZ, Parent = Frame })
		-- the parallax moves the layer, the slow sky drift (Wander) moves Inner, so neither
		-- overwrites the other's Position
		local inner = Library:New("Frame", { Name = "Inner", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = BaseZ, Parent = frame })
		Layers[i] = { Depth = depth, Frame = frame, Inner = inner }
	end

	local Stars = {}
	for _ = 1, Config.Count or 48 do
		local near = Rng:NextNumber() < 0.28
		local size = near and Rng:NextInteger(Knob.Near[1], Knob.Near[2]) or Rng:NextInteger(Knob.Far[1], Knob.Far[2])
		-- Brighten lowers every star's resting transparency by that much (owner 2026-11-01)
		local base = math.max(0, (near and Rng:NextNumber(0.05, 0.35) or Rng:NextNumber(0.35, 0.7)) - Knob.Brighten)
		local tinted = Rng:NextNumber() < 0.3
		-- a hair of the metal in every star (owner 2026-11-01 "the stars outside the gui, make them
		-- accent color too"): pure white is never tinted by a theme, this is
		local star = Library:New("Frame", {
			Name = "Star",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = White:Lerp(Accent, tinted and 0.45 or 0.12),
			BackgroundTransparency = base,
			BorderSizePixel = 0,
			Position = UDim2.fromScale(Rng:NextNumber(0.04, 0.96), Rng:NextNumber(0.05, 0.95)),   -- parallax shifts up to 18 px: keep a margin
			Size = UDim2.fromOffset(size, size),
			ZIndex = BaseZ,
			Parent = Layers[near and 2 or 1].Inner,
		})
		if size >= 3 then Library:Round(size).Parent = star end   -- a 2 px dot rounds to nothing
		star:SetAttribute("CorvusTint", true)   -- the theme walk tints it while it is transparent too
		table.insert(Stars, { Star = star, Base = base, Near = near, Twinkle = Rng:NextNumber() < 0.55, Duration = Rng:NextNumber(1.1, 3.4), Delay = Rng:NextNumber(0, 2.5) })
	end

	local Sparkles = {}
	for _ = 1, Config.Sparkles or 2 do
		local holder = Library:New("Frame", {
			Name = "Sparkle",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Position = UDim2.fromScale(Rng:NextNumber(0.08, 0.92), Rng:NextNumber(0.1, 0.9)),
			Size = UDim2.fromOffset(11, 11),
			ZIndex = BaseZ,
			Parent = Layers[2].Inner,
		})
		for _, horizontal in ipairs({ true, false }) do
			local ray = Library:New("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = White,
				BorderSizePixel = 0,
				Position = UDim2.fromScale(0.5, 0.5),
				Size = horizontal and UDim2.new(1, 0, 0, 1) or UDim2.new(0, 1, 1, 0),
				ZIndex = BaseZ,
				Parent = holder,
			})
			local g = Instance.new("UIGradient")
			g.Rotation = horizontal and 0 or 90
			g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) })
			g.Parent = ray
		end
		local core = Library:New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = White, BorderSizePixel = 0, Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(3, 3), ZIndex = BaseZ, Parent = holder })
		Library:Round(3).Parent = core
		local scale = Instance.new("UIScale"); scale.Parent = holder
		table.insert(Sparkles, { Scale = scale, Duration = Rng:NextNumber(1.6, 2.8), Delay = Rng:NextNumber(0, 1.5) })
	end

	local BrightStars = {}
	local function CreateBrightStar(layer, position, coreSize, glowSize)
		local holder = Library:New("Frame", { Name = "Bright", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Position = position, Size = UDim2.fromOffset(glowSize, glowSize), ZIndex = BaseZ, Parent = layer })
		local halo = Library:New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = White:Lerp(Accent, 0.55), BackgroundTransparency = 0.88, BorderSizePixel = 0, Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), ZIndex = BaseZ, Parent = holder })
		Library:Round(glowSize).Parent = halo
		local inner = Library:New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = White:Lerp(Accent, 0.3), BackgroundTransparency = 0.72, BorderSizePixel = 0, Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.45, 0.45), ZIndex = BaseZ, Parent = holder })
		Library:Round(glowSize).Parent = inner
		local rays = {}
		for _, horizontal in ipairs({ true, false }) do
			local ray = Library:New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = White, BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromScale(0.5, 0.5), Size = horizontal and UDim2.new(1.9, 0, 0, 1) or UDim2.new(0, 1, 1.9, 0), ZIndex = BaseZ, Parent = holder })
			local g = Instance.new("UIGradient")
			g.Rotation = horizontal and 0 or 90
			g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) })
			g.Parent = ray
			table.insert(rays, ray)
		end
		local core = Library:New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = White, BorderSizePixel = 0, Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(coreSize, coreSize), ZIndex = BaseZ, Parent = holder })
		Library:Round(coreSize).Parent = core
		local scale = Instance.new("UIScale"); scale.Parent = holder
		local data = { Holder = holder, Halo = halo, Inner = inner, Rays = rays, Scale = scale, Phase = Rng:NextNumber(0, math.pi * 2), Speed = Rng:NextNumber(1.2, 2.6), Flare = 0, NextFlare = Rng:NextNumber(0.5, 6) }
		table.insert(BrightStars, data)
		return data
	end
	for _ = 1, Config.BrightStars or 3 do
		CreateBrightStar(Layers[2].Inner, UDim2.fromScale(Rng:NextNumber(0.07, 0.93), Rng:NextNumber(0.08, 0.92)), Rng:NextInteger(2, 3), Rng:NextInteger(10, 15))
	end

	-- owner 2026-11-01 ("more stars flying around outside the ui"): drifters are tiny stars that
	-- cross the field slowly, each on its own slanted line, fading in and out. A leaf frame per
	-- star, so the Position tween is one write a frame; nothing runs while the field is off.
	local Drifters = {}
	for _ = 1, tonumber(Config.Drifters) or 0 do
		local size = Rng:NextInteger(Knob.Drifter[1], Knob.Drifter[2])
		local star = Library:New("Frame", {
			Name = "Drifter",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = White:Lerp(Accent, Rng:NextNumber() < 0.35 and 0.45 or 0.12),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromScale(Rng:NextNumber(), Rng:NextNumber()),
			Size = UDim2.fromOffset(size, size),
			ZIndex = BaseZ,
			Parent = Layers[3].Inner,
		})
		if size >= 3 then Library:Round(size).Parent = star end   -- a 2 px dot rounds to nothing
		star:SetAttribute("CorvusTint", true)   -- the theme walk tints it while it is transparent too
		table.insert(Drifters, star)
	end
	if #Drifters > 0 then
		local function fly(star)
			-- in from one side, out past the other, 14-32 s a trip, a little rise or fall on the way
			local fromLeft = Rng:NextNumber() < 0.5
			local x0 = fromLeft and Rng:NextNumber(-0.04, 0.2) or Rng:NextNumber(0.8, 1.04)
			local x1 = fromLeft and Rng:NextNumber(0.55, 1.04) or Rng:NextNumber(-0.04, 0.45)
			local y0 = Rng:NextNumber(0.02, 0.98)
			local span = 0.35 * math.min(Knob.Reach, 1.5)
			local y1 = math.clamp(y0 + Rng:NextNumber(-span, span), -0.04, 1.04)
			local trip = Rng:NextNumber(10, 28) / Knob.Tempo
			local rest = math.max(0, Rng:NextNumber(0.1, 0.45) - Knob.Brighten)
			W(star, "Position", UDim2.fromScale(x0, y0))
			W(star, "BackgroundTransparency", 1)
			local move = Tw(star, TweenInfo.new(trip, Enum.EasingStyle.Linear), { Position = UDim2.fromScale(x1, y1) })
			local fadeIn = Tw(star, TweenInfo.new(trip * 0.25, Enum.EasingStyle.Sine), { BackgroundTransparency = rest })
			local fadeOut = Tw(star, TweenInfo.new(trip * 0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.In), { BackgroundTransparency = 1 })
			move:Play()
			fadeIn:Play()
			task.delay(trip * 0.7, function()
				if move.PlaybackState == Enum.PlaybackState.Playing then fadeOut:Play() end
			end)
			return { move = move, all = { move, fadeIn, fadeOut } }
		end
		task.spawn(function()
			local running = {}
			while not Field.Destroyed and not Library.Unloaded do
				if Field.Enabled and Field.Active and Library.IconAnimations ~= false then
					for i, star in ipairs(Drifters) do
						local r = running[i]
						-- a new mirror (Epoch) relaunches every drifter so its twin flies the same trip
						if not r or r.epoch ~= Epoch or r.move.PlaybackState ~= Enum.PlaybackState.Playing then
							if r then for _, tw in ipairs(r.all) do tw:Cancel() end end
							running[i] = fly(star)
							running[i].epoch = Epoch
							task.wait(Rng:NextNumber(0.2, 1.4))   -- the launches stagger
							if Field.Destroyed or not (Field.Enabled and Field.Active) then break end
						end
					end
				else
					for i, r in pairs(running) do
						for _, tw in ipairs(r.all) do tw:Cancel() end
						running[i] = nil
						W(Drifters[i], "BackgroundTransparency", 1)
					end
				end
				task.wait(0.5)
			end
		end)
	end

	-- Owner 2026-10-20 "hub sie laguje": the per-frame bindings (bright-star shimmer,
	-- parallax mouse-lerp) stay bound only while the field is actually running, so a
	-- disabled starfield costs nothing. Toggled by Field:Refresh below.
	local LiveConns = {}
	local function stopLive()
		for _, c in ipairs(LiveConns) do pcall(function() c:Disconnect() end) end
		table.clear(LiveConns)
	end
	local function startLive()
		if #LiveConns > 0 then return end
		if #BrightStars > 0 then
			local clock = 0
			table.insert(LiveConns, RunService.RenderStepped:Connect(function(dt)
				if Field.Destroyed or not (Field.Enabled and Field.Active) or Library.IconAnimations == false then return end
				clock += dt
				for _, d in ipairs(BrightStars) do
					if clock >= d.NextFlare then
						d.Flare = 1
						d.NextFlare = clock + Rng:NextNumber(3, 9)
					end
					d.Flare = math.max(0, d.Flare - dt * 1.4)
					local flare = d.Flare * d.Flare
					local shimmer = math.sin(clock * d.Speed + d.Phase)
					W(d.Scale, "Scale", 1 + shimmer * 0.08 + flare * 0.55)
					W(d.Halo, "BackgroundTransparency", 0.88 - shimmer * 0.03 - flare * 0.3)
					-- 60 fps budget: inner + rays only change during a flare; write them while it
					-- runs and once more when it ends, not every frame of the idle shimmer
					if flare > 0 or d.Lit then
						d.Lit = flare > 0
						W(d.Inner, "BackgroundTransparency", 0.72 - flare * 0.35)
						for _, ray in ipairs(d.Rays) do W(ray, "BackgroundTransparency", 1 - flare * 0.85) end
					end
				end
			end))
		end
	end
	table.insert(Field.Connections, { Disconnect = stopLive })

	-- owner 2026-11-01 ("floating around freely, not only when i move my mouse ... realistic, more
	-- of flying stars"): with Wander on every star drifts on its own slow course - a new nearby
	-- point every 9-26 s on a Sine ease, the near stars further and faster than the far ones -
	-- and each layer as a whole sways a little over 40-70 s at its own pace, so the sky keeps
	-- moving by itself and the pointer parallax only adds to it. Engine tweens chained on
	-- Completed: nothing runs per frame in Luau. Field.Running gates every chain.
	local WanderOn = Config.Wander == true
	local function wander(d)
		if not (WanderOn and Field.Running) then return end
		local p = d.Star.Position
		local reach = (d.Near and 0.06 or 0.035) * Knob.Reach
		local x = math.clamp(p.X.Scale + Rng:NextNumber(-reach, reach), 0.03, 0.97)
		local y = math.clamp(p.Y.Scale + Rng:NextNumber(-reach, reach) * 0.7, 0.04, 0.96)
		local t = (d.Near and Rng:NextNumber(9, 18) or Rng:NextNumber(14, 26)) / Knob.Tempo
		local tw = Tw(d.Star, TweenInfo.new(t, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.fromScale(x, y) })
		d.Wander = tw
		tw.Completed:Connect(function(state)
			if d.Wander == tw and state == Enum.PlaybackState.Completed then wander(d) end
		end)
		tw:Play()
	end
	local function driftLayer(layer)
		if not (WanderOn and Field.Running) then return end
		local amp = (layer.Depth or 10) * 0.9 * Knob.Reach
		local tw = Tw(layer.Inner, TweenInfo.new(Rng:NextNumber(40, 70) / Knob.Tempo, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.fromOffset(Rng:NextNumber(-amp, amp), Rng:NextNumber(-amp, amp)) })
		layer.Drift = tw
		tw.Completed:Connect(function(state)
			if layer.Drift == tw and state == Enum.PlaybackState.Completed then driftLayer(layer) end
		end)
		tw:Play()
	end
	local function StopTweens()
		Field.Running = false
		for _, tw in ipairs(Field.Tweens) do tw:Cancel() end
		table.clear(Field.Tweens)
		for _, d in ipairs(Stars) do
			W(d.Star, "BackgroundTransparency", d.Base)
			if d.Wander then d.Wander:Cancel(); d.Wander = nil end
		end
		for _, layer in ipairs(Layers) do
			if layer.Drift then layer.Drift:Cancel(); layer.Drift = nil end
		end
		for _, d in ipairs(Sparkles) do W(d.Scale, "Scale", 1) end
	end
	local function StartTweens()
		if Field.Running then return end
		Field.Running = true
		for _, d in ipairs(Stars) do
			if d.Twinkle then
				local tw = Tw(d.Star, TweenInfo.new(d.Duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, d.Delay), { BackgroundTransparency = math.min(1, d.Base + 0.55) })
				tw:Play()
				table.insert(Field.Tweens, tw)
			end
			wander(d)
		end
		for _, layer in ipairs(Layers) do driftLayer(layer) end
		for _, d in ipairs(Sparkles) do
			local tw = Tw(d.Scale, TweenInfo.new(d.Duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, d.Delay), { Scale = 0.35 })
			tw:Play()
			table.insert(Field.Tweens, tw)
		end
	end

	function Field:Refresh()
		if Field.Destroyed then return end
		local running = Field.Enabled and Field.Active
		Frame.Visible = running
		if Canvas then Canvas.Visible = running end
		if running and Library.IconAnimations ~= false then
			StartTweens()
			startLive()
		else
			StopTweens()
			stopLive()
		end
	end
	function Field:SetEnabled(v) Field.Enabled = v ~= false; Field:Refresh() end
	function Field:SetActive(v)  Field.Active  = v ~= false; Field:Refresh() end

	-- shooting star: silver streak with a bright head, fades while it travels
	function Field:Shoot()
		if Field.Destroyed then return end
		local angle = math.rad(Rng:NextNumber(16, 34))
		local travel = math.floor(Rng:NextInteger(220, 380) * Knob.Comet)
		local length = math.floor(Rng:NextInteger(130, 220) * Knob.Comet)
		local duration = Rng:NextNumber(0.8, 1.2)
		-- whole streak (tail behind the head) and the full travel stay inside the field (no clip)
		local k = tonumber(Config.Scale) or Library.UIScale or 1   -- Scale = 1 for a field outside the window
		if k <= 0 then k = 1 end
		local fw, fh = Frame.AbsoluteSize.X / k, Frame.AbsoluteSize.Y / k
		if fw < 200 or fh < 120 then return end
		local sxPx = Rng:NextNumber(length + 12, math.max(length + 12, fw * 0.55))
		-- Rotation pivots on the streak's centre, so the tail can swing up to length/2 above the head
		local syPx = Rng:NextNumber(length * 0.6, math.max(length * 0.6, fh * 0.35))
		travel = math.min(travel, (fw - 12 - sxPx) / math.cos(angle), (fh - 12 - syPx) / math.sin(angle))
		if travel < 60 then return end
		local streak = Library:New("Frame", {
			Name = "Comet",
			AnchorPoint = Vector2.new(1, 0.5),
			BackgroundColor3 = White,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(sxPx, syPx),
			Rotation = math.deg(angle),
			Size = UDim2.fromOffset(length, math.max(2, math.round(2 * Knob.Comet))),
			ZIndex = BaseZ,
			Parent = Frame,
		})
		Library:Round(2).Parent = streak
		local g = Instance.new("UIGradient")
		g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Library:ThemeColor(Colors.metalLo)), ColorSequenceKeypoint.new(0.7, Library:ThemeColor(Colors.metalMid)), ColorSequenceKeypoint.new(1, White) })
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.6, 0.6), NumberSequenceKeypoint.new(0.92, 0.15), NumberSequenceKeypoint.new(1, 0) })
		g.Parent = streak
		local hd = math.round(5 * Knob.Comet)
		local head = Library:New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = White, BorderSizePixel = 0, Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(hd, hd), ZIndex = BaseZ, Parent = streak })
		Library:Round(hd).Parent = head
		local glow = Library:Stroke(Library:ThemeColor(Accent), math.round(4 * Knob.Comet), 0.45)
		glow.Parent = head
		-- the mirror gets a twin comet: the same streak, head and glow, driven by the same tweens
		local twin = nil
		if Canvas then
			twin = streak:Clone()
			twin.Parent = Canvas
			Twins[streak] = twin
			local th = twin:FindFirstChildOfClass("Frame")
			if th then
				Twins[head] = th
				Twins[glow] = th:FindFirstChildOfClass("UIStroke")
			end
		end
		local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local tw = Tw(streak, info, { Position = UDim2.fromOffset(sxPx + math.cos(angle) * travel, syPx + math.sin(angle) * travel), BackgroundTransparency = 1 })
		Tw(head, info, { BackgroundTransparency = 1 }):Play()
		Tw(glow, info, { Transparency = 1 }):Play()
		tw.Completed:Once(function()
			Twins[streak], Twins[head], Twins[glow] = nil, nil, nil
			streak:Destroy()
			if twin then twin:Destroy() end
		end)
		tw:Play()
	end

	-- Parallax now rides startLive/stopLive via a closure appended below, so a
	-- disabled starfield spends no mouse-lerp per frame.
	local ParallaxOn = Config.Parallax ~= false
	local startLiveBase = startLive
	startLive = function()
		if #LiveConns > 0 then return end
		startLiveBase()
		if ParallaxOn then
			local offset, written = Vector2.zero, Vector2.new(1e9, 1e9)
			local maxDepth = 0
			for _, layer in ipairs(Layers) do maxDepth = math.max(maxDepth, math.abs(layer.Depth or 0)) end
			table.insert(LiveConns, RunService.RenderStepped:Connect(function(dt)
				if Field.Destroyed or not (Field.Enabled and Field.Active) then return end
				local size = Frame.AbsoluteSize
				if size.X < 1 or size.Y < 1 then return end
				local center = Frame.AbsolutePosition + size / 2
				local m = UserInputService:GetMouseLocation()
				local target = Vector2.new(math.clamp((m.X - center.X) / size.X, -0.75, 0.75), math.clamp((m.Y - center.Y) / size.Y, -0.75, 0.75))
				offset = offset:Lerp(target, math.clamp(dt * 5, 0, 1))
				-- 60 fps budget: a still pointer converges the lerp; once the deepest layer would
				-- move under a quarter pixel, skip the Position writes (each one re-lays the field)
				if (offset - written).Magnitude * maxDepth < 0.25 then return end
				written = offset
				for _, layer in ipairs(Layers) do
					W(layer.Frame, "Position", UDim2.fromOffset(-offset.X * layer.Depth, -offset.Y * layer.Depth))
				end
			end))
		end
	end

	if Config.ShootingStars ~= false then
		task.spawn(function()
			while not Field.Destroyed and not Library.Unloaded do
				task.wait(Rng:NextNumber(Config.ShootingMin or 2.5, Config.ShootingMax or 6))
				if Field.Destroyed or Library.Unloaded then break end
				if Field.Enabled and Field.Active and Library.IconAnimations ~= false and Frame.AbsoluteSize.X > 80 then
					Field:Shoot()
					if Rng:NextNumber() < (Config.BurstChance or 0.3) then
						for _ = 1, Rng:NextInteger(1, Knob.BurstMax) do
							task.wait(Rng:NextNumber(0.12, 0.3))
							if Field.Destroyed or not (Field.Enabled and Field.Active) then break end
							Field:Shoot()
						end
					end
				end
			end
		end)
	end

	-- Field:Mirror(host, scaleOf): the field's twin inside host (a clipping frame in a window). A
	-- canvas the field's size in screen px, placed so its origin sits where the field's does (in
	-- host's own units, hence the window scale from scaleOf), its UIScale 1/scale so the twins
	-- render at screen scale; every layer cloned into it and paired child by child; the running
	-- tweens restarted so both sides start together. Comets get their twin as they are shot.
	function Field:Mirror(host, scaleOf)
		if Field.Destroyed or Canvas then return nil end
		local canvas = Library:New("Frame", { Name = "SkyMirror", BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = BaseZ, Parent = host })
		local cs = Instance.new("UIScale")
		cs.Parent = canvas
		StopTweens()
		local function pair(a, b)
			Twins[a] = b
			local ca, cb = a:GetChildren(), b:GetChildren()
			for i, child in ipairs(ca) do
				if cb[i] then pair(child, cb[i]) end
			end
		end
		for _, layer in ipairs(Layers) do
			local clone = layer.Frame:Clone()
			clone.Parent = canvas
			pair(layer.Frame, clone)
		end
		Canvas = canvas
		Epoch += 1
		local function fit()
			local k = tonumber(type(scaleOf) == "function" and scaleOf() or scaleOf) or 1
			if k <= 0 then k = 1 end
			cs.Scale = 1 / k
			local sp, ss, hp, hs = Frame.AbsolutePosition, Frame.AbsoluteSize, host.AbsolutePosition, host.AbsoluteSize
			canvas.Size = UDim2.fromOffset(ss.X, ss.Y)
			-- a UDim offset is an integer (found live: every twin sat 1.2 px off its star), the
			-- place goes in as a fraction of the host, which is exact
			canvas.Position = UDim2.fromScale(hs.X > 0 and (sp.X - hp.X) / hs.X or 0, hs.Y > 0 and (sp.Y - hp.Y) / hs.Y or 0)
		end
		for _, prop in ipairs({ "AbsolutePosition", "AbsoluteSize" }) do
			table.insert(Field.Connections, host:GetPropertyChangedSignal(prop):Connect(fit))
			table.insert(Field.Connections, Frame:GetPropertyChangedSignal(prop):Connect(fit))
		end
		Field.Fit = fit
		fit()
		Field:Refresh()
		return canvas
	end

	function Field:Destroy()
		if Field.Destroyed then return end
		StopTweens()
		Field.Destroyed = true
		for _, c in ipairs(Field.Connections) do c:Disconnect() end
		table.clear(Field.Connections)
		Frame:Destroy()
		if Canvas then Canvas:Destroy() end
		table.clear(Twins)
	end

	Field:Refresh()
	return Field
end

-- owner 2026-11-01 (C10, ported from the old library's AddAvatarCard): a 3D avatar card - the
-- player's character cloned into a ViewportFrame, lit cool, drag to turn it, a slow idle spin
-- while its tab is open; the 2D avatar thumbnail when there is no character to clone. The name,
-- the @handle and a membership chip sit on a shade at the foot. Anonymous shows the crow instead.
-- opts: Player, Height, Rotate, Anonymous, Scroll (a ScrollingFrame paused while dragging),
-- IsActive() (gates the idle spin), LayoutOrder.
function Library:AvatarCard(parent, opts)
	opts = opts or {}
	local target = opts.Player or LocalPlayer
	local height = tonumber(opts.Height) or 190
	local card = { Model = nil, Rotate = opts.Rotate ~= false, Dragging = false, Anonymous = opts.Anonymous == true, Destroyed = false, Connections = {} }
	local z = (parent and parent.ZIndex or 1) + 1
	local box = Library:New("TextButton", {
		Name = "AvatarCard",
		BackgroundColor3 = Colors.well,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		ClipsDescendants = true,
		Size = UDim2.new(1, 0, 0, height),
		ZIndex = z,
	})
	if opts.LayoutOrder then box.LayoutOrder = opts.LayoutOrder end
	Library:Round(8).Parent = box
	Library:Stroke(Colors.hairlineStrong or Colors.outline, 1, 0).Parent = box
	-- a faint metal light from the top, a soot shade at the foot for the text
	local stage = Library:New("Frame", { Name = "Stage", BackgroundColor3 = Colors.metalLo, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), ZIndex = z, Parent = box })
	Library:Round(8).Parent = stage
	Library:New("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.86), NumberSequenceKeypoint.new(0.5, 0.97), NumberSequenceKeypoint.new(1, 1) }),
		Parent = stage,
	})
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	local viewport = Library:New("ViewportFrame", {
		Name = "Viewport",
		Ambient = Color3.fromRGB(160, 160, 180),
		BackgroundTransparency = 1,
		LightColor = Color3.fromRGB(240, 240, 255),
		LightDirection = Vector3.new(-0.6, -1, -0.8),
		Size = UDim2.new(1, 0, 1, -10),
		ZIndex = z + 1,
		Parent = box,
	})
	viewport.CurrentCamera = camera
	camera.Parent = viewport
	local function thumbUrl()
		return string.format("rbxthumb://type=Avatar&id=%d&w=420&h=420", tonumber(target and target.UserId) or 1)
	end
	local thumb = Library:New("ImageLabel", {
		Name = "Thumb",
		BackgroundTransparency = 1,
		Image = card.Anonymous and "" or thumbUrl(),
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.new(1, 0, 1, -30),
		Visible = false,
		ZIndex = z + 1,
		Parent = box,
	})
	-- anonymous: the crow in the player's place
	local hidden = Library:CrowMark(box, 64, z + 1)
	hidden.Name = "Hidden"
	hidden.AnchorPoint = Vector2.new(0.5, 0.5)
	hidden.Position = UDim2.new(0.5, 0, 0.5, -16)
	hidden.Visible = false
	local shade = Library:New("Frame", { Name = "Shade", AnchorPoint = Vector2.new(0, 1), BackgroundColor3 = Colors.bg, BorderSizePixel = 0, Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 58), ZIndex = z + 2, Parent = box })
	Library:New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.2) }), Parent = shade })
	local nameLbl = Library:New("TextLabel", {
		Name = "Name", BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 1, -40), Size = UDim2.new(1, -104, 0, 18),
		FontFace = Fonts.OswaldMed or Fonts.Display or Fonts.InterBold, TextSize = 16, TextColor3 = Colors.moon,
		TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = z + 3, Parent = box,
	})
	local handleLbl = Library:New("TextLabel", {
		Name = "Handle", BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 1, -22), Size = UDim2.new(1, -104, 0, 14),
		FontFace = Fonts.Inter, TextSize = 12, TextColor3 = Colors.textMid,
		TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = z + 3, Parent = box,
	})
	local premium = false
	pcall(function() premium = target.MembershipType == Enum.MembershipType.Premium end)
	local chip = Library:New("TextLabel", {
		Name = "Chip",
		AnchorPoint = Vector2.new(1, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Colors.metalLo,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -10, 1, -12),
		Size = UDim2.new(0, 0, 0, 20),
		Text = "",
		FontFace = Fonts.InterMed or Fonts.Inter,
		TextSize = 11,
		TextColor3 = Colors.metalMid,
		ZIndex = z + 3,
		Parent = box,
	})
	Library:Round(5).Parent = chip
	Library:Padding(0, 8, 0, 8).Parent = chip
	local function paintText()
		local anon = card.Anonymous
		nameLbl.Text = anon and "Anonymous" or tostring(target and target.DisplayName or "?")
		handleLbl.Text = anon and "@hidden" or ("@" .. tostring(target and target.Name or "?"))
		chip.Text = anon and "Hidden" or (premium and "Premium" or "Member")
		thumb.Image = anon and "" or thumbUrl()
	end
	paintText()

	local focus, distance = Vector3.zero, 8
	local angle, pitch = math.rad(tonumber(opts.Angle) or 18), math.rad(tonumber(opts.Pitch) or 6)
	local function updateCamera()
		local flat = math.cos(pitch) * distance
		camera.CFrame = CFrame.lookAt(focus + Vector3.new(math.sin(angle) * flat, math.sin(pitch) * distance, -math.cos(angle) * flat), focus)
	end
	local function fitCamera()
		if not card.Model then return end
		local ok, cf, size = pcall(function() return card.Model:GetBoundingBox() end)
		if not ok or typeof(cf) ~= "CFrame" then return end
		focus = cf.Position - Vector3.new(0, size.Y * 0.04, 0)
		local aspect = math.max(viewport.AbsoluteSize.X, 1) / math.max(viewport.AbsoluteSize.Y, 1)
		local tangent = math.tan(math.rad(camera.FieldOfView / 2))
		local fitH = (size.Y * 0.5 + 0.45) / tangent
		local fitW = (math.max(size.X, size.Z) * 0.5 + 0.45) / (tangent * aspect)
		distance = math.max(fitH, fitW, 4)
		updateCamera()
	end
	local function buildModel()
		local character = target and target.Character
		if not character then return nil end
		local oldArchivable = character.Archivable
		local ok, clone = pcall(function()
			character.Archivable = true
			return character:Clone()
		end)
		pcall(function() character.Archivable = oldArchivable end)
		if not ok or typeof(clone) ~= "Instance" then return nil end
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("ParticleEmitter") or d:IsA("Trail")
				or d:IsA("Beam") or d:IsA("ForceField") or d:IsA("BillboardGui") or d:IsA("Highlight") or d:IsA("Tool") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
			end
		end
		local humanoid = clone:FindFirstChildOfClass("Humanoid")
		if humanoid then
			pcall(function()
				humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			end)
		end
		local root = clone:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then root.Transparency = 1 end
		-- a game that hides the whole character (every part at 1, TFF does) leaves nothing to
		-- draw: show the avatar as it looks unhidden. A character with no parts at all falls
		-- back to the thumbnail.
		local parts, shown = 0, 0
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") and d ~= root then
				parts += 1
				if d.Transparency < 1 then shown += 1 end
			end
		end
		if parts == 0 then
			clone:Destroy()
			return nil
		end
		if shown == 0 then
			for _, d in ipairs(clone:GetDescendants()) do
				if d:IsA("BasePart") and d ~= root then
					d.Transparency = 0
				elseif d:IsA("Decal") then
					d.Transparency = 0
				end
			end
		end
		pcall(function() clone:PivotTo(CFrame.new()) end)
		return clone
	end
	function card:Refresh()
		if card.Destroyed then return end
		if card.Model then
			card.Model:Destroy()
			card.Model = nil
		end
		if card.Anonymous then
			viewport.Visible, thumb.Visible, hidden.Visible = false, false, true
			return
		end
		hidden.Visible = false
		local model = buildModel()
		if model then
			model.Parent = viewport
			card.Model = model
			viewport.Visible, thumb.Visible = true, false
			fitCamera()
		else
			viewport.Visible, thumb.Visible = false, true
		end
	end
	function card:SetAnonymous(v)
		card.Anonymous = v == true
		paintText()
		card:Refresh()
	end
	function card:Destroy()
		if card.Destroyed then return end
		card.Destroyed = true
		for _, cn in ipairs(card.Connections) do pcall(cn.Disconnect, cn) end
		table.clear(card.Connections)
		if card.Model then card.Model:Destroy() end
		box:Destroy()
	end
	table.insert(card.Connections, viewport:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitCamera))
	-- drag to turn (the page stops scrolling under the drag)
	table.insert(card.Connections, box.InputBegan:Connect(function(io)
		if io.UserInputType ~= Enum.UserInputType.MouseButton1 and io.UserInputType ~= Enum.UserInputType.Touch then return end
		card.Dragging = true
		local lastX, lastY = io.Position.X, io.Position.Y
		if opts.Scroll then pcall(function() opts.Scroll.ScrollingEnabled = false end) end
		local moved, ended
		moved = UserInputService.InputChanged:Connect(function(ch)
			if ch.UserInputType == Enum.UserInputType.MouseMovement or ch.UserInputType == Enum.UserInputType.Touch then
				angle += (ch.Position.X - lastX) * 0.012
				pitch = math.clamp(pitch + (ch.Position.Y - lastY) * 0.01, -1.3, 1.3)
				lastX, lastY = ch.Position.X, ch.Position.Y
				updateCamera()
			end
		end)
		ended = UserInputService.InputEnded:Connect(function(fin)
			if fin.UserInputType ~= io.UserInputType then return end
			card.Dragging = false
			moved:Disconnect()
			ended:Disconnect()
			if opts.Scroll then pcall(function() opts.Scroll.ScrollingEnabled = true end) end
		end)
	end))
	-- the idle turn: only with a model, while the card is on screen and its tab is the open one
	table.insert(card.Connections, RunService.RenderStepped:Connect(function(dt)
		if not card.Rotate or card.Dragging or not card.Model or not box.Visible then return end
		if type(opts.IsActive) == "function" and not opts.IsActive() then return end
		angle += dt * 0.55
		updateCamera()
	end))
	if target and target.CharacterAdded then
		table.insert(card.Connections, target.CharacterAdded:Connect(function()
			task.delay(1.5, function() card:Refresh() end)
		end))
	end
	box.Parent = parent
	card.Frame = box
	card:Refresh()
	return card
end

-- Library:SetStarfield(bool) - window background sky on/off (remembered in settings)
function Library:SetStarfield(enabled)
	enabled = enabled ~= false
	Library.StarfieldEnabled = enabled
	if type(Library.SetSetting) == "function" then pcall(Library.SetSetting, Library, "Starfield", enabled) end
	local w = rawget(Library, "Window")
	if w and w.Starfield then pcall(w.Starfield.SetEnabled, w.Starfield, enabled and rawget(Library, "LowEffects") ~= true) end
	local ss = rawget(Library, "_syncSky")
	if type(ss) == "function" then pcall(ss) end
end

-- Low effects (weak PC, owner 2026-10-19 "hub sie laguje"): starfield off, card shadows,
-- glows and the ghost crow hidden. Persisted as setting "LowEffects"; new shadows / glows
-- respect it at creation.
function Library:SetLowEffects(v)
	v = v == true
	rawset(Library, "LowEffects", v)
	if type(Library.SetSetting) == "function" then pcall(Library.SetSetting, Library, "LowEffects", v) end
	local w = rawget(Library, "Window")
	if w and w.Starfield then
		pcall(w.Starfield.SetEnabled, w.Starfield, (not v) and Library.StarfieldEnabled ~= false)
	end
	do
		local ss = rawget(Library, "_syncSky")
		if type(ss) == "function" then pcall(ss) end
	end
	local gui = rawget(Library, "ScreenGui")
	if gui then
		for _, d in ipairs(gui:GetDescendants()) do
			if d:IsA("GuiObject") and (d.Name == "ShadowLayer" or d.Name == "GhostCrow" or string.match(d.Name, "Glow$")) then
				d.Visible = not v
			end
		end
	end
	if type(rawget(Library, "SetBezelsEnabled")) == "function" then pcall(Library.SetBezelsEnabled, Library, not v) end
	-- the rim light stands still and the halo goes with low effects
	for _, tw in ipairs(rawget(Library, "_rimSpins") or {}) do
		if v then pcall(tw.Pause, tw) else pcall(tw.Play, tw) end
	end
	local sync = rawget(Library, "_syncHalo")
	if sync then pcall(sync) end
end

-- W6 UI sounds (setting UISounds, default ON, Settings > Hub): Roblox's own built-in clips
-- (rbxasset://sounds/*, verified to load on 2026-10-19), quiet, one Sound per kind under the
-- hub's ScreenGui (2D, gone with the hub). Nothing here is an automation: a click sound.
do
	local SFX = {
		-- (tab: gone, owner 2026-11-01 - the click on every tab switch was annoying; open: gone,
		-- owner 2026-11-01 "delete the sword sound when opening ui")
		toggle = { "rbxasset://sounds/switch3.wav", 0.4, 1.05 },
		click  = { "rbxasset://sounds/button.wav", 0.3, 1.1 },
		notify = { "rbxasset://sounds/electronicpingshort.wav", 0.22, 1.2 },
	}
	local cache = {}
	-- the setting is read lazily: GetSetting lives in the addons file, which loads after this one
	function Library:GetUISounds()
		local v = rawget(Library, "UISounds")
		if v == nil then
			v = true
			if type(Library.GetSetting) == "function" then
				local ok, s = pcall(Library.GetSetting, Library, "UISounds", true)
				if ok and s == false then v = false end
			end
			rawset(Library, "UISounds", v)
		end
		return v
	end
	function Library:PlaySound(kind)
		if Library:GetUISounds() == false then return end
		local def = SFX[kind]
		local gui = rawget(Library, "ScreenGui")
		if not def or not gui then return end
		local s = cache[kind]
		if not s or s.Parent == nil then
			s = Instance.new("Sound")
			s.Name = "Sfx_" .. tostring(kind)
			s.SoundId = def[1]
			s.Volume = def[2]
			s.PlaybackSpeed = def[3]
			s.Parent = gui
			cache[kind] = s
		end
		pcall(s.Play, s)
	end
	function Library:SetUISounds(v)
		v = v ~= false
		rawset(Library, "UISounds", v)
		if type(Library.SetSetting) == "function" then pcall(Library.SetSetting, Library, "UISounds", v) end
	end
end

-- ---------------------------------------------------------------- Lucide icons + glass tiles
-- Lucide: cached copy (Corvus/lucide.lua) loads at once, otherwise the module is fetched
-- once and cached; images created before it arrives are filled in afterwards.
do
	local LucideUrl  = "https://raw.githubusercontent.com/mstudio45/lucide-roblox-direct/refs/heads/main/source.lua"
	local LucideFile = "Corvus/lucide.lua"
	local Module, Loading, Pending = nil, false, {}

	local function tryLoad(src)
		local fn = type(src) == "string" and loadstring(src) or nil
		if not fn then return nil end
		local ok, m = pcall(fn)
		if ok and type(m) == "table" and type(m.GetAsset) == "function" then return m end
		return nil
	end
	local function flushPending()
		local queue = Pending
		Pending = {}
		for img, name in pairs(queue) do
			if img and img.Parent then pcall(Library.ApplyLucideIcon, Library, img, name) end
		end
	end
	function Library:GetLucide()
		if Module then return Module end
		if not Loading then
			Loading = true
			task.spawn(function()
				pcall(function()
					if isfile and readfile and isfile(LucideFile) then Module = tryLoad(readfile(LucideFile)) end
				end)
				if not Module then
					local ok, src = pcall(game.HttpGet, game, LucideUrl)
					if ok and type(src) == "string" and #src > 1000 then
						Module = tryLoad(src)
						if Module and writefile then
							pcall(function()
								if makefolder and isfolder and not isfolder("Corvus") then makefolder("Corvus") end
								writefile(LucideFile, src)
							end)
						end
					end
				end
				Loading = false
				if Module then flushPending() end
			end)
		end
		return Module
	end
	function Library:GetIcon(name)
		local m = Library:GetLucide()
		if not m or type(name) ~= "string" then return nil end
		local ok, asset = pcall(m.GetAsset, name)
		if ok and type(asset) == "table" and asset.Url then return asset end
		return nil
	end
	function Library:ApplyLucideIcon(img, name)
		if not img or type(name) ~= "string" then return false end
		local asset = Library:GetIcon(name)
		if not asset then
			if not Module then Pending[img] = name end
			return false
		end
		img.Image = asset.Url
		img.ImageRectSize = asset.ImageRectSize
		img.ImageRectOffset = asset.ImageRectOffset
		img.Visible = true
		local glyph = img.Parent and img.Parent:FindFirstChild("Glyph")
		if glyph then glyph.Visible = false end
		return true
	end

	-- Glass tile (iOS-glass look): translucent rounded square, hairline edge, top sheen,
	-- Lucide icon inside; a text glyph shows until / unless the icon resolves.
	function Library:GlassIcon(parent, fallbackGlyph, lucideName, size)
		size = size or 20
		local baseZ = (parent and parent.ZIndex or 1) + 1
		-- Bench: no glass tile. The icon is a bare line glyph in slate; the "tile" is only
		-- the hit/size box (edge kept, fully transparent, for callers that look it up).
		local tile = Library:New("Frame", {
			Name = "IconTile",
			BackgroundColor3 = Colors.text,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(0, size, 0, size),
			ZIndex = baseZ,
			Parent = parent,
		})
		local edge = Library:Stroke(Colors.border, 1, 1)
		edge.Name = "Edge"
		edge.Parent = tile

		local inner = math.floor(size * 0.72)
		local img = Library:New("ImageLabel", {
			Name = "Img",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.new(0, inner, 0, inner),
			Image = "",
			ImageColor3 = Colors.textMid,
			ScaleType = Enum.ScaleType.Fit,
			Visible = false,
			ZIndex = baseZ + 2,
			Parent = tile,
		})
		local glyph = Library:New("TextLabel", {
			Name = "Glyph",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, 0),
			Text = tostring(fallbackGlyph or ""),
			FontFace = Fonts.Mono or Fonts.Inter,
			TextSize = math.max(9, math.floor(size * 0.55)),
			TextColor3 = Colors.muted,
			ZIndex = baseZ + 2,
			Parent = tile,
		})
		local name = type(lucideName) == "string" and lucideName or nil
		if name and (name:match("^rbxassetid://%d+$") or name:match("^rbxthumb://") or name:match("^rbxasset://") or name:match("^https?://")) then
			-- a picture (a game's own icon, Pet Universe style): shown as is, full size, never tinted
			img.Image = name
			img.ImageColor3 = Color3.new(1, 1, 1)
			img.Size = UDim2.new(0, size, 0, size)
			img.Visible = true
			glyph.Visible = false
			tile:SetAttribute("Picture", true)
		elseif name then
			name = name:lower()
			if name:match("^[a-z0-9%-]+$") then
				Library:ApplyLucideIcon(img, name)
			end
		end
		return tile, img, glyph
	end

	-- Icon plate (owner 2026-10-31 late: "ikonki ladnie z cieniami"): a raised square under an
	-- icon, the same everywhere (group headers, stat tiles, the sidebar). A soft drop under it,
	-- a face with a vertical ramp and a lit edge, the GlassIcon centred on top. Returns the
	-- holder and the GlassIcon tile (paint the tile; the plate itself never changes).
	local PLATE_EDGE_HI, PLATE_EDGE_LO = hex("#5C6473"), hex("#20242B")
	function Library:IconPlate(parent, iconName, size, iconSize, z)
		size = size or 24
		iconSize = iconSize or math.floor(size * 0.58)
		z = z or ((parent and parent.ZIndex or 1) + 1)
		local holder = Library:New("Frame", {
			Name = "Plate",
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(size, size),
			ZIndex = z,
			Parent = parent,
		})
		local r = math.max(5, math.floor(size * 0.29))
		local shadow = Library:New("Frame", {
			Name = "Shadow",
			BackgroundColor3 = Colors.bg,
			-- owner 2026-11-01 ("shadows ... not centered", twice): a soft rim one px round the plate,
			-- centred on it, no drop
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.new(1, 2, 1, 2),
			ZIndex = z,
			Parent = holder,
		})
		Library:Round(r + 1).Parent = shadow
		local face = Library:New("Frame", {
			Name = "Face",
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 1, 0),
			ZIndex = z + 1,
			Parent = holder,
		})
		Library:Round(r).Parent = face
		local hi = Colors.window:Lerp(Color3.new(1, 1, 1), 0.07)
		Library:New("UIGradient", {
			Name = "Ramp", Rotation = 90, Parent = face,
			Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, hi), ColorSequenceKeypoint.new(1, Colors.window) }),
		})
		local edge = Library:Stroke(hex("#BFC4CC"), 1, 0)
		edge.Parent = face
		Library:New("UIGradient", {
			Name = "Lit", Rotation = 90, Parent = edge,
			Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, PLATE_EDGE_HI), ColorSequenceKeypoint.new(1, PLATE_EDGE_LO) }),
		})
		local tile = Library:GlassIcon(face, "", iconName, iconSize)
		tile.AnchorPoint = Vector2.new(0.5, 0.5)
		tile.Position = UDim2.new(0.5, 0, 0.5, 0)
		tile.ZIndex = z + 2
		local img = tile:FindFirstChild("Img")
		if img then img.ZIndex = z + 3 end
		local glyph = tile:FindFirstChild("Glyph")
		if glyph then glyph.ZIndex = z + 3 end
		Library:PaintIconPlate(holder, "idle", true)
		Library:PaintGlassIcon(tile, "idle", true)
		return holder, tile
	end
	-- the plate itself has two states: at rest the lit edge is dimmed by the #BFC4CC stroke
	-- colour; active (the open tab) lifts the face a step and lets the edge show at full white
	local PLATE_FACE_REST = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Colors.window:Lerp(Color3.new(1, 1, 1), 0.07)),
		ColorSequenceKeypoint.new(1, Colors.window),
	})
	local PLATE_FACE_ACTIVE = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Colors.window:Lerp(Color3.new(1, 1, 1), 0.16)),
		ColorSequenceKeypoint.new(1, Colors.window:Lerp(Color3.new(1, 1, 1), 0.05)),
	})
	function Library:PaintIconPlate(plate, state, instant)
		if not plate then return end
		local face = plate:FindFirstChild("Face")
		if not face then return end
		local edge = face:FindFirstChildOfClass("UIStroke")
		local ramp = face:FindFirstChild("Ramp")
		local active = state == "active"
		-- the state stays on the plate: a theme change repaints the plate and its icon from it
		-- (owner 2026-11-01: icons kept the old theme's colour until the pointer repainted them)
		plate:SetAttribute("CorvusPaint", state)
		if ramp then ramp.Color = active and PLATE_FACE_ACTIVE or PLATE_FACE_REST end
		if edge then
			-- owner 2026-11-01 ("when theme is picked and tab selected dont make it change color to
			-- white again"): under a theme the active edge is the theme's bright - the chrome #F2F3F5
			-- tinted by the theme, so the registry keeps the base and the next theme (or the moving
			-- RGB) re-tints the edge from its state; white on Silver
			local bright = rawget(Library, "_themeTint") and Colors.text or Color3.new(1, 1, 1)
			Library:ThemeSet(edge, "Color", active and bright or hex("#BFC4CC"), instant and 0 or 0.12, Enum.EasingStyle.Linear)
		end
	end

	-- Soft silver glow (mockup box-shadow 0 0 12px rgba(206,211,220,.3)) built from three
	-- concentric rounded frames: no image asset (rbxassetid 6014261993 renders as a grey
	-- square, 2026-10-19). Library:GlowLayers fills a holder; Library:SetGlow(holder, 0..1)
	-- fades it; Library:Glow makes a SIBLING holder centred on a target (a child would draw
	-- above its parent; only for parents without a UIListLayout).
	local GLOW_LAYERS = { { 0, 0.72 }, { 6, 0.88 } }   -- pad, transparency at full strength (2 layers: draw cost)
	function Library:GlowLayers(holder, radius, color)
		for i, l in ipairs(GLOW_LAYERS) do
			local f = Library:New("Frame", {
				Name = "L" .. i,
				BackgroundColor3 = color or Colors.metalLo,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, 0.5, 0),
				Size = UDim2.new(1, l[1] * 2, 1, l[1] * 2),
				ZIndex = holder.ZIndex,
				Parent = holder,
			})
			Library:Round(math.min(999, (radius or 8) + l[1])).Parent = f
			f:SetAttribute("Full", l[2])
		end
		return holder
	end
	function Library:SetGlow(holder, strength, t)
		if not holder then return end
		strength = math.clamp(tonumber(strength) or 0, 0, 1)
		for _, f in ipairs(holder:GetChildren()) do
			local full = f:GetAttribute("Full")
			if full then
				local target = 1 - (1 - full) * strength
				if (t or 0) <= 0 then f.BackgroundTransparency = target
				else Library:NewTween(f, t, { BackgroundTransparency = target }) end
			end
		end
	end
	function Library:Glow(target, opts)
		opts = opts or {}
		local parent = target and target.Parent
		if not parent then return nil end
		local ax, ay = target.AnchorPoint.X, target.AnchorPoint.Y
		local p, s = target.Position, target.Size
		local holder = Library:New("Frame", {
			Name = tostring(target.Name) .. "Glow",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(
				p.X.Scale + (0.5 - ax) * s.X.Scale, p.X.Offset + (0.5 - ax) * s.X.Offset,
				p.Y.Scale + (0.5 - ay) * s.Y.Scale, p.Y.Offset + (0.5 - ay) * s.Y.Offset),
			Size = s,
			ZIndex = math.max(0, (target.ZIndex or 1) - 1),
			Parent = parent,
		})
		Library:GlowLayers(holder, opts.Radius or 999, opts.Color)
		Library:SetGlow(holder, opts.Strength or 0, 0)
		if rawget(Library, "LowEffects") == true then holder.Visible = false end
		return holder
	end

	-- W2 bezel light (owner 2026-10-19 "WOW"): a transparent overlay frame with a 2 px
	-- stroke whose UIGradient is opaque on ONE side and clear elsewhere; the gradient's
	-- Rotation tweens 0 -> 360 forever, so a reflection walks around the frame like light
	-- on a titanium bezel. Engine-side tween: nothing runs per frame in Luau. Low effects
	-- hides it. Inset = thickness for clipping parents (the window), 0 for cards.
	local BEZEL_EDGE = hex("#2C2D36")
	local function tintRatio(dark, bright)
		return Color3.new(dark.R / math.max(bright.R, 0.001), dark.G / math.max(bright.G, 0.001), dark.B / math.max(bright.B, 0.001))
	end
	rawset(Library, "_bezels", rawget(Library, "_bezels") or {})
	function Library:BezelLight(frame, opts)
		opts = opts or {}
		if not frame then return nil end
		local old = frame:FindFirstChild("Bezel")
		if old then
			local st0 = old:FindFirstChildOfClass("UIStroke")
			return st0 and st0:FindFirstChild("BezelLight") or nil
		end
		local th = opts.Thickness or 2
		local inset = opts.Inset or 0
		local overlay = Library:New("Frame", {
			Name = "Bezel",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.new(0, inset, 0, inset),
			Size = UDim2.new(1, -2 * inset, 1, -2 * inset),
			ZIndex = opts.ZIndex or 95,
			Visible = rawget(Library, "LowEffects") ~= true,
			Parent = frame,
		})
		Library:Round(math.max(2, (opts.Radius or 18) - inset)).Parent = overlay
		local st = Library:Stroke(opts.Color or Colors.metalHi, th, 0)
		st.Parent = overlay
		local g = Instance.new("UIGradient")
		g.Name = "BezelLight"
		g.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, opts.Peak or 0.08),
			NumberSequenceKeypoint.new(0.1, 0.35),
			NumberSequenceKeypoint.new(opts.Width or 0.3, 1),
			NumberSequenceKeypoint.new(1, 1),
		})
		g.Rotation = opts.Rotation or 200
		g.Parent = st
		-- de-AI pass 2026-10-19: no endless spin. The light rests on one corner and only runs one
		-- lap when the window opens (BezelSweep): one orchestrated moment instead of constant motion.
		local tween = { Play = function() end, Pause = function() end }
		table.insert(Library._bezels, { Frame = overlay, Stroke = st, Gradient = g, Tween = tween })
		return g
	end
	-- one fast lap (boot / restore), then the light rests where it started
	function Library:BezelSweep(g, t)
		if not g then return end
		for _, e in ipairs(Library._bezels) do
			if e.Gradient == g then
				if rawget(Library, "LowEffects") == true then return end
				e.Tween:Pause()
				local from = g.Rotation % 360
				g.Rotation = from
				local fast = TweenService:Create(g, TweenInfo.new(t or 0.9, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Rotation = from + 360 })
				fast:Play()
				fast.Completed:Once(function()
					if e.Gradient.Parent then
						g.Rotation = from
						e.Tween:Play()
					end
				end)
				return
			end
		end
	end
	function Library:SetBezelsEnabled(on)
		for _, e in ipairs(Library._bezels) do
			if e.Frame.Parent then
				e.Frame.Visible = on == true
				if on then e.Tween:Play() else e.Tween:Pause() end
			end
		end
	end

	-- W3 cursor spotlight: while the pointer is over a card, the lit side of its edge faces
	-- the pointer (the "border glow" of Linear / Vercel cards, unseen in Roblox hubs). One
	-- Rotation write per pointer move, nothing per frame, no clip, no extra frames.
	function Library:Spotlight(frame, strokeInst, opts)
		opts = opts or {}
		if not frame or not strokeInst then return nil end
		local dark, bright = opts.Edge or Colors.cardEdge or BEZEL_EDGE, opts.Color or Colors.metalMid
		local base = tintRatio(dark, bright)
		local flat = ColorSequence.new(base)
		local lit = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
			ColorSequenceKeypoint.new(0.42, base),
			ColorSequenceKeypoint.new(1, base),
		})
		strokeInst.Color = bright
		local g = Instance.new("UIGradient")
		g.Name = "Spot"
		g.Color = flat
		g.Parent = strokeInst
		local conn
		local function aim(pos)
			if not frame.Parent then
				if conn then conn:Disconnect() conn = nil end
				return
			end
			local c = frame.AbsolutePosition + frame.AbsoluteSize / 2
			local d = Vector2.new(pos.X, pos.Y) - c
			if d.Magnitude < 1 then return end
			-- Rotation 0 puts keypoint 0 on the LEFT edge (direction 180 deg): light at angle a needs a - 180
			g.Rotation = math.deg(math.atan2(d.Y, d.X)) - 180
		end
		local th0 = strokeInst.Thickness
		frame.MouseEnter:Connect(function()
			if rawget(Library, "LowEffects") == true then return end
			g.Color = lit
			Library:NewTween(strokeInst, 0.15, { Thickness = th0 + 0.6 })
			if conn then conn:Disconnect() end
			conn = UserInputService.InputChanged:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseMovement then aim(input.Position) end
			end)
			pcall(function()
				local inset = game:GetService("GuiService"):GetGuiInset()
				aim(UserInputService:GetMouseLocation() - inset)
			end)
		end)
		frame.MouseLeave:Connect(function()
			if conn then conn:Disconnect() conn = nil end
			g.Color = flat
			Library:NewTween(strokeInst, 0.2, { Thickness = th0 })
		end)
		return g
	end

	-- Silver crow mark (owner 2026-10-19): the Corvus raven PNG inside a dark disc with a
	-- metal rim. The file comes from the Loader / dev deploy (Corvus/assets); without it the
	-- disc falls back to the metal + play glyph so the brand never renders empty.
	-- owner 2026-11-01 ("the silver corvus with transparency"): the 200 px cut-out crow first (alpha
	-- bounds 10,33 - 190,167, shown whole); the 256 px file has a starfield margin and is cropped to
	-- the bird when it is the one found
	local CrowFiles = { "Corvus/assets/CorvusLogo_201.png", "Corvus/assets/CorvusCrow_256.png" }
	local crowAsset = nil
	local crowFile = nil
	function Library:GetCrowAsset()
		if crowAsset ~= nil then return crowAsset or nil end
		crowAsset = false
		if type(getcustomasset) == "function" and type(isfile) == "function" then
			for _, path in ipairs(CrowFiles) do
				local okF, has = pcall(isfile, path)
				if okF and has then
					local ok, id = pcall(getcustomasset, path)
					if ok and type(id) == "string" and id ~= "" then
						crowAsset = id
						crowFile = path
						break
					end
				end
			end
		end
		return crowAsset or nil
	end
	function Library:CrowMark(parent, size, z)
		size = size or 26
		z = z or ((parent and parent.ZIndex or 1) + 1)
		local disc = Library:New("Frame", {
			Name = "Mark",
			BackgroundColor3 = Colors.window,
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			Size = UDim2.new(0, size, 0, size),
			ZIndex = z,
			Parent = parent,
		})
		-- owner 2026-10-31 ("dont make it so round that pfp", evening: "pfp bez outline"): the picture
		-- alone, a rounded square (6 px corners on 28), no backing disc and no rim
		local R = math.max(3, math.floor(size * 0.22))
		local id = Library:GetCrowAsset()
		if id then
			disc.BackgroundTransparency = 1
			Library:Round(R).Parent = disc
			local img = Library:New("ImageLabel", {
				Name = "Crow",
				BackgroundTransparency = 1,
				Image = id,
				ScaleType = Enum.ScaleType.Fit,
				Size = UDim2.new(1, 0, 1, 0),
				ZIndex = z + 1,
				Parent = disc,
			})
			if crowFile and string.find(crowFile, "_256", 1, true) then
				-- the 256 px source has a wide starfield margin: crop to the bird so it fills the disc
				img.ScaleType = Enum.ScaleType.Crop
				img.ImageRectOffset = Vector2.new(30, 22)
				img.ImageRectSize = Vector2.new(200, 200)
			else
				-- the cut-out: its alpha bounds, so the bird fills the mark's width
				img.ImageRectOffset = Vector2.new(10, 33)
				img.ImageRectSize = Vector2.new(180, 134)
			end
			Library:Round(R).Parent = img
		else
			-- Farm 2026-10-20: no crow file on this executor -> plain soft-grey square, no glyph, no rim.
			disc.BackgroundColor3 = Colors.well
			disc.BackgroundTransparency = 0
			Library:Round(R).Parent = disc
		end
		return disc
	end

	-- state: "idle" | "hover" | "active"
	function Library:PaintGlassIcon(tile, state, instant)
		if not tile then return end
		local t = instant and 0 or 0.12
		local img, glyph = tile:FindFirstChild("Img"), tile:FindFirstChild("Glyph")
		-- slate at rest, bone-mid under the pointer, bone when active: colour is the state
		-- under a theme the active icon is the theme's bright, not white (owner 2026-11-01); the paint
		-- goes through the theme registry, so a later theme re-tints it from this state's base
		-- chrome bases only (GLYPH0, never the already-tinted Colors.glyph): ThemeSet keeps a chrome
		-- base in the registry, so every later theme re-tints the icon from its state (owner
		-- 2026-11-01: idle icons kept the old theme's colour until the pointer repainted them)
		local bright = rawget(Library, "_themeTint") and Colors.text or Colors.moon
		local base = (state == "active" and bright) or (state == "hover" and Colors.textMid) or GLYPH0
		-- a picture icon (game asset) keeps its own colours
		if img and tile:GetAttribute("Picture") ~= true then Library:ThemeSet(img, "ImageColor3", base, t, Enum.EasingStyle.Linear) end
		if glyph then Library:NewTween(glyph, t, { TextColor3 = Library:ThemeColor(base) }, Enum.EasingStyle.Linear) end
	end
end

