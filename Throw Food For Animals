				local okG, gid = pcall(function() return game.PlaceId == placeId and tonumber(game.GameId) or nil end)
				if okG and gid and gid > 0 then
					universeIds[placeId] = gid
					return gid
				end
				local okB, body = pcall(game.HttpGet, game, string.format("https://apis.roblox.com/universes/v1/places/%d/universe", placeId))
				local id = okB and type(body) == "string" and tonumber(body:match('"universeId"%s*:%s*(%d+)')) or nil
				if id then universeIds[placeId] = id end
				return id
			end
			local function playGame(entry)
				pcall(function()
					local queue = queue_on_teleport or queueonteleport or (typeof(syn) == "table" and syn.queue_on_teleport)
					if type(queue) == "function" and type(loader) == "string" and loader ~= "" then
						queue("if not game:IsLoaded() then game.Loaded:Wait() end " .. loader)
					end
				end)
				if type(Library.CorvusLog) == "function" then
					pcall(Library.CorvusLog, Library, string.format("PLAY %s (%s)", tostring(entry.Name), tostring(entry.PlaceId)))
				end
				Library:Notify("Teleporting to " .. tostring(entry.Name), 4)
				local okT, err = pcall(function() game:GetService("TeleportService"):Teleport(tonumber(entry.PlaceId), LocalPlayer) end)
				if not okT then Library:Notify("Teleport failed: " .. tostring(err), 5) end
			end
