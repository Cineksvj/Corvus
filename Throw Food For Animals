	-- The best food you own and the best unlocked one you can afford (bait = how much food a throw carries).
	local function bestFoods(budget)
		if not (FoodsConfig and type(FoodsConfig.All) == "table") then
			return nil, nil
		end
		local bestOwned, bestBuy
		for _, food in ipairs(FoodsConfig.All) do
			local locked = FoodsConfig.IsLocked and call(FoodsConfig.IsLocked, food.Index)
			if not locked then
				local owned = food.Index == 1 or DP("OwnedFoods." .. food.Index) == true
				if owned then
					if not bestOwned or food.Bait > bestOwned.Bait then
						bestOwned = food
					end
				elseif num(food.Price) <= budget and (not bestBuy or food.Bait > bestBuy.Bait) then
					bestBuy = food
				end
			end
		end
		return bestOwned, bestBuy
	end
