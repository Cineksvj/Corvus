	local function startTraining()
		ensurePatched()
		if os.clock() < st.trainRetryAt then
			return
		end
		if num(D("Stand")) < 1 then
			fail("no pull-up bar yet (buy one in Plot)")
			st.trainRetryAt = os.clock() + 5
			return
		end
		local pos = trainPos()
		if not pos then
			fail("plot not found")
			st.trainRetryAt = os.clock() + 2
			return
		end
		goTo(pos, 3)
		local r = inv("Training_Start")
		if r.Ok then
			st.training = true
			st.trainStart = os.clock()
			st.sessions += 1
			return
		end
		fail("TrainStart:" .. tostring(r.Reason))
		if r.Reason == "TooFar" then
			tp(pos)
			st.trainRetryAt = os.clock() + 0.3
		elseif cfg.farm then
			st.hybridBlockedUntil = os.clock() + 60
			note("hybrid paused 60s: " .. tostring(r.Reason))
		else
			st.trainRetryAt = os.clock() + 1.5
		end
	end
	local function stopTraining()
		if st.training then
			st.trainTotal += os.clock() - st.trainStart
		end
		st.training = false
		st.lastTrainStop = os.clock()
		inv("Training_Stop")
	end
