		local gameName = (windowOpts.FooterGame and windowOpts.Footer) or windowOpts.Game or nil
		local hopping = false
		local function hopServer(mode)
			if hopping then return end
			hopping = true
			Library:Notify("Looking for a server", 2)
			task.spawn(function()
				local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100", game.PlaceId)
				local data
				local okB, body = pcall(function() return game:HttpGet(url) end)
				if okB and type(body) == "string" then
					local HttpService = game:GetService("HttpService")
					local okJ, dec = pcall(HttpService.JSONDecode, HttpService, body)
					if okJ and type(dec) == "table" and type(dec.data) == "table" then data = dec.data end
				end
				if not data then
					hopping = false
					return Library:Notify("Server list failed, try again in a moment", 3)
				end
				local list = {}
				for _, sv in ipairs(data) do
					if type(sv) == "table" and type(sv.id) == "string" and sv.id ~= game.JobId
						and (tonumber(sv.playing) or 0) < (tonumber(sv.maxPlayers) or math.huge) then
						table.insert(list, sv)
					end
				end
				if #list == 0 then
					hopping = false
					return Library:Notify("No other server has room", 3)
				end
				local pick = list[math.random(1, #list)]
				if mode == "small" then
					pick = list[1]
					for _, sv in ipairs(list) do
						if (tonumber(sv.playing) or 0) < (tonumber(pick.playing) or 0) then pick = sv end
					end
				end
				if type(Library.CorvusLog) == "function" then
					pcall(Library.CorvusLog, Library, string.format("HOP %s -> %s (%d players)", tostring(mode), tostring(pick.id), tonumber(pick.playing) or 0))
				end
				Library:Notify(string.format("Joining a server with %d players", tonumber(pick.playing) or 0), 3)
				queueRejoin()
				pcall(function() game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, pick.id, LocalPlayer) end)
				task.delay(8, function() hopping = false end)
			end)
		end
