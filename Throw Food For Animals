					Name = "CorvusMiniDrop",
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Visible = false,
					ZIndex = 19,
					Parent = screenGui,
				})
				Library:Round(99).Parent = fxDrop
				for _, spec in ipairs({ { 2, 0.72 }, { 6, 0.9 } }) do
					Library:Stroke(Colors.bg, spec[1], spec[2]).Parent = fxDrop
				end
				local fxRim = Library:New("Frame", {
					Name = "CorvusMiniRim",
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Visible = false,
					ZIndex = 21,
					Parent = screenGui,
				})
				local rimCorner = Library:Round(99)
				rimCorner.Parent = fxRim
				Library:Stroke(hex("#07080A"), 1, 0.4).Parent = fxRim
				local function syncFx()
					local vis = pill.Visible and rawget(Library, "LowEffects") ~= true
					fxDrop.Visible, fxRim.Visible = vis, vis
					if not vis then return end
					local p = pill.AbsolutePosition - screenGui.AbsolutePosition
					local s = pill.AbsoluteSize
					fxDrop.Position = UDim2.fromOffset(p.X, p.Y + 1)
					fxDrop.Size = UDim2.fromOffset(s.X, s.Y)
					fxRim.Position = UDim2.fromOffset(p.X + 1, p.Y + 1)
					fxRim.Size = UDim2.fromOffset(math.max(0, s.X - 2), math.max(0, s.Y - 2))
					rimCorner.CornerRadius = UDim.new(0, math.max(1, math.floor(s.Y / 2) - 1))
				end
				for _, prop in ipairs({ "AbsolutePosition", "AbsoluteSize", "Visible" }) do
					Library:GiveSignal(pill:GetPropertyChangedSignal(prop):Connect(syncFx))
				end
				rawset(self, "_islandFx", { Drop = fxDrop, Rim = fxRim, Sync = syncFx })
			end
			self.MiniPill = pill
		end
		local function showIsland()
			local vp = Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
			local x = vp.X / 2
			if type(Library.GetSetting) == "function" then
				local ok, saved = pcall(Library.GetSetting, Library, "IslandX", nil)
				if ok and tonumber(saved) then x = math.clamp(tonumber(saved), 140, vp.X - 140) end
			end
			pill.Size = UDim2.new(0, 0, 0, ISLAND_H)
			-- IgnoreGuiInset ScreenGui: its origin sits above the screen by the top inset (58 px
			-- live), so "10 px from the top of the screen" is inset + 10 in gui space
			local inset = math.max(0, -screenGui.AbsolutePosition.Y)
			pill.Position = UDim2.new(0, x, 0, inset + 10)
			pill.Visible = true
			local full = Library.UIScale or 1
			if rawget(Library, "LowEffects") ~= true and wasVisible then
				-- the island pops in (Back) as the window leaves
				islandScale.Scale = full * 0.6
				Library:NewTween(islandScale, 0.38, { Scale = full }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			else
				islandScale.Scale = full
			end
		end
		if wasVisible and rawget(Library, "LowEffects") ~= true then
			-- the window's UIScale winds up a hair and shrinks (Back-in) while the frame slides to the
			-- island's spot, the veil closes over the pages on the way, the corners round into a pill,
			-- the comet runs along the top edge and the island pops out as the frame lands
			local a = beginAnim()
			pcall(playMinimizeComet, true)
			local kEnd, pos = islandTarget(a.Scale)
			local info = TweenInfo.new(MIN_T, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			play(a, mainScale, info, { Scale = kEnd })
			play(a, main, info, { Position = pos })
			if mainCorner then play(a, mainCorner, info, { CornerRadius = UDim.new(0.5, 0) }) end
			play(a, veilCorner, info, { CornerRadius = UDim.new(0.5, 0) })
			play(a, veil, TweenInfo.new(MIN_T * 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 0 })
			task.delay(MIN_T * 0.62, function()
				if animSeq ~= my then return end
				showIsland()
			end)
			task.delay(MIN_T, function()
				if animSeq ~= my then return end
				main.Visible = false
				finishAnim()
				pcall(applyBlur)
			end)
		else
			finishAnim()
			main.Visible = false
			pcall(applyBlur)
			showIsland()
		end
		if self.Starfield then pcall(self.Starfield.SetActive, self.Starfield, false) end
		if type(Library.CorvusLog) == "function" then pcall(Library.CorvusLog, Library, "HUB minimized to island") end
		return self
	end
	function window:Restore()
		rawset(self, "_shown", true)
		animSeq += 1
		local my = animSeq
		local wasVisible = main.Visible
		local pill = self.MiniPill
		if pill and (pill.Visible or winAnim) and rawget(Library, "LowEffects") ~= true and islandScale then
			-- the island folds away and the window grows out of its spot back to its place, landing
			-- with a little mass (Back-out) while the veil lifts off the pages; the comet runs the
			-- other way. Caught mid-minimize it turns round from where the frame is.
			local a = beginAnim()
			local kEnd, pos = islandTarget(a.Scale)
			local full = Library.UIScale or islandScale.Scale
			if pill.Visible then
				Library:NewTween(islandScale, 0.14, { Scale = full * 0.6 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			end
			task.delay(0.14, function()
				if animSeq ~= my then return end
				pill.Visible = false
				islandScale.Scale = full
			end)
			if not wasVisible then
				mainScale.Scale, main.Position = kEnd, pos
				if mainCorner then mainCorner.CornerRadius = UDim.new(0.5, 0) end
				veilCorner.CornerRadius = UDim.new(0.5, 0)
				veil.BackgroundTransparency = 0
			end
			main.Visible = true
			rawset(Library, "Toggled", true)
			if self.Starfield then pcall(self.Starfield.SetActive, self.Starfield, true) end
			pcall(applyBlur)
			local info = TweenInfo.new(RES_T, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			play(a, mainScale, info, { Scale = a.Scale })
			play(a, main, info, { Position = a.Position })
			if mainCorner and a.Corner then play(a, mainCorner, info, { CornerRadius = a.Corner }) end
			play(a, veilCorner, info, { CornerRadius = UDim.new(0, 12) })
			play(a, veil, TweenInfo.new(RES_T * 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, RES_T * 0.2), { BackgroundTransparency = 1 })
			task.delay(RES_T, function()
				if animSeq ~= my then return end
				finishAnim()
			end)
			pcall(playMinimizeComet, false)
		else
			finishAnim()
			if pill then pill.Visible = false end
			self:SetVisible(true)
		end
		return self
	end
	-- Library:Toggle([state]) - the toggle key goes window <-> island (owner 2026-11-01: the island
	-- is the closed hub); the topbar's x hides the hub whole, island included, until the key
	-- brings the window back (Library:HideHub)
	function Library:Toggle(state)
		local v = state
		if v == nil then v = rawget(window, "_shown") ~= true end
		if v then window:Restore() else window:Minimize() end
		return v
	end
	function Library:HideHub()
		rawset(window, "_shown", false)
		animSeq += 1
		finishAnim()
		local pill = window.MiniPill
		if pill then pill.Visible = false end
		window:SetVisible(false)
	end
