-- Hub-wide stop / resume (the per-tab pills do the same per tab). Resume restores the
-- toggles the user had ON before the last stop (Library._userOn is kept by every toggle).
function Library:StopAllToggles()
	local remembered = {}
	Library._batchSuppress = true
	for flag, t in pairs(Library.Toggles) do
		if typeof(t) == "table" and t.Value and typeof(t.SetValue) == "function" then
			if typeof(flag) == "string" then table.insert(remembered, flag) end
			pcall(function() t:SetValue(false) end)
		end
	end
	Library._batchSuppress = false
	if #remembered > 0 then Library._resumeAll = remembered end
	Library:CorvusLog("STOPALL toggles=" .. #remembered)
	for _, tab in pairs(Library.Tabs) do
		if typeof(tab) == "table" and typeof(tab._refreshNavPill) == "function" then pcall(tab._refreshNavPill, tab) end
	end
	return #remembered
end
function Library:ResumeToggles()
	local set = Library._resumeAll
	if typeof(set) ~= "table" or #set == 0 then
		set = {}
		for flag, on in pairs(rawget(Library, "_userOn") or {}) do
			if on then table.insert(set, flag) end
		end
	end
	Library._batchSuppress = true
	local n = 0
	for _, flag in ipairs(set) do
		local t = Library.Toggles[flag]
		if typeof(t) == "table" and typeof(t.SetValue) == "function" then
			pcall(function() t:SetValue(true) end)
			n += 1
		end
	end
	Library._batchSuppress = false
	Library:CorvusLog("RESUME toggles=" .. n)
	for _, tab in pairs(Library.Tabs) do
		if typeof(tab) == "table" and typeof(tab._refreshNavPill) == "function" then pcall(tab._refreshNavPill, tab) end
	end
	return n
end
