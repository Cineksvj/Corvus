	function Library:SetFocusBlur(v)
		v = v == true
		rawset(Library, "FocusBlur", v)
		if type(Library.SetSetting) == "function" then pcall(Library.SetSetting, Library, "FocusBlur", v) end
		pcall(applyBlur)
		if type(Library.CorvusLog) == "function" then pcall(Library.CorvusLog, Library, "BLUR " .. (v and "on" or "off")) end
	end
	do
		if type(Library.GetSetting) == "function" then
			-- a BlurEffect costs a phone GPU whole frames (Discord 2026-11-02): off by default on touch, on
			-- elsewhere; a saved choice wins either way
			local ok, v = pcall(Library.GetSetting, Library, "FocusBlur", nil)
			rawset(Library, "FocusBlur", if ok and v ~= nil then v == true else rawget(Library, "Touch") ~= true)
		end
		local function killBlur()
			pcall(function()
				local b = game:GetService("Lighting"):FindFirstChild("CorvusFocusBlur")
				if b then b:Destroy() end
			end)
		end
		local ou = rawget(Library, "OnUnload")
		if type(ou) == "function" then pcall(ou, Library, killBlur)
		elseif type(ou) == "table" then table.insert(ou, killBlur) end
	end
	function window:SetVisible(v)
		v = v ~= false
		rawset(self, "_shown", v)
		local was = main.Visible
		main.Visible = v
		rawset(Library, "Toggled", v)
		if self.Starfield then pcall(self.Starfield.SetActive, self.Starfield, v) end
		if v and not was then pcall(popIn) end
		pcall(applyBlur)
		return self
	end
