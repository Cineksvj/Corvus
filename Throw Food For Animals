-- groupbox:AddRanking({ Rows = 5 }) -> rk:Set({ {label, value, ratio, note}, ... })
-- Fixed 24 px rows: label (13px), right mono value, 3 px metal bar = ratio. Top row brighter.
function Groupbox:AddRanking(props)
    props = props or {}
    local rows = math.clamp(tonumber(props.Rows) or 5, 1, 10)
    -- starts one row tall (the "Empty" line); Set grows it to the rows it shows
    local holder = makeRow(self, 24, "Ranking")
    local items = {}
    for i = 1, rows do
        local r = new("Frame", {
            Name = "R" .. i,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 24),
            Position = UDim2.new(0, 0, 0, (i - 1) * 24),
            Visible = false,
            Parent = holder,
        })
        local label = text({
            Name = "Label",
            Text = "",
            TextSize = 12,
            FontFace = i == 1 and Fonts.SansMed or Fonts.Sans,
            TextColor3 = i == 1 and Colors.Ink or TEXT_MID,
            Size = UDim2.new(1, -92, 0, 14),
            Position = UDim2.new(0, 0, 0, 1),
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = r,
        })
        label.RichText = true
        local value = text({
            Name = "Value",
            Text = "",
            TextSize = 11,
            FontFace = Fonts.Mono,
            TextColor3 = i == 1 and Colors.Moon or Colors.Brushed,
            TextXAlignment = Enum.TextXAlignment.Right,
            Size = UDim2.new(0, 88, 0, 14),
            Position = UDim2.new(1, -88, 0, 1),
            Parent = r,
        })
        local track = new("Frame", {
            Name = "Track",
            BackgroundColor3 = Colors.Well,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 3),
            Position = UDim2.new(0, 0, 0, 18),
            Parent = r,
        })
        corner(2, track)
        local fill = new("Frame", {
            Name = "Fill",
            BackgroundColor3 = Colors.Moon,
            BackgroundTransparency = i == 1 and 0 or 0.3,
            BorderSizePixel = 0,
            Size = UDim2.new(0, 0, 1, 0),
            Parent = track,
        })
        corner(2, fill)
        applyGradient(fill, Gradients.Metal135, 0)
        items[i] = { Row = r, Label = label, Value = value, Fill = fill }
    end
    local empty = text({
        Name = "Empty",
        Text = props.Empty or "Nothing planned yet",
        TextSize = 12,
        FontFace = Fonts.Sans,
        TextColor3 = Colors.Smoke,
        Size = UDim2.new(1, 0, 0, 24),
        Parent = holder,
    })
    local rk = { Type = "Ranking", Instance = holder, Rows = items }
    function rk:Set(list)
        list = type(list) == "table" and list or {}
        empty.Visible = #list == 0
        for i, it in ipairs(items) do
            local d = list[i]
            if type(d) == "table" and d.label then
                local lbl = tostring(d.label)
                if d.note and d.note ~= "" then
                    lbl = lbl .. '  <font color="#7F8389">' .. tostring(d.note) .. "</font>"
                end
                if it.Label.Text ~= lbl then it.Label.Text = lbl end
                local val = tostring(d.value or "")
                if it.Value.Text ~= val then it.Value.Text = val end
                local ratio = math.clamp(tonumber(d.ratio) or 0, 0, 1)
                local target = UDim2.new(ratio, 0, 1, 0)
                if it.Fill.Size ~= target then tween(it.Fill, 0.3, nil, { Size = target }) end
                if not it.Row.Visible then it.Row.Visible = true end
            elseif it.Row.Visible then
                it.Row.Visible = false
            end
        end
        local n = 0
        for i = 1, #items do if items[i].Row.Visible then n = i end end
        holder.Size = UDim2.new(1, 0, 0, math.max(1, n) * 24)
    end
    table.insert(self._controls, rk)
    return rk
end

