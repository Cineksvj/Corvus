	-- Sell filters (owner 2026-10-31 night: dropdowns by mutation, pet name, rarity and area). The
	-- game has Plot_SellAnimal(id) next to Plot_SellAll, so the hub can sell one pet at a time: a
	-- pet is sold when its rarity, its mutation (Normal = none) and its area all pass and its name
	-- is not on the Never sell list. Pets on the plot (Placed) and bought pets (Bought) are never
	-- touched, and the hub never calls Plot_SellAll (owner 2026-11-01): one Plot_SellAnimal per pet,
	-- every pet re-read right before its call.
	local RarityConfig = sreq(child(Config, "RarityConfig"), "Config.RarityConfig")
	local MutationsConfig = sreq(child(Config, "MutationsConfig"), "Config.MutationsConfig")
	local AreasConfig = sreq(child(Config, "AreasConfig"), "Config.AreasConfig")
	local AnimalsData = sreq(ReplicatedStorage:FindFirstChild("AnimalsData"), "AnimalsData")
	local function names(list)
		local out = {}
		for _, e in ipairs(if type(list) == "table" then list else {}) do
			if type(e) == "table" and e.Name ~= nil then
				table.insert(out, tostring(e.Name))
