		end
		local areaPics = if type(IconImages) == "table" and type(IconImages.Areas) == "table" then IconImages.Areas else {}
		local petPics = if type(IconImages) == "table" and type(IconImages.Animals) == "table" then IconImages.Animals else {}
		for _, area in ipairs((AreasConfig and AreasConfig.All) or {}) do
