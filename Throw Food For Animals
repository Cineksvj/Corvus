	end
	-- model name -> { name, rarity, area }: AreasConfig lists the areas, AnimalsData the animals of
	-- each area in order, the area's RarityPattern gives the rarity by that order
	local animalInfo
	local function animalIndex()
		if animalInfo then
			return animalInfo
		end
		animalInfo = {}
		if AreasConfig and type(AreasConfig.All) == "table" and type(AnimalsData) == "table" then
			for _, area in ipairs(AreasConfig.All) do
				local list = AnimalsData[area.Key]
				local pattern = if type(area.RarityPattern) == "table" then area.RarityPattern else {}
				if type(list) == "table" then
					for i, a in ipairs(list) do
						if type(a) == "table" and a.ModelName then
							animalInfo[tostring(a.ModelName)] = {
								name = tostring(a.Name or a.ModelName),
								rarity = tostring(pattern[i] or "?"),
								area = tostring(area.Name or area.Key),
							}
						end
					end
				end
			end
		end
		return animalInfo
	end
	local function has(set, key)
		return type(set) == "table" and set[key] == true
	end
	local function allOf(set, list)
		for _, k in ipairs(list) do
			if not has(set, k) then
				return false
			end
		end
		return true
	end
	function N.sellFilterIsAll()
		local SV = N.SellValues
		return allOf(cfg.sellRarities, SV.rarities)
			and allOf(cfg.sellMutations, SV.mutations)
			and allOf(cfg.sellAreas, SV.areas)
			and next(cfg.neverSell or {}) == nil
			and not cfg.sellUnderIncomeOn
			and not cfg.sellUnderKgOn
	end
	-- the bag pets that pass the filters ({ id, name } each), the bag size and the plot count
	function N.sellPicks()
		local picks, bag, placed = {}, 0, 0
		local animals = D("Animals")
		if type(animals) ~= "table" then
			return picks, bag, placed
		end
		local index = animalIndex()
		for id, e in pairs(animals) do
			if type(e) == "table" then
				if e.Placed then
					placed += 1
				elseif not e.Bought then
					bag += 1
					local info = index[tostring(e.ModelName)]
					local mutation = if type(e.Mutation) == "string" and e.Mutation ~= "" then e.Mutation else "Normal"
					local pass = info ~= nil
						and has(cfg.sellRarities, info.rarity)
						and has(cfg.sellMutations, mutation)
						and has(cfg.sellAreas, info.area)
						and not has(cfg.neverSell, info.name)
					-- the thresholds: a pet is sold only when it is under the value (a threshold
					-- of 0 with its switch on sells nothing, which is what "under 0" says)
					if pass and (cfg.sellUnderIncomeOn or cfg.sellUnderKgOn) then
						local s = N.petStats(e)
						if cfg.sellUnderIncomeOn and not (s.income < num(cfg.sellUnderIncome)) then
							pass = false
						end
						if cfg.sellUnderKgOn and not (s.kg < num(cfg.sellUnderKg)) then
							pass = false
						end
					end
					if pass then
						table.insert(picks, { id = id, name = info.name })
					end
				end
			end
		end
		table.sort(picks, function(a, b)
			return tostring(a.id) < tostring(b.id)
		end)
		return picks, bag, placed
	end
	function N.bagSummary()
		local picks, bag, placed = N.sellPicks()
		if bag == 0 and placed == 0 then
			return ""
		end
		return string.format("%d pets in the bag, %d pass the filters, %d on the plot stay", bag, #picks, placed)
	end
