local DependencyBox = {}
DependencyBox.__index = DependencyBox

function Groupbox:AddDependencyBox()
    local root = new("Frame", {
        Name = "DependencyBox",
        BackgroundColor3 = Colors.Well,
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = self:_next(),
        Parent = self.Body,
    })
    corner(8, root)
    stroke(root, Colors.WellEdge, 1, 0.3)
    padding(root, 10, 10, 8, 8)
    local layout = listLayout(root, Enum.FillDirection.Vertical, 6)

    local box = setmetatable({
        Type = "DependencyBox",
        Root = root,
        Body = root,
        Layout = layout,
        _controls = {},
        _deps = {},
        _order = 0,
    }, DependencyBox)
    -- inherit all Groupbox add methods except layout wiring
    for k, v in pairs(Groupbox) do
        if k ~= "Toggle" and k ~= "_next" and not DependencyBox[k] then
            DependencyBox[k] = v
        end
    end
    function DependencyBox:_next()
        self._order = self._order + 1
        return self._order
    end

    function box:SetupDependencies(deps)
        self._deps = deps or {}
        for _, dep in ipairs(self._deps) do
            local ctrl, want = dep[1], dep[2]
            if ctrl and ctrl.Changed then
                ctrl.Changed:Connect(function() box:Update() end)
            end
        end
        box:Update()
    end

    function box:Update()
        local ok = true
        for _, dep in ipairs(self._deps) do
            local ctrl, want = dep[1], dep[2]
            if ctrl and ctrl.Value ~= want then ok = false; break end
        end
        self.Root.Visible = ok
    end

    table.insert(self._controls, box)
    Library.DependencyBoxes[#Library.DependencyBoxes + 1] = box
    return box
end

