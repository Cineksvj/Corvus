			return nil
		end
		local ok, mod = pcall(require, inst)
		if not ok then
			log("REQUIRE failed", label, mod)
			return nil
		end
		return mod
	end
	local function call(fn, ...)
		if type(fn) ~= "function" then
			return nil
		end
		local ok, value = pcall(fn, ...)
		return if ok then value else nil
	end
