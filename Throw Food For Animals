	local function startDrag(input)
		if window.DragMode == "none" then return end
		-- ScreenGui.IgnoreGuiInset = true: AbsolutePosition and GetMouseLocation share the
		-- same screen-space origin, so no inset correction anywhere below.
		local startMouse = UserInputService:GetMouseLocation()
		-- Work in the ScreenGui's own pixel space (ghost and Main are siblings there), so
		-- the outline sits exactly on the window whatever the topbar inset does.
		local guiOrigin  = screenGui.AbsolutePosition
		local startPos   = main.AbsolutePosition - guiOrigin
		local winSize    = main.AbsoluteSize

		local useGhost = window.DragMode == "ghost"
		local ghost
		if useGhost then
			ghost = ensureGhost()
			ghost.Size = UDim2.new(0, winSize.X, 0, winSize.Y)
			ghost.Position = UDim2.new(0, startPos.X, 0, startPos.Y)
			ghost.Visible = true
			-- Fade outline in
			local outline = ghost:FindFirstChild("GhostOutline")
			if outline then
				outline.Transparency = 1
				Library:NewTween(outline, 0.15, { Transparency = 0.2 }, Enum.EasingStyle.Quad)
			end
		end

		local vp = screenGui.AbsoluteSize
		if vp.X < 1 then vp = Camera and Camera.ViewportSize or Vector2.new(1920, 1080) end

		-- the pointer is read once per rendered frame (RenderStepped), so the window moves with
		-- the game's own frame rate and never waits for a mouse event; the position is clamped to
		-- the screen
		local moveConn, upConn
		local lastX, lastY = startPos.X, startPos.Y
		moveConn = RunService.RenderStepped:Connect(function()
			local now = UserInputService:GetMouseLocation()
			local nx = clamp(startPos.X + (now.X - startMouse.X), 0, math.max(0, vp.X - winSize.X))
			local ny = clamp(startPos.Y + (now.Y - startMouse.Y), 0, math.max(0, vp.Y - winSize.Y))
			if nx == lastX and ny == lastY then return end
			lastX, lastY = nx, ny
			if useGhost and ghost then
				ghost.Position = UDim2.new(0, nx, 0, ny)
			else
				main.Position = UDim2.new(0, nx, 0, ny)
			end
		end)

		upConn = UserInputService.InputEnded:Connect(function(endInput)
			if endInput.UserInputType ~= Enum.UserInputType.MouseButton1
				and endInput.UserInputType ~= Enum.UserInputType.Touch
			then
				return
			end
			moveConn:Disconnect()
			upConn:Disconnect()
			if useGhost and ghost then
				-- Snap window to ghost position via tween
				local targetPos = ghost.Position
				Library:NewTween(
					main,
					0.28,
					{ Position = targetPos },
					Enum.EasingStyle.Quint,
					Enum.EasingDirection.Out
				)
				-- Fade ghost outline, then hide
				local outline = ghost:FindFirstChild("GhostOutline")
				if outline then
					Library:NewTween(outline, 0.15, { Transparency = 1 }, Enum.EasingStyle.Quad)
				end
				task.delay(0.28, function()
					if ghost and ghost.Parent then
						ghost.Visible = false
					end
				end)
			end
		end)
	end

	for _, h in ipairs(dragHandles) do
		h.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				startDrag(input)
			end
		end)
	end

	-- window:SetDragMode(mode)
	function window:SetDragMode(mode)
		if mode ~= "ghost" and mode ~= "classic" and mode ~= "none" then
			warn("[Corvus][core] SetDragMode: unknown mode " .. tostring(mode))
			return self
		end
		self.DragMode = mode
		return self
	end

	-- -------------------- Show / hide / minimise
	-- Open pop: the window settles from 97 % to its scale (also used on first show)
	-- W4 card reveal: the active tab's cards appear one after another (a window-coloured
	-- veil per card fades out, 60 ms apart). No layout churn: positions never move.
	local function revealCards(tab)
		if rawget(Library, "LowEffects") == true then return end
		if type(tab) ~= "table" or type(tab.Groupboxes) ~= "table" then return end
		local i = 0
		for _, gb in ipairs(tab.Groupboxes) do
			local root = type(gb) == "table" and gb.Root
			if root and root.Visible and i < 8 then
				i += 1
				-- Farm 2026-10-20: stagger kept, but each veil is short and starts near-transparent so
				-- a 500 ms headless capture never catches a card half-under its veil.
				local veil = Library:New("Frame", {
					Name = "Veil",
					BackgroundColor3 = Colors.window,
					BackgroundTransparency = 0.5,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 2, 1, 2),
					Position = UDim2.new(0, -1, 0, -1),
					ZIndex = 60,
					Parent = root,
				})
				Library:Round(8).Parent = veil
				task.delay(0.02 + (i - 1) * 0.03, function()
					if not veil.Parent then return end
					local tw = Library:NewTween(veil, 0.14, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
					if tw and tw.Completed then tw.Completed:Once(function() veil:Destroy() end)
					else task.delay(0.16, function() veil:Destroy() end) end
				end)
			end
		end
	end
	rawset(Library, "RevealCards", revealCards)
	local booted = false
	local function popIn()
		local s = Library.UIScale or mainScale.Scale or 1
		if not booted then
			-- boot: a deeper scale-in with a Back ease, one fast lap of the bezel light, cards
			-- revealed one by one, a short metal "unsheath" (W6)
			booted = true
			-- the loader's loading screen (if any) ends now: the window is on screen
			pcall(function()
				local env = (getgenv and getgenv()) or _G
				local done = rawget(env, "CorvusLoadingDone") or rawget(_G, "CorvusLoadingDone")
				if type(done) == "function" then done() end
			end)
			mainScale.Scale = s * 0.94
			Library:NewTween(mainScale, 0.5, { Scale = s }, Enum.EasingStyle.Back)
			pcall(Library.BezelSweep, Library, mainBezel, 1.1)
			pcall(revealCards, rawget(Library, "ActiveTab"))
			return
		end
		mainScale.Scale = s * 0.97
		Library:NewTween(mainScale, 0.24, { Scale = s }, Enum.EasingStyle.Quint)
		pcall(Library.BezelSweep, Library, mainBezel, 0.8)
	end
	-- B2 focus blur: a BlurEffect on the game while the hub is open (setting FocusBlur; default ON
	-- since 2026-11-01, owner)
	local function applyBlur()
		local want = rawget(Library, "FocusBlur") == true and main.Visible
		local Lighting = game:GetService("Lighting")
		local b = Lighting:FindFirstChild("CorvusFocusBlur")
		if want and not b then
			b = Instance.new("BlurEffect")
			b.Name = "CorvusFocusBlur"
			b.Size = 10
			b.Parent = Lighting
		end
		if b then b.Enabled = want end
