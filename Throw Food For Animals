	-- -------------------- Sidebar.MovePillTo(entry)
	-- Tweens the SlidingPill to sit flush behind the given tab entry.
	-- entry: Frame already parented to tabList.
	function window.Sidebar.MovePillTo(entry, instant)
		if not entry or not entry:IsDescendantOf(window.Sidebar.Frame) then return end
		local pill = window.SlidingPill
		local sb   = window.Sidebar.Frame
		pill.Visible = true   -- the list scroll handler hides it while its row is out of view
		-- AbsolutePosition is screen-space; convert to sidebar-local.
		local ep = entry.AbsolutePosition
		local sp = sb.AbsolutePosition
		-- Absolute deltas are in screen pixels; offsets inside the UIScale'd window are
		-- unscaled units, so divide by the scale. Children of the padded sidebar are
		-- positioned from the padded origin.
		local k = (mainScale and mainScale.Scale) or 1
		if k <= 0 then k = 1 end
		local relY = (ep.Y - sp.Y) / k - sidebarPad.PaddingTop.Offset
		local relX = (ep.X - sp.X) / k - sidebarPad.PaddingLeft.Offset
		local target = {
			Position = UDim2.new(0, relX, 0, relY),
			Size     = UDim2.new(0, entry.AbsoluteSize.X / k, 0, entry.AbsoluteSize.Y / k),
		}
		-- compact: the pill hugs the plate like the hover ring does (owner 2026-11-01)
		local plate = window.Compact and entry:FindFirstChild("Plate")
		if plate then
			local pp, ps = plate.AbsolutePosition, plate.AbsoluteSize
			target = {
				Position = UDim2.new(0, (pp.X - sp.X) / k - sidebarPad.PaddingLeft.Offset - 5, 0, (pp.Y - sp.Y) / k - sidebarPad.PaddingTop.Offset - 5),
				Size     = UDim2.new(0, ps.X / k + 10, 0, ps.Y / k + 10),
			}
		end
		if instant then
			pill.Position = target.Position
			pill.Size     = target.Size
			return
		end
		if rawget(Library, "LowEffects") ~= true then
			-- the trail starts where the pill was, follows on a slower ease and fades out
			pillTrail.Position, pillTrail.Size = pill.Position, pill.Size
			pillTrail.BackgroundTransparency = 0.9
			pillTrail.Visible = true
			Library:NewTween(pillTrail, 0.5, target, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			Library:NewTween(pillTrail, 0.5, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.52, function() if pillTrail.BackgroundTransparency >= 0.99 then pillTrail.Visible = false end end)
		end
		Library:NewTween(
			pill,
			0.3,
			target,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		)
		-- the pill lands with a brief lift of its fill, then settles back to the resting tint
		pill.BackgroundTransparency = 0.84
		Library:NewTween(pill, 0.45, { BackgroundTransparency = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	end
	-- hover ring onto `entry` (same sidebar-local math as MovePillTo, inset 1 px); nil hides it
	-- `glide`: the ring slides from the row it was on (pointer moving down the list) and fades in
	-- when it was hidden; scroll / compact re-snaps pass no glide.
	local ringStroke = hoverRing:FindFirstChildOfClass("UIStroke")
	local ringGen = 0
	function window.Sidebar.HoverEntry(entry, glide)
		ringGen += 1
		if not entry or not entry:IsDescendantOf(window.Sidebar.Frame) then
			rawset(window, "_hoverEntry", nil)
			if not glide or not hoverRing.Visible then hoverRing.Visible = false return end
			local g = ringGen
			Library:NewTween(hoverRing, 0.12, { BackgroundTransparency = 1 })
			if ringStroke then Library:NewTween(ringStroke, 0.12, { Transparency = 1 }) end
			task.delay(0.13, function() if ringGen == g then hoverRing.Visible = false end end)
			return
		end
		local k = (mainScale and mainScale.Scale) or 1
		if k <= 0 then k = 1 end
		local ep, sp = entry.AbsolutePosition, window.Sidebar.Frame.AbsolutePosition
		local goal = {
			Position = UDim2.new(0, (ep.X - sp.X) / k - sidebarPad.PaddingLeft.Offset, 0, (ep.Y - sp.Y) / k - sidebarPad.PaddingTop.Offset),
			Size = UDim2.new(0, entry.AbsoluteSize.X / k, 0, entry.AbsoluteSize.Y / k),
		}
		-- owner 2026-11-01 ("the shadow outline on the icon tabs ... still a little too big"): in
		-- the compact sidebar the row is only the plate, so the ring hugs the plate (5 px round it)
		local plate = window.Compact and entry:FindFirstChild("Plate")
		if plate then
			local pp, ps = plate.AbsolutePosition, plate.AbsoluteSize
			goal = {
				Position = UDim2.new(0, (pp.X - sp.X) / k - sidebarPad.PaddingLeft.Offset - 5, 0, (pp.Y - sp.Y) / k - sidebarPad.PaddingTop.Offset - 5),
				Size = UDim2.new(0, ps.X / k + 10, 0, ps.Y / k + 10),
			}
		end
		if glide and hoverRing.Visible and hoverRing.BackgroundTransparency < 0.99 then
			Library:NewTween(hoverRing, 0.14, goal, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		else
			hoverRing.Position, hoverRing.Size = goal.Position, goal.Size
			if glide then
				hoverRing.BackgroundTransparency = 1
				if ringStroke then ringStroke.Transparency = 1 end
			end
		end
		Library:NewTween(hoverRing, glide and 0.14 or 0, { BackgroundTransparency = 0.96 })
		if ringStroke then Library:NewTween(ringStroke, glide and 0.14 or 0, { Transparency = 0 }) end
		hoverRing.Visible = true
		rawset(window, "_hoverEntry", entry)
	end
	-- the ring and the pill live on the sidebar, not in the scrolled list: follow the scroll,
	-- and keep both inside the list's visible band (a row scrolled under the wordmark has no ring)
	Library:GiveSignal(tabList:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		local he = rawget(window, "_hoverEntry")
		if hoverRing.Visible and he then window.Sidebar.HoverEntry(he) end
		if window.ActiveTab and window.ActiveTab.Entry then pcall(window.Sidebar.MovePillTo, window.ActiveTab.Entry, true) end
		local top, bot = tabList.AbsolutePosition.Y, tabList.AbsolutePosition.Y + tabList.AbsoluteSize.Y
		local function inBand(e) return e and e.AbsolutePosition.Y >= top - 2 and e.AbsolutePosition.Y + e.AbsoluteSize.Y <= bot + 2 end
		if hoverRing.Visible and not inBand(he) then hoverRing.Visible = false end
		slidingPill.Visible = inBand(window.ActiveTab and window.ActiveTab.Entry) and true or false
	end))

	-- -------------------- window:SetUserProfile(opts)
	function window:SetUserProfile(info)
		info = info or {}
		if info.Avatar then
			pcall(function() userAvatar.Image = info.Avatar; userAvatar.Visible = true; placeUser() end)
		elseif info.UserId then
			local ok, url = pcall(function()
				return Players:GetUserThumbnailAsync(
					info.UserId,
					Enum.ThumbnailType.HeadShot,
					Enum.ThumbnailSize.Size100x100
				)
			end)
			if ok and type(url) == "string" and url ~= "" then
				userAvatar.Image = url
				userAvatar.Visible = rawget(Library, "Anonymous") ~= true
				placeUser()
			end
		end
		if info.Name then
			userName.Text = tostring(info.Name)
		end
		if info.Username then
			userHandle.Text = "@" .. tostring(info.Username)
		end
		if info.Game then
			userGame.Text = tostring(info.Game)
		end
		-- owner 2026-11-01 (Profile card "Anonymous"): the footer hides the name, handle and picture
		if rawget(Library, "Anonymous") == true then
			userName.Text = "Anonymous"
			userHandle.Text = ""
			userAvatar.Visible = false
		end
		self.UserProfile = info
		return self
	end
	-- owner 2026-11-01 ("make it change the leaderboard too for every people in server"): with
	-- Anonymous on, every name on Roblox's player list (CoreGui.PlayerList, the leaderstats board)
	-- reads "Anonymous". The list is Roact-driven, so a label is re-masked whenever the list
	-- writes it and new rows are caught as they appear; off puts the real names back.
	local anonConns, anonOrig = {}, {}
	local ANON_NAME = "Anonymous"
	local function isNameLabel(d)
		return d:IsA("TextLabel") and d.Name == "PlayerName" and d.Parent ~= nil and d.Parent.Name == "PlayerName"
	end
	local function maskName(lbl)
		if lbl.Text == ANON_NAME then return end
		anonOrig[lbl] = lbl.Text   -- a real write by the list: remember it for later
		lbl.Text = ANON_NAME
	end
	function Library:ApplyAnonymousLeaderboard(on)
		for _, c in ipairs(anonConns) do pcall(c.Disconnect, c) end
		table.clear(anonConns)
		if not on then
			for lbl, orig in pairs(anonOrig) do
				if lbl.Parent and lbl.Text == ANON_NAME then lbl.Text = orig end
			end
			table.clear(anonOrig)
			return
		end
		local list = game:GetService("CoreGui"):FindFirstChild("PlayerList")
		if not list then return end
		local function hook(d)
			if not isNameLabel(d) then return end
			maskName(d)
			table.insert(anonConns, d:GetPropertyChangedSignal("Text"):Connect(function() maskName(d) end))
		end
		for _, d in ipairs(list:GetDescendants()) do hook(d) end
		table.insert(anonConns, list.DescendantAdded:Connect(hook))
	end
	function Library:SetAnonymous(v)
		v = v == true
		rawset(Library, "Anonymous", v)
		if type(Library.SetSetting) == "function" then pcall(Library.SetSetting, Library, "Anonymous", v) end
		pcall(function() window:SetUserProfile(window.UserProfile or {}) end)
		pcall(Library.ApplyAnonymousLeaderboard, Library, v)
		if type(Library.CorvusLog) == "function" then pcall(Library.CorvusLog, Library, "ANONYMOUS " .. (v and "on" or "off")) end
	end

