-- ============================================================================
-- groupbox:AddStat({ Icon, Text, Value, Size, ValueColor, Progress }) -> stat:SetValue(v)
-- Owner 2026-10-31 ("way better stats, with icons from the game like Pet Universe"; evening:
-- "tekst zeby byl widoczny a nie ..."): every stat is a full-width tile with the icon on a
-- darker plate at the left (a game picture keeps its colours, a Lucide glyph is bone-mid) and
-- the label over the Oswald number at the right. Full width always: the hub columns are ~280 px
-- and half tiles cut every label short. Size >= 26 = hero tile (64 px, 26 px number), anything
-- else = 52 px with a 20 px number. ValueColor "FontColor" = plain secondary text (rates /
-- times). Progress (0..1) draws a 3 px bar under the number; stat:SetProgress(p) moves it.
local STAT_GAP = 6
function Groupbox:AddStat(props)
    props = props or {}
    local big = (tonumber(props.Size) or 22) >= 26
    local hasProg = type(props.Progress) == "number"
    -- critique 2026-11-01: the hero tile was only 12 px taller than the rest; 72 px with a 32 px
    -- number reads as the one number of the tab
    local H = big and T(72, 80) or T(52, 60)
    local PLATE = big and 48 or 34
    local row = makeRow(self, H + STAT_GAP, "Stat_" .. tostring(props.Text or "x"))
    local tile = new("Frame", {
        Name = "Tile",
        BackgroundColor3 = Colors.Well,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, H),
        Parent = row,
    })
    corner(8, tile)
    -- (critique 2026-10-31 night: the tile sat flush with the card) the edge is lit at the top
    -- and falls to the well hairline at the foot, so the plate reads as raised
    local edge = stroke(tile, Color3.new(1, 1, 1), 1, 0)
    new("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromHex("#6B7382")),
            ColorSequenceKeypoint.new(0.35, Colors.WellEdge),
            ColorSequenceKeypoint.new(1, Colors.WellEdge),
        }),
        Parent = edge,
    })

    local hasIcon = type(props.Icon) == "string" and props.Icon ~= "" and type(Library.GlassIcon) == "function"
    local plate, ico
    if hasIcon then
        plate, ico = Library:IconPlate(tile, props.Icon, PLATE, PLATE - 8, 2)
        plate.AnchorPoint = Vector2.new(0, 0.5)
        plate.Position = UDim2.new(0, 12, 0.5, 0)
    end
    local textX = hasIcon and (PLATE + 24) or 14
    local labelSize = T(12, 13)
    local valueSize = big and (hasProg and 28 or 32) or (hasProg and 19 or 20)
    local labelY = big and (hasProg and 9 or 12) or (hasProg and 5 or 8)
    local valueY = big and (hasProg and 26 or 31) or (hasProg and 19 or 24)

    local label = text({
        Name = "Label",
        Text = tostring(props.Text or ""),
        TextSize = labelSize,
        FontFace = Fonts.InterMed or Fonts.SansMed or Fonts.Sans,
        TextColor3 = Colors.textMid or Color3.fromHex("#D5D8DE"),
        TextTruncate = Enum.TextTruncate.AtEnd,
        Position = UDim2.new(0, textX, 0, labelY),
        Size = UDim2.new(1, -textX - 10, 0, labelSize + 4),
        ZIndex = 3,
        Parent = tile,
    })
    local plain = props.ValueColor ~= nil
    -- Oswald numerals: a stat is a readout
    local value = text({
        Name = "Value",
        Text = tostring(props.Value or "-"),
        TextSize = valueSize,
        FontFace = Fonts.OswaldMed or Fonts.Display or Fonts.Sans,
        TextColor3 = plain and (Colors.textMid or Color3.fromHex("#D5D8DE")) or (Colors.text or Color3.fromHex("#F2F3F5")),
        TextTruncate = Enum.TextTruncate.AtEnd,
        Position = UDim2.new(0, textX, 0, valueY),
        Size = UDim2.new(1, -textX - 10, 0, valueSize + 4),
        ZIndex = 3,
        Parent = tile,
    })
    local progFill
    if hasProg then
        local rail = new("Frame", {
            Name = "Progress",
            BackgroundColor3 = Colors.WellEdge,
            BorderSizePixel = 0,
            Position = UDim2.new(0, textX, 1, -8),
            Size = UDim2.new(1, -textX - 12, 0, 3),
            ZIndex = 3,
            Parent = tile,
        })
        corner(2, rail)
        progFill = new("Frame", {
            Name = "Fill",
            BackgroundColor3 = Colors.brushed or Colors.Brushed,
            BorderSizePixel = 0,
            Size = UDim2.new(math.clamp(props.Progress, 0, 1), 0, 1, 0),
            ZIndex = 4,
            Parent = rail,
        })
        corner(2, progFill)
    end

    local s = setmetatable({
        Type = "Stat",
        Instance = tile,
        Row = row,
        Value = props.Value or "-",
        Progress = hasProg and math.clamp(props.Progress, 0, 1) or nil,
        Label = label,
        ValueLabel = value,
        Edge = edge,
        Plate = plate,
        Icon = ico,
    }, { __index = Label })
    function s:SetValue(v)
        v = tostring(v == nil and "-" or v)
        if v == self.Value then return end
        self.Value = v
        value.Text = v
        value.TextColor3 = (v == "-" or v == "") and (Colors.muted or Colors.Smoke) or (plain and (Colors.textMid or TEXT_MID) or (Colors.text or Colors.Ink))
        -- a changed number glints once (text fades in from half), nothing per frame
        if rawget(Library, "LowEffects") ~= true then
            value.TextTransparency = 0.55
            tween(value, 0.35, nil, { TextTransparency = 0 })
        end
    end
    function s:SetText(v) self:SetValue(v) end
    function s:Set(v) self:SetValue(v) end
    function s:SetLabel(t) label.Text = tostring(t or "") end
    function s:SetProgress(p)
        if not progFill then return end
        p = math.clamp(tonumber(p) or 0, 0, 1)
        if p == self.Progress then return end
        self.Progress = p
        tween(progFill, 0.25, nil, { Size = UDim2.new(p, 0, 1, 0) })
    end
    table.insert(self._controls, s)
    return s
end

