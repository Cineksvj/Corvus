function Library:GetControlValues()
    local out = { Toggles = {}, Options = {} }
    for k, t in pairs(self.Toggles) do out.Toggles[k] = t.Value end
    for k, o in pairs(self.Options) do
        if o.Type == "Dropdown" and o.Multi then
            local arr = {}
            for n, v in pairs(o.Value) do if v then arr[#arr+1] = n end end
            out.Options[k] = arr
        elseif o.Type == "ColorPicker" then
            local c = o.Value
            out.Options[k] = { c.R, c.G, c.B }
        elseif o.Type == "KeyPicker" then
            out.Options[k] = o.Value and tostring(o.Value) or nil
        else
            out.Options[k] = o.Value
        end
    end
    return out
end

-- Unique feature 2: a config load is ONE history entry and the player is told what it did
-- ("Load config (7 changes)" -> notify lists the first three, Ctrl+Z reverts all of them).
function Library:LoadControlValues(data, label)
    if not data then return end
    local function run()
        if data.Toggles then
            for k, v in pairs(data.Toggles) do
                local t = self.Toggles[k]
                if t then t:SetValue(v) end
            end
        end
        if data.Options then
            for k, v in pairs(data.Options) do
                local o = self.Options[k]
                if o then
                    if o.Type == "Dropdown" and o.Multi and type(v) == "table" then
                        local tbl = {}
                        for _, name in ipairs(v) do tbl[name] = true end
                        o:SetValue(tbl)
                    elseif o.Type == "ColorPicker" and type(v) == "table" then
                        o:SetValue(Color3.new(v[1] or 1, v[2] or 1, v[3] or 1))
                    else
                        o:SetValue(v)
                    end
                end
            end
        end
    end
    if type(self.HistoryBatch) ~= "function" then run() return end
    local b = self:HistoryBatch(label or "Load config", run)
    if type(b) == "table" and b.entries and #b.entries > 0 and type(self.Notify) == "function" then
        local n = #b.entries
        local parts = {}
        for i = 1, math.min(3, n) do parts[i] = b.entries[i].label end
        local msg = string.format("%d change%s: %s%s", n, n == 1 and "" or "s", table.concat(parts, "; "), n > 3 and ("; +" .. (n - 3) .. " more") or "")
        pcall(self.Notify, self, msg, 6)
        if type(self.CorvusLog) == "function" then pcall(self.CorvusLog, self, "CONFIG " .. msg) end
    end
end

