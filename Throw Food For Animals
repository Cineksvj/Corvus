	local function jobSell(force)
		local did = false
		if cfg.equipBest or force then
			local r = doRemoteAt("equip", "Plot_EquipBest", sellPos)
			if not r.Ok and r.Reason ~= "Nothing" then
				fail("Equip:" .. tostring(r.Reason))
			end
			did = true
		end
		if cfg.sell or force then
			-- owner 2026-11-01 ("block selling those on the plot"): never the game's Sell all, one
			-- call per pet, and every pet is read again right before its call, so one placed or
			-- bought between the pick and the call stays
			local picks = N.sellPicks()
			local sold, kept = 0, 0
			for _, p in ipairs(picks) do
				local animals = D("Animals")
				local e = if type(animals) == "table" then animals[p.id] else nil
				if type(e) ~= "table" or e.Placed or e.Bought then
					kept += 1
					continue
				end
				local r = doRemoteAt("sell", "Plot_SellAnimal", sellPos, p.id)
				if r.Ok then
					sold += 1
				elseif r.Reason ~= "Nothing" then
					fail("Sell:" .. tostring(r.Reason))
