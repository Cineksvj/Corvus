	N.SellValues = {
		rarities = names(RarityConfig and RarityConfig.List),
		mutations = { "Normal" },
		areas = names(AreasConfig and AreasConfig.All),
	}
	for _, n in ipairs(names(MutationsConfig and MutationsConfig.List)) do
