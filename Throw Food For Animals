			log("BLOCKED", name)
			return { Ok = false, Reason = "Blocked" }
		end
		local remote = Remotes and Remotes:FindFirstChild(name)
		if not (remote and remote:IsA("RemoteFunction")) then
			return { Ok = false, Reason = "NoRemote" }
		end
		N.Sent.count += 1
		N.Sent.byName[name] = (N.Sent.byName[name] or 0) + 1
		local ok, res = pcall(remote.InvokeServer, remote, ...)
		if not ok then
			return { Ok = false, Reason = "Err:" .. tostring(res) }
		end
		if type(res) ~= "table" then
			return { Ok = res == true, Reason = "Raw:" .. tostring(res) }
		end
		return res
	end

	local function child(parent, name)
