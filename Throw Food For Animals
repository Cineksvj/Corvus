-- ------------------------------------------------------------
-- Low-level creation helpers
-- ------------------------------------------------------------
local function new(className, props, children)
    local inst = Instance.new(className)
    if props then
        for k, v in pairs(props) do
            inst[k] = v
        end
    end
    if children then
        for _, child in ipairs(children) do
            child.Parent = inst
        end
    end
    return inst
end

local function corner(radius)
    return new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

local function stroke(color, thickness, transparency)
    return new("UIStroke", {
        Color = color or Palette.RavenOutline,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end

local function metalGradient(parent, rotation)
    local g = new("UIGradient", {
        Color = themeMetal(),
        Rotation = rotation or 135,
    })
    if parent then g.Parent = parent end
    -- (Lib() is declared later in this file: reach the library through _G here)
    local L = rawget(_G, "CorvusLibrary") or rawget(_G, "Library")
    if type(L) == "table" and type(rawget(L, "RegisterThemed")) == "function" then L:RegisterThemed(g, "metal") end
    return g
end

local function glassTop(parent)
    local g = new("UIGradient", {
        Color = ColorSequence.new(Color3.fromRGB(255,255,255)),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0.00, 0.94),
            NumberSequenceKeypoint.new(0.35, 1.00),
            NumberSequenceKeypoint.new(1.00, 1.00),
        }),
        Rotation = 90,
    })
    if parent then g.Parent = parent end
    return g
end

local function padding(top, right, bottom, left)
    return new("UIPadding", {
        PaddingTop    = UDim.new(0, top),
        PaddingRight  = UDim.new(0, right or top),
        PaddingBottom = UDim.new(0, bottom or top),
        PaddingLeft   = UDim.new(0, left or (right or top)),
    })
end

local function listLayout(dir, pad, h, v)
    return new("UIListLayout", {
        FillDirection = dir or Enum.FillDirection.Vertical,
        Padding = UDim.new(0, pad or 6),
        HorizontalAlignment = h or Enum.HorizontalAlignment.Left,
        VerticalAlignment = v or Enum.VerticalAlignment.Top,
        SortOrder = Enum.SortOrder.LayoutOrder,
    })
end

local function tween(obj, time, info, props)
    local ti = TweenInfo.new(
        time,
        info and info.style or Enum.EasingStyle.Quint,
        info and info.dir or Enum.EasingDirection.Out,
        0, false, 0
    )
    local t = TweenService:Create(obj, ti, props)
    t:Play()
    return t
end

-- Simple deterministic hash for toggle name -> position
local function djb2(s)
    local h = 5381
    for i = 1, #s do
        h = (h * 33 + string.byte(s, i)) % 2147483647
    end
    return h
end

-- ------------------------------------------------------------
-- Resolve library handles (Agent A exposes these)
-- ------------------------------------------------------------
local function Lib()
    return rawget(_G, "CorvusLibrary") or rawget(_G, "Library")
end

local function toggleRef(flag)
    local L = Lib()
    if L and L.Toggles and L.Toggles[flag] then
        return L.Toggles[flag]
    end
    -- Shim: a minimal toggle object so widget stays interactive
    -- during preview builds where Agent B toggle isn't registered yet.
    local shim = { Value = false, Callback = function() end }
    function shim:SetValue(v)
        self.Value = not not v
        pcall(self.Callback, self.Value)
        if self._listeners then
            for _, fn in ipairs(self._listeners) do pcall(fn, self.Value) end
        end
    end
    function shim:OnChanged(fn)
        self._listeners = self._listeners or {}
        table.insert(self._listeners, fn)
    end
    if L and L.Toggles then L.Toggles[flag] = shim end
    return shim
end

-- =====================================================================
-- PRIMARY CARD - tab:AddPrimary(flagName, {Title, Desc})
-- =====================================================================
-- Full-width card with 1px Metal gradient border (padding-box = surface,
-- border-box = metal), eyebrow + title + desc + big 50x28 toggle.
-- =====================================================================
function Widgets.AddPrimary(tab, flagName, cfg)
    cfg = cfg or {}
    -- The hub's row/column grid lives inside tab.Content (PageHolder, UIListLayout
    -- Vertical). tab.Container is the raw ScrollingFrame and has no layout, so a
    -- card parented there would float on top of every column.
    local parent = (tab and (tab.Content or tab.PageHolder or tab.Container or tab.Pages)) or tab
    assert(parent, "AddPrimary: tab has no Content")

    -- The Primary card is always the first row of the tab, before any Groupbox row.
    cfg.LayoutOrder = cfg.LayoutOrder or -1

    local tog = toggleRef(flagName)

    -- Dark surface card + metal UIStroke 1px (border-image equivalent). Any
    -- metal fill on the frame itself would read as a WHITE bar instead of a
    -- card with a silver vein.
    local border = new("Frame", {
        Name = "CorvusPrimary_" .. tostring(flagName),
        Size = UDim2.new(1, 0, 0, 82),
        BackgroundColor3 = Palette.Surface,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        LayoutOrder = cfg.LayoutOrder or 1,
        Parent = parent,
    })
    corner(8).Parent = border
    do
        -- Metal border via UIStroke; the stroke carries the silver gradient so
        -- the card body stays raven-void.
        local st = Instance.new("UIStroke")
        st.Color = Color3.fromRGB(230, 234, 240)
        st.Thickness = 1
        st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        st.Transparency = 0.1
        local sg = Instance.new("UIGradient")
        sg.Color = MetalSequence
        sg.Rotation = 135
        sg.Parent = st
        st.Parent = border
    end

    -- Surface alias so the rest of the function keeps working.
    local surface = border
    padding(14, 16, 14, 16).Parent = surface

    -- Left column: eyebrow + title + desc
    local text = new("Frame", {
        Name = "Text",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -72, 1, 0),
        Parent = surface,
    })
    local col = listLayout(Enum.FillDirection.Vertical, 2)
    col.Parent = text

    -- Eyebrow "PRIMARY" - 9px, uppercase, muted, letter-spacing 0.22em
    -- Roblox has no letter-spacing: fake it with literal spaces between glyphs
    local eyebrowText = string.upper(cfg.Eyebrow or "PRIMARY")
    local eyebrowSpaced = {}
    for i = 1, #eyebrowText do
        table.insert(eyebrowSpaced, string.sub(eyebrowText, i, i))
    end
    local eyebrow = new("TextLabel", {
        Name = "Eyebrow",
        BackgroundTransparency = 1,
        FontFace = Fonts.BuilderMed,
        TextSize = 9,
        Text = table.concat(eyebrowSpaced, " "),
        TextColor3 = Palette.SilverSmoke,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = UDim2.new(1, 0, 0, 12),
        LayoutOrder = 1,
        Parent = text,
    })

    -- Title - 20px, Metal gradient text fill, weight 600 (bold)
    local title = new("TextLabel", {
        Name = "Title",
        BackgroundTransparency = 1,
        FontFace = Fonts.BuilderBold,
        TextSize = 20,
        Text = cfg.Title or flagName,
        TextColor3 = Color3.fromRGB(255,255,255),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = UDim2.new(1, 0, 0, 24),
        LayoutOrder = 2,
        Parent = text,
    })
    metalGradient(title, 135)

    -- Desc - 11.5px, muted
    local desc = new("TextLabel", {
        Name = "Desc",
        BackgroundTransparency = 1,
        FontFace = Fonts.BuilderReg,
        TextSize = 12, -- 11.5 rounded, Roblox TextSize integer
        Text = cfg.Desc or "",
        TextColor3 = Palette.SilverSmoke,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        Size = UDim2.new(1, 0, 0, 32),
        LayoutOrder = 3,
        Parent = text,
    })

    -- Right column: big toggle 50x28 with inner knob 22x22
    local toggleWell = new("Frame", {
        Name = "Toggle",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, 50, 0, 28),
        BackgroundColor3 = Palette.RavenAsh,
        BorderSizePixel = 0,
        Parent = surface,
    })
    corner(14).Parent = toggleWell
    local toggleStroke = stroke(Palette.RavenOutline, 1, 0)
    toggleStroke.Parent = toggleWell

    -- Fill rail (metal gradient when ON)
    local rail = new("Frame", {
        Name = "Rail",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = toggleWell,
    })
    corner(14).Parent = rail
    metalGradient(rail, 135)

    -- Knob 22x22 (dark inner, offset)
    local knob = new("Frame", {
        Name = "Knob",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.new(0, 22, 0, 22),
        BackgroundColor3 = Palette.RavenVoid,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = toggleWell,
    })
    corner(11).Parent = knob
    local knobStroke = stroke(Palette.SilverSmoke, 1.5, 0.4)
    knobStroke.Parent = knob

    -- Hit target
    local button = new("TextButton", {
        Name = "Hit",
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 10,
        Parent = toggleWell,
    })

    -- Render state
    local function render(value)
        local on = not not value
        if on then
            tween(rail, 0.18, nil, { BackgroundTransparency = 0 })
            tween(knob, 0.14, { style = Enum.EasingStyle.Quad }, {
                Position = UDim2.new(1, -25, 0.5, 0),
                BackgroundColor3 = Palette.RavenVoid,
            })
            tween(knobStroke, 0.14, nil, { Transparency = 1 })
            tween(toggleStroke, 0.14, nil, { Color = Palette.SilverBrushed, Transparency = 0.5 })
        else
            tween(rail, 0.18, nil, { BackgroundTransparency = 1 })
            tween(knob, 0.14, { style = Enum.EasingStyle.Quad }, {
                Position = UDim2.new(0, 3, 0.5, 0),
                BackgroundColor3 = Palette.RavenAsh,
            })
            tween(knobStroke, 0.14, nil, { Transparency = 0.4 })
            tween(toggleStroke, 0.14, nil, { Color = Palette.RavenOutline, Transparency = 0 })
        end
    end

    button.MouseButton1Click:Connect(function()
        local cur = tog.Value
        if tog.SetValue then
            tog:SetValue(not cur)
        else
            tog.Value = not cur
            if tog.Callback then pcall(tog.Callback, tog.Value) end
        end
    end)

    if tog.OnChanged then
        tog:OnChanged(render)
    end
    render(tog.Value)

    -- Register with constellation (fed by Agent D / background)
    if Widgets.Constellation and Widgets.Constellation.register then
        pcall(Widgets.Constellation.register, flagName, border, tog)
    end

    return {
        Instance = border,
        Toggle = tog,
        SetValue = function(_, v)
            if tog.SetValue then tog:SetValue(v) else tog.Value = v render(v) end
        end,
    }
end

-- =====================================================================
-- HERO - groupbox:AddHero({Label, Value, Delta, Sub})
-- =====================================================================
-- Large card: Label 9px uppercase muted + Value 30px Mono metal gradient
-- + Delta 11.5px green mono + Sub 10.5px muted
-- =====================================================================
function Widgets.AddHero(box, cfg)
    cfg = cfg or {}
    -- Flat inside the groupbox card (mockup .card > .cash / .cash-delta / .cash-sub);
    -- the groupbox already is the card, so no nested panel here.
    local parent = (box and (box.Body or box.Container or box.Content)) or box
    assert(parent, "AddHero: groupbox has no Body")
    local order = cfg.LayoutOrder or (box and type(box._next) == "function" and box:_next()) or 1

    local withSpark = cfg.Spark ~= false
    -- Bench: the readout. A 56 px Oswald numeral in flat bone is the one dominant element of
    -- the Main tab (hierarchy rule 10); delta and sub in slate under it, sparkline at the foot.
    local card = new("Frame", {
        Name = "CorvusHero",
        Size = UDim2.new(1, 0, 0, withSpark and 122 or 86),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = order,
        Parent = parent,
    })

    local value = new("TextLabel", {
        Name = "Value",
        BackgroundTransparency = 1,
        FontFace = Fonts.BuilderBold,
        TextSize = 52,
        Text = cfg.Value or "0",
        TextColor3 = Palette.SilverMoon,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, 0, 0, 62),
        Position = UDim2.new(0, -2, 0, 0),
        Parent = card,
    })
    -- character: a subtle white -> twilight-violet gradient over the big number
    local valueGrad = Instance.new("UIGradient")
    valueGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.0, Palette.SilverMoon),
        ColorSequenceKeypoint.new(1.0, Palette.AccentHi),
    })
    valueGrad.Rotation = 90
    valueGrad.Parent = value

    -- Delta: Oswald 13, sage (the rate is the one thing that is "live" here)
    local delta = new("TextLabel", {
        Name = "Delta",
        BackgroundTransparency = 1,
        FontFace = Fonts.Oswald,
        TextSize = 13,
        Text = cfg.Delta or "",
        TextColor3 = Palette.SignalGreen,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(0.45, 0, 0, 16),
        Position = UDim2.new(0, 0, 0, 64),
        Parent = card,
    })

    -- Sub: BuilderSans 11, slate, same line, right
    local sub = new("TextLabel", {
        Name = "Sub",
        BackgroundTransparency = 1,
        FontFace = Fonts.BuilderReg,
        TextSize = 11,
        Text = cfg.Sub or "",
        TextColor3 = Palette.SilverSmoke,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(0.55, 0, 0, 16),
        Position = UDim2.new(0.45, 0, 0, 64),
        Parent = card,
    })

    -- de-AI pass 2026-10-19: no second bezel on the hero card; the window edge is the only lit edge

    -- Sparkline (owner 2026-10-19 "wymysl cos"): 56 metal bars = the value over the last
    -- minutes (hub pushes samples with hero:Push(n); at most one sample per 4 s is kept).
    local SPARK_N, bars, samples, lastSample = 56, {}, {}, -1e9
    local spark
    if withSpark then
        -- full width under the delta row
        spark = new("Frame", {
            Name = "Spark",
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.new(0, 0, 1, 0),
            Size = UDim2.new(1, 0, 0, 30),
            Parent = card,
        })
        -- a 1 px slate baseline under the bars (the chart's rule)
        new("Frame", {
            Name = "Base",
            BackgroundColor3 = Palette.RavenOutline,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.new(0, 0, 1, 0),
            Size = UDim2.new(1, 0, 0, 1),
            Parent = spark,
        })
        for i = 1, SPARK_N do
            -- hidden until a sample lands (no fake rhythm on an empty card). Slate bars, the
            -- newest one saffron: the needle of the chart.
            local bar = new("Frame", {
                Name = "B" .. i,
                BackgroundColor3 = Palette.SilverBrushed,
                BackgroundTransparency = 0.55,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0, 1),
                Position = UDim2.new((i - 1) / SPARK_N, 0, 1, -1),
                Size = UDim2.new(1 / SPARK_N, -2, 0, 0),
                Visible = false,
                Parent = spark,
            })
            bars[i] = bar
        end
        bars[SPARK_N].BackgroundColor3 = Palette.SignalAmber
        bars[SPARK_N].BackgroundTransparency = 0
    end
    local function redraw()
        if not spark then return end
        local n = #samples
        if n == 0 then return end
        local lo, hi = math.huge, -math.huge
        for _, v in ipairs(samples) do
            if v < lo then lo = v end
            if v > hi then hi = v end
        end
        local span = hi - lo
        for i = 1, SPARK_N do
            local idx = n - SPARK_N + i
            local bar = bars[i]
            if idx >= 1 then
                local v = samples[idx]
                local h = span > 0 and (0.12 + 0.88 * (v - lo) / span) or 0.45
                local target = UDim2.new(1 / SPARK_N, -2, h, 0)
                if bar.Size ~= target then bar.Size = target end
                if not bar.Visible then bar.Visible = true end
            elseif bar.Visible then
                bar.Visible = false
            end
        end
    end
    local function put(lbl, v)
        v = tostring(v)
        if lbl.Text ~= v then lbl.Text = v end
    end
    local valueGrad = value:FindFirstChildOfClass("UIGradient")
    -- B1 count-up: hero:SetNumber(n, fmt) rolls the digits from the previous number
    local numVal = Instance.new("NumberValue")
    local numFmt, numPrev, numTween = nil, nil, nil
    numVal.Changed:Connect(function(v)
        if numFmt then
            local ok, s = pcall(numFmt, v)
            if ok and type(s) == "string" and value.Text ~= s then value.Text = s end
        end
    end)
    -- long history (one point / 30 s, 2 h) for the Stats charts
    local history, lastHist = {}, -1e9
    local function setValue(v)
        v = tostring(v)
        if value.Text == v then return end
        value.Text = v
        -- a light passes through the digits when the number changes
        if valueGrad and rawget(Lib() or {}, "LowEffects") ~= true then
            valueGrad.Offset = Vector2.new(-0.8, 0)
            local tw = TweenService:Create(valueGrad, TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Offset = Vector2.new(0.8, 0) })
            tw:Play()
            tw.Completed:Once(function() valueGrad.Offset = Vector2.zero end)
        end
    end
    local api = {
        Instance = card,
        SetValue = function(_, v) setValue(v) end,
        SetDelta = function(_, v, col)
            put(delta, v)
            if col and delta.TextColor3 ~= col then delta.TextColor3 = col end
        end,
        SetSub = function(_, v) put(sub, v) end,
        SetText = function(_, v) setValue(v) end,
        Push = function(_, n)
            n = tonumber(n)
            if not n then return end
            local now = os.clock()
            if now - lastHist >= 30 then
                lastHist = now
                table.insert(history, { t = now, v = n })
                if #history > 240 then table.remove(history, 1) end
            end
            if not spark then return end
            if now - lastSample < 4 then return end
            lastSample = now
            table.insert(samples, n)
            if #samples > SPARK_N then table.remove(samples, 1) end
            redraw()
        end,
        SetNumber = function(_, n, fmt)
            n = tonumber(n)
            if not n then return end
            numFmt = type(fmt) == "function" and fmt or tostring
            if numPrev == nil or rawget(Lib() or {}, "LowEffects") == true or math.abs(n - numPrev) < 1e-9 then
                numPrev = n
                numVal.Value = n
                setValue(numFmt(n))
                return
            end
            if numTween then numTween:Cancel() end
            numVal.Value = numPrev
            numTween = TweenService:Create(numVal, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = n })
            numTween:Play()
            numPrev = n
            -- the sheen still passes once per real change
            if valueGrad and rawget(Lib() or {}, "LowEffects") ~= true then
                valueGrad.Offset = Vector2.new(-0.8, 0)
                local tw = TweenService:Create(valueGrad, TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Offset = Vector2.new(0.8, 0) })
                tw:Play()
                tw.Completed:Once(function() valueGrad.Offset = Vector2.zero end)
            end
        end,
        GetSeries = function(_) return table.clone(samples) end,
        -- gains per bucket (newest last): hero:Buckets(12, 300) = the last hour in 5-minute steps
        Buckets = function(_, count, seconds)
            count = math.max(1, tonumber(count) or 12)
            seconds = math.max(10, tonumber(seconds) or 300)
            local now = os.clock()
            local out = {}
            for i = count, 1, -1 do
                local t0, t1 = now - i * seconds, now - (i - 1) * seconds
                local first, last = nil, nil
                for _, p in ipairs(history) do
                    if p.t >= t0 and p.t < t1 then
                        if not first then first = p.v end
                        last = p.v
                    end
                end
                table.insert(out, { label = string.format("-%dm", math.floor(i * seconds / 60)), value = (first and last) and math.max(0, last - first) or 0 })
            end
            return out
        end,
        -- unicode sparkline of the sample series (for Discord cards)
        Sparkline = function(_)
            local chars = { "\226\150\129", "\226\150\130", "\226\150\131", "\226\150\132", "\226\150\133", "\226\150\134", "\226\150\135", "\226\150\136" }
            if #samples == 0 then return "" end
            local lo, hi = math.huge, -math.huge
            for _, v in ipairs(samples) do lo = math.min(lo, v); hi = math.max(hi, v) end
            local out = {}
            for _, v in ipairs(samples) do
                local idx = hi > lo and (1 + math.floor((v - lo) / (hi - lo) * 7 + 0.5)) or 4
                out[#out + 1] = chars[math.clamp(idx, 1, 8)]
            end
            return table.concat(out)
        end,
        SetSeries = function(_, list)
            if type(list) ~= "table" or not spark then return end
            samples = {}
            for i = math.max(1, #list - SPARK_N + 1), #list do
                local v = tonumber(list[i])
                if v then table.insert(samples, v) end
            end
            redraw()
        end,
    }
    return api
end

-- =====================================================================
-- DONUT - groupbox:AddDonut({Label, Value, SubText, Percent})
-- =====================================================================
-- Side-by-side: left = Label + Value + Sub, right = 54x54 ring with
-- metal gradient progress + center percent text.
-- Ring uses tick-dot technique (36 dots in a circle); lit dots run from
-- top (12 o'clock) clockwise up to Percent*36. Clean, deterministic,
-- renders without image assets.
-- =====================================================================
local DONUT_TICKS = 48
local DONUT_RADIUS = 22

function Widgets.AddDonut(box, cfg)
    cfg = cfg or {}
    -- Flat inside the groupbox card (mockup .card > .target): text left, 54px ring right.
    local parent = (box and (box.Body or box.Container or box.Content)) or box
    assert(parent, "AddDonut: groupbox has no Body")
    local order = cfg.LayoutOrder or (box and type(box._next) == "function" and box:_next()) or 1

    local card = new("Frame", {
        Name = "CorvusDonut",
        Size = UDim2.new(1, 0, 0, 60),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = order,
        Parent = parent,
    })

    -- Left column (text), vertically centred like the mockup flex row
    local text = new("Frame", {
        Name = "Text",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0, 0.5),
        Size = UDim2.new(1, -62, 0, 40),
        Position = UDim2.new(0, 0, 0.5, 0),
        Parent = card,
    })
    listLayout(Enum.FillDirection.Vertical, 3).Parent = text

    local valueLbl = new("TextLabel", {
        BackgroundTransparency = 1,
        FontFace = Fonts.MonoMed,
        TextSize = 16,
        TextScaled = false,
        Text = cfg.Value or "0 / 0",
        TextColor3 = Palette.SilverMoon,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, 0, 0, 22),
        LayoutOrder = 2,
        Parent = text,
    })

    local subLbl = new("TextLabel", {
        BackgroundTransparency = 1,
        FontFace = Fonts.BuilderReg,
        TextSize = 11,
        Text = cfg.SubText or "",
        TextColor3 = Palette.SilverSmoke,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, 0, 0, 14),
        LayoutOrder = 3,
        Parent = text,
    })

    -- Right side: 54x54 ring
    local ring = new("Frame", {
        Name = "Ring",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, 54, 0, 54),
        BackgroundTransparency = 1,
        Parent = card,
    })

    -- Build ticks around a circle (dense enough to read as the mockup's 3px stroke arc)
    local dots = {}
    for i = 1, DONUT_TICKS do
        -- Start at 12 o'clock (-pi/2), go clockwise
        local a = (i - 1) / DONUT_TICKS * math.pi * 2 - math.pi / 2
        local px = 27 + math.cos(a) * DONUT_RADIUS
        local py = 27 + math.sin(a) * DONUT_RADIUS
        local dot = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, px, 0, py),
            Size = UDim2.new(0, 3, 0, 3),
            BackgroundColor3 = Palette.SilverMoon,
            BackgroundTransparency = 0.82,
            BorderSizePixel = 0,
            Parent = ring,
        })
        corner(2).Parent = dot
        dots[i] = dot
    end

    -- Center percent text
    local center = new("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 40, 0, 16),
        BackgroundTransparency = 1,
        FontFace = Fonts.MonoMed,
        TextSize = 12,
        TextColor3 = Palette.SilverMoon,
        Text = "0%",
        TextXAlignment = Enum.TextXAlignment.Center,
        Parent = ring,
    })

    local lastLit = -1
    local function setPercent(p)
        p = math.clamp(tonumber(p) or 0, 0, 1)
        local pct = tostring(math.floor(p * 100 + 0.5)) .. "%"
        if center.Text ~= pct then center.Text = pct end
        local litCount = math.floor(p * DONUT_TICKS + 0.5)
        if litCount == lastLit then return end
        lastLit = litCount
        for i = 1, DONUT_TICKS do
            local dot = dots[i]
            local isLit = i <= litCount
            if isLit then
                dot.BackgroundColor3 = Palette.SilverBrushed
                dot.BackgroundTransparency = 0
                -- Metal gradient tint via gradient instance (only on lit dots)
                if not dot:FindFirstChild("UIGradient") then
                    metalGradient(dot, 135)
                end
            else
                local g = dot:FindFirstChild("UIGradient")
                if g then g:Destroy() end
                dot.BackgroundColor3 = Palette.SilverMoon
                dot.BackgroundTransparency = 0.82
            end
        end
    end

    setPercent(cfg.Percent or 0)

    return {
        Instance = card,
        SetPercent = function(_, p) setPercent(p) end,
        SetValue = function(_, v) v = tostring(v); if valueLbl.Text ~= v then valueLbl.Text = v end end,
        SetSub = function(_, v) v = tostring(v); if subLbl.Text ~= v then subLbl.Text = v end end,
    }
end

-- =====================================================================
-- PAGER - tab:AddPager({pages})
-- =====================================================================
-- Bottom bar: left pill "page N / M", right pill with gesture hints,
-- center page tag (zones / trainer / boost), arrow buttons <, >.
-- Snap-flip (1 wheel notch = 1 flip, 0.4s Quint).
-- =====================================================================
function Widgets.AddPager(tab, cfg)
    cfg = cfg or {}
    -- Idempotent: one pager per tab, no matter how many AddPageBreak calls fire.
    if tab and tab._pagerApi then return tab._pagerApi end
    local parent = (tab and (tab.Footer or tab.Content or tab.Container)) or tab
    assert(parent, "AddPager: tab has no Container/Footer")

    -- mockup .pager: 10px muted, "◀ [page 1 / 3]   zones · trainer · boost   [scroll · swipe · ▶ ◀] ▶"
    local pageTags = cfg.pages or cfg.Pages
        or (tab and type(tab.GetPageTags) == "function" and tab:GetPageTags())
        or { "page 1" }
    local pageCount = cfg.count or #pageTags
    local current = (tab and tab.CurrentPage) or 1
    local borderSoft = themeColor("borderSoft", Color3.fromRGB(26, 27, 33))

    local bar = new("Frame", {
        Name = "CorvusPager",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        LayoutOrder = cfg.LayoutOrder or 999,
        Parent = parent,
    })
    padding(0, 4, 0, 4).Parent = bar

    local function chip(parentF, txt, order)
        local c = new("TextLabel", {
            Name = "Chip",
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 0.96,
            BorderSizePixel = 0,
            AutomaticSize = Enum.AutomaticSize.X,
            Size = UDim2.new(0, 0, 0, 18),
            FontFace = Fonts.MonoReg,
            TextSize = 10,
            Text = txt,
            TextColor3 = Palette.SilverSmoke,
            TextXAlignment = Enum.TextXAlignment.Center,
            LayoutOrder = order,
            Parent = parentF,
        })
        corner(4).Parent = c
        stroke(borderSoft, 1, 0).Parent = c
        padding(0, 9, 0, 9).Parent = c
        return c
    end
    local function arrowBtn(parentF, txt, order)
        return new("TextButton", {
            Name = "Arrow",
            BackgroundTransparency = 1,
            AutoButtonColor = false,
            Text = txt,
            FontFace = Fonts.BuilderReg,
            TextSize = 11,
            TextColor3 = Palette.SilverInk,
            Size = UDim2.new(0, 14, 0, 18),
            LayoutOrder = order,
            Parent = parentF,
        })
    end

    local left = new("Frame", {
        Name = "Left",
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.X,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(0, 0, 1, 0),
        Parent = bar,
    })
    listLayout(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center).Parent = left
    local prev = arrowBtn(left, "\226\151\128", 0)
    local leftChip = chip(left, "page 1 / " .. pageCount, 1)

    local tagLbl = new("TextLabel", {
        Name = "Tags",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0.45, 0, 1, 0),
        FontFace = Fonts.BuilderReg,
        TextSize = 10,
        TextColor3 = Palette.SilverSmoke,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        RichText = true,
        Text = "",
        Parent = bar,
    })

    local right = new("Frame", {
        Name = "Right",
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.X,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, 0, 1, 0),
        Parent = bar,
    })
    listLayout(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center).Parent = right
    chip(right, "scroll, swipe, \226\150\182 \226\151\128", 0)
    local nextB = arrowBtn(right, "\226\150\182", 1)

    local function render()
        leftChip.Text = "page " .. current .. " / " .. pageCount
        -- mockup shows the CURRENT page's section tags ("zones · trainer · boost")
        tagLbl.Text = tostring(pageTags[current] or "")
        prev.TextTransparency  = (current <= 1)         and 0.6 or 0
        nextB.TextTransparency = (current >= pageCount) and 0.6 or 0
    end

    local busy = false
    local function flip(delta, silent)
        local target = math.clamp(current + delta, 1, pageCount)
        if target == current then
            if silent then return end
            -- nudge at the ends
            local src = (delta > 0) and 8 or -8
            tween(tagLbl, 0.10, nil, { Position = UDim2.new(0.5, src, 0.5, 0) })
            task.delay(0.12, function()
                tween(tagLbl, 0.22, { style = Enum.EasingStyle.Back }, { Position = UDim2.new(0.5, 0, 0.5, 0) })
            end)
            return
        end
        if busy and not silent then return end
        busy = true
        current = target
        render()
        tween(leftChip, 0.12, nil, { BackgroundTransparency = 0.88 })
        task.delay(0.22, function() tween(leftChip, 0.18, nil, { BackgroundTransparency = 0.96 }) end)
        task.delay(0.40, function() busy = false end)
        if not silent then
            if tab and type(tab.ShowPage) == "function" then
                pcall(function() tab:ShowPage(current) end)
            end
            if cfg.OnFlip then pcall(cfg.OnFlip, current, pageCount) end
        end
    end

    prev.MouseButton1Click:Connect(function() flip(-1) end)
    nextB.MouseButton1Click:Connect(function() flip( 1) end)

    render()

    local api = {
        Instance = bar,
        Flip = function(_, d) flip(d) end,
        GetPage = function() return current end,
        SetPage = function(_, p, silent) flip((p or 1) - current, silent) end,
        SetPageCount = function(_, n, tags)
            if type(tags) == "table" and #tags > 0 then pageTags = tags end
            pageCount = math.max(1, tonumber(n) or #pageTags)
            while #pageTags < pageCount do table.insert(pageTags, "page " .. (#pageTags + 1)) end
            current = math.clamp(current, 1, pageCount)
            bar.Visible = pageCount > 1
            render()
        end,
    }
    bar.Visible = pageCount > 1
    if tab then tab._pagerApi = api end
    return api
end

