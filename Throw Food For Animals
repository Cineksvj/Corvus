	-- -------------------- Ghost-drag system
	-- Hooked to the top 44 px band of the Main frame.
	local function ensureGhost()
		if window.GhostFrame and window.GhostFrame.Parent then
			return window.GhostFrame
		end
		local ghost = Library:New("Frame", {
			Name = "GhostFrame",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = main.AbsoluteSize and UDim2.new(0, main.AbsoluteSize.X, 0, main.AbsoluteSize.Y) or Size,
			Position = main.Position,
			ZIndex = 50,
			Visible = false,
			Parent = screenGui,
		})
		local outline = Library:Stroke(Colors.metalLo, 1.5, 0.3)
		outline.Name = "GhostOutline"
		outline.Parent = ghost
		Library:Round(12).Parent = ghost  -- same radius as Main so the outline hugs the window

		-- Four L-brackets in each corner (24 px each)
		local function corner(name, anchor, pos)
			local holder = Library:New("Frame", {
				Name = "LBracket_" .. name,
				BackgroundTransparency = 1,
				AnchorPoint = anchor,
				Position = pos,
				Size = UDim2.new(0, 24, 0, 24),
				ZIndex = 51,
				Parent = ghost,
			})

			local vert = Library:New("Frame", {
				Name = "Vert",
				BackgroundColor3 = Colors.metalLo,
				BorderSizePixel = 0,
				Size = UDim2.new(0, 2, 0, 24),
				Position = UDim2.new(0, 0, 0, 0),
				ZIndex = 52,
				Parent = holder,
			})
			local horz = Library:New("Frame", {
				Name = "Horz",
				BackgroundColor3 = Colors.metalLo,
				BorderSizePixel = 0,
				Size = UDim2.new(0, 24, 0, 2),
				Position = UDim2.new(0, 0, 0, 0),
				ZIndex = 52,
				Parent = holder,
			})
			-- Mirror horizontally for TR/BR
			if name == "TR" then
				vert.Position = UDim2.new(1, -2, 0, 0)
				horz.Position = UDim2.new(0, 0, 0, 0)
			elseif name == "BL" then
				vert.Position = UDim2.new(0, 0, 0, 0)
				horz.Position = UDim2.new(0, 0, 1, -2)
			elseif name == "BR" then
				vert.Position = UDim2.new(1, -2, 0, 0)
				horz.Position = UDim2.new(0, 0, 1, -2)
			end
			Library:ApplyGradient(vert, "Metal", { Rotation = 90 })
			Library:ApplyGradient(horz, "Metal", { Rotation = 0 })
			return holder
		end
		corner("TL", Vector2.new(0, 0), UDim2.new(0, 0, 0, 0))
		corner("TR", Vector2.new(1, 0), UDim2.new(1, 0, 0, 0))
		corner("BL", Vector2.new(0, 1), UDim2.new(0, 0, 1, 0))
		corner("BR", Vector2.new(1, 1), UDim2.new(1, 0, 1, 0))

		window.GhostFrame = ghost
		return ghost
	end

