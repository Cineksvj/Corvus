		local session = tab:AddRightGroupbox("Session", "activity")
		-- the session numbers are stat tiles (owner 2026-10-31 evening); a stripped build without
		-- AddStat falls back to one label per line
		local function sessionStat(icon, label, plain, big)
			if type(session.AddStat) == "function" then
				return session:AddStat({ Icon = icon, Text = label, Value = "-", ValueColor = plain and "FontColor" or nil, Size = big and 28 or nil })
			end
			local l = session:AddLabel({ Text = label .. ": -" })
			return { SetValue = function(_, v) l:SetText(label .. ": " .. tostring(v)) end }
		end
		local playersLbl = sessionStat("users", "Players", false, true)   -- one hero tile per tab
		local serverLbl  = sessionStat("server", "Server age", true)
		local sessionLbl = sessionStat("clock", "Session", true)
		local perfLbl    = sessionStat("gauge", "Performance", true)
		local sessionStart = os.clock()
		local meter = { Frames = 0, Elapsed = 0 }
		Library:GiveSignal(RunService.Heartbeat:Connect(function(dt)
			meter.Frames += 1
			meter.Elapsed += tonumber(dt) or 0
		end))
		task.spawn(function()
			while Library.Unloaded ~= true and main.Parent do
				task.wait(1)
				if rawget(Library, "ActiveTab") == tab and main.Visible then
					local players = Players:GetPlayers()
					playersLbl:SetValue(string.format("%d / %d", #players, tonumber(Players.MaxPlayers) or #players))
					serverLbl:SetValue(fmtDuration(Workspace.DistributedGameTime))
					sessionLbl:SetValue(fmtDuration(os.clock() - sessionStart))
					if meter.Elapsed > 0.2 then
						local fps = meter.Frames / meter.Elapsed
						meter.Frames, meter.Elapsed = 0, 0
						local ping = 0
						pcall(function() ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5) end)
						perfLbl:SetValue(string.format("%d fps, %d ms", math.floor(fps + 0.5), ping))
					end
				else
					meter.Frames, meter.Elapsed = 0, 0
				end
			end
		end)

