-- ---------------------------------------------------------------- hex -> Color3
-- Parses "#RRGGBB", "RRGGBB", "RGB" shorthand. Returns Color3; falls back
-- to black on malformed input (Roblox will show it as a bug, not nil-crash).
local function hex(s)
	if typeof(s) == "Color3" then return s end
	if type(s) ~= "string" then return Color3.new(0, 0, 0) end
	local str = s:gsub("^#", "")
	if #str == 3 then
		local r = tonumber(str:sub(1, 1):rep(2), 16) or 0
		local g = tonumber(str:sub(2, 2):rep(2), 16) or 0
		local b = tonumber(str:sub(3, 3):rep(2), 16) or 0
		return Color3.fromRGB(r, g, b)
	end
	if #str == 6 then
		local r = tonumber(str:sub(1, 2), 16) or 0
		local g = tonumber(str:sub(3, 4), 16) or 0
		local b = tonumber(str:sub(5, 6), 16) or 0
		return Color3.fromRGB(r, g, b)
	end
	return Color3.new(0, 0, 0)
end
