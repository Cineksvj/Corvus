	end
	function N.rarityColor(name)
		if not (RarityConfig and type(RarityConfig.List) == "table") then
			return nil
		end
		for _, e in ipairs(RarityConfig.List) do
			if type(e) == "table" and e.Name == name and typeof(e.Color) == "Color3" then
