		tab.Toggles = {}
		local function anyOn()
			for _, t in ipairs(tab.Toggles) do if t.Value then return true end end
			return false
		end
		function tab:_refreshNavPill()
			-- Setup tabs (Info / Settings) carry housekeeping toggles, not automations: no pill.
			-- Owner 2026-10-20: no switches beside the tab names at all (nor the compact on-dots);
			-- StopAll / Resume stay as API for hubs and the Stop everything button.
			if self.OnDot then self.OnDot.Visible = false end
			self.NavPill.Visible = false
		end
		function tab:_registerToggle(t)
			table.insert(self.Toggles, t)
			self:_refreshNavPill()
		end
