-- Autoload report and click log. The library applies the autoload config a moment after the Settings tab is built, so the
-- report and the CLICK hooks wait for it; changes made by the hub itself (Stop everything) stay quiet.
task.delay(3, function()
	local function show(value)
		if type(value) == "table" then
			local keys = {}
			for k, v in pairs(value) do
				table.insert(keys, tostring(if type(k) == "number" then v else k))
			end
			table.sort(keys)
			return "{" .. table.concat(keys, ",") .. "}"
		end
		return tostring(value)
	end
	local restored = {}
	for name, toggle in pairs(Toggles) do
		if toggle.Value == true and not toggle.Default then
			table.insert(restored, name)
		end
	end
	table.sort(restored)
	log("AUTOLOAD toggles=" .. (if #restored > 0 then table.concat(restored, ",") else "-"))
	local function hook(name, element)
		local run = element.RunChanged
		if type(run) ~= "function" or element.Type == "KeyPicker" or element.Type == "ColorPicker" then
			return
		end
		element.RunChanged = function(self, ...)
			if not N.quiet then
				log("CLICK", name .. "=" .. show(element.Value))
			end
			return run(self, ...)
		end
	end
	for name, toggle in pairs(Toggles) do
		hook(name, toggle)
	end
	for name, option in pairs(Options) do
		hook(name, option)
	end
end)

-- Cards for the Plot tab strips: the game's own foods, bars and fences with the player's state on
-- each (owner 2026-10-31 night). Built every refresh; the widget writes only what changed.
local function priceLine(price)
	return if price > 0 then fmtMoney(price) else "Free"
end
local function foodCards(cash, bestBuy)
	local list = {}
	if not (FoodsConfig and type(FoodsConfig.All) == "table") then
		return list
	end
	local equipped = math.floor(num(D("EquippedFood"), 1))
	if bestBuy == nil then
		local _, b = N.bestFoods(cash)
		bestBuy = b
	end
	local equippedPos = nil
	for pos, food in ipairs(FoodsConfig.All) do
		local idx = food.Index
		if equipped == idx then
			equippedPos = pos
		end
		local price = num(food.Price)
		local locked = FoodsConfig.IsLocked and N.call(FoodsConfig.IsLocked, idx) == true
		local owned = idx == 1 or DP("OwnedFoods." .. tostring(idx)) == true
		-- the game's card: the model, the name, the rarity in its colour; ours adds bait + price
		local card = {
			icon = N.foodModel(food) or N.Icons.Bag,
			name = tostring(food.Name),
			tag = tostring(food.Rarity or ""),
			tagColor = N.rarityColor(food.Rarity) or "muted",
			line = string.format("bait %d, %s", math.floor(num(food.Bait)), priceLine(price)),
		}
		if locked then
			card.status, card.dim = "Locked", true
		elseif equipped == idx then
			card.status, card.statusColor, card.selected = "Equipped", "good", true
		elseif owned then
			card.action = { text = "Equip", func = function()
				N.equipFood(idx)
			end }
		elseif price <= cash then
			-- only the best buy wears the bone button; the other buys are quiet (critique 2026-10-31 night)
			local best = bestBuy ~= nil and bestBuy.Index == idx
			card.action = { text = if best then "Buy best" else "Buy", primary = best, func = function()
				N.buyFood(idx)
			end }
		else
			card.status = "Need " .. fmtMoney(price - cash)
		end
		table.insert(list, card)
	end
	return list, equippedPos
end
