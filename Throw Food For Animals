	local function pushCycle(dt)
		table.insert(st.cycleHist, 1, dt)
		st.cycleHist[11] = nil
		local sum = 0
		for _, v in ipairs(st.cycleHist) do
			sum += v
		end
		st.cycleAvg = sum / #st.cycleHist
	end
	-- One throw on the server's floor: Start, the optional saved super, Resolve with a perfect meter, Complete in the
	-- background. The next start is FlightTime + Cooldown + margin after this one; the margin adapts to refusals.
	local function doThrow()
		ensurePatched()
		goTo(launchPos(), 7)
		local t0 = os.clock()
		local start = inv("Throw_Start")
		if not start.Ok then
			st.fails += 1
			st.okStreak = 0
			fail("Start:" .. tostring(start.Reason))
			if start.Reason == "TooFar" then
				tp(launchPos())
				st.nextStartAt = os.clock() + 0.25
			else
				if start.Reason == "Busy" then
					inv("Throw_Cancel")
				end
				st.margin = math.min(st.margin + 0.1, 1.5)
				if os.clock() - st.lastTrainStop < 1.5 then
					st.exitLead = math.min(st.exitLead + 0.1, 1.5)
					note(string.format("exit lead -> %.2f", st.exitLead))
				end
				st.nextStartAt = os.clock() + 0.35
			end
			return
		end
		st.saved = num(start.Saved)
		if cfg.autoSuper and start.SuperOffer and st.saved > 0 then
			local super = inv("Throw_UseSuper")
			if super.Ok then
				st.supers += 1
				st.saved -= 1
			else
				fail("Super:" .. tostring(super.Reason))
			end
		end
		local r = inv("Throw_Resolve", 1)
		if not r.Ok then
			inv("Throw_Cancel")
			fail("Resolve:" .. tostring(r.Reason))
			st.nextStartAt = os.clock() + 0.5
			return
		end
		st.throws += 1
		st.lastDist = math.floor(num(r.Distance))
		st.lastRarity = tostring(r.Rarity or "-")
		st.lastRank = math.floor(num(r.Rank))
		st.lastModel = tostring(r.ModelName or "")
		if r.SuperThrow then
			st.superHits += 1
		end
		local flight = num(r.FlightTime, 6)
		st.nextStartAt = t0 + flight + COOLDOWN + st.margin
		if st.prevStart then
			pushCycle(t0 - st.prevStart)
		end
		st.prevStart = t0
		st.okStreak += 1
		if st.okStreak >= 5 and st.margin > 0.05 then
			st.margin = math.max(0.05, st.margin - 0.05)
			st.okStreak = 0
		end
		-- the first throws and then every 25th: the cycle time is the one number that proves the floor is met
		if st.throws <= 5 or st.throws % 25 == 0 then
			log("THROW", st.throws, st.lastRarity, "#" .. st.lastRank, st.lastModel, st.lastDist .. " studs", string.format("cycle %.2f margin %.2f", st.cycleAvg, st.margin))
		end
		task.spawn(function()
			inv("Throw_Complete")
		end)
	end
