	-- The pet index (owner 2026-10-31 night: the Never sell list is every pet of the game, not the
	-- bag - a pet you never had can still drop and would be sold before you could pick it).
	-- AnimalEconomy.List has every model with its base weight (kg at size 1), income ($/s at size
	-- 1, no mutation), rank and area; AnimalsData gives the display names in area order. A model
	-- that is only in the economy list (unreleased, or a shop pet) follows the areas, by rank, and
	-- joins the Never sell values too.
	local Eco = sreq(child(Config, "AnimalEconomy"), "Config.AnimalEconomy")
	local Lucky = sreq(child(Shared, "LuckyCatch"), "Shared.LuckyCatch")
	N.Pets = {}        -- model -> { model, name, rarity, area, weight, income, rank, icon, mutIcon }
	N.PetByName = {}   -- display name -> the same entry
	do
		local index = animalIndex()
		local pics = if type(IconImages) == "table" and type(IconImages.Animals) == "table" then IconImages.Animals else {}
		local mutPics = if type(IconImages) == "table" and type(IconImages.Mutated) == "table" then IconImages.Mutated else {}
		local list = if type(Eco) == "table" and type(Eco.List) == "table" then Eco.List else {}
		local areaName = {}
		for _, area in ipairs((AreasConfig and AreasConfig.All) or {}) do
			local aname = tostring(area.Name or area.Key)
			areaName[tostring(area.Key)] = aname
			areaName[aname] = aname
		end
		local function add(model, base)
			model = tostring(model)
			if N.Pets[model] then
				return N.Pets[model]
			end
			local info = index[model]
			base = if type(base) == "table" then base else {}
			local e = {
				model = model,
				name = if info then info.name else model,
				rarity = if info then info.rarity else tostring(base.Rarity or "?"),
				area = if info then info.area else (areaName[tostring(base.Area)] or tostring(base.Area or "?")),
				weight = num(base.Weight),
				income = num(base.Income),
				rank = num(base.Rank),
				icon = imageOf(pics[model]),
				mutIcon = imageOf(mutPics[model]) or imageOf(pics[model]),
			}
			N.Pets[model] = e
			N.PetByName[e.name] = e
			return e
		end
		for _, area in ipairs((AreasConfig and AreasConfig.All) or {}) do
			local alist = if type(AnimalsData) == "table" then AnimalsData[area.Key] else nil
			for _, a in ipairs(if type(alist) == "table" then alist else {}) do
				if type(a) == "table" and a.ModelName then
					add(a.ModelName, list[a.ModelName])
				end
			end
		end
		local rest = {}
		for model in pairs(list) do
			if not N.Pets[tostring(model)] then
				table.insert(rest, tostring(model))
			end
		end
		table.sort(rest, function(a, b)
			local ra, rb = num(list[a] and list[a].Rank), num(list[b] and list[b].Rank)
			if ra ~= rb then
				return ra < rb
			end
			return a < b
		end)
		local M = N.SellMeta
		for _, model in ipairs(rest) do
			local e = add(model, list[model])
			if not M.pets.sub[e.name] then
				table.insert(N.SellValues.pets, e.name)
				M.pets.icons[e.name] = e.icon
				M.pets.colors[e.name] = M.rarities.colors[e.rarity]
				M.pets.sub[e.name] = e.area
			end
		end
		log("PETS", #N.SellValues.pets, "in the index,", #rest, "from the economy list only")
	end
	-- Size and mutation maths, from MutationsConfig (verified live 2026-10-31 on 12 bag pets):
	--   income = base income x mutation multiplier x size ^ IncomeExponent (1.8)
	--   weight = base weight x size; the size title is the step count (x1.5 per step)
	local SizeCfg = if type(MutationsConfig) == "table" and type(MutationsConfig.Size) == "table" then MutationsConfig.Size else {}
	local SIZE_STEP = num(SizeCfg.Step, 1.5)
	local INCOME_EXP = num(SizeCfg.IncomeExponent, 1.8)
	N.MutationRank, N.MutationColor, N.RarityRank = { Normal = 0 }, {}, {}
	for i, e in ipairs((MutationsConfig and MutationsConfig.List) or {}) do
		if type(e) == "table" and e.Name then
			N.MutationRank[tostring(e.Name)] = i
			if typeof(e.Color) == "Color3" then
				N.MutationColor[tostring(e.Name)] = e.Color
			end
		end
	end
	for i, e in ipairs((RarityConfig and RarityConfig.List) or {}) do
		if type(e) == "table" and e.Name then
			N.RarityRank[tostring(e.Name)] = num(e.Index, i)
		end
	end
	N.MutationTints = if type(IconImages) == "table" and type(IconImages.MutationTints) == "table" then IconImages.MutationTints else {}
	function N.mutationMult(mut)
		local by = if type(MutationsConfig) == "table" then MutationsConfig.ByName else nil
		local m = if type(by) == "table" then by[mut] else nil
		return num(type(m) == "table" and m.Multiplier, 1)
	end
	-- the size title ("BIG", "HUGE"...) with its colour, or nil at size 1
	function N.sizeTitle(size)
		size = num(size, 1)
		if size <= 1.01 or SIZE_STEP <= 1 then
			return nil
		end
		local titles = SizeCfg.Titles
		if type(titles) ~= "table" or #titles == 0 then
			return nil
		end
		local n = math.clamp(math.floor(math.log(size) / math.log(SIZE_STEP) + 0.5), 1, #titles)
		local t = titles[n]
		if type(t) == "table" then
			return { name = tostring(t.Name or t.Title or t[1] or "?"), color = if typeof(t.Color) == "Color3" then t.Color else nil }
		end
		return { name = tostring(t) }
	end
	-- income $/s, weight kg, mutation name and size of one bag entry
	function N.petStats(e)
		local p = N.Pets[tostring(e.ModelName)]
		local size = num(e.Size, 1)
		if size <= 0 then
			size = 1
		end
		local mut = if type(e.Mutation) == "string" and e.Mutation ~= "" then e.Mutation else "Normal"
		local income = (if p then p.income else 0) * N.mutationMult(mut) * size ^ INCOME_EXP
		return { pet = p, size = size, mutation = mut, income = income, kg = (if p then p.weight else 0) * size }
	end
	function N.fmtKg(kg)
		kg = num(kg)
		if kg >= 1000 then
			local t = kg / 1000
			local text = if t >= 100 then string.format("%.0f t", t) else string.format("%.1f t", t)
			return (text:gsub("%.0 t", " t"))
		end
		return if kg >= 10 then string.format("%.0f kg", kg) else string.format("%.1f kg", kg)
	end
	function N.fmtIncome(n)
		local text = NumberFormat and call(NumberFormat.PerSecond, n)
		return if text then tostring(text) else (fmtMoney(n) .. "/s")
	end
	-- "1 in N" for a size, nil when the game says 1 in 1 (live 2026-11-01: BIG read "1 in 1")
	function N.luckText(size)
		if not Lucky then
			return nil
		end
		local n = call(Lucky.OneIn, num(size, 1))
		if type(n) == "number" and n < 2 then
			return nil
		end
		local t = call(Lucky.Text, num(size, 1))
		if type(t) ~= "string" or t:match("in%s+1$") then
			return nil
		end
		return t
	end
	function N.fmtAgo(sec)
		sec = math.max(0, math.floor(sec))
		if sec < 5 then
			return "now"
		elseif sec < 60 then
			return string.format("%ds ago", sec)
		elseif sec < 3600 then
			return string.format("%dm ago", math.floor(sec / 60))
		end
		return string.format("%dh %02dm ago", math.floor(sec / 3600), math.floor(sec % 3600 / 60))
	end
	-- "500Dd", "$1.2Td/s", "900" -> a number. The suffix table is learnt from the game's own
	-- formatter (Money / PerSecond / Abbreviate at 10^3k), so it follows the game's names - the
	-- two differ (Money has gaps like "1000No", PerSecond says "Dd") and both are accepted.
	local suffixPow = {}
	do
		local function learn(fmt)
			if type(fmt) ~= "function" then
				return
			end
			for k = 1, 30 do
				local s = call(fmt, 10 ^ (3 * k))
				if type(s) == "string" then
					s = s:gsub("^%$", ""):gsub("/s$", "")
					local mant, suf = s:match("^([%d%.,]+)(%a+)$")
					if mant and suf then
						local m = tonumber((mant:gsub(",", ""))) or 1
						local pow = 3 * k - math.floor(math.log10(m) + 0.5)
						if not suffixPow[suf:lower()] then
							suffixPow[suf:lower()] = pow
						end
					end
				end
			end
		end
		if NumberFormat then
			learn(NumberFormat.Money)
			learn(NumberFormat.PerSecond)
			learn(NumberFormat.Abbreviate)
		end
		suffixPow.k = suffixPow.k or 3
		suffixPow.m = suffixPow.m or 6
		suffixPow.b = suffixPow.b or 9
		suffixPow.t = suffixPow.t or 12
	end
	function N.parseMoney(s)
		s = tostring(s or ""):gsub("[%s,%$]", ""):gsub("/s$", "")
		if s == "" then
			return nil
		end
		local mant, suf = s:match("^([%d%.]+)(%a*)$")
		local v = tonumber(mant)
		if not v then
			return nil
		end
		if suf == "" then
			return v
		end
		local pow = suffixPow[suf:lower()]
		return if pow then v * 10 ^ pow else nil
	end
	-- "900", "900kg", "4.5t" -> kg
	function N.parseWeight(s)
		s = tostring(s or ""):gsub("[%s,]", ""):lower()
		local mant, unit = s:match("^([%d%.]+)(%a*)$")
		local v = tonumber(mant)
		if not v then
			return nil
		end
		if unit == "" or unit == "kg" then
			return v
		elseif unit == "t" then
			return v * 1000
		elseif unit == "g" then
			return v / 1000
		end
		return nil
	end

	-- Last catches (owner 2026-10-31 night: "last live catches z ikonkami, kg itd"): every pet
	-- that lands in PlayerData.<uid>.Animals is a catch (a bought pet too). The folder gets its
	-- values a frame after the child, so the read waits 0.2 s. Newest first, 8 kept.
	N.Catches = {}
	local CATCH_MAX = 8
	task.spawn(function()
		local pd = ReplicatedStorage:WaitForChild("PlayerData", 10)
		local mine = pd and pd:WaitForChild(tostring(LocalPlayer.UserId), 10)
		local animals = mine and mine:WaitForChild("Animals", 10)
		if not animals then
			log("catch feed off: PlayerData.Animals not found")
			return
		end
		local conn = animals.ChildAdded:Connect(function(af)
			task.delay(0.2, function()
				if not alive() then
					return
				end
				local mv = af:FindFirstChild("ModelName")
				if not (mv and mv.Value) then
					return
				end
				local mut = af:FindFirstChild("Mutation")
				local sz = af:FindFirstChild("Size")
				local e = { ModelName = tostring(mv.Value), Mutation = if mut then mut.Value else nil, Size = if sz then num(sz.Value, 1) else 1 }
				local s = N.petStats(e)
				table.insert(N.Catches, 1, { id = af.Name, model = e.ModelName, mutation = s.mutation, size = s.size, income = s.income, kg = s.kg, at = os.clock() })
				while #N.Catches > CATCH_MAX do
					table.remove(N.Catches)
				end
			end)
		end)
		if type(Library.GiveSignal) == "function" then
			Library:GiveSignal(conn)
		end
	end)

	-- The bag order (owner 2026-10-31 night: "segregacja inventory... caly robloxowy ekwipunek
	-- zmienia kolejnosc"). The game's Inventory controller keeps one table (Tool -> { Visual = the
	-- Item frame, Key = "a:<id>", ... }; InvButton before game v1191, the hub takes either) in an
	-- upvalue of its Init; with debug.getupvalues the hub maps every
	-- grid button to its animal and gives the grid's UIGridLayout (SortOrder LayoutOrder) its own
	-- order, so the game's own inventory reorders at once. Without getupvalues the control is not
	-- offered (a control that cannot work is not built).
	local InvCtl = sreq(child(Controllers, "Inventory"), "Controllers.Inventory")
	local getups = (type(debug) == "table" and debug.getupvalues) or getupvalues
	N.bagSortAvailable = type(getups) == "function" and type(InvCtl) == "table" and type(InvCtl.Init) == "function"
	-- (critique 2026-11-01: "first" on half the names) one word where one word does
	N.SortModes = { "Game order", "Heaviest", "Lightest", "Highest income", "Lowest income", "Best mutation", "Rarest", "Newest", "Oldest" }
	local SORT_ALIAS = { ["Heaviest first"] = "Heaviest", ["Lightest first"] = "Lightest", ["Rarest first"] = "Rarest", ["Newest first"] = "Newest", ["Oldest first"] = "Oldest" }
	local invMap
	local function findInvMap()
		if invMap then
			return invMap
		end
		if not N.bagSortAvailable then
			return nil
		end
		local ok, ups = pcall(getups, InvCtl.Init)
		if not ok or type(ups) ~= "table" then
			return nil
		end
		for _, u in pairs(ups) do
			if type(u) == "table" then
				local _, first = next(u)
				if type(first) == "table" and (first.Visual ~= nil or first.InvButton ~= nil) and type(first.Key) == "string" then
					invMap = u
					break
				end
			end
		end
		return invMap
	end
	local function invPanel()
		local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		local inv = gui and gui:FindFirstChild("Inventory")
		return inv and inv:FindFirstChild("InventoryPanel")
	end
	N.invPanel = invPanel
	local SORT_KEY = {
		["Heaviest"] = function(a, b) return a.kg > b.kg end,
		["Lightest"] = function(a, b) return a.kg < b.kg end,
		["Highest income"] = function(a, b) return a.income > b.income end,
		["Lowest income"] = function(a, b) return a.income < b.income end,
		["Best mutation"] = function(a, b) if a.mut ~= b.mut then return a.mut > b.mut end return a.income > b.income end,
		["Rarest"] = function(a, b) if a.rar ~= b.rar then return a.rar > b.rar end return a.income > b.income end,
		["Newest"] = function(a, b) return a.n > b.n end,
		["Oldest"] = function(a, b) return a.n < b.n end,
	}
	-- gives every grid button its LayoutOrder for the mode; "Game order" puts back the order the
	-- game gave (kept in an attribute the first time a button is touched)
	-- a row's numbers: the game's own Tool attributes (Weight kg, Income /s, Rarity) when the tool
	-- carries them, the hub's index otherwise (live 2026-11-01: the index put every Meltdown Idol
	-- above the heavier Waste Harvesters)
	local function rowStats(tool, e)
		local s = if type(e) == "table" then N.petStats(e) else { income = 0, kg = 0, mutation = "Normal" }
		s.rarity = if s.pet then s.pet.rarity else nil
		if typeof(tool) == "Instance" then
			local w, inc, rar = tonumber(tool:GetAttribute("Weight")), tonumber(tool:GetAttribute("Income")), tool:GetAttribute("Rarity")
			if w then s.kg = w end
			if inc then s.income = inc end
			if type(rar) == "string" and rar ~= "" then s.rarity = rar end
		end
		return s
	end
	local lastBagRows
	function N.sortBag(mode)
		mode = SORT_ALIAS[mode] or mode
		local map = findInvMap()
		if not map then
			return false, "no map"
		end
		local animals = D("Animals")
		if type(animals) ~= "table" then
			return false, "no data"
		end
		local rows, total = {}, 0
		for tool, v in pairs(map) do
			total += 1
			local btn = type(v) == "table" and (v.InvButton or v.Visual)
			local id = type(v) == "table" and type(v.Key) == "string" and v.Key:match("^a:(.+)$")
			if typeof(btn) == "Instance" and id and btn:IsA("GuiObject") then
				if btn:GetAttribute("CorvusOrder") == nil then
					btn:SetAttribute("CorvusOrder", btn.LayoutOrder)
				end
				local e = animals[id]
				if mode == "Game order" then
					local o = btn:GetAttribute("CorvusOrder")
					if type(o) == "number" and btn.LayoutOrder ~= o then
						btn.LayoutOrder = o
					end
				elseif type(e) == "table" then
					local s = rowStats(if typeof(v.Tool) == "Instance" then v.Tool else tool, e)
					table.insert(rows, {
						btn = btn,
						income = s.income,
						kg = s.kg,
						mut = N.MutationRank[s.mutation] or 0,
						rar = N.RarityRank[s.rarity] or 0,
						n = tonumber(id:match("%d+")) or 0,
					})
				end
			end
		end
		local key = SORT_KEY[mode]
		if key then
			table.sort(rows, function(a, b)
				if key(a, b) then
					return true
				elseif key(b, a) then
					return false
				end
				return a.n < b.n
			end)
			for i, r in ipairs(rows) do
				if r.btn.LayoutOrder ~= i then
					r.btn.LayoutOrder = i
				end
			end
		end
		lastBagRows = { mode = mode, rows = rows, total = total }
		return true, #rows
	end
	-- true while the grid still stands in the order the last pass gave it (same pets, every button
	-- where it was put): the once-a-second pass then costs ten lookups, not a sort
	local function bagStillSorted(mode)
		local last = lastBagRows
		if not last or last.mode ~= mode then
			return false
		end
		local map = findInvMap()
		if not map then
			return false
		end
		local total = 0
		for _ in pairs(map) do
			total += 1
		end
		if total ~= last.total then
			return false
		end
		for i, r in ipairs(last.rows) do
			if not r.btn.Parent or r.btn.LayoutOrder ~= i then
				return false
			end
		end
		return true
	end
	-- applied on every change and once a second while the game's inventory is open (the game
	-- re-sorts the grid on its own updates)
	local lastSortAt, sortLogged = 0, false
	function N.applyBagSort(force)
		if not N.bagSortAvailable then
			return
		end
		local mode = SORT_ALIAS[cfg.sortBag] or cfg.sortBag
		if mode == "Game order" then
			if N.bagSorted then
				N.bagSorted = false
				pcall(N.sortBag, "Game order")
			end
			return
		end
		local now = os.clock()
		if not force and now - lastSortAt < 1 then
			return
		end
		local panel = invPanel()
		if not force and not (panel and panel.Visible) then
			return
		end
		lastSortAt = now
		if not force and bagStillSorted(mode) then
			return
		end
		local ok, res = N.sortBag(mode)
		if ok then
			N.bagSorted = true
			if force then
				log("BAG SORT", mode, res, "items")
			end
		elseif not sortLogged then
			sortLogged = true
			log("BAG SORT failed:", res)
		end
	end
	-- owner 2026-11-01 ("make the bag sorter work on the quick hand too, the bottom bar"): the
	-- hotbar. The same Init keeps the slot table (1..10 -> Tool) and the redraw queue in its
	-- upvalues; both are found by shape, never by index - the slot table is the table whose keys
	-- are slot numbers and whose values are Tools (so it is found once a pet sits in a slot), the
	-- queue the function whose constants are task + defer and nothing of the slots. The hub writes
	-- the slot table in the mode's order and asks the game to redraw; "Game order" puts every
	-- tool back in the slot it first had.
	local getconsts = (type(debug) == "table" and debug.getconstants) or getconstants
	local hotTable, hotQueue, hotNextTry = nil, nil, 0
	local hotOrig = setmetatable({}, { __mode = "k" })
	local function findHotbar()
		if hotTable and hotQueue then
			return hotTable, hotQueue
		end
		if not N.bagSortAvailable or type(getconsts) ~= "function" then
			return nil
		end
		local now = os.clock()
		if now < hotNextTry then
			return nil
		end
		hotNextTry = now + 2
		local ok, ups = pcall(getups, InvCtl.Init)
		if not ok or type(ups) ~= "table" then
			return nil
		end
		for _, u in pairs(ups) do
			if type(u) == "table" and not hotTable then
				local n, good = 0, true
				for k, v in pairs(u) do
					n += 1
					if type(k) ~= "number" or k < 1 or k > 10 or k % 1 ~= 0 or typeof(v) ~= "Instance" or not v:IsA("Tool") then
						good = false
						break
					end
				end
				if good and n > 0 then
					hotTable = u
				end
			elseif type(u) == "function" and not hotQueue then
				local okc, consts = pcall(getconsts, u)
				if okc and type(consts) == "table" then
					local defer, taskc, strings, slot = false, false, 0, false
					for _, cst in pairs(consts) do
						if type(cst) == "string" then
							strings += 1
							if cst == "defer" then defer = true end
							if cst == "task" then taskc = true end
							if cst == "Slot" or cst == "LayoutOrder" or cst == "Visual" or cst == "Item" then slot = true end
						end
					end
					if defer and taskc and strings <= 3 and not slot then
						hotQueue = u
					end
				end
			end
		end
		if hotTable and hotQueue then
			return hotTable, hotQueue
		end
		return nil
	end
	N.findHotbar = findHotbar
	local function hotRows(hot, map, animals)
		local rows, extra = {}, {}
		for slot = 1, 10 do
			local tool = hot[slot]
			if typeof(tool) == "Instance" then
				if hotOrig[tool] == nil then
					hotOrig[tool] = slot
				end
				local v = map and map[tool]
				local id = type(v) == "table" and type(v.Key) == "string" and v.Key:match("^a:(.+)$")
				if not id then
					local a = tool:GetAttribute("AnimalId")
					id = if type(a) == "string" and a ~= "" then a else nil
				end
				local e = id and animals[id]
				if type(e) == "table" then
					local s = rowStats(tool, e)
					table.insert(rows, {
						tool = tool,
						slot = slot,
						income = s.income,
						kg = s.kg,
						mut = N.MutationRank[s.mutation] or 0,
						rar = N.RarityRank[s.rarity] or 0,
						n = tonumber(id:match("%d+")) or 0,
					})
				else
					table.insert(extra, { tool = tool, slot = slot })
				end
			end
		end
		return rows, extra
	end
	function N.sortHotbar(mode)
		mode = SORT_ALIAS[mode] or mode
		local hot, queue = findHotbar()
		if not hot then
			return false, "no slot table"
		end
		local map = findInvMap()
		local animals = D("Animals")
		if type(animals) ~= "table" then
			return false, "no data"
		end
		local rows, extra = hotRows(hot, map, animals)
		local order = {}
		if mode == "Game order" then
			local all = {}
			for _, r in ipairs(rows) do table.insert(all, r) end
			for _, r in ipairs(extra) do table.insert(all, r) end
			table.sort(all, function(a, b) return a.slot < b.slot end)
			local used, rest = {}, {}
			for _, r in ipairs(all) do
				local o = hotOrig[r.tool]
				if type(o) == "number" and not used[o] then
					used[o] = true
					order[o] = r.tool
				else
					table.insert(rest, r.tool)
				end
			end
			local free = 1
			for _, tool in ipairs(rest) do
				while used[free] do
					free += 1
				end
				used[free] = true
				order[free] = tool
			end
		else
			local key = SORT_KEY[mode]
			if not key then
				return false, "no mode"
			end
			table.sort(rows, function(a, b)
				if key(a, b) then
					return true
				elseif key(b, a) then
					return false
				end
				return a.n < b.n
			end)
			table.sort(extra, function(a, b) return a.slot < b.slot end)
			for _, r in ipairs(rows) do table.insert(order, r.tool) end
			for _, r in ipairs(extra) do table.insert(order, r.tool) end
		end
		local changed = false
		for slot = 1, 10 do
			if hot[slot] ~= order[slot] then
				changed = true
				hot[slot] = order[slot]
			end
		end
		if changed then
			task.defer(function()
				pcall(queue)
			end)
		end
		return true, #rows + #extra, changed
	end
	local function hotSig(hot, map)
		local parts = {}
		for slot = 1, 10 do
			local t = hot[slot]
			local v = typeof(t) == "Instance" and map and map[t]
			parts[slot] = if type(v) == "table" and type(v.Key) == "string" then v.Key elseif typeof(t) == "Instance" then t.Name else "-"
		end
		return table.concat(parts, "|")
	end
	-- once a second, whatever the panel does (the hotbar is always on screen): a re-sort only
	-- when the slots changed hands (a catch, a sale, a drag by the game)
	local lastHotAt, lastHotSig, lastHotLog, hotLogged = 0, "", 0, false
	function N.applyHotbarSort(force)
		if not N.bagSortAvailable then
			return
		end
		local now = os.clock()
		if not force and now - lastHotAt < 1 then
			return
		end
		lastHotAt = now
		local mode = SORT_ALIAS[cfg.sortBag] or cfg.sortBag
		local hot = findHotbar()
		if not hot then
			if force and mode ~= "Game order" then
				log("HOTBAR SORT waiting: no slot table yet (an empty hotbar, or no debug.getconstants)")
			end
			return
		end
		local map = findInvMap()
		if mode == "Game order" then
			if N.hotSorted then
				N.hotSorted = false
				local ok, done, res = pcall(N.sortHotbar, "Game order")
				lastHotSig = hotSig(hot, map)
				log("HOTBAR SORT Game order", if ok and done then tostring(res) .. " slots" else tostring(res))
			end
			return
		end
		local sig = hotSig(hot, map)
		if not force and sig == lastHotSig then
			return
		end
		local ok, res, changed = N.sortHotbar(mode)
		if ok then
			N.hotSorted = true
			lastHotSig = hotSig(hot, map)
			if force or (changed and now - lastHotLog > 30) then
				lastHotLog = now
				log("HOTBAR SORT", mode, res, "slots")
			end
		elseif not hotLogged then
			hotLogged = true
			log("HOTBAR SORT failed:", res)
		end
	end

	-- owner 2026-11-01 ("hide money and hide strength ... a streamer mode"): while Streamer mode is
	-- on the game's money and throw power readouts show dots - the HUD (StatsGui) and the owner's
	-- own row of Roblox's player list (Money, Money/s, Throw Power). The game rewrites those labels,
	-- so each is masked again on every write and new ones are caught as they appear; off puts the
	-- real text back. The hub's own money tiles follow cfg.streamer in refreshUI.
	N.MASK = "\u{2022}\u{2022}\u{2022}"
	local streamConns = {}
	local streamOrig = setmetatable({}, { __mode = "k" })
	local function isStreamLabel(d)
		if not d:IsA("TextLabel") then
			return false
		end
		local p = d.Parent
		if not p then
			return false
		end
		if d.Name == "ValueLabel" and (p.Name == "MoneyDisplay" or p.Name == "ThrowPowerDisplay") then
			return true
		end
		if d.Name == "PlayerStatDisplay" and p.Name:sub(1, 9) == "GameStat_" then
			return d:FindFirstAncestor("PlayerEntry_" .. tostring(LocalPlayer.UserId)) ~= nil
		end
		return false
	end
	local function maskLabel(lbl)
		if lbl.Text == N.MASK then
			return
		end
		streamOrig[lbl] = lbl.Text
		lbl.Text = N.MASK
	end
	function N.setStreamer(on)
		cfg.streamer = on == true
		for _, c in ipairs(streamConns) do
			pcall(c.Disconnect, c)
		end
		table.clear(streamConns)
		if not cfg.streamer then
			local back = 0
			for lbl, orig in pairs(streamOrig) do
				if lbl.Parent and lbl.Text == N.MASK then
					lbl.Text = orig
					back += 1
				end
			end
			table.clear(streamOrig)
			log("STREAMER off,", back, "labels back")
			return
		end
		local roots = {}
		local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		local stats = gui and gui:FindFirstChild("StatsGui")
		if stats then
			table.insert(roots, stats)
		end
		local okList, list = pcall(function()
			return game:GetService("CoreGui"):FindFirstChild("PlayerList")
		end)
		if okList and list then
			table.insert(roots, list)
		end
		local masked = 0
		local function hook(d)
			if not isStreamLabel(d) then
				return
			end
			maskLabel(d)
			masked += 1
			table.insert(streamConns, d:GetPropertyChangedSignal("Text"):Connect(function()
				maskLabel(d)
			end))
		end
		for _, root in ipairs(roots) do
			for _, d in ipairs(root:GetDescendants()) do
				hook(d)
			end
			table.insert(streamConns, root.DescendantAdded:Connect(hook))
		end
		if gui then
			-- a StatsGui that comes back after a respawn is hooked again
			table.insert(streamConns, gui.ChildAdded:Connect(function(ch)
				if ch.Name == "StatsGui" and cfg.streamer then
					task.defer(N.setStreamer, true)
				end
			end))
		end
		log("STREAMER on,", masked, "labels masked in", #roots, "roots")
	end
