	local IconImages = sreq(child(Config, "IconImages"), "Config.IconImages")
	local function imageOf(v)
		if type(v) == "number" and v > 0 then
			return "rbxassetid://" .. tostring(math.floor(v))
		end
		if type(v) == "string" and v:match("^rbxassetid://%d+$") then
			return v
		end
		return nil
	end
	N.SellMeta = {
		rarities = { colors = {} },
		mutations = { colors = {} },
		areas = { colors = {}, icons = {} },
		pets = { icons = {}, colors = {}, sub = {} },
	}
	N.SellValues.pets = {}
	do
		local M = N.SellMeta
		for _, e in ipairs((RarityConfig and RarityConfig.List) or {}) do
			if type(e) == "table" and typeof(e.Color) == "Color3" then
				M.rarities.colors[tostring(e.Name)] = e.Color
			end
		end
		for _, e in ipairs((MutationsConfig and MutationsConfig.List) or {}) do
			if type(e) == "table" and typeof(e.Color) == "Color3" then
