	return setmetatable({ _subs = {} }, Signal)
end
function Signal:Connect(fn)
	local t = self._subs
	local id = #t + 1
	t[id] = fn
	return {
		Disconnect = function() t[id] = nil end,
	}
end
function Signal:Fire(...)
	for _, fn in pairs(self._subs) do
		task.spawn(fn, ...)
	end
end
Library._Signal = Signal

-- ---------------------------------------------------------------- gethui / parent
local function getParentGui()
	-- 1) exploit path: gethui() -> hidden ui holder
	if type(gethui) == "function" then
		local ok, h = pcall(gethui)
		if ok and h then return h end
	end
	-- 2) direct CoreGui (works in Studio with LoadStringEnabled or in some executors)
	local ok, c = pcall(function() return CoreGui end)
	if ok and c then
		-- Try an inst parent probe
		local ok2 = pcall(function() local _ = c:GetChildren() end)
		if ok2 then return c end
	end
	-- 3) PlayerGui fallback
	if LocalPlayer then
		local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
		if pg then return pg end
	end
	return CoreGui
end

