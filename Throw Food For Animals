-- owner 2026-11-01 ("the lines that divide everything: make all of them look like the dividers,
-- accent colour so they change with theme"): one groove builder for every rule in the window -
-- the two long window rules, the status-bar rule, the sidebar group grooves and the groupbox
-- dividers. A 1 px line lit at the centre (the theme's metal: its mid tone at the centre, its
-- dark end towards the ends) dying out towards both ends, a soot line beside it. The gradient is
-- registered as a themed "groove", so a theme change repaints it from its own metal.
function Library.GrooveSequence(metal)
	local kps = (typeof(metal) == "ColorSequence") and metal.Keypoints or nil
	local lo, mid = Colors.metalLo, Colors.metalMid
	if kps and #kps >= 2 then
		local a, b = kps[1].Value, kps[#kps].Value
		local _, _, va = a:ToHSV()
		local _, _, vb = b:ToHSV()
		lo = (va < vb) and a or b
		mid = kps[math.ceil(#kps / 2)].Value
	end
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, lo),
		ColorSequenceKeypoint.new(0.5, mid),
		ColorSequenceKeypoint.new(1, lo),
	})
end
-- opts: Vertical, Size, Position, AnchorPoint, ZIndex, Name, Visible, LayoutOrder, Fade (the
-- share of the length that dies out at each end, 0.18 like the sidebar grooves)
function Library:GrooveLine(parent, opts)
	opts = opts or {}
	local vertical = opts.Vertical == true
	local z = opts.ZIndex or ((parent and parent.ZIndex or 1) + 1)
	local fade = math.clamp(tonumber(opts.Fade) or 0.18, 0.02, 0.45)
	local wrap = Library:New("Frame", {
		Name = opts.Name or "Groove",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = opts.AnchorPoint or Vector2.new(0, 0),
		Position = opts.Position or UDim2.new(0, 0, 0, 0),
		Size = opts.Size or (vertical and UDim2.new(0, 2, 1, 0) or UDim2.new(1, 0, 0, 2)),
		Visible = opts.Visible ~= false,
		ZIndex = z,
	})
	if opts.LayoutOrder then wrap.LayoutOrder = opts.LayoutOrder end
	local line = Library:New("Frame", {
		Name = "Line",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = vertical and UDim2.new(0, 1, 1, 0) or UDim2.new(1, 0, 0, 1),
		ZIndex = z,
		Parent = wrap,
	})
	local g = Library:New("UIGradient", {
		Rotation = vertical and 90 or 0,
		Color = Library.GrooveSequence(type(Library.Theme) == "table" and Library.Theme.Metal or nil),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(fade, 0.15),
			NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1 - fade, 0.15),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = line,
	})
	if type(Library.RegisterThemed) == "function" then Library:RegisterThemed(g, "groove") end
	local shade = Library:New("Frame", {
		Name = "Shade",
		BackgroundColor3 = Colors.bg,
		BorderSizePixel = 0,
		Position = vertical and UDim2.new(0, 1, 0, 0) or UDim2.new(0, 0, 0, 1),
		Size = vertical and UDim2.new(0, 1, 1, 0) or UDim2.new(1, 0, 0, 1),
		ZIndex = z,
		Parent = wrap,
	})
	Library:New("UIGradient", {
		Rotation = vertical and 90 or 0,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(math.min(0.49, fade + 0.02), 0.35),
			NumberSequenceKeypoint.new(0.5, 0.15), NumberSequenceKeypoint.new(math.max(0.51, 1 - fade - 0.02), 0.35),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = shade,
	})
	wrap.Parent = parent
	return wrap, line, shade
end

