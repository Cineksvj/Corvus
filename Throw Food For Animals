-- Attach methods to the shared metatables Agent A/B expose. If the
-- library hasn't registered its classes yet, we patch on Library once
-- it appears (polling-free: expect Agent A to call Widgets.install()).
-- =====================================================================
function Widgets.install(opts)
    opts = opts or {}
    local L = opts.Library or Lib()
    if not L then
        warn("[CorvusWidgets] Library not found, deferring install")
        return
    end

    local function attach(cls, name, fn)
        if not cls then return end
        if type(cls) == "table" then
            cls[name] = fn
        end
    end

    -- Agent A should expose Window / Tab / Groupbox class tables under
    -- Library.Classes = { Window = ..., Tab = ..., Groupbox = ... }
    local classes = L.Classes or L
    attach(classes.Tab,      "AddPrimary", function(self, flag, cfg) return Widgets.AddPrimary(self, flag, cfg) end)
    attach(classes.Tab,      "AddPager",   function(self, cfg)       return Widgets.AddPager(self, cfg) end)
    attach(classes.Groupbox, "AddHero",    function(self, cfg)       return Widgets.AddHero(self, cfg) end)
    attach(classes.Groupbox, "AddDonut",   function(self, cfg)       return Widgets.AddDonut(self, cfg) end)
    attach(classes.Window,   "AddFooter",  function(self, cfg)       return Widgets.AddFooter(self, cfg) end)

    -- Expose constellation globally for Agent D background addons to extend
    L.Widgets        = Widgets
    L.Constellation  = Constellation
end

