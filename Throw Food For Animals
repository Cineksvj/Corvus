    dotGlow.Parent = dot
    local pulseInfo = TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, 0)
    TweenService:Create(dot, pulseInfo, { BackgroundTransparency = 0.45 }):Play()
    TweenService:Create(dotGlow, pulseInfo, { Transparency = 0.9 }):Play()

    local online, members, session = cfg.online, cfg.members, cfg.session
    local text = new("TextLabel", {
        Name = "Text",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 19, 0.5, 0),
        Size = UDim2.new(1, -19 - 112, 1, 0),
        BackgroundTransparency = 1,
        FontFace = Fonts.BuilderMed,
        TextSize = 12,
        TextColor3 = Palette.SilverInk,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        RichText = true,
        ZIndex = 4,
        Parent = bar,
    })
    local function discordLink()
        return cfg.discordLink or cfg.DiscordLink or (L and L.DiscordInvite) or "https://discord.gg/corvus"
    end
    -- Only known numbers are shown (no "—" placeholders).
    local function paint()
        if flat then
            -- slim status bar (owner 2026-10-20): the invite link + members, nothing else
            local link = tostring(discordLink()):gsub("^https?://", ""):gsub("/$", "")
            -- (owner 2026-10-31: no middle dots) the muted colour is the separator
            local tail = type(members) == "number" and ("   <font color=\"#7F8389\">" .. fmtThousands(members) .. " members</font>") or ""
            text.Text = link .. tail
            return
        end
        -- "820 online · 6 981 Discord members" (mockup); nothing else, no placeholders
        local head, rest = nil, {}
        if type(online) == "number" then head = fmtThousands(online) .. " online" end
        if type(members) == "number" then table.insert(rest, fmtThousands(members) .. " Discord members") end
        if not head then
            head = table.remove(rest, 1) or "Corvus Discord"
        end
        local tail = #rest > 0 and ("<font color=\"#7F8389\" size=\"11\">, " .. table.concat(rest, ", ") .. "</font>") or ""
        text.Text = head .. tail
    end
    paint()

    -- .btn-disc: metal, radius 10, padding 6px 14px, 10.5px 500, dark text
    local copyBtn = new("TextButton", {
        Name = "CopyDiscord",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 0, 24),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "Copy Discord",
