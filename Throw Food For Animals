		Library:CorvusLog(string.format("AFK guard %s layers=key%s,vu,idled,nudge,rejoin%s",
			Afk.Enabled and "on" or "off", hasVIM and "" or "(no VIM)",
			(typeof(getconnections) == "function") and ",defuse" or ""))
	end)
	task.spawn(function()
		while not Library.Unloaded do
			task.wait(1)
			if Afk.Enabled then
				local n = clock(); local idle = n - Afk.LastInput
				if idle >= Afk.Every then
					Afk.Every = 60 + math.random() * 20; Afk.LastInput = n
					if n - Afk.LastWatchLog >= 300 then
						Afk.LastWatchLog = n
						Library:CorvusLog(string.format("AFK watchdog no input for %.1f min -> nudge", idle / 60))
					end
