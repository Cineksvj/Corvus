	function window:_updateNarrow()
		local k = mainScale.Scale > 0 and mainScale.Scale or 1
		-- a phone keeps two columns down to 400 px of content (the laptop look, owner 2026-11-03)
		self:SetNarrow(self.Touch == true or content.AbsoluteSize.X / k < (touchDevice and 400 or 560))
	end
	function window:SetCompact(v, instant)
		if self.Touch then return self end   -- no sidebar on a phone
		v = v == true
		self.Compact = v
		applySidebarWidth(v and SIDEBAR_MINI or SIDEBAR_FULL, instant)
		wordmarkText.Visible = not v
		versionText.Visible = not v
		-- owner 2026-11-01 ("corvus icon isnt centered"): the mark sits on the column's centre line
		-- (sidebar centre, minus the sidebar's left padding and the wordmark's own 6 px)
		local markCx = math.floor(SIDEBAR_MINI / 2) - sidebarPad.PaddingLeft.Offset - 6
		brandMark.Position = v and UDim2.new(0, markCx - 15, 0, 7) or UDim2.new(0, 3, 0, 7)
		-- compact: the glyph centres in the 36 px icon column
		compactBtn.AnchorPoint = v and Vector2.new(0.5, 0) or Vector2.new(1, 0)
		compactBtn.Position = v and UDim2.new(0.5, 0, 0, 0) or UDim2.new(1, 0, 0, 0)
		collapseRow.Position = UDim2.new(0, 0, 0, v and 48 or 11)
		do
			local top = v and 74 or 50
			-- compact: the list takes the whole inner width, so a row's centre is the column's centre
			local goal = { Position = UDim2.new(0, 0, 0, top), Size = UDim2.new(1, v and 0 or -2, 1, -top) }
			if instant then tabList.Position, tabList.Size = goal.Position, goal.Size
			else Library:NewTween(tabList, 0.22, goal, Enum.EasingStyle.Quint) end
		end
		userName.Visible = not v
		userGame.Visible = false   -- the slim bar has one row: the name only
		userAvatar.Position = v and UDim2.new(0.5, -9, 0, 0) or UDim2.new(0, 0, 0, 0)
		-- (the group words are gone, critique 2026-11-01; the grooves alone separate the groups)
		local innerW = SIDEBAR_MINI - sidebarPad.PaddingLeft.Offset - sidebarPad.PaddingRight.Offset
		local midPad = math.floor((innerW - 24) / 2)   -- the 24 px icon plate centred in the row
		for _, tab in pairs(self.Tabs) do
			if type(tab) == "table" and tab.Entry then
				if tab.EntryName then tab.EntryName.Visible = not v end
				if tab.EntryPad then
					tab.EntryPad.PaddingLeft = UDim.new(0, v and midPad or 10)
					tab.EntryPad.PaddingRight = UDim.new(0, v and midPad or 8)
				end
				if type(tab._refreshNavPill) == "function" then pcall(tab._refreshNavPill, tab) end
			end
		end
		compactBtn.Text = v and "\194\187" or "\194\171"
		if not instant and type(Library.SetSetting) == "function" then pcall(Library.SetSetting, Library, "Compact", v) end
		-- after the 0.22 s width tween: the pill and the narrow check read final sizes
		task.delay(instant and 0 or 0.24, function()
			if self.Compact ~= v then return end
			if self.ActiveTab and self.ActiveTab.Entry then pcall(self.Sidebar.MovePillTo, self.ActiveTab.Entry, true) end
			local he = rawget(self, "_hoverEntry")
			if he then pcall(self.Sidebar.HoverEntry, he) end   -- the row resized under a still pointer
			pcall(self._updateNarrow, self)
		end)
		return self
	end
