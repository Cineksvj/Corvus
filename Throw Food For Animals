	local function sideJobsDue()
		local now = os.clock()
		if (cfg.sell or cfg.equipBest) and now - st.lastSell >= cfg.sellEvery then
			return true
		end
		if (cfg.autoStand or cfg.autoFence or cfg.buyFood) and now - st.lastUpg >= SIDE_JOBS_EVERY then
			return true
		end
		return false
	end
	-- Upgrades in the order bar (xp per rep), food (bait per throw), fence: one purchase per pass.
	local function runSideJobs()
		local now = os.clock()
		local did = false
		if (cfg.sell or cfg.equipBest) and now - st.lastSell >= cfg.sellEvery then
			st.lastSell = now
			did = jobSell() or did
		end
		if (cfg.autoStand or cfg.autoFence or cfg.buyFood) and now - st.lastUpg >= SIDE_JOBS_EVERY then
			st.lastUpg = now
			local budget = money()
			for _, job in ipairs({ tryStand, tryFood, tryFence }) do
				if job(budget) then
					did = true
					break
				end
			end
		end
		return did
	end

	-- One tick: throws take priority, side jobs run in gaps over 1 s, training fills the rest and leaves the bar
	-- trainExitLead before the next throw.
	function N.brain()
		local now = os.clock()
		if not hrp() then
			return
		end
		if st.training and LocalPlayer:GetAttribute("Training") == false then
			st.training = false
		end
		-- a session the player started by hand is taken over
		if not st.training and cfg.train and LocalPlayer:GetAttribute("Training") == true then
			ensurePatched()
			st.training = true
			st.trainStart = now
			st.sessions += 1
		end
		if st.training and not cfg.train then
			stopTraining()
		end
		if st.training and cfg.farm and (st.nextStartAt - now) <= st.exitLead then
			stopTraining()
		end
		if cfg.farm and now >= st.nextStartAt then
			doThrow()
			return
		end
		local gap = if cfg.farm then st.nextStartAt - now else math.huge
		if gap > 1.0 then
			if not st.training then
				if runSideJobs() then
					return
				end
			elseif not cfg.farm and sideJobsDue() then
				stopTraining()
				runSideJobs()
				return
			end
		end
		if cfg.train and not st.training then
			if not cfg.farm then
				startTraining()
			elseif gap >= MIN_TRAIN_GAP and now >= st.hybridBlockedUntil then
				startTraining()
			end
		end
	end
	-- A newer hub instance calls this before it takes over: no training session is left running on the server.
	INSTANCE.onStop = function()
		cfg.farm, cfg.train = false, false
		if st.training then
			pcall(stopTraining)
		end
	end
