-- ============================================================================
--                              TOGGLE (moon toggle)
-- ============================================================================
local Toggle = {}
Toggle.__index = Toggle

function Groupbox:AddToggle(idx, props)
    props = props or {}
    -- Bench: 30 px row, bone-mid label, a 38x20 pill at the right (touchables stay soft).
    -- OFF = well + hairline + slate knob; ON = saffron track + bone knob: the only place a
    -- control uses the accent, because ON is the one live state a toggle has.
    local row = makeRow(self, T(30, 40), "Toggle_" .. tostring(idx or props.Text or "x"))
    local TRACK_W, TRACK_H, KNOB = T(38, 46), T(20, 26), T(14, 20)

    -- Farm 2026-10-20: Risk badge. props.Risk = "green"|"amber"|"red" draws a 8x8 dot
    -- at the left of the label; the label indents by 14 px to make room.
    --   green = dump-confirmed + wired + tested headless (low risk)
    --   amber = wired, live behaviour unverified (medium risk)
    --   red   = dump-only, no live run (high risk — Malicious tab stuff)
    local riskKey = type(props.Risk) == "string" and props.Risk:lower() or nil
    local riskDot
    if riskKey == "green" or riskKey == "amber" or riskKey == "red" then
        local col = Colors.good or Color3.fromRGB(74, 222, 128)
        if riskKey == "amber" then col = Color3.fromRGB(234, 179, 8) end
        if riskKey == "red"   then col = Color3.fromRGB(239, 68, 68) end
        riskDot = new("Frame", {
            Name = "RiskDot",
            BackgroundColor3 = col,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(8, 8),
            ZIndex = 2,
            Parent = row,
        })
        corner(999, riskDot)
    end
    local labelX = riskDot and 14 or 0
    -- props.Input = { Idx, Default, Placeholder, Suffix, Width, Numeric, Callback }: a small text
    -- box between the label and the switch (owner 2026-10-31 night: "textboxy z toggle typu sell
    -- under X"). The box is its own Option (Type "Input", saved by its Idx); a click in it never
    -- flips the switch. Built below, after the track.
    local INPUT_W = type(props.Input) == "table" and (tonumber(props.Input.Width) or 72) or 0
    -- the unit sits outside the box (critique 2026-11-01: "500Dd" and "/s" in one grey inside
    -- one box read as placeholder text; the box is 72 px, the value Oswald, right-aligned)
    local SUF_W = (INPUT_W > 0 and type(props.Input.Suffix) == "string" and props.Input.Suffix ~= "") and (#props.Input.Suffix * 7 + 6) or 0
    local label = text({
        Name = "Label",
        Text = props.Text or "Toggle",
        TextColor3 = Colors.textMid or TEXT_MID,
        TextSize = T(13, 14),
        FontFace = Fonts.Sans,
        Size = UDim2.new(1, -(TRACK_W + 10 + labelX + (INPUT_W > 0 and INPUT_W + SUF_W + 10 or 0)), 1, 0),
        Position = UDim2.new(0, labelX, 0, 0),
        Parent = row,
    })

    local track = new("Frame", {
        Name = "Track",
        BackgroundColor3 = Colors.Well,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(TRACK_W, TRACK_H),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Parent = row,
    })
    -- owner 2026-10-31 (square geometry across the hub): a rounded rectangle, not a pill
    corner(999, track)
    -- owner 2026-10-31 night ("ledwo co widac toggle"): OFF = the window colour, a step darker
    -- than the card, with the well hairline on; the knob stays the light grey
    local trackStroke = stroke(track, Colors.wellEdge or Colors.WellEdge, 1, 0.15)
    local trackScale = new("UIScale", { Scale = 1, Parent = track })
    -- hover: a rounded well under the row, 6 px wider than the content on each side so the
    -- label and the switch sit inside it with air; it never reaches the card edge (owner
    -- 2026-10-31 night: "the highlight only inside"). Built before the label so it draws under it.
    local hoverWell = new("Frame", {
        Name = "Hover",
        BackgroundColor3 = Colors.wellHover or Colors.WellHover,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.new(0, -6, 0, 1),
        Size = UDim2.new(1, 12, 1, -2),
        Parent = row,
    })
    corner(6, hoverWell)
    local hoverEdge = stroke(hoverWell, Colors.WellEdge, 1, 1)
    label.ZIndex, track.ZIndex = 2, 2

    local knob = new("Frame", {
        Name = "Knob",
        BackgroundColor3 = Colors.muted or Colors.Smoke,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(KNOB, KNOB),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 3 + KNOB / 2, 0.5, 0),
        ZIndex = track.ZIndex + 2,
        Parent = track,
    })
    corner(999, knob)
    local knobStroke = stroke(knob, Colors.window or Colors.VoidBase, 1, 1)

    local t = setmetatable({
        Type = "Toggle",
        Idx = idx,
        Value = props.Default == true,
        Default = props.Default == true,
        Text = props.Text or "",
        Row = row,
        Track = track,
        Knob = knob,
        Changed = signal(),
        _callback = props.Callback or function() end,
        _disabled = props.Disabled == true,
        _group = self,
        -- props.Confirm = "<hint>" | true: turning it ON by hand takes a second tap within 3 s (a
        -- phone player kept selling his best pets with one stray tap, Discord 2026-11-03); OFF is
        -- one tap, SetValue from code / config is never gated
        _confirm = (type(props.Confirm) == "string" and props.Confirm ~= "" and props.Confirm) or (props.Confirm == true and "Tap again to turn on") or nil,
    }, Toggle)

    function t:_refresh(animate)
        local dur = animate and 0.14 or 0
        local move = animate and 0.18 or 0
        -- physics: the knob squashes as it leaves and settles with a little overshoot (Back-out)
        if animate and rawget(Library, "LowEffects") ~= true then
            self.Knob.Size = UDim2.fromOffset(KNOB + 5, KNOB - 2)
            tween(self.Knob, 0.2, Enum.EasingStyle.Back, { Size = UDim2.fromOffset(KNOB, KNOB) })
        end
        -- ON = silver track + dark knob (a white knob vanishes on silver); OFF = ash track + grey knob
        if self.Value then
            Edge.set(self.Track, "BackgroundColor3", Colors.needle or Colors.Amber, dur)
            tween(self.Knob, move, Enum.EasingStyle.Back, { Position = UDim2.new(1, -(3 + KNOB / 2), 0.5, 0) })
            Edge.set(self.Knob, "BackgroundColor3", Colors.window or Colors.VoidBase, dur)
        else
            Edge.set(self.Track, "BackgroundColor3", Colors.window or Colors.VoidBase, dur)
            tween(self.Knob, move, Enum.EasingStyle.Back, { Position = UDim2.new(0, 3 + KNOB / 2, 0.5, 0) })
            Edge.set(self.Knob, "BackgroundColor3", Colors.muted or Colors.Smoke, dur)
        end
        -- OFF: the dark track sits in the card with its hairline on; ON: the silver track needs none
        trackStroke.Transparency, knobStroke.Transparency = (self.Value and 1 or 0.15), 1
        -- pass 9: what is running reads first - an ON label takes the bright ink + medium weight,
        -- OFF stays mid grey (only colour/weight; disabled / requires dims stay on TextTransparency)
        tween(label, dur, nil, { TextColor3 = self.Value and (Colors.text or Colors.Ink) or (Colors.textMid or TEXT_MID) })
        label.FontFace = self.Value and (Fonts.SansMed or Fonts.Sans) or Fonts.Sans
        if type(self._refreshDependency) == "function" then self:_refreshDependency() end
    end

    function t:OnChanged(fn)
        return self.Changed:Connect(fn)
    end

    function t:SetValue(v, silent)
        v = v and true or false
        if v == self.Value then return end
        local old = self.Value
        self.Value = v
        self:_refresh(true)
        if self._group and type(self._group._refreshCounter) == "function" then pcall(self._group._refreshCounter, self._group) end
        -- toggles that `Requires` this one redraw their "needs X" box on every change, silent
        -- ones too (config load / batch restore skip Changed, the box must not go stale)
        local deps = rawget(self, "_dependents")
        if deps then
            for _, d in ipairs(deps) do
                if type(d._refreshDependency) == "function" then pcall(d._refreshDependency, d) end
            end
        end
        -- Remember what the user wants ON (tab pill / "Resume" restore this set);
        -- batch stop/resume runs with _batchSuppress so it never rewrites the memory.
        -- rawget: both keys are unset until the first batch / first toggle, and the core's
        -- __index warns once per unknown key (a warn that yields in headless runtimes)
        if not rawget(Library, "_batchSuppress") and type(self.Idx) == "string" then
            local userOn = rawget(Library, "_userOn") or {}
            userOn[self.Idx] = v or nil
            rawset(Library, "_userOn", userOn)
        end
        if self.Tab and type(self.Tab._onToggleChanged) == "function" then
            pcall(self.Tab._onToggleChanged, self.Tab, self, v)
        end
        if not silent then
            task.spawn(self._callback, v)
            self.Changed:Fire(v)
            if Library.OnOptionChanged then Library.OnOptionChanged(self) end
            if type(rawget(Library, "_pushHistory")) == "function" then Library._pushHistory(self, old, v) end
        end
    end

    function t:Toggle() self:SetValue(not self.Value) end

    function t:SetDisabled(v)
        self._disabled = v and true or false
        label.TextTransparency = self._disabled and 0.35 or 0
        self.Track.BackgroundTransparency = self._disabled and 0.5 or 0
    end

    -- Unique feature 4: Requires = "<flag>" draws the dependency. While the parent toggle is off
    -- this row dims and a boxed "needs <parent>" sits before the switch; clicking it turns the
    -- parent on. Nothing here changes what the toggle does, only what the player sees.
    local requires = props.Requires
    if type(requires) == "table" then requires = requires[1] or requires.Flag end
    local needsBox, paintNeeds, depConn
    if type(requires) == "string" and type(Library.StateBox) == "function" then
        needsBox, paintNeeds = Library:StateBox(row, "needs " .. requires, nil, T(16, 22))
        needsBox.AnchorPoint = Vector2.new(1, 0.5)
        needsBox.Position = UDim2.new(1, -(TRACK_W + 10), 0.5, 0)
        needsBox.Visible = false
        -- Farm 2026-10-20: hide the text chip (noise); dim-label on the row is the signal.
        -- The hit area below still works, so clicking the row still turns the parent on.
        needsBox.TextTransparency = 1
        needsBox.BackgroundTransparency = 1
        local ns = needsBox:FindFirstChildOfClass("UIStroke")
        if ns then ns.Transparency = 1 end
        -- the box is 16 / 22 px; its hit (invisible) grows to 36 px on touch
        local hit = new("TextButton", {
            Name = "Hit",
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(1, T(0, 12), 1, T(0, 14)),
            ZIndex = needsBox.ZIndex + 1,
            Parent = needsBox,
        })
        hit.MouseButton1Click:Connect(function()
            local p = Library.Toggles[requires]
            if type(p) == "table" and type(p.SetValue) == "function" then p:SetValue(true) end
        end)
        connectHover(hit, function() paintNeeds("changed") end, function() paintNeeds(nil) end)
        t.NeedsBox, t.NeedsHit = needsBox, hit
    end
    function t:_refreshDependency()
        if not needsBox then return end
        local p = Library.Toggles[requires]
        if type(p) ~= "table" then needsBox.Visible = false return end
        if not depConn then
            -- register with the parent: its SetValue refreshes us, silent or not
            local deps = rawget(p, "_dependents") or {}
            deps[#deps + 1] = t
            rawset(p, "_dependents", deps)
            depConn = true
            local nm = tostring((p.Text and p.Text ~= "") and p.Text or requires)
            if #nm > 18 then nm = nm:sub(1, 17) .. "\226\128\166" end
            needsBox.Text = "needs " .. nm
        end
        local off = not p.Value
        -- Owner 2026-10-20: needs-box used to intercept the click (invisible hit → turned the
        -- parent on, not the dependent). Keep it as a visual hint only; the row click below
        -- now handles the "needs X" case by turning parent ON then flipping the dependent.
        needsBox.Visible = false
        label.TextTransparency = (off or self._disabled) and 0.45 or 0
        -- Knob stays fully opaque so the player sees the state at a glance; track dims to
        -- signal "parent off". Was 0.4 on both → looked broken.
        track.BackgroundTransparency = off and 0.5 or 0
        self.Knob.BackgroundTransparency = 0
    end
    if needsBox then task.defer(function() t:_refreshDependency() end) end

    local inInput
    if INPUT_W > 0 then
        local ip = props.Input
        local box = new("Frame", {
            Name = "Input",
            BackgroundColor3 = Colors.Well,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -(TRACK_W + 10 + SUF_W), 0.5, 0),
            Size = UDim2.fromOffset(INPUT_W, T(22, 28)),
            ZIndex = 3,
            Parent = row,
        })
        corner(4, box)
        local boxStroke = Edge.lit(box)
        if SUF_W > 0 then
            text({
                Name = "Suffix",
                Text = ip.Suffix,
                TextSize = 11,
                FontFace = Fonts.Sans,
                TextColor3 = Colors.glyph or Colors.muted or Colors.Smoke,
                TextXAlignment = Enum.TextXAlignment.Left,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -(TRACK_W + 10), 0.5, 0),
                Size = UDim2.new(0, SUF_W - 5, 1, 0),
                ZIndex = 3,
                Parent = row,
            })
        end
        local tb = new("TextBox", {
            Name = "Box",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 6, 0, 0),
            Size = UDim2.new(1, -12, 1, 0),
            Text = tostring(ip.Default == nil and "" or ip.Default),
            PlaceholderText = tostring(ip.Placeholder or ""),
            PlaceholderColor3 = Colors.muted or Colors.Smoke,
            TextColor3 = Colors.text or Colors.Ink,
            FontFace = Fonts.OswaldMed or Fonts.Display or Fonts.Sans,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Right,
            ClearTextOnFocus = false,
            ZIndex = 4,
            Parent = box,
        })
        local inp = setmetatable({
            Type = "Input",
            Idx = ip.Idx,
            Value = tb.Text,
            Default = tb.Text,
            Text = tostring(props.Text or ""),
            Row = row,
            Box = box,
            TextBox = tb,
            Changed = signal(),
            _callback = ip.Callback or function() end,
            _onFinished = true,
            _numeric = ip.Numeric == true,
        }, Input)
        function inp:SetValue(v, silent)
            v = tostring(v or "")
            if v == self.Value then return end
            local old = self.Value
            self.Value = v
            if tb.Text ~= v then tb.Text = v end
            if not silent then
                task.spawn(self._callback, v)
                self.Changed:Fire(v)
                if Library.OnOptionChanged then Library.OnOptionChanged(self) end
                if type(rawget(Library, "_pushHistory")) == "function" then Library._pushHistory(self, old, v) end
            end
        end
        function inp:GetNumber()
            return tonumber(self.Value) or 0
        end
        tb.Focused:Connect(function()
            Edge.state(boxStroke, "active", 0.14)
            tween(box, 0.14, nil, { BackgroundColor3 = Colors.WellHover })
        end)
        tb.FocusLost:Connect(function()
            Edge.state(boxStroke, "rest", 0.16)
            tween(box, 0.16, nil, { BackgroundColor3 = Colors.Well })
            if inp._numeric and tb.Text ~= "" and not tonumber(tb.Text) then
                Edge.error(boxStroke)
                tb.Text = inp.Value
                return
            end
            inp:SetValue(tb.Text)
        end)
        function inInput(input)
            local inset = GuiService:GetGuiInset()
            local mx, my = input.Position.X + inset.X, input.Position.Y + inset.Y
            local p, s = box.AbsolutePosition, box.AbsoluteSize
            return mx >= p.X and mx <= p.X + s.X and my >= p.Y and my <= p.Y + s.Y
        end
        t.Input = inp
        if ip.Idx then Library.Options[ip.Idx] = inp end
    end

    row.InputBegan:Connect(function(input)
        if t._disabled then return end
        if inInput and inInput(input) then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            pcall(rawget(Library, "PlaySound"), Library, "toggle")
            -- press physics: the switch dips and springs back
            if rawget(Library, "LowEffects") ~= true then
                trackScale.Scale = 0.92
                tween(trackScale, 0.2, Enum.EasingStyle.Back, { Scale = 1 })
            end
            -- Owner 2026-10-20: clicking a dependent row while its parent is off used to
            -- turn only the parent on (the row looked dead for the next click). Now it
            -- turns both on in one tap: parent first, then the dependent.
            if t._confirm and not t.Value then
                if not t._armedAt or os.clock() - t._armedAt > 3 then
                    -- first tap: the label asks for the second one in the warning colour, nothing runs
                    t._armedAt = os.clock()
                    local armed = t._armedAt
                    t._labelText = t._labelText or label.Text
                    label.Text = t._confirm
                    label.TextColor3 = Colors.bad or Colors.warn or Color3.fromRGB(234, 179, 8)
                    task.delay(3, function()
                        if t._armedAt == armed then
                            t._armedAt = nil
                            label.Text = t._labelText or label.Text
                            t:_refresh(false)
                        end
                    end)
                    return
                end
                t._armedAt = nil
                label.Text = t._labelText or label.Text
            end
            if requires and type(Library.Toggles) == "table" then
                local p = Library.Toggles[requires]
                if type(p) == "table" and p.Value == false and not t.Value then
                    if type(p.SetValue) == "function" then pcall(p.SetValue, p, true) end
                end
            end
            t:Toggle()
        end
    end)

    -- feature dot in the constellation watermark (Agent C), lights up when ON
    pcall(function()
        local C = rawget(Library, "Constellation")
        if type(C) == "table" and type(C.register) == "function" then
            C.register(tostring(idx or props.Text or "toggle"), row, t)
        end
    end)
    -- tab-wide stop/resume pill (core) tracks every toggle of its tab
    if self.Tab then
        t.Tab = self.Tab
        if type(self.Tab._registerToggle) == "function" then
            pcall(self.Tab._registerToggle, self.Tab, t)
        end
    end

    connectHover(row,
        function()
            if t._disabled then return end
            tween(hoverWell, 0.09, Enum.EasingStyle.Linear, { BackgroundTransparency = 0 })
            tween(hoverEdge, 0.09, Enum.EasingStyle.Linear, { Transparency = 0.4 })
        end,
        function()
            tween(hoverWell, 0.12, nil, { BackgroundTransparency = 1 })
            tween(hoverEdge, 0.12, nil, { Transparency = 1 })
        end
    )

    attachTooltip(row, props.Tooltip)
    t:_refresh(false)

    if idx then Library.Toggles[idx] = t end
    table.insert(self._controls, t)
    self:_refreshCounter()
    return t
end

-- ============================================================================
--                              SLIDER
-- ============================================================================
-- Owner 2026-10-31 evening ("te slidery brzydkie w chuj"): the label and the readout sit on their
-- own line above a low filling track, so the fill never runs under the text. The track is a
-- 10 px well (14 on touch) with soft ends; the fill grows from the left in silver and brightens
-- under the pointer and while it is held. No knob, no tick scale, no min / max line. A press on
-- the track sets the value there, a drag scrubs it, a tap on the readout types it, the arrow
-- keys step it while hovered (Shift = 10 steps).
local Slider = {}
Slider.__index = Slider

function Groupbox:AddSlider(idx, props)
    props = props or {}
    local LABEL_H = T(18, 22)
    local TRACK_H = T(10, 14)
    local GAP = T(4, 6)
    local VAL_W = T(84, 96)
    local ROW_H = LABEL_H + GAP + TRACK_H + T(6, 8)
    local row = makeRow(self, ROW_H, "Slider_" .. tostring(idx or props.Text or "x"))

    local label = text({
        Name = "Label",
        Text = props.Text or "Slider",
        TextSize = T(13, 14),
        FontFace = Fonts.Sans,
        TextColor3 = Colors.textMid or TEXT_MID,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(1, -(VAL_W + 8), 0, LABEL_H),
        ZIndex = 3,
        Parent = row,
    })
    -- the readout is an Oswald numeral (instrument readout); a tap on it types a number
    local valueLabel = text({
        Name = "Value",
        Text = tostring(props.Default or props.Min or 0) .. (props.Suffix or ""),
        TextSize = T(14, 16),
        FontFace = Fonts.OswaldMed or Fonts.Display or Fonts.Mono,
        TextColor3 = Colors.text or Colors.Ink,
        TextXAlignment = Enum.TextXAlignment.Right,
        Position = UDim2.new(1, -VAL_W, 0, 0),
        Size = UDim2.new(0, VAL_W, 0, LABEL_H),
        ZIndex = 3,
        Parent = row,
    })
    local valueBox = new("TextBox", {
        Name = "ValueBox",
        BackgroundColor3 = Colors.window or Colors.VoidBase,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -VAL_W, 0, 0),
        Size = UDim2.new(0, VAL_W, 0, LABEL_H),
        Text = "",
        FontFace = Fonts.OswaldMed or Fonts.Display or Fonts.Mono,
        TextSize = 13,
        TextColor3 = Colors.text or Colors.Ink,
        TextXAlignment = Enum.TextXAlignment.Right,
        ClearTextOnFocus = false,
        Visible = false,
        ZIndex = 6,
        Parent = row,
    })
    corner(4, valueBox)
    stroke(valueBox, Colors.metalMid or Colors.Brushed, 1, 0.35)
    padding(valueBox, 6, 6, 0, 0)

    local track = new("Frame", {
        Name = "Track",
        BackgroundColor3 = Colors.Well,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, LABEL_H + GAP),
        Size = UDim2.new(1, 0, 0, TRACK_H),
        ClipsDescendants = true,
        Parent = row,
    })
    corner(math.floor(TRACK_H / 2), track)
    local trackStroke = Edge.lit(track)

    -- the fill is silver: brushed at rest, lighter under the pointer, bright while held
    local base, metal = Colors.outline or Colors.Outline, Colors.brushed or Colors.Brushed
    local FILL_IDLE = base:Lerp(metal, 0.7)
    local FILL_HOVER = metal
    local FILL_DRAG = Colors.metalMid or Colors.text or metal
    local fill = new("Frame", {
        Name = "Fill",
        BackgroundColor3 = FILL_IDLE,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
        ZIndex = 2,
        Parent = track,
    })
    corner(math.floor(TRACK_H / 2), fill)
    -- one hit for the whole row: press + move = scrub, a tap on the track = set there, a tap on
    -- the readout = type
    local hit = new("TextButton", {
        Name = "ValueHit",
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 4,
        Parent = row,
    })

    local s = setmetatable({
        Type = "Slider",
        Idx = idx,
        Min = props.Min or 0,
        Max = props.Max or 100,
        Rounding = props.Rounding or 0,
        Suffix = props.Suffix or "",
        Format = props.Format,
        Value = props.Default or props.Min or 0,
        Default = props.Default or props.Min or 0,
        Row = row,
        Label = label,
        Track = track,
        Fill = fill,
        ValueLabel = valueLabel,
        ValueHit = hit,
        ValueBox = valueBox,
        Stroke = trackStroke,
        Changed = signal(),
        _callback = props.Callback or function() end,
        _dragging = false,
        _hover = false,
    }, Slider)

    local function roundTo(v, step)
        if step <= 0 then return math.floor(v + 0.5) end
        local mult = 10 ^ step
        return math.floor(v * mult + 0.5) / mult
    end

    function s:_format(v)
        if type(self.Format) == "function" then
            local ok, out = pcall(self.Format, v)
            if ok and type(out) == "string" then return out end
        end
        return tostring(v) .. self.Suffix
    end

    function s:_refresh(animate)
        local range = self.Max - self.Min
        local pct = range > 0 and (self.Value - self.Min) / range or 0
        pct = math.clamp(pct, 0, 1)
        tween(self.Fill, animate and 0.1 or 0, nil, { Size = UDim2.new(pct, 0, 1, 0) })
        self.ValueLabel.Text = self:_format(self.Value)
    end

    function s:SetValue(v, silent)
        v = roundTo(math.clamp(v, self.Min, self.Max), self.Rounding)
        if v == self.Value then return end
        local old = self.Value
        self.Value = v
        self:_refresh(true)
        if not silent then
            task.spawn(self._callback, v)
            self.Changed:Fire(v)
            if Library.OnOptionChanged then Library.OnOptionChanged(self) end
            -- a drag is one history entry (pushed on release), not one per pixel
            if not self._dragging and type(rawget(Library, "_pushHistory")) == "function" then Library._pushHistory(self, old, v) end
        end
    end

    s:_refresh(false)

    -- owner 2026-11-01 ("ui scale slider glitches"): the UI-scale callback rescales the window
    -- under the pointer, so reading the track's live geometry on every move fed the moved track
    -- back into the value (an oscillation). The track is measured once at the press and that
    -- snapshot maps the pointer for the whole drag.
    local trackX, trackW = nil, nil
    local function valueAt(x)
        local absPos, absSize = trackX or track.AbsolutePosition.X, trackW or track.AbsoluteSize.X
        if absSize <= 0 then return s.Value end
        local pct = math.clamp((x - absPos) / absSize, 0, 1)
        return s.Min + pct * (s.Max - s.Min)
    end
    local function paintFill(col, t)
        Edge.set(fill, "BackgroundColor3", col, t or 0.09, Enum.EasingStyle.Linear)
    end
    local function openTypeBox()
        valueBox.Text = tostring(s.Value)
        valueBox.Visible = true
        valueLabel.Visible = false
        task.defer(function() pcall(valueBox.CaptureFocus, valueBox) end)
    end
    local function onReadout(pos)
        local scale = Library.UIScale or 1
        if scale <= 0 then scale = 1 end
        local readoutX = row.AbsolutePosition.X + row.AbsoluteSize.X - (VAL_W + 4) * scale
        local trackY = track.AbsolutePosition.Y
        return pos.X >= readoutX and pos.Y < trackY
    end

    local pressed, pressX = false, 0
    local pageScroll   -- the page under the slider, paused while a finger holds the knob
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            pressed, pressX = true, input.Position.X
            s._dragFrom = s.Value
            trackX, trackW = track.AbsolutePosition.X, track.AbsoluteSize.X
            -- phones (Discord 2026-11-02, "bugs with the frame"): a finger on the knob also panned
            -- the page's ScrollingFrame, so the page jumped under the drag; the page stands still
            -- while the slider is held (the old library paused it the same way)
            if input.UserInputType == Enum.UserInputType.Touch then
                pageScroll = hit:FindFirstAncestorWhichIsA("ScrollingFrame")
                if pageScroll then pageScroll.ScrollingEnabled = false end
            end
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not pressed then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if not s._dragging then
            if math.abs(input.Position.X - pressX) < 3 then return end
            s._dragging = true
            -- the held bar lights up and the readout brightens while it is held
            paintFill(FILL_DRAG)
            Edge.state(trackStroke, "active", 0.1)
            tween(valueLabel, 0.1, nil, { TextColor3 = Colors.moon or Colors.text or Colors.Ink })
        end
        s:SetValue(valueAt(input.Position.X))
    end)
    UserInputService.InputEnded:Connect(function(input)
        if not pressed then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        pressed = false
        if pageScroll then pageScroll.ScrollingEnabled = true; pageScroll = nil end
        if s._dragging then
            s._dragging = false
            paintFill(s._hover and FILL_HOVER or FILL_IDLE, 0.22)
            Edge.state(trackStroke, s._hover and "hover" or "rest", 0.22)
            tween(valueLabel, 0.22, nil, { TextColor3 = Colors.text or Colors.Ink })
            if s._dragFrom ~= nil and s._dragFrom ~= s.Value and type(rawget(Library, "_pushHistory")) == "function" then
                Library._pushHistory(s, s._dragFrom, s.Value)
            end
        else
            -- a tap: on the readout it opens the type box, anywhere else it sets the value there
            if onReadout(input.Position) then
                openTypeBox()
            else
                s:SetValue(valueAt(input.Position.X))
            end
        end
        s._dragFrom = nil
        trackX, trackW = nil, nil
    end)

    -- hover: the fill and the edge brighten (90 ms, linear); while hovered the arrow keys step the
    -- value (Shift = 10 steps) - precise values without dragging
    connectHover(row,
        function()
            s._hover = true
            if not s._dragging then paintFill(FILL_HOVER); Edge.state(trackStroke, "hover", 0.09) end
        end,
        function()
            s._hover = false
            if not s._dragging then paintFill(FILL_IDLE); Edge.state(trackStroke, "rest", 0.09) end
        end
    )
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or not s._hover or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if focusedTextBox() then return end
        local dir = (input.KeyCode == Enum.KeyCode.Right and 1) or (input.KeyCode == Enum.KeyCode.Left and -1) or 0
        if dir == 0 then return end
        local step = 10 ^ -(s.Rounding or 0)
        if shiftHeld() then step *= 10 end
        s:SetValue(s.Value + dir * step)
    end)
    -- Enter applies the typed number, anything else cancels
    valueBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            local n = tonumber((valueBox.Text:gsub("[^%d%.%-]", "")))
            if n then s:SetValue(n) end
        end
        valueBox.Visible = false
        valueLabel.Visible = true
    end)
    attachTooltip(row, props.Tooltip)

    if idx then Library.Options[idx] = s end
    table.insert(self._controls, s)
    return s
end

-- ============================================================================
--                              INPUT
-- ============================================================================
local Input = {}
Input.__index = Input

function Groupbox:AddInput(idx, props)
    props = props or {}
    local hasLabel = props.Text and props.Text ~= ""
    local BOX_H, LABEL_H = T(32, 40), T(18, 20)
    local height = hasLabel and (LABEL_H + 2 + BOX_H + 4) or (BOX_H + 4)
    local row = makeRow(self, height, "Input_" .. tostring(idx or props.Text or "x"))

    if hasLabel then
        text({
            Name = "Label",
            Text = props.Text,
            TextSize = T(13, 14),
            FontFace = Fonts.Sans,
            TextColor3 = TEXT_MID,  -- one label style for every control (de-AI pass 3)
            Size = UDim2.new(1, 0, 0, LABEL_H),
            Parent = row,
        })
    end

    local box = new("Frame", {
        Name = "Box",
        BackgroundColor3 = Colors.Well,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, BOX_H),
        Position = UDim2.new(0, 0, 0, hasLabel and (LABEL_H + 2) or 0),
        ClipsDescendants = true,   -- owner 2026-11-02: a long URL ran out of the box; it stays under the edge
        Parent = row,
    })
    corner(4, box)
    local boxStroke = Edge.lit(box)
    padding(box, 12, 12, 0, 0)

    local tb = new("TextBox", {
        Name = "Input",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -20, 1, 0),
        ClipsDescendants = true,   -- the text scrolls with the caret instead of spilling over the x
        Text = props.Default or "",
        PlaceholderText = "",   -- drawn by the Placeholder label below, not by the TextBox
        PlaceholderColor3 = Colors.Smoke,
        TextColor3 = Colors.Ink,
        FontFace = props.Numeric and Fonts.Mono or Fonts.Sans,
        TextSize = T(13, 14),
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = props.ClearOnFocus or false,
        Parent = box,
    })
    -- the placeholder as a label of our own (slate, the box's font): an empty box reads as
    -- broken, and TextBox.PlaceholderText is skipped by some renderers / executors
    local ghost = text({
        Name = "Placeholder",
        Text = tostring(props.Placeholder or ""),
        TextSize = T(13, 14),
        FontFace = props.Numeric and Fonts.Mono or Fonts.Sans,
        TextColor3 = Colors.muted or Colors.Smoke,
        Size = UDim2.new(1, -20, 1, 0),
        ZIndex = tb.ZIndex,
        Parent = box,
    })
    local ghostFocused = false
    local function ghostRefresh()
        ghost.Visible = ghost.Text ~= "" and tb.Text == "" and not ghostFocused
    end
    ghostRefresh()
    tb:GetPropertyChangedSignal("Text"):Connect(ghostRefresh)
    tb.Focused:Connect(function() ghostFocused = true; ghostRefresh() end)
    tb.FocusLost:Connect(function() ghostFocused = false; ghostRefresh() end)
    if props.MaxLength and props.MaxLength > 0 then
        tb:GetPropertyChangedSignal("Text"):Connect(function()
            if #tb.Text > props.MaxLength then
                tb.Text = tb.Text:sub(1, props.MaxLength)
            end
        end)
    end

    local clearBtn = new("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(1, -4, 0.5, -8),
        AnchorPoint = Vector2.new(1, 0),
        Text = "x",
        TextColor3 = Colors.Smoke,
        FontFace = Fonts.Sans,
        TextSize = 14,
        Visible = false,
        AutoButtonColor = false,
        Parent = box,
    })

    local inp = setmetatable({
        Type = "Input",
        Idx = idx,
        Value = tb.Text,
        Default = tb.Text,
        Row = row,
        Box = box,
        TextBox = tb,
        Changed = signal(),
        _callback = props.Callback or function() end,
        _onFinished = props.Finished or false,
        _numeric = props.Numeric == true,
    }, Input)

    function inp:SetValue(v, silent)
        v = tostring(v or "")
        if v == self.Value then return end
        local old = self.Value
        self.Value = v
        tb.Text = v
        ghostRefresh()
        if not silent then
            task.spawn(self._callback, v)
            self.Changed:Fire(v)
            if Library.OnOptionChanged then Library.OnOptionChanged(self) end
            if type(rawget(Library, "_pushHistory")) == "function" then Library._pushHistory(self, old, v) end
        end
    end

    function inp:GetNumber()
        return tonumber(self.Value) or 0
    end

    local function sheen()
        sheenPass(box, 0.9)
    end

    tb.Focused:Connect(function()
        -- focus ring: the lit edge goes off and the needle silver takes the whole stroke
        Edge.state(boxStroke, "active", 0.14)
        tween(box, 0.14, nil, { BackgroundColor3 = Colors.WellHover })
        sheen()
    end)
    tb.FocusLost:Connect(function(enterPressed)
        Edge.state(boxStroke, "rest", 0.16)
        tween(box, 0.16, nil, { BackgroundColor3 = Colors.Well })
        if inp._numeric and tb.Text ~= "" and not tonumber(tb.Text) then
            Edge.error(boxStroke)
            tb.Text = inp.Value
            return
        end
        inp:SetValue(tb.Text)
    end)

    tb:GetPropertyChangedSignal("Text"):Connect(function()
        clearBtn.Visible = #tb.Text > 0
        if not inp._onFinished then
            inp.Value = tb.Text
            task.spawn(inp._callback, tb.Text)
            inp.Changed:Fire(tb.Text)
        end
    end)

    clearBtn.MouseButton1Click:Connect(function()
        tb.Text = ""
        inp:SetValue("")
    end)

    if idx then Library.Options[idx] = inp end
    table.insert(self._controls, inp)
    return inp
end

-- ============================================================================
--                              WEBHOOK BOARD
-- ============================================================================
-- groupbox:AddWebhookBoard(idx, { Events = { { Key = "hatch", Text = "Hatches" } | "Key", ... },
--   Default = { { url, events = { [Key] = true } }, ... }, Max = 5, Callback = function(list),
--   Test = function(url, row) })
-- Owner 2026-11-02 (TSR "posts webhook"): several Discord webhooks, each with its own URL box and
-- its own "Posts" multi dropdown; "Add webhook" appends one, Remove drops one. The object is an
-- Option (Library.Options[idx], Type "WebhookBoard"): Value = { { url = "https://...", events =
-- { [Key] = true } }, ... }, saved and loaded by configs, reset by Reset hub options.
-- board:GetWebhooks() returns the rows with an https URL only. The hub keeps its own queue per
-- URL (Discord rate limits), the board only holds the configuration.
local WebhookBoard = {}
WebhookBoard.__index = WebhookBoard

function Groupbox:AddWebhookBoard(idx, props)
    props = props or {}
    local box = self
    local events, eventText, eventKey = {}, {}, {}
    for _, e in ipairs(props.Events or {}) do
        local key, label
        if type(e) == "table" then
            key = e.Key or e[1]
            label = e.Text or e[2] or key
        else
            key, label = e, e
        end
        if key ~= nil then
            key, label = tostring(key), tostring(label)
            table.insert(events, key)
            eventText[key] = label
            eventKey[label] = key
        end
    end
    local labels = {}
    for _, key in ipairs(events) do table.insert(labels, eventText[key]) end
    local maxRows = tonumber(props.Max) or 5

    local board = setmetatable({
        Type = "WebhookBoard",
        Idx = idx,
        Text = props.Text or "Webhooks",
        Value = {},
        Default = {},
        Rows = {},
        Events = events,
        Changed = signal(),
        _callback = props.Callback or function() end,
        _test = props.Test,
        _silent = false,
    }, WebhookBoard)

    -- a saved list comes back from JSON: events as a map, or as an array when it was empty
    local function cleanList(list)
        local out = {}
        for _, w in ipairs(type(list) == "table" and list or {}) do
            if type(w) == "table" then
                local ev = {}
                if type(w.events) == "table" then
                    for k, v in pairs(w.events) do
                        if v == true and eventText[tostring(k)] then
                            ev[tostring(k)] = true
                        elseif type(v) == "string" and eventText[v] then
                            ev[v] = true
                        end
                    end
                end
                table.insert(out, { url = tostring(w.url or w.Url or ""), events = ev })
            end
        end
        return out
    end
    board.Default = cleanList(props.Default)

    function board:_collect()
        local list = {}
        for _, r in ipairs(self.Rows) do
            local ev = {}
            for label, on in pairs(type(r.Dropdown.Value) == "table" and r.Dropdown.Value or {}) do
                if on and eventKey[label] then ev[eventKey[label]] = true end
            end
            table.insert(list, { url = tostring(r.Input.Value or ""), events = ev })
        end
        return list
    end

    function board:_emit()
        if self._silent then return end
        self.Value = self:_collect()
        task.spawn(self._callback, self.Value)
        self.Changed:Fire(self.Value)
        if Library.OnOptionChanged then Library.OnOptionChanged(self) end
    end

    function board:_renumber()
        for i, r in ipairs(self.Rows) do
            r.Label:SetText(string.format("<b>Webhook %d</b>", i))
        end
    end

    function board:GetWebhooks()
        local out = {}
        for _, w in ipairs(self.Value) do
            if type(w.url) == "string" and w.url:match("^https://") then table.insert(out, w) end
        end
        return out
    end

    function board:AddRow(entry, silent)
        if #self.Rows >= maxRows then
            if not silent then Library:Notify(string.format("Up to %d webhooks", maxRows), 3) end
            return nil
        end
        entry = type(entry) == "table" and entry or { url = "", events = {} }
        local r = {}
        r.Label = box:AddLabel({ Text = string.format("<b>Webhook %d</b>", #self.Rows + 1), Scan = false })
        r.Input = box:AddInput(nil, {
            Placeholder = "https://discord.com/api/webhooks/...",
            Default = tostring(entry.url or ""),
            Finished = true,
            Callback = function() board:_emit() end,
        })
        r.Input.Text = "Webhook URL"   -- the undo history names the control by Text
        local picked = {}
        for key, on in pairs(type(entry.events) == "table" and entry.events or {}) do
            if on and eventText[key] then picked[eventText[key]] = true end
        end
        r.Dropdown = box:AddDropdown(nil, {
            Text = "Posts",
            Values = labels,
            Multi = true,
            Default = picked,
            Noun = "posts",
            NoneText = "Nothing",
            Callback = function() board:_emit() end,
        })
        r.Remove = box:AddButton({ Text = "Remove", Variant = "secondary", Func = function() board:RemoveRow(r) end })
        if type(self._test) == "function" then
            r.Remove:AddButton({ Text = "Send a test", Func = function()
                local url = tostring(r.Input.Value or "")
                if not url:match("^https://") then
                    Library:Notify("Paste the webhook URL first", 3)
                    return
                end
                task.spawn(self._test, url, r)
            end })
        end
        r.Instances = { r.Label.Row, r.Input.Row, r.Dropdown.Row, r.Remove.Instance.Parent }
        table.insert(self.Rows, r)
        -- "Add webhook" stays the last row of the card
        if self._addRow then self._addRow.LayoutOrder = box:_next() end
        pcall(box.Resize, box)
        if not silent then self:_emit() end
        return r
    end

    function board:RemoveRow(r)
        local i = table.find(self.Rows, r)
        if not i then return end
        table.remove(self.Rows, i)
        for _, ctl in ipairs({ r.Label, r.Input, r.Dropdown, r.Remove }) do
            local k = table.find(box._controls, ctl)
            if k then table.remove(box._controls, k) end
        end
        pcall(function() if r.Dropdown._open then r.Dropdown:Close() end end)
        for _, inst in ipairs(r.Instances) do pcall(inst.Destroy, inst) end
        self:_renumber()
        pcall(box.Resize, box)
        self:_emit()
    end

    function board:SetValue(list, silent)
        self._silent = true
        while #self.Rows > 0 do self:RemoveRow(self.Rows[#self.Rows]) end
        for _, w in ipairs(cleanList(list)) do self:AddRow(w, true) end
        if #self.Rows == 0 then self:AddRow(nil, true) end   -- one empty box is always there to fill
        self._silent = false
        self.Value = self:_collect()
        if not silent then
            task.spawn(self._callback, self.Value)
            self.Changed:Fire(self.Value)
            if Library.OnOptionChanged then Library.OnOptionChanged(self) end
        end
    end

    local addBtn = box:AddButton({ Text = "Add webhook", Variant = "primary", Tooltip = string.format("Up to %d, each with its own posts", maxRows), Func = function() board:AddRow() end })
    board._addRow = addBtn.Instance.Parent
    board:SetValue(board.Default, true)

    if idx then Library.Options[idx] = board end
    return board
end

