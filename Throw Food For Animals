-- B5 theme engine: presets only change the METAL (every registered gradient repaints live).
local function metalSeq(lo, mid, hi)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, hex(lo)),
		ColorSequenceKeypoint.new(0.55, hex(mid)),
		ColorSequenceKeypoint.new(1.00, hex(hi)),
	})
end
local function darkenSeq(seq, k)
	local pts = {}
	for _, kp in ipairs(seq.Keypoints) do
		table.insert(pts, ColorSequenceKeypoint.new(kp.Time, kp.Value:Lerp(Color3.new(0, 0, 0), k)))
	end
	return ColorSequence.new(pts)
end
