-- groupbox:AddDonutSplit({ Text = "...", Slices = 4 }) -> ring:Set({ {label, value, color?}, ... })
-- 48 ticks coloured by share + a legend with percentages. No image assets.
function Groupbox:AddDonutSplit(props)
    props = props or {}
    local TICKS, R = 48, 26
    local hasTitle = type(props.Text) == "string" and props.Text ~= ""
    local holder = makeRow(self, 72 + (hasTitle and 18 or 0), "DonutSplit")
    if hasTitle then
        text({ Name = "Title", Text = props.Text, TextSize = T(11, 12), FontFace = Fonts.Sans, TextColor3 = Colors.Smoke, Size = UDim2.new(1, 0, 0, 14), Parent = holder })
    end
    local top = hasTitle and 18 or 0
    local ring = new("Frame", {
        Name = "Ring",
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(R * 2 + 8, R * 2 + 8),
        Position = UDim2.new(0, 2, 0, top + 4),
        Parent = holder,
    })
    local ticks = {}
    for i = 1, TICKS do
        local a = (i - 1) / TICKS * math.pi * 2 - math.pi / 2
        local t = new("Frame", {
            BackgroundColor3 = Colors.Well,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, math.cos(a) * R, 0.5, math.sin(a) * R),
            Size = UDim2.fromOffset(3, 3),
            Parent = ring,
        })
        corner(2, t)
        ticks[i] = t
    end
    local centre = text({
        Name = "Centre",
        Text = "",
        TextSize = 11,
        FontFace = Fonts.Mono,
        TextColor3 = Colors.Ink,
        TextXAlignment = Enum.TextXAlignment.Center,
        Size = UDim2.new(1, 0, 1, 0),
        Parent = ring,
    })
    local legend = new("Frame", {
        Name = "Legend",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, R * 2 + 24, 0, top + 2),
        Size = UDim2.new(1, -(R * 2 + 24), 0, 68),
        Parent = holder,
    })
    local rows = {}
    local PALETTE = { Colors.Moon, Colors.Brushed, Colors.Green, Colors.Amber, Colors.Smoke, Colors.Red }
    for i = 1, 6 do
        local r = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 0, (i - 1) * 17), Visible = false, Parent = legend })
        local dot = new("Frame", { BackgroundColor3 = PALETTE[i], BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(6, 6), Parent = r })
        corner(3, dot)
        local lbl = text({ Name = "Label", Text = "", TextSize = 12, FontFace = Fonts.Sans, TextColor3 = TEXT_MID, Size = UDim2.new(1, -60, 1, 0), Position = UDim2.new(0, 12, 0, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = r })
        local val = text({ Name = "Value", Text = "", TextSize = 11, FontFace = Fonts.Mono, TextColor3 = Colors.Brushed, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0, 56, 1, 0), Position = UDim2.new(1, -56, 0, 0), Parent = r })
        rows[i] = { Row = r, Dot = dot, Label = lbl, Value = val }
    end
    local api = { Type = "DonutSplit", Instance = holder }
    function api:Set(slices)
        slices = type(slices) == "table" and slices or {}
        local total = 0
        for _, s in ipairs(slices) do total += math.max(0, tonumber(s.value) or 0) end
        local idx = 1
        for i = 1, 6 do
            local s = slices[i]
            local row = rows[i]
            if s and i <= #slices then
                local v = math.max(0, tonumber(s.value) or 0)
                local share = total > 0 and v / total or 0
                local col = s.color or PALETTE[i]
                row.Dot.BackgroundColor3 = col
                local lt = tostring(s.label or "")
                if row.Label.Text ~= lt then row.Label.Text = lt end
                local vt = string.format("%d%%", math.floor(share * 100 + 0.5))
                if row.Value.Text ~= vt then row.Value.Text = vt end
                row.Row.Visible = true
                local count = math.floor(share * TICKS + 0.5)
                for _ = 1, count do
                    if idx <= TICKS then
                        ticks[idx].BackgroundColor3 = col
                        ticks[idx].BackgroundTransparency = 0
                        idx += 1
                    end
                end
            else
                row.Row.Visible = false
            end
        end
        for i = idx, TICKS do
            ticks[i].BackgroundColor3 = Colors.Well
            ticks[i].BackgroundTransparency = 0
        end
        centre.Text = total > 0 and tostring(math.floor(total + 0.5)) or ""
    end
    table.insert(self._controls, api)
    return api
end

-- ============================================================================
--                              DROPDOWN
-- ============================================================================
local Dropdown = {}
Dropdown.__index = Dropdown

local function closeAllDropdowns()
    for _, d in pairs(Library.OpenedFrames) do
        if d.Type == "Dropdown" and d._open then d:Close() end
    end
end

-- a value colour too dark to read on the menu (TFF's Secret rarity is near black) lifts
-- towards white for its text; the dot beside it keeps the true colour
local function readableOn(c)
    if typeof(c) ~= "Color3" then return c end
    local lum = 0.2126 * c.R + 0.7152 * c.G + 0.0722 * c.B
    if lum < 0.32 then return c:Lerp(Color3.new(1, 1, 1), 0.55) end
    return c
end

function Groupbox:AddDropdown(idx, props)
    props = props or {}
    local hasLabel = props.Text and props.Text ~= ""
    local PILL_H, LABEL_H = T(28, 40), T(18, 20)
    local height = hasLabel and (LABEL_H + 4 + PILL_H + 2) or PILL_H
    local row = makeRow(self, height, "Dropdown_" .. tostring(idx or props.Text or "x"))

    if hasLabel then
        text({
            Name = "Label",
            Text = props.Text,
            TextSize = T(13, 14),
            FontFace = Fonts.Sans,
            TextColor3 = TEXT_MID,  -- one label style for every control (de-AI pass 3)
            Size = UDim2.new(1, 0, 0, LABEL_H),
            Parent = row,
        })
    end

    -- Bench (bench3 note): a chooser is a sharp 4 px hairline box, not a filled rectangle; the
    -- well appears under the pointer and while the list is open
    -- owner 2026-10-31 evening: a filled well (the same one the slider track sits on), 6 px
    -- corners, a quiet hairline; the hairline brightens on hover and while open
    local pill = new("TextButton", {
        Name = "Pill",
        BackgroundColor3 = Colors.well or Colors.Well,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, PILL_H),
        Position = UDim2.new(0, 0, 0, hasLabel and (LABEL_H + 4) or 0),
        Text = "",
        AutoButtonColor = false,
        Parent = row,
    })
    corner(6, pill)
    local pillStroke = Edge.lit(pill)
    padding(pill, 12, 10, 0, 0)

    local valueText = text({
        Name = "Value",
        Text = "...",
        TextSize = T(13, 14),
        FontFace = Fonts.Sans,
        TextColor3 = Colors.Ink,
        Size = UDim2.new(1, -24, 1, 0),
        Parent = pill,
    })

    local chevron = makeChevron(pill, 14, Colors.muted or Colors.Brushed)
    chevron.Position = UDim2.new(1, 3, 0.5, 0)
    local CHEV_REST, CHEV_LIT = Colors.muted or Colors.Brushed, Colors.text or Colors.Ink
    local function tintChevron(col)
        for _, t in ipairs(chevron:GetChildren()) do
            if t.Name == "Tick" then tween(t, 0.12, nil, { BackgroundColor3 = col }) end
        end
    end

    local d = setmetatable({
        Type = "Dropdown",
        Idx = idx,
        Values = props.Values or {},
        Value = nil,
        Multi = props.Multi == true,
        Searchable = props.Searchable == true,
        MaxVisible = props.MaxVisible or (props.Searchable and 6 or 8),
        SearchHint = props.SearchHint,
        -- Noun (plural, "rarities") writes "All 7 rarities" on the pill and "Search 148 pets" in
        -- the box; NoneText replaces "None" (critique 2026-11-01: four pills reading All / All /
        -- All / None said nothing)
        Noun = props.Noun,
        NoneText = props.NoneText,
        -- Placeholder: the pill with nothing picked ("Pick a config"); EmptyText: the pill and the
        -- one row of a list with no values ("No configs yet"), owner 2026-11-01
        Placeholder = props.Placeholder,
        EmptyText = props.EmptyText,
        -- per-value extras, each a map value -> x: Icons (image id, drawn 22 px at the left of
        -- the row), Colors (Color3, the row text in that colour; without an icon a 8 px dot of
        -- it marks the row), Sub (a short muted note at the right, searched too). SetMeta
        -- replaces any of them; the open list keeps its rows until it opens again.
        Meta = { icons = props.Icons or {}, colors = props.Colors or {}, sub = props.Sub or {}, tags = props.Tags or {} },
        TagFilterText = props.TagFilterText,
        Row = row,
        Pill = pill,
        ValueText = valueText,
        Changed = signal(),
        _open = false,
        _menu = nil,
        _callback = props.Callback or function() end,
    }, Dropdown)

    if d.Multi then
        d.Value = type(props.Default) == "table" and props.Default or {}
    else
        d.Value = props.Default or (d.Values[1] or nil)
    end

    function d:_formatValue()
        if self.Multi then
            local keys = {}
            for k in pairs(self.Value) do if self.Value[k] then table.insert(keys, tostring(k)) end end
            if #keys == 0 then return self.NoneText or "None" end
            if #keys > 1 and #keys == #self.Values then return self.Noun and ("All " .. #self.Values .. " " .. self.Noun) or "All" end
            table.sort(keys)
            if #keys == 1 then return keys[1] end
            if #keys <= 3 then return table.concat(keys, ", ") end
            return keys[1] .. ", +" .. (#keys - 1)
        end
        if self.Value == nil then
            if #self.Values == 0 then return self.EmptyText or self.Placeholder or "..." end
            return self.Placeholder or "..."
        end
        return tostring(self.Value)
    end

    function d:_refresh()
        self.ValueText.Text = self:_formatValue()
        -- one picked value with a picture / colour: the pill wears them too
        local meta = self.Meta or {}
        local one = nil
        if self.Multi then
            local n = 0
            for k, on in pairs(self.Value) do
                if on then n += 1; one = k end
            end
            if n ~= 1 then one = nil end
        else
            one = self.Value
        end
        local icon = (one ~= nil and meta.icons) and meta.icons[one] or nil
        local col = (one ~= nil and meta.colors) and meta.colors[one] or nil
        local pic = self.Pill:FindFirstChild("Pic")
        if icon then
            if not pic then
                pic = new("ImageLabel", {
                    Name = "Pic",
                    BackgroundTransparency = 1,
                    ScaleType = Enum.ScaleType.Fit,
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 0, 0.5, 0),
                    Size = UDim2.fromOffset(20, 20),
                    ZIndex = self.Pill.ZIndex + 1,
                    Parent = self.Pill,
                })
            end
            pic.Image = tostring(icon)
            pic.Visible = true
            self.ValueText.Position = UDim2.new(0, 26, 0, 0)
            self.ValueText.Size = UDim2.new(1, -50, 1, 0)
        else
            if pic then pic.Visible = false end
            self.ValueText.Position = UDim2.new(0, 0, 0, 0)
            self.ValueText.Size = UDim2.new(1, -24, 1, 0)
        end
        self.ValueText.TextColor3 = typeof(col) == "Color3" and readableOn(col) or Colors.Ink
        -- the "n of N" count in an open multi list
        local cl = self._countLbl
        if cl and cl.Parent and self.Multi then
            local n = 0
            for _, on in pairs(self.Value) do if on then n += 1 end end
            cl.Text = tostring(n) .. " of " .. tostring(#self.Values)
        end
    end

    function d:_isSelected(v)
        if self.Multi then return self.Value[v] == true end
        return self.Value == v
    end

    local function snapshot(v)
        if type(v) ~= "table" then return v end
        local c = {}
        for k, x in pairs(v) do c[k] = x end
        return c
    end

    function d:_select(v)
        local old = snapshot(self.Value)
        if self.Multi then
            self.Value[v] = not self.Value[v] or nil
        else
            self.Value = v
            self:Close()
        end
        self:_refresh()
        task.spawn(self._callback, self.Value)
        self.Changed:Fire(self.Value)
        if Library.OnOptionChanged then Library.OnOptionChanged(self) end
        if type(rawget(Library, "_pushHistory")) == "function" then Library._pushHistory(self, old, snapshot(self.Value)) end
    end

    function d:SetValue(v, silent)
        local old = snapshot(self.Value)
        if self.Multi then
            self.Value = type(v) == "table" and v or {}
        else
            self.Value = v
        end
        self:_refresh()
        if not silent then
            task.spawn(self._callback, self.Value)
            self.Changed:Fire(self.Value)
            if type(rawget(Library, "_pushHistory")) == "function" then Library._pushHistory(self, old, snapshot(self.Value)) end
        end
    end

    function d:SetMeta(m)
        if type(m) ~= "table" then return end
        local meta = self.Meta or { icons = {}, colors = {}, sub = {} }
        meta.icons = m.icons or m.Icons or meta.icons
        meta.colors = m.colors or m.Colors or meta.colors
        meta.sub = m.sub or m.Sub or meta.sub
        meta.tags = m.tags or m.Tags or meta.tags
        self.Meta = meta
        self:_refresh()
    end

    function d:SetValues(list)
        self.Values = list or {}
        if self._menu then self:Close() end
        if not self.Multi then
            local ok = false
            for _, v in ipairs(self.Values) do if v == self.Value then ok = true break end end
            if not ok then self.Value = self.Values[1] end
        end
        self:_refresh()
    end

    function d:Open()
        if self._open then return end
        closeAllDropdowns()
        self._open = true
        Library.OpenedFrames[self] = self
        Edge.state(pillStroke, "active", 0.14)
        tween(pill, 0.14, nil, { BackgroundColor3 = Colors.wellHover or Colors.WellHover })
        tween(chevron, 0.2, Enum.EasingStyle.Quint, { Rotation = 180 })
        tintChevron(CHEV_LIT)
        self:_buildMenu()
    end

    function d:Close()
        if not self._open then return end
        self._open = false
        Library.OpenedFrames[self] = nil
        Edge.state(pillStroke, "rest", 0.14)
        tween(pill, 0.14, nil, { BackgroundColor3 = Colors.well or Colors.Well })
        tween(chevron, 0.2, Enum.EasingStyle.Quint, { Rotation = 0 })
        tintChevron(CHEV_REST)
        if self._menu then
            local m = self._menu
            self._menu = nil
            tween(m, 0.12, nil, { BackgroundTransparency = 1 })
            local ms, fold = self._menuScale, self._menuFold
            if ms and ms.Parent == m then tween(ms, 0.12, Enum.EasingStyle.Quad, { Scale = (Library.UIScale or 1) * 0.96 }) end
            if fold then tween(m, 0.12, Enum.EasingStyle.Quad, { Position = fold, Size = self._menuFoldSize or m.Size }) end
            local sh = self._menuShadow
            if sh and sh.Parent == m then tween(sh, 0.12, nil, { BackgroundTransparency = 1 }) end
            self._menuScale, self._menuFold, self._menuShadow, self._menuFoldSize = nil, nil, nil, nil
            task.delay(0.14, function() if m then m:Destroy() end end)
        end
    end

    function d:_buildMenu()
        local gui = Library.ScreenGui
        if not gui then
            -- fallback: parent to player gui
            gui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
        end
        if not gui then return end

        local mobile = isTouch()
        if mobile then
            self:_buildMenuMobile(gui)
        else
            self:_buildMenuDesktop(gui)
        end
    end

    function d:_buildMenuDesktop(gui)
        local pillPos = self.Pill.AbsolutePosition
        local pillSize = self.Pill.AbsoluteSize
        -- critique 2026-11-01: the pill's width is screen pixels and the menu wears its own
        -- UIScale, so the list came out 18 % wider than the pill and ran into the card edge;
        -- every size below is in the menu's unscaled units (k), every position in screen pixels
        local k = Library.UIScale or 1
        if k <= 0 then k = 1 end
        local menuWidth = math.max(pillSize.X / k, 160)
        do
            local meta = self.Meta or {}
            if type(meta.sub) == "table" and next(meta.sub) ~= nil then
                menuWidth = math.max(menuWidth, pillSize.X / k + 56)
            end
        end
        -- an empty list keeps one row (it says so: EmptyText), owner 2026-11-01
        local itemCount = math.max(1, math.min(#self.Values, self.MaxVisible))
        local ITEM_H = 30
        local function heightFor(n)
            return n * ITEM_H + math.max(0, n - 1) * 2 + (self.Searchable and 36 or 0) + (self.Multi and 22 or 0) + 12
        end
        local menuHeight = heightFor(itemCount)

        -- Anchor under the pill in the ScreenGui's own space; flip above when the bottom is
        -- too close, and when neither side has the room, shorten the list (three rows at the
        -- least) and let it scroll. Solid card skin (a glass gradient on the popup itself made
        -- the list read as a see-through smear).
        local guiPos = gui.AbsolutePosition
        local guiSize = gui.AbsoluteSize
        local x = pillPos.X - guiPos.X
        local below = pillPos.Y - guiPos.Y + pillSize.Y + 4
        local above = pillPos.Y - guiPos.Y - 4
        local y = below
        if guiSize.Y > 0 and below + menuHeight * k > guiSize.Y - 8 then
            if above - menuHeight * k >= 8 then
                y = above - menuHeight * k
            else
                local roomBelow, roomAbove = guiSize.Y - 8 - below, above - 8
                local fitN = itemCount
                while fitN > 3 and heightFor(fitN) * k > math.max(roomBelow, roomAbove) do fitN -= 1 end
                itemCount = fitN
                menuHeight = heightFor(itemCount)
                if roomAbove > roomBelow then y = math.max(8, above - menuHeight * k) else y = below end
            end
        end
        if guiSize.X > 0 then
            menuWidth = math.min(menuWidth, math.max(160, (guiSize.X - 16) / k))
            x = math.max(8, math.min(x, guiSize.X - menuWidth * k - 8))
        end

        local menu = new("Frame", {
            Name = "DropdownMenu",
            BackgroundColor3 = Colors.Slate,
            BackgroundTransparency = 0,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(menuWidth, menuHeight),
            Position = UDim2.fromOffset(x, y),
            Parent = gui,
            ZIndex = 50,
        })
        if type(Library.CardSkin) == "function" then
            Library.CardSkin(menu, 10)
            menu.BackgroundTransparency = 0
        else
            corner(10, menu)
            stroke(menu, Colors.Outline, 1, 0)
        end
        padding(menu, 6, 6, 6, 6)
        -- owner 2026-10-31 night ("animacje dropdownow lepsze"): the list unfolds. It starts at
        -- 84 % of its height, 8 px towards the pill and a hair small, and reaches its place in
        -- 0.2 s on a Quint while the rows fade in one after another (buildItems, 22 ms apart).
        -- Close folds it back. Scale on the menu's own UIScale, so it multiplies the UI scale.
        local k = Library.UIScale or 1
        local menuScale = new("UIScale", { Scale = k * 0.98, Parent = menu })
        local flip = y < below
        local foldPos = UDim2.fromOffset(x, y + (flip and 8 or -8))
        local foldSize = UDim2.fromOffset(menuWidth, math.floor(menuHeight * 0.84))
        local fullSize = UDim2.fromOffset(menuWidth, menuHeight)
        menu.Position, menu.Size = foldPos, foldSize
        if rawget(Library, "LowEffects") == true then
            menuScale.Scale, menu.Position, menu.Size = k, UDim2.fromOffset(x, y), fullSize
            self._stagger = false
        else
            tween(menuScale, 0.2, Enum.EasingStyle.Quint, { Scale = k })
            tween(menu, 0.2, Enum.EasingStyle.Quint, { Position = UDim2.fromOffset(x, y), Size = fullSize })
            self._stagger = true
            task.delay(0.4, function() self._stagger = false end)
        end
        self._menuScale, self._menuFold, self._menuFoldSize = menuScale, foldPos, foldSize

        -- soft drop shadow
        local shadow = new("Frame", {
            BackgroundColor3 = Colors.bg or Colors.VoidBase,
            BackgroundTransparency = 0.5,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 12, 1, 14),
            Position = UDim2.fromOffset(-6, -3),
            ZIndex = 49,
            Parent = menu,
        })
        corner(14, shadow)
        self._menuShadow = shadow

        local filter
        if self.Searchable then
            local sb = new("TextBox", {
                BackgroundColor3 = Colors.Well,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 28),
                Text = "",
                PlaceholderText = tostring(self.SearchHint or ("Search " .. #self.Values .. (self.Noun and (" " .. self.Noun) or ""))),
                PlaceholderColor3 = Colors.Smoke,
                TextColor3 = Colors.Ink,
                FontFace = Fonts.Sans,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = menu,
                ZIndex = 51,
            })
            corner(4, sb)
            stroke(sb, Colors.WellEdge, 1, 0)
            padding(sb, 10, 10, 0, 0)
            filter = sb
        end

        local headH = (filter and 32 or 0) + (self.Multi and 22 or 0)
        local scroll = new("ScrollingFrame", {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 1, -headH),
            Position = UDim2.new(0, 0, 0, headH),
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 0,
            ScrollBarImageColor3 = Colors.Smoke,
            ElasticBehavior = Enum.ElasticBehavior.Always,
            Parent = menu,
            ZIndex = 51,
        })
        listLayout(scroll, Enum.FillDirection.Vertical, 2)

        -- keyboard / hover cursor (pass 8): one highlighted option, moved by the pointer or by
        -- Up / Down; Enter picks it, Esc closes. The highlight eases in instead of snapping.
        local navItems, cursorItem = {}, nil
        local function setCursor(item)
            if cursorItem and cursorItem ~= item and cursorItem.Button.Parent then
                tween(cursorItem.Button, 0.1, nil, { BackgroundTransparency = 1 })
            end
            cursorItem = item
            if item and item.Button.Parent then
                tween(item.Button, 0.1, nil, { BackgroundTransparency = 0 })
                -- keep a keyboard-moved cursor inside the scroll view
                local top = item.Button.AbsolutePosition.Y - scroll.AbsolutePosition.Y
                local bottom = top + item.Button.AbsoluteSize.Y
                local k2 = Library.UIScale or 1
                if top < 0 then
                    scroll.CanvasPosition = Vector2.new(0, scroll.CanvasPosition.Y + top / k2)
                elseif bottom > scroll.AbsoluteSize.Y then
                    scroll.CanvasPosition = Vector2.new(0, scroll.CanvasPosition.Y + (bottom - scroll.AbsoluteSize.Y) / k2)
                end
            end
        end
        local function moveCursor(step)
            if #navItems == 0 then return end
            local idx = 0
            for i, it in ipairs(navItems) do if it == cursorItem then idx = i break end end
            if idx == 0 then idx = step > 0 and 1 or #navItems else idx = math.clamp(idx + step, 1, #navItems) end
            setCursor(navItems[idx])
        end

        local function buildItems(query)
            navItems, cursorItem = {}, nil
            scroll:ClearAllChildren()
            listLayout(scroll, Enum.FillDirection.Vertical, 2)
            query = query and query:lower() or ""
            local meta = self.Meta or {}
            local built = 0
            for _, v in ipairs(self.Values) do
                local label = tostring(v)
                local icon = meta.icons and meta.icons[v]
                local col = meta.colors and meta.colors[v]
                local tcol = readableOn(col)
                local sub = meta.sub and meta.sub[v]
                local tag = meta.tags and meta.tags[v]
                local hit = query == "" or label:lower():find(query, 1, true) or (sub and tostring(sub):lower():find(query, 1, true))
                if self._tagsOnly and not tag then hit = false end
                if hit then
                    -- owner 2026-10-31 evening: the row fills with the well under the cursor; the
                    -- picked one shows a check at the right and reads in full text colour (the
                    -- metal dot is gone)
                    local opt = new("TextButton", {
                        BackgroundColor3 = Colors.wellHover or Colors.WellHover,
                        BackgroundTransparency = 1,
                        BorderSizePixel = 0,
                        Size = UDim2.new(1, 0, 0, ITEM_H),
                        Text = "",
                        AutoButtonColor = false,
                        Parent = scroll,
                        ZIndex = 52,
                    })
                    corner(6, opt)
                    padding(opt, 10, 8, 0, 0)

                    local selected = self:_isSelected(v)
                    -- a multi list draws a 16 px box at the right of every row and the check
                    -- inside it (critique 2026-11-01: a multi-select with no checkboxes)
                    local cbox
                    if self.Multi then
                        cbox = new("Frame", {
                            Name = "CheckBox",
                            BackgroundColor3 = Colors.wellHover or Colors.WellHover,
                            BackgroundTransparency = selected and 0 or 1,
                            BorderSizePixel = 0,
                            AnchorPoint = Vector2.new(1, 0.5),
                            Position = UDim2.new(1, 0, 0.5, 0),
                            Size = UDim2.fromOffset(16, 16),
                            Parent = opt,
                            ZIndex = 53,
                        })
                        corner(4, cbox)
                        stroke(cbox, selected and (Colors.metalLo or Colors.Brushed) or Colors.WellEdge, 1, 0)
                    end
                    local tick
                    if type(Library.GlassIcon) == "function" then
                        tick = Library:GlassIcon(cbox or opt, "", "check", cbox and 12 or 16)
                        tick.AnchorPoint = cbox and Vector2.new(0.5, 0.5) or Vector2.new(1, 0.5)
                        tick.Position = cbox and UDim2.new(0.5, 0, 0.5, 0) or UDim2.new(1, 0, 0.5, 0)
                        tick.ZIndex = 54
                        tick.Visible = selected
                        if type(Library.PaintGlassIcon) == "function" then Library:PaintGlassIcon(tick, "active", true) end
                    else
                        tick = new("Frame", {
                            BackgroundColor3 = Colors.text or Colors.Ink,
                            BackgroundTransparency = selected and 0 or 1,
                            BorderSizePixel = 0,
                            Size = UDim2.fromOffset(2, 12),
                            AnchorPoint = Vector2.new(1, 0.5),
                            Position = UDim2.new(1, 0, 0.5, 0),
                            Parent = opt,
                            ZIndex = 53,
                        })
                    end

                    -- the value's picture at the left (the game's own icon) or, with only a
                    -- colour, a small dot of it; its note at the right before the check
                    local x0, subW = 0, 0
                    local pic, subLbl
                    if icon then
                        pic = new("ImageLabel", {
                            Name = "Pic",
                            BackgroundTransparency = 1,
                            Image = tostring(icon),
                            ScaleType = Enum.ScaleType.Fit,
                            AnchorPoint = Vector2.new(0, 0.5),
                            Position = UDim2.new(0, 0, 0.5, 0),
                            Size = UDim2.fromOffset(22, 22),
                            Parent = opt,
                            ZIndex = 53,
                        })
                        x0 = 28
                    elseif typeof(col) == "Color3" then
                        local dot = new("Frame", {
                            Name = "Dot",
                            BackgroundColor3 = col,
                            BorderSizePixel = 0,
                            AnchorPoint = Vector2.new(0, 0.5),
                            Position = UDim2.new(0, 2, 0.5, 0),
                            Size = UDim2.fromOffset(8, 8),
                            Parent = opt,
                            ZIndex = 53,
                        })
                        corner(4, dot)
                        x0 = 16
                    end
                    if sub and sub ~= "" then
                        subW = 118
                        subLbl = new("TextLabel", {
                            Name = "Sub",
                            BackgroundTransparency = 1,
                            AnchorPoint = Vector2.new(1, 0.5),
                            Position = UDim2.new(1, -24, 0.5, 0),
                            Size = UDim2.new(0, subW - 4, 1, 0),
                            Text = tostring(sub),
                            TextColor3 = Colors.muted or Colors.Smoke,
                            FontFace = Fonts.Sans,
                            TextSize = 11,
                            TextXAlignment = Enum.TextXAlignment.Right,
                            TextTruncate = Enum.TextTruncate.AtEnd,
                            Parent = opt,
                            ZIndex = 52,
                        })
                    end
                    local lbl = new("TextLabel", {
                        BackgroundTransparency = 1,
                        Position = UDim2.new(0, x0, 0, 0),
                        Size = UDim2.new(1, -22 - x0 - subW, 1, 0),
                        RichText = tag ~= nil,
                        Text = tag and (label .. ' <font color="#' .. (Colors.muted or Colors.Smoke):ToHex() .. '">' .. tostring(tag) .. "</font>") or label,
                        TextColor3 = tcol or (selected and (Colors.text or Colors.Ink) or TEXT_MID),
                        FontFace = selected and (Fonts.SansMed or Fonts.Sans) or Fonts.Sans,
                        TextSize = 13,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                        Parent = opt,
                        ZIndex = 52,
                    })
                    -- a coloured row that is not picked sits a little back (so the ticked ones read)
                    if col and not selected then lbl.TextTransparency = 0.25 end
                    -- the first 12 rows of a fresh list arrive one after another (22 ms apart)
                    built += 1
                    if self._stagger and built <= 12 then
                        local restT = lbl.TextTransparency
                        lbl.TextTransparency = 1
                        if pic then pic.ImageTransparency = 1 end
                        if subLbl then subLbl.TextTransparency = 1 end
                        task.delay(0.03 + (built - 1) * 0.022, function()
                            if not lbl.Parent then return end
                            tween(lbl, 0.16, nil, { TextTransparency = restT })
                            if pic then tween(pic, 0.16, nil, { ImageTransparency = 0 }) end
                            if subLbl then tween(subLbl, 0.16, nil, { TextTransparency = 0 }) end
                        end)
                    end

                    local function pick()
                        self:_select(v)
                        if tick.Parent then
                            local on = self:_isSelected(v)
                            if cbox then
                                tween(cbox, 0.12, nil, { BackgroundTransparency = on and 0 or 1 })
                                local cs = cbox:FindFirstChildOfClass("UIStroke")
                                if cs then Edge.set(cs, "Color", on and (Colors.metalLo or Colors.Brushed) or Colors.WellEdge, 0.12) end
                            end
                            if tick.Name == "IconTile" then
                                tick.Visible = on
                                -- the check pops in (a tick that just appears reads as a redraw)
                                if on and rawget(Library, "LowEffects") ~= true then
                                    local ts = tick:FindFirstChild("Pop") or new("UIScale", { Name = "Pop", Scale = 1, Parent = tick })
                                    ts.Scale = 0.55
                                    tween(ts, 0.24, Enum.EasingStyle.Back, { Scale = 1 })
                                end
                            else
                                tick.BackgroundTransparency = on and 0 or 1
                            end
                            lbl.TextColor3 = tcol or (on and (Colors.text or Colors.Ink) or TEXT_MID)
                            lbl.TextTransparency = (col and not on) and 0.25 or 0
                            lbl.FontFace = on and (Fonts.SansMed or Fonts.Sans) or Fonts.Sans
                        end
                    end
                    local item = { Button = opt, Pick = pick }
                    table.insert(navItems, item)
                    opt.MouseEnter:Connect(function() setCursor(item) end)
                    opt.MouseLeave:Connect(function() if cursorItem == item then setCursor(nil) end end)
                    opt.MouseButton1Click:Connect(pick)
                end
            end
            if built == 0 then
                -- nothing to list: one muted row says so (owner 2026-11-01: the empty Saved
                -- configs list opened as a black bar)
                local emptyLbl = new("TextLabel", {
                    Name = "Empty",
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, ITEM_H),
                    Text = (query ~= "" and "No matches") or self.EmptyText or "Nothing here yet",
                    TextColor3 = Colors.muted or Colors.Smoke,
                    FontFace = Fonts.Sans,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = scroll,
                    ZIndex = 52,
                })
                padding(emptyLbl, 10, 8, 0, 0)
            end
        end
        -- a multi list: "All" and "None" at the left, "n of N" at the right (owner 2026-10-31
        -- night, the Never sell list has every pet of the game: ticking 148 rows one by one is
        -- not a control)
        if self.Multi then
            local quick = new("Frame", {
                Name = "Quick",
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 22),
                Position = UDim2.new(0, 0, 0, filter and 32 or 0),
                Parent = menu,
                ZIndex = 51,
            })
            local function setAll(on)
                local old = snapshot(self.Value)
                local nv = {}
                if on then
                    for _, v in ipairs(self.Values) do nv[v] = true end
                end
                self.Value = nv
                self:_refresh()
                buildItems(filter and filter.Text or "")
                task.spawn(self._callback, self.Value)
                self.Changed:Fire(self.Value)
                if Library.OnOptionChanged then Library.OnOptionChanged(self) end
                if type(rawget(Library, "_pushHistory")) == "function" then Library._pushHistory(self, old, snapshot(self.Value)) end
            end
            -- (critique 2026-10-31 night: bare 11 px words read as stray text) the quick actions
            -- are small hairline chips in a row; the tag filter chip ("Owned") stays lit while on
            local chips = new("Frame", {
                Name = "Chips",
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 2, 0, 0),
                Size = UDim2.new(1, -100, 1, 0),
                Parent = quick,
                ZIndex = 52,
            })
            listLayout(chips, Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
            local function chip(txt, w, lit, onClick)
                local restCol = Colors.glyph or Colors.muted or Colors.Smoke
                local b = new("TextButton", {
                    BackgroundColor3 = Colors.wellHover or Colors.WellHover,
                    BackgroundTransparency = lit() and 0 or 1,
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Size = UDim2.new(0, w, 0, 18),
                    Text = txt,
                    TextSize = 11,
                    FontFace = Fonts.SansMed or Fonts.Sans,
                    TextColor3 = lit() and (Colors.text or Colors.Ink) or restCol,
                    Parent = chips,
                    ZIndex = 52,
                })
                corner(4, b)
                local e = stroke(b, Colors.WellEdge, 1, lit() and 0 or 0.25)
                local function paint(hover)
                    local on = lit()
                    tween(b, 0.1, nil, {
                        BackgroundTransparency = (on or hover) and 0 or 1,
                        TextColor3 = (on or hover) and (Colors.text or Colors.Ink) or restCol,
                    })
                    tween(e, 0.1, nil, { Transparency = (on or hover) and 0 or 0.25 })
                    Edge.set(e, "Color", on and (Colors.metalLo or Colors.Brushed) or Colors.WellEdge, 0.1)
                end
                b.MouseEnter:Connect(function() paint(true) end)
                b.MouseLeave:Connect(function() paint(false) end)
                b.MouseButton1Click:Connect(function() onClick(); paint(false) end)
                return b
            end
            local function never() return false end
            chip("All", 34, never, function() setAll(true) end)
            chip("Clear", 44, never, function() setAll(false) end)
            if type(self.TagFilterText) == "string" and self.TagFilterText ~= "" then
                chip(self.TagFilterText, math.max(40, #self.TagFilterText * 7 + 14), function() return self._tagsOnly == true end, function()
                    self._tagsOnly = not self._tagsOnly
                    buildItems(filter and filter.Text or "")
                end)
            end
            self._countLbl = new("TextLabel", {
                Name = "Count",
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -10, 0, 0),
                Size = UDim2.new(0, 100, 1, 0),
                Text = "",
                TextSize = 11,
                FontFace = Fonts.SansMed or Fonts.Sans,
                TextColor3 = Colors.glyph or Colors.muted or Colors.Smoke,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = quick,
                ZIndex = 52,
            })
            self:_refresh()
        end
        buildItems()
        if filter then
            filter:GetPropertyChangedSignal("Text"):Connect(function() buildItems(filter.Text) end)
        end

        -- open animation: fill fades in; the scale / drop is menuScale above (a second UIScale
        -- here fought it - Roblox applies only one per object)
        menu.BackgroundTransparency = 1
        tween(menu, 0.14, nil, { BackgroundTransparency = 0 })

        self._menu = menu

        -- outside click close
        task.defer(function()
            local conn
            conn = UserInputService.InputBegan:Connect(function(input)
                if not self._open or not self._menu or self._menu ~= menu then conn:Disconnect(); return end
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    local kc = input.KeyCode
                    -- typing in the search box: only the nav keys are ours
                    if kc == Enum.KeyCode.Down then moveCursor(1)
                    elseif kc == Enum.KeyCode.Up then moveCursor(-1)
                    elseif kc == Enum.KeyCode.Return or kc == Enum.KeyCode.KeypadEnter then
                        if cursorItem then cursorItem.Pick() end
                    elseif kc == Enum.KeyCode.Escape then
                        self:Close(); conn:Disconnect()
                    end
                    return
                end
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    -- InputObject.Position is measured below the top inset while AbsolutePosition is
                    -- measured from the screen's top edge (live 2026-10-31 night: a click on the first
                    -- rows read as "outside" and closed the list, and a click on the pill closed and
                    -- reopened it); the inset is added back so both sit in one frame
                    local inset = game:GetService("GuiService"):GetGuiInset()
                    local mx, my = input.Position.X + inset.X, input.Position.Y + inset.Y
                    local mp = self._menu.AbsolutePosition
                    local ms = self._menu.AbsoluteSize
                    local pp = self.Pill.AbsolutePosition
                    local ps = self.Pill.AbsoluteSize
                    local inMenu = mx >= mp.X and mx <= mp.X + ms.X and my >= mp.Y and my <= mp.Y + ms.Y
                    local inPill = mx >= pp.X and mx <= pp.X + ps.X and my >= pp.Y and my <= pp.Y + ps.Y
                    if not inMenu and not inPill then
                        self:Close()
                        conn:Disconnect()
                    end
                end
            end)
        end)
    end

