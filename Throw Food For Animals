			if e.Row.Parent then
				if v then
					e.List.FillDirection = Enum.FillDirection.Vertical
					e.Left.Size  = UDim2.new(1, 0, 0, 0)
					e.Right.Size = UDim2.new(1, 0, 0, 0)
