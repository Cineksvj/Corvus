    SignalGreen    = Color3.fromHex("#D5D8DE"),   -- "live" delta uses the silver accent
    SignalAmber    = Color3.fromHex("#D5D8DE"),   -- current-marker on charts: same accent
    SignalRed      = Color3.fromHex("#F87171"),
