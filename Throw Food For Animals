			self:_refreshNavPill()
		end
		function tab:StopAll()
			local remembered = {}
			Library._batchSuppress = true
			for _, t in ipairs(self.Toggles) do
				if t.Value then
					table.insert(remembered, t)
					pcall(function() t:SetValue(false) end)
				end
			end
			Library._batchSuppress = false
			if #remembered > 0 then self._resume = remembered end
			self:_refreshNavPill()
		end
		function tab:Resume()
			local set = self._resume
			if not set or #set == 0 then
				set = {}
				local userOn = rawget(Library, "_userOn") or {}
				for _, t in ipairs(self.Toggles) do
					if type(t.Idx) == "string" and userOn[t.Idx] then table.insert(set, t) end
				end
			end
			Library._batchSuppress = true
			for _, t in ipairs(set) do pcall(function() t:SetValue(true) end) end
			Library._batchSuppress = false
			self:_refreshNavPill()
		end
