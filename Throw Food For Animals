function N.refreshUI()
	local now = os.clock()
	local call = N.call
	-- the feeds, the food strip, the bag text and the Never sell tags are rebuilt only while the hub
	-- is on screen (owner 2026-11-01: "optimize it"); the island's cash chip and the game-facing
	-- sorts run whatever the window does
	local shown = rawget(Library, "Toggled") ~= false
	local mask = cfg.streamer
	local pf = N.perf
	-- the heavy rebuilds (the catches feed, the food strip, the bag text) take turns, one a pass,
	-- so each runs about once a second and no pass carries all three; the status, the tiles and
	-- the island chip every pass
	heavySlot = heavySlot % 3 + 1
	local doFeed, doFood, doBag = heavySlot == 1, heavySlot == 2, heavySlot == 3
	local level = math.floor(num(D("Level"), 1))
	local xp = num(D("Xp"))
	local cash = money()
	local nextIn = if cfg.farm then math.max(0, st.nextStartAt - now) else 0
	-- (critique 2026-11-01: "next in 0.0 s" at the throw itself) under a tenth it is the throw
	local nextTxt = if nextIn < 0.1 then "throwing now" else string.format("next throw in %.1f s", nextIn)
	local status
	if cfg.farm and cfg.train then
		status = if st.training
			then "Throwing + training, on the bar now, " .. nextTxt
			else "Throwing + training, " .. nextTxt
		if now < st.hybridBlockedUntil then
			status ..= string.format(", training paused by the server for %d s", math.floor(st.hybridBlockedUntil - now))
		end
	elseif cfg.farm then
		status = if nextIn < 0.1 then "Throwing now" else string.format("Throwing, next in %.1f s", nextIn)
	elseif cfg.train then
		status = if st.training then "Training" else "Waiting for the bar"
	else
		status = ""   -- idle: nothing (owner 2026-10-31 night: no filler text)
	end
	if st.lastErr ~= "" and not ROUTINE[st.lastErr] and now - num(st.lastErrAt) < 20 then
		status = (if status == "" then "" else status .. "\n") .. "Last problem: " .. st.lastErr
	end
	Labels.Status:SetText(status)
	Stats.Level:SetValue(string.format("%d", level))
	Stats.Money:SetValue(if mask then N.MASK else fmtMoney(cash))
	Stats.Throws:SetValue(string.format("%d", st.throws))
	Stats.Cycle:SetValue(if st.cycleAvg > 0 then string.format("%.1f s", st.cycleAvg) else "idle")

	-- the minimised island: cash, and the income of the last minute when it is positive
	table.insert(cashLog, { now, cash })
	while #cashLog > 0 and now - cashLog[1][1] > 60 do
		table.remove(cashLog, 1)
	end
	local delta = ""
	if #cashLog >= 2 and now - cashLog[1][1] >= 5 then
		local rate = (cash - cashLog[1][2]) / (now - cashLog[1][1]) * 60
		if rate > 0 then
			delta = "+" .. fmtMoney(rate) .. "/min"
		end
	end
	if type(Library.SetIslandStats) == "function" then
		Library:SetIslandStats({ value = if mask then N.MASK else fmtMoney(cash), delta = if mask then "" else delta })
	end

	local need = num(LevelConfig and call(LevelConfig.XpForLevel, level))
	local maxLevel = math.floor(num(LevelConfig and LevelConfig.MaxLevel))
	local standIndex = math.floor(num(D("Stand")))
	local stand = StandsConfig and call(StandsConfig.Get, math.max(standIndex, 1))
	local perRep = num(stand and stand.XpPerRep) * num(LocalPlayer:GetAttribute("XpMultiplier"), 1)
	local reps = if perRep > 0 then math.ceil(math.max(0, need - xp) / perRep) else -1
	-- one line (owner 2026-10-31 night: no level/xp recap, the Level tile has it)
	-- (owner 2026-11-01: no "Level 1592, the game's cap" under Train, the Level tile has it) at
	-- the cap the line says only what the bar is doing, or nothing
	local trainParts = {}
	if not (maxLevel > 0 and level >= maxLevel) then
		table.insert(trainParts, string.format("%s, %d reps to level %d", if stand then tostring(stand.Name) else "No bar", math.max(0, math.floor(reps)), level + 1))
	end
	if st.training then
		table.insert(trainParts, "On the bar now")
	elseif now < st.hybridBlockedUntil then
		table.insert(trainParts, "Training paused by the server")
	end
	Labels.Train:SetText(table.concat(trainParts, ", "))

	local nextStand = StandsConfig and call(StandsConfig.Get, standIndex + 1)
	local fenceLevel = math.floor(num(D("FenceLevel")))
	local nextFence = FenceConfig and call(FenceConfig.Get, fenceLevel + 1)
	local food = FoodsConfig and call(FoodsConfig.GetAny, num(D("EquippedFood"), 1))
	local _, buy = N.bestFoods(cash)
	-- (critique 2026-10-31 night: no dangling "-" placeholders; the next-buy clause is there only
	-- when there is a buy)
	Labels.Plot:SetText(string.format(
		"Bar %d -> %s, fence %d -> %s",
		standIndex,
		if nextStand then tostring(nextStand.Name) .. " " .. fmtMoney(num(nextStand.Price)) else "MAX",
		fenceLevel,
		if nextFence then fmtMoney(num(nextFence.Price)) else "MAX"
	))
	if Labels.Luck and N.serverLuck then
		local luck, left = N.serverLuck()
		if luck > 1 then
			local short = cfg.luckHop and (luck < cfg.luckMin or left < 60)
			Labels.Luck:SetText(string.format("This server has x%d luck, %d min left%s", luck, math.floor(left / 60), if short then ", below the minimum, hopping" else ""))
		else
			Labels.Luck:SetText(if cfg.luckHop then "No server luck here, hopping" else "No server luck on this server")
		end
	end
	if Labels.Food then
		Labels.Food:SetText(string.format(
			"%s, bait %d%s",
			if food then tostring(food.Name) else "No food",
			math.floor(num(food and food.Bait)),
			if buy then ", next buy " .. tostring(buy.Name) .. " " .. fmtMoney(num(buy.Price)) else ""
		))
	end
	-- the last catches feed: the mutated picture tinted the mutation's way, the name in the rarity
	-- colour, then mutation / size title / weight / luck, and the income at the right
	local tSec = os.clock()
	if shown and doFeed and Feeds and Feeds.Catches and (N.Catches[1] ~= lastFeedTop or now - lastFeedAt > 2) then
		lastFeedAt, lastFeedTop = now, N.Catches[1]
		local rows = {}
		for _, c in ipairs(N.Catches) do
			local p = N.Pets[c.model]
			local mutated = c.mutation ~= "Normal"
			local parts = {}
			if mutated then
				local mc = N.MutationColor[c.mutation]
				table.insert(parts, if mc then string.format('<font color="#%s">%s</font>', mc:ToHex(), c.mutation) else c.mutation)
			end
			local title = N.sizeTitle(c.size)
			if title then
				table.insert(parts, if title.color then string.format('<font color="#%s">%s</font>', title.color:ToHex(), title.name) else title.name)
			end
			table.insert(parts, N.fmtKg(c.kg))
			if c.size > 1.01 then
				local luck = N.luckText(c.size)
				if luck then
					table.insert(parts, luck)
				end
			end
			local tint = if mutated then N.MutationTints[c.mutation] else nil
			table.insert(rows, {
				key = c.id,
				icon = if p then (if mutated then p.mutIcon else p.icon) else nil,
				iconColor = if typeof(tint) == "Color3" then tint else nil,
				name = if p then p.name else c.model,
				nameColor = if p then N.rarityColor(p.rarity) else nil,
				sub = table.concat(parts, ", "),
				value = N.fmtIncome(c.income),
				time = N.fmtAgo(now - c.at),
			})
		end
		Feeds.Catches:Set(rows)
	end
	if pf then pf.feed += os.clock() - tSec end
	-- the bag order follows the game's inventory while it is open, the hotbar always
	tSec = os.clock()
	N.applyBagSort(false)
	N.applyHotbarSort(false)
	if pf then pf.sort += os.clock() - tSec end
	tSec = os.clock()
	if shown and doFood and Catalogs and Catalogs.Foods then
		-- rebuilt only when something on the strip can differ: the equipped food, the best buy, how
		-- many foods are in reach, the owned set, the level (locks) and the cash as it is shown
		local reach, owned = 0, 0
		if FoodsConfig and type(FoodsConfig.All) == "table" then
			for _, item in ipairs(FoodsConfig.All) do
				if num(item.Price) <= cash then
					reach += 1
				end
			end
		end
		local ownedT = DP("OwnedFoods")
		if type(ownedT) == "table" then
			for _ in pairs(ownedT) do
				owned += 1
			end
		end
		local sig = string.format("%d|%s|%d|%d|%d|%s", math.floor(num(D("EquippedFood"), 1)), tostring(buy and buy.Index), reach, owned, level, fmtMoney(cash))
		if sig ~= lastFoodSig then
			lastFoodSig = sig
			local cards, equippedPos = foodCards(cash, buy)
			Catalogs.Foods:Set(cards)
			-- the strip scrolls to the equipped food when it changes (critique 2026-11-01)
			if equippedPos and equippedPos ~= lastEquippedPos then
				lastEquippedPos = equippedPos
				if type(Catalogs.Foods.ShowCard) == "function" then
					pcall(Catalogs.Foods.ShowCard, Catalogs.Foods, equippedPos)
				end
			end
		end
	end
	if pf then pf.food += os.clock() - tSec end
	tSec = os.clock()
	if shown and doBag and Labels.Bag and (N.Catches[1] ~= lastBagTop or now - lastBagAt > 2) then
		lastBagAt, lastBagTop = now, N.Catches[1]
		Labels.Bag:SetText(N.bagSummary())
	end
	if pf then pf.bag += os.clock() - tSec end
	-- the Never sell tags follow the bag ("x185" after a pet you have); checked every 3 s, the
	-- open list keeps its rows until it opens again
	local never = Options.NeverSell
	if shown and never and type(never.SetMeta) == "function" and now - lastSubAt > 3 then
		lastSubAt = now
		local tags, key = N.petTags()
		if key ~= lastPetNames then
			lastPetNames = key
			never:SetMeta({ tags = tags })
		end
	end

	Stats.Supers:SetValue(string.format("%d", st.supers))
	Stats.SuperHits:SetValue(string.format("%d", st.superHits))
	Stats.Saved:SetValue(string.format("%d", math.floor(st.saved)))
	Stats.Sold:SetValue(string.format("%d", math.floor(st.sold)))
	Stats.Upgrades:SetValue(string.format("%d", st.upgrades))
	Stats.Sessions:SetValue(string.format("%d", st.sessions))
	Stats.Taps:SetValue(string.format("%d", st.taps))
	local life = D("Stats")
	if type(life) == "table" then
		Stats.TotalCaught:SetValue(string.format("%d", math.floor(num(life.TotalCaught))))
		local luck = num(life.LuckiestCatch)
		Stats.Luckiest:SetValue(if luck > 1 then "1 in " .. (fmtMoney(luck):gsub("^%$", "")) else "-")
		Stats.TotalEarned:SetValue(if mask then N.MASK else fmtMoney(num(life.TotalEarned)))
		local pt = math.floor(num(life.PlayTime))
		Stats.PlayTime:SetValue(if pt >= 3600 then string.format("%dh %02dm", math.floor(pt / 3600), math.floor(pt % 3600 / 60)) else string.format("%dm", math.floor(pt / 60)))
	end
	Labels.Problems:SetText(if Log.problemCount > 0 then string.format("%d problems logged, last: %s", Log.problemCount, Log.lastProblem) else "")
end

-- PERF (owner 2026-11-01, "optimize it"): what the hub's own Luau costs - avg / max ms of a UI
-- refresh and of a brain tick, one log line a minute. The GUI itself measured within noise of the
-- game's frame (hub open 21.0 / 28.0 ms avg / p95, the whole ScreenGui off 23.6 / 36.8), so the
-- savings are on this side: the throttled refresh and the skipped rebuilds above.
-- A brain tick that yields (a walk, a wait for the cooldown) is wall time, not cost: ticks under
-- 20 ms are the CPU figure, the rest are counted as yielded.
local perf = { ui = 0, uiN = 0, uiMax = 0, feed = 0, food = 0, bag = 0, sort = 0, brain = 0, brainN = 0, brainMax = 0, brainLong = 0, at = os.clock() }
N.perf = perf
local function perfReport(now)
	if now - perf.at < 60 then
		return
	end
	perf.at = now
	if perf.uiN > 0 or perf.brainN > 0 or perf.brainLong > 0 then
		local n = math.max(perf.uiN, 1)
		log("PERF", string.format(
			"ui avg %.2f max %.2f ms (%d passes: feed %.2f, food %.2f, bag %.2f, sort %.2f), brain quick avg %.3f max %.2f ms (%d), %d ticks yielded",
			perf.ui / n * 1000, perf.uiMax * 1000, perf.uiN,
			perf.feed / n * 1000, perf.food / n * 1000, perf.bag / n * 1000, perf.sort / n * 1000,
			if perf.brainN > 0 then perf.brain / perf.brainN * 1000 else 0, perf.brainMax * 1000, perf.brainN, perf.brainLong
		))
	end
	perf.ui, perf.uiN, perf.uiMax, perf.feed, perf.food, perf.bag, perf.sort = 0, 0, 0, 0, 0, 0, 0
	perf.brain, perf.brainN, perf.brainMax, perf.brainLong = 0, 0, 0, 0
end
-- The brain: one tick every 30 ms while something is on (p02 decides what to do). An error lands in the log, never stops the loop.
task.spawn(function()
	while alive() do
		if cfg.farm or cfg.train then
			local t0 = os.clock()
			local ok, err = pcall(N.brain)
			local dt = os.clock() - t0
			if dt < 0.02 then
				perf.brain += dt
				perf.brainN += 1
				if dt > perf.brainMax then perf.brainMax = dt end
			else
				perf.brainLong += 1
			end
			if not ok then
				local msg = "brain:" .. tostring(err)
				if msg ~= st.lastErr then
					logProblem(msg)
				end
				st.lastErr = msg
			end
		end
		task.wait(0.03)
	end
end)
-- Lucky server (owner 2026-11-01): workspace carries ServerLuck (1 = none, else x2..x16) and
-- ServerLuckEnd (a server timestamp). With Lucky hop on, the hub hops to a random public server
-- through the library (the same queued rejoin as the Info tab's Server hop) until the luck here is
-- at least Min luck with a minute left; then it stays, and hunts again once the luck has run out.
-- 30 s of settling after a join, 40 s between hops.
do
	local joinedAt = os.clock()
	local lastHopAt = 0
	function N.serverLuck()
		local luck = num(workspace:GetAttribute("ServerLuck"), 1)
		local endsAt = num(workspace:GetAttribute("ServerLuckEnd"), 0)
		local left = if endsAt > 0 then endsAt - workspace:GetServerTimeNow() else 0
		if luck > 1 and left > 0 then
			return luck, left
		end
		return 1, 0
	end
	task.spawn(function()
		local staying = false
		while alive() do
			task.wait(1)
			if not cfg.luckHop then
				staying = false
				continue
			end
			local luck, left = N.serverLuck()
			if luck >= cfg.luckMin and left >= 60 then
				if not staying then
					staying = true
					log("LUCK", string.format("server x%d, %d min left, staying", luck, math.floor(left / 60)))
					notify("Lucky server", string.format("x%d luck for %d more minutes. Staying here", luck, math.floor(left / 60)), 5)
				end
			else
				staying = false
				local now = os.clock()
				if now - joinedAt >= 30 and now - lastHopAt >= 40 then
					lastHopAt = now
					log("LUCK", string.format("this server x%d (%d s left), below x%d, hopping", luck, math.floor(left), cfg.luckMin))
					local hop = rawget(Library, "HopServer")
					if type(hop) == "function" then
						pcall(hop, Library, "random")
					else
						logProblem("Lucky hop: this library has no HopServer")
					end
				end
			end
		end
	end)
end
-- Level up -> max power (the game raises the cap per level; the player's power value does not follow by itself).
pcall(function()
	DataController:Observe("Level", function()
		if alive() and cfg.maxPower and (cfg.farm or cfg.train) then
			task.defer(N.setMaxPower)
		end
	end)
end)
task.spawn(function()
	local errAt = 0
	while alive() do
		N.fixIdentity()
		local t0 = os.clock()
		local ok, err = pcall(N.refreshUI)
		local dt = os.clock() - t0
		perf.ui += dt
		perf.uiN += 1
		if dt > perf.uiMax then perf.uiMax = dt end
		if not ok and os.clock() - errAt > 10 then
			errAt = os.clock()
			log("UI refresh error", err)
		end
		flushLog(false)
		perfReport(os.clock())
		-- a hidden hub (island or closed) refreshes once a second; the island's cash chip is fed
		-- from the same pass
		task.wait(if rawget(Library, "Toggled") == false then 1 else 0.3)
	end
	flushLog(true)
end)
log("READY", "Insert toggles the menu, nothing is on")
notify("Corvus", "Throw Food For Animals hub loaded. Insert toggles the menu, nothing is on", 5)
end, debug.traceback)
Boot.CorvusBooting = nil
if not BootOk then
	local report = "[Corvus TFF] Throw Food For Animals failed to start:\n" .. tostring(BootError)
	warn(report)
	Boot.CorvusLastError = report
	local copied = pcall(setclipboard, report)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "Corvus error",
			Text = if copied
				then "Hub failed to start. The error is copied, paste it to Cinek."
				else "Hub failed to start. Press F9 and send the red [Corvus] line.",
			Duration = 20,
		})
	end)
end
