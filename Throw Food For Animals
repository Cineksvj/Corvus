        Name = "LiveDot",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(0, 7, 0, 7),
        BackgroundColor3 = Palette.DiscordWhisper,
        BorderSizePixel = 0,
        ZIndex = 4,
        Parent = bar,
    })
    corner(4).Parent = dot
