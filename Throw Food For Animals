-- metal: white -> cool silver gradient for the hero numeral; still mostly flat.
local MetalSequence = ColorSequence.new({
    ColorSequenceKeypoint.new(0.00, Color3.fromHex("#FFFFFF")),
    ColorSequenceKeypoint.new(1.00, Color3.fromHex("#C9CDD4")),
})

local function themeMetal()
    local T = rawget(_G, "CorvusLibrary") or rawget(_G, "Library")
    if T and T.Theme and T.Theme.Metal then
        return T.Theme.Metal
    end
    return MetalSequence
end

local function themeColor(name, fallback)
    local T = rawget(_G, "CorvusLibrary") or rawget(_G, "Library")
    if T and T.Theme and T.Theme[name] then
        return T.Theme[name]
    end
    return fallback
end

-- ------------------------------------------------------------
-- Font helpers (Michroma for display, BuilderSans for UI, RobotoMono for digits)
-- Pre-build Font instances once; falling back to Enum fonts if missing.
-- ------------------------------------------------------------
local function safeFont(assetId, weight, style)
    local ok, result = pcall(function()
        return Font.new(assetId, weight or Enum.FontWeight.Regular, style or Enum.FontStyle.Normal)
    end)
    if ok and result then return result end
    return Font.fromEnum(Enum.Font.Gotham)
end

