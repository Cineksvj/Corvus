			end
		end))
		main:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() pcall(window._updateNarrow, window) end)
		window.ResizeGrip = grip
	end
	task.defer(function()
		if type(Library.GetSetting) == "function" then
