        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 40),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = layoutOrder,
        Parent = parent,
    })
    local borderStroke
    if instrument then
        -- owner 2026-10-31 evening: 10 px card with the lit-edge skin (CardSkin), no hairline box
        if type(Library.CardSkin) == "function" then
            Library.CardSkin(root, 10)
            borderStroke = root:FindFirstChildOfClass("UIStroke")
        else
            corner(10, root)
            borderStroke = stroke(root, Colors.hairline or Colors.BorderSoft, 1, 0)
        end
        -- Farm 2026-10-20: no corner registration marks (Bench "instrument" tell).
    end

    local HEAD_H = instrument and 40 or 30
    local header = new("Frame", {
        Name = "Header",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, HEAD_H),
        Parent = root,
    })
    padding(header, instrument and 14 or 0, instrument and 12 or 0, instrument and 4 or 6, instrument and 4 or 0)

    -- the group's icon on a small plate before the title (owner 2026-10-31 evening: the bare
    -- title over a hairline was "dry"); hubs pass a Lucide name, a game picture works too
    local titleX = 0
    local iconName = props.Icon
    if instrument and type(iconName) == "string" and iconName ~= "" and type(Library.GlassIcon) == "function" then
        -- owner 2026-10-31 night ("subtaby bardziej jak ikony"): the same 28 px tile the stat
        -- tiles and the sidebar wear, so a game picture on it reads as the game's own icon
        local plate = Library:IconPlate(header, iconName, 28, 16, 2)
        plate.AnchorPoint = Vector2.new(0, 0.5)
        plate.Position = UDim2.new(0, 0, 0.5, 0)
        titleX = 38
    end

    -- Oswald title (condensed, medium): 16 on a card, 14 on a strip. Sentence case.
    local headerLabel = text({
        Name = "Title",
        Text = name,
        TextSize = instrument and 16 or 14,
        FontFace = Fonts.OswaldMed or Fonts.Display or Fonts.SansMed or Fonts.Sans,
        TextColor3 = instrument and (Colors.text or Colors.Ink) or (Colors.textMid or Colors.Ink),
        TextYAlignment = Enum.TextYAlignment.Center,
        AutomaticSize = Enum.AutomaticSize.X,
        Position = UDim2.new(0, titleX, 0, 0),
        Size = UDim2.new(0, 0, 1, 0),
        ZIndex = 2,
        Parent = header,
    })
    headerLabel.RichText = true

    -- strip: the title sits ON the rule (a 1 px line from the title to the chevron)
    local rule = new("Frame", {
        Name = "Rule",
        BackgroundColor3 = Colors.hairlineStrong or Colors.Outline,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(0, 0, 0, 1),
        Visible = not instrument,
        Parent = header,
    })

    -- Farm 2026-10-20: no "X of Y on" counter boxed in the header.
    local counter, paintCounter = nil, nil

    -- the collapse arrow: a 14 px glyph in a 20 px button; on touch the button (invisible) is 36 px
    local CHEV = T(20, 36)
    if counter then counter.Position = UDim2.new(1, -(CHEV + 6), 0.5, 0) end
    local chevron = new("TextButton", {
        Name = "Chevron",
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(CHEV, CHEV),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 2, 0.5, 0),
        Text = "",
        FontFace = Fonts.Sans,
        AutoButtonColor = false,
        Parent = header,
    })
    local chevronIcon = makeChevron(chevron, 14, Colors.smoke or Colors.Smoke)
    chevronIcon.Position = UDim2.new(0.5, 0, 0.5, 0)
    -- critique 2026-11-01 (round 11): eleven chevrons across four tabs and nothing to fold; the
    -- arrow shows only on a card built with Collapsible = true (Groupbox:Toggle stays an API)
    chevron.Visible = props.Collapsible == true

    local function layoutHeader()
        local k = Library.UIScale or 1
        if k <= 0 then k = 1 end
        local tw = headerLabel.AbsoluteSize.X / k
        local rightW = (chevron.Visible and (CHEV + 6) or 0) + ((counter and counter.Visible) and (counter.AbsoluteSize.X / k + 8) or 0)
        rule.Position = UDim2.new(0, titleX + tw + 10, 0.5, 0)
        rule.Size = UDim2.new(1, -(titleX + tw + 10 + rightW), 0, 1)
    end
    headerLabel:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutHeader)
    if counter then counter:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutHeader) end
    task.defer(layoutHeader)

    -- (owner 2026-10-31 evening: no hairline under the header; the title row and 4 px of air do it)
    local dividerWrap = new("Frame", {
        Name = "DividerWrap",
        BackgroundColor3 = Colors.hairline or Colors.BorderSoft,
        BorderSizePixel = 0,
        Size = UDim2.new(1, -30, 0, 1),
        Position = UDim2.new(0, 16, 0, HEAD_H),
        Visible = false,
        Parent = root,
    })

    local BODY_TOP = HEAD_H
    local body = new("Frame", {
        Name = "Body",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.new(0, 0, 0, BODY_TOP),
        Parent = root,
    })
    if instrument then padding(body, 14, 12, 4, 14) else padding(body, 0, 0, 8, 14) end
    local layout = listLayout(body, Enum.FillDirection.Vertical, 2)

    local self = setmetatable({
        Type = "Groupbox",
        Name = name,
        Root = root,
        Header = header,
        Body = body,
        Layout = layout,
        Open = true,
        _controls = {},
        _savedHeight = nil,
    }, Groupbox)

    -- Height comes from AutomaticSize alone (root -> Body -> rows). No manual Size writes:
    -- a Size write per content change made AutomaticSize re-run for the whole column.
    self._bodyTop = BODY_TOP
    self.Instrument = instrument
    self._counter = counter
    self._paintCounter = paintCounter
    self._layoutHeader = layoutHeader

    chevron.MouseButton1Click:Connect(function()
        self:Toggle()
    end)

    -- hover: the lit edge brightens in 90 ms, linear, no glow (the stroke colour multiplies the
    -- CardSkin gradient, so "brighter" = towards white and "rest" = the skin's own colour)
    if borderStroke then
        local rest = borderStroke.Color
        connectHover(root,
            function() tween(borderStroke, 0.09, Enum.EasingStyle.Linear, { Color = Color3.new(1, 1, 1) }) end,
            function() tween(borderStroke, 0.09, Enum.EasingStyle.Linear, { Color = rest }) end
        )
    end

    return self
end

-- "2 of 7 on": the group's toggle count, boxed in the header (hidden under two toggles)
function Groupbox:_refreshCounter()
    local c = self._counter
    if not c then return end
    local total, on = 0, 0
    for _, ctrl in ipairs(self._controls) do
        if type(ctrl) == "table" and ctrl.Type == "Toggle" then
            total += 1
            if ctrl.Value then on += 1 end
        end
    end
    if total < 2 then
        c.Visible = false
    else
        c.Text = string.format("%d of %d on", on, total)
        c.Visible = true
        if self._paintCounter then self._paintCounter(on > 0 and "live" or nil) end
    end
    if self._layoutHeader then self._layoutHeader() end
end

function Groupbox:Toggle()
    self.Open = not self.Open
    -- the tick-arrow holder (named Chevron inside the Chevron button) turns, not a glyph
    local chev = self.Header:FindFirstChild("Chevron") and self.Header.Chevron:FindFirstChild("Chevron")
    if self.Open then
        self.Body.Visible = true
        if chev then tween(chev, 0.14, nil, { Rotation = 0 }) end
    else
        self.Body.Visible = false
        if chev then tween(chev, 0.14, nil, { Rotation = -90 }) end
    end
end

function Groupbox:AddDivider()
    -- owner 2026-10-31 night ("lepsze dividery, bardziej naswietlone"): the sidebar groove - a
    -- 1 px line lit steel at the centre that dies out towards both ends, a soot line right
    -- under it, 14 px of air around; it reads as a cut in the card, not as a drawn rule
    local wrap = new("Frame", {
        Name = "DividerRow",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 14),
        LayoutOrder = self:_next(),
        Parent = self.Body,
    })
    -- (owner 2026-11-01: the shared groove - it repaints in the theme's metal)
    Library:GrooveLine(wrap, { Name = "Line", Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 0, 6) })
    return wrap
end

function Groupbox:_next()
    self._order = (self._order or 0) + 1
    return self._order
end

-- ============================================================================
