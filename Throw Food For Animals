	local _ = constellationHolder

	-- -------------------- Command palette (search pill / Ctrl+K)  [B4 keyboard-first]
	-- Searches registered commands, every toggle by its label, tabs and options.
	-- Arrow keys move the selection, Enter runs it, Escape closes. Empty query shows the
	-- recent commands. "fast speed 180" sets a slider/input inline; "goto <control>" jumps
	-- to a control and pulses it.
	do
		local palette, input, listHolder, results, hintLabel
		local selected = 1
		local rowFrames = {}
		rawset(Library, "_recentCmds", rawget(Library, "_recentCmds") or {})
		local function closePalette()
			if palette then palette.Visible = false end
		end
		local function remember(label)
			local rc = Library._recentCmds
			for i = #rc, 1, -1 do if rc[i] == label then table.remove(rc, i) end end
			table.insert(rc, 1, label)
			while #rc > 5 do table.remove(rc) end
		end
		local function controlTab(ctrl)
			if type(ctrl) == "table" and type(ctrl.Tab) == "table" then return ctrl.Tab end
			local row = type(ctrl) == "table" and (ctrl.Row or ctrl.Instance)
			if typeof(row) ~= "Instance" then return nil end
			local p = row
			while p and p ~= screenGui do
				local nm = tostring(p.Name)
				if nm:sub(1, 8) == "TabPage_" then
					return window.Tabs[nm:sub(9)]
				end
				p = p.Parent
			end
			return nil
		end
		-- jump to a control: its tab, scrolled into view, with a glow pulse
		local function gotoControl(ctrl)
			local tab = controlTab(ctrl)
			local row = type(ctrl) == "table" and (ctrl.Row or ctrl.Instance)
			if tab then window:SelectTab(tab, true) end
			task.delay(0.05, function()
				if typeof(row) ~= "Instance" or not row.Parent then return end
				local scroll = tab and tab.Scroll
				if scroll then
					local k = mainScale.Scale > 0 and mainScale.Scale or 1
					local dy = (row.AbsolutePosition.Y - scroll.AbsolutePosition.Y) / k + scroll.CanvasPosition.Y - 60
					scroll.CanvasPosition = Vector2.new(0, math.max(0, dy))
				end
				if row.Parent and type(Library.Glow) == "function" then
					local holder = Library:Glow(row, { Radius = 6, Strength = 1 })
					if holder then
						task.delay(0.9, function()
							Library:SetGlow(holder, 0, 0.5)
							task.delay(0.6, function() pcall(function() holder:Destroy() end) end)
						end)
					end
				end
			end)
		end
		local function collect(q)
			q = string.lower(q or "")
			local out = {}
			local function add(kind, label, hint, fn, score)
				table.insert(out, { kind = kind, label = label, hint = hint, fn = fn, score = score or 0 })
			end
			local function matches(label) return q == "" or string.find(string.lower(label), q, 1, true) ~= nil end
			local togs = rawget(Library, "Toggles")
			local opts = rawget(Library, "Options")
			-- "goto <name>": controls only
			local gotoQ = q:match("^goto%s+(.*)$") or q:match("^go%s+(.*)$")
			if gotoQ then
				for flag, tog in pairs(type(togs) == "table" and togs or {}) do
					if type(tog) == "table" and type(flag) == "string" and tog.Text and string.find(string.lower(tog.Text), gotoQ, 1, true) then
						add("goto", "Go to " .. tostring(tog.Text), "toggle", function() gotoControl(tog) end)
					end
				end
				for flag, opt in pairs(type(opts) == "table" and opts or {}) do
					if type(opt) == "table" and type(flag) == "string" and opt.Text and string.find(string.lower(opt.Text), gotoQ, 1, true) then
						add("goto", "Go to " .. tostring(opt.Text), string.lower(tostring(opt.Type or "option")), function() gotoControl(opt) end)
					end
				end
				return out
			end
			-- "<option> <number>": inline parameter
			local optQ, num = q:match("^(.-)%s+(%-?%d+%.?%d*)$")
			if optQ and optQ ~= "" and tonumber(num) then
				for flag, opt in pairs(type(opts) == "table" and opts or {}) do
					if type(opt) == "table" and type(flag) == "string" and opt.Text and (opt.Type == "Slider" or opt.Type == "Input")
						and string.find(string.lower(opt.Text), optQ, 1, true) then
						local n = tonumber(num)
						add("set", "Set " .. tostring(opt.Text) .. " to " .. tostring(n), opt.Type == "Slider" and ("now " .. tostring(opt.Value)) or "input", function()
							if type(opt.SetValue) == "function" then opt:SetValue(opt.Type == "Slider" and n or tostring(n)) end
							Library:Notify(tostring(opt.Text) .. " = " .. tostring(n), 2)
						end, 2)
					end
				end
				if #out > 0 then return out end
			end
			if q == "" then
				for _, label in ipairs(Library._recentCmds) do
					add("recent", label, "recent", nil, 5)
				end
			end
			for _, t in ipairs(window.TabOrder) do
				local label = "Go to " .. tostring(t.Name)
				if matches(label) then add("tab", label, string.upper(tostring(t.Workflow or "")), function() window:SelectTab(t) end) end
			end
			local cmds = rawget(Library, "Commands")
			if type(cmds) == "table" then
				for name, entry in pairs(cmds) do
					local fn = type(entry) == "table" and entry.Func or entry
					if type(fn) == "function" and matches(tostring(name)) then
						add("cmd", tostring(name), tostring(type(entry) == "table" and entry.Group or "command"), fn)
					end
				end
			end
			if type(togs) == "table" then
				for flag, tog in pairs(togs) do
					if type(tog) == "table" and type(flag) == "string" and tog.Text and tog.Text ~= "" and matches(tostring(tog.Text)) then
						add("toggle", tostring(tog.Text), tog.Value and "ON, turn off" or "OFF, turn on", function()
							if type(tog.SetValue) == "function" then tog:SetValue(not tog.Value) end
						end)
					end
				end
			end
			-- recent labels resolve to the matching entry's function
			for _, r in ipairs(out) do
				if r.kind == "recent" and not r.fn then
					for _, o in ipairs(out) do
						if o.kind ~= "recent" and o.label == r.label then r.fn = o.fn; r.hint = o.hint; break end
					end
					if not r.fn then r.fn = function() end end
				end
			end
			table.sort(out, function(a, b)
				if a.score ~= b.score then return a.score > b.score end
				local pa = string.find(string.lower(a.label), q, 1, true) or 999
				local pb = string.find(string.lower(b.label), q, 1, true) or 999
				if pa ~= pb then return pa < pb end
				return a.label < b.label
			end)
			return out
		end
		local function paintSelection()
