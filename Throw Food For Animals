				M.areas.colors[aname] = area.Color
			end
			M.areas.icons[aname] = imageOf(areaPics[area.Key]) or imageOf(areaPics[aname])
			local list = if type(AnimalsData) == "table" then AnimalsData[area.Key] else nil
			local pattern = if type(area.RarityPattern) == "table" then area.RarityPattern else {}
			for i, a in ipairs(if type(list) == "table" then list else {}) do
				if type(a) == "table" and a.ModelName then
					local pname = tostring(a.Name or a.ModelName)
					if not M.pets.sub[pname] then
						table.insert(N.SellValues.pets, pname)
						M.pets.icons[pname] = imageOf(petPics[a.ModelName])
						M.pets.colors[pname] = M.rarities.colors[tostring(pattern[i])]
						M.pets.sub[pname] = aname
					end
				end
