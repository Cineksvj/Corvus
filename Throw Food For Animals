	-- -------------------- window:AddTab(opts | name, icon [, workflow, order, primary]) -> Tab
	function window:AddTab(opts, iconArg, workflowArg, orderArg, primaryArg)
		if type(opts) == "string" then
			opts = { Name = opts, Icon = iconArg, Workflow = workflowArg, Order = orderArg, Primary = primaryArg }
		end
		opts = opts or {}
		local tabName    = opts.Name or ("Tab " .. (#self.TabOrder + 1))
		local icon       = opts.Icon or ""
		local workflow   = opts.Workflow or "setup"
