	rawset(Library, "TickerHistory", rawget(Library, "TickerHistory") or {})
	function Library:PushTicker(line)
		if type(line) ~= "string" then return end
		local body = line:gsub("^%[%s*[%d%.]+%]%s*", "")
		local tag, rest = body:match("^(%u[%u_]*)%s+(.*)$")
		if not tag or not rest or rest == "" then return end
		rest = rest:gsub("%s+", " ")
		-- the START line is a debug dump ("hub loaded | place N | toggles 3 on of 62 | window 1.2s"):
		-- the ticker shows it as a sentence
		if tag == "START" then
			local on, total = rest:match("toggles (%d+) on of (%d+)")
			if on then rest = string.format("Ready: %s of %s automations on", on, total) end
		end
		if #rest > 110 then rest = rest:sub(1, 108) .. "\226\128\166" end
		if TICKER_TAGS[tag] or tag == "PROBLEM" or tag == "ERROR" then
			local hist = Library.TickerHistory
			hist[#hist + 1] = { t = os.clock(), tag = tag, text = rest, clock = os.date("%H:%M:%S") }
			if #hist > HISTORY_MAX then table.remove(hist, 1) end
			if PULSE_TAGS[tag] then rawset(Library, "IslandPulse", os.clock()) end
			if (tag == "PROBLEM" or tag == "ERROR") and type(rawget(Library, "_pushNotice")) == "function" then
				pcall(Library._pushNotice, Library, rest, "bad")
			end
		end
		if not TICKER_TAGS[tag] then return end
		if rest == tickerLast then return end
		tickerLast = rest
		rawset(Library, "TickerLast", rest)
		rawset(Library, "TickerTag", tag)
		tickerTag.Text = tag
		tickerTime.Text = os.date("%H:%M:%S")
		tickerGen += 1
		do
			local g = tickerGen
			tickerPaint("changed")
			task.delay(2, function() if tickerGen == g then tickerPaint("live") end end)
		end
		titleLabel.Text = rest
		titleLabel.TextTransparency = 0.6
		Library:NewTween(titleLabel, 0.3, { TextTransparency = 0 })
	end
