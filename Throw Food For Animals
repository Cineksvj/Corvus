-- FOOTER - window:AddFooter({online, members, session})
-- =====================================================================
-- Full-width 30px pill. Live green dot animated pulse 2.2s ease-in-out.
-- Text "N online \183 M Discord members \183 N session". Right: Copy
-- Discord link Metal pill button.
-- =====================================================================
local function fmtThousands(n)
    if type(n) ~= "number" then return "\226\128\148" end
    local s = tostring(math.floor(n + 0.5))
    local out = s:reverse():gsub("(%d%d%d)", "%1 "):reverse()
    return (out:gsub("^%s+", ""))
end

function Widgets.AddFooter(window, cfg)
    cfg = cfg or {}
    -- One footer per window: a second call just refreshes the numbers.
    if window and type(window.Footer) == "table" and window.Footer.Instance then
        local f = window.Footer
        if cfg.online  ~= nil then f:SetOnline(cfg.online)   end
        if cfg.members ~= nil then f:SetMembers(cfg.members) end
        if cfg.session ~= nil then f:SetSession(cfg.session) end
        return f
    end
    local parent = (window and (window.FooterSlot or window.Root or window.Content)) or window
    assert(parent, "AddFooter: window has no FooterSlot/Root")
    local L = Lib()

    -- mockup .footer: card skin, radius 16, padding 8px 16px, gap 12
    local bar = new("Frame", {
        Name = "CorvusFooter",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Palette.RavenSlate,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = parent,
    })
    -- core's status bar slot is Flat: no card, the band + its rule are the frame
    -- (no padding: the Discord line is centred and the 18 px resize grip sits in the corner)
    local flat = typeof(parent) == "Instance" and parent:GetAttribute("Flat") == true
    if flat then
        bar.BackgroundTransparency = 1
    else
        if L and type(L.CardSkin) == "function" then
            L.CardSkin(bar, 4)
        else
            corner(4).Parent = bar
            stroke(Palette.RavenOutline, 1, 0).Parent = bar
