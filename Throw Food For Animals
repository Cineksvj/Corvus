	rawset(Library, "SpawnFlare", function(_, at, size, life) return spawnFlare(at, size or 90, life or 0.5) end)
	local function playMinimizeComet(minimizing)
		if rawget(Library, "LowEffects") == true then return end
		local k = Library.UIScale or (mainScale.Scale > 0 and mainScale.Scale or 1)
		local pos = main.AbsolutePosition - screenGui.AbsolutePosition
		local size = main.AbsoluteSize
		local miniW = 300 * k
		local from = minimizing and size.X or miniW
		local to = minimizing and miniW or math.max(size.X, 480 * k)
		local line = Library:New("Frame", {
			Name = "NovaLine",
			BackgroundColor3 = Colors.moon,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(pos.X, pos.Y),
			Size = UDim2.fromOffset(from, 2),
			ZIndex = 40,
			Parent = screenGui,
		})
		Library:New("UIGradient", {
			Color = nebulaSeq(),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.15),
				NumberSequenceKeypoint.new(0.8, 0.15), NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = line,
		})
		Library:NewTween(line, 0.32, { Size = UDim2.fromOffset(to, 2) }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		task.delay(0.22, function() Library:NewTween(line, 0.25, { BackgroundTransparency = 1 }) end)
		task.delay(0.5, function() line:Destroy() end)
		local star = minimizing and (pos + Vector2.new(30 * k, 39 * k)) or (pos + Vector2.new(to / 2, 2))
		task.delay(minimizing and 0.24 or 0.05, function() spawnFlare(star, minimizing and 90 or 140, 0.5) end)
	end
	-- A1 Dynamic Island, redesigned (owner 2026-11-01, C9): the crow, the CORVUS wordmark and the
	-- restore plate in one pill at the top of the screen; under the pointer a clipped strip slides
	-- open with the game, players, fps, ping and the session time. Drag it along the top edge
	-- (IslandX persisted); a click (< 4 px of travel) restores. The lit edge still flashes on a
	-- tagged event. SetIslandStats stays as an API: the island shows no cash any more.
	local ISLAND_H, ISLAND_PAD = 36, 8
	local islandScale
	local windowStart = os.clock()
	local function islandDuration(s)
		s = math.max(0, math.floor(tonumber(s) or 0))
		if s >= 3600 then return string.format("%dh %02dm", math.floor(s / 3600), math.floor(s % 3600 / 60)) end
		return string.format("%dm %02ds", math.floor(s / 60), s % 60)
	end
	-- owner 2026-11-01 ("when minimizing the crovus hub i want cool animation", "the animation rn
	-- is kinda glitching cuz it was made for other ui"): the window collapses into the island by
	-- its own UIScale (see Minimize), nothing hides and the size never changes. The resting state
	-- (scale, place, corner) lives in winAnim while a tween runs and finishAnim puts it back;
	-- every delayed step is tagged with animSeq and checked before it acts, and a call caught
	-- mid-animation carries on from where the frame is, so a spammed key always lands clean.
	-- The veil is a window-coloured sheet over the pages for the way in and out, hidden at rest.
	-- _shown is the state the window is heading for.
	local MIN_T, RES_T = 0.4, 0.44
	local animSeq = 0
	local winAnim   -- { Tweens, Scale, Position, Corner } while the frame is animating
	local mainCorner = main:FindFirstChildOfClass("UICorner")
	local veil = Library:New("Frame", {
		Name = "CorvusVeil",
		BackgroundColor3 = main.BackgroundColor3,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 90,
		Parent = main,
	})
	local veilCorner = Library:Round(12)
	veilCorner.Parent = veil
	Library:GiveSignal(main:GetPropertyChangedSignal("BackgroundColor3"):Connect(function() veil.BackgroundColor3 = main.BackgroundColor3 end))
	rawset(window, "_shown", main.Visible)
	local function beginAnim()
		local a = winAnim
		if a then
			for _, tw in ipairs(a.Tweens) do pcall(tw.Cancel, tw) end
			table.clear(a.Tweens)
		else
			a = { Tweens = {}, Scale = Library.UIScale or mainScale.Scale, Position = main.Position, Corner = mainCorner and mainCorner.CornerRadius or nil }
			winAnim = a
		end
		rawset(window, "_animating", true)
		veil.Visible = true
		return a
	end
	local function play(a, inst, info, props)
		local tw = TweenService:Create(inst, info, props)
		table.insert(a.Tweens, tw)
		tw:Play()
		return tw
	end
	local function finishAnim()
		local a = winAnim
		if not a then return end
		winAnim = nil
		rawset(window, "_animating", nil)
		for _, tw in ipairs(a.Tweens) do pcall(tw.Cancel, tw) end
		mainScale.Scale, main.Position = a.Scale, a.Position
		if mainCorner and a.Corner then mainCorner.CornerRadius = a.Corner end
		veilCorner.CornerRadius = UDim.new(0, 12)
		veil.BackgroundTransparency, veil.Visible = 1, false
		if main.Visible and type(window._scheduleFit) == "function" then window:_scheduleFit(false) end
	end
	local function islandSpot()
		local vp = Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
		local x = vp.X / 2
		if type(Library.GetSetting) == "function" then
			local ok, saved = pcall(Library.GetSetting, Library, "IslandX", nil)
			if ok and tonumber(saved) then x = math.clamp(tonumber(saved), 140, vp.X - 140) end
		end
		local inset = math.max(0, -screenGui.AbsolutePosition.Y)
		return x, inset + 10
	end
	-- the scale and the place that put the frame on the island: ISLAND_H high (at the hub's full
	-- scale), centred on the island's spot, the frame's own AnchorPoint kept
	local function islandTarget(full)
		local k = mainScale.Scale > 0 and mainScale.Scale or 1
		local w, h = main.Size.X.Offset, main.Size.Y.Offset
		if w < 1 or h < 1 then w, h = main.AbsoluteSize.X / k, main.AbsoluteSize.Y / k end
		local kEnd = math.max(0.04, ISLAND_H * (full or k) / math.max(1, h))
		local x, y = islandSpot()
		local ax, ay = main.AnchorPoint.X, main.AnchorPoint.Y
		return kEnd, UDim2.fromOffset(x - w * kEnd / 2 + ax * w * kEnd, y + ay * h * kEnd)
	end
