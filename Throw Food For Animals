local KeyPicker = {}
KeyPicker.__index = KeyPicker

local KEY_LABEL = {
    [Enum.KeyCode.LeftShift] = "LSHIFT",
    [Enum.KeyCode.RightShift] = "RSHIFT",
    [Enum.KeyCode.LeftControl] = "LCTRL",
    [Enum.KeyCode.RightControl] = "RCTRL",
    [Enum.KeyCode.LeftAlt] = "LALT",
    [Enum.KeyCode.RightAlt] = "RALT",
    [Enum.KeyCode.Insert] = "INS",
    [Enum.KeyCode.Delete] = "DEL",
    [Enum.KeyCode.Return] = "ENTER",
    [Enum.KeyCode.Space] = "SPACE",
    [Enum.UserInputType.MouseButton1] = "MB1",
    [Enum.UserInputType.MouseButton2] = "MB2",
    [Enum.UserInputType.MouseButton3] = "MB3",
}

-- a picker's Value is the key's NAME ("Insert", "MouseButton2"): a string the save manager's
-- JSON can hold (an EnumItem encodes as null - found live 2026-11-01, the menu key never saved).
-- keyStr normalises what comes in (EnumItem or name), keyEnum gives the EnumItem back for the
-- input checks.
local Keys = {}
function Keys.str(v)
    if typeof(v) == "EnumItem" then return v.Name end
    if type(v) == "string" and v ~= "" then return v end
    return nil
end
function Keys.enum(v)
    if typeof(v) == "EnumItem" then return v end
    if type(v) ~= "string" or v == "" then return nil end
    local ok, e = pcall(function() return Enum.KeyCode[v] end)
    if ok and e then return e end
    ok, e = pcall(function() return Enum.UserInputType[v] end)
    if ok and e then return e end
    return nil
end
local function keyName(k)
    if not k then return "---" end
    if KEY_LABEL[k] then return KEY_LABEL[k] end
    local nameStr = typeof(k) == "EnumItem" and tostring(k.Name)
        or (type(k) == "string" and k)
        or nil
    if nameStr then
        -- de-AI pass 4: show the full name (chip was widened to 92 px). The 4-char truncation
        -- "RIGH" was tell-level sloppy.
        local e = Keys.enum(nameStr)
        if e and KEY_LABEL[e] then return KEY_LABEL[e] end
        return nameStr
    end
    return "---"
end

function Groupbox:AddKeyPicker(idx, props)
    props = props or {}
    local inline = props.NoUI or false
    local row
    if not inline then
        row = makeRow(self, T(24, 36), "KeyPicker_" .. tostring(idx or props.Text or "x"))
        text({
            Name = "Label",
            Text = props.Text or "Keybind",
            TextSize = T(13, 14),
            FontFace = Fonts.Sans,
            TextColor3 = TEXT_MID,  -- one label style for every control (de-AI pass 3)
            Size = UDim2.new(1, -70, 1, 0),
            Parent = row,
        })
    end

    local chip = new("TextButton", {
        Name = "Chip",
        BackgroundColor3 = Colors.Well,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(T(92, 104), T(22, 32)),  -- wide enough for "RightControl" (was 64 -> "RIGH")
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Text = keyName(props.Default),
        TextColor3 = Colors.Brushed,
        FontFace = Fonts.Mono,
        TextSize = T(11, 12),
        AutoButtonColor = false,
        Parent = row or self.Body,
    })
    corner(4, chip)
    local chipStroke = Edge.lit(chip)

    local k = setmetatable({
        Type = "KeyPicker",
        Idx = idx,
        Value = Keys.str(props.Default),
        Default = Keys.str(props.Default),
        Mode = props.Mode or "Toggle",
        Modifiers = {},
        Chip = chip,
        Row = row,
        Changed = signal(),
        Clicked = signal(),
        _callback = props.Callback or function() end,
        _changedCallback = props.ChangedCallback or function() end,
        _state = false,
        _listening = false,
    }, KeyPicker)

    function k:_refresh()
        chip.Text = self._listening and "..." or keyName(self.Value)
    end
    k:_refresh()
    -- Reset path uses SetValue - restore to default without a callback. The save manager's load
    -- hands { key, mode, modifiers } (its own form); a key alone comes as an EnumItem or a name.
    function k:SetValue(v, silent)
        if type(v) == "table" then
            local mode = v[2]
            if mode == "Toggle" or mode == "Hold" or mode == "Always" then self.Mode = mode end
            self.Modifiers = type(v[3]) == "table" and v[3] or {}
            v = v[1]
        end
        v = Keys.str(v)
        if self.Value == v then return end
        local old = self.Value
        self.Value = v
        self:_refresh()
        if not silent then
            task.spawn(self._changedCallback, v)
            self.Changed:Fire(v)
            if Library.OnOptionChanged then Library.OnOptionChanged(self) end
            if type(rawget(Library, "_pushHistory")) == "function" then Library._pushHistory(self, old, v) end
        end
    end

    local pulseConn
    local function startPulse()
        local t0 = tick()
        Edge.state(chipStroke, "active", 0)
        pulseConn = RunService.RenderStepped:Connect(function()
            local dt = (tick() - t0) % 1.2
            local f = dt / 1.2
            local alpha = 0.2 + 0.5 * math.abs(math.sin(f * math.pi * 2))
            chipStroke.Transparency = alpha
        end)
    end
    local function stopPulse()
        if pulseConn then pulseConn:Disconnect(); pulseConn = nil end
        Edge.state(chipStroke, "rest", 0)
        chipStroke.Transparency = 0
    end

    function k:StartListening()
        if self._listening then return end
        self._listening = true
        self:_refresh()
        startPulse()
        local conn
        conn = UserInputService.InputBegan:Connect(function(input, processed)
            if not self._listening then conn:Disconnect(); return end
            local picked
            if input.KeyCode == Enum.KeyCode.Escape then
                picked = nil
            elseif input.UserInputType == Enum.UserInputType.Keyboard then
                picked = input.KeyCode
            elseif input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.MouseButton2
                or input.UserInputType == Enum.UserInputType.MouseButton3 then
                picked = input.UserInputType
            else
                return
            end
            self._listening = false
            stopPulse()
            -- through SetValue, so the change reaches the autosave (owner 2026-11-01: the menu key
            -- saves and loads with the rest)
            if Keys.str(picked) == self.Value then
                self:_refresh()
            else
                self:SetValue(picked)
            end
            conn:Disconnect()
        end)
    end

    function k:GetState()
        if not self.Value then return false end
        if self.Mode == "Always" then return true end
        if self.Mode == "Hold" then
            local e = Keys.enum(self.Value)
            if e then
                if e.EnumType == Enum.KeyCode then
                    return UserInputService:IsKeyDown(e)
                else
                    return UserInputService:IsMouseButtonPressed(e)
                end
            end
            return false
        end
        return self._state
    end

    chip.MouseButton1Click:Connect(function() k:StartListening() end)
    chip.MouseButton2Click:Connect(function()
        -- cycle mode
        local modes = { "Toggle", "Hold", "Always" }
        local cur = table.find(modes, k.Mode) or 1
        k.Mode = modes[(cur % #modes) + 1]
    end)

    local function matches(input)
        local e = Keys.enum(k.Value)
        if not e then return false end
        if e.EnumType == Enum.KeyCode then return input.KeyCode == e end
        return e.EnumType == Enum.UserInputType and input.UserInputType == e
    end
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or k._listening or not k.Value then return end
        local match = matches(input)
        if match then
            if k.Mode == "Toggle" then
                k._state = not k._state
                task.spawn(k._callback, k._state)
                k.Clicked:Fire(k._state)
            elseif k.Mode == "Hold" then
                task.spawn(k._callback, true)
                k.Clicked:Fire(true)
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if k._listening or not k.Value or k.Mode ~= "Hold" then return end
        local match = matches(input)
        if match then
            task.spawn(k._callback, false)
        end
    end)

    connectHover(chip,
        function() if not k._listening then Edge.state(chipStroke, "hover", 0.12); tween(chip, 0.12, nil, { BackgroundColor3 = Colors.WellHover }) end end,
        function() if not k._listening then Edge.state(chipStroke, "rest", 0.12); tween(chip, 0.12, nil, { BackgroundColor3 = Colors.Well }) end end
    )

    if idx then Library.Options[idx] = k end
    table.insert(self._controls, k)
    return k
end

