-- ============================================================================
-- CORVUS-DIAG: library hash line + the v1 opt-out diagnostics sender (1:1,
-- tools/hubtest.py cuts CORVUS-DIAG-BEGIN..END into tools/mocks/diag_test.luau).
-- Sends only when the loader set getgenv().CorvusStats (url, game, playerKey).
-- ============================================================================
do
	local LibHash = 0
	local Source = rawget(Library, "_Source") or tostring(rawget(Library, "Version") or "corvus-v2")
	for i = 1, #Source do LibHash = (LibHash * 131 + string.byte(Source, i)) % 2147483647 end
	Library.LibHash = string.format("%x", LibHash)
	print(string.format("[Corvus Lib] hash=%s load=%s lua5.1=%s", Library.LibHash, tostring(_VERSION), tostring(_G._VERSION or "n/a")))
	-- optional fields the sender / config loader read before anyone sets them: no "not registered" warn
	local Silent = rawget(Library, "_silentKeys")
	if type(Silent) == "table" then
		for _, Key in { "HubVersion", "KeybindFrame", "DiagnosticsInternal", "ConfigLoadFailed", "ConfigLoadedName", "ConfigRetryToken" } do
			Silent[Key] = true
		end
	end
end
do
	-- v1 helper the sender posts through (executor request function)
	local function GetRequestFunction()
		return (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
	end
	-- CORVUS-DIAG-BEGIN: opt-out anonymous diagnostics (Settings > Diagnostics). Reads the hub's own status lines from the log file writes.
	do
		local DiagStats = { Url = nil }
		local DiagTags = {
			START = true, PLAN = true, RATE = true, BUY = true, SELL = true, REBIRTH = true, ADMIN = true, EVENT = true, FRIEND = true,
			HOP = true, NEEDS = true, MOOD = true, PAUSE = true, LUCKY = true, STARS = true, PROBLEM = true,
		}
		local DiagOn = Library:GetSetting("Diagnostics", true) == true   -- on by default (owner 2026-11-02: anonymous, users told on Discord); Settings > Privacy turns it off
		local Pending, PendingCount, Seen = {}, 0, {}
		local HourStart, HourBytes, LastLuaError = os.clock(), 0, nil
		local function stats()
			local value = getgenv().CorvusStats
			return if type(value) == "table" then value else {}
		end
		local function playerKey()
			local value = stats().playerKey
			if type(value) == "function" then
				local ok, key = pcall(value)
				if ok and type(key) == "string" and #key >= 8 then
					return key
				end
			end
			return nil
		end
		local function setStatus(text)
			Library.DiagnosticsStatus = text
			local label = Library.DiagnosticsLabel
			if label and label.SetText then
				pcall(label.SetText, label, text)
			end
		end
		local function post(path, body, countBudget)
			local url = stats().url
			local fn = GetRequestFunction()
			if type(url) ~= "string" or url == "" or type(fn) ~= "function" then
				return false
			end
			local okEnc, text = pcall(HttpService.JSONEncode, HttpService, body)
			if not okEnc or type(text) ~= "string" then
				return false
			end
			if countBudget then
				if os.clock() - HourStart >= 3600 then
					HourStart, HourBytes = os.clock(), 0
				end
				if HourBytes + #text > 20000 then
					return false
				end
				HourBytes += #text
			end
			local ok, response = pcall(fn, { Url = url .. path, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = text })
			if ok and response ~= nil then
				if countBudget then
					setStatus(string.format("Last sent %s, %.1f KB", os.date("%H:%M"), #text / 1024))
				end
				return true
			end
			return false
		end
		local function maskIds(part)
			part = string.gsub(part, "%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x", "<id>")
			part = string.gsub(part, "%f[%w]%x+%f[%W]", function(word)
				if #word >= 12 then
					return "<id>"
				end
				return nil
			end)
			return part
		end
		local function maskPart(part)
			return (string.gsub(maskIds(part), "%d+[%.,]?%d*", "<n>"))
		end
		-- numbers -> <n>, long hex/ids -> <id>, quoted strings are kept
		local function template(text)
			local out, pos, quoted = {}, 1, false
			while pos <= #text + 1 do
				local stop = string.find(text, '"', pos, true) or (#text + 1)
				local piece = string.sub(text, pos, stop - 1)
				out[#out + 1] = if quoted then piece else maskPart(piece)
				if stop <= #text then
					out[#out + 1] = '"'
				end
				quoted = not quoted
				pos = stop + 1
			end
			return string.sub(table.concat(out), 1, 160)
		end
		local function scrub(text)
			local player = game:GetService("Players").LocalPlayer
			if player then
				for _, name in ipairs({ player.Name, player.DisplayName }) do
					if type(name) == "string" and #name >= 3 then
						local from = 1
						while true do
							local a, b = string.find(string.lower(text), string.lower(name), from, true)
							if not a then
								break
							end
							text = string.sub(text, 1, a - 1) .. "<player>" .. string.sub(text, b + 1)
							from = a + 8
						end
					end
				end
			end
			return text
		end
		local function add(text, forced)
			text = maskIds(scrub(text))
			local key = template(text)
			local item = Pending[key]
			if not item then
				if PendingCount >= 150 then
					return
				end
				item = { t = key, n = 0, s = {}, problem = forced == true or string.find(string.lower(key), "problem", 1, true) ~= nil }
				Pending[key] = item
				PendingCount += 1
			end
			item.n += 1
			table.insert(item.s, string.sub(text, 1, 200))
			if #item.s > 3 then
				table.remove(item.s, 1)
			end
		end
		local function ingest(content, append)
			if type(content) ~= "string" then
				return
			end
			local current = {}
			for line in string.gmatch(content, "[^\r\n]+") do
				current[line] = true
				if not Seen[line] and DiagOn then
					local text = string.gsub(line, "^%[[^%]]*%]%s*", "")
					local tag = string.match(text, "^(%a+)")
					if tag then
						local up = string.upper(tag)
						if DiagTags[up] then
							add(text, up == "PROBLEM")
						end
					end
				end
				if append then
					Seen[line] = true
				end
			end
			if not append then
				Seen = current
			end
		end
		local function flush()
			if not DiagOn then
				return
			end
			local luaError = getgenv().CorvusLastError
			if type(luaError) == "string" and luaError ~= "" and luaError ~= LastLuaError then
				LastLuaError = luaError
				add("LUAERROR " .. string.sub(string.match(luaError, ":\n([^\n]+)") or luaError, 1, 150), true)
			end
			if PendingCount == 0 then
				return
			end
			local stat = stats()
			local key = playerKey()
			if not stat.game or not key then
				return
			end
			local list = {}
			for _, item in pairs(Pending) do
				table.insert(list, item)
			end
			table.sort(list, function(a, b)
				if a.problem ~= b.problem then
					return a.problem
				end
				return a.n > b.n
			end)
			local body = { g = stat.game, h = tostring(Library.HubVersion or Library.Version or "?"), k = key, l = {} }
			local size = #HttpService:JSONEncode(body)
			local taken = {}
			for _, item in ipairs(list) do
				local entry = { t = item.t, n = item.n, s = item.s }
				local cost = #HttpService:JSONEncode(entry) + 1
				if size + cost <= 4000 then
					size += cost
					table.insert(body.l, entry)
					table.insert(taken, item)
				end
			end
			if #taken == 0 then
				return
			end
			for _, item in ipairs(taken) do
				Pending[item.t] = nil
				PendingCount -= 1
			end
			post("/logs", body, true)
		end
		function Library:SetDiagnostics(Value)
			DiagOn = Value == true
			Library:SetSetting("Diagnostics", DiagOn)
			if not DiagOn then
				table.clear(Pending)
				PendingCount = 0
				setStatus("Off, nothing is sent")
			else
				setStatus("On, first send within 10 minutes")
			end
		end
		function Library:GetDiagnostics()
			return DiagOn
		end
		setStatus(if DiagOn then "On, first send within 10 minutes" else "Off, nothing is sent")
		-- every hub writes its status log with writefile/appendfile to Corvus_<GAME>_log.txt: read the new lines there
		local env = getgenv()
		local function isLog(name)
			return type(name) == "string" and string.match(name, "Corvus_[^/\\]*_log%.txt$") ~= nil
		end
		local baseWrite = env.CorvusRealWriteFile or writefile
		if type(baseWrite) == "function" then
			env.CorvusRealWriteFile = baseWrite
			env.writefile = function(name, content, ...)
				if isLog(name) then
					pcall(ingest, content, false)
				end
				return baseWrite(name, content, ...)
			end
		end
		local baseAppend = env.CorvusRealAppendFile or appendfile
		if type(baseAppend) == "function" then
			env.CorvusRealAppendFile = baseAppend
			env.appendfile = function(name, content, ...)
				if isLog(name) then
					pcall(ingest, content, true)
				end
				return baseAppend(name, content, ...)
			end
		end
		task.spawn(function()
			while not Library.Unloaded do
				task.wait(600)
				pcall(flush)
			end
		end)
		DiagStats.flush = flush
		Library.DiagnosticsInternal = DiagStats
		-- the hub's feedback sender calls this next to its Discord post (anonymous = the worker does not store the key)
		function Library.PostFeedback(kind, text, anonymous, executor)
			local stat = stats()
			local key = playerKey()
			if not key or not stat.game then
				return false
			end
			local lowered = string.lower(tostring(kind or "other"))
			if lowered ~= "bug" and lowered ~= "idea" then
				lowered = "other"
			end
			return post("/feedback", {
				k = key,
				g = stat.game,
				kind = lowered,
				text = string.sub(tostring(text or ""), 1, 1500),
				e = string.sub(tostring(executor or "?"), 1, 40),
				hv = tostring(Library.HubVersion or Library.Version or "?"),
				a = anonymous == true,
			}, false)
		end
	end
	-- CORVUS-DIAG-END
end

-- ============================================================================
-- CORVUS-LOAD: timing + CorvusLog + START / AUTOLOAD / CLICK lines.
-- The hub sets Library.LoadLogger; everything below funnels through CorvusLog.
-- ============================================================================
do
	CorvusLoadTimes.lib = CorvusLoadTimes.lib or (clock() - getgenv().CorvusLoadT0)
	CorvusLoadTimes.libDone = CorvusLoadTimes.libDone or clock()

	function Library:CorvusLog(Line: string)
		if typeof(Library.LoadLogger) == "function" then
			pcall(Library.LoadLogger, tostring(Line))
		end
	end

	function Library:LoadReport(): string
		local T = CorvusLoadTimes
		local Loader = getgenv().CorvusLoaderTimes
		Loader = (typeof(Loader) == "table") and Loader or {}
		local function F(v) return (typeof(v) == "number") and string.format("%.1f", v) or "-" end
		local game_t = (T.shown and T.libDone) and math.max(0, T.shown - T.libDone - (T.ui or 0) - (T.addons or 0)) or nil
		local boot = (typeof(Loader.run) == "number") and math.max(0, getgenv().CorvusLoadT0 - Loader.run) or nil
		local total = (T.shown and typeof(Loader.begin) == "number") and (T.shown - Loader.begin)
			or (T.shown and (T.shown - getgenv().CorvusLoadT0)) or nil
		return string.format(
			"LOAD fetch=%s compile=%s boot=%s lib=%s icons=%s ui=%s addons=%s community=%s discord=%s game=%s total=%s",
			F(Loader.fetch), F(Loader.compile), F(boot), F(T.lib),
			(typeof(T.iconsState) == "string") and T.iconsState or F(T.icons),
			F(T.ui), F(T.addons), F(T.community), F(T.discord), F(game_t), F(total)
		)
	end

	-- Obsidian addon fetcher with offline cache (Corvus/addons/)
	function Library.FetchAddon(BaseUrl: string, Name: string, Network: boolean?): string
		local T0 = clock()
		local File = "Corvus/addons/" .. Name
		local Source = nil
		if not Network then
			pcall(function()
				if isfile and readfile and isfile(File) then Source = readfile(File) end
			end)
		end
		if typeof(Source) == "string" and #Source > 500 then
			task.spawn(function()
				local ok, fresh = pcall(game.HttpGet, game, BaseUrl .. Name)
				if ok and typeof(fresh) == "string" and #fresh > 500 and fresh ~= Source and writefile then
					pcall(writefile, File, fresh)
				end
			end)
		else
			Source = game:HttpGet(BaseUrl .. Name)
			if typeof(Source) == "string" and #Source > 500 then
				pcall(function()
					if isfolder and makefolder then
						if not isfolder("Corvus") then makefolder("Corvus") end
						if not isfolder("Corvus/addons") then makefolder("Corvus/addons") end
					end
					if writefile then writefile(File, Source) end
				end)
			end
		end
		CorvusLoadTimes.addons = (CorvusLoadTimes.addons or 0) + (clock() - T0)
		return Source
	end

	-- Wrap CreateWindow so load timing + icons wait fires once.
	if typeof(Library.CreateWindow) == "function" then
		local BaseCreateWindow = Library.CreateWindow
		function Library:CreateWindow(...)
			if typeof(self.WaitForIcons) == "function" then pcall(self.WaitForIcons, self) end
			local T0 = clock()
			local Window = BaseCreateWindow(self, ...)
			if CorvusLoadTimes.shown == nil then
				CorvusLoadTimes.ui = clock() - T0
				CorvusLoadTimes.shown = clock()
				getgenv().CorvusLoaded = clock()
				task.delay(12, function()
					local ok, line = pcall(self.LoadReport, self)
					if not ok then return end
					getgenv().CorvusLoadLine = line
					print("[Corvus] " .. line)
					if typeof(Library.LoadLogger) == "function" then pcall(Library.LoadLogger, line) end
				end)
			end
			if not Library.StartFallback then
				Library.StartFallback = true
				task.delay(20, function()
					if not Library.Unloaded then Library:LogStart() end
				end)
			end
			return Window
		end
	end
	if typeof(Library.OpenDiscordInvite) == "function" then
		local base = Library.OpenDiscordInvite
		function Library:OpenDiscordInvite(...)
			local T0 = clock()
			local r = base(self, ...)
			CorvusLoadTimes.discord = CorvusLoadTimes.discord or (clock() - T0)
			return r
		end
	end
	if typeof(Library.WaitForIcons) ~= "function" then
		function Library:WaitForIcons() end
	end
	if typeof(Library.StartQuickBind) ~= "function" then
		function Library:StartQuickBind() end
	end

	local function TogglesOn()
		local n = {}
		for name, t in Library.Toggles do
			if typeof(name) == "string" and typeof(t) == "table" and t.Value == true and string.sub(name, 1, 6) ~= "Corvus" then
				table.insert(n, name)
			end
		end
		table.sort(n); return n
	end
	function Library:LogStart()
		if self.StartLogged then return end
		self.StartLogged = true
		local total, on = 0, #TogglesOn()
		for name in Library.Toggles do if typeof(name) == "string" then total += 1 end end
		local shown = CorvusLoadTimes.shown
		self:CorvusLog(string.format(
			"START hub loaded | place %s | toggles %d on of %d | window %ss",
			tostring(game.PlaceId), on, total, shown and string.format("%.1f", shown - getgenv().CorvusLoadT0) or "-"
		))
	end
	function Library:FireAutoload()
		if self.AutoloadFired then return end
		self.AutoloadFired = true
		if typeof(self.SyncMirrors) == "function" then pcall(self.SyncMirrors, self) end
		self:LogStart()
		local hook = self.OnAutoload
		if hook == false then return end
		if typeof(hook) == "function" then pcall(hook); return end
		local names = TogglesOn()
		self:CorvusLog("AUTOLOAD toggles=" .. (#names > 0 and table.concat(names, ",") or "-"))
	end
	-- set unconditionally like v1: 01_core leaves a no-op OnUserToggle stub, so an `or` here never logged CLICK
	Library.OnUserToggle = function(name, value)
		Library:CorvusLog("CLICK " .. tostring(name) .. "=" .. tostring(value))
	end
end

-- ============================================================================
-- CORVUS-MIRROR: v1 block 1:1 (tools/hubtest.py cuts it into tools/mocks/config_test.luau)
-- + v2 shims: disabled state also in _disabled, SetValue(v, silent) forwarded,
-- v2 rows have no Holder GuiButton -> the click is logged from Row.InputBegan.
-- ============================================================================
;(function()
	-- CORVUS-MIRROR (Quick Start rule): a second control for an existing toggle in another groupbox. Both stay in sync
	-- both ways, the original keeps the only callback and the only config key (the mirror is not in Library.Toggles).
	-- The mirror shows the original's value from every source: it is repainted before the original's callback runs (a
	-- callback that waits or errors never leaves it stale), after every config load, share code and reset
	-- (Library:SyncMirrors) and by a 0.5 s check that only repaints mirrors (it never changes an original).
	Library.MirrorSyncs = {}
	function Library:SyncMirrors(): number
		local Fixed = 0
		for Index = #Library.MirrorSyncs, 1, -1 do
			local Ok, Alive, Changed = pcall(Library.MirrorSyncs[Index])
			if Ok and Alive == false then
				table.remove(Library.MirrorSyncs, Index)
			elseif Ok and Changed then
				Fixed += 1
			end
		end
		return Fixed
	end
	function Library:MirrorToggle(Idx: string, Box: any, Opts: any?)
		Opts = if typeof(Opts) == "table" then Opts else {}
		local Original = Library.Toggles[Idx]
		if typeof(Original) ~= "table" or typeof(Box) ~= "table" or typeof(Box.AddToggle) ~= "function" then
			return nil
		end
		local Key = {}
		local Mirror = Box:AddToggle(Key, {
			Text = Opts.Text or Original.Text,
			Description = Opts.Description,
			Tooltip = Opts.Tooltip or Original.Tooltip,
			DisabledTooltip = Original.DisabledTooltip,
			Risky = Original.Risky,
			Default = Original.Value == true,
			Confirm = Original._confirm,   -- a guarded original stays guarded on Main
		})
		Library.Toggles[Key] = nil
		if not Mirror then
			return nil
		end
		Mirror.MirrorOf = Idx
		local ShowValue = Mirror.SetValue
		local Syncing = false
		-- v1/Obsidian toggles keep the state in Disabled, v2 toggles (02_controls) in _disabled
		local function IsDisabled(Toggle: any): boolean
			return Toggle.Disabled == true or Toggle._disabled == true
		end
		-- repaints only the mirror (no callback of the original); true = it showed something else
		local function Paint(Value: any): boolean
			if Syncing or Mirror.Destroyed or Mirror.Value == Value then
				return false
			end
			Syncing = true
			pcall(ShowValue, Mirror, Value)
			Syncing = false
			return true
		end
		-- alive (false = mirror destroyed, drop it), changed
		local function Sync(): (boolean, boolean)
			if Mirror.Destroyed then
				return false, false
			end
			return true, Paint(Original.Value)
		end
		local BaseSet = Original.SetValue
		Original.SetValue = function(Self, Value, ...)
			Paint(Value)
			BaseSet(Self, Value, ...)
			Sync()
		end
		table.insert(Library.MirrorSyncs, Sync)
		if not Library.MirrorWatch then
			Library.MirrorWatch = true
			task.spawn(function()
				while not Library.Unloaded do
					task.wait(0.5)
					Library:SyncMirrors()
				end
			end)
		end
		local BaseDisabled = Original.SetDisabled
		if typeof(BaseDisabled) == "function" then
			Original.SetDisabled = function(Self, Disabled)
				BaseDisabled(Self, Disabled)
				if not Mirror.Destroyed then
					pcall(Mirror.SetDisabled, Mirror, Disabled)
				end
			end
			if IsDisabled(Original) then
				pcall(Mirror.SetDisabled, Mirror, true)
			end
		end
		-- the mirror's own switch (click, quick bar, v2 Toggle()) drives the original, whose SetValue repaints the mirror
		Mirror.SetValue = function(_, Value, ...)
			Original:SetValue(Value, ...)
		end
		local Holder = Mirror.Holder
		if typeof(Holder) == "Instance" and Holder:IsA("GuiButton") and typeof(Mirror.Connections) == "table" then
			table.insert(Mirror.Connections, Holder.MouseButton1Click:Connect(function()
				-- deferred so the value is the one after the click, whatever order the connections fire in
				task.defer(function()
					if not IsDisabled(Original) and Library.OnUserToggle then
						pcall(Library.OnUserToggle, Idx, Original.Value)
					end
				end)
			end))
			table.insert(Mirror.Connections, Holder.MouseButton2Click:Connect(function()
				Library:StartQuickBind("Toggle", Idx, tostring(Original.Text))
			end))
		elseif typeof(Mirror.Row) == "Instance" then
			-- v2 toggle: its Row.InputBegan flips it (02_controls); log the user click under the original's name
			local Conn = Mirror.Row.InputBegan:Connect(function(Input)
				local Kind = Input.UserInputType
				if Kind == Enum.UserInputType.MouseButton1 or Kind == Enum.UserInputType.Touch then
					task.defer(function()
						if not IsDisabled(Original) and not IsDisabled(Mirror) and Library.OnUserToggle then
							pcall(Library.OnUserToggle, Idx, Original.Value)
						end
					end)
				elseif Kind == Enum.UserInputType.MouseButton2 then
					pcall(Library.StartQuickBind, Library, "Toggle", Idx, tostring(Original.Text))
				end
			end)
			if typeof(Library.GiveSignal) == "function" then
				pcall(Library.GiveSignal, Library, Conn)
			end
		end
		return Mirror
	end
end)()-- CORVUS-MIRROR-END

-- ============================================================================
-- CORVUS-CONFIGLOAD: v1 block 1:1 (tools/hubtest.py cuts it into tools/mocks/config_test.luau)
-- + v2 shim: a v2 toggle has no RunChanged, an unchanged true toggle runs its callback + Changed.
-- ============================================================================
	-- CORVUS-CONFIGLOAD (player feedback 2026-10-07: "after I loaded the config none of the settings were active").
	-- The Obsidian SaveManager is fetched live from GitHub: it applies saved values one by one with task.defer, drops a
	-- value whose control does not exist yet and a dropdown value whose list is filled later (tower lists, eggs...).
	-- Corvus applies a config itself: right away, every control through SetValue (callbacks and loops start), a true
	-- toggle that already shows true still gets its callback, and controls or dropdown values that appear later are
	-- applied the moment they exist (retried for 60 s). Log: CONFIG loaded <name> controls=<n> on=<list> [later=<n>].
;(function()
	local ConfigKinds = { Toggle = "Toggles", Slider = "Options", Dropdown = "Options", Input = "Options", KeyPicker = "Options", ColorPicker = "Options", WebhookBoard = "Options" }
	local function ConfigSameSet(A: any, B: any): boolean
		local Left, Right = {}, {}
		for Key, On in (if typeof(A) == "table" then A else {}) do
			if typeof(On) ~= "boolean" then
				Left[tostring(On)] = true
			elseif On then
				Left[tostring(Key)] = true
			end
		end
		for Key, On in (if typeof(B) == "table" then B else {}) do
			if typeof(On) ~= "boolean" then
				Right[tostring(On)] = true
			elseif On then
				Right[tostring(Key)] = true
			end
		end
		for Key in Left do
			if not Right[Key] then
				return false
			end
		end
		for Key in Right do
			if not Left[Key] then
				return false
			end
		end
		return true
	end
	-- true = the control now holds the saved value, false = not yet (control missing or its list not filled yet)
	local function ConfigApplyOne(Option: any): boolean
		local List = Library[ConfigKinds[Option.type] or ""]
		local Element = List and List[Option.idx]
		if typeof(Element) ~= "table" or typeof(Element.SetValue) ~= "function" then
			return false
		end
		local Kind = Option.type
		if Kind == "Toggle" then
			local Want = Option.value == true
			if Element.Value ~= Want then
				task.spawn(Element.SetValue, Element, Want)
			elseif Want and typeof(Element.RunChanged) == "function" then
				task.spawn(Element.RunChanged, Element)
			elseif Want and typeof(Element._callback) == "function" then
				-- v2 toggle (02_controls) has no RunChanged: the same as RunChanged, callback + Changed with the value
				task.spawn(function()
					Element._callback(true)
					if typeof(Element.Changed) == "table" and typeof(Element.Changed.Fire) == "function" then
						Element.Changed:Fire(true)
					end
				end)
			end
			return true
		elseif Kind == "Slider" then
			local Want = tonumber(Option.value)
			if Want and Element.Value ~= Want then
				task.spawn(Element.SetValue, Element, Want)
			end
			return true
		elseif Kind == "Input" then
			if typeof(Option.text) == "string" and Element.Value ~= Option.text then
				task.spawn(Element.SetValue, Element, Option.text)
			end
			return true
		elseif Kind == "WebhookBoard" then
			task.spawn(Element.SetValue, Element, Option.value)
			return true
		elseif Kind == "Dropdown" then
			local Want = Option.value
			if Element.Multi then
				if ConfigSameSet(Element.Value, Want) then
					return true
				end
				task.spawn(Element.SetValue, Element, if typeof(Want) == "table" then Want else {})
				return ConfigSameSet(Element.Value, Want)
			end
			if Element.Value == Want then
				return true
			end
			task.spawn(Element.SetValue, Element, Want)
			return Element.Value == Want
		elseif Kind == "KeyPicker" then
			if Option.key ~= nil then
				task.spawn(Element.SetValue, Element, { Option.key, Option.mode, Option.modifiers })
			end
			return true
		elseif Kind == "ColorPicker" then
			if typeof(Option.value) == "string" and typeof(Element.SetValueRGB) == "function" then
				local Ok, Color = pcall(Color3.fromHex, Option.value)
				if Ok then
					task.spawn(Element.SetValueRGB, Element, Color, Option.transparency)
				end
			end
			return true
		end
		return true
	end
	local function ConfigOnList(): string
		local Names = {}
		for Name, Toggle in Library.Toggles do
			if typeof(Name) == "string" and typeof(Toggle) == "table" and Toggle.Value == true and string.sub(Name, 1, 6) ~= "Corvus" then
				table.insert(Names, Name)
			end
		end
		table.sort(Names)
		return if #Names > 0 then table.concat(Names, ",") else "-"
	end
	function Library:ApplyConfigObjects(Objects: any, Ignore: any, Name: string?): (number, number)
		Ignore = if typeof(Ignore) == "table" then Ignore else {}
		Name = tostring(Name or "config")
		local Applied, Later = 0, {}
		for _, Option in (if typeof(Objects) == "table" then Objects else {}) do
			if typeof(Option) == "table" and typeof(Option.idx) == "string" and ConfigKinds[Option.type] and not Ignore[Option.idx] then
				local Ok, Done = pcall(ConfigApplyOne, Option)
				if Ok and Done then
					Applied += 1
				else
					table.insert(Later, Option)
				end
			elseif typeof(Option) == "table" and Option.type == "Groupbox" and typeof(Option.tabIdx) == "string" then
				pcall(function()
					local Tab = Library.Tabs[Option.tabIdx]
					local Box = Tab and Tab.Groupboxes and Tab.Groupboxes[Option.idx]
					if Box and typeof(Box.SetCollapsed) == "function" and (Box.Collapsed == true) ~= (Option.collapsed == true) then
						Box:SetCollapsed(Option.collapsed == true)
					end
				end)
			end
		end
		Library.ConfigLoadedName = Name
		-- Quick Start mirrors show the loaded values (CORVUS-MIRROR)
		if typeof(Library.SyncMirrors) == "function" then
			pcall(Library.SyncMirrors, Library)
		end
		Library:CorvusLog(string.format("CONFIG loaded %s controls=%d on=%s%s", Name, Applied, ConfigOnList(), if #Later > 0 then " later=" .. #Later else ""))
		if #Later > 0 then
			local Token = {}
			Library.ConfigRetryToken = Token
			task.spawn(function()
				local Deadline = os.clock() + 60
				while #Later > 0 and os.clock() < Deadline and not Library.Unloaded and Library.ConfigRetryToken == Token do
					task.wait(0.5)
					local Still = {}
					for _, Option in Later do
						local Ok, Done = pcall(ConfigApplyOne, Option)
						if not (Ok and Done) then
							table.insert(Still, Option)
						end
					end
					if #Still < #Later then
						if typeof(Library.SyncMirrors) == "function" then
							pcall(Library.SyncMirrors, Library)
						end
						Library:CorvusLog(string.format("CONFIG late %s applied=%d waiting=%d on=%s", Name, #Later - #Still, #Still, ConfigOnList()))
					end
					Later = Still
				end
				if #Later > 0 and Library.ConfigRetryToken == Token then
					local Missing = {}
					for Index, Option in Later do
						if Index > 8 then
							break
						end
						table.insert(Missing, tostring(Option.idx))
					end
					Library:CorvusLog(string.format("CONFIG skipped %s count=%d (%s)", Name, #Later, table.concat(Missing, ",")))
				end
			end)
		end
		return Applied, #Later
	end
	-- Routes SaveManager:Load / LoadJSON / LoadAutoloadConfig through ApplyConfigObjects. Only a real SaveManager
	-- (raw Load function) is patched; the offline stub stays as it is.
	function Library:HardenSaveManager(SM: any)
		if typeof(SM) ~= "table" or typeof(rawget(SM, "Load")) ~= "function" or rawget(SM, "CorvusHardened") then
			return
		end
		rawset(SM, "CorvusHardened", true)
		-- the webhook board (02_controls) saves like any option: { type, idx, value = { { url, events } } }
		local Parser = rawget(SM, "Parser")
		if typeof(Parser) == "table" and Parser.WebhookBoard == nil then
			Parser.WebhookBoard = {
				Save = function(Idx, Object)
					return { type = "WebhookBoard", idx = Idx, value = Object.Value }
				end,
				Load = function(Idx, Data)
					local Element = Library.Options[Idx]
					if typeof(Element) == "table" and typeof(Element.SetValue) == "function" then
						Element:SetValue(Data.value)
					end
				end,
			}
		end
		local BaseLoad = rawget(SM, "Load")
		local LoadingName = nil
		rawset(SM, "LoadJSON", function(_, Content: string)
			if typeof(Content) ~= "string" or string.match(Content, "^%s*$") then
				return false, "No JSON provided"
			end
			local Ok, Decoded = pcall(HttpService.JSONDecode, HttpService, Content)
			if not Ok or typeof(Decoded) ~= "table" or typeof(Decoded.objects) ~= "table" then
				return false, "Failed to decode config data"
			end
			if Library.KeybindFrame and typeof(Decoded.keybindMenu) == "table" then
				pcall(function()
					Library.KeybindFrame.Visible = Decoded.keybindMenu.visible == true
				end)
			end
			Library:ApplyConfigObjects(Decoded.objects, SM.Ignore, LoadingName or Decoded.name)
			return true
		end)
		rawset(SM, "Load", function(Self, Name: string)
			LoadingName = Name
			rawset(Library, "ConfigLoading", true)   -- the Settings auto save skips the changes a load makes
			local Ok, Success, Error = pcall(BaseLoad, Self, Name)
			rawset(Library, "ConfigLoading", false)
			LoadingName = nil
			if not Ok then
				return false, tostring(Success)
			end
			if Success then
				Library.ConfigLoadFailed = nil
			else
				Library.ConfigLoadFailed = Name
				Library:CorvusLog(string.format("CONFIG not loaded %s: %s", tostring(Name), tostring(Error)))
			end
			return Success, Error
		end)
	end
end)()-- CORVUS-CONFIGLOAD-END

-- ============================================================================
-- CORVUS-PURCHASEGUARD: block Robux prompts (client calls + server-pushed UI).
-- Default ON, Library.BlockRobuxPrompts, Library:SetBlockRobuxPrompts(bool).
-- ============================================================================
do
	Library.BlockRobuxPrompts = Library:GetSetting("BlockRobuxPrompts", true) ~= false
	local Off = {}
	local function Release()
		for obj in Off do
			Off[obj] = nil
			pcall(function() obj.Enabled = true end)
		end
	end
	function Library:SetBlockRobuxPrompts(Value: boolean)
		Library.BlockRobuxPrompts = Value == true
		Library:SetSetting("BlockRobuxPrompts", Value == true)
		if Value ~= true then Release() end
	end
	table.insert(Library.UnloadSignals, Release)

	pcall(function()
		local Genv = getgenv()
		local Guard = Genv.CorvusPurchaseGuard
		if typeof(Guard) ~= "table" then Guard = {}; Genv.CorvusPurchaseGuard = Guard end
		local Methods = {
			PromptPurchase = true, PromptProductPurchase = true, PromptGamePassPurchase = true,
			PromptBundlePurchase = true, PromptSubscriptionPurchase = true, PromptPremiumPurchase = true,
			PromptRobloxPurchase = true, PromptBulkPurchase = true, PromptThirdPartyPurchase = true,
		}
		local last = {}
		local function Note(kind, id)
			local key = tostring(kind) .. ":" .. tostring(id)
			local n = clock()
			if last[key] and n - last[key] < 60 then return end
			last[key] = n
			Library:CorvusLog("GUARD blocked purchase prompt " .. tostring(kind) .. " " .. tostring(id))
		end
		Guard.Block = function(method, id)
			if Library.Unloaded or not Library.BlockRobuxPrompts then return false end
			task.spawn(Note, method, id); return true
		end
		if not Guard.Hooked and typeof(hookmetamethod) == "function" and typeof(getnamecallmethod) == "function" then
			local Wrap = (typeof(newcclosure) == "function") and newcclosure or function(f) return f end
			local Old
			local ok = pcall(function()
				Old = hookmetamethod(game, "__namecall", Wrap(function(self, ...)
					local m = getnamecallmethod()
					if Methods[m] and self == MarketplaceService then
						local b = select(2, ...)
						if Guard.Block and Guard.Block(m, b ~= nil and b or "-") then return nil end
					end
					return Old(self, ...)
				end))
			end)
			Guard.Hooked = ok and Old ~= nil
		end
		if typeof(hookfunction) == "function" then
			local Wrap = (typeof(newcclosure) == "function") and newcclosure or function(f) return f end
			Guard.FnHooked = (typeof(Guard.FnHooked) == "table") and Guard.FnHooked or {}
			for name in Methods do
				if not Guard.FnHooked[name] then
					pcall(function()
						local Old
						Old = hookfunction(MarketplaceService[name], Wrap(function(self, ...)
							local b = select(2, ...)
							if self == MarketplaceService and Guard.Block and Guard.Block(name, b ~= nil and b or "-") then return nil end
							return Old(self, ...)
						end))
						Guard.FnHooked[name] = true
						Guard.Hooked = true
					end)
				end
			end
		end
		local function IsPrompt(obj)
			if typeof(obj) ~= "Instance" or not obj:IsA("ScreenGui") then return false end
			local n = string.lower(obj.Name)
			return string.find(n, "purchaseprompt", 1, true) ~= nil or string.find(n, "upsell", 1, true) ~= nil
		end
		local function Hide(obj)
			if Library.BlockRobuxPrompts and not Library.Unloaded and obj.Enabled then
				Off[obj] = true; obj.Enabled = false
			end
		end
		local watched = {}
		local function Watch(obj)
			if watched[obj] then return end
			watched[obj] = true
			Library:GiveSignal(obj.DescendantAdded:Connect(function()
				if Library.BlockRobuxPrompts and not Library.Unloaded then pcall(Hide, obj) end
			end))
			Library:GiveSignal(obj:GetPropertyChangedSignal("Enabled"):Connect(function()
				if Library.BlockRobuxPrompts and obj.Enabled then pcall(Hide, obj) end
			end))
			pcall(Hide, obj)
		end
		local function Scan()
			for _, obj in CoreGui:GetChildren() do
				if IsPrompt(obj) then Watch(obj); Hide(obj) end
			end
		end
		pcall(Scan)
		Library:GiveSignal(CoreGui.ChildAdded:Connect(function(obj)
			if IsPrompt(obj) then pcall(Watch, obj) end
		end))
		task.spawn(function()
			while not Library.Unloaded do pcall(Scan); task.wait(0.15) end
		end)
	end)
end

-- ============================================================================
-- CORVUS-ANTIAFK: shared layer, default ON. VirtualInputManager key -> VU click
-- -> LocalPlayer.Idled rebound -> MoveTo nudge -> rejoin on idle kick.
-- ============================================================================
do
	local Afk = {
		Enabled = Library:GetSetting("AntiAFK", true) ~= false,
		LastInput = clock(), LastHuman = clock(), OwnAt = -1e9,
		LastNudge = clock(), NextNudge = 180 + math.random() * 60,
		Every = 60 + math.random() * 20, Count = 0, LastVia = nil,
		LastLog = -1e9, LastWatchLog = -1e9, LastDefuse = -1e9,
		KeySeen = false, KeyWorks = nil, Disabled = {}, Rejoining = false,
	}
	Library.AntiAfk = Afk
	function Library:SetAntiAfk(Value: boolean)
		local was = Afk.Enabled
		Afk.Enabled = Value == true
		Library:SetSetting("AntiAFK", Value == true)
		if was ~= Afk.Enabled then Library:CorvusLog("AFK guard " .. (Afk.Enabled and "on" or "off")) end
	end
	local Key = Enum.KeyCode.F13
	local function Note(via)
		Afk.Count += 1
		local n = clock()
		if via ~= Afk.LastVia or n - Afk.LastLog >= 300 then
			Afk.LastVia = via; Afk.LastLog = n
			Library:CorvusLog(string.format("AFK prevented via=%s total=%d", via, Afk.Count))
		end
	end
	local function VU()
		Afk.OwnAt = clock()
		return (pcall(function()
			local vu = game:GetService("VirtualUser")
			vu:CaptureController(); vu:ClickButton2(Vector2.new())
		end))
	end
	local function Input(inp)
		local k = inp and inp.UserInputType
		if k == Enum.UserInputType.Gyro or k == Enum.UserInputType.Accelerometer then return end
		Afk.LastInput = clock()
		if k == Enum.UserInputType.Keyboard and inp.KeyCode == Key then
			Afk.KeySeen = true
		elseif clock() - Afk.OwnAt > 1.5 then
			Afk.LastHuman = clock()
		end
	end
	for _, sig in { UserInputService.InputBegan, UserInputService.InputEnded, UserInputService.InputChanged } do
		pcall(function() Library:GiveSignal(sig:Connect(Input)) end)
	end
	local function Pulse()
		Afk.KeySeen = false
		local sent = pcall(function()
			local vim = game:GetService("VirtualInputManager")
			vim:SendKeyEvent(true, Key, false, game); task.wait(0.05)
			vim:SendKeyEvent(false, Key, false, game)
		end)
		task.wait(0.5)
		if sent and Afk.KeySeen then Afk.KeyWorks = true; Note("key"); return end
		if Afk.KeyWorks ~= false then
			Afk.KeyWorks = false
			Library:CorvusLog("AFK key input not seen (" .. (sent and "no InputBegan" or "no VirtualInputManager") .. "), using VirtualUser")
		end
		if VU() then Afk.LastInput = clock(); Note("vu") end
	end
	local function Step(hum, target)
		local done = false
		local c = hum.MoveToFinished:Connect(function() done = true end)
		hum:MoveTo(target)
		local dl = clock() + 0.8
		while not done and clock() < dl do task.wait(0.05) end
		c:Disconnect()
	end
	local function Nudge()
		local busy = Library.AntiAfkBusy
		if typeof(busy) == "function" then
			local ok, b = pcall(busy); if ok and b then return false end
		end
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = hum and hum.RootPart
