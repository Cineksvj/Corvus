        local NextButton = FooterButton("Next", "Primary", 1, -16, 96)
        local BackButton = FooterButton("Back", "Secondary", 1, -120, 80)
        Wizard.SkipButton, Wizard.NextButton, Wizard.BackButton = SkipButton, NextButton, BackButton
        Wizard.Overlay = Overlay
        Wizard.Card = Card

        local function PaintChoices()
            local Step = Steps[Wizard.Step]
            if not Step then
                return
            end
            local Key = Step.Id or Wizard.Step
            local Value = Wizard.Values[Key]
            for _, Entry in Wizard.Cards do
                local Selected = if Step.Multi then (typeof(Value) == "table" and Value[Entry.Id] == true) else Value == Entry.Id
                Entry.Stroke.Color = if Selected then Library.Scheme.AccentColor else Library.Scheme.OutlineColor
                Entry.Stroke.Thickness = if Selected then 1.5 else 1
                Entry.Stroke.Transparency = if Selected then 0 else 0.3
                Entry.Fill.BackgroundTransparency = if Selected then 0.88 else 1
                Entry.Check.Visible = Selected
            end
            local Ready = true
            if Step.Multi and Step.Required and typeof(Value) == "table" then
                Ready = next(Value) ~= nil
            end
            NextButton.BackgroundTransparency = if Ready then 0 else 0.6
            Wizard.Ready = Ready
        end

        local function Show(StepIndex: number, Direction: number?)
            Wizard.Step = StepIndex
            local Step = Steps[StepIndex]
            if not Step then
                return
            end
            local Order = VisibleSteps()
            local Position = table.find(Order, StepIndex) or 1
            for _, Child in Segments:GetChildren() do
                Child:Destroy()
            end
            local Count = #Order
            for Index = 1, Count do
                local Segment = New("Frame", {
                    BackgroundColor3 = if Index <= Position then "AccentColor" else "OutlineColor",
                    BackgroundTransparency = if Index <= Position then 0 else 0.2,
                    Position = UDim2.new((Index - 1) / Count, if Index > 1 then 3 else 0, 0, 0),
                    Size = UDim2.new(1 / Count, if Index > 1 then -3 else 0, 1, 0),
                    ZIndex = 2,
                    Parent = Segments,
                })
                New("UICorner", {
                    CornerRadius = UDim.new(1, 0),
                    Parent = Segment,
                })
            end
            StepLabel.Text = string.format("STEP %d OF %d", Position, Count)
            TitleLabel.Text = tostring(Step.Title or "")
            DescLabel.Text = tostring(Step.Description or "")
            BackButton.Visible = Position > 1
            NextButton.Text = if Position >= Count then (Info.FinishText or "Finish") else "Next"

            for _, Entry in Wizard.Cards do
                Entry.Button:Destroy()
            end
            table.clear(Wizard.Cards)
            local Columns = if Wide and not Step.SingleColumn then 2 else 1
            local ChoiceHeight = Step.ChoiceHeight or 58
            local ChoiceGap = 8
            local Key = Step.Id or StepIndex
            for Index, Choice in Step.Choices or {} do
                local Column = (Index - 1) % Columns
                local Row = math.floor((Index - 1) / Columns)
                local Button = New("TextButton", {
                    AutoButtonColor = false,
                    BackgroundColor3 = "MainColor",
                    Position = UDim2.new(Column / Columns, Column * ChoiceGap / Columns + 3 - Column * 6 / Columns, 0, Row * (ChoiceHeight + ChoiceGap) + 3),
                    Size = UDim2.new(1 / Columns, -(Columns - 1) * ChoiceGap / Columns - 6 / Columns, 0, ChoiceHeight),
                    Text = "",
                    ZIndex = 3,
                    Parent = Choices,
                })
                New("UICorner", {
                    CornerRadius = UDim.new(0, 9),
                    Parent = Button,
