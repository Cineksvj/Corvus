    local function PaintTabEntry(Entry, Active)
        if not Entry then
            return
        end

        local WasActive = Entry.Active
        Entry.Active = Active

        if Entry.Tile then
            TweenService:Create(Entry.Tile, Library.TweenInfo, {
                BackgroundTransparency = Active and 0 or 1,
            }):Play()
        end

        if Entry.SpinTween then
            Entry.SpinTween:Cancel()
            Entry.SpinTween = nil
        end
        if Entry.TileGradient then
            Entry.TileGradient.Rotation = 45
            if Active and Library.IconAnimations ~= false then
                Entry.SpinTween = TweenService:Create(Entry.TileGradient, TweenInfo.new(7, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), {
                    Rotation = 405,
                })
                Entry.SpinTween:Play()
            end
        end

        if Active and not WasActive and Entry.Shine and Library.IconAnimations ~= false then
            Entry.Shine.Visible = true
            Entry.ShineGradient.Offset = Vector2.new(-1, 0)
            local Sweep = TweenService:Create(Entry.ShineGradient, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Offset = Vector2.new(1, 0),
            })
            Sweep.Completed:Once(function()
                if Entry.Shine then
                    Entry.Shine.Visible = false
                end
            end)
            Sweep:Play()
        end

        if Entry.PaintHover then
            Entry.PaintHover()
        end

        if Entry.Label then
            Library:SetSchemeProperty(Entry.Label, "TextColor3", Active and "BackgroundColor" or "FontColor", true)
        end

        if Entry.Icon and not Entry.CustomIcon then
            Library:SetSchemeProperty(Entry.Icon, "ImageColor3", Active and "BackgroundColor" or "AccentColor", true)
        end
    end

