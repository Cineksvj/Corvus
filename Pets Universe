local LoopTicks = 0
local function safe(fn, where)
	local ok, err = pcall(fn)
	if not ok then
		pcall(diag, where or "loop", err)
	end
end

task.spawn(function()
	while alive() do
		task.wait(0.5)
		LoopTicks += 1
		pcall(function()
			SessionTimeLabel:SetText(string.format("Session: %s  \u{00B7}  tick %d", Library:FormatDuration(os.clock() - Session.started), LoopTicks))
		end)
		safe(function()
			local bd
			if PlayerData then
				pcall(function() bd = PlayerData.Folder(LocalPlayer, "BreakableData") end)
			end
			local areaVal = bd and bd:FindFirstChild("Area")
			local inArea = bd and bd:FindFirstChild("InArea")
			local autoBreak = bd and bd:FindFirstChild("AutoBreaking")
			local area = areaVal and areaVal.Value ~= "" and areaVal.Value or Stats.lastArea

			if not S.autoFarm then
				FarmStateLabel:SetText('<font transparency="0.5">Idle</font>')
			elseif lockedTarget and lockedTarget.Parent then
				FarmStateLabel:SetText('<font color="#60d696">Firing</font>')
			elseif area == "" then
				FarmStateLabel:SetText('<font color="#ffb84d">Waiting for an area</font>')
			else
				FarmStateLabel:SetText('<font color="#ffb84d">Searching</font>')
			end

			if lockedTarget and lockedTarget.Parent then
				local hp = getBreakableHP(lockedTarget)
				TargetLabel:SetText(string.format("Target: %s  (%s)%s", lockedTarget.Name, getCurrencySafe(lockedTarget), if hp then "  HP " .. formatNumber(hp) else ""))
			else
				TargetLabel:SetText("Target: none")
			end

			local suffix = ""
			if inArea and not inArea.Value then
				suffix = if autoBreak and autoBreak.Value then "  \u{00B7}  auto" else "  \u{00B7}  outside"
			end
			AreaLabel:SetText("Area: " .. (if area ~= "" then area else "unknown") .. suffix)
		end, "farm")

		safe(function()
			local gifts = getGiftStatus()
			if gifts then
				GiftLabel:SetText(string.format("Claimed %d / 9%s", gifts.claimed, if gifts.claimable > 0 then string.format('  \u{00B7}  <font color="#60d696">%d ready</font>', gifts.claimable) else ""))
				if gifts.nextIndex then
					GiftNextLabel:SetText(string.format("Gift %d in %s", gifts.nextIndex, formatTime(gifts.nextLeft)))
				else
					GiftNextLabel:SetText(if gifts.claimed >= 9 then "All gifts claimed" else "")
				end
			else
				GiftLabel:SetText("Waiting for gift data")
			end
		end, "gifts")

		safe(function()
			local party = getPartyStatus()
			if party then
				PartyLabel:SetText(if party.ready then '<font color="#60d696">Ready to claim</font>' .. (if Stats.partyEggs > 0 then "  \u{00B7}  claimed " .. Stats.partyEggs else "") else "Ready in " .. formatTime(party.timeLeft))
			else
				PartyLabel:SetText("Status: unavailable")
			end
		end, "party")

		safe(function()
			local selected = Options.HatchEgg.Value
			S.hatchEggName = if type(selected) == "string" then selected else ""
			HatchLabel:SetText("Eggs opened: " .. tostring(Stats.hatches))
			SelectedEggLabel:SetText("Selected: " .. (if S.hatchEggName ~= "" then S.hatchEggName else "none") .. "  \u{00B7}  " .. S.hatchMode)
		end, "eggs")

		safe(refreshStats, "stats")
	end
end)

