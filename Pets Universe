            local Ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
            if Ctrl and Input.KeyCode == Enum.KeyCode.Backquote then
                Console:Toggle()
                return
            end

            if not Console.Built then
                return
            end

            if (Input.KeyCode == Enum.KeyCode.Up or Input.KeyCode == Enum.KeyCode.Down) and Console.InputBox and Console.InputBox:IsFocused() then
                local History = Console.History
                if #History == 0 then
                    return
                end

                local Step = if Input.KeyCode == Enum.KeyCode.Up then 1 else -1
                Console.HistoryIndex = math.clamp(Console.HistoryIndex + Step, 0, #History)
                local Box = Console.InputBox
                if Box then
                    Box.Text = if Console.HistoryIndex == 0 then "" else History[Console.HistoryIndex]
                    Box.CursorPosition = #Box.Text + 1
                end
            end
        end))

        local function FindElement(Query: string, Kinds: { [string]: boolean }?)
            Query = string.lower(Trim(Query))
            if Query == "" then
                return nil
            end

            local Best, BestScore = nil, 0
            local function Consider(Key, Element)
                if typeof(Element) ~= "table" or (Kinds and not Kinds[Element.Type]) then
                    return
                end

                local Text = string.lower(tostring(Element.Text or ""):gsub("<[^>]+>", ""))
                local KeyText = string.lower(tostring(Key))
                local Score = 0
                if Text == Query or KeyText == Query then
                    Score = 3
                elseif string.sub(Text, 1, #Query) == Query or string.sub(KeyText, 1, #Query) == Query then
                    Score = 2
                elseif string.find(Text, Query, 1, true) or string.find(KeyText, Query, 1, true) then
                    Score = 1
                end
                if Score > BestScore then
                    Best, BestScore = Element, Score
                end
            end

            for Key, Toggle in Library.Toggles do
                Consider(Key, Toggle)
            end
            for Key, Option in Library.Options do
                Consider(Key, Option)
            end
            return Best
        end

