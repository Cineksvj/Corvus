                local Success, Error = RemoteSpy:Repeat(Record, Call)
                Library:Notify({
                    Title = "Remote Spy",
                    Description = if Success then "Sent " .. Record.Name .. " again" else tostring(Error),
                    Time = 3,
                })
            end)
            DecompileButton.MouseButton1Click:Connect(function()
                local Record = Spy.Selected
                local Call = Record and Record.Calls[Spy.SelectedCall]
                if not Call then
                    return
                end
                if Spy.CodeMode == "Decompiled" and Spy.DecompiledFor == Call then
                    Spy.CodeMode = "Code"
                    RenderCode()
                    return
                end

                CodeLabel.Text = "Decompiling\u{2026}"
                task.spawn(function()
                    local Success, Result = RemoteSpy:Decompile(Call)
                    if not Success then
                        Library:Notify({ Title = "Remote Spy", Description = Result, Time = 4 })
                        RenderCode()
                        return
                    end
                    Spy.CodeMode = "Decompiled"
                    Spy.DecompiledFor = Call
                    Spy.DecompiledText = Result
                    Library:CopyToClipboard(Result, "Decompiled script copied")
                    RenderCode()
                end)
            end)
            PathButton.MouseButton1Click:Connect(function()
                if Spy.Selected then
                    Library:CopyToClipboard(Spy.Selected.Path, "Path copied")
                end
            end)
            IgnoreButton.MouseButton1Click:Connect(function()
                if Spy.Selected then
                    Spy.Selected.Ignored = not Spy.Selected.Ignored
                    Render()
                end
            end)
            BlockButton.MouseButton1Click:Connect(function()
                if Spy.Selected then
                    Spy.Selected.Blocked = not Spy.Selected.Blocked
                    Render()
                end
            end)

            RemoteSpy:OnChanged(function()
                Spy.Dirty = true
                if Spy.Tab and Library.ActiveTab == Spy.Tab and Library.Toggled then
                    Render()
                end
            end)

            Render()
        end

        function Window:AddRemoteSpyTab(Info)
            if Spy.Tab then
                return Spy.Tab
            end
            Info = Info or {}

            local Tab = Window:AddTab({
                Name = Info.Name or "Remote Spy",
                Icon = Info.Icon or "radar",
                Description = Info.Description or "Watch remote calls live",
            })
            for _, Side in Tab.Sides do
                Side.Visible = false
            end

            Spy.Tab = Tab
            Window.RemoteSpyTab = Tab
            BuildSpy(Tab.Container)

            local OriginalShow = Tab.Show
            function Tab:Show(...)
                OriginalShow(Tab, ...)
                if Spy.Dirty then
                    Render()
                end
            end

            if Info.AutoStart == true then
                RemoteSpy:Start()
                Render()
            end

            return Tab
        end

        Library:AddCommand({
            Name = "spy",
            Aliases = { "remotes", "rspy", "remotespy" },
            Description = "Opens the Corvus remote spy tab",
            Callback = function()
                if not Window.RemoteSpyTab then
                    Window:AddRemoteSpyTab()
                end
                Window.RemoteSpyTab:Show()
            end,
        })
    end

    Window:SetAlwaysOnTop(WindowInfo.AlwaysOnTop)
