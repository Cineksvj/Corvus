        Library:AddIconHover(Box, RotateHint, { Scale = 1.15, Transparency = 0.1, RestTransparency = 0.6, Press = false })

        local Focus = Vector3.zero
        local Distance = 8
        local Angle = math.rad(Info.Angle or 18)

        local function UpdateCamera()
            Camera.CFrame = CFrame.lookAt(
                Focus + Vector3.new(math.sin(Angle) * Distance, Distance * 0.07, -math.cos(Angle) * Distance),
                Focus
            )
        end

        local function FitCamera()
            if not Card.Model then
                return
            end

            local Success, BoxCFrame, BoxSize = pcall(function()
                return Card.Model:GetBoundingBox()
            end)
            if not Success then
                return
            end

            Focus = BoxCFrame.Position - Vector3.new(0, BoxSize.Y * 0.04, 0)
            local Aspect = math.max(Viewport.AbsoluteSize.X, 1) / math.max(Viewport.AbsoluteSize.Y, 1)
            local Tangent = math.tan(math.rad(Camera.FieldOfView / 2))
            local FitHeight = (BoxSize.Y * 0.5 + 0.45) / Tangent
            local FitWidth = (math.max(BoxSize.X, BoxSize.Z) * 0.5 + 0.45) / (Tangent * Aspect)
            Distance = math.max(FitHeight, FitWidth, 4)
            UpdateCamera()
        end

        local function BuildModel()
            local Character = Target.Character
            if not Character then
                return nil
            end

            local OldArchivable = Character.Archivable
            local Success, Clone = pcall(function()
                Character.Archivable = true
                return Character:Clone()
            end)
            pcall(function()
                Character.Archivable = OldArchivable
            end)

            if not Success or typeof(Clone) ~= "Instance" then
                return nil
            end

            for _, Descendant in Clone:GetDescendants() do
                if
                    Descendant:IsA("LuaSourceContainer")
                    or Descendant:IsA("Sound")
                    or Descendant:IsA("ParticleEmitter")
                    or Descendant:IsA("Trail")
                    or Descendant:IsA("Beam")
                    or Descendant:IsA("ForceField")
                    or Descendant:IsA("BillboardGui")
                    or Descendant:IsA("Highlight")
                    or Descendant:IsA("Tool")
                then
                    Descendant:Destroy()
                elseif Descendant:IsA("BasePart") then
                    Descendant.Anchored = true
                    Descendant.CanCollide = false
                end
            end

            local Humanoid = Clone:FindFirstChildOfClass("Humanoid")
            if Humanoid then
                pcall(function()
                    Humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                    Humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
                end)
            end

            local Root = Clone:FindFirstChild("HumanoidRootPart")
            if Root and Root:IsA("BasePart") then
                Root.Transparency = 1
            end

            pcall(function()
                Clone:PivotTo(CFrame.new())
            end)

            return Clone
        end

        function Card:Refresh()
            if Card.Destroyed then
                return
            end

            if Card.Model then
                Card.Model:Destroy()
                Card.Model = nil
            end

            local Model = if Info.Mode ~= "2D" then BuildModel() else nil
            if Model then
                Model.Parent = Viewport
                Card.Model = Model
                Viewport.Visible = true
                Thumbnail.Visible = false
                FitCamera()
            else
                Viewport.Visible = false
                Thumbnail.Visible = true
            end
        end

        function Card:SetVisible(Visible: boolean)
            Card.Visible = Visible
            Holder.Visible = Visible
            Groupbox:Resize()
        end

        table.insert(Card.Connections, Viewport:GetPropertyChangedSignal("AbsoluteSize"):Connect(FitCamera))

        table.insert(Card.Connections, Box.InputBegan:Connect(function(Input: InputObject)
            if not IsClickInput(Input) then
                return
            end

            Card.Dragging = true
            local LastX = Input.Position.X

            if Groupbox.Tab and Groupbox.Tab.Sides then
                for _, Side in Groupbox.Tab.Sides do
                    Side.ScrollingEnabled = false
                end
            end

            local Moved, Ended
            Moved = UserInputService.InputChanged:Connect(function(Changed: InputObject)
                if Changed.UserInputType == Enum.UserInputType.MouseMovement or Changed.UserInputType == Enum.UserInputType.Touch then
                    local X = Changed.Position.X
                    Angle -= (X - LastX) * 0.012
                    LastX = X
                    UpdateCamera()
                end
            end)
            Ended = UserInputService.InputEnded:Connect(function(Finished: InputObject)
                if Finished.UserInputType ~= Input.UserInputType then
                    return
                end

                Card.Dragging = false
                Moved:Disconnect()
                Ended:Disconnect()

                if Groupbox.Tab and Groupbox.Tab.Sides then
                    for _, Side in Groupbox.Tab.Sides do
                        Side.ScrollingEnabled = true
                    end
                end
            end)
        end))

        table.insert(Card.Connections, RunService.RenderStepped:Connect(function(Delta)
            if not Card.Rotate or Card.Dragging or not Card.Model or not Holder.Visible or not Library.Toggled then
                return
            end
            if Groupbox.Tab and Library.ActiveTab ~= Groupbox.Tab then
                return
            end

            Angle += Delta * 0.55
            UpdateCamera()
        end))

        table.insert(Card.Connections, Target.CharacterAdded:Connect(function()
            task.delay(1.5, function()
                Card:Refresh()
            end)
        end))

        function Card:Destroy()
            Card.Destroyed = true

            for _, Connection in Card.Connections do
                Connection:Disconnect()
            end
            table.clear(Card.Connections)

            CardField:Destroy()
            if Card.Model then
                Card.Model:Destroy()
            end
            Holder:Destroy()

            local ElemIdx = table.find(Groupbox.Elements, Card)
            if ElemIdx then
                table.remove(Groupbox.Elements, ElemIdx)
            end

            Groupbox:Resize()
            if Idx then
                Options[Idx] = nil
            end
        end

        Card.Holder = Holder
        Card:Refresh()
        Groupbox:Resize()
        table.insert(Groupbox.Elements, Card)

        if Idx then
            Options[Idx] = Card
        end

        return Card
    end

