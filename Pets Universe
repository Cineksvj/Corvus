        TextSize = 14,
        TextTransparency = 0.5,
        Visible = false,
        Parent = List,
    })

    local function IsSelected(Value)
        if IsMulti then
            return typeof(Dropdown.Value) == "table" and Dropdown.Value[Value] == true
        end
        return Dropdown.Value == Value
    end

    local function UpdateCount()
        local Total = 0
        local Selected = 0
        for _, Row in Picker.Rows do
            Total += 1
            if IsSelected(Row.Value) then
                Selected += 1
            end
        end
        CountLabel.Text = if IsMulti then string.format("%d / %d", Selected, Total) else string.format("%d items", Total)
    end

    local function PaintRow(Row, Animate)
        local Selected = IsSelected(Row.Value)
        Row.Selected = Selected

        Library:SetSchemeProperty(Row.Label, "TextColor3", if Selected then "AccentColor" else "FontColor", Animate)
        Row.Label.TextTransparency = if Row.Disabled then 0.8 elseif Selected then 0 else 0.3
        Row.Button.BackgroundTransparency = if Selected or Row.Hovering then 0 else 1
        Row.Check.Visible = Selected

        if Selected and Animate and Library.IconAnimations ~= false then
            Row.CheckScale.Scale = 0.4
            TweenService:Create(Row.CheckScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Scale = 1,
            }):Play()
        end
    end

    local function RepaintAll(Animate)
        for _, Row in Picker.Rows do
            PaintRow(Row, Animate)
        end
        UpdateCount()
    end

    local function Select(Row)
        if Row.Disabled or Picker.Closed then
            return
        end

        if IsMulti then
            local NewValue = {}
            for Key, Active in Dropdown.Value or {} do
                if Active then
                    NewValue[Key] = true
                end
            end
            NewValue[Row.Value] = if NewValue[Row.Value] then nil else true
            Dropdown:SetValue(NewValue)
            RepaintAll(true)
            return
        end

        if Dropdown.Value == Row.Value and Dropdown.AllowNull then
            Dropdown:SetValue(nil)
        else
            Dropdown:SetValue(Row.Value)
        end

        RepaintAll(true)
        task.delay(0.12, function()
            Picker:Close()
        end)
    end

    local Values = Dropdown.Values or {}
    local IsDictionary = not IsSequentialArray(Values)
    local DisabledValues = Dropdown.DisabledValues or {}
    local Entries = {}

    for Key, RawValue in Values do
        local Value = if IsDictionary then Key else RawValue
        local Display = RawValue
        if Dropdown.FormatListValue then
            local Success, Formatted = pcall(Dropdown.FormatListValue, RawValue)
            if Success and Formatted ~= nil then
                Display = Formatted
            end
        end

        table.insert(Entries, {
            Value = Value,
            Display = tostring(Display),
            SortKey = Key,
            Disabled = table.find(DisabledValues, Value) ~= nil or (RawValue ~= Value and table.find(DisabledValues, RawValue) ~= nil),
        })
    end

    if not IsDictionary then
        table.sort(Entries, function(A, B)
            return A.SortKey < B.SortKey
        end)
    end

    for Index, Entry in Entries do
        local Button = New("TextButton", {
            BackgroundColor3 = "MainColor",
