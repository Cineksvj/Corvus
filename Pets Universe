        local function GetVisibleRemotes()
            local Query = string.lower(Trim(Spy.Filter))
            local List = {}
            for _, Record in RemoteSpy.Order do
                if Query == "" or string.find(string.lower(Record.Name), Query, 1, true) or string.find(string.lower(Record.Path), Query, 1, true) then
                    table.insert(List, Record)
                end
            end
            return List
        end

        local function RenderCode()
            local Record = Spy.Selected
            local Call = Record and Record.Calls[Spy.SelectedCall]
            if Spy.CodeMode == "Decompiled" and Call and Spy.DecompiledFor == Call then
                CodeLabel.Text = EscapeRich(Spy.DecompiledText or "")
                CodeLabel.TextTransparency = 0.05
                return
            end
            Spy.CodeMode = "Code"
            if not Call then
                CodeLabel.Text = if Record then "No calls logged for this remote." else "Select a remote to see its generated code."
                CodeLabel.TextTransparency = 0.5
                return
            end

            CodeLabel.Text = EscapeRich(RemoteSpy.GetCode(Record, Call))
            CodeLabel.TextTransparency = 0.05
        end

        local function RenderCalls()
            local Record = Spy.Selected
            local Calls = if Record then Record.Calls else {}

            CallTitle.Text = if Record then string.format("CALLS  \u{00B7}  %s", string.upper(Record.Name)) else "CALLS"
            CallEmpty.Visible = #Calls == 0
            CallEmpty.Text = if Record then (if Record.Ignored then "This remote is ignored." else "No calls yet.") else "Select a remote on the left."
            CallList.CanvasSize = UDim2.fromOffset(0, #Calls * CallHeight + 8)

            local Scale = math.max(Library.DPIScale, 0.01)
            local First = math.max(0, math.floor(CallList.CanvasPosition.Y / Scale / CallHeight) - 1)
            for Index, Row in Spy.CallRows do
                local DataIndex = First + Index
                local Call = Calls[DataIndex]
                Row.Button.Visible = Call ~= nil
                Row.Index = DataIndex

                if Call then
                    local Selected = DataIndex == Spy.SelectedCall
                    Row.Button.Position = UDim2.fromOffset(4, (DataIndex - 1) * CallHeight + 4)
                    Row.Button.BackgroundTransparency = if Selected then 0 else 1
                    Row.Bar.Visible = Selected

                    local MethodColor = if Call.Direction == "Incoming" then GetSecondaryAccent() else Library.Scheme.AccentColor
                    local ScriptName = if typeof(Call.Script) == "Instance" then Call.Script.Name else nil
                    Row.Head.Text = string.format('<font transparency="0.5">%s</font>  <font color="#%s">%s</font>%s%s',
                        Call.Time,
                        MethodColor:ToHex(),
                        Call.Method,
                        if Call.FromExecutor then '  <font transparency="0.5">executor</font>' else "",
                        if ScriptName then string.format('  <font transparency="0.5">%s</font>', EscapeRich(ScriptName)) else ""
                    )
                    Row.Preview.Text = EscapeRich(Call.Preview)
                end
            end

            local Blocked = Record and Record.Blocked
            local Ignored = Record and Record.Ignored
            if ActionButtons.BlockLabel then
                ActionButtons.BlockLabel.Text = if Blocked then "Unblock" else "Block"
                Library:SetSchemeProperty(ActionButtons.BlockLabel, "TextColor3", if Blocked then "RedColor" else "FontColor")
            end
            if ActionButtons.IgnoreLabel then
                ActionButtons.IgnoreLabel.Text = if Ignored then "Unignore" else "Ignore"
            end

            RenderCode()
        end

        local function RenderRemotes()
            local List = GetVisibleRemotes()
            Spy.Visible = List

            RemoteCount.Text = tostring(#List)
            RemoteList.CanvasSize = UDim2.fromOffset(0, #List * RemoteHeight + 8)

            if #List == 0 then
                RemoteEmpty.Visible = true
                if not RemoteSpy:Supported() then
                    RemoteEmpty.Text = "Your executor cannot hook remotes."
                elseif not RemoteSpy.Enabled then
                    RemoteEmpty.Text = "Press Start to watch remote calls."
                elseif Spy.Filter ~= "" then
                    RemoteEmpty.Text = "No remote matches the filter."
                else
                    RemoteEmpty.Text = "Waiting for remote calls\u{2026}"
                end
            else
                RemoteEmpty.Visible = false
            end

            local Scale = math.max(Library.DPIScale, 0.01)
            local First = math.max(0, math.floor(RemoteList.CanvasPosition.Y / Scale / RemoteHeight) - 1)
            for Index, Row in Spy.RemoteRows do
                local DataIndex = First + Index
                local Record = List[DataIndex]
                Row.Record = Record
                Row.Button.Visible = Record ~= nil

                if Record then
                    local Selected = Record == Spy.Selected
                    Row.Button.Position = UDim2.fromOffset(4, (DataIndex - 1) * RemoteHeight + 4)
                    Row.Button.BackgroundTransparency = if Selected then 0 else 1
                    Row.Bar.Visible = Selected

                    local IconName = if Record.ClassName == "RemoteFunction" then "arrow-left-right" elseif Record.Outgoing == 0 and Record.Incoming > 0 then "arrow-down-left" else "arrow-up-right"
                    if Row.IconName ~= IconName then
                        Row.IconName = IconName
                        local IconData = Library:GetIcon(IconName)
                        if IconData then
                            Library:ApplyLucideIcon(Row.Icon, IconData)
                        end
                    end
                    Library:SetSchemeProperty(Row.Icon, "ImageColor3", if Record.Outgoing == 0 and Record.Incoming > 0 then function()
                        return GetSecondaryAccent()
                    end else "AccentColor")

                    Row.Name.Text = EscapeRich(Record.Name)
                    Row.Name.TextTransparency = if Record.Ignored then 0.55 else 0
                    Row.Path.Text = EscapeRich(Record.Path)

                    if Record.Blocked then
                        Row.Count.Text = "BLOCKED"
                        Library:SetSchemeProperty(Row.Count, "TextColor3", "RedColor")
                    elseif Record.Ignored then
                        Row.Count.Text = "IGNORED"
                        Library:SetSchemeProperty(Row.Count, "TextColor3", "FontColor")
                    else
                        Row.Count.Text = if Record.Count > 999 then "999+" else tostring(Record.Count)
                        Library:SetSchemeProperty(Row.Count, "TextColor3", "AccentColor")
                    end
                end
            end
        end

        local function RenderStatus()
            if RemoteSpy.Enabled then
                StatusLabel.Text = string.format("%s  \u{00B7}  %d calls  \u{00B7}  %d remotes", if RemoteSpy.Paused then "Paused" else "Watching", RemoteSpy.TotalCalls, #RemoteSpy.Order)
                StartLabel.Text = "Stop"
            else
                StatusLabel.Text = if RemoteSpy:Supported() then "Idle" else "Hooks not supported"
                StartLabel.Text = "Start"
            end
            PauseButton.Visible = RemoteSpy.Enabled
            PauseLabel.Text = if RemoteSpy.Paused then "Resume" else "Pause"

            for Key, Chip in Chips do
                local On = RemoteSpy[Key] == true
                Library:SetSchemeProperty(Chip.Button, "BackgroundColor3", if On then "AccentColor" else "MainColor", true)
                Library:SetSchemeProperty(Chip.Label, "TextColor3", if On then "BackgroundColor" else "FontColor", true)
            end
        end

        local function Render()
            if not Spy.Built then
                return
            end
            Spy.Dirty = false
            RenderStatus()
            RenderRemotes()
            RenderCalls()
        end
        Spy.Render = Render

