    Library.Floats = nil
    Library.Overlay = nil
    Library.WindowContainer = nil
    Library.KeybindFrame = nil
    Library.KeybindContainer = nil

    if Library.ActivePicker then
        pcall(function()
            Library.ActivePicker:Close(true)
        end)
    end
    Library.NotificationCenter = nil
    Library.ActivePicker = nil
    table.clear(Library.NotificationHistory)
