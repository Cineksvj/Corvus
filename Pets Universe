local Suffixes = { "", "k", "m", "b", "t", "Qd", "Qn", "sx", "Sp", "Oc", "No" }
local function formatNumber(n)
	n = tonumber(n) or 0
	if n < 0 then return "-" .. formatNumber(-n) end
	for i = 1, #Suffixes do
		if n < 10 ^ (i * 3) then
			return tostring(math.floor(n / (10 ^ ((i - 1) * 3) / 10)) / 10) .. Suffixes[i]
		end
	end
	return string.format("%.1e", n)
end

