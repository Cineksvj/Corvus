local function recordHatch(list)
	if type(list) ~= "table" then return end
	for _, pet in ipairs(list) do
		local name = type(pet) == "table" and pet.Name or (type(pet) == "string" and pet) or nil
		if name then
			local rarity = type(pet) == "table" and pet.Rarity or nil
			if not rarity and PetDisplay and PetDisplay.GetRarity then
				local ok, r = pcall(PetDisplay.GetRarity, name)
				if ok then rarity = r end
			end
			rarity = rarity or "Basic"
			Session.rarityCounts[rarity] = (Session.rarityCounts[rarity] or 0) + 1
			local rank = RarityRank[rarity] or 0
			local entry = Session.hatched[name]
			if entry then
				entry.count += 1
			else
				entry = { name = name, rarity = rarity, rank = rank, count = 1, at = os.clock() }
				Session.hatched[name] = entry
				table.insert(Session.best, entry)
				table.sort(Session.best, function(a, b)
					if a.rank ~= b.rank then return a.rank > b.rank end
					return a.at > b.at
				end)
			end
			if rank >= 5 then
