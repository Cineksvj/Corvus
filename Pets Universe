        local function FooterButton(Text: string, Kind: string, Anchor: number, X: number, ButtonWidth: number)
            local Primary = Kind == "Primary"
            local Button = New("TextButton", {
                AnchorPoint = Vector2.new(Anchor, 0.5),
                BackgroundColor3 = if Primary then "AccentColor" elseif Kind == "Ghost" then "BackgroundColor" else "MainColor",
