function Library:AddHoverStroke(Target: GuiObject, Stroke: UIStroke, IsLocked: (() -> boolean)?, IsDisabled: (() -> boolean)?)
    if not (Target and Stroke) then
        return nil
    end

    local Hovering = false
    local function Refresh()
        if Library.Unloaded or not Stroke.Parent then
            return
        end

        local Active = (Hovering or (IsLocked ~= nil and IsLocked() == true)) and not (IsDisabled ~= nil and IsDisabled() == true)
        Library:SetSchemeProperty(Stroke, "Color", if Active then "AccentColor" else "OutlineColor", true)
    end

    Target.MouseEnter:Connect(function()
        Hovering = true
        Refresh()
    end)
    Target.MouseLeave:Connect(function()
        Hovering = false
        Refresh()
    end)

    return Refresh
end

function Library:SetSchemeProperty(Inst: Instance, Property: string, Key: any, UseTween: boolean?)
    if not Inst then
        return
    end

    local Properties = Library.Registry[Inst]
    if not Properties then
        Properties = {}
        Library.Registry[Inst] = Properties
    end
    Properties[Property] = Key

    local Value = GetSchemeValue(Key)
    if Value == nil and typeof(Key) == "function" then
        Value = Key()
    end
    if Value == nil then
        return
    end

    if UseTween then
        TweenService:Create(Inst, Library.TweenInfo, { [Property] = Value }):Play()
    else
        Inst[Property] = Value
    end
end

function Library:AddIconHover(Target: GuiObject, Icon: GuiObject, Options: { [string]: any }?)
    if not (Target and Icon) then
        return nil
    end

    Options = Options or {}

    local IconScale = Icon:FindFirstChildOfClass("UIScale")
    if not IconScale then
        IconScale = New("UIScale", {
            Parent = Icon,
        })
    end

    local Hover = {
        Hovering = false,
        Connections = {},
        Scale = IconScale,
    }

    local HoverScale = Options.Scale or 1.15
    local PressScale = Options.PressScale or 0.88
    local BaseRotation = Options.BaseRotation or Icon.Rotation
    local EnterInfo = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    local LeaveInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local MotionToken = 0

    local function IsEnabled()
        return Library.IconAnimations ~= false and not Library.Unloaded
    end

    local function RestTransparency()
        local Rest = Options.RestTransparency
        if typeof(Rest) == "function" then
            return Rest()
        end
        return Rest
    end

    local function PlayWiggle()
        MotionToken += 1
        local Token = MotionToken

        task.spawn(function()
            for _, Angle in { -16, 13, -9, 5, 0 } do
                if Token ~= MotionToken or not Icon.Parent then
                    return
                end

                TweenService:Create(Icon, TweenInfo.new(0.07, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                    Rotation = BaseRotation + Angle,
                }):Play()
                task.wait(0.07)
            end
        end)
    end

    local function PlaySpin()
        MotionToken += 1
        local Token = MotionToken

        Icon.Rotation = BaseRotation
        local Tween = TweenService:Create(Icon, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Rotation = BaseRotation + (Options.Spin or 360),
        })
        Tween.Completed:Once(function()
            if Token == MotionToken and Icon.Parent then
                Icon.Rotation = BaseRotation
            end
        end)
        Tween:Play()
    end

    table.insert(Hover.Connections, Target.MouseEnter:Connect(function()
        Hover.Hovering = true
        if not IsEnabled() then
            return
        end

        TweenService:Create(IconScale, EnterInfo, { Scale = HoverScale }):Play()

        if Options.Wiggle then
            PlayWiggle()
        elseif Options.Spin then
            PlaySpin()
        elseif Options.Tilt then
            TweenService:Create(Icon, EnterInfo, { Rotation = BaseRotation + Options.Tilt }):Play()
        end

        if Options.Transparency ~= nil then
            TweenService:Create(Icon, Library.TweenInfo, { ImageTransparency = Options.Transparency }):Play()
        end
    end))

    table.insert(Hover.Connections, Target.MouseLeave:Connect(function()
        Hover.Hovering = false
        if Library.Unloaded then
            return
        end

        TweenService:Create(IconScale, LeaveInfo, { Scale = 1 }):Play()

        if Options.Tilt then
            TweenService:Create(Icon, LeaveInfo, { Rotation = BaseRotation }):Play()
        end

        local Rest = RestTransparency()
        if Options.Transparency ~= nil and Rest ~= nil then
            TweenService:Create(Icon, Library.TweenInfo, { ImageTransparency = Rest }):Play()
        end
    end))

    if Options.Press ~= false and Target:IsA("GuiButton") then
        table.insert(Hover.Connections, Target.MouseButton1Down:Connect(function()
            if not IsEnabled() then
