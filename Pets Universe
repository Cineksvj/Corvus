            local Data = HttpRequestJSON(string.format("https://discord.com/api/v10/invites/%s?with_counts=true", Card.Code))
            if typeof(Data) ~= "table" or Card.Destroyed or Library.Unloaded then
                return false
            end

            local Guild = typeof(Data.guild) == "table" and Data.guild or nil
            if Info.AutoFetch ~= false and Guild then
                if not HasCustomTitle and typeof(Guild.name) == "string" then
                    Card:SetTitle(Guild.name)
                end

                if not HasCustomDescription and typeof(Guild.description) == "string" and Guild.description ~= "" then
                    Card:SetDescription(Guild.description)
                end

                if Info.Avatar == nil and Guild.id and Guild.icon then
                    Card:SetAvatar(string.format("https://cdn.discordapp.com/icons/%s/%s.png?size=128", tostring(Guild.id), tostring(Guild.icon)))
                end

                if Info.Banner == nil and Guild.id then
                    if Guild.banner then
                        Card:SetBanner(string.format("https://cdn.discordapp.com/banners/%s/%s.png?size=512", tostring(Guild.id), tostring(Guild.banner)))
                    elseif Guild.splash then
                        Card:SetBanner(string.format("https://cdn.discordapp.com/splashes/%s/%s.png?size=512", tostring(Guild.id), tostring(Guild.splash)))
                    end
                end
            end

            if Info.ShowCounts ~= false then
                Card:SetCounts(Data.approximate_presence_count, Data.approximate_member_count)
            end

            return true
        end

