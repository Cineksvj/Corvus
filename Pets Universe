function Library:GetTextBounds(Text: string, Font: Font, Size: number, Width: number?): (number, number)
    local Scale = Library.DPIScale
    local Success, Bounds = pcall(function()
        local Params = CreateInstance("GetTextBoundsParams")
        Params.Text = Text
        Params.RichText = true
        Params.Font = Font
        Params.Size = Size * Scale
        if Width then
            Params.Width = Width * Scale
        else
            Params.Width = workspace.CurrentCamera.ViewportSize.X - 32
        end
        return TextService:GetTextBoundsAsync(Params)
    end)

    if not Success or typeof(Bounds) ~= "Vector2" then
        local Plain = string.gsub(tostring(Text), "<[^>]+>", "")
        local Estimated = #Plain * Size * 0.55
        local MaxWidth = Width or (workspace.CurrentCamera.ViewportSize.X - 32)
        local Lines = math.max(1, math.ceil(Estimated / math.max(MaxWidth, 1)))
        return math.ceil(math.min(Estimated, MaxWidth)), math.ceil(Lines * Size * 1.2)
    end

    return math.ceil(Bounds.X / Scale), math.ceil(Bounds.Y / Scale)
end

function Library:MouseIsOverFrame(Frame: GuiObject, Mouse: Vector2): boolean
