local StatsErrorShown = false
local function refreshStats()
	for _, name in ipairs({ "Coins", "Rubies", "Gems" }) do
		local ok, err = pcall(function()
			local value = getStat(name)
			if value == nil then
				BalanceRows[name]:SetValue("?")
				return
			end
			if Session.start[name] == nil then
				Session.start[name] = value
			end
			local gained = value - Session.start[name]
			CurrencyRows[name]:SetValue((if gained >= 0 then "+" else "") .. formatNumber(gained))
			BalanceRows[name]:SetValue(formatNumber(value))
		end)
		if not ok then
			diag("stats " .. name, err)
		end
	end

	pcall(function()
		local totalEggs = getEggsOpenedTotal()
		if Session.start.Eggs == nil then
			Session.start.Eggs = totalEggs
		end
		Session.eggsOpened = math.max(totalEggs - Session.start.Eggs, 0)
		EggsSessionRow:SetValue(formatNumber(Session.eggsOpened))
		EggsTotalRow:SetValue(formatNumber(totalEggs))
	end)

	for rarity, row in pairs(RarityRows) do
		local count = Session.rarityCounts[rarity] or 0
		row:SetValue(tostring(count))
		if count > 0 and not row.Visible then
			row:SetVisible(true)
		end
	end

	BestEmpty:SetVisible(#Session.best == 0)
	for i, row in ipairs(BestRows) do
		local entry = Session.best[i]
		if entry then
			if row.IconName ~= entry.name then
				row.IconName = entry.name
				local icon = nil
				if PetDisplay and PetDisplay.GetIcon then
					local ok, result = pcall(PetDisplay.GetIcon, entry.name)
					if ok then icon = result end
				end
				pcall(row.SetIcon, row, if type(icon) == "string" and icon ~= "" then icon else nil)
			end
			row:SetText(string.format('%s  <font color="%s">%s</font>', entry.name, RarityColors[entry.rarity] or "#ffffff", entry.rarity))
			row:SetValue("x" .. entry.count)
			if not row.Visible then
				row:SetVisible(true)
			end
		elseif row.Visible then
			row:SetVisible(false)
		end
	end

end

