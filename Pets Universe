function Library:GetThemeNames(): { string }
    local Names = {}
    for Name in Library.CorvusThemes do
        table.insert(Names, Name)
    end
    table.sort(Names, function(A, B)
        return Library.CorvusThemes[A][1] < Library.CorvusThemes[B][1]
    end)
    return Names
end

function Library:SetTheme(Theme: any): boolean
    local Data = Theme
    if typeof(Theme) == "string" then
        local Entry = Library.CorvusThemes[Theme]
        Data = Entry and Entry[2]
    end
    if typeof(Data) ~= "table" then
        return false
    end

    for _, Key in { "FontColor", "MainColor", "AccentColor", "BackgroundColor", "OutlineColor" } do
        local Value = Data[Key]
        if typeof(Value) == "string" then
            local Success, Color = pcall(Color3.fromHex, Value)
            Value = if Success then Color else nil
        end

        if typeof(Value) == "Color3" then
            Library.Scheme[Key] = Value

            local Option = Library.Options[Key]
            if Option and Option.Type == "ColorPicker" and Option.SetValueRGB then
                pcall(Option.SetValueRGB, Option, Value)
            end
        end
    end

    Library:UpdateColorsUsingRegistry()
    return true
end

local Performance = {
    FPS = 60,
    Ping = 0,
    Frames = 0,
    Elapsed = 0,
    Connection = nil,
    Listeners = {},
}

local function ReadPing(): number
    local Success, Value = pcall(function()
        local StatsService = game:GetService("Stats")
        return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if Success and typeof(Value) == "number" and Value > 0 then
        return Value
    end

    local PingSuccess, NetworkPing = pcall(function()
        return LocalPlayer:GetNetworkPing()
    end)
    if PingSuccess and typeof(NetworkPing) == "number" then
        return NetworkPing * 2000
    end

    return 0
end

function Library:GetPerformance(): (number, number)
    if not Performance.Connection then
        Performance.Connection = RunService.RenderStepped:Connect(function(Delta)
            Performance.Frames += 1
            Performance.Elapsed += Delta
            if Performance.Elapsed < 0.5 then
                return
            end

            Performance.FPS = math.floor(Performance.Frames / Performance.Elapsed + 0.5)
            Performance.Ping = math.floor(ReadPing() + 0.5)
            Performance.Frames = 0
            Performance.Elapsed = 0

            for _, Listener in Performance.Listeners do
                task.spawn(Listener, Performance.FPS, Performance.Ping)
            end
        end)
        Library:GiveSignal(Performance.Connection)
    end

    return Performance.FPS, Performance.Ping
end

function Library:OnPerformance(Callback: (number, number) -> ())
    Library:GetPerformance()
    table.insert(Performance.Listeners, Callback)
    return function()
        local Index = table.find(Performance.Listeners, Callback)
        if Index then
            table.remove(Performance.Listeners, Index)
        end
    end
end

function Library:FormatDuration(Seconds: number): string
    Seconds = math.max(0, math.floor(tonumber(Seconds) or 0))
    local Hours = math.floor(Seconds / 3600)
    local Minutes = math.floor(Seconds / 60) % 60
    local Secs = Seconds % 60
    if Hours > 0 then
        return string.format("%dh %02dm %02ds", Hours, Minutes, Secs)
    end
    return string.format("%dm %02ds", Minutes, Secs)
end

function Library:CreateStarfield(Parent: GuiObject, Options: { [string]: any }?)
    local Config = Options or {}
    local Rng = Random.new(Config.Seed or 7)
    local BaseZ = Config.ZIndex or 0

    local Field = {
        Enabled = true,
        Active = true,
        Destroyed = false,
        Tweens = {},
        Connections = {},
    }

    local Frame = New("Frame", {
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        Name = "Starfield",
        Size = UDim2.fromScale(1, 1),
        ZIndex = BaseZ,
        Parent = Parent,
    })
    if Config.CornerRadius then
        New("UICorner", {
            CornerRadius = UDim.new(0, Config.CornerRadius),
            Parent = Frame,
        })
    end
    Field.Frame = Frame

    local function Band(Rotation: number, Offset: Vector2, Peak: number, Width: number)
        local BandFrame = New("Frame", {
            BackgroundColor3 = "WhiteColor",
            Size = UDim2.fromScale(1, 1),
            ZIndex = BaseZ,
            Parent = Frame,
        })
        New("UIGradient", {
            Color = GetNebulaSequence,
            Offset = Offset,
            Rotation = Rotation,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.5 - Width, 1),
                NumberSequenceKeypoint.new(0.5, Peak),
                NumberSequenceKeypoint.new(0.5 + Width, 1),
                NumberSequenceKeypoint.new(1, 1),
            }),
            Parent = BandFrame,
        })
    end
    Band(28, Vector2.new(0.1, -0.05), Config.NebulaPeak or 0.9, 0.3)
    Band(-22, Vector2.new(-0.25, 0.15), math.min(1, (Config.NebulaPeak or 0.9) + 0.04), 0.2)

    local Layers = {}
    for Index, Depth in { 5, 12 } do
        Layers[Index] = {
            Depth = Depth,
            Frame = New("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                ZIndex = BaseZ,
                Parent = Frame,
            }),
        }
    end

    local Stars = {}
    for _ = 1, Config.Count or 64 do
        local Near = Rng:NextNumber() < 0.28
        local Size = if Near then Rng:NextInteger(2, 3) else Rng:NextInteger(1, 2)
        local Base = if Near then Rng:NextNumber(0.05, 0.35) else Rng:NextNumber(0.35, 0.7)
        local Tinted = Rng:NextNumber() < 0.3

        local Star = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = if Tinted
                then function()
                    return Color3.new(1, 1, 1):Lerp(Library.Scheme.AccentColor, 0.45)
                end
                else Color3.new(1, 1, 1),
            BackgroundTransparency = Base,
            Position = UDim2.fromScale(Rng:NextNumber(0.015, 0.985), Rng:NextNumber(0.02, 0.98)),
            Size = UDim2.fromOffset(Size, Size),
            ZIndex = BaseZ,
            Parent = Layers[if Near then 2 else 1].Frame,
        })
        if Size > 1 then
            New("UICorner", {
                CornerRadius = UDim.new(1, 0),
                Parent = Star,
            })
        end

        table.insert(Stars, {
            Star = Star,
            Base = Base,
            Twinkle = Rng:NextNumber() < 0.55,
            Duration = Rng:NextNumber(1.1, 3.4),
            Delay = Rng:NextNumber(0, 2.5),
        })
    end

    local Sparkles = {}
    for _ = 1, Config.Sparkles or 3 do
        local Holder = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundTransparency = 1,
            Position = UDim2.fromScale(Rng:NextNumber(0.08, 0.92), Rng:NextNumber(0.1, 0.9)),
            Size = UDim2.fromOffset(11, 11),
            ZIndex = BaseZ,
            Parent = Layers[2].Frame,
        })
        for _, Horizontal in { true, false } do
            local Ray = New("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundColor3 = "WhiteColor",
                Position = UDim2.fromScale(0.5, 0.5),
                Size = if Horizontal then UDim2.new(1, 0, 0, 1) else UDim2.new(0, 1, 1, 0),
                ZIndex = BaseZ,
                Parent = Holder,
            })
            New("UIGradient", {
                Rotation = if Horizontal then 0 else 90,
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 1),
                    NumberSequenceKeypoint.new(0.5, 0),
                    NumberSequenceKeypoint.new(1, 1),
                }),
                Parent = Ray,
            })
        end
        local Core = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = "WhiteColor",
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(3, 3),
            ZIndex = BaseZ,
            Parent = Holder,
        })
        New("UICorner", {
            CornerRadius = UDim.new(1, 0),
            Parent = Core,
        })

        table.insert(Sparkles, {
            Scale = New("UIScale", {
                Parent = Holder,
            }),
            Duration = Rng:NextNumber(1.6, 2.8),
            Delay = Rng:NextNumber(0, 1.5),
        })
    end

    local function StopTweens()
        for _, Tween in Field.Tweens do
            Tween:Cancel()
        end
        table.clear(Field.Tweens)

        for _, Data in Stars do
            Data.Star.BackgroundTransparency = Data.Base
        end
        for _, Data in Sparkles do
            Data.Scale.Scale = 1
        end
    end

    local function StartTweens()
        if #Field.Tweens > 0 then
            return
        end

        for _, Data in Stars do
            if Data.Twinkle then
                local Tween = TweenService:Create(Data.Star, TweenInfo.new(Data.Duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, Data.Delay), {
                    BackgroundTransparency = math.min(1, Data.Base + 0.55),
                })
                Tween:Play()
                table.insert(Field.Tweens, Tween)
            end
        end

        for _, Data in Sparkles do
            local Tween = TweenService:Create(Data.Scale, TweenInfo.new(Data.Duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, Data.Delay), {
                Scale = 0.35,
            })
            Tween:Play()
            table.insert(Field.Tweens, Tween)
        end
    end

    function Field:Refresh()
        if Field.Destroyed then
            return
        end

        local Running = Field.Enabled and Field.Active
        Frame.Visible = Running

        if Running and Library.IconAnimations ~= false then
            StartTweens()
        else
            StopTweens()
        end
    end

    function Field:SetEnabled(Enabled: boolean)
        Field.Enabled = Enabled ~= false
        Field:Refresh()
    end

    function Field:SetActive(Active: boolean)
        Field.Active = Active ~= false
        Field:Refresh()
    end

    function Field:Shoot()
        if Field.Destroyed then
            return
        end

        local Angle = math.rad(Rng:NextNumber(16, 34))
        local Travel = Rng:NextInteger(200, 340)
        local Length = Rng:NextInteger(90, 160)
        local Duration = Rng:NextNumber(0.75, 1.1)
        local StartX, StartY = Rng:NextNumber(0.02, 0.7), Rng:NextNumber(0.0, 0.4)

        local Streak = New("Frame", {
            AnchorPoint = Vector2.new(1, 0.5),
            BackgroundColor3 = "WhiteColor",
            BackgroundTransparency = 0,
            Position = UDim2.fromScale(StartX, StartY),
            Rotation = math.deg(Angle),
            Size = UDim2.fromOffset(Length, 2),
            ZIndex = BaseZ,
            Parent = Frame,
        })
        New("UICorner", {
            CornerRadius = UDim.new(1, 0),
            Parent = Streak,
        })
        New("UIGradient", {
            Color = function()
                return ColorSequence.new({
                    ColorSequenceKeypoint.new(0, GetSecondaryAccent()),
                    ColorSequenceKeypoint.new(0.7, Library.Scheme.AccentColor),
                    ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1)),
                })
            end,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.6, 0.6),
                NumberSequenceKeypoint.new(0.92, 0.15),
                NumberSequenceKeypoint.new(1, 0),
            }),
            Parent = Streak,
        })

        local Head = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = "WhiteColor",
            Position = UDim2.fromScale(1, 0.5),
            Size = UDim2.fromOffset(4, 4),
            ZIndex = BaseZ,
            Parent = Streak,
        })
        New("UICorner", {
            CornerRadius = UDim.new(1, 0),
            Parent = Head,
        })
        local Glow = New("UIStroke", {
            Color = "AccentColor",
            Thickness = 3,
            Transparency = 0.55,
            Parent = Head,
        })

        local Info = TweenInfo.new(Duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local Tween = TweenService:Create(Streak, Info, {
            Position = UDim2.new(StartX, math.cos(Angle) * Travel, StartY, math.sin(Angle) * Travel),
            BackgroundTransparency = 1,
        })
        TweenService:Create(Head, Info, { BackgroundTransparency = 1 }):Play()
        TweenService:Create(Glow, Info, { Transparency = 1 }):Play()
        Tween.Completed:Once(function()
            Streak:Destroy()
        end)
        Tween:Play()
    end

    if Config.Parallax ~= false then
        local Offset = Vector2.zero
        table.insert(Field.Connections, RunService.RenderStepped:Connect(function(Delta)
            if Field.Destroyed or not (Field.Enabled and Field.Active) then
                return
            end

            local Size = Frame.AbsoluteSize
            if Size.X < 1 or Size.Y < 1 then
                return
            end

            local Center = Frame.AbsolutePosition + Size / 2
            local Target = Vector2.new(
                math.clamp((Mouse.X - Center.X) / Size.X, -0.6, 0.6),
                math.clamp((Mouse.Y - Center.Y) / Size.Y, -0.6, 0.6)
            )
            Offset = Offset:Lerp(Target, math.clamp(Delta * 4, 0, 1))

            for _, Layer in Layers do
                Layer.Frame.Position = UDim2.fromOffset(-Offset.X * Layer.Depth, -Offset.Y * Layer.Depth)
            end
        end))
    end

    if Config.ShootingStars ~= false then
        task.spawn(function()
            while not Field.Destroyed and not Library.Unloaded do
                task.wait(Rng:NextNumber(Config.ShootingMin or 2.5, Config.ShootingMax or 6))
                if Field.Destroyed or Library.Unloaded then
                    break
                end

                if Field.Enabled and Field.Active and Library.IconAnimations ~= false and Frame.AbsoluteSize.X > 80 then
                    Field:Shoot()
                    if Rng:NextNumber() < (Config.BurstChance or 0.22) then
                        for _ = 1, Rng:NextInteger(1, 3) do
                            task.wait(Rng:NextNumber(0.12, 0.3))
                            if Field.Destroyed or not (Field.Enabled and Field.Active) then
                                break
                            end
                            Field:Shoot()
                        end
                    end
                end
            end
        end)
    end

    function Field:Destroy()
        if Field.Destroyed then
            return
        end

        StopTweens()
        Field.Destroyed = true
        for _, Connection in Field.Connections do
            Connection:Disconnect()
        end
        table.clear(Field.Connections)
        Frame:Destroy()
    end

    Field:Refresh()
    return Field
end

