local function SplitWords(Text: string): { string }
    local Words = {}
    for Word in string.gmatch(tostring(Text), "%S+") do
        table.insert(Words, Word)
    end
    return Words
end

local function FireCommandListeners()
    for _, Listener in CommandRegistry.Listeners do
        task.spawn(Listener)
    end
end

function Library:OnCommandsChanged(Callback: () -> ())
    table.insert(CommandRegistry.Listeners, Callback)
end

function Library:ConsoleLog(Text: any, Kind: string?)
    local Entry = {
        Text = tostring(Text),
        Kind = Kind or "info",
        Time = os.date("%H:%M:%S"),
    }
    table.insert(ConsoleLines, Entry)
    if #ConsoleLines > 150 then
        table.remove(ConsoleLines, 1)
    end

    for _, Sink in ConsoleSinks do
        task.spawn(Sink, Entry)
    end
    return Entry
end

function Library:GetConsoleLines(): { any }
    return ConsoleLines
end

function Library:OnConsoleLog(Callback: (any) -> ())
    table.insert(ConsoleSinks, Callback)
end

function Library:ClearConsole()
    table.clear(ConsoleLines)
    for _, Sink in ConsoleSinks do
        task.spawn(Sink, nil)
    end
end

function Library:AddCommand(Info: { [string]: any })
    assert(typeof(Info) == "table" and typeof(Info.Name) == "string", "AddCommand expects a table with a Name")

    local Command = {
        Name = string.lower(Info.Name),
        Aliases = {},
        Args = tostring(Info.Args or ""),
        Description = tostring(Info.Description or ""),
        Callback = Info.Callback,
        Source = Info.Source or "Corvus",
    }
    for _, Alias in Info.Aliases or {} do
        table.insert(Command.Aliases, string.lower(tostring(Alias)))
    end

    local Existing = CommandRegistry.Lookup[Command.Name]
    if Existing and Existing.Name == Command.Name then
        local Index = table.find(CommandRegistry.List, Existing)
        if Index then
            table.remove(CommandRegistry.List, Index)
        end
    end

    table.insert(CommandRegistry.List, Command)
    CommandRegistry.Lookup[Command.Name] = Command
    for _, Alias in Command.Aliases do
        local Current = CommandRegistry.Lookup[Alias]
        if not Current or Current.Name ~= Alias then
            CommandRegistry.Lookup[Alias] = Command
        end
    end

    FireCommandListeners()
    return Command
end

function Library:RemoveCommand(Name: string)
    local Command = CommandRegistry.Lookup[string.lower(tostring(Name))]
    if not Command then
        return
    end

    local Index = table.find(CommandRegistry.List, Command)
    if Index then
        table.remove(CommandRegistry.List, Index)
    end
    for Key, Value in CommandRegistry.Lookup do
        if Value == Command then
            CommandRegistry.Lookup[Key] = nil
        end
    end
    FireCommandListeners()
end

function Library:GetCommands(): { any }
    local List = table.clone(CommandRegistry.List)
    for _, Command in InfiniteYield.Commands do
        table.insert(List, Command)
    end
    return List
end

function Library:FindCommand(Name: string)
    Name = string.lower(tostring(Name))
    return CommandRegistry.Lookup[Name] or InfiniteYield.Lookup[Name]
end

local function ParseInfiniteYield(Env)
    local Executable = {}
    if typeof(Env.cmds) == "table" then
        for _, Cmd in Env.cmds do
            if typeof(Cmd) == "table" and typeof(Cmd.NAME) == "string" then
                Executable[string.lower(Cmd.NAME)] = true
                if typeof(Cmd.ALIAS) == "table" then
                    for _, Alias in Cmd.ALIAS do
                        Executable[string.lower(tostring(Alias))] = true
                    end
                end
            end
        end
    end

    local Commands, Lookup = {}, {}
    local function Register(Names: { string }, Args: string, Description: string)
        local Primary = Names[1]
        if not Primary or Lookup[Primary] then
            return
        end

        local Command = {
            Name = Primary,
            Aliases = {},
            Args = Args,
            Description = Description,
            Source = "Pack",
        }
        for Index = 2, #Names do
            table.insert(Command.Aliases, Names[Index])
        end

        table.insert(Commands, Command)
        for _, Name in Names do
            if not Lookup[Name] then
                Lookup[Name] = Command
            end
        end
    end

    if typeof(Env.CMDs) == "table" then
        for _, Data in Env.CMDs do
            if typeof(Data) == "table" and typeof(Data.NAME) == "string" then
                local Raw = Data.NAME
                local ArgsStart = string.find(Raw, "[%[%(<{]")
                local NamesPart = if ArgsStart then string.sub(Raw, 1, ArgsStart - 1) else Raw
                local Args = if ArgsStart then Trim(string.sub(Raw, ArgsStart)) else ""

                local Names = {}
                local Runnable = next(Executable) == nil
                for Name in string.gmatch(NamesPart, "[^/]+") do
                    Name = string.lower(Trim(Name))
                    if Name ~= "" and not string.find(Name, " ", 1, true) then
                        table.insert(Names, Name)
                        if Executable[Name] then
                            Runnable = true
                        end
                    end
                end

                if #Names > 0 and Runnable then
                    Register(Names, Args, tostring(Data.DESC or ""))
                end
            end
        end
    end

    if typeof(Env.cmds) == "table" then
        for _, Cmd in Env.cmds do
            if typeof(Cmd) == "table" and typeof(Cmd.NAME) == "string" and not Lookup[string.lower(Cmd.NAME)] then
                local Names = { string.lower(Cmd.NAME) }
                if typeof(Cmd.ALIAS) == "table" then
                    for _, Alias in Cmd.ALIAS do
                        table.insert(Names, string.lower(tostring(Alias)))
                    end
                end
                Register(Names, "", if Cmd.PLUGIN then "Plugin command" else "")
            end
        end
    end

    return Commands, Lookup, Executable
end

function Library:LoadInfiniteYield(): boolean
    if InfiniteYield.Loaded then
        return true
    end

    if InfiniteYield.Loading then
        repeat
            task.wait(0.1)
        until not InfiniteYield.Loading
        return InfiniteYield.Loaded
    end

    InfiniteYield.Loading = true
    FireCommandListeners()
    Library:ConsoleLog("Loading commands...", "system")

    local Success, Error = pcall(function()
        local Source = game:HttpGet(Library.InfiniteYieldSource)
        local Chunk, CompileError = loadstring(Source, "=InfiniteYield")
        if not Chunk then
            error(CompileError or "could not compile the command pack", 0)
        end

        local Base = getgenv()
        local Env = setmetatable({ IY_LOADED = false }, {
            __index = Base,
        })
        setfenv(Chunk, Env)
        InfiniteYield.Env = Env
        Chunk()

        if typeof(Env.execCmd) ~= "function" then
            error("command runner missing", 0)
        end
    end)

    InfiniteYield.Loading = false

    if not Success then
        Library:ConsoleLog("Commands failed to load: " .. tostring(Error), "error")
        FireCommandListeners()
        return false
    end

    local Env = InfiniteYield.Env
    InfiniteYield.Commands, InfiniteYield.Lookup, InfiniteYield.Executable = ParseInfiniteYield(Env)
    InfiniteYield.Loaded = true

    pcall(function()
        if Env.ScaledHolder then
            InfiniteYield.HolderWasVisible = Env.ScaledHolder.Visible
            Env.ScaledHolder.Visible = false
        end
    end)

    InfiniteYield.OriginalNotify = Env.notify
    Env.notify = function(Title, Text, Length)
        local HasText = Text ~= nil and Text ~= ""
        local Heading = if HasText then tostring(Title) else tostring(Library.Title or Library.Name)
        local Body = if HasText then tostring(Text) else tostring(Title)
        Library:ConsoleLog(Heading .. ": " .. Body, "iy")
        Library:Notify({
            Title = Heading,
            Description = Body,
            Time = tonumber(Length) or 4,
        })
    end

    InfiniteYield.OriginalMaximize = Env.maximizeHolder
    Env.maximizeHolder = function()
        task.defer(function()
            pcall(function()
                Env.Cmdbar:ReleaseFocus()
            end)
            if Library.OpenConsole then
                Library:OpenConsole()
            end
        end)
    end

    Library:ConsoleLog(string.format("%d commands ready.", #InfiniteYield.Commands), "success")
    FireCommandListeners()
    return true
end

function Library:RunCommand(Text: string): boolean
    Text = Trim(tostring(Text or ""))
    if Text == "" then
        return false
    end

    Library:ConsoleLog(Text, "input")

    local Words = SplitWords(Text)
    local Name = string.lower(table.remove(Words, 1))
    local Command = CommandRegistry.Lookup[Name]

    if Command and typeof(Command.Callback) == "function" then
        local Success, Result = pcall(Command.Callback, Words, Text)
        if not Success then
            Library:ConsoleLog(tostring(Result), "error")
            return false
        end
        if Result ~= nil then
            Library:ConsoleLog(tostring(Result), "success")
        end
        return true
    end

    if InfiniteYield.Loaded then
        local Known = InfiniteYield.Lookup[Name] or InfiniteYield.Executable[Name]
        if Known or string.find(Text, "^%d+%^") or string.find(Text, "^inf%^") or string.find(Text, "\\", 1, true) then
            local Success, Error = pcall(InfiniteYield.Env.execCmd, Text, LocalPlayer, true)
            if not Success then
                Library:ConsoleLog(tostring(Error), "error")
                return false
            end
            return true
        end

        Library:ConsoleLog(string.format('Unknown command "%s".', Name), "error")
        return false
    end

    Library:ConsoleLog(string.format('Unknown command "%s". Commands are still loading.', Name), "error")
    return false
end

Library:OnUnload(function()
    local Env = InfiniteYield.Env
    if not (InfiniteYield.Loaded and Env) then
        return
    end

    pcall(function()
        if Env.ScaledHolder then
            Env.ScaledHolder.Visible = true
        end
        if InfiniteYield.OriginalNotify then
            Env.notify = InfiniteYield.OriginalNotify
        end
        if InfiniteYield.OriginalMaximize then
            Env.maximizeHolder = InfiniteYield.OriginalMaximize
        end
    end)
end)

local RemoteSpy = {
    Hooked = false,
    Enabled = false,
    Paused = false,
    LogOutgoing = true,
    LogIncoming = false,
    LogExecutor = false,
    Remotes = {},
    Order = {},
    Queue = {},
    Listeners = {},
    IncomingConnections = {},
    Connections = {},
    TotalCalls = 0,
    MaxCalls = 80,
    MaxRemotes = 400,
    Original = nil,
}
Library.RemoteSpy = RemoteSpy

local SpyMethods = {
    FireServer = "Outgoing",
    fireServer = "Outgoing",
    InvokeServer = "Outgoing",
    invokeServer = "Outgoing",
}
local SpyClasses = {
    RemoteEvent = true,
    RemoteFunction = true,
    UnreliableRemoteEvent = true,
}

local function SpyChanged()
    if RemoteSpy.PendingNotify then
        return
    end
    RemoteSpy.PendingNotify = true

    task.delay(0.12, function()
        RemoteSpy.PendingNotify = false
        for _, Listener in RemoteSpy.Listeners do
            task.spawn(Listener)
        end
    end)
end

function RemoteSpy:OnChanged(Callback: () -> ())
    table.insert(RemoteSpy.Listeners, Callback)
end

local function SpyIndexName(Name: string): string
    if string.match(Name, "^[%a_][%w_]*$") then
        return "." .. Name
    end
    return "[" .. string.format("%q", Name) .. "]"
end

local function SpyEscape(Text: string): string
    local Escaped = string.gsub(Text, '[%c"\\]', function(Char)
        if Char == '"' then
            return '\\"'
        elseif Char == "\\" then
            return "\\\\"
        elseif Char == "\n" then
            return "\\n"
        elseif Char == "\r" then
            return "\\r"
        elseif Char == "\t" then
            return "\\t"
        end
        return string.format("\\%03d", string.byte(Char))
    end)
    return '"' .. Escaped .. '"'
end

function RemoteSpy.GetPath(Target: Instance): (string, boolean)
    if Target == game then
        return "game", false
    end
    if Target == workspace then
        return "workspace", false
    end

    local Segments = {}
    local Current = Target
    while Current do
        if Current == LocalPlayer then
            table.insert(Segments, 1, 'game:GetService("Players").LocalPlayer')
            return table.concat(Segments), false
        end

        local Parent = Current.Parent
        if Parent == game then
            local Success, Service = pcall(function()
                return game:FindService(Current.ClassName)
            end)
            if Success and Service == Current then
                table.insert(Segments, 1, string.format('game:GetService("%s")', Current.ClassName))
            else
                table.insert(Segments, 1, "game" .. SpyIndexName(Current.Name))
            end
            return table.concat(Segments), false
        end

        if Parent == nil then
            return table.concat(Segments), true
        end

        table.insert(Segments, 1, SpyIndexName(Current.Name))
        Current = Parent
    end

    return table.concat(Segments), true
end

local function SpyNumber(Value: number): string
    if Value ~= Value then
        return "0 / 0"
    elseif Value == math.huge then
        return "math.huge"
    elseif Value == -math.huge then
        return "-math.huge"
    elseif Value == math.floor(Value) and math.abs(Value) < 1e15 then
        return string.format("%d", Value)
    end
    return string.format("%.14g", Value)
end

function RemoteSpy.Serialize(Value: any, Depth: number?, Seen: { [any]: boolean }?): string
    Depth = Depth or 0
    Seen = Seen or {}

    local Kind = typeof(Value)
    if Kind == "nil" then
        return "nil"
    elseif Kind == "boolean" then
        return tostring(Value)
    elseif Kind == "number" then
        return SpyNumber(Value)
    elseif Kind == "string" then
        return SpyEscape(Value)
    elseif Kind == "Instance" then
        local Path, IsNil = RemoteSpy.GetPath(Value)
        if IsNil then
            return "nil"
        end
        return Path
    elseif Kind == "Vector3" then
        return string.format("Vector3.new(%s, %s, %s)", SpyNumber(Value.X), SpyNumber(Value.Y), SpyNumber(Value.Z))
    elseif Kind == "Vector2" then
        return string.format("Vector2.new(%s, %s)", SpyNumber(Value.X), SpyNumber(Value.Y))
    elseif Kind == "CFrame" then
        local Parts = {}
        for _, Component in { Value:GetComponents() } do
            table.insert(Parts, SpyNumber(Component))
        end
        return "CFrame.new(" .. table.concat(Parts, ", ") .. ")"
    elseif Kind == "Color3" then
        return string.format("Color3.fromRGB(%d, %d, %d)", math.floor(Value.R * 255 + 0.5), math.floor(Value.G * 255 + 0.5), math.floor(Value.B * 255 + 0.5))
    elseif Kind == "UDim2" then
        return string.format("UDim2.new(%s, %s, %s, %s)", SpyNumber(Value.X.Scale), SpyNumber(Value.X.Offset), SpyNumber(Value.Y.Scale), SpyNumber(Value.Y.Offset))
    elseif Kind == "UDim" then
        return string.format("UDim.new(%s, %s)", SpyNumber(Value.Scale), SpyNumber(Value.Offset))
    elseif Kind == "EnumItem" then
        return tostring(Value)
    elseif Kind == "BrickColor" then
        return string.format("BrickColor.new(%s)", SpyEscape(tostring(Value)))
    elseif Kind == "table" then
        if Seen[Value] or Depth > 8 then
            return "{}"
        end
        Seen[Value] = true

        local Count = 0
        local MaxIndex = 0
        for Key in Value do
            Count += 1
            if typeof(Key) == "number" and Key >= 1 and Key == math.floor(Key) then
                MaxIndex = math.max(MaxIndex, Key)
            end
        end
        if Count == 0 then
            Seen[Value] = nil
            return "{}"
        end

        local Indent = string.rep("    ", Depth + 1)
        local Lines = {}
        if MaxIndex == Count then
            for Index = 1, MaxIndex do
                table.insert(Lines, Indent .. RemoteSpy.Serialize(Value[Index], Depth + 1, Seen))
            end
        else
            local Keys = {}
            for Key in Value do
                table.insert(Keys, Key)
            end
            table.sort(Keys, function(A, B)
                return tostring(A) < tostring(B)
            end)
            for _, Key in Keys do
                local KeyText
                if typeof(Key) == "string" and string.match(Key, "^[%a_][%w_]*$") then
                    KeyText = Key
                else
                    KeyText = "[" .. RemoteSpy.Serialize(Key, Depth + 1, Seen) .. "]"
                end
                table.insert(Lines, Indent .. KeyText .. " = " .. RemoteSpy.Serialize(Value[Key], Depth + 1, Seen))
            end
        end

        Seen[Value] = nil
        return "{\n" .. table.concat(Lines, ",\n") .. "\n" .. string.rep("    ", Depth) .. "}"
    end

    return "nil"
end

function RemoteSpy.Preview(Args): string
    local Parts = {}
    for Index = 1, math.min(Args.n or #Args, 6) do
        local Value = Args[Index]
        local Kind = typeof(Value)
        local Text
        if Kind == "string" then
            Text = if #Value > 22 then SpyEscape(string.sub(Value, 1, 20)) .. "\u{2026}" else SpyEscape(Value)
        elseif Kind == "table" then
            local Count = 0
            for _ in Value do
                Count += 1
            end
            Text = string.format("{%d}", Count)
        elseif Kind == "Instance" then
            Text = Value.Name
        elseif Kind == "number" then
            Text = SpyNumber(Value)
        elseif Kind == "nil" or Kind == "boolean" then
            Text = tostring(Value)
        else
            Text = Kind
        end
        table.insert(Parts, Text)
    end
    if (Args.n or #Args) > 6 then
        table.insert(Parts, "\u{2026}")
    end
    return if #Parts == 0 then "no arguments" else table.concat(Parts, ", ")
end

function RemoteSpy.GetCode(Record, Call): string
    if not (Record and Call) then
        return ""
    end

    local Lines = {}
    local Target = Record.Path
    if Record.IsNil then
        table.insert(Lines, "local Remote")
        table.insert(Lines, "for _, Instance in getnilinstances() do")
        table.insert(Lines, string.format("    if Instance.Name == %s and Instance.ClassName == %s then", SpyEscape(Record.Name), SpyEscape(Record.ClassName)))
        table.insert(Lines, "        Remote = Instance")
        table.insert(Lines, "        break")
        table.insert(Lines, "    end")
        table.insert(Lines, "end")
        Target = "Remote"
    end

    if Call.Direction == "Incoming" then
        table.insert(Lines, Target .. ".OnClientEvent:Connect(function(...)")
        table.insert(Lines, "    print(...)")
        table.insert(Lines, "end)")
        return table.concat(Lines, "\n")
    end

    local Method = if Record.ClassName == "RemoteFunction" then "InvokeServer" else "FireServer"
    local Count = Call.Args.n or #Call.Args
    if Call.ScriptPath then
        table.insert(Lines, 1, "local CalledFrom = " .. SpyEscape(Call.ScriptPath))
    end
    if Count == 0 then
        table.insert(Lines, string.format("%s:%s()", Target, Method))
    else
        table.insert(Lines, "local Args = {")
        for Index = 1, Count do
            table.insert(Lines, string.format("    [%d] = %s,", Index, RemoteSpy.Serialize(Call.Args[Index], 1)))
        end
        table.insert(Lines, "}")
        table.insert(Lines, string.format("%s:%s(table.unpack(Args, 1, %d))", Target, Method, Count))
    end
    if Call.Returns and (Call.Returns.n or #Call.Returns) > 0 then
        table.insert(Lines, "")
        table.insert(Lines, "local Returned = " .. RemoteSpy.Serialize({ table.unpack(Call.Returns, 1, Call.Returns.n) }, 0))
    end
    return table.concat(Lines, "\n")
end

local function SpyScriptPath(Script: any): string?
    if typeof(Script) ~= "Instance" then
        return nil
    end
    local Success, Path = pcall(RemoteSpy.GetPath, Script)
    return if Success then Path else Script.Name
end

function RemoteSpy.Record(Remote: Instance, Method: string, Args, Direction: string, FromExecutor: boolean?, Script: any?, Returns: any?)
    local Record = RemoteSpy.Remotes[Remote]
    if not Record then
        if #RemoteSpy.Order >= RemoteSpy.MaxRemotes then
            return
        end

        local Path, IsNil = RemoteSpy.GetPath(Remote)
        Record = {
            Remote = Remote,
            Name = Remote.Name,
            ClassName = Remote.ClassName,
            Path = Path,
            IsNil = IsNil,
            Calls = {},
            Count = 0,
            Outgoing = 0,
            Incoming = 0,
            Blocked = false,
            Ignored = false,
            Order = #RemoteSpy.Order + 1,
        }
        RemoteSpy.Remotes[Remote] = Record
        table.insert(RemoteSpy.Order, Record)
    end

    Record.Count += 1
    Record[Direction] += 1
    Record.LastSeen = os.clock()

    if not Record.Ignored then
        table.insert(Record.Calls, 1, {
            Method = Method,
            Args = Args,
            Direction = Direction,
            FromExecutor = FromExecutor == true,
            Script = Script,
            ScriptPath = SpyScriptPath(Script),
            Returns = Returns,
            Time = os.date("%H:%M:%S"),
            Preview = RemoteSpy.Preview(Args),
        })
        if #Record.Calls > RemoteSpy.MaxCalls then
            table.remove(Record.Calls)
        end
    end

    RemoteSpy.TotalCalls += 1
    SpyChanged()
end

local function SpyProcessQueue()
    local Queue = RemoteSpy.Queue
    if #Queue == 0 then
        return
    end

    RemoteSpy.Queue = {}
    for _, Item in Queue do
        local Success = pcall(RemoteSpy.Record, Item[1], Item[2], Item[3], Item[4], Item[5], Item[6], Item[7])
        if not Success then
            continue
        end
    end
end

function RemoteSpy:WatchIncoming()
    if RemoteSpy.WatchingIncoming then
        return
    end
    RemoteSpy.WatchingIncoming = true

    local function Watch(Target: Instance)
        if RemoteSpy.IncomingConnections[Target] then
            return
        end

        local Success, IsRemote = pcall(function()
            return Target:IsA("RemoteEvent") or Target:IsA("UnreliableRemoteEvent")
        end)
        if not (Success and IsRemote) then
            return
        end

        RemoteSpy.IncomingConnections[Target] = Target.OnClientEvent:Connect(function(...)
            if RemoteSpy.Enabled and RemoteSpy.LogIncoming and not RemoteSpy.Paused then
                local Record = RemoteSpy.Remotes[Target]
                if Record and Record.Ignored then
                    return
                end
                table.insert(RemoteSpy.Queue, { Target, "OnClientEvent", table.pack(...), "Incoming", false })
            end
        end)
    end

    task.spawn(function()
        for Index, Target in game:GetDescendants() do
            Watch(Target)
            if Index % 2500 == 0 then
                task.wait()
            end
        end
    end)
    table.insert(RemoteSpy.Connections, game.DescendantAdded:Connect(Watch))
end

function RemoteSpy:Supported(): boolean
    return typeof(hookmetamethod) == "function" and typeof(getnamecallmethod) == "function"
end

function RemoteSpy:Start(): (boolean, string?)
    if not RemoteSpy.Hooked then
        if not RemoteSpy:Supported() then
            return false, "Your executor does not support hookmetamethod"
        end

        local Wrap = if typeof(newcclosure) == "function" then newcclosure else function(Callback)
            return Callback
        end
        local IsExecutor = if typeof(checkcaller) == "function" then checkcaller else function()
            return false
        end

        local Original
        local Success, Error = pcall(function()
            Original = hookmetamethod(game, "__namecall", Wrap(function(Self, ...)
                local Method = getnamecallmethod()
                if RemoteSpy.Enabled and SpyMethods[Method] and typeof(Self) == "Instance" and SpyClasses[Self.ClassName] then
                    local FromExecutor = IsExecutor()
                    local Record = RemoteSpy.Remotes[Self]

                    if Record and Record.Blocked and not FromExecutor then
                        return nil
                    end

                    if RemoteSpy.LogOutgoing and not RemoteSpy.Paused and (RemoteSpy.LogExecutor or not FromExecutor) and not (Record and Record.Ignored) then
                        local Queue = RemoteSpy.Queue
                        if #Queue < 600 then
                            local Script = nil
                            if typeof(getcallingscript) == "function" then
                                local Ok, Result = pcall(getcallingscript)
                                Script = if Ok then Result else nil
                            end

                            if Method == "InvokeServer" or Method == "invokeServer" then
                                local Results = table.pack(Original(Self, ...))
                                Queue[#Queue + 1] = { Self, Method, table.pack(...), "Outgoing", FromExecutor, Script, Results }
                                return table.unpack(Results, 1, Results.n)
                            end

                            Queue[#Queue + 1] = { Self, Method, table.pack(...), "Outgoing", FromExecutor, Script }
                        end
                    end
                end

                return Original(Self, ...)
            end))
        end)

        if not Success or not Original then
            return false, tostring(Error or "hook failed")
        end

        RemoteSpy.Original = Original
        RemoteSpy.Hooked = true
        table.insert(RemoteSpy.Connections, RunService.Heartbeat:Connect(SpyProcessQueue))
    end

    RemoteSpy.Enabled = true
    if RemoteSpy.LogIncoming then
        RemoteSpy:WatchIncoming()
    end
    SpyChanged()
    return true
end

function RemoteSpy:Stop()
    RemoteSpy.Enabled = false
    SpyChanged()
end

function RemoteSpy:SetPaused(Paused: boolean)
    RemoteSpy.Paused = Paused == true
    SpyChanged()
end

function RemoteSpy:SetIncoming(Enabled: boolean)
    RemoteSpy.LogIncoming = Enabled == true
    if RemoteSpy.LogIncoming and RemoteSpy.Enabled then
        RemoteSpy:WatchIncoming()
    end
    SpyChanged()
end

function RemoteSpy:Clear()
    table.clear(RemoteSpy.Remotes)
    table.clear(RemoteSpy.Order)
    RemoteSpy.Queue = {}
    RemoteSpy.TotalCalls = 0
    SpyChanged()
end

function RemoteSpy:Decompile(Call): (boolean, string)
    local Script = Call and Call.Script
    if typeof(Script) ~= "Instance" then
        return false, "No calling script was captured for this call."
    end
    if typeof(decompile) ~= "function" then
        return false, "Your executor has no decompiler."
    end

    local Success, Result = pcall(decompile, Script)
    if not Success or typeof(Result) ~= "string" or Result == "" then
        return false, "Decompile failed: " .. tostring(Result)
    end
    return true, Result
end

function RemoteSpy:Repeat(Record, Call): (boolean, string?)
    if not (Record and Call) or Call.Direction ~= "Outgoing" then
        return false, "Only outgoing calls can be repeated"
    end

    local Remote = Record.Remote
    local Args = Call.Args
    return pcall(function()
        if Record.ClassName == "RemoteFunction" then
            return Remote:InvokeServer(table.unpack(Args, 1, Args.n or #Args))
        end
        Remote:FireServer(table.unpack(Args, 1, Args.n or #Args))
    end)
end

Library:OnUnload(function()
    RemoteSpy.Enabled = false
    for _, Connection in RemoteSpy.Connections do
        pcall(function()
            Connection:Disconnect()
        end)
    end
    for _, Connection in RemoteSpy.IncomingConnections do
        pcall(function()
            Connection:Disconnect()
        end)
    end
    table.clear(RemoteSpy.IncomingConnections)

    if RemoteSpy.Hooked and RemoteSpy.Original and typeof(hookmetamethod) == "function" then
        pcall(hookmetamethod, game, "__namecall", RemoteSpy.Original)
    end
end)

local BaseAddons = {}
do
    local Funcs = {}

    function Funcs:AddKeyPicker(Idx, Info)
        if self.Destroyed then return nil end

        Info = Library:Validate(Info, Templates.KeyPicker)

        local ParentObj = self
        local ToggleLabel = ParentObj.TextLabel

        if ParentObj.Type == "Button" or ParentObj.Type == "SubButton" then
            assert(Info.Mode == "Press", "KeyPicker on Buttons can only be applied with the 'Press' mode.")

            ToggleLabel = ParentObj.Base
        end

        local KeyPicker = {
            Connections = {},

            Text = Info.Text,
            Value = Info.Default,
            Modifiers = Info.DefaultModifiers,
            DisplayValue = Info.Default,

            Blacklisted = Info.Blacklisted,
            BlacklistedModifiers = Info.BlacklistedModifiers,
            Whitelisted = Info.Whitelisted,
            WhitelistedModifiers = Info.WhitelistedModifiers,

            Toggled = false,
            Mode = Info.Mode,
            SyncToggleState = Info.SyncToggleState,

            MenuVisible = Info.NoUI ~= true,

            Callback = Info.Callback,
            ChangedCallback = Info.ChangedCallback,
            Changed = Info.Changed,
            Clicked = Info.Clicked,

            Type = "KeyPicker",
        }

        if KeyPicker.Mode == "Press" then
            assert(ParentObj.Type == "Label" or ParentObj.Type == "Button" or ParentObj.Type == "SubButton", "KeyPicker with the mode 'Press' can be only applied on Labels and Buttons.")

            KeyPicker.SyncToggleState = false
            Info.Modes = { "Press" }
            Info.Mode = "Press"
        end

        if KeyPicker.SyncToggleState then
            Info.Modes = { "Toggle", "Hold" }

            if not table.find(Info.Modes, Info.Mode) then
                Info.Mode = "Toggle"
            end
        end

        local Picking = false
        local IsForButton = ParentObj.Type == "Button" or ParentObj.Type == "SubButton"

        local SpecialKeys = {
            ["MB1"] = Enum.UserInputType.MouseButton1,
            ["MB2"] = Enum.UserInputType.MouseButton2,
            ["MB3"] = Enum.UserInputType.MouseButton3,
        }

        local SpecialKeysInput = {
            [Enum.UserInputType.MouseButton1] = "MB1",
            [Enum.UserInputType.MouseButton2] = "MB2",
            [Enum.UserInputType.MouseButton3] = "MB3",
        }

        local Modifiers = {
            ["LAlt"] = Enum.KeyCode.LeftAlt,
            ["RAlt"] = Enum.KeyCode.RightAlt,

            ["LCtrl"] = Enum.KeyCode.LeftControl,
            ["RCtrl"] = Enum.KeyCode.RightControl,

            ["LShift"] = Enum.KeyCode.LeftShift,
            ["RShift"] = Enum.KeyCode.RightShift,

            ["Tab"] = Enum.KeyCode.Tab,
            ["CapsLock"] = Enum.KeyCode.CapsLock,
        }

        local ModifiersInput = {
            [Enum.KeyCode.LeftAlt] = "LAlt",
            [Enum.KeyCode.RightAlt] = "RAlt",

            [Enum.KeyCode.LeftControl] = "LCtrl",
            [Enum.KeyCode.RightControl] = "RCtrl",

            [Enum.KeyCode.LeftShift] = "LShift",
            [Enum.KeyCode.RightShift] = "RShift",

            [Enum.KeyCode.Tab] = "Tab",
            [Enum.KeyCode.CapsLock] = "CapsLock",
        }

        local IsModifierInput = function(Input)
            return Input.UserInputType == Enum.UserInputType.Keyboard and ModifiersInput[Input.KeyCode] ~= nil
        end

        local GetActiveModifiers = function()
            local ActiveModifiers = {}

            for Name, Input in Modifiers do
                if table.find(ActiveModifiers, Name) then
                    continue
                end
                if not UserInputService:IsKeyDown(Input) then
                    continue
                end

                table.insert(ActiveModifiers, Name)
            end

            return ActiveModifiers
        end

        local AreModifiersHeld = function(Required)
            if not (typeof(Required) == "table" and GetTableSize(Required) > 0) then
                return true
            end

            local ActiveModifiers = GetActiveModifiers()
            local Holding = true

            for _, Name in Required do
                if table.find(ActiveModifiers, Name) then
                    continue
                end

                Holding = false
                break
            end

            return Holding
        end

        local IsInputDown = function(Input)
            if not Input then
                return false
            end

            if SpecialKeysInput[Input.UserInputType] ~= nil then
                return UserInputService:IsMouseButtonPressed(Input.UserInputType)
                    and not UserInputService:GetFocusedTextBox()
            elseif Input.UserInputType == Enum.UserInputType.Keyboard then
                return UserInputService:IsKeyDown(Input.KeyCode) and not UserInputService:GetFocusedTextBox()
            else
                return false
            end
        end

        local ConvertToInputModifiers = function(CurrentModifiers)
            local InputModifiers = {}

            for _, name in CurrentModifiers do
                table.insert(InputModifiers, Modifiers[name])
            end

            return InputModifiers
        end

        local VerifyModifiers = function(CurrentModifiers)
            if typeof(CurrentModifiers) ~= "table" then
                return {}
            end

            local ValidModifiers = {}

            for _, name in CurrentModifiers do
                if not Modifiers[name] then
                    continue
                end

                table.insert(ValidModifiers, name)
            end

            return ValidModifiers
        end

        KeyPicker.Modifiers = VerifyModifiers(KeyPicker.Modifiers)

        local SlideOverflow = true
        local LastDisplayText = nil
        local MaxPickerWidth = 85
        local SlidingLabel

        local SlideForwardTween
        local SlideBackTween
        local HandleForwardTween = function(State)
            if State ~= Enum.PlaybackState.Completed then
                return
            end

            task.wait(1.5)
            if SlideBackTween then
                SlideBackTween:Play()
            end
        end

        local HandleBackTween = function(State)
            if State ~= Enum.PlaybackState.Completed then
                return
            end

            task.wait(1.5)
            if SlideForwardTween then
                SlideForwardTween:Play()
            end
        end

        local SlideForwardConn, SlideBackConn
        local CancelSlidingTweens = function()
            if SlideForwardConn then
                SlideForwardConn:Disconnect()
                SlideForwardConn = nil
            end

            if SlideBackConn then
                SlideBackConn:Disconnect()
                SlideBackConn = nil
            end

            if SlideForwardTween then
                StopTween(SlideForwardTween, true)
                SlideForwardTween = nil
            end

            if SlideBackTween then
                StopTween(SlideBackTween, true)
                SlideBackTween = nil
            end

            RunService.RenderStepped:Wait()
        end

        local Picker = New("TextButton", {
            BackgroundColor3 = "MainColor",
            Size = UDim2.fromOffset(18, 18),
            Text = (IsForButton and SlideOverflow) and "" or KeyPicker.Value,
            TextSize = 14,
            TextTransparency = 0.4,
            Parent = ToggleLabel,
        })

        if IsForButton and SlideOverflow then
            Picker.ClipsDescendants = true

            SlidingLabel = New("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 1, 0),
                Position = UDim2.new(0, 0, 0, 0),
