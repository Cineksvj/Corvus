local Base64Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local Base64Lookup = {}
for Index = 1, #Base64Alphabet do
    Base64Lookup[string.byte(Base64Alphabet, Index)] = Index - 1
end

local function Base64Decode(Data: string): string
    local Decoder = (crypt and (crypt.base64decode or (crypt.base64 and crypt.base64.decode))) or base64_decode
    if typeof(Decoder) == "function" then
        local Success, Result = pcall(Decoder, Data)
        if Success and typeof(Result) == "string" and #Result > 0 then
            return Result
        end
    end

    Data = string.gsub(Data, "[^%w%+/=]", "")
    local Output = table.create(math.floor(#Data / 4) * 3)
    local Count = 0

    for Index = 1, #Data, 4 do
        local A, B, C, D = string.byte(Data, Index, Index + 3)
        local V1 = Base64Lookup[A] or 0
        local V2 = Base64Lookup[B] or 0
        local V3 = Base64Lookup[C] or 0
        local V4 = Base64Lookup[D] or 0
        local Triple = V1 * 262144 + V2 * 4096 + V3 * 64 + V4

        Count += 1
        Output[Count] = string.char(math.floor(Triple / 65536) % 256)
        if C and C ~= 61 then
            Count += 1
            Output[Count] = string.char(math.floor(Triple / 256) % 256)
        end
        if D and D ~= 61 then
            Count += 1
            Output[Count] = string.char(Triple % 256)
        end
    end

    return table.concat(Output)
end

