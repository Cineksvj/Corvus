    end
    if WindowInfo.AutoShow and not Library.ActiveLoading then
        if Library:GetSetting("HideOnStart", false) == true then
            task.delay(0.8, function()
                if Library.Unloaded or Library.Toggled then
                    return
                end

                local Bind = Library.ToggleKeybind
                local KeyName = "your menu key"
                if typeof(Bind) == "table" and Bind.Value ~= nil then
                    KeyName = tostring(Bind.Value)
                elseif typeof(Bind) == "EnumItem" then
                    KeyName = Bind.Name
                end

                Library:Notify({
