                Text = Text,
                TextSize = 14,
                TextTransparency = 0.4,
                Parent = Footer,
            })
            table.insert(
                Library.Corners,
                New("UICorner", {
                    CornerRadius = UDim.new(0, Library.CornerRadius / 2),
                    Parent = Button,
                })
            )
            table.insert(Picker.Connections, Button.MouseEnter:Connect(function()
                TweenService:Create(Button, Library.TweenInfo, { TextTransparency = 0 }):Play()
            end))
            table.insert(Picker.Connections, Button.MouseLeave:Connect(function()
                TweenService:Create(Button, Library.TweenInfo, { TextTransparency = 0.4 }):Play()
            end))
            table.insert(Picker.Connections, Button.MouseButton1Click:Connect(Callback))
            return Button
        end

        FooterButton("Select all", function()
            local NewValue = {}
            for _, Row in Picker.Rows do
                if (Row.Button.Visible and not Row.Disabled) or IsSelected(Row.Value) then
                    NewValue[Row.Value] = true
                end
            end
            Dropdown:SetValue(NewValue)
            RepaintAll(true)
        end)

        FooterButton("Clear", function()
            local NewValue = {}
            for _, Row in Picker.Rows do
                if Row.Disabled and IsSelected(Row.Value) then
                    NewValue[Row.Value] = true
                end
            end
            Dropdown:SetValue(NewValue)
            RepaintAll(true)
        end)
    end

    table.insert(Picker.Connections, SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
        local Query = string.lower(Trim(SearchInput.Text))
        local AnyVisible = false

        for _, Row in Picker.Rows do
            local Visible = Query == "" or string.find(Row.Search, Query, 1, true) ~= nil
            if not Visible and Query ~= "" then
                Visible = FuzzyScore(Row.Search, NormalizeSearch(Query))
            end

            Row.Button.Visible = Visible
            AnyVisible = AnyVisible or Visible
        end

        EmptyLabel.Visible = not AnyVisible
        List.CanvasPosition = Vector2.zero
    end))

    function Picker:Close(Instant: boolean?)
        if Picker.Closed then
            return
        end
        Picker.Closed = true

        if Library.ActivePicker == Picker then
            Library.ActivePicker = nil
        end

        for _, Connection in Picker.Connections do
            Connection:Disconnect()
        end
        table.clear(Picker.Connections)

        if Instant or Library.IconAnimations == false then
            Backdrop:Destroy()
            return
        end

        TweenService:Create(Backdrop, Library.TweenInfo, { BackgroundTransparency = 1 }):Play()
        TweenService:Create(PanelScale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Scale = 0.9,
        }):Play()
        task.delay(0.15, function()
            Backdrop:Destroy()
        end)
    end

    table.insert(Picker.Connections, Backdrop.MouseButton1Click:Connect(function()
        Picker:Close()
    end))
    table.insert(Picker.Connections, CloseButton.MouseButton1Click:Connect(function()
        Picker:Close()
    end))
    table.insert(Picker.Connections, UserInputService.InputBegan:Connect(function(Input: InputObject)
        if Input.KeyCode == Enum.KeyCode.Escape then
            Picker:Close()
        end
    end))

    RepaintAll(false)
    Library.ActivePicker = Picker

    if Library.IconAnimations ~= false then
        TweenService:Create(Backdrop, Library.TweenInfo, { BackgroundTransparency = 0.45 }):Play()
        TweenService:Create(PanelScale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Scale = 1,
        }):Play()
    else
        Backdrop.BackgroundTransparency = 0.45
        PanelScale.Scale = 1
    end

    return Picker
end

