local function FormatThousands(Value: number): string
    local Formatted = tostring(math.floor(tonumber(Value) or 0))
    local Result = Formatted:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    if Result:sub(1, 1) == "," then
        Result = Result:sub(2)
    end
    return Result
end

local function ParseDiscordInvite(Invite: any): (string?, string?)
    if typeof(Invite) ~= "string" then
        return nil, nil
    end

    Invite = Trim(Invite)
    if Invite == "" then
        return nil, nil
    end

    local Code = Invite:match("discord%.gg/([%w%-_]+)")
        or Invite:match("discord%.com/invite/([%w%-_]+)")
        or Invite:match("discordapp%.com/invite/([%w%-_]+)")

    if not Code and Invite:match("^[%w%-_]+$") then
        Code = Invite
    end

    if not Code then
        return Invite, nil
    end

    return "https://discord.gg/" .. Code, Code
end

local function HttpRequestJSON(Url: string): any
    local RequestFunction = (syn and syn.request)
        or (http and http.request)
        or http_request
        or (fluxus and fluxus.request)
        or request

    local Body = nil
    if typeof(RequestFunction) == "function" then
        local Success, Response = pcall(RequestFunction, {
            Url = Url,
            Method = "GET",
        })

        if Success and typeof(Response) == "table" and (Response.StatusCode == 200 or Response.Success == true) then
            Body = Response.Body
        end
    end

    if typeof(Body) ~= "string" or Body == "" then
        local Success, Result = pcall(function()
            return game:HttpGet(Url)
        end)

        if Success then
            Body = Result
        end
    end

    if typeof(Body) ~= "string" or Body == "" then
        return nil
    end

    local Success, Decoded = pcall(function()
        return HttpService:JSONDecode(Body)
    end)

    return if Success then Decoded else nil
end

local function GetRemoteImage(Url: string, FileName: string): any
    if typeof(Url) ~= "string" or not Url:match("^https?://") then
        return nil
    end

    if not (getcustomasset and writefile and isfile) then
        return nil
    end

    if CustomImageManagerAssets[FileName] == nil then
        local Success = pcall(CustomImageManager.AddAsset, FileName, 0, Url)
        if not Success then
            return nil
        end
    end

    local Asset = CustomImageManager.GetAsset(FileName)
    if not Asset or Asset == "rbxassetid://0" then
        return nil
    end

    return {
        Url = Asset,
        ImageRectOffset = Vector2.zero,
        ImageRectSize = Vector2.zero,
    }
end

local function ResolveCardImage(Value: any, FileName: string): any
    if Value == nil or Value == "" then
        return nil
    end

    if typeof(Value) == "string" and Value:match("^https?://") then
        return GetRemoteImage(Value, FileName)
    end

    return Library:GetCustomIcon(Value)
end

local function SafeFileName(Text: string): string
    local Clean = tostring(Text):gsub("[^%w]", "")
    if #Clean > 48 then
        Clean = Clean:sub(-48)
    end
    return Clean
end

function Library:GetRemoteImage(Url: string, FileName: string?): any
    if typeof(Url) ~= "string" then
        return nil
    end

    local Extension = if string.match(string.lower(Url), "%.jpe?g") then ".jpg" else ".png"
    return GetRemoteImage(Url, FileName or ("image_" .. SafeFileName(Url) .. Extension))
end

function Library:GetEmbeddedAsset(Name: string): string?
    local Asset = EmbeddedAssets[Name]
    if not Asset then
        return nil
    end

    if Asset.Id ~= nil then
        return Asset.Id or nil
    end

    local AssetId = nil
    if getcustomasset and writefile and isfile then
        local Path = "Corvus/assets/" .. Asset.File
        local Written = pcall(function()
            if isfolder and makefolder then
                if not isfolder("Corvus") then
                    makefolder("Corvus")
                end
                if not isfolder("Corvus/assets") then
                    makefolder("Corvus/assets")
                end
            end

            if not isfile(Path) then
                writefile(Path, Base64Decode(Asset.Data))
            end
        end)

        if Written then
            local Success, Result = pcall(getcustomasset, Path)
            if Success and typeof(Result) == "string" and Result ~= "" then
                AssetId = Result
            end
        end
    end

    Asset.Id = AssetId or false
    return AssetId
end

local SettingsPath = "Corvus/settings.json"
local SettingsCache = nil

function Library:GetSetting(Key: string, Default: any): any
    if SettingsCache == nil then
        SettingsCache = {}

        if isfile and readfile then
            local Success, Content = pcall(function()
                return if isfile(SettingsPath) then readfile(SettingsPath) else nil
            end)

            if Success and typeof(Content) == "string" and Content ~= "" then
                local Decoded, Result = pcall(function()
                    return HttpService:JSONDecode(Content)
                end)
                if Decoded and typeof(Result) == "table" then
                    SettingsCache = Result
                end
            end
        end
    end

    local Value = SettingsCache[Key]
    if Value == nil then
        return Default
    end
    return Value
end

function Library:SetSetting(Key: string, Value: any)
    Library:GetSetting(Key)
    SettingsCache[Key] = Value

    if writefile then
        pcall(function()
            if isfolder and makefolder and not isfolder("Corvus") then
                makefolder("Corvus")
            end
            writefile(SettingsPath, HttpService:JSONEncode(SettingsCache))
        end)
    end
end

local function GetRequestFunction()
    return (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
end

function Library:OpenDiscordInvite(Code: string): boolean
    local RequestFunction = GetRequestFunction()
    if typeof(RequestFunction) ~= "function" or typeof(Code) ~= "string" or Code == "" then
        return false
    end

    local Success, Response = pcall(RequestFunction, {
        Url = "http://127.0.0.1:6463/rpc?v=1",
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json",
            ["Origin"] = "https://discord.com",
        },
        Body = HttpService:JSONEncode({
            cmd = "INVITE_BROWSER",
            nonce = HttpService:GenerateGUID(false),
            args = { code = Code },
        }),
    })

    return Success and typeof(Response) == "table" and (Response.StatusCode == 200 or Response.Success == true)
end

