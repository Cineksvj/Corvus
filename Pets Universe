            end

            TweenService:Create(IconScale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Scale = PressScale,
            }):Play()
        end))

        table.insert(Hover.Connections, Target.MouseButton1Up:Connect(function()
            if not IsEnabled() then
                return
            end

            TweenService:Create(IconScale, EnterInfo, {
                Scale = Hover.Hovering and HoverScale or 1,
            }):Play()
        end))
    end

    function Hover:SetBaseRotation(Rotation: number)
