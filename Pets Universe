    function Window:Rejoin()
        local TeleportService = game:GetService("TeleportService")
        Library:Notify({ Title = "Rejoin", Description = "Rejoining this server...", Time = 3 })

        local Success = pcall(function()
            if #Players:GetPlayers() <= 1 then
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            else
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
            end
        end)
        if not Success then
            Library:Notify({ Title = "Rejoin", Description = "Teleport failed, try again in a moment.", Time = 4 })
        end
    end

    function Window:ServerHop()
        local TeleportService = game:GetService("TeleportService")
        Library:Notify({ Title = "Server Hop", Description = "Looking for another server...", Time = 3 })

        local Data = HttpRequestJSON(string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true", game.PlaceId))
        local Candidates = {}
        if typeof(Data) == "table" and typeof(Data.data) == "table" then
            for _, Server in Data.data do
                local Playing, Maximum = tonumber(Server.playing), tonumber(Server.maxPlayers)
                if typeof(Server) == "table" and Server.id ~= game.JobId and Playing and Maximum and Playing < Maximum then
                    table.insert(Candidates, Server.id)
                end
            end
        end

        if #Candidates == 0 then
            Library:Notify({ Title = "Server Hop", Description = "No other public servers were found.", Time = 4 })
            return
        end

        local Success = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, Candidates[math.random(1, #Candidates)], LocalPlayer)
        end)
        if not Success then
            Library:Notify({ Title = "Server Hop", Description = "Teleport failed, try again in a moment.", Time = 4 })
        end
    end

