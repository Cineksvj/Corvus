    local function ShowTabTooltip(Entry)
        if WindowInfo.TabTooltips == false or not IsCompact or Window:IsMinimized() then
            return
        end

        EnsureTabTooltip()
        TabTooltipToken += 1

        local Description = Entry.Description
        local HotkeyIndex = if WindowInfo.TabHotkeys ~= false and Window.GetTabHotkeyIndex then Window.GetTabHotkeyIndex(Entry) else nil
        local SafeName = tostring(Entry.Name or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
        TabTooltipLabel.RichText = true
        TabTooltipLabel.Text = if HotkeyIndex then string.format('%s   <font transparency="0.55" size="12">Ctrl %d</font>', SafeName, HotkeyIndex) else SafeName
        TabTooltipDesc.Text = Description or ""
        TabTooltipDesc.Visible = typeof(Description) == "string" and Description ~= ""

        local Scale = math.max(Library.DPIScale, 0.01)
        local Y = (Entry.Button.AbsolutePosition.Y - MainFrame.AbsolutePosition.Y + Entry.Button.AbsoluteSize.Y / 2) / Scale
        local X = Window:GetSidebarWidth() + 12

        TabTooltip.Position = UDim2.fromOffset(X - 6, Y)
        TabTooltip.Visible = true

        local Info = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(TabTooltip, Info, { BackgroundTransparency = 0, Position = UDim2.fromOffset(X, Y) }):Play()
        TweenService:Create(TabTooltipArrow, Info, { BackgroundTransparency = 0 }):Play()
        TweenService:Create(TabTooltipStroke, Info, { Transparency = 0 }):Play()
        TweenService:Create(TabTooltipLabel, Info, { TextTransparency = 0 }):Play()
        TweenService:Create(TabTooltipDesc, Info, { TextTransparency = 0.45 }):Play()
    end

    local function HideTabTooltip()
        if not TabTooltip then
            return
        end

        TabTooltipToken += 1
        local Token = TabTooltipToken
        local Info = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(TabTooltip, Info, { BackgroundTransparency = 1 }):Play()
        TweenService:Create(TabTooltipArrow, Info, { BackgroundTransparency = 1 }):Play()
        TweenService:Create(TabTooltipStroke, Info, { Transparency = 1 }):Play()
        TweenService:Create(TabTooltipLabel, Info, { TextTransparency = 1 }):Play()
        TweenService:Create(TabTooltipDesc, Info, { TextTransparency = 1 }):Play()

        task.delay(0.13, function()
            if Token == TabTooltipToken and TabTooltip then
                TabTooltip.Visible = false
            end
        end)
    end

