        function Adaptive.Sample(Fps: number)
            Adaptive.Fps = Fps
            if not Adaptive.Enabled or not Adaptive.Focused then
                Adaptive.Low = 0
                return
            end
            if os.clock() - Adaptive.Started < 20 then
                return
            end
            local CapOption = Library.Options.CorvusFPSCap
            local Cap = CapOption and tonumber(CapOption.Value)
            if Cap and Cap <= Adaptive.Threshold + 5 then
                Adaptive.Low = 0
                return
            end
            local NoRender = Library.Toggles.CorvusNoRender
            if NoRender and NoRender.Value then
                Adaptive.Low = 0
                return
            end
            if Fps < Adaptive.Threshold then
                Adaptive.Low += 1
            else
                Adaptive.Low = 0
                return
            end
            if os.clock() - Adaptive.LastAction < 20 then
                return
            end
            local Toggle = Library.Toggles.CorvusAntiLag
            local LevelOption = Library.Options.CorvusAntiLagLevel
            if not Toggle then
                return
            end
            if not AntiLag.Enabled and Adaptive.Low >= 8 then
                Adaptive.LastAction = os.clock()
                Adaptive.Low = 0
                if LevelOption and AntiLag.Level < 2 then
                    LevelOption:SetValue("Balanced")
                end
                Toggle:SetValue(true)
                Adaptive.Raised = if LevelOption then LevelOption.Value else "Balanced"
                Library:Notify({
                    Title = "Adaptive anti lag",
                    Description = string.format("FPS dropped to %d, anti lag is now on (%s)", math.floor(Fps + 0.5), tostring(Adaptive.Raised)),
                    Time = 6,
                })
            elseif AntiLag.Enabled and AntiLag.Level < 3 and Adaptive.Low >= 12 and LevelOption then
                Adaptive.LastAction = os.clock()
                Adaptive.Low = 0
                LevelOption:SetValue("Ultra")
                Adaptive.Raised = "Ultra"
                Library:Notify({
                    Title = "Adaptive anti lag",
                    Description = string.format("Still %d FPS, switched anti lag to Ultra", math.floor(Fps + 0.5)),
                    Time = 6,
                })
            end
        end

