local PlanSpeed = { value = nil, at = -1e9 }
local function glideTo(target, speedFn, keepGoing)
N.Moves.last = nil
local last = os.clock()
local expected
local startRoot = rootPart()
local checkAt, checkDistance = os.clock(), startRoot and (target - startRoot.Position).Magnitude or 0
while alive() do
local root = rootPart()
if not root then
return false
end
if (target - root.Position).Magnitude <= 0.05 then
break
end
if keepGoing and not keepGoing() then
return false
end
task.wait()
local now = os.clock()
local dt = math.clamp(now - last, 0, 0.1)
last = now
root = rootPart()
if not root then
return false
end
if expected and (root.Position - expected).Magnitude > 15 then
N.Moves.pushes += 1
log(
"MOVE pushed while gliding",
math.floor((root.Position - expected).Magnitude) .. " studs",
brief(expected),
"->",
brief(root.Position)
)
end
local offset = target - root.Position
local distance = offset.Magnitude
if distance <= 0.05 then
break
end
if now - checkAt >= 0.75 then
if checkDistance - distance < math.max(1, math.min(speedFn(), 1000) * (now - checkAt) * 0.2) then
N.Moves.blocked += 1
log("MOVE blocked", math.floor(distance) .. " studs left", brief(root.Position), "->", brief(target))
return false, "blocked"
end
checkAt, checkDistance = now, distance
end
local step = math.min(distance, speedFn() * dt)
local nextPos = root.Position + offset.Unit * step
root.CFrame = facing(root, root.Position, nextPos)
stopMotion(root)
expected = nextPos
end
N.Moves.last = nil
return placeRoot(target)
end
local HeightCache = { cells = {}, count = 0 }
local function cachedGround(x, z)
local cx, cz = math.floor(x / 64), math.floor(z / 64)
local key = cx * 100000 + cz
local value = HeightCache.cells[key]
if value == nil then
if HeightCache.count > 20000 then
table.clear(HeightCache.cells)
HeightCache.count = 0
end
value = groundAt(cx * 64 + 32, cz * 64 + 32) or false
HeightCache.cells[key] = value
HeightCache.count += 1
end
return value or nil
end
local function cruiseHeight(from, to, sampler, spacing)
local distance = flat(from, to)
local offset = N.hrpOffset()
local highest = math.max(from.Y, to.Y) - offset
local samples = math.clamp(math.floor(distance / spacing), 2, 140)
for i = 1, samples - 1 do
local t = i / samples
local y = sampler(from.X + (to.X - from.X) * t, from.Z + (to.Z - from.Z) * t)
if y and y > highest then
highest = y
end
end
local cruise = highest + offset + math.clamp(optionNumber("FlyHeight", 25), 5, 400)
return math.min(cruise, skyY() - 25)
end
local function planPath(from, to)
local distance = flat(from, to)
if distance < 30 or optionText("TravelPath", "Over terrain") == "Straight line" then
return { to }
end
local params = rayParams()
local cruise = cruiseHeight(from, to, function(x, z)
return groundAt(x, z, params)
end, 45)
if cruise <= math.max(from.Y, to.Y) + 2 then
return { to }
end
return { Vector3.new(from.X, cruise, from.Z), Vector3.new(to.X, cruise, to.Z), to }
end
local function pathLength(from, to)
local distance = flat(from, to)
if distance < 30 or optionText("TravelPath", "Over terrain") == "Straight line" then
return (to - from).Magnitude
end
local cruise = cruiseHeight(from, to, cachedGround, 64)
if cruise <= math.max(from.Y, to.Y) + 2 then
return (to - from).Magnitude
end
return distance + (cruise - from.Y) + (cruise - to.Y)
end
local function plannedSpeed(mode)
if mode ~= "Safe" or N.isRiding() or not on("RideOnTrips") then
return N.modeSpeed(mode)
end
if os.clock() - PlanSpeed.at > 5 then
PlanSpeed.at = os.clock()
local pick = N.ridePetChoice()
PlanSpeed.value = if pick then N.petRideSpeed(pick) * math.clamp(optionNumber("SafePercent", 95), 50, 100) / 100 else nil
end
return math.max(PlanSpeed.value or 0, N.modeSpeed(mode))
end
local function travelSeconds(from, to, mode, carry)
if mode == "Blatant" then
return 0.2
end
return pathLength(from, to) / math.max(plannedSpeed(mode) * (carry or 1), 1)
