local function activeWeathers()
local serverData = ReplicatedStorage:FindFirstChild("ServerData")
if not serverData then
return {}
end
local raw = serverData:GetAttribute("WeatherSnapshotV2")
local snapshot = type(raw) == "string"
if not snapshot then
raw = serverData:GetAttribute("ActiveWeathers")
end
if type(raw) ~= "string" then
return {}
end
local ok, data = pcall(function()
return HttpService:JSONDecode(raw)
end)
if not ok or type(data) ~= "table" then
return {}
end
if snapshot then
data = type(data.Weathers) == "table" and data.Weathers or {}
end
local now = serverNow()
local list = {}
for _, entry in pairs(data) do
if type(entry) == "table" and type(entry.Type) == "string" and tonumber(entry.EndsAt) and entry.EndsAt > now then
table.insert(list, { name = entry.Type, left = entry.EndsAt - now })
end
end
table.sort(list, function(a, b)
return a.left < b.left
end)
return list
end
function N.weatherText()
