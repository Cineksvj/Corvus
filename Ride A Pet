function N.Analytics.addGoal(label, text)
local kind
for key, meta in pairs(GoalMeta) do
if meta.label == label then
kind = key
end
end
if not kind then
notify("Goals", "Pick a goal first", 4)
return false
end
if #Saved.goals >= 4 then
notify("Goals", "You can track 4 goals at once, remove one first", 4)
return false
end
local target = parseAmount(text)
if not target or target <= 0 then
notify("Goals", "Type a target like 10b, 500k or 1.5t", 4)
return false
end
local current = GoalMeta[kind].current()
if type(current) == "number" and current >= target then
notify("Goals", "You already have " .. formatNumber(current) .. ", pick a higher target", 5)
return false
end
table.insert(
Saved.goals,
{ id = string.format("%d-%d", os.time(), math.random(1, 999999)), kind = kind, target = target, created = os.time() }
)
N.SaveDirty = true
notify("Goals", "Tracking " .. formatNumber(target) .. " " .. GoalMeta[kind].label, 3)
N.Analytics.draw(true)
return true
end
function N.Analytics.removeGoal(id)
for i = #Saved.goals, 1, -1 do
local goal = Saved.goals[i]
if type(goal) ~= "table" or goal.id == id then
table.remove(Saved.goals, i)
end
end
N.SaveDirty = true
N.Analytics.draw(true)
end
function N.Analytics.clearGoals()
local removed = 0
for i = #Saved.goals, 1, -1 do
local goal = Saved.goals[i]
if type(goal) ~= "table" or goal.done then
table.remove(Saved.goals, i)
removed += 1
end
end
N.SaveDirty = true
notify(
"Goals",
if removed > 0
then "Removed " .. removed .. " reached goal" .. (if removed == 1 then "" else "s")
else "No reached goals to clear",
3
)
N.Analytics.draw(true)
end
function N.Analytics.goalCards(check)
local cards = {}
for _, goal in ipairs(Saved.goals) do
local meta = type(goal) == "table" and GoalMeta[goal.kind]
local target = meta and tonumber(goal.target)
if meta and target and target > 0 then
local ok, current = pcall(meta.current)
current = if ok then current else nil
if check and not goal.done and type(current) == "number" and current >= target then
goal.done = true
goal.doneAt = os.time()
N.SaveDirty = true
local text = formatNumber(target) .. " " .. meta.label
notify("Goal reached", text, 6)
Track.event("Goal", "Goal reached", text, "target", meta.color)
emit("goal", text)
end
local note
if goal.done then
local ago = if goal.doneAt then math.max(0, os.time() - goal.doneAt) else 0
note = '<font color="#60d696">Reached</font>'
.. (
if ago >= 60
then "  \u{00B7}  " .. (if Library.FormatDuration
then Library:FormatDuration(ago)
else (ago // 60 .. "m")) .. " ago"
else ""
)
elseif type(current) ~= "number" then
note = "Waiting for data"
else
local left = eta(meta.metric, target - current)
note = if left
then left .. " at your current rate"
elseif meta.metric then formatNumber(target - current) .. " to go  \u{00B7}  rate warming up"
else formatNumber(target - current) .. " to go"
end
table.insert(cards, {
Id = goal.id,
Title = meta.label,
Icon = meta.icon,
Color = meta.color,
Progress = if type(current) == "number" then math.clamp(current / target, 0, 1) else 0,
Done = goal.done == true,
Value = string.format(
'%s  <font transparency="0.45">/ %s</font>',
if type(current) == "number" then formatNumber(current) else "?",
formatNumber(target)
),
Note = note,
})
end
end
return cards
end
