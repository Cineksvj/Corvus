local function dipCandidate()
local now = serverNow()
for _, child in ipairs(N.basketItems()) do
local until_ = child:GetAttribute("VolcanoUntil")
if
child:GetAttribute("VolcanoDipped") ~= true
and child:GetAttribute("Delivering") ~= true
and (type(until_) ~= "number" or now >= until_)
then
local name = tostring(child:GetAttribute("Egg") or child.Name)
if allows(Options.VolcanoRarities, N.eggRarity(name)) then
return child, name
end
end
end
return nil
end
local function volcanoDip()
if not on("VolcanoDip") then
return false
end
local child, name = dipCandidate()
local top = N.volcanoTop()
local root = rootPart()
local home = homePos()
if not child or not top or not root or not home then
return false
end
local hover = N.volcanoHover(top, 35)
local mode = N.moveMode()
local deadline = tonumber(child:GetAttribute("BreakAt")) or (serverNow() + 20)
local bonus = tonumber(N.VolcanoData.BonusSeconds) or 12
local carry = carrySlowdown()
local need = travelSeconds(root.Position, hover, "Safe", carry) + 11 + travelSeconds(hover, home, "Safe", carry) + N.deliveryMargin()
if serverNow() + need > deadline + bonus - 1 then
log("VOLCANO skipped, not enough time", string.format("need %.0fs", need))
return false
end
setStatus("Dipping " .. name .. " in the volcano")
N.travelTo(hover, {
mode = mode,
carry = carry,
keepGoing = function()
return child.Parent ~= nil
end,
})
if not N.overVolcano(top) then
log("VOLCANO could not get over the lava pool", brief(hover))
return false
end
Volcano.result = nil
fire("Net/VolcanoDip")
Session.dips += 1
N.holdStill(1.5)
local started = os.clock()
while alive() and os.clock() - started < 16 do
local result = Volcano.result
if result and tonumber(result.ArriveAt) and serverNow() >= result.ArriveAt + 0.3 then
break
end
local until_ = child.Parent and child:GetAttribute("VolcanoUntil")
if not result and os.clock() - started > 4 and type(until_) ~= "number" then
log("VOLCANO the dip did not start")
break
end
N.holdStill(0.25)
end
return true
end
