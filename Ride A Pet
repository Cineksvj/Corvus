-- Fusion machine: starting a fusion uses up pets and is a gamble, so it stays manual.
-- Revealing and collecting a finished fusion is safe and repeats, so it is automated.
-- First try from where you stand; if the state does not move and "Go To Fusion Machine" is on,
-- walk next to the machine (its take prompt works within 30 studs) and try again there.
N.Fusion = { tries = 0, lastState = nil, part = nil }
function N.fusionMachine()
local F = N.Fusion
if F.part and F.part.Parent then
return F.part
end
local function find(root)
for _, d in ipairs(root and root:GetDescendants() or {}) do
if d.Name == "FusionOutput" and d:IsA("BasePart") then
return d
end
end
return nil
end
F.part = find(workspace:FindFirstChild("Functionals")) or find(N.myPlot())
return F.part
end
local function fusionAction(slots)
local status = slots:GetAttribute("FusionStatus")
if status == "Waiting" then
local ends = tonumber(slots:GetAttribute("EndsAt"))
if ends and workspace:GetServerTimeNow() >= ends then
return "reveal", function()
fire("Game/FusionAction", "Fuse")
end
end
elseif status == "Result" then
if slots:GetAttribute("FusionFailed") == true then
return "clear", function()
fire("Game/FusionAction", "Claim", slots:GetAttribute("FusionResultKey"))
end
end
local result = LocalPlayer:FindFirstChild("FusionResult")
local pet = result and result:FindFirstChild("Pet")
if pet then
return "collect", function()
fire("Game/FusionAction", "Claim", pet:GetAttribute("PetKey"))
end
end
end
return nil, nil
end
function N.fusionTick()
local slots = LocalPlayer:FindFirstChild("FusionSlots")
if not slots then
return false
end
local F = N.Fusion
local kind, act = fusionAction(slots)
if not kind then
F.tries = 0
F.lastState = nil
return false
end
local state = kind .. "|" .. tostring(slots:GetAttribute("EndsAt"))
if F.lastState ~= state then
F.lastState = state
F.tries = 0
end
F.tries += 1
local machine = N.fusionMachine()
local root = rootPart()
local far = machine ~= nil and root ~= nil and (root.Position - machine.Position).Magnitude > 20
if F.tries >= 2 and far and on("FusionGoToMachine") and not N.manualRunning() then
task.spawn(N.runManual, function()
setStatus("Walking to the fusion machine")
local spot = machine.Position + Vector3.new(0, 3, 0)
local dir = rootPart() and (rootPart().Position - machine.Position) or Vector3.new(1, 0, 0)
dir = Vector3.new(dir.X, 0, dir.Z)
if dir.Magnitude > 0.5 then
spot += dir.Unit * 8
end
N.travelTo(spot)
task.wait(0.4)
local _, again = fusionAction(slots)
if again then
again()
end
task.wait(1.5)
log("FUSION", kind, "at the machine")
end)
return true
end
if F.tries <= 3 or F.tries % 6 == 0 then
act()
log("FUSION", kind, if far then "(from a distance)" else "")
end
return true
end
