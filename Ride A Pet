local Odds = { cache = {}, luck = nil }
function N.eggOdds(eggName)
local luck = N.eggLuck(eggName) * N.luckMultiplier()
local key = eggName .. "|" .. tostring(luck)
local cached = Odds.cache[key]
if cached then
return cached
end
local list = {}
local entries, total = isolated(N.LuckData.GetOdds, luck, N.EggsData[eggName])
if type(entries) == "table" then
local sum = 0
for _, entry in ipairs(entries) do
if type(entry) == "table" and type(entry.PetName) == "string" then
local chance = tonumber(entry.Chance)
if not chance then
chance = (tonumber(entry.Weight) or 0) / math.max(tonumber(total) or 1, 1e-9)
end
sum += chance
table.insert(list, { name = entry.PetName, chance = chance })
end
end
if sum > 1.5 then
for _, entry in ipairs(list) do
entry.chance /= sum
end
end
table.sort(list, function(a, b)
return a.chance > b.chance
end)
end
Odds.cache[key] = list
if count(Odds.cache) > 300 then
table.clear(Odds.cache)
end
return list
end
