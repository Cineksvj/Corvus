local values = M.series(metric, range, points)
local average = M.mean(values)
local current = M.current(metric)
local now = M.now()
local labels = {}
for i = 1, points do
local t = now - range + range * (i - 1) / (points - 1)
local ok, text = pcall(os.date, "%H:%M", math.floor(t))
labels[i] = if ok then text else ""
end
local events = {}
for i = #M.events, 1, -1 do
local event = M.events[i]
if #events >= 12 then
break
end
if tonumber(event.t) and event.t >= now - range then
local ok, color = pcall(Color3.fromHex, tostring(event.c or ""))
table.insert(events, {
Index = math.floor((event.t - (now - range)) / range * (points - 1) + 0.5) + 1,
Color = if ok then color else Library.Scheme and Library.Scheme.AccentColor,
Text = event.x,
})
end
end
