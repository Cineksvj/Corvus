function N.eggScore(info, from)
local pick = optionText("FarmPriority", "Best Value")
local mutated = N.mutationFactor(info.mutation) * N.mutationFactor(info.spawnMutation)
local value = info.luck * mutated * math.max(info.weight, 0.5)
if optionText("FarmMutated", "Any") == "Prefer mutated" and mutated > 1 then
value *= 1000
end
local distance = if from then flat(from, info.pos) else 0
if on("RadarFirst") and nearRadar(info.pos) then
return 1e30 - distance
end
if on("AdminFirst") and (info.admin or info.spotlight) then
return 1e29 + value
end
if pick == "Rarest" then
return info.rank * 1e18 + value
elseif pick == "Heaviest" then
return info.kg * 1e6 + value / 1e12
elseif pick == "Nearest" then
return -distance
elseif pick == "New Pets First" then
return N.newPetChance(info.name) * 1e20 + value
end
