local function placeableEggs()
local list = {}
for _, info in ipairs(N.eggTools()) do
if
allows(Options.PlaceRarities, info.rarity)
and info.kg >= N.optionAmount("PlaceMinKG", 0)
and (PlotState.placeFails[info.item] or 0) < 3
then
table.insert(list, info)
end
end
local order = optionText("PlaceOrder", "Best Value")
table.sort(list, function(a, b)
local va, vb
if order == "Rarest" then
va, vb = a.rank * 1e18 + a.luck, b.rank * 1e18 + b.luck
elseif order == "Heaviest" then
va, vb = a.kg, b.kg
elseif order == "Fastest Hatch" then
va, vb = -a.grow, -b.grow
else
va = a.luck * N.mutationFactor(a.mutation) * N.mutationFactor(a.spawnMutation) * a.weight
vb = b.luck * N.mutationFactor(b.mutation) * N.mutationFactor(b.spawnMutation) * b.weight
end
if va ~= vb then
return va > vb
end
return a.name < b.name
end)
return list
end
