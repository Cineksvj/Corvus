local parts = {}
for _, entry in ipairs(list) do
local cfg = type(N.WeatherData.Data) == "table" and N.WeatherData.Data[entry.name]
local extra = if type(cfg) == "table" and type(cfg.Description) == "string"
then ' <font transparency="0.45">' .. cfg.Description .. "</font>"
else ""
table.insert(parts, "<b>" .. entry.name .. "</b> " .. clockText(entry.left) .. extra)
end
return table.concat(parts, "\n")
end
end
