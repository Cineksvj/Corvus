local now = serverNow()
for _, info in ipairs(N.worldEggs()) do
info.distance = flat(from, info.pos)
info.wanted = N.eggWanted(info) and not N.skipped(info.id)
local ok = N.reachInfo(info, from)
info.reachable = ok
info.newChance = N.newPetChance(info.name)
info.waitDrop = math.max(0, info.dropEndsAt - now)
table.insert(list, info)
end
table.sort(list, function(a, b)
if a.wanted ~= b.wanted then
return a.wanted
end
local sa, sb = N.eggScore(a, from), N.eggScore(b, from)
if sa ~= sb then
return sa > sb
end
return a.distance < b.distance
end)
