local function goToEgg(info, carry)
local target = info.pos + Vector3.new(0, N.hrpOffset() + 0.5, 0)
local function keepGoing()
return info.cfg.Parent ~= nil and not eggClaimed(info.cfg, info.name) and (on("AutoFarm") or N.manualRunning())
end
local cfg = N.eggConfig(info.name)
if type(cfg) == "table" and cfg.RequiresVolcano == true then
local inside, why = N.enterVolcano(keepGoing)
log("VOLCANO entering for", info.name, if inside then "inside" else "not marked inside: " .. tostring(why or "no answer"))
if not keepGoing() then
return false
end
end
setStatus(string.format("Going for %s (%s KG, %s)", info.name, formatNumber(info.kg), info.rarity))
return N.travelTo(target, {
carry = carry,
keepGoing = keepGoing,
})
end
local function grab(info, carry)
if not goToEgg(info, carry) then
if info.cfg.Parent == nil or eggClaimed(info.cfg, info.name) then
log("TRIP egg gone before we got there", info.name)
else
skipEgg(info.id, 15, "could not reach")
end
return false
end
local wait = info.dropEndsAt - serverNow()
if wait > 0 then
setStatus("Waiting for " .. info.name .. " to land")
N.holdStill(math.min(wait + 0.1, 8))
end
local delay = optionNumber("PickupDelay", 0.2)
if delay > 0 then
N.holdStill(delay * (0.8 + math.random() * 0.4))
end
local ok, why = pickUp(info)
if not ok and why == "full" then
return false, "full"
end
return ok
end
local function runTrip(first)
Track.trip()
Farm.lastTarget = first
N.mount()
local got = grab(first)
if got then
local limit = math.min(N.basketCapacity(), math.max(1, optionNumber("EggsPerTrip", 1)))
while alive() and #N.basketItems() < limit and (on("AutoFarm") or N.manualRunning()) do
local root = rootPart()
local home = homePos()
local deadline = N.soonestBreak()
if not root or not home or not deadline then
break
end
local mode = N.moveMode()
local carry = carrySlowdown()
local nextEgg = targetList(root.Position, function(info)
if mode == "Blatant" then
return true
end
local arrive = travelSeconds(root.Position, info.pos, mode, carry) + optionNumber("PickupDelay", 0.2) + 0.5
local back = travelSeconds(info.pos, home, "Safe", math.min(carry, N.carryMultiplier(info.weight, info.name)))
return serverNow() + arrive + back <= deadline - N.deliveryMargin()
end)[1]
if not nextEgg then
break
end
local _, why = grab(nextEgg, carry)
if why == "full" then
break
end
end
for _ = 1, 5 do
if not volcanoDip() then
break
end
end
end
if #N.basketItems() > 0 then
N.deliverBasket()
end
return got
end
function N.farmStep()
N.watchBasket()
if #N.basketItems() > 0 then
N.deliverBasket()
return true
end
local root = rootPart()
if not root then
return false
end
local list = targetList(root.Position)
local first = list[1]
if not first then
Farm.idleReason = "No eggs match right now"
return false
end
Farm.idleReason = nil
runTrip(first)
return true
end
function N.goHome(reason)
local home = homePos()
local root = rootPart()
if not home or not root or N.onPlot(root.Position, -3) then
return
end
if reason then
setStatus(reason)
end
N.travelTo(home)
end
end
