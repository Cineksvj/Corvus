function N.travelTo(target, opts)
opts = opts or {}
local root = rootPart()
if not root or not target then
return false
end
local mode = opts.mode or N.moveMode()
-- The game now checks how carried eggs reach the base ("Egg Delivery Failed | CODE AT"): with eggs in the
-- basket the trip always goes at the pet's own speed, never Fast or a teleport.
if mode ~= "Safe" and #N.basketItems() > 0 then
mode = "Safe"
end
if mode == "Blatant" or (target - root.Position).Magnitude < 0.5 then
Noclip.travel = true
local ok = placeRoot(target)
task.wait(0.05)
Noclip.travel = false
return ok
end
local speedFn = if mode == "Safe"
then function()
return N.safeSpeed() * (opts.carry or 1)
end
else function()
return N.modeSpeed(mode)
end
Noclip.travel = on("TravelNoclip") or optionText("TravelPath", "Over terrain") == "Straight line"
local ok = true
local path = planPath(root.Position, target)
for index, point in ipairs(path) do
local done, why = glideTo(point, speedFn, opts.keepGoing)
if not done and why == "blocked" then
if N.isRiding() then
log("MOVE the ride stops at walls, getting off to noclip through")
N.dismount()
end
Noclip.travel = true
done = glideTo(point, speedFn, opts.keepGoing)
if done and index < #path and not N.isRiding() and on("RideOnTrips") then
N.mount()
end
end
if not done then
ok = false
break
end
end
Noclip.travel = false
return ok
end
