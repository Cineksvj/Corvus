		end
		N.ZoneSweep.running = true
		N.ZoneSweep.last = "searching the map for the " .. zone .. " portal"
		task.spawn(function()
			local started = os.clock()
			local points = N.zoneSweepPoints()
			local n = 0
			local streamHung0, streamSkipped0 = N.Stream.hung, N.Stream.skipped
			local okSweep, err = pcall(function()
				for _, p in ipairs(points) do
					if os.clock() - started > 90 or not alive() then
						break
					end
					n += 1
					N.streamAround(p, 2)
					local hit = waitFor(function()
						for _, z in ipairs({ "Forest", "Winter", "Desert" }) do
							N.notePortal(z)
						end
						if N.upgradePoint and not N.place("UpgradeStation") then
							local up = N.upgradePoint()
							if up then
								N.learnPlace("UpgradeStation", N.posOf(up))
							end
						end
						return N.ZoneSweep.found[zone] ~= nil
					end, 0.3)
					if hit then
						break
					end
				end
			end)
			N.ZoneSweep.running = false
			N.ZoneSweep.doneAt = os.clock()
			if not N.ZoneSweep.found[zone] then
				N.ZoneSweep.missAt = os.clock()
			end
			-- R5-1 (live 3097: 91 of 91 points, no Zones.Portals part, Island.World1 empty): the zones are not in this game
			-- version. Remembered per PlaceVersion (PROBE zone_portals), so no unlock trip goes to the Spawn for them again;
			-- only a complete sweep with every streaming request answered counts, and a portal that streams in later undoes it.
			do
				local island = workspace:FindFirstChild("Island")
				local w1 = island and island:FindFirstChild("World1")
				local zonesFolder = workspace:FindFirstChild("Zones")
				local portalsFolder = zonesFolder and zonesFolder:FindFirstChild("Portals")
				local anyPart = portalsFolder ~= nil and portalsFolder:FindFirstChildWhichIsA("BasePart", true) ~= nil
				local found = next(N.ZoneSweep.found) ~= nil
				-- R6-4: Potassium leaves some streaming requests unanswered (R5-4); up to a fifth of the points may go unanswered
				local missed = (N.Stream.hung - streamHung0) + (N.Stream.skipped - streamSkipped0)
				if okSweep and not found and not anyPart and n >= #points and (w1 == nil or #w1:GetChildren() == 0) and missed <= #points / 5 then
					N.probeResult("zone_portals", "rejected", string.format("absent: %d of %d map points streamed, no zone portal, Island.World1 models %d (the game keeps the zone upgrades locked)", n, #points, if w1 then #w1:GetChildren() else 0), "absent")
				end
			end
			local parts = {}
			for _, z in ipairs({ "Forest", "Winter", "Desert" }) do
				if N.ZoneSweep.found[z] then
					table.insert(parts, z .. "@" .. brief(N.ZoneSweep.found[z]))
				end
			end
			if not okSweep then
				log("PLACE sweep stopped by an error: " .. string.sub(tostring(err), 1, 120))
			end
			if #parts > 0 then
				N.ZoneSweep.last = "found " .. table.concat(parts, " ")
				log(string.format("PLACE sweep %d points, found %s (%.0fs)", n, table.concat(parts, " "), os.clock() - started))
			else
				local world1 = workspace:FindFirstChild("Island")
				world1 = world1 and world1:FindFirstChild("World1")
				N.ZoneSweep.last = "no portal on the map, next sweep in 60 min"
				log(string.format("PLACE sweep done, no portal (next in 60 min): %d of %d points in %.0fs, World1 models %d", n, #points, os.clock() - started, if world1 then #world1:GetChildren() else 0))
			end
		end)
		return "searching"
	end

	-- ===== Values. One passive tap = TapFormula.GetPassiveAmount (3097 L387770; the multiplier of the island the player
	-- stands on). Another island's tap = that tap x (its multiplier / the current one), IslandConfig Multiplier. =====
	local function islandMult(name)
		local info = N.islandInfo(name)
		if info then
			return tonumber(info.Multiplier) or 1
		end
		return tonumber(N.tableOr(N.zoneInfo(N.currentZone())).Multiplier) or 1
	end
	function N.passiveTap(island)
		local data = N.data()
		local base = 0
		if data then
			for _, key in ipairs({ "GetPassiveAmount", "GetPassiveMultiplier" }) do
				local fn = N.G.Tap[key]
				if base <= 0 and type(fn) == "function" then
					local okP, v = pcall(fn, data)
					if okP and N.finite(v) and v > 0 then
						base = v
					end
				end
			end
		end
		if base <= 0 then
			base = math.max(N.income() / 10, 1)
		end
		if island then
			base = base * islandMult(island) / math.max(islandMult(N.currentIsland()), 0.01)
		end
		return base
	end
	function N.incomeSeconds(coins)
		local income = N.income()
		return if income > 0 and N.finite(coins) then coins / income else 0
	end
	-- What a boost potion is worth in income-seconds (BoostConfig Multi x Duration; REV-10: Coins on the tap share of the
	-- income, Luck by the power the extra luck adds per hatch at h, Gems at the gems the rebirth presses earn in that time x
	-- N.gemWorth, the Octo Incubator by the x8 hatches over x3).
	function N.tapShare()
		local income = N.income()
		local taps = tonumber(N.Tap.coinRate) or 0
		return if income > 0 and taps > 0 then math.clamp(taps / income, 0.05, 1) else 1
	end
	function N.boostValue(name)
		local def = N.tableOr(N.tableOr(N.tableOr(N.W).Boosts).Definitions)[name]
		if type(def) ~= "table" then
			return 0
		end
		local multi = tonumber(def.Multi or def.Value or def.Multiplier) or 0
		local duration = tonumber(def.Duration) or 600
		if def.Type == "Luck" then
			return N.luckGain(math.max(multi - 1, 0)) * N.hatchWeight() * duration
		elseif def.Type == "Gems" then
			local rate = if N.Plan then N.Plan.gemRate or 0 else 0
			return multi * rate * duration * (if N.gemWorth then N.gemWorth() else 0)
		elseif def.Type == "OctoHatch" then
			return if N.hasX8() then 0 else (8 / 3 - 1) * N.hatchWeight() * duration
		end
		return multi * duration * N.tapShare()
	end

	-- ===== B19 Tap chests (TapChestConfig 3097 L363841-363973): Sky Island 525 taps first / 2625 again, Desert 1400 /
	-- 7000, cooldown 21600 s, ClaimReach 45; the "hits" are the client's animation only (TapChestController 149377-149458).
	-- TapChestService.RF.Claim(Id) (149358) from within 45 studs of the TapChest model (tag TapChest, attribute TapChestId)
	-- when TapChests[Id] (the ready time) has passed. The coins are passive taps at the chest's island. =====
	function N.validTapChest(id)
		return type(id) == "string" and N.tableOr(X.TapChest.Chests)[id] ~= nil
	end
	local function chestModel(id)
		for _, m in ipairs(CollectionService:GetTagged(X.TapChest.Tag or "TapChest")) do
			if m:GetAttribute("TapChestId") == id and m:IsDescendantOf(workspace) then
				return m
			end
		end
		return nil
	end
	-- R13: ignoreHeld = the game's own state (STATE claimable counts a ready chest even while a failed try rests)
	function N.tapChestsDue(only, ignoreHeld)
		local out = {}
		local data = N.data()
		if not data then
			return out
		end
		local now = N.serverTime()
		for id, c in pairs(N.tableOr(X.TapChest.Chests)) do
			if type(c) == "table" and (only == nil or c.Island == only) and N.islandUnlocked(c.Island) and (ignoreHeld or not held("chest " .. id)) then
				local readyAt = tonumber(N.sub(data, "TapChests")[id]) or 0
				if readyAt <= now then
					local claims = tonumber(N.sub(data, "TapChestClaims")[id]) or 0
					local taps = tonumber(if claims > 0 then c.RepeatTaps else c.Taps) or 0
					local coins = taps * N.passiveTap(c.Island)
					table.insert(out, { id = id, island = c.Island, taps = taps, coins = coins, value = N.incomeSeconds(coins) })
				end
			end
		end
		table.sort(out, function(a, b)
			return a.value > b.value
		end)
		return out
	end
	-- R7-2: why a chest the panel shows as ready waits (the last failed try and when the next one comes)
	function N.tapChestHeld(id)
		local left = (Xtra.fail["chest " .. id] or 0) - os.clock()
		if left > 0 then
			return string.format("retry in %s: %s", N.longTime(left), tostring(Xtra.chestWhy and Xtra.chestWhy[id] or "last try failed"))
		end
		return nil
	end
	local function chestFailed(c, why, seconds)
		Xtra.chestWhy = Xtra.chestWhy or {}
		Xtra.chestWhy[c.id] = why
		backoff("chest " .. c.id, seconds)
		log(string.format("CHEST %s %s (next try in %s)", c.island, why, N.longTime(seconds)))
	end
	function N.tapChestTrip(only)
		local list = N.tapChestsDue(only)
		if #list == 0 then
			return 0
		end
		N.tripBegin("tap chests")
		local got = 0
		for _, c in ipairs(list) do
			N.loopStatus("Main", "opening the " .. c.island .. " tap chest")
			if not N.travel(c.island) then
				chestFailed(c, "travel failed (" .. tostring(N.Travel and N.Travel.last or "?") .. ")", 600)
			else
				local model = N.findStreamed("TapChest" .. c.id, function()
					return chestModel(c.id)
				end, 4)
				local part = N.standPart(model)
				local pos = part and part.Position
				if pos then
					N.teleport(pos + Vector3.new(0, 3, 6), 0.3)
					local coins0 = N.coins()
					local result = invoke("TapChestService.RF.Claim", c.id)
					-- R13 (OWNER_RULES 24): Success AND the chest's ready time moved into the future (Data.TapChests[id],
					-- TapChestConfig.GetReadyAt bc 232972-232979)
					local moved = okResult(result) and waitFor(function()
						return (tonumber(N.sub(N.data(), "TapChests")[c.id]) or 0) > N.serverTime()
					end, 3)
					if okResult(result) and not moved then
						chestFailed(c, "FAILED answer=" .. brief(result) .. " (the chest still shows ready)", 600)
					elseif okResult(result) then
						got += 1
						Xtra.counts.chests += 1
						local paid = tonumber(result.Amount or result.Coins or result.Reward)
						local gained = if paid and N.finite(paid) and paid > 0 then paid else math.max(N.coins() - coins0, 0)
						if gained <= 0 then
							gained = c.coins
						end
						N.incomeWindfall(gained)
						if Xtra.chestWhy then
							Xtra.chestWhy[c.id] = nil
						end
						Xtra.last.chests = string.format("%s +%s coins", c.island, formatNumber(gained))
						log(string.format("CHEST %s +%s coins (%d is) ok, ready again in %s", c.island, formatNumber(gained), math.floor(N.incomeSeconds(gained)), N.longTime((tonumber(N.sub(N.data(), "TapChests")[c.id]) or 0) - N.serverTime())))
					else
						chestFailed(c, "refused: " .. brief(result), 1800)
					end
				else
					chestFailed(c, "chest not found on the island", 1800)
				end
			end
		end
		N.tripEnd()
		return got
	end

	-- ===== B17 Island breakables (IslandBreakableConfig 3097 L362509-362673): one per island, ready at
	-- IslandBreakables[Id], spawned for the player near workspace.IslandBreakableSpots:GetAttribute(Id) (AppearRange 100,
	-- IslandBreakableSigns 127496-127524), tagged "Breakable" with BreakableOwner = our UserId and BreakableType = the
	-- spot's Type (BreakableConfig 361972-362004). Ordinary taps hit it within TapRange 14 / TapHeight 12 (InRange
	-- 362136-362148); it hops away when hit, so the hub follows it. Reward: Taps x passive tap + the honey pot ingredient
	-- (CloudPuff, PumpkinSeeds, GlowSpore + Slime, CactusFruit, CrystalShard, VoidEssence). =====
	N.TargetClickTreats = 24
	-- 2x Coins treats in stock: items owned + the hours still running (ActiveTreats.PetClicks2x = seconds left, 3097
	-- L161214-161236). One treat = an hour of x3 tap coins (ActiveTreatConfig Multiplier 2 added to 1, L150013-150026).
	function N.clickTreatStock()
		local left = tonumber(N.sub(N.sub(N.data(), "Items"), "ActiveTreats").PetClicks2x) or 0
		return N.itemCount("PetClicks2x") + math.max(left, 0) / 3600
	end
	-- REV-4: an hour of the treat's measured multiplier (TapResult.PetClickTreatMultiplier; the config's +2 = x3 until seen)
	-- on the tap share of the income, while fewer than a day of treats are in stock (more are not used inside the horizon).
	function N.clickTreatValue()
		if N.clickTreatStock() >= N.TargetClickTreats then
			return 0
		end
		local mult = tonumber(N.Tap.petClickMult)
		if not mult or mult <= 1 then
			mult = 3
		end
		return (mult - 1) * 3600 * N.tapShare()
	end
	-- REV-4/REV-10: pet levels and XP are worth the power they add to the coin team (income follows the equipped power),
	-- for the horizon: +L levels on the equipped pet with the most room adds base x L / 199 power (PetPower: power x (1 +
	-- Level / 199), 3097 L381172); XP turns into levels at that pet's next-level cost (TreatXP.GetXPToLevel).
	local Horizon = 86400
	local function levelTarget()
		local best, bestPet, bestId = 0, nil, nil
		for id in pairs(N.equippedSet()) do
			local pet = N.owned()[id]
			if type(pet) == "table" and N.maxLevel(pet) - (tonumber(pet.Level) or 1) > 0 then
				local p = N.petPower(id)
				if p > best then
					best, bestPet, bestId = p, pet, id
				end
			end
		end
		return bestPet, bestId, best
	end
	function N.levelValue(levels)
		local team = N.equippedPower()
		local pet, _, power = levelTarget()
		if not pet or team <= 0 or not levels or levels <= 0 then
			return 0
		end
		local level = tonumber(pet.Level) or 1
		local add = math.min(levels, N.maxLevel(pet) - level)
		local base = power / (1 + level / 199)
		return base * add / 199 / team * Horizon
	end
	function N.xpValue(xp)
		local pet = levelTarget()
		if not pet or not xp or xp <= 0 then
			return 0
		end
		local level = tonumber(pet.Level) or 1
		local need = 0
		if type(N.G.TreatXP.GetXPToLevel) == "function" then
			local okN, n = pcall(N.G.TreatXP.GetXPToLevel, pet, level + 1)
			need = if okN and N.finite(n) then n else 0
		end
		if need <= 0 and type(N.G.PetLevel.GetXPRequirement) == "function" then
			local okR, n = pcall(N.G.PetLevel.GetXPRequirement, level)
			need = if okR and N.finite(n) then n else 0
		end
		if need <= 0 then
			return 0
		end
		return N.levelValue(xp / need)
	end
	-- What one item is worth now, in income-seconds (REV-4, REV-10): XP items by their XP (OriginalItemCatalog XP), +10
	-- Levels by 10 levels, the 2x Coins treat by its hour of extra tap coins, the 2x Pet XP treat by the levels the team
	-- gains in an hour, honey ingredients by the best recipe they feed (output value / inputs), totems and dials by boost
	-- x duration on what they boost, gems at N.gemWorth. Slime, crystals and shards buy nothing the hub uses: 0.
	local Recipes = nil
	function N.itemValue(name, depth)
		depth = depth or 0
		if name == "Gems" then
			return if N.gemWorth then N.gemWorth() else 0
		elseif name == "PetLevels10" then
			return N.levelValue(10)
		elseif name == "PetClicks2x" then
			return N.clickTreatValue()
		elseif name == "PetXP3x" then
			local hours = math.max((os.clock() - Session.started) / 3600, 0.25)
			return N.levelValue(Session.levelUps / hours)
		elseif name == "RainDial" or name == "AcidDial" then
			local length = 60
			return if name == "RainDial" then 0.25 * length * N.tapShare() else N.luckGain(0.5) * N.hatchWeight() * length
		end
		local totem = N.tableOr(X.Totems[name])
		if next(totem) ~= nil then
			local m = (tonumber(totem.Multiplier) or 1) - 1
			local d = tonumber(totem.Duration) or 300
			if name == "TotemOfClicks" then
				return m * d * N.tapShare()
			elseif name == "TotemOfRebirths" then
				return m * d
			elseif name == "TotemOfHatchSpeed" then
				return N.hatchSpeedGain(m) * d * N.hatchWeight()
			end
			return N.luckGain(m) * N.hatchWeight() * d
		end
		local def = N.tableOr(N.tableOr(N.G.Items)[name])
		if tonumber(def.XP) then
			return N.xpValue(tonumber(def.XP))
		end
		-- an ingredient: the best recipe it feeds (one level deep)
		if depth == 0 then
			Recipes = Recipes or N.tableOr(N.G.HoneyPot.ByKey)
			local best = 0
			for key, recipe in pairs(Recipes) do
				if type(recipe) == "table" then
					local inputs, uses = 0, 0
					for _, v in pairs(N.tableOr(recipe.Inputs)) do
						if type(v) == "table" and type(v.Key) == "string" then
							inputs += tonumber(v.Amount) or 1
							if v.Key == name then
								uses += tonumber(v.Amount) or 1
							end
						end
					end
					if uses > 0 and inputs > 0 then
						best = math.max(best, N.itemValue(tostring(key), 1) / inputs)
					end
				end
			end
			return best
		end
		return 0
	end
	function N.ingredientValue(name)
		return N.itemValue(name)
	end
	local function spotPos(id)
		local folder = workspace:FindFirstChild("IslandBreakableSpots")
		local v = folder and folder:GetAttribute(id)
		return if typeof(v) == "Vector3" then v else nil
	end
	local BreakAttr = N.tableOr(X.Breakable.Attributes)
	local function liveBreakable(kind)
		for _, m in ipairs(CollectionService:GetTagged(X.Breakable.Tag or "Breakable")) do
			if m:GetAttribute(BreakAttr.Owner or "BreakableOwner") == LocalPlayer.UserId and m:GetAttribute(BreakAttr.Type or "BreakableType") == kind and m:GetAttribute(BreakAttr.Broken or "BreakableBroken") ~= true and m:IsDescendantOf(workspace) then
				return m
			end
		end
		return nil
	end
	function N.breakablesDue(only)
		local out = {}
		local data = N.data()
		if not data then
			return out
		end
		local now = N.serverTime()
		for id, s in pairs(N.tableOr(X.IslandBreak.Spots)) do
			if type(s) == "table" and (only == nil or s.Island == only) and N.islandUnlocked(s.Island) and not held("break " .. id) and spotPos(id) then
				local readyAt = tonumber(N.sub(data, "IslandBreakables")[id]) or 0
				if readyAt <= now then
					local coins = (tonumber(s.Taps) or 0) * N.passiveTap(s.Island)
					local value = N.incomeSeconds(coins) + N.ingredientValue(s.Ingredient) * (tonumber(s.Amount) or 0)
					table.insert(out, { id = id, spot = s, island = s.Island, value = value })
				end
			end
		end
		table.sort(out, function(a, b)
			return a.value > b.value
		end)
		return out
	end
	local function breakSpot(b)
		local s = b.spot
		N.loopStatus("Main", "breaking the " .. tostring(s.Title) .. " on " .. s.Island)
		if not N.travel(s.Island) then
			return false
		end
		local pos = spotPos(b.id)
		if not pos then
			return false
		end
		local before = N.itemCount(s.Ingredient)
		local started = os.clock()
		-- broken = the server moved its ready time (the taps of the tap loop can finish it while the hub is still landing)
		local function broken()
			return (tonumber(N.sub(N.data(), "IslandBreakables")[b.id]) or 0) > N.serverTime()
		end
		N.teleport(pos + Vector3.new(0, 3, 0), 0.2)
		local model = waitFor(function()
			return broken() or liveBreakable(s.Type) ~= nil
		end, 6) and liveBreakable(s.Type)
		if not model and not broken() then
			backoff("break " .. b.id, 300)
			log("BREAK", s.Island, tostring(s.Title), "did not appear")
			return false
		end
		while model and os.clock() - started < 25 and alive() and not broken() do
			if not model.Parent or model:GetAttribute(BreakAttr.Broken or "BreakableBroken") == true then
				break
			end
			local at = N.posOf(model)
			local root = N.root()
			if at and root then
				pcall(function()
					root.CFrame = CFrame.new(at + Vector3.new(3, 2, 0))
				end)
			end
			-- the tap loop taps while Auto Tap (or the planner) runs; otherwise this trip taps itself
			if not N.does("AutoTap") then
				N.tapOnce()
			end
			task.wait(0.11)
		end
		waitFor(function()
			return N.itemCount(s.Ingredient) > before
		end, 2)
		local got = N.itemCount(s.Ingredient) - before
		Xtra.counts.breaks += 1
		Xtra.last.breaks = string.format("%s +%d %s", tostring(s.Title), got, tostring(s.Ingredient))
		log(string.format("BREAK %s %s +%d %s %.1fs", s.Island, tostring(s.Title), got, tostring(s.Ingredient), os.clock() - started))
		if got <= 0 then
			backoff("break " .. b.id, 120)
		end
		return got > 0
	end
	function N.breakableTrip(only)
		local list = N.breakablesDue(only)
		if #list == 0 then
			return 0
		end
		N.tripBegin("breakables")
		N.incomeHold(60)
		local done = 0
		-- every ready spot of that island (one island per trip)
		local island = list[1].island
		for _, b in ipairs(list) do
			if b.island == island and breakSpot(b) then
				done += 1
			end
		end
		N.tripEnd()
		return done
	end

	-- ===== B21 Shiny Stars (ShinyStarConfig 3097 L363459-363643): 15 one-time stars, models tagged ShinyStar with
	-- ShinyStarId + ShinyStarCenter (ShinyStarController addStar 140408-140449), ShinyStarService.RF.Collect(Id) within
	-- ServerReach 22 (requestCollect 140336-140363, answer {Success, Found, Total, JustUnlocked, Already}). All 15 raise the
	-- hatch mutation chance from 2 % to 4 %. =====
	function N.validShinyStar(id)
		if type(id) ~= "string" then
			return false
		end
		for _, s in ipairs(N.tableOr(X.Stars.Stars)) do
			if type(s) == "table" and s.Id == id then
				return true
			end
		end
		return false
	end
	function N.starsLeft()
		local found = N.sub(N.sub(N.data(), "ShinyStars"), "Found")
		local out = {}
		for _, s in ipairs(N.tableOr(X.Stars.Stars)) do
			if type(s) == "table" and found[s.Id] ~= true and N.islandUnlocked(s.Island) and not held("star " .. tostring(s.Id)) then
				table.insert(out, s)
			end
		end
		return out
	end
	local function starModel(id)
		local attr = X.Stars.IdAttribute or "ShinyStarId"
		for _, m in ipairs(CollectionService:GetTagged(X.Stars.Tag or "ShinyStar")) do
			if m:GetAttribute(attr) == id then
				return m
			end
		end
		local folder = workspace:FindFirstChild(X.Stars.Folder or "ShinyStars")
		if folder then
			for _, d in ipairs(folder:GetDescendants()) do
				if d:GetAttribute(attr) == id then
					return d
				end
			end
		end
		return nil
	end
	function N.shinyStarTrip()
		local left = N.starsLeft()
		if #left == 0 then
			return 0
		end
		N.tripBegin("shiny stars")
		local started = os.clock()
		local got = 0
		local byIsland, order = {}, {}
		for _, s in ipairs(left) do
			if not byIsland[s.Island] then
				byIsland[s.Island] = {}
				table.insert(order, s.Island)
			end
			table.insert(byIsland[s.Island], s)
		end
		local here = N.currentIsland()
		table.sort(order, function(a, b)
			if (a == here) ~= (b == here) then
				return a == here
			end
			return a < b
		end)
		for _, island in ipairs(order) do
			if os.clock() - started > 120 or not alive() then
				break
			end
			N.loopStatus("Main", "collecting Shiny Stars on " .. island)
			if N.travel(island) then
				for _, s in ipairs(byIsland[island]) do
					local model = waitFor(function()
						return starModel(s.Id) ~= nil
					end, 3) and starModel(s.Id)
					local center = model and model:GetAttribute(X.Stars.CenterAttribute or "ShinyStarCenter")
					if typeof(center) ~= "Vector3" and model then
						center = N.posOf(model)
					end
					if typeof(center) == "Vector3" then
						N.teleport(center + Vector3.new(0, 1, 0), 0.2)
						local result = invoke("ShinyStarService.RF.Collect", s.Id)
						if okResult(result) then
							got += 1
							Xtra.counts.stars += 1
							log(string.format("STAR %s found %s/%s", s.Id, tostring(result.Found or "?"), tostring(result.Total or X.Stars.Total or 15)))
						else
							backoff("star " .. s.Id, 3600)
							log("STAR", s.Id, "refused:", brief(result))
						end
					else
						backoff("star " .. s.Id, 1800)
						log("STAR", s.Id, "not found on", island)
					end
				end
			end
		end
		N.tripEnd()
		return got
	end
	-- What the stars change: Shiny mutations per hatch (HatchMutationFormula; measured on the hatch answers, one line per
	-- 10 minutes while hatching).
	local Mut = { pets = 0, shiny = 0, at = os.clock() }
	N.Mutations = Mut
	N.onEvent("EggService.RE.EggHatchResult", function(r)
		if type(r) ~= "table" or r.Success ~= true or type(r.Pets) ~= "table" then
			return
		end
		for _, pet in ipairs(r.Pets) do
			if type(pet) == "table" then
				Mut.pets += 1
				if pet.Mutation == "Shiny" then
					Mut.shiny += 1
				end
			end
		end
		if os.clock() - Mut.at >= 600 and Mut.pets > 0 then
			Mut.at = os.clock()
			log(string.format("HATCH shiny mutation %d of %d hatches (%.2f %%, stars %d/%d)", Mut.shiny, Mut.pets, Mut.shiny / Mut.pets * 100, count(N.sub(N.sub(N.data(), "ShinyStars"), "Found")), tonumber(X.Stars.Total) or 15))
		end
	end)
	-- I-3518: a mutation's power multiplier, read from the game's own PetPower.GetFromBase (the table is local there);
	-- fallback = the 3518 values (L407903-407909).
	local MutFallback = { Shiny = 1.3, Void = 1.5, Electric = 1.35, Solar = 1.45, Galaxy = 1.5 }
	local MutCache = {}
	function N.mutationMult(name)
		if MutCache[name] then
			return MutCache[name]
		end
		local m = MutFallback[name] or 1
		local fn = N.G.PetPower.GetFromBase
		if type(fn) == "function" then
			local okA, a = pcall(fn, { Name = "", Mutation = name, Tier = "Normal", Level = 0 }, 1000)
			local okB, b = pcall(fn, { Name = "", Tier = "Normal", Level = 0 }, 1000)
			if okA and okB and N.finite(a) and N.finite(b) and b > 0 and a >= b then
				m = a / b
			end
		end
		MutCache[name] = m
		return m
	end
	-- What one more star is worth (income-seconds over the 24 h horizon): the chance gain once all are found x the Shiny
	-- power bonus x the share of the team that hatches replace within the horizon (half of it, the team keeps its best),
	-- split over the stars still missing.
	function N.shinyStarValue()
		local left = #N.starsLeft()
		local gain = (tonumber(X.Stars.UnlockedMutationChance) or 0.04) - (tonumber(X.Stars.BaseMutationChance) or 0.02)
		local bonus = N.mutationMult("Shiny") - 1
		if left <= 0 or gain <= 0 or bonus <= 0 then
			return 0
		end
		local life = if N.enchantLife then N.enchantLife() else 86400
		local replaced = 0.5 * math.min(1, 86400 / math.max(life, 1))
		return gain * bonus * replaced * 86400 / left
	end

	-- ===== B24 NPC quests: Boingo's Big Bounce (NpcQuestConfig 3097 L388103-388329, NpcQuestController 205506-205543,
	-- 206200-206224, 206382-206404). Once the tutorial is done (IsAvailable = OnboardingConfig.DeriveStep == nil):
	-- NpcQuestService.RF.Talk {Line="BouncyBall"} at the Boingo model (tag Interactable, InteractableId "Boingo"), 1000 taps
	-- and 20 eggs (counted by the server), the 5 Bounce Cores (RF.Collect {Line, Core} within CollectRange 14 of the fixed
	-- positions; the game's own client also collects within 7 studs), Sky Island, Talk again -> 5 Slime. =====
	local function boingoLine()
		return N.tableOr(N.tableOr(X.Npc.Lines).BouncyBall)
	end
	local function boingoEntry()
		local e = N.sub(N.data(), "NpcQuests").BouncyBall
		return if type(e) == "table" then e else nil
	end
	function N.validCore(id)
		for _, c in ipairs(N.tableOr(boingoLine().Cores)) do
			if type(c) == "table" and c.Id == id then
				return true
			end
		end
		return false
	end
	local function npcAvailable()
		local fn = X.Npc.IsAvailable
		local data = N.data()
		if type(fn) == "function" and data then
			local okA, yes = pcall(fn, data)
			if okA then
				return yes == true
			end
		end
		return N.levelingUnlocked()
	end
	-- "talk" | "cores" | "wait <step>" | nil (done or not offered yet)
	function N.boingoStep()
		local line = boingoLine()
		if line.Id == nil then
			return nil
		end
		local entry = boingoEntry()
		if entry and entry.Done == true then
			return nil
		end
		if not entry then
			return if npcAvailable() then "talk" else nil
		end
		local step = N.tableOr(line.Steps)[tonumber(entry.Step) or 1]
		if type(step) ~= "table" or step.Kind == "Talk" then
			return "talk"
		end
		if step.Kind == "Collect" then
			return "cores"
		end
		local complete = false
		if type(X.Npc.IsStepComplete) == "function" then
			local okC, yes = pcall(X.Npc.IsStepComplete, line, entry, N.data())
			complete = okC and yes == true
		end
		return if complete then "talk" else "wait: " .. string.lower(tostring(step.Title or step.Id))
	end
	function N.boingoDue()
		local s = N.boingoStep()
		return (s == "talk" or s == "cores") and not held("boingo")
	end
	-- Builder L: seconds left on the Boingo backoff (0 = free); the Main slot waits for it instead of travelling to Spawn
	function N.boingoWait()
		return math.max(0, math.ceil((Xtra.fail["boingo"] or 0) - os.clock()))
	end
	-- Builder J (live 2026-10-11, 3518: `NPC Boingo step 6/6 Return to Boingo`, then `NPC Boingo not found on the main map`
	-- and 30 min off while the game showed "Return to Boingo! Step 5 of 5, Ready!"): only Interactable-tagged models were
	-- looked at, and only for 4 s after the travel. Boingo stands in workspace.NpcQuests, a streamed folder (empty in the
	-- 3518 dump L117/L309; NpcQuestController L211438-211442 reads the BoingoBall from it). Now: NpcQuests (any model or
	-- part named/attributed Boingo, never the BoingoBall), then the Interactable tag (InteractableId "Boingo", L131433), then
	-- a ProximityPrompt whose ActionText/ObjectText names Boingo (full scan, once per try). A model without a part is not
	-- taken (its pivot would be the world origin). Own block: Luau allows 200 live locals per function.
	local boingoModel
	do
		local function hasPart(inst)
			return inst:IsA("BasePart") or inst:FindFirstChildWhichIsA("BasePart", true) ~= nil
		end
		local function isBoingo(inst)
			if inst:GetAttribute("InteractableId") == "Boingo" or inst:GetAttribute("Npc") == "Boingo" then
				return true
			end
			local name = string.lower(inst.Name)
			return string.find(name, "boingo", 1, true) ~= nil and string.find(name, "ball", 1, true) == nil
		end
		function boingoModel(full)
			local found, via = nil, nil
			pcall(function()
				local folder = workspace:FindFirstChild("NpcQuests")
				if folder then
					for _, d in ipairs(folder:GetDescendants()) do
						if (d:IsA("Model") or d:IsA("BasePart")) and isBoingo(d) and hasPart(d) then
							found, via = d, "NpcQuests"
							return
						end
					end
				end
			end)
			if found then
				return found, via
			end
			for _, m in ipairs(CollectionService:GetTagged("Interactable")) do
				if m:GetAttribute("InteractableId") == "Boingo" and m:IsDescendantOf(workspace) and hasPart(m) then
					return m, "Interactable"
				end
			end
			if full then
				pcall(function()
					for _, d in ipairs(workspace:GetDescendants()) do
						if d:IsA("ProximityPrompt") then
							local text = string.lower(tostring(d.ActionText) .. " " .. tostring(d.ObjectText))
							if string.find(text, "boingo", 1, true) then
								local holder = d.Parent
								while holder and holder.Parent and holder.Parent ~= workspace and not holder:IsA("Model") do
									holder = holder.Parent
								end
								if holder and hasPart(holder) then
									found, via = holder, "prompt"
									return
								end
							end
						end
					end
				end)
			end
			return found, via
		end
		-- Stream the spawn area until Boingo is there: the spot he was last seen at, the middle of the 5 core spots (they all lie
		-- "around spawn", NpcQuestConfig 3518 L415073-415093), then the core spots one by one; at most 5 tries (N.streamAround
		-- has its own time limit, Builder E). Returns the model, how it was found, the streams that went through and the number
		-- of NpcQuests children.
		function N.findBoingo()
			local model, via = boingoModel(false)
			if model then
				return model, via, 0, 0
			end
			local points = {}
			if typeof(Xtra.boingoPos) == "Vector3" then
				table.insert(points, Xtra.boingoPos)
			end
			local cores = N.tableOr(boingoLine().Cores)
			local sum, n = Vector3.zero, 0
			for _, c in ipairs(cores) do
				if type(c) == "table" and typeof(c.Position) == "Vector3" then
					sum += c.Position
					n += 1
				end
			end
			if n > 0 then
				table.insert(points, sum / n)
				for _, c in ipairs(cores) do
					if type(c) == "table" and typeof(c.Position) == "Vector3" then
						table.insert(points, c.Position)
					end
				end
			end
			local streamed = 0
			for i = 1, math.min(#points, 5) do
				if not alive() then
					break
				end
				if N.streamAround(points[i], 2) then
					streamed += 1
				end
				waitFor(function()
					return boingoModel(false) ~= nil
				end, 1.5)
				model, via = boingoModel(true)
				if model then
					return model, via, streamed, 0
				end
			end
			local folder = workspace:FindFirstChild("NpcQuests")
			return nil, nil, streamed, if folder then #folder:GetChildren() else 0
		end
	end
	local function coreFound(id)
		return N.tableOr(N.tableOr(boingoEntry()).Found)[id] == true
	end
	-- Builder K: the Main slot's question: "talk" (any talk step, a Ready one too), "cores" while a missing core is not in
	-- its 15 min rest after a refusal, else nil
	function N.boingoWork()
		local s = N.boingoStep()
		if s == "talk" then
			return s
		end
		if s == "cores" then
			for _, c in ipairs(N.tableOr(boingoLine().Cores)) do
				if type(c) == "table" and not coreFound(c.Id) and not held("core " .. tostring(c.Id)) then
					return s
				end
			end
		end
		return nil
	end
	do
		-- own block: its locals end here (Luau allows 200 live locals per function)
		-- `NPC Boingo step n/m <title>` once per step the server moved the quest to.
		local function stepLog()
			local entry = boingoEntry()
			local steps = N.tableOr(boingoLine().Steps)
			if not entry or entry.Done == true then
				return
			end
			local i = tonumber(entry.Step) or 1
			if Xtra.boingoStepLogged ~= i then
				Xtra.boingoStepLogged = i
				local step = N.tableOr(steps[i])
				log(string.format("NPC Boingo step %d/%d %s", i, #steps, tostring(step.Title or step.Id or "?")))
			end
		end
		-- R6-1 (live 2026-10-11: `NpcQuestService.RF.Collect {Core=Dock} -> {Reason=TooFar}`, then no retry; Boards, Honey and
		-- Cloud were taken): Dock (-37, -516, -2088) lies at the end of the dock, ~220 studs from the spawn, and was the first
		-- core of the trip, right after the travel: the dock had not streamed in, the character dropped and the server
		-- measured it away from the core (CollectRange 14, NpcQuestConfig 3097 L388117). Per core now: stream the spot and wait
		-- for its ground (N.teleport: N.streamAround with its own time limit, then up to 2 s for a part under the spot), stand on
		-- it and HOLD the character on the core's position (set every 0.03 s, so nothing has to stand under it) while the
		-- request goes out; on TooFar one step closer (2 studs above -> on the core -> 1 below), at most 3 tries, then that core
		-- rests 15 minutes.
		local CoreSteps = { Vector3.new(0, 2, 0), Vector3.zero, Vector3.new(0, -1, 0) }
		local function holdOn(pos)
			local hold = { on = true }
			-- the holder lives only as long as its trip: a Main turn cut by the Priority watch (p11) takes the trip with it,
			-- the holder must not keep the character on the core under the next turn
			local gen = N.Trip.gen
			task.spawn(function()
				while hold.on and alive() and N.Trip.active and N.Trip.gen == gen do
					local root = N.root()
					if root then
						pcall(function()
							root.CFrame = CFrame.new(pos)
							root.AssemblyLinearVelocity = Vector3.zero
						end)
						N.Move.at = os.clock()
					end
					task.wait(0.03)
				end
			end)
			return hold
		end
		local function collectCore(c)
			local reason = "no answer"
			for try, offset in ipairs(CoreSteps) do
				local at = c.Position + offset
				N.teleport(at, 0.1)
				local hold = holdOn(at)
				-- the game's own client collects within 7 studs (NpcQuestController L206382); the hub asks itself when it did not
				local got = waitFor(function()
					return coreFound(c.Id)
				end, if try == 1 then 0.8 else 0.3)
				if not got then
					task.wait(0.2)
					local result = invoke("NpcQuestService.RF.Collect", { Line = "BouncyBall", Core = c.Id })
					got = okResult(result) or waitFor(function()
						return coreFound(c.Id)
					end, 1)
					if not got then
						reason = if type(result) == "table" then tostring(result.Reason or result.Error or "refused") else "no answer"
					end
				end
				hold.on = false
				if got then
					return true, try
				end
				log(string.format("NPC Boingo core %s try %d refused: %s (%s)", tostring(c.Id), try, reason, if try < #CoreSteps then "one step closer" else "next try in 15 min"))
				if reason ~= "TooFar" and reason ~= "no answer" then
					break
				end
			end
			backoff("core " .. tostring(c.Id), 900)
			return false, reason
		end
		-- Builder L: `force` (only the `boingo` chat command) ignores the boingo backoff; the Main slot respects it (live
		-- 2026-10-11: a forced trip to Spawn every 2 min while Boingo was not streamed). The step must still be "talk" or
		-- "cores". Every try logs its start and end (`NPC Boingo trip ...`).
		function N.boingoTrip(force)
			local s0 = N.boingoStep()
			if s0 ~= "talk" and s0 ~= "cores" then
				if force then
					log("NPC Boingo trip skipped: step=" .. tostring(s0 or "done or not offered"))
				end
				return 0
			end
			if not force and not N.boingoDue() then
				return 0
			end
			N.tripBegin("npc quest")
			local done = 0
			local line = boingoLine()
			log("NPC Boingo trip start step=" .. tostring(s0))
			local travelled = N.travel("Spawn")
			if not travelled then
				log("NPC Boingo trip: travel to Spawn failed")
			end
			if travelled then
				for _ = 1, 6 do
					stepLog()
					local what = N.boingoStep()
					if what == "talk" then
						N.loopStatus("Main", "talking to Boingo")
						local model, via, streamed, kids = N.findBoingo()
						local pos = model and N.posOf(model)
						if not pos then
							-- Builder L: 10 minutes, after 5 trips in a row without him 30 minutes (each trip pulls the
							-- character back to Spawn); the Main slot waits for it
							Xtra.boingoMiss = (Xtra.boingoMiss or 0) + 1
							local wait = if Xtra.boingoMiss >= 5 then 1800 else 600
							backoff("boingo", wait)
							log(string.format("NPC Boingo not found (streamed=%d npcquests=%d) retry in %d s", streamed, kids, wait))
							break
						end
						Xtra.boingoMiss = 0
						if Xtra.boingoPos == nil or (Xtra.boingoPos - pos).Magnitude > 1 then
							log(string.format("NPC Boingo found via=%s at %d, %d, %d", tostring(via), math.floor(pos.X), math.floor(pos.Y), math.floor(pos.Z)))
						end
						Xtra.boingoPos = pos
						N.teleport(pos + Vector3.new(0, 2, 5), 0.3)
						local step0 = tonumber(N.tableOr(boingoEntry()).Step) or 0
						local lastStep = step0 >= #N.tableOr(line.Steps)
						local result = invoke("NpcQuestService.RF.Talk", { Line = "BouncyBall" })
						if not okResult(result) then
							backoff("boingo", 900)
							log("NPC Boingo talk refused:", brief(result))
							break
						end
						done += 1
						Xtra.counts.npc += 1
						local changed = if result.Unlocked ~= nil then "Unlocked" elseif result.Changed == true then "Changed" else "no change"
						log("NPC Boingo talk -> " .. changed)
						-- the Return step (the last one) answers Unlocked, or Changed with the entry turning Done
						local finished = result.Unlocked ~= nil
						if not finished and lastStep and result.Changed == true then
							waitFor(function()
								return N.tableOr(boingoEntry()).Done == true
							end, 2)
							finished = true
						end
						if finished then
							local reward = N.tableOr(line.Reward)
							log(string.format("NPC Boingo done +%s %s", tostring(reward.Amount or 5), tostring(reward.Item or "Slime")))
							Xtra.last.npc = "Boingo's quest done"
							break
						end
						if changed == "no change" then
							backoff("boingo", 600)
							break
						end
						waitFor(function()
							return (tonumber(N.tableOr(boingoEntry()).Step) or 0) ~= step0
						end, 2)
					elseif what == "cores" then
						local cores = N.tableOr(line.Cores)
						local found = 0
						for _, c in ipairs(cores) do
							if coreFound(c.Id) then
								found += 1
							end
						end
						local missed = 0
						for _, c in ipairs(cores) do
							if type(c) == "table" and not coreFound(c.Id) and typeof(c.Position) == "Vector3" and not held("core " .. tostring(c.Id)) and os.clock() - N.Trip.since < 90 then
								N.loopStatus("Main", "collecting Boingo's Bounce Cores (" .. tostring(c.Id) .. ")")
								local got, tries = collectCore(c)
								if got then
									found += 1
									done += 1
									log(string.format("NPC Boingo core %s %d/%d%s", tostring(c.Id), found, #cores, if tries and tries > 1 then " (try " .. tries .. ")" else ""))
								else
									missed += 1
								end
							end
						end
						if not waitFor(function()
							return N.boingoStep() ~= "cores"
						end, 2) then
							backoff("boingo", if missed > 0 then 900 else 600)
							break
						end
					else
						break
					end
				end
				stepLog()
			end
			log(string.format("NPC Boingo trip end done=%d step=%s", done, tostring(N.boingoStep() or "done")))
			N.tripEnd()
			return done
		end
	end

	-- ===== B23 + R6-2 Quests (QuestConfig 3097 L388425-388633, QuestVisibility 388636-388766, QuestController
	-- 208896-209812, EggGoalController 202976-203003, IslandQuestConfig 387941-388100). The client has ONE quest remote,
	-- QuestService.RF.ClaimQuest {Quest} (L209214; RE.QuestAutoClaimed is the server's notice for the AutoClaim ones). There
	-- is no accept or start remote: the SERVER hands a quest out by writing Data.Quests[id] = {Amount, Completed, Claimed}:
	-- the Initial ones {Egg1, Egg2, Egg3, Rebirth1} on a new profile, the Sequel when a quest is claimed (Egg1 ->
	-- EquipPetQuest, GoldenPet1 -> GoldenPet2, NimbusEgg1 -> NimbusEgg2, SkyEgg1 -> SkyEgg2, PumpkinEgg1 -> PumpkinEgg2,
	-- Rebirth1 -> Rebirth2) and the AssignOnIsland ones on that island (Sky Island: NimbusEgg1, SkyEgg1, AutumnPortal;
	-- Autumn: PumpkinEgg1, MushroomPortal). So accepting = claiming at once (the sequel appears) + standing on those
	-- islands once per game version (PROBE quest_assign: accepted = a visit handed a quest out, rejected = no island gives
	-- this account anything more). 3097 has 14 quests + 4 island-board quests + Boingo, so "Quest II" (65) cannot be
	-- reached in this version (the Rewards panel says so). The loop: accept (visit) -> do (the egg quests at that egg x8,
	-- the boards' hatch quests, one Golden craft for the Golden quests) -> claim at once (p05_more N.claimQuests) -> the
	-- sequel; the rebirth quests fill from the rebirth loop, the portal quests from Auto Unlock Islands. =====
	do
		-- own block: its locals end here (Luau allows 200 live locals per function)
		local function eggForQuest(def)
			if type(def.Egg) == "string" then
				return def.Egg
			end
			for egg, group in pairs(N.tableOr(N.G.Quests.EggGroups)) do
				if group == def.Group then
					return egg
				end
			end
			return nil
		end
		-- R6-2: a quest's reward in income-seconds: coins over the income; gems at N.gemWorth (what a gem buys now); rebirths by
		-- the share they add to the rebirth count (a day of income at most); plus 30 s for the next quest it opens.
		local function questRewardValue(def)
			local r = N.tableOr(def.Reward)
			local amount = tonumber(r[3]) or 0
			local value = 30
			if r[1] == "Clicks" then
				value += N.incomeSeconds(amount)
			elseif r[1] == "Gems" then
				value += amount * (if N.gemWorth then N.gemWorth() else 0)
			elseif r[1] == "Rebirths" then
				value += math.min(amount / math.max(N.rebirths(), 1), 1) * 86400 * 0.5
			end
			return value
		end
		N.questRewardValue = questRewardValue
		local GoldenQuests = { GoldenPet = true }
		local function goldenMachine()
			for _, m in ipairs(N.Machines or {}) do
				if m.key == "Golden" then
					return m
				end
			end
			return nil
		end
		function N.questTasks()
			local out = {}
			local data = N.data()
			if not data then
				return out
			end
			local defs = N.tableOr(N.G.Quests.Definitions)
			local quests = N.sub(data, "Quests")
			for id, q in pairs(quests) do
				local def = defs[id]
				if type(def) == "table" and type(q) == "table" and q.Claimed ~= true and q.Completed ~= true and not held("quest " .. tostring(id)) then
					local need = (tonumber(def.Goal) or 1) - (tonumber(q.Amount) or 0)
					local egg = eggForQuest(def)
					if need > 0 and egg and N.validEgg(egg) and N.eggUnlocked(egg) then
						table.insert(out, { kind = "quest", id = tostring(id), egg = egg, need = need, island = N.eggIsland(egg), value = questRewardValue(def) })
					elseif need > 0 and GoldenQuests[def.Group] then
						-- "Turn a pet golden": one craft of a duplicate set (the same craft the machines do when the storage is full)
						local m = goldenMachine()
						if m and N.craftableCount(m) > 0 then
							table.insert(out, { kind = "golden", id = tostring(id), need = need, island = nil, value = questRewardValue(def), machine = m })
						end
					end
				end
			end
			for board, cfg in pairs(N.tableOr(X.Boards.Boards)) do
				if type(cfg) == "table" and N.islandUnlocked(board) then
					local state = N.tableOr(N.sub(data, "IslandQuests")[board])
					for _, bq in ipairs(N.tableOr(cfg.Quests)) do
						local paid = type(bq) ~= "table" or state.Claimed == true or N.tableOr(state.Paid)[bq.Id] == true
						if not paid and bq.Kind == "Hatch" and type(bq.Egg) == "string" and N.validEgg(bq.Egg) and N.eggUnlocked(bq.Egg) and not held("board " .. tostring(bq.Id)) then
							local need = (tonumber(bq.Goal) or 0) - (tonumber(N.tableOr(state.Progress)[bq.Id]) or 0)
							if need > 0 then
								local reward = N.tableOr(N.tableOr(bq.Rewards)[1]).Boost
								table.insert(out, { kind = "board", id = tostring(bq.Id), board = board, egg = bq.Egg, need = need, island = N.eggIsland(bq.Egg), value = N.boostValue(reward) })
							end
						end
					end
				end
			end
			-- R6-2: the islands that hand quests out, once per session while quests are still missing; never again in this game
			-- version once a full round of visits handed nothing out (PROBE quest_assign rejected)
			local completed = tonumber(N.sub(data, "Statistics").QuestsCompleted) or 0
			if completed + count(quests) < count(defs) and N.probeState("quest_assign") ~= "rejected" then
				for id, def in pairs(defs) do
					local island = type(def) == "table" and def.AssignOnIsland
					if type(island) == "string" and quests[id] == nil and N.islandUnlocked(island) and not Xtra.visited[island] then
						table.insert(out, { kind = "visit", id = tostring(id), island = island, value = 30 + questRewardValue(def) })
					end
				end
			end
			table.sort(out, function(a, b)
				return a.value > b.value
			end)
			return out
		end
		-- Hatches `need` eggs of one egg right now (inside a trip: the hatch loop pauses while a trip runs).
		function N.hatchFor(egg, need, cap)
			if not N.goToEgg(egg) then
				return 0
			end
			local started = os.clock()
			local got0 = Session.hatched
			while Session.hatched - got0 < need and os.clock() - started < cap and alive() do
				if not N.atEgg(egg) and not N.goToEgg(egg) then
					break
				end
				local step = N.hatchStep(egg)
				if step == "storage full" or step == "not enough coins" or step == "rebirths first" then
					break
				end
				task.wait(0.05)
			end
			waitFor(function()
				return not N.Hatch.inFlight
			end, 6)
			return Session.hatched - got0
		end
		function N.questTaskTrip()
			local tasks = N.questTasks()
			if #tasks == 0 then
				return 0
			end
			N.questWatch(true)
			N.tripBegin("quest tasks")
			local started = os.clock()
			local done = 0
			local seen = {}
			local golden = nil
			for _, t in ipairs(tasks) do
				if os.clock() - started > 60 or not alive() then
					break
				end
				if t.kind == "visit" then
					if not Xtra.visited[t.island] then
						Xtra.visited[t.island] = true
						N.loopStatus("Main", "picking up the quests on " .. t.island)
						local before = count(N.sub(N.data(), "Quests"))
						if N.travel(t.island) then
							waitFor(function()
								return count(N.sub(N.data(), "Quests")) > before
							end, 4)
							N.questWatch(true)
							local new = math.max(count(N.sub(N.data(), "Quests")) - before, 0)
							done += 1
							Xtra.questVisits = (Xtra.questVisits or 0) + 1
							Xtra.questNew = (Xtra.questNew or 0) + new
							log(string.format("QUEST visit %s: %d new quest%s (the game hands out its quests there)", t.island, new, if new == 1 then "" else "s"))
							if new > 0 and N.probeState("quest_assign") ~= "accepted" then
								N.probeResult("quest_assign", "accepted", string.format("gain=%d quest%s from %s", new, if new == 1 then "" else "s", t.island))
							end
						end
					end
				elseif t.kind == "golden" then
					golden = golden or t
				elseif not seen[t.egg .. t.id] then
					seen[t.egg .. t.id] = true
					N.loopStatus("Main", string.format("hatching %d %s egg%s for a quest", t.need, t.egg, if t.need == 1 then "" else "s"))
					local got = N.hatchFor(t.egg, t.need, 40)
					if got >= t.need then
						done += 1
						Xtra.counts.quests += 1
						if t.kind == "board" then
							local paid = waitFor(function()
								return N.tableOr(N.tableOr(N.sub(N.data(), "IslandQuests")[t.board]).Paid)[t.id] == true
							end, 3)
							log(string.format("QUEST board %s %s %d/%d %s", t.board, t.id, got, t.need, if paid then "paid" else "done"))
						else
							log(string.format("QUEST task %s %s %d/%d", t.id, t.egg, got, t.need))
						end
					else
						backoff((if t.kind == "board" then "board " else "quest ") .. t.id, 900)
						log(string.format("QUEST %s %s hatched %d of %d", t.kind, t.id, got, t.need))
					end
				end
			end
			N.tripEnd()
			-- R6-2: every island that hands quests out was visited and none gave this account anything: nothing is left to take
			-- in this game version (no more visits until the game updates)
			if N.probeState("quest_assign") == "untested" and (Xtra.questVisits or 0) > 0 and (Xtra.questNew or 0) == 0 then
				local left = false
				for _, t in ipairs(N.questTasks()) do
					if t.kind == "visit" then
						left = true
						break
					end
				end
				if not left then
					N.probeResult("quest_assign", "rejected", string.format("gain=0 (%d island visit%s handed out no quest: this account has every quest it can get in this game version)", Xtra.questVisits, if Xtra.questVisits == 1 then "" else "s"))
				end
			end
			-- "Turn a pet golden": one Golden craft of a duplicate set (never equipped, level team, locked or protected pets)
			if golden and alive() then
				N.loopStatus("Main", "crafting a Golden pet for the " .. golden.id .. " quest")
				local okC, crafted = pcall(N.craftTrip, "quest " .. golden.id, golden.machine)
				if okC and (tonumber(crafted) or 0) > 0 then
					done += 1
					Xtra.counts.quests += 1
					log(string.format("QUEST task %s: %d Golden craft%s", golden.id, tonumber(crafted) or 0, if crafted == 1 then "" else "s"))
				else
					backoff("quest " .. golden.id, 900)
				end
			end
			-- claim at once, so the server hands the sequel out right away
			done += N.claimQuests(true)
			return done
		end
	end

	-- ===== B18 Auto Enchant (EnchantConfig 3097 L372365-373322, EnchantService client 186558-186772, EnchantController
	-- roll_ 301229-301440). At the InteractionPoint "Enchant" (Shadow Realm, +3,2,3 box): RF.Enchant {PetId, Slot,
	-- RequestId} -> {Success, Pending={Token, Enchant, Double, Free}}, then RF.Resolve {Token, UseNew}: the new enchant
	-- only when it is better for the goal, else the old one stays. Price 25,000 x 1.015^(pet EnchantRolls) gems
	-- (GetRollPrice 373300-373305). Families I/II/III (Power = Taps 10/20/35 %, Renewal = Rebirths 5/10/15 %, Fortune,
	-- Payday, Lucky ...), singles (Frenzy +40 % taps while tapping, Glass Cannon, Prismatic Surge ...), TeamCap 3 per
	-- family: a fourth copy counts nothing. The hub rolls slot 1 of the best power team. =====
	local GoalWeights = {
		["Taps and Rebirths"] = { Taps = 1, Rebirths = 1, FrenzyMax = 0.9, AutoTaps = 0.3, CritPower = 0.05, CritRecharge = 0.02, Gems = 0.05, RebirthGems = 0.03, JackpotChance = 0.1, Luck = 0.1, SecretLuck = 0.05, GoldenTouch = 0.2, CraftChance = 0.05 },
		Gems = { Gems = 1, RebirthGems = 1, JackpotChance = 2, ProspectorGems = 0.2, LootYield = 0.1, Taps = 0.2, Rebirths = 0.2 },
		Luck = { Luck = 1, SecretLuck = 1, GoldenTouch = 2, FourLeaf = 0.2, NewPetChance = 0.3, CraftChance = 0.3, Taps = 0.1 },
	}
	N.EnchantTarget = 0.3
	-- UI-3: the dropdown names the goal by its effect; the coin goal is the default
	local GoalNames = { ["Coins (Rebirths + Taps)"] = "Taps and Rebirths", ["Gems (Fortune, Payday)"] = "Gems", ["Luck (hatching)"] = "Luck" }
	function N.enchantGoal()
		local goal = optionText("EnchantGoal", "Coins (Rebirths + Taps)")
		goal = GoalNames[goal] or goal
		return if GoalWeights[goal] then goal else "Taps and Rebirths"
	end
	local function enchantDef(name)
		local def = type(name) == "string" and N.tableOr(X.Enchant.Enchants)[name]
		return if type(def) == "table" then def else nil
	end
	function N.enchantScore(name, goal)
		local def = enchantDef(name)
		if not def then
			return 0
		end
		local g = goal or N.enchantGoal()
		local w = GoalWeights[g] or GoalWeights["Taps and Rebirths"]
		local s = 0
		local stats = N.tableOr(def.Stats)
		-- strategy.md item 1: on the coin goal the CritPower / CritRecharge stats are valued by the live crit stack
		-- (N.critWeight: p x P / M x the manual share), not the stale 0.05 / 0.02 that lost to any Taps roll
		local critW = if g == "Taps and Rebirths" and N.critWeight then N.critWeight() else 0
		for k, v in pairs(stats) do
			if type(v) == "number" then
				local wk = w[k] or 0
				if k == "CritPower" then
					wk = math.max(wk, critW)
				elseif k == "CritRecharge" then
					wk = math.max(wk, 0.3 * critW)
				end
				s += v * wk
			end
		end
		if next(stats) == nil and type(def.Type) == "string" then
			s += (tonumber(def.Multi) or 0) * (w[def.Type] or 0) * (if def.Type == "CelestialBond" then 3 else 1)
		end
		return s
	end
	local function familyCount(team, family, except)
		local n = 0
		for id in pairs(team) do
			local pet = id ~= except and N.owned()[id]
			local def = type(pet) == "table" and enchantDef(pet.Enchant)
			if def and def.Family == family then
				n += 1
			end
		end
		return n
	end
	-- What an enchant adds on this pet, given the rest of the team (TeamCap per family, Wildcard counts for every family).
	function N.enchantWorth(name, team, id)
		local def = enchantDef(name)
		if not def then
			return 0
		end
		local others = familyCount(team, def.Family, id)
		if def.Wildcard ~= true and others >= (tonumber(def.TeamCap) or 3) then
			return 0
		end
		local worth = N.enchantScore(name)
		-- REV-10: Resonance (EnchantConfig.Resonance Copies 3, Bonus 0.25, 3097 L372735-372739): the copy that completes 3 of
		-- one family adds the bonus on the whole family's stats
		local res = N.tableOr(X.Enchant.Resonance)
		local copies = tonumber(res.Copies) or 3
		if def.Family and others == copies - 1 then
			local family = worth
			for other in pairs(team) do
				local pet = other ~= id and N.owned()[other]
				local d = type(pet) == "table" and enchantDef(pet.Enchant)
				if d and d.Family == def.Family then
					family += N.enchantScore(pet.Enchant)
				end
			end
			worth += family * (tonumber(res.Bonus) or 0.25)
		end
		return worth
	end
	local function rollPrice(pet)
		local fn = X.Enchant.GetRollPrice
		if type(fn) == "function" then
			local okP, p = pcall(fn, pet)
			if okP and N.finite(p) then
				return p
			end
		end
		return 25000 * 1.015 ^ (tonumber(type(pet) == "table" and pet.EnchantRolls) or 0)
	end
	-- REV-10 (the fixed "1 % of the gems" replaced): a roll is made while its expected gain (about 1 roll in 35 reaches the
	-- target, for as long as the pet stays in the team) beats its gem price at N.gemWorth; at most a quarter of the gems
	-- above the next skill/upgrade's price per trip.
	local function gemBudget()
		local reserve = if N.Spend.pick then N.Spend.pick.cost else 0
		return math.max(N.gems() - reserve, 0) * 0.25
	end
	local function rollPays(price, worth, life)
		local gw = if N.gemWorth then N.gemWorth() else 0
		local value = (1 / 35) * math.max(N.EnchantTarget - worth, 0) * (life or N.enchantLife()) * 0.5
		return value > price * gw
	end
	-- Owner rule 2026-10-10 21:20 (the planner rerolled the enchants of his equipped pets): a pet is left alone when it is in
	-- Never craft or delete, when it is equipped (unless Include equipped pets is on) and when its slot already holds an
	-- enchant (unless Reroll existing enchants is on). Logged once per pet and reason: `ENCHANT skipped <pet>: <why>`.
	function N.enchantBlock(id, pet, equipped, protect)
		if type(pet) ~= "table" then
			return "gone"
		end
		if (protect or N.protectedNames())[pet.Name] then
			return "protected"
		end
		if (equipped or N.equippedSet())[id] and not on("EnchantEquipped") then
			return "equipped"
		end
		if pet.Enchant ~= nil and pet.Enchant ~= false and pet.Enchant ~= "" and not on("EnchantReroll") then
			return "has " .. tostring(pet.Enchant) .. " (reroll off)"
		end
		return nil
	end
	Xtra.skipped = {}
	function N.enchantSkipLog(id, pet, why)
		local key = tostring(id) .. "|" .. why
		if Xtra.skipped[key] then
			return
		end
		if count(Xtra.skipped) > 200 then
			table.clear(Xtra.skipped)
		end
		Xtra.skipped[key] = true
		log(string.format("ENCHANT skipped %s: %s", tostring(type(pet) == "table" and pet.Name or id), why))
	end
	function N.enchantWork()
		local team = N.bestTeam()
		local list = {}
		local budget = gemBudget()
		local life = N.enchantLife()
		local equipped, protect = N.equippedSet(), N.protectedNames()
		for id in pairs(team) do
			local pet = N.owned()[id]
			local why = N.enchantBlock(id, pet, equipped, protect)
			if why then
				N.enchantSkipLog(id, pet, why)
			elseif type(pet) == "table" and pet.Frozen == nil and not held("enchant " .. id) then
				local worth = N.enchantWorth(pet.Enchant, team, id)
				local price = rollPrice(pet)
				if worth < N.EnchantTarget and price <= budget and rollPays(price, worth, life) then
					table.insert(list, { id = id, worth = worth, price = price })
				end
			end
		end
		table.sort(list, function(a, b)
			return a.worth < b.worth
		end)
		return list, team
	end
	-- Expected gain of one enchant trip: about 1 roll in 35 reaches the target (EnchantConfig pool weights), 25 rolls per
	-- pet; the target adds ~0.3 of income for as long as the pet stays in the best team: a day for a settled team, less
	-- while the team's power still grows fast (the enchant leaves with the pet; the time to the next doubling of the
	-- equipped power, from the scheduler's power samples).
	-- How long a pet stays in the best team: the share of the team that left it since a snapshot at least 10 minutes old
	-- (snapshots every 5 minutes); no change = a settled team (a day).
	local TeamSnaps = {}
	function N.enchantLife()
		local now = os.clock()
		local last = TeamSnaps[#TeamSnaps]
		if not last or now - last.t >= 300 then
			local ids = {}
			for id in pairs(N.bestTeam()) do
				ids[id] = true
			end
			table.insert(TeamSnaps, { t = now, ids = ids })
			if #TeamSnaps > 6 then
				table.remove(TeamSnaps, 1)
			end
		end
		local old
		for i = #TeamSnaps, 1, -1 do
			if now - TeamSnaps[i].t >= 600 then
				old = TeamSnaps[i]
				break
			end
		end
		if not old then
			return 86400
		end
		local current = N.bestTeam()
		local total, left = 0, 0
		for id in pairs(old.ids) do
			total += 1
			if not current[id] then
				left += 1
			end
		end
		if total == 0 or left == 0 then
			return 86400
		end
		return math.clamp((now - old.t) * total / left, 600, 86400)
	end
	function N.enchantValue(work)
		local value = 0
		local life = N.enchantLife()
		for _, w in ipairs(work) do
			local hit = 1 - (1 - 1 / 35) ^ 25
			value += hit * (N.EnchantTarget - w.worth) * life * 0.5
		end
		return value
	end
	local function newRequestId()
		local okG, id = pcall(function()
			return HttpService:GenerateGUID(false)
		end)
		if okG and type(id) == "string" and #id <= 64 and not string.find(id, "[\128-\255]") then
			return id
		end
		return string.format("%08x-%04x-%04x-%04x-%08x", math.random(0, 0x7fffffff), math.random(0, 0xffff), math.random(0, 0xffff), math.random(0, 0xffff), math.random(0, 0x7fffffff))
	end
	function N.validEnchantToken(token)
		return type(token) == "string" or N.isInt(token)
	end
	-- Stands inside an InteractionPoint (machines use the same box, p04 N.insidePoint). R4-2: the spot is remembered
	-- (Corvus/TAPSIM_places.txt "Point<Name>") and streamed in before the guessed island is tried; `force` stands again
	-- even when the client thinks the root is inside (the server answered VisitEnchantMachine).
	function N.standIn(part, force)
		if not force and N.insidePoint(part) then
			return true
		end
		local pos = part.Position
		N.teleport(Vector3.new(pos.X, pos.Y - part.Size.Y / 2 + 3, pos.Z), 0.4)
		return N.insidePoint(part)
	end
	function N.goToPoint(pointName, guess)
		local key = "Point" .. pointName
		local function find()
			return N.findPoint(pointName)
		end
		local part = find()
		if not part and N.place(key) then
			part = N.findStreamed(key, find, 3, false)
		end
		if not part and guess and N.travel(guess) then
			part = waitFor(function()
				return find() ~= nil
			end, 5) and find()
		end
		if not part then
			return nil
		end
		N.learnPlace(key, part.Position)
		N.standIn(part)
		return part
	end
	function N.enchantTrip()
		local work, team = N.enchantWork()
		if #work == 0 then
			return 0
		end
		-- R3-3: the trip's gem budget is announced 10 s ahead when it is a big share of the gems
		local estimate = 0
		for _, w in ipairs(work) do
			estimate += (w.price or 0) * 25
		end
		estimate = math.min(estimate, gemBudget())
		if N.gemGate and not N.gemGate("enchant", estimate, string.format("enchant rolls on %d team pet%s for up to %s gems", #work, if #work == 1 then "" else "s", formatNumber(estimate))) then
			return 0
		end
		local life = N.enchantLife()
		local started = os.clock()
		local rolls, kept, spent = 0, 0, 0
		local function reasonOfRoll(result)
			return tostring(type(result) == "table" and result.Reason or "no answer")
		end
		local function roll(id)
			return invoke("EnchantService.RF.Enchant", { PetId = id, Slot = 1, RequestId = newRequestId() })
		end
		-- a roll left open by an earlier session is finished first (the server refuses a new one: ChoosePendingEnchant)
		local function resolveLeftover()
			local pending = N.sub(N.sub(N.data(), "Enchanting"), "Pending")
			if pending.Token ~= nil then
				-- a pet the hub leaves alone (equipped, protected, slot taken) keeps what it has
				local blocked = N.enchantBlock(pending.PetId, N.owned()[pending.PetId]) ~= nil
				invoke("EnchantService.RF.Resolve", { Token = pending.Token, UseNew = not blocked and N.enchantWorth(pending.Enchant, team, pending.PetId) > N.enchantWorth(N.tableOr(N.owned()[pending.PetId]).Enchant, team, pending.PetId) })
			end
		end
		-- R4-2 (live 20:57: `ENCHANT Shinigami roll refused: VisitEnchantMachine` and the summary still counted the refused
		-- rolls). PROBE enchant_remote (ACTION SPEED LADDER rung 1): the first roll goes out from where the player stands;
		-- accepted = every later trip rolls remotely (no visit, the hatching goes on); VisitEnchantMachine = rejected and the
		-- hub stands in the Enchant point (EnchantController opens the window inside the point's box +3,2,3, 3097
		-- L187100-187114). Only Success=true counts as a roll.
		local remote = N.probeState("enchant_remote")
		local first = nil
		if remote == "untested" and not (N.findPoint("Enchant") and N.insidePoint(N.findPoint("Enchant"))) then
			resolveLeftover()
			local w = work[1]
			if rollPrice(N.owned()[w.id]) <= gemBudget() then
				local result = roll(w.id)
				if okResult(result) then
					N.probeResult("enchant_remote", "accepted", "gain=no trip to the Enchant machine")
					remote, first = "accepted", result
				elseif reasonOfRoll(result) == "VisitEnchantMachine" then
					N.probeResult("enchant_remote", "rejected", "gain=0 (VisitEnchantMachine): the machine is visited")
					remote = "rejected"
				end
			end
		end
		local trip = remote ~= "accepted"
		local part = nil
		if trip then
			N.tripBegin("enchant")
			N.loopStatus("Main", "enchanting the best team at the Enchant machine")
			part = N.goToPoint("Enchant", "Shadow Realm")
		end
		if part or not trip then
			if not first then
				resolveLeftover()
			end
			local stood = false
			local stop = false
			for _, w in ipairs(work) do
				local pet = N.owned()[w.id]
				local name = tostring(type(pet) == "table" and pet.Name or w.id)
				local current = type(pet) == "table" and pet.Enchant or nil
				local worth = w.worth
				local perPet, petSpent = 0, 0
				while perPet < 25 and rolls < 60 and os.clock() - started < 45 and alive() do
					if worth >= N.EnchantTarget then
						break
					end
					-- owner rule 21:20: an enchant the hub just put into an empty slot is not rolled over (Reroll existing
					-- enchants off), and a pet that became equipped or protected meanwhile is left alone
					local why = N.enchantBlock(w.id, N.owned()[w.id])
					if (current ~= nil and not on("EnchantReroll")) or why then
						if why and not (current ~= nil and string.sub(why, 1, 4) == "has ") then
							N.enchantSkipLog(w.id, N.owned()[w.id], why)
						end
						break
					end
					local price = rollPrice(N.owned()[w.id])
					if price > gemBudget() or spent + price > estimate or not rollPays(price, worth, life) then
						break
					end
					local result
					if first and w == work[1] then
						result, first = first, nil
					else
						if part and not N.insidePoint(part) then
							N.standIn(part)
						end
						result = roll(w.id)
					end
					-- not where the server wants the player (pushed off the point): stand in it again, one retry per trip
					if not okResult(result) and reasonOfRoll(result) == "VisitEnchantMachine" and part and not stood then
						stood = true
						log("ENCHANT not at the machine for the server: standing in the Enchant point again")
						N.standIn(part, true)
						task.wait(0.5)
						result = roll(w.id)
					end
					if not okResult(result) then
						local reason = reasonOfRoll(result)
						log("ENCHANT", name, "roll refused:", reason)
						if reason == "VisitEnchantMachine" then
							-- the whole trip ends: the next pets would get the same answer
							stop = true
							if not trip then
								-- the remote rung stopped working: the next trip visits the machine (5 minutes from now)
								N.probeResult("enchant_remote", "rejected", "gain=0 (VisitEnchantMachine after an accepted remote roll): the machine is visited")
								backoff("enchant trip", 300)
							else
								backoff("enchant trip", 1800)
							end
						else
							backoff("enchant " .. w.id, if reason == "RateLimited" then 30 else 900)
						end
						break
					end
					rolls += 1
					perPet += 1
					petSpent += price
					spent += price
					Xtra.counts.rolls += 1
					local p = N.tableOr(result.Pending)
					local newWorth = N.enchantWorth(p.Enchant, team, w.id)
					local useNew = newWorth > worth
					local resolved = invoke("EnchantService.RF.Resolve", { Token = p.Token, UseNew = useNew })
					if useNew and okResult(resolved) then
						kept += 1
						Xtra.counts.kept += 1
						current, worth = p.Enchant, newWorth
					end
					task.wait(0.25)
				end
				if perPet > 0 then
					log(string.format("ENCHANT %s slot 1 -> %s (rolls %d, gems %s, worth %.2f)", name, tostring(current or "none"), perPet, formatNumber(petSpent), worth))
				end
				if stop then
					break
				end
			end
			if first then
				-- the probe's roll was not used by the loop: keep it only when it is better
				local p = N.tableOr(first.Pending)
				local w = work[1]
				invoke("EnchantService.RF.Resolve", { Token = p.Token, UseNew = N.enchantBlock(w.id, N.owned()[w.id]) == nil and N.enchantWorth(p.Enchant, team, w.id) > w.worth })
			end
			-- the team's families after the trip
			local fam = {}
			for id in pairs(team) do
				local def = enchantDef(N.tableOr(N.owned()[id]).Enchant)
				if def and def.Family then
					fam[def.Family] = (fam[def.Family] or 0) + 1
				end
			end
			local parts = {}
			for family, n in pairs(fam) do
				table.insert(parts, family .. " x" .. n)
			end
			table.sort(parts)
			Xtra.last.enchant = string.format("%d rolls, %d kept, %s gems%s", rolls, kept, formatNumber(spent), if trip then "" else " (remote)")
			if rolls > 0 then
				log(string.format("ENCHANT team %s (rolls %d, kept %d, gems %s, goal %s%s)", if #parts > 0 then table.concat(parts, " ") else "-", rolls, kept, formatNumber(spent), N.enchantGoal(), if trip then "" else ", remote"))
				-- strategy.md item 1: show the crit weights that drove the keep decision on the coin goal
				if N.enchantGoal() == "Taps and Rebirths" and N.critWeight and N.critStats then
					local cs = N.critStats()
					log(string.format("ENCHANT weights crit=%.2f taps=1.0 (crit share %.2f, power x%.1f, avg x%.2f)", N.critWeight(), cs.p, cs.P, cs.M))
				end
			else
				log("ENCHANT no roll accepted this trip" .. (if stop then " (the machine refused the visit, next try in 30 min)" else ""))
			end
		else
			backoff("enchant trip", 1800)
			log("ENCHANT machine not found (InteractionPoint Enchant)")
		end
		if trip then
			N.tripEnd()
		end
		return kept
	end

	-- ===== B22 Equip Relic (RelicConfig 3097 L386496-386607, MasteryController invokeEquip 133941-133960):
	-- MasteryService.RF.EquipRelic {Name} with the best owned relic of Mastery.RelicInventory, valued like the income it
	-- adds (Tap Ring +20 % taps, Holy Grail +20 % taps +10 % rebirths +20 % hatch ...). =====
	-- strategy.md item 1: CriticalPower was 0.05 (so Holy Grail beat the Tap Ring for coins); it is now the live crit weight,
	-- so a +300% CriticalPower Tap Ring is priced for what it does to the manual income.
	local RelicWeight = { ClickMultiplier = 1, RebirthMultiplier = 1, GoldMachineSpeed = 0.01, MachineShinyChance = 0.02 }
	local function relicWorth(name)
		local def = N.tableOr(N.tableOr(X.Relics.Relics)[name])
		local s = 0
		for _, b in ipairs(N.tableOr(def.Boosts)) do
			if type(b) == "table" then
				local w = RelicWeight[b.Type]
				local v = tonumber(b.Value) or 0
				if b.Type == "CriticalPower" then
					w = if N.critWeight then N.critWeight() else 0.6
				end
				if w == nil then
					-- REV-10: hatch speed at h, luck by the power it adds per hatch
					if b.Type == "HatchSpeed" then
						-- G4 (3937): through the server's hatch hold, not 1:1
						w = if v > 0 then N.hatchSpeedGain(v) / v * N.hatchWeight() else 0
					elseif (b.Type == "Luck" or b.Type == "SecretLuck") and v > 0 then
						w = N.luckGain(v) / v * N.hatchWeight()
					else
						w = 0
					end
				end
				s += v * w
			end
		end
		return s
	end
	function N.ownsRelic(name)
		return type(name) == "string" and N.sub(N.sub(N.data(), "Mastery"), "RelicInventory")[name] == true
	end
	function N.bestRelic()
		local best, bestWorth = nil, -1
		for name, yes in pairs(N.sub(N.sub(N.data(), "Mastery"), "RelicInventory")) do
			if yes == true and type(name) == "string" then
				local w = relicWorth(name)
				if w > bestWorth or (w == bestWorth and best ~= nil and name < best) then
					best, bestWorth = name, w
				end
			end
		end
		return best, bestWorth
	end
	function N.relicStep()
		local best, worth = N.bestRelic()
		local equipped = N.sub(N.data(), "Mastery").EquippedRelic
		if not best or best == equipped or held("relic") then
			return false
		end
		if equipped and type(equipped) == "string" and relicWorth(equipped) >= worth then
			return false
		end
		local result = invoke("MasteryService.RF.EquipRelic", { Name = best })
		if okResult(result) then
			local parts = {}
			for _, b in ipairs(N.tableOr(N.tableOr(N.tableOr(X.Relics.Relics)[best]).Boosts)) do
				if type(b) == "table" then
					table.insert(parts, string.format("%s %s", tostring(b.Name or b.Type), if (tonumber(b.Value) or 0) < 1 then math.floor((tonumber(b.Value) or 0) * 100 + 0.5) .. "%" else tostring(b.Value)))
				end
			end
			Xtra.last.relic = best
			log("RELIC equipped " .. tostring(N.tableOr(N.tableOr(X.Relics.Relics)[best]).Name or best) .. " (" .. table.concat(parts, ", ") .. ")")
			return true
		end
		backoff("relic", 600)
		log("RELIC", best, "refused:", brief(result))
		return false
	end

	-- ===== B20 Totems and weather dials (TotemConfig 3097 L366651-366692, ItemController placeTotem 165673-165695: RF
	-- PlaceTotem {TotemName, Position = a ground point within 100 studs}, at most 5 per player; RF.GetActiveTotems lists
	-- them {Id, TotemName, Position, OwnerId}; WeatherDialController 164528-164575: RF.CanUse(name) then RF.Use(name),
	-- "Rain" (+25 % coins on every tap, 60 s) from a RainDial, "Acid" (+50 % luck) from an AcidDial). Placed at the farming
	-- spot: Rebirths (x1.15 rebirths per press, 300 s), Coins (x1.1, 600 s), Hatch Speed, Luck and Secret Luck while hatching
	-- (the Smart Planner holds the luck totems for the game's Luck / Mythic windows when one starts within 10 min). =====
	N.TotemNames = { TotemOfLuck = true, TotemOfRebirths = true, TotemOfClicks = true, TotemOfSecretLuck = true, TotemOfHatchSpeed = true }
	local TotemActive = {}
	local TotemSyncAt = -1e9
	local function noteTotem(t)
		if type(t) ~= "table" or type(t.TotemName) ~= "string" or (t.OwnerId ~= nil and t.OwnerId ~= LocalPlayer.UserId) then
			return
		end
		local cfg = N.tableOr(X.Totems[t.TotemName])
		local ends = tonumber(t.ExpiresAt or t.EndsAt)
		local left = if ends then ends - N.serverTime() else tonumber(cfg.Duration) or 300
		TotemActive[t.TotemName] = { at = if typeof(t.Position) == "Vector3" then t.Position else nil, untilClock = os.clock() + left }
	end
	N.onEvent("ItemService.RE.TotemPlaced", noteTotem)
	local function groundBelow(pos)
		local hit
		pcall(function()
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { LocalPlayer.Character }
			hit = workspace:Raycast(pos, Vector3.new(0, -20, 0), params)
		end)
		return if hit and typeof(hit.Position) == "Vector3" then hit.Position else pos - Vector3.new(0, 3, 0)
	end
	local function luckWindowSoon()
		local nextLuck = tonumber(workspace:GetAttribute("Event_Luck_NextStartAt"))
		return nextLuck ~= nil and nextLuck - N.serverTime() < 600
	end
	function N.totemStep(planner)
		if N.Trip.active then
			return false
		end
		local egg = N.Hatch.target
		local atSpot = if N.hatchWanted() then (egg ~= nil and N.atEgg(egg)) else N.does("AutoTap")
		local here = N.myPos()
		if not atSpot or not here then
			return false
		end
		local owned = false
		for name in pairs(N.TotemNames) do
			if N.itemCount(name) > 0 then
				owned = true
				break
			end
		end
		if not owned then
			return false
		end
		if os.clock() - TotemSyncAt > 120 then
			TotemSyncAt = os.clock()
			local list = invoke("ItemService.RF.GetActiveTotems")
			if type(list) == "table" then
				for _, t in ipairs(list) do
					noteTotem(t)
				end
			end
		end
		local order = {}
		if N.does("AutoRebirth") then
			table.insert(order, "TotemOfRebirths")
		end
		if N.does("AutoTap") then
			table.insert(order, "TotemOfClicks")
		end
		if N.hatchWanted() then
			table.insert(order, "TotemOfHatchSpeed")
			-- strategy.md items 2+4: place the Luck and Secret Luck totems whenever any luck/secret window is live (Phantom
			-- Fog, Lucky Skies, Blessed Winds, Windy Day, Blood Rain all stack); only hold them for a scheduled Luck window
			local window = N.luckWindowNow and N.luckWindowNow() or (N.eventActive("Luck") or N.eventActive("Mythic"))
			if not planner or window or not luckWindowSoon() then
				table.insert(order, "TotemOfLuck")
				table.insert(order, "TotemOfSecretLuck")
			end
		end
		for _, name in ipairs(order) do
			local cfg = N.tableOr(X.Totems[name])
			local active = TotemActive[name]
			local covered = active ~= nil and active.untilClock > os.clock() and (active.at == nil or (active.at - here).Magnitude <= (tonumber(cfg.Range) or 12))
			if N.itemCount(name) > 0 and not covered and not held("totem " .. name) then
				local result = invoke("ItemService.RF.PlaceTotem", { TotemName = name, Position = groundBelow(here) })
				if okResult(result) then
					TotemActive[name] = { at = here, untilClock = os.clock() + (tonumber(cfg.Duration) or 300) }
					Xtra.counts.totems += 1
					Xtra.last.totems = name
					log(string.format("TOTEM %s placed %ds", name, tonumber(cfg.Duration) or 0))
				else
					backoff("totem " .. name, 300)
					log("TOTEM", name, "refused:", brief(result))
				end
				return true
			end
		end
		return false
	end
	function N.dialStep(planner)
		local hatching = N.hatchWanted()
		local dials = {
			{ item = "RainDial", event = "Rain", want = N.does("AutoTap") },
			{ item = "AcidDial", event = "Acid", want = hatching and (not planner or (N.luckWindowNow and N.luckWindowNow()) or not luckWindowSoon()) },
		}
		for _, d in ipairs(dials) do
			if d.want and N.itemCount(d.item) > 0 and not N.eventActive(d.event) and not held("dial " .. d.event) then
				local can = invoke("WeatherDialService.RF.CanUse", d.event)
				if okResult(can) then
					local result = invoke("WeatherDialService.RF.Use", d.event)
					if okResult(result) then
						Xtra.counts.dials += 1
						Xtra.last.dials = d.event
						log("DIAL " .. d.event .. " used")
						return true
					end
					can = result
				end
				local reason = tostring(type(can) == "table" and can.Reason or "no answer")
				backoff("dial " .. d.event, if reason == "AlreadyActive" then 60 else 600)
				log("DIAL " .. d.event .. " not used: " .. reason)
			end
		end
		return false
	end

	-- ===== B27 Dig site (DigConfig 3097 L368032-368142, DigWorld 368145-368296, DigController 172240-172437): stand in
	-- Ts2Islands.Autumn.Digsite.DigZone, DigService.RF.Begin() -> {Id, Round, Remaining, Maximum, Reward}, then
	-- RF.Hit(Id, Round.Sequence, serverTime) at the moment the cursor (DigConfig.Cursor) is inside the round's zone
	-- (IsHit), at least MinHitInterval 0.16 s apart; 10 games per 3600 s window (Allowance). Reward: a RegularTreat or a
	-- BagOfTreats (XP). The hub hits like a player with perfect timing: it waits for the real moment, then sends the
	-- real server time. =====
	function N.digLeft()
		local fn = X.Dig.Allowance
		if type(fn) ~= "function" then
			return 0
		end
		local okA, left = pcall(fn, N.sub(N.data(), "Digging"), N.serverTime())
		return if okA and type(left) == "number" then left else 0
	end
	function N.digDue()
		return N.islandUnlocked("Autumn") and N.digLeft() > 0 and not held("dig")
	end
	-- The server (and DigWorld.Contains, 3687 L393390-393417) wants the HumanoidRootPart inside the DigZone BOX
	-- (object space |X|<=Size.X/2, |Z|<=Size.Z/2, Y in [-1,9]); the sloped Path part sits off that box. Resolve the
	-- real DigZone (streamed in via findStreamed), never Path. Builder (3687): the old build teleported to
	-- `DigZone or Path` + world (0,3,0) and landed off the box -> `DigService.RF.Begin -> {Error=Stand on the digsite
	-- to dig.}` on the owner's run (live_findings R8 12:40).
	local function digZone()
		local site = N.findStreamed("Digsite", function()
			local okS, s = pcall(function()
				return X.DigWorld.GetSite()
			end)
			if okS and s then
				return s
			end
			local isl = N.islandFolder("Autumn")
			return isl and isl:FindFirstChild("Digsite") or nil
		end, 4, false)
		if not site then
			return nil
		end
		local zone = site:FindFirstChild("DigZone", true)
		if zone and zone:IsA("BasePart") then
			return zone
		end
		return nil
	end
	-- Stand at the CENTRE of the DigZone box (zone.CFrame, so a rotated pad is handled), a little above the floor and
	-- well inside Y<=9; a longer settle so the position replicates to the server before RF.Begin.
	function N.standOnDigZone(zone)
		if not zone or not zone:IsA("BasePart") then
			return false
		end
		N.learnPlace("Digsite", zone.Position)
		return N.teleport((zone.CFrame * CFrame.new(0, 2.5, 0)).Position, 0.5)
	end
	local function nextHitTime(round, from)
		local cursor, isHit = X.Dig.Cursor, X.Dig.IsHit
		if type(cursor) ~= "function" or type(isHit) ~= "function" or type(round) ~= "table" then
			return nil
		end
		local t = math.max(from, (tonumber(round.Epoch) or 0) + 0.02)
		local width = tonumber(round.Width) or 0.2
		local center = tonumber(round.Center) or 0.5
		for _ = 1, 800 do
			local okH, hit = pcall(isHit, round, t)
			if okH and hit then
				local okC, c = pcall(cursor, round, t)
				if okC and type(c) == "number" and math.abs(c - center) <= width * 0.3 then
					return t
				end
			end
			t += 0.01
		end
		return nil
	end
	function N.validDigId(id)
		return type(id) == "string" or N.isInt(id)
	end
	function N.digRun(maxGames)
		maxGames = tonumber(maxGames) or 3
		local zone = digZone()
		if not zone then
			backoff("dig", 1800)
			log("DIG site not found on Autumn")
			return 0
		end
		N.loopStatus("Main", "digging at the Autumn dig site")
		N.standOnDigZone(zone)
		local wins = 0
		local gap = (tonumber(X.Dig.MinHitInterval) or 0.16) + 0.03
		for _ = 1, maxGames do
			if N.digLeft() <= 0 or not alive() then
				break
			end
			-- Begin with an off-pad retry: a cooldown answer is final; any other failure means the HumanoidRootPart is
			-- off the DigZone box ("Stand on the digsite to dig." from the server, "NotAtDigsite" from the client echo),
			-- so stand on the pad centre and retry up to 3 times before giving up.
			local state
			local offPad = false
			for attempt = 1, 3 do
				state = invoke("DigService.RF.Begin")
				if type(state) == "table" and not state.Error and state.Id ~= nil then
					offPad = false
					break
				end
				local cooldown = type(state) == "table" and state.Error == "Cooldown" and tonumber(state.Remaining)
				if cooldown then
					offPad = false
					break
				end
				offPad = true
				if attempt < 3 then
					N.standOnDigZone(zone)
					task.wait(0.35)
				end
			end
			if type(state) ~= "table" or state.Error or state.Id == nil then
				local cooldown = type(state) == "table" and state.Error == "Cooldown" and tonumber(state.Remaining)
				backoff("dig", cooldown or (offPad and 300 or 600))
				log("DIG begin refused:", brief(state), offPad and "(off the digsite, stood on the pad centre and retried)" or "")
				break
			end
			local lastHit = N.serverTime()
			local hits = 0
			while hits < 40 and alive() do
				local t = nextHitTime(state.Round, math.max(N.serverTime() + 0.05, lastHit + gap))
				if not t then
					break
				end
				local ahead = t - N.serverTime()
				if ahead > 0 then
					task.wait(ahead)
				end
				lastHit = N.serverTime()
				local r = invoke("DigService.RF.Hit", state.Id, tonumber(N.tableOr(state.Round).Sequence) or 0, lastHit)
				hits += 1
				if type(r) ~= "table" then
					break
				end
				if r.Error then
					if r.Error ~= "TooSoon" and r.Error ~= "StaleRound" and r.Error ~= "Busy" then
						log("DIG hit refused:", tostring(r.Error))
						break
					end
				elseif r.Complete then
					wins += 1
					Xtra.counts.digs += 1
					local done = tonumber(N.sub(N.data(), "Digging").Completed) or 0
					Xtra.last.dig = tostring(r.Reward)
					log(string.format("DIG win %s %d/%d this hour (%d hits)", tostring(r.Reward), done, tonumber(X.Dig.MaxGames) or 10, hits))
					break
				else
					if type(r.Round) == "table" then
						state.Round = r.Round
					end
					if r.Id ~= nil then
						state.Id = r.Id
					end
				end
			end
		end
		return wins
	end
	function N.digTrip()
		if not N.digDue() then
			return 0
		end
		N.tripBegin("dig")
		local wins = 0
		if N.travel("Autumn") then
			wins = N.digRun(3)
		end
		N.tripEnd()
		return wins
	end

	-- ===== B28 Memory Match (MemoryMatchConfig 3097 L368299-368357, MemoryMatchWorld 368360-368409, MemoryMatchController
	-- 172683-172902): within 24 studs of workspace.MemoryMatch.TouchToPlay, MemoryMatchService.RF.Open(false) reads the
	-- board, RF.Open(true) starts a game (cooldown 1800 s, NextPlay), RF.Flip(Id, i) turns a card; every answer lists the
	-- revealed cards (Cards[i].Pet / Matched), Pairs, Attempts (12), Outcome, Reward, UnlockAt. The hub remembers every
	-- card it saw (perfect memory) and only flips a known pair or an unknown card. Reward: one treat. =====
	local function memoryPad()
		local okP, pad = pcall(function()
			return X.MemoryWorld.GetPad()
		end)
		if okP and pad then
			return pad
		end
		local folder = workspace:FindFirstChild("MemoryMatch")
		return folder and folder:FindFirstChild("TouchToPlay")
	end
	function N.memoryDue()
		return not held("memory") and memoryPad() ~= nil and (Xtra.memoryNext or 0) <= N.serverTime()
	end
	function N.validMemoryBoard(id)
		return type(id) == "string" or N.isInt(id)
	end
	local function closeMemoryMenu()
		pcall(function()
			local menu = require(game:GetService("ReplicatedStorage").Controllers.UI.MenuController)
			if type(menu) == "table" and type(menu.Close) == "function" then
				menu:Close("MemoryMatch")
			end
		end)
	end
	function N.memoryRun()
		local pad = memoryPad()
		if not pad then
			backoff("memory", 1800)
			return false
		end
		N.loopStatus("Main", "playing Memory Match")
		-- 14 studs beside the pad: inside the game's 24-stud reach, outside the pad's own touch box (no menu pops up)
		N.teleport(pad.Position + Vector3.new(14, 3, 0), 0.3)
		-- Live 3983 (Round 12, owner main): the server now answers {Error="Walk onto the Memory Match pad."}; the pad is
		-- workspace.MemoryMatch.TouchToPlay (MemoryMatchWorld.GetPad, bc 234599-234601), "on it" = the client's own box
		-- test (|X|, |Z| <= Size/2 + 1, 0 <= Y <= 8 in pad space, MemoryMatchController bc 60756-60775). Such a refusal
		-- puts the character on the pad centre and asks once more; the menu the pad opens is closed again.
		local function onPad()
			local root = N.root()
			if not root then
				return false
			end
			local okRel, rel = pcall(function()
				return pad.CFrame:PointToObjectSpace(root.Position)
			end)
			return okRel and rel ~= nil and math.abs(rel.X) <= pad.Size.X / 2 + 1 and math.abs(rel.Z) <= pad.Size.Z / 2 + 1 and rel.Y >= 0 and rel.Y <= 8
		end
		local function openOnPad(play)
			local result = invoke("MemoryMatchService.RF.Open", play)
			local err = type(result) == "table" and string.lower(tostring(result.Error or "")) or ""
			if string.find(err, "pad", 1, true) or string.find(err, "walk onto", 1, true) then
				N.teleport(pad.Position + Vector3.new(0, pad.Size.Y / 2 + 3, 0), 0.3)
				waitFor(onPad, 2)
				log("MEMORY pad reached", if onPad() then "(on the pad)" else "(not confirmed)")
				result = invoke("MemoryMatchService.RF.Open", play)
				task.delay(0.5, closeMemoryMenu)
			end
			return result
		end
		local state = openOnPad(false)
		if type(state) ~= "table" or state.Error then
			backoff("memory", 900)
			log("MEMORY board refused:", brief(state))
			return false
		end
		if state.Outcome ~= "Playing" then
			if (tonumber(state.NextPlay) or 0) > N.serverTime() then
				Xtra.memoryNext = tonumber(state.NextPlay)
				return false
			end
			state = openOnPad(true)
			if type(state) ~= "table" or state.Error or state.Id == nil then
				backoff("memory", 900)
				log("MEMORY start refused:", brief(state))
				return false
			end
		end
		local seen = {}
		local flips = 0
		local function remember(s)
			for i, card in pairs(N.tableOr(s.Cards)) do
				if type(card) == "table" and type(card.Pet) == "string" then
					seen[i] = card.Pet
				end
			end
		end
		local function matched(i)
			local card = N.tableOr(state.Cards)[i]
			return type(card) == "table" and card.Matched == true
		end
		local function flip(i)
			local unlock = tonumber(state.UnlockAt) or 0
			if unlock > N.serverTime() then
				task.wait(math.min(unlock - N.serverTime() + 0.05, 2))
			end
			local r = invoke("MemoryMatchService.RF.Flip", state.Id, i)
			flips += 1
			if type(r) == "table" and not r.Error then
				state = r
				remember(r)
				return true
			end
			return false
		end
		remember(state)
		while state.Outcome == "Playing" and flips < 40 and alive() do
			-- a known pair first
			local a, b
			for i, pet in pairs(seen) do
				if not matched(i) then
					for j, other in pairs(seen) do
						if j ~= i and other == pet and not matched(j) then
							a, b = i, j
						end
					end
				end
				if a then
					break
				end
			end
			if not a then
				for i = 1, 12 do
					if seen[i] == nil and not matched(i) then
						a = i
						break
					end
				end
				if not a or not flip(a) then
					break
				end
				task.wait(0.2)
				local pet = seen[a]
				for j, other in pairs(seen) do
					if j ~= a and other == pet and not matched(j) then
						b = j
					end
				end
				if not b then
					for j = 1, 12 do
						if j ~= a and seen[j] == nil and not matched(j) then
							b = j
							break
						end
					end
				end
				if not b or not flip(b) then
					break
				end
			else
				if not flip(a) then
					break
				end
				task.wait(0.2)
				if not flip(b) then
					break
				end
			end
			task.wait(0.2)
		end
		Xtra.memoryNext = tonumber(state.NextPlay) or (N.serverTime() + 1800)
		closeMemoryMenu()
		if state.Outcome == "Won" then
			Xtra.counts.memory += 1
			Xtra.last.memory = "won " .. tostring(state.Reward)
			log(string.format("MEMORY won %s in %d attempts", tostring(state.Reward), tonumber(state.Attempts) or 0))
			return true
		end
		Xtra.last.memory = string.format("%s, %s/6 pairs", tostring(state.Outcome), tostring(state.Pairs or 0))
		log(string.format("MEMORY %s %s/6 pairs in %d attempts", string.lower(tostring(state.Outcome or "stopped")), tostring(state.Pairs or 0), tonumber(state.Attempts) or 0))
		return false
	end
	function N.memoryTrip()
		if not N.memoryDue() then
			return 0
		end
		N.tripBegin("memory match")
		local won = false
		if N.travel("Spawn") then
			won = N.memoryRun()
		end
		N.tripEnd()
		return if won then 1 else 0
	end

	-- ===== REV-12 Pre-steps for a fresh account (owner rule: tutorials and gates are automated). OnboardingConfig (3097
	-- L383827-385420): the intro hands out a starter pet (TutorialService.RF.ChooseStarterPet {Pet}, IntroSequence
	-- chooseOnServer L280933-280944; Doggy, Kitty or Bunny) and the client marks RF.MarkBeat {Beat="Tutorial_Intro"} when
	-- the intro sequence did not finish it (TutorialController L158792-158840); Greg's bridge talk is the beat
	-- "Tutorial_GregBridge" (BeatSteps GregBridgeTalk, L383874-383880). The bridge (BridgeController L23756-26530,
	-- OnboardingBridgeConfig L92413-92500: RequiredTapPower 700, Requirement 8400, Range 10): once the tap power reaches the
	-- bridge power (OnboardingConfig.BridgeChallengeReady), stand within 10 studs of BridgeFightZone.GetCenter() (L92348-92410),
	-- BridgeService.RE.EngageChanged {Engaged=true}, tap; the server answers CrankResult {Progress, Lowered, RoundLost} and
	-- lowers the bridge (Progression.BridgeLowered: pet levels unlock). =====
	local function onboarding()
		return N.G.Onboarding
	end
	function N.starterPet(name)
		local list = N.tableOr(onboarding().StarterPets)
		if #list == 0 then
			list = { "Doggy", "Kitty", "Bunny" }
		end
		return table.find(list, name) ~= nil
	end
	function N.tutorialBeat(name)
		local beats = N.tableOr(onboarding().Beats)
		if next(beats) == nil then
			beats = { Tutorial_Intro = true, Tutorial_GregBridge = true }
		end
		return beats[name] == true
	end
	local function call(fnName, ...)
		local fn = onboarding()[fnName]
		local data = N.data()
		if type(fn) ~= "function" or not data then
			return nil
		end
		local okC, v = pcall(fn, data, ...)
		return if okC then v else nil
	end
	-- Remote-only (the chores loop): the starter pet and the beats.
	function N.tutorialStep()
		local data = N.data()
		if not data then
			return false
		end
		if call("IntroDone") == false then
			if call("CanChooseStarterPet") and not held("starter") then
				-- the strongest of the three (LaunchPetConfig Power)
				local best, bestPower = nil, -1
				local list = N.tableOr(onboarding().StarterPets)
				for _, name in ipairs(if #list > 0 then list else { "Doggy", "Kitty", "Bunny" }) do
					local p = tonumber(N.tableOr(N.tableOr(N.G.PetCfg)[name]).Power) or 0
					if p > bestPower then
						best, bestPower = name, p
					end
				end
				local r = invoke("TutorialService.RF.ChooseStarterPet", { Pet = best })
				log("TUTORIAL starter pet " .. tostring(best) .. " -> " .. (if okResult(r) then "ok" else brief(r)))
				backoff("starter", 120)
				if okResult(r) then
					Xtra.counts.tutorial = (Xtra.counts.tutorial or 0) + 1
				end
			end
			if not waitFor(function()
				return call("IntroDone") ~= false
			end, 2) and not held("beat intro") then
				backoff("beat intro", 600)
				local r = invoke("TutorialService.RF.MarkBeat", { Beat = "Tutorial_Intro" })
				log("TUTORIAL beat Tutorial_Intro -> " .. (if okResult(r) then "ok" else brief(r)))
			end
			return true
		end
		local step = call("DeriveStep")
		if type(step) == "table" and step.Id == "GregBridgeTalk" and N.sub(data, "PromptedUIs").Tutorial_GregBridge ~= true and not held("beat greg") then
			backoff("beat greg", 600)
			local r = invoke("TutorialService.RF.MarkBeat", { Beat = "Tutorial_GregBridge" })
			log("TUTORIAL beat Tutorial_GregBridge -> " .. (if okResult(r) then "ok" else brief(r)))
			return true
		end
		return false
	end
	function N.bridgeDue()
		if N.levelingUnlocked() or held("bridge") then
			return false
		end
		return call("BridgeChallengeReady") == true
	end
	N.Bridge = { progress = 0, lowered = false, lost = 0 }
	N.onEvent("BridgeService.RE.CrankResult", function(r)
		if type(r) == "table" then
			if tonumber(r.Progress) then
				N.Bridge.progress = tonumber(r.Progress)
			end
			if r.Lowered == true then
				N.Bridge.lowered = true
			end
			if r.RoundLost == true then
				N.Bridge.lost += 1
			end
		end
	end)
	local function bridgeArea()
		local o = workspace:FindFirstChild("Onboarding")
		local a = o and o:FindFirstChild("BridgeArea")
		return a and (a:FindFirstChild("PlayerPosition") or a:FindFirstChild("Wheel"))
	end
	function N.bridgeTrip()
		if not N.bridgeDue() then
			return 0
		end
		N.tripBegin("bridge")
		local started = os.clock()
		local done = false
		N.loopStatus("Main", "lowering Greg's bridge")
		if N.travel("Spawn") then
			local center
			local zone = N.G.BridgeZone
			if type(zone.GetCenter) == "function" then
				local okC, c = pcall(zone.GetCenter)
				center = if okC and typeof(c) == "Vector3" then c else nil
			end
			if not center then
				local part = N.findStreamed("BridgeArea", bridgeArea, 3, true)
				center = part and N.posOf(part)
			end
			if center then
				N.teleport(center + Vector3.new(0, 3, 0), 0.3)
				N.Bridge.lowered, N.Bridge.lost = false, 0
				fire("BridgeService.RE.EngageChanged", { Engaged = true })
				local lost = 0
				while os.clock() - started < 40 and alive() and not N.levelingUnlocked() and not N.Bridge.lowered do
					if not N.does("AutoTap") then
						N.tapOnce()
					end
					if N.Bridge.lost > lost then
						lost = N.Bridge.lost
						-- the client re-engages after a lost round (L25949-25953)
						fire("BridgeService.RE.EngageChanged", { Engaged = true, Restart = true })
					end
					task.wait(0.1)
				end
				done = N.levelingUnlocked() or N.Bridge.lowered
				fire("BridgeService.RE.EngageChanged", { Engaged = false })
				log(string.format("BRIDGE %s in %.1fs (progress %s, rounds lost %d)", if done then "lowered" else "not lowered", os.clock() - started, formatNumber(N.Bridge.progress), N.Bridge.lost))
			else
				log("BRIDGE area not found on the main map")
			end
		end
		if not done then
			backoff("bridge", 900)
		end
		N.tripEnd()
		return if done then 1 else 0
	end
	-- cap and the island it happens on (same-island extras run right after a trip, p06 N.runTrip). =====
	-- R7-2: the tap chests are not an optional trip any more: they have their own slot in the Main loop (p11, like the craft
	-- trip), so a ready chest never waits behind the 5-minute gap of the optional trips.
	function N.xtraOptions(add, lossTo)
		if N.does("AutoBreakables") then
			local list = N.breakablesDue()
			if #list > 0 then
				local b = list[1]
				local value = 0
				for _, x in ipairs(list) do
					if x.island == b.island then
						value += x.value
					end
				end
				add("breakables", value, 15, lossTo(b.island), function()
					return N.breakableTrip(b.island)
				end, on("AutoBreakables"), b.island)
			end
		end
		-- I-3518: PetPower gives the Shiny mutation a power multiplier since 3518 (Shiny = 1.3, 3518 L407903-407909; 3097 had
		-- none), and all stars found raise the hatch chance BaseMutationChance -> UnlockedMutationChance (2 % -> 4 %,
		-- ShinyStarConfig 3518 L390380+, HatchMutationFormula L401385-401409). Worth per star = its share of that gain.
		if N.does("AutoShinyStars") and #N.starsLeft() > 0 then
			add("shiny stars", N.shinyStarValue(), 120, 0.6, N.shinyStarTrip, on("AutoShinyStars"), nil)
		end
		-- Builder K (live 3518, build J: "Return to Boingo, Step 5/5 Ready" for hours, no `NPC Boingo` line): Boingo was an
		-- optional trip here worth 5 Slime at item value 0, so with the Smart Planner on `value > cost` never held and the
		-- trip was never picked (with it off it lost every ratio and every multiplier window). He has his own Main slot now
		-- (p11, every 2 min while the step is "talk" or "cores"), like the tap chests.
		if N.does("AutoQuestTasks") then
			local tasks = N.questTasks()
			if #tasks > 0 then
				local value = 0
				for _, t in ipairs(tasks) do
					value += t.value
				end
				add("quest tasks", value, 45, lossTo(tasks[1].island), N.questTaskTrip, on("AutoQuestTasks"), tasks[1].island)
			end
		end
		if on("AutoEnchant") and not held("enchant trip") then
			local work = N.enchantWork()
			if #work > 0 then
				add("enchant", N.enchantValue(work), 45, lossTo("Shadow Realm"), N.enchantTrip, on("AutoEnchant"), "Shadow Realm")
			end
		end
		-- Feedback round 2026-11-02: the dig and Memory Match run from the Main minigame slot (p11) the moment they are up, no
		-- longer priced here against the hatch gap.
	end
	-- Main "Up next" lines for the side systems that have work (only the ones switched on, or all with the planner).
	function N.xtraUpNext()
		local out = {}
		if N.does("AutoTapChests") then
			local list = N.tapChestsDue()
			if #list > 0 then
				table.insert(out, string.format("Tap chest %s ready (%s coins)", list[1].island, formatNumber(list[1].coins)))
			end
		end
		if N.does("AutoBreakables") then
			local list = N.breakablesDue()
			if #list > 0 then
				local s = list[1].spot
				table.insert(out, string.format("Break the %s on %s (%s)", tostring(s.Title), s.Island, tostring(s.Ingredient)))
			end
		end
		if on("AutoEnchant") then
			local work = N.enchantWork()
			if #work > 0 then
				table.insert(out, string.format("Enchant %d team pet%s (goal %s)", #work, if #work == 1 then "" else "s", N.enchantGoal()))
			end
		end
		if N.does("AutoQuestTasks") then
			local tasks = N.questTasks()
			local t = tasks[1]
			if t then
				table.insert(out, if t.kind == "visit" then "Pick up the quests on " .. t.island elseif t.kind == "golden" then "Craft a Golden pet for the " .. t.id .. " quest" else string.format("Hatch %d %s egg%s for a quest", t.need, t.egg, if t.need == 1 then "" else "s"))
			end
		end
		if N.does("AutoNpcQuests") then
			local s = N.boingoStep()
			if s then
				table.insert(out, "Boingo's quest: " .. (if s == "talk" then "talk to Boingo" elseif s == "cores" then "collect the Bounce Cores" else string.gsub(s, "^wait: ", "")))
			end
		end
		if N.does("AutoShinyStars") then
			local left = #N.starsLeft()
			if left > 0 then
				table.insert(out, string.format("Collect %d Shiny Star%s", left, if left == 1 then "" else "s"))
			end
		end
		if N.does("AutoDig") and N.digDue() then
			table.insert(out, string.format("Dig site: %d game%s left this hour", N.digLeft(), if N.digLeft() == 1 then "" else "s"))
		end
		if N.does("AutoMemory") and N.memoryDue() then
			table.insert(out, "Memory Match ready")
		end
		return out
	end
	-- UI-5: one-time systems with nothing left say so on their toggle ("done"), so the owner sees they have nothing to do.
	local DoneText = { AutoShinyStars = "Auto Shiny Stars", AutoNpcQuests = "Auto NPC Quests", AutoQuestTasks = "Auto Quest Tasks", AutoTutorial = "Auto Tutorial And Bridge" }
	local DoneShown = {}
	function N.markDone()
		local data = N.data()
		if not data then
			return
		end
		local found = count(N.sub(N.sub(data, "ShinyStars"), "Found"))
		local total = tonumber(X.Stars.Total) or #N.tableOr(X.Stars.Stars)
		local entry = boingoEntry()
		local state = {
			AutoShinyStars = if total > 0 and found >= total then "all found" else nil,
			AutoNpcQuests = if entry and entry.Done == true then "Boingo done" else nil,
			AutoQuestTasks = if #N.questTasks() == 0 then (if N.probeState("quest_assign") == "rejected" then "none left in this version" else "no open quest") else nil,
			AutoTutorial = if N.levelingUnlocked() and call("IntroDone") ~= false then "done" else nil,
		}
		for name, base in pairs(DoneText) do
			local want = if state[name] then base .. " (" .. state[name] .. ")" else base
			local t = Toggles[name]
			if t and DoneShown[name] ~= want and type(t.SetText) == "function" then
				DoneShown[name] = want
				pcall(t.SetText, t, want)
			end
		end
	end
	-- Panel texts (built in the draw thread only while the tab is on screen).
	function N.exploreText()
		local chests = {}
		local now = N.serverTime()
		for id, c in pairs(N.tableOr(X.TapChest.Chests)) do
			if type(c) == "table" and N.islandUnlocked(c.Island) then
				local readyAt = tonumber(N.sub(N.data(), "TapChests")[id]) or 0
				-- R7-2: a ready chest that waits for a retry says why
				local heldWhy = if readyAt <= now then N.tapChestHeld(id) else nil
				table.insert(chests, string.format("%s %s", c.Island, if readyAt > now then "in " .. N.longTime(readyAt - now) elseif heldWhy then "ready (" .. heldWhy .. ")" else "ready"))
			end
		end
		table.sort(chests)
		local found = count(N.sub(N.sub(N.data(), "ShinyStars"), "Found"))
		local total = tonumber(X.Stars.Total) or 15
		local s = N.boingoStep()
		local boingo = if s == nil and boingoEntry() and boingoEntry().Done == true then "done, nothing left" elseif s == nil then "not offered yet" elseif s == "talk" then "talk to Boingo" elseif s == "cores" then "Bounce Cores" else (string.gsub(s, "^wait: ", ""))
		return string.format(
			"Tap chests: %s\nShiny Stars %d/%d%s  \u{00B7}  Boingo: %s\n%s\nChests opened %d, stars %d%s",
			if #chests > 0 then table.concat(chests, ", ") else "none unlocked",
			found,
			total,
			if found >= total then " (all found, nothing left)" else "",
			boingo,
			N.questText(),
			Xtra.counts.chests,
			Xtra.counts.stars,
			if Xtra.last.chests then "\nLast chest: " .. Xtra.last.chests else ""
		)
	end
	-- R6-2: the quest counter against the next Quest badge (AchievementConfig QuestBadges 3097 L356548-356599: 13, 65, 325,
	-- 1300, 6500): the badge progress the game's own Achievements page shows (Data.Achievements.Progress[category],
	-- AchievementController L106989; the owner's page showed 3/65, the profile snapshot in ideas.md had QuestsCompleted 12),
	-- else Statistics.QuestsCompleted;
	-- this session's claims, the open quests and why none is open.
	function N.questText()
		local data = N.data()
		local total = tonumber(N.sub(N.sub(data, "Achievements"), "Progress").QuestBadges) or tonumber(N.sub(data, "Statistics").QuestsCompleted) or 0
		local badge = nil
		for _, t in ipairs(N.tableOr(X.Ach.QuestBadges)) do
			if type(t) == "table" and (tonumber(t.Amount) or 0) > total then
				badge = t
				break
			end
		end
		local open = 0
		local defs = N.tableOr(N.G.Quests.Definitions)
		for id, q in pairs(N.sub(data, "Quests")) do
			if type(q) == "table" and q.Claimed ~= true and defs[id] ~= nil then
				open += 1
			end
		end
		local line = string.format("Quests done <b>%s%s</b>%s  \u{00B7}  +%d this session  \u{00B7}  open %d", formatNumber(total), if badge then "/" .. formatNumber(tonumber(badge.Amount) or 0) else "", if badge then " (" .. tostring(badge.Title or "next badge") .. ")" else "", N.QuestWatch.session, open)
		local tasks = N.questTasks()
		if open == 0 and #tasks == 0 then
			if N.probeState("quest_assign") == "rejected" then
				return line .. "\nNo quest left to take in this game version: the game hands out " .. count(defs) .. " quests, the island boards and Boingo"
			end
			return line .. "\nNo quest open: new ones come after a claim and on Sky Island and Autumn"
		end
		local t = tasks[1]
		if t then
			return line .. "\nNext: " .. (if t.kind == "visit" then "pick up the quests on " .. t.island elseif t.kind == "golden" then "a Golden craft for " .. t.id else string.format("%d %s egg%s for %s", t.need, t.egg, if t.need == 1 then "" else "s", t.id))
		end
		return line
	end
	function N.enchantText()
		local team = N.bestTeam()
		local parts = {}
		for id in pairs(team) do
			local pet = N.owned()[id]
			if type(pet) == "table" then
				table.insert(parts, string.format("%s: %s", tostring(pet.Name), tostring(pet.Enchant or "none")))
			end
		end
		table.sort(parts)
		local equipped = N.sub(N.data(), "Mastery").EquippedRelic
		return string.format(
			"%s\nRelic: %s  \u{00B7}  rolls %d, kept %d%s",
			if #parts > 0 then table.concat(parts, "\n") else "No team yet",
			tostring(N.tableOr(N.tableOr(X.Relics.Relics)[equipped]).Name or (if type(equipped) == "string" then equipped else "none")),
			Xtra.counts.rolls,
			Xtra.counts.kept,
			if Xtra.last.enchant then "\nLast: " .. Xtra.last.enchant else ""
