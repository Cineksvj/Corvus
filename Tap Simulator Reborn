					local prev = Prev[i]
					Prev[i] = v
					if Swapping or N.changeSource == "config" or prev == v or type(prev) ~= "string" then
						return
					end
					for j = 1, 5 do
						local o = Options["Priority" .. j]
						if j ~= i and o and o.Value == v then
