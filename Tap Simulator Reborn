	-- hatching and tapping it costs (B4). R6-5 (OWNER_RULES 21): it never uses anything up by itself (N.Consumers in p02:
	-- potions, totems, dials, treats, honey, gem buys, mining coins, enchants, relics, deletes, the team, the egg pick);
	-- with those toggles on it adds its value math to them. PLAN lines only while it is on. =====
	N.Plan = { say = "", why = "", spendText = "", logged = {}, coinRate = 0, gemRate = 0, lastCoins = nil, lastGems = nil, lastAt = os.clock(), egg = nil, saving = nil }
	local Plan = N.Plan
	local function planLog(key, text, every, minGap)
		if not N.planner() then
			return
		end
		local last = Plan.logged[key]
		if last and last.text == text and os.clock() - last.at < (every or 600) then
			return
		end
		if last and os.clock() - last.at < (minGap or 30) then
			return
		end
		Plan.logged[key] = { text = text, at = os.clock() }
		log("PLAN " .. text)
	end
	N.planLog = planLog
	-- Coins per second: the HUD method (N.Income, coin gains between replica samples, resets left out); before it has 3 s
	-- of samples, the TapResult amounts; before any tap, the passive formula at the tap pace.
	function N.income()
		local measured = tonumber(N.Income and N.Income.rate) or 0
		if measured > 0 and (N.Income.counted or 0) >= 3 then
			-- a rise shows in the last 5 s before the 60 s window catches up
			return math.max(measured, tonumber(N.Income.fast) or 0)
		end
		local taps = tonumber(N.Tap.coinRate) or 0
		if taps > 0 then
			return taps
		end
		local fn = N.G.Tap.GetPassiveMultiplier
		local data = N.data()
		if type(fn) == "function" and data and N.does("AutoTap") then
			local ok, m = pcall(fn, data)
			if ok and type(m) == "number" and N.finite(m) then
				return m / math.max(N.Tap.interval, 0.1)
			end
		end
		return 0
	end
	function N.sampleRates()
		local now = os.clock()
		local dt = now - Plan.lastAt
		if dt < 5 then
			return
		end
		local gems = N.gems()
		if Plan.lastGems and gems > Plan.lastGems then
			Plan.gemRate = Plan.gemRate * 0.7 + (gems - Plan.lastGems) / dt * 0.3
		else
			Plan.gemRate *= 0.95
		end
		Plan.lastGems, Plan.lastAt = gems, now
		Plan.coinRate = N.income()
	end
	-- ===== Egg choice: expected base power per second = egg value x min(hatch speed, what the income pays for). =====
	function N.eggScore(egg)
		local top = N.hatchTop()
		local cost = N.eggCost(egg, top)
		if cost >= math.huge then
			return 0
		end
		local timeRate = top / N.hatchWindow(N.Hatch.speed, top)
		local income = N.income()
		local coinRate = if cost > 0 then income * top / cost else timeRate
		local eggsPerSec = math.min(timeRate, coinRate)
		if N.coins() >= cost * 30 then
			eggsPerSec = timeRate
		elseif N.coins() < N.eggCost(egg, 1) and coinRate < timeRate * 0.02 then
			eggsPerSec = 0
		end
		-- owner 2026-10-12: power the egg ADDS to the team (an egg below the team scores 0, whatever its average power)
		return N.eggMarginal(egg) * eggsPerSec
	end
	local function lockedRecently(egg)
		return os.clock() - (N.Hatch.locked[egg] or -1e9) < 120
	end
	function N.bestEgg()
		local best, bestScore = nil, -1
		for _, egg in ipairs(N.eggList()) do
			if N.eggUnlocked(egg) and not lockedRecently(egg) then
				local score = N.eggScore(egg)
				if score > bestScore then
					best, bestScore = egg, score
				end
			end
		end
		local current = Plan.egg
		if current and current ~= best and N.eggUnlocked(current) and not lockedRecently(current) and N.eggScore(current) >= bestScore * 0.8 and bestScore > 0 then
			return current, N.eggScore(current)
		end
		-- no unlocked egg improves the team: the richest unlocked egg (highest average power = the secrets live there)
		if bestScore <= 0 then
			local rich, richValue = nil, -1
			for _, egg in ipairs(N.eggList()) do
				if N.eggUnlocked(egg) and not lockedRecently(egg) and N.eggValue(egg) > richValue then
					rich, richValue = egg, N.eggValue(egg)
				end
			end
			if rich then
				return rich, 0
			end
		end
		return best, bestScore
	end
	-- The unlocked egg with the most power per second once the wait for its price is counted:
	-- rate(e) = eggScore(e) / (hatch window + max(0, price - coins) / income). A fresh account (0 coins) gets the egg
	-- whose price the income reaches fastest per unit of power; the expensive egg wins only when its power pays for the wait.
	function N.affordableEgg()
		local coins = N.coins()
		local income = math.max(N.income(), 1e-9)
		local window = math.max(N.hatchWindow(N.Hatch.speed, 1), 0.5)
		local pick, pickRate = nil, -1
		for _, egg in ipairs(N.eggList()) do
			if N.eggUnlocked(egg) and not lockedRecently(egg) then
				local cost = N.eggCost(egg, 1)
				local gain = N.eggMarginal(egg)
				-- an egg whose pets add nothing to the team is never a fallback (owner 2026-10-12: no Crystal next to Void pets)
				if cost < math.huge and gain > 0 then
					local wait = math.max(cost - coins, 0) / income
					local rate = gain / (window + wait)
					if rate > pickRate then
						pick, pickRate = egg, rate
					end
				end
			end
		end
		return pick
	end
	-- The egg to hatch: the one picked in the dropdown when it is unlocked (Void by default, the owner's egg), else the
	-- best unlocked one. "Best (Smart)" always takes the best.
	function N.pickEgg()
		-- strategy.md item 2 (Secret Hunt): hold ONE egg without a gap so its secret drought/pity grows (every egg switch
		-- zeroes SecretHatchFormula.ActiveSeconds). It wins over the Index Hunter and over any fallback, so the window never
		-- resets. The egg is the dropdown pick (Void by default); a locked/Smart pick falls back to the best unlocked egg.
		if on("SecretHunt") then
			local choice = optionText("HatchEgg", "Void")
			local egg = if choice ~= "Best (Smart)" and N.validEgg(choice) and N.eggUnlocked(choice) and not lockedRecently(choice) and not N.eggOutOfStock(choice) then choice else N.bestEgg()
			if egg then
				Plan.egg = egg
				return egg, "Secret Hunt: holding " .. egg .. " for its secret pity"
			end
		end
		-- R6-3: while the Index Hunter is on and has pets to find, its egg goes first (its own toggle; the planner never
		-- changes the picked egg by itself)
		if on("IndexHunter") then
			local hunt = N.indexTarget()
			if hunt then
				-- a fixed reason: the PLAN hatch line is logged when the reason changes (the counts live in the Index Hunter box)
				return hunt.egg, "Index Hunter: filling the pet index"
			end
		end
		local choice = optionText("HatchEgg", "Void")
		if choice ~= "Best (Smart)" and N.validEgg(choice) and N.eggUnlocked(choice) and not lockedRecently(choice) and not N.eggOutOfStock(choice) then
			-- Owner 2026-10-12 ("matematycznie idealnie"): the picked egg hatches when the coins pay for it now, or when its
			-- power per second (wait for the price included) beats every egg the coins reach; otherwise the math wins.
			local cost = N.eggCost(choice, 1)
			if N.coins() >= cost then
				Plan.egg = choice
				return choice, "picked in the dropdown"
			end
			-- rebirths first: the surplus is small and rare, it goes to the picked egg (the one worth having), never to a
			-- cheap egg whose pets add nothing (live 10:21: Crystal x3 with a gain of 0 per coin)
			if N.eggsFirst and not N.eggsFirst() then
				Plan.egg = choice
				return choice, "picked in the dropdown, rebirths first"
			end
			local alt = N.affordableEgg()
			if alt == choice or alt == nil then
				Plan.egg = choice
				return choice, "picked in the dropdown"
			end
		end
		local best = N.bestEgg()
		local why = if choice == "Best (Smart)" then "most power per second" elseif N.validEgg(choice) and not N.eggUnlocked(choice) then choice .. " is locked" else choice .. " is not affordable yet"
		-- Owner 2026-10-12: a fresh account must still open eggs. When the best egg is out of reach, the most expensive
		-- unlocked egg that the coins pay for (else the cheapest) takes the hatch, so no egg is skipped.
		if best and N.eggCost(best, 1) > N.coins() then
			local alt = N.affordableEgg()
			if alt then
				best = alt
				why = "fallback: " .. alt .. " is what the coins reach now"
			end
		end
		if best then
			Plan.egg = best
			return best, why
		end
		return nil, "no egg unlocked"
	end
	-- ===== Owner 2026-10-12 ("matematycznie idealnie"): coins go where ONE coin buys the most income. =====
	-- Tap coins = (rebirths + 1) x pet power x ... (dump TapFormula.GetAmount, 3518 L414663-414667), so a rebirth adds
	-- 1 / (R + 1) of the income per rebirth, and a hatched pet adds its power above the weakest team slot over the team
	-- power. Per coin: rebirth = 1 / (coins per rebirth x (R + 1)); egg = E[max(0, power - weakest)] / team power / price.
	-- Whichever is bigger gets the coins; the other one lives on the surplus (a windfall above the biggest button the
	-- coins pay for, or eggs so cheap that they never hold a press).
	function N.rebirthGainPerCoin()
		local perRebirth = N.rebirthPrice(1) / math.max(N.rebirthAmount(1), 1)
		if not N.finite(perRebirth) or perRebirth <= 0 then
			return 0
		end
		return 1 / (perRebirth * (N.rebirths() + 1))
	end
	function N.eggGainPerCoin(egg)
		local cfg = egg and N.eggCfg(egg)
		if not cfg then
			return 0
		end
		local cost = N.eggCost(egg, 1)
		if cost <= 0 or cost >= math.huge then
			return 0
		end
		local _, teamBase = N.teamBaseline()
		return N.eggMarginal(egg) / math.max(teamBase, 1) / cost
	end
	-- The team in the same units as a fresh hatch: base power x tier (no levels, no enchants; a new pet levels up to the
	-- same cap later). Returns the weakest slot (0 while a slot is free) and the team sum.
	function N.teamBaseline()
		local owned = N.owned()
		local pets = N.tableOr(N.G.PetCfg)
		local weakest, n, sum = math.huge, 0, 0
		for id in pairs(N.equippedSet()) do
			local pet = owned[id]
			local cfg = type(pet) == "table" and pets[pet.Name]
			local base = if type(cfg) == "table" then tonumber(cfg.Power) or 0 else 0
			local pw = N.tierPower(base, (type(pet) == "table" and pet.Tier) or "Normal")
			n += 1
			sum += pw
			weakest = math.min(weakest, pw)
		end
		if n < N.equipLimit() or weakest == math.huge then
			weakest = 0
		end
		return weakest, sum
	end
	-- Expected power one hatch ADDS to the team: E[max(0, pet power - weakest equipped)] over the egg's pets. Zero for an
	-- egg whose pets are all weaker than the team (owner 2026-10-12: "Crystal does not pay back next to Void pets").
	-- strategy.md item 3: with nRolls given, the pet distribution is the game's own best-of-n bands (HatchLuck.BuildPool +
	-- Odds, 3687 L399964-400066), so the rarer (stronger) pets carry the weight the luck actually gives them; without the
	-- module it falls back to the egg's flat weights.
	function N.eggExpected(egg, nRolls)
		local cfg = egg and N.eggCfg(egg)
		if not cfg then
			return 0
		end
		local weakest = N.teamBaseline()
		local pets = N.tableOr(N.G.PetCfg)
		local paths = N.craftPaths()
		local function bestUse(petName)
			local p = pets[petName]
			local pw = if type(p) == "table" then tonumber(p.Power) or 0 else 0
			-- the best use of one hatched copy: on the team as it is, or as 1/n of a Golden / Diamond / Rainbow craft
			local best = math.max(N.tierPower(pw, "Normal") - weakest, 0)
			for _, path in ipairs(paths) do
				local v = math.max(N.tierPower(pw, path.tier) - weakest, 0)
				-- G6 (3937): a sure Golden craft turns Lucky into a Diamond 1 in 50 / a Rainbow 1 in 250
				if path.lucky then
					local rest = 1
					local lucky = 0
					for _, l in ipairs(path.lucky) do
						lucky += l.p * math.max(N.tierPower(pw, l.tier) - weakest, 0)
						rest -= l.p
					end
					v = v * math.max(rest, 0) + lucky
				end
				v /= path.copies
				if path.bonus then
					v *= path.bonus
				end
				best = math.max(best, v)
			end
			return best
		end
		local hl = N.G.HatchLuck
		if type(hl) == "table" and type(hl.BuildPool) == "function" and type(hl.Odds) == "function" then
			local okPool, pool = pcall(hl.BuildPool, N.tableOr(cfg.Pets), {})
			if okPool and type(pool) == "table" and #pool > 0 then
				local okOdds, odds = pcall(hl.Odds, pool, math.max(nRolls or 1, 1))
				if okOdds and type(odds) == "table" then
					local total = 0
					for i, entry in ipairs(pool) do
						local w = tonumber(odds[i]) or 0
						if w > 0 and type(entry) == "table" and entry.Pet then
							total += w * bestUse(entry.Pet)
						end
					end
					return total
				end
			end
		end
		-- fallback: the egg's flat weights (no luck weighting)
		local total, weight = 0, 0
		for pet, w in pairs(N.tableOr(cfg.Pets)) do
			w = tonumber(w) or 0
			total += w * bestUse(pet)
			weight += w
		end
		return if weight > 0 then total / weight else 0
	end
	function N.eggMarginal(egg)
		return N.eggExpected(egg, if N.luckRolls then N.luckRolls() else 1)
	end
	-- Power of a base-power pet at a tier, through the game's own PetPower.GetFromBase (fallback: the 3518 tier table
	-- Normal 1 / Golden 2 / Diamond 5 / Shiny 7, L407159-407164).
	local TierFallback = { Normal = 1, Golden = 2, Diamond = 5, Shiny = 7 }
	local TierMultCache = {}
	function N.tierPower(base, tier)
		local m = TierMultCache[tier]
		if not m then
			m = TierFallback[tier] or 1
			local fn = N.G.PetPower and N.G.PetPower.GetFromBase
			if type(fn) == "function" then
				local okA, a = pcall(fn, { Name = "", Tier = tier, Level = 0 }, 1000)
				local okB, b = pcall(fn, { Name = "", Tier = "Normal", Level = 0 }, 1000)
				if okA and okB and N.finite(a) and N.finite(b) and b > 0 and a >= b then
					m = a / b
				end
			end
			TierMultCache[tier] = m
		end
		return base * m
	end
	-- The craft paths one hatched Normal copy can take and how many copies each result costs: Golden = the sure count
	-- (6 Normals without bonuses), Diamond = Goldens x that (5 x 6), Rainbow = Diamonds x the pod count (5 x 5 x 6).
	-- Only machines the game config has; cached for 10 s (the sure counts move with mastery and enchants).
	local PathCache = { at = -1e9, list = {} }
	-- G6 (3937 code pass): MachineConfig.Golden.LuckyDiamond = 50 / LuckyRainbow = 250 (bc 239173; the craft answer marks
	-- them Lucky, 70050-70054): one sure Golden craft becomes a Diamond 1 in 50 and a Rainbow 1 in 250 = expected power
	-- 3 + 4/50 + 7/250 = 3.108 instead of 3 (+3.6 %). Nil when the config has no Lucky fields.
	function N.goldenLucky()
		local cfg = N.machineCfg and N.machineCfg("Golden")
		if not cfg then
			return nil
		end
		local out = {}
		local d, r = tonumber(cfg.LuckyDiamond), tonumber(cfg.LuckyRainbow)
		if d and d >= 1 then
			table.insert(out, { tier = "Diamond", p = 1 / d })
		end
		if r and r >= 1 then
			table.insert(out, { tier = "Shiny", p = 1 / r })
		end
		return if #out > 0 then out else nil
	end
	-- The expected power factor of one sure Golden craft over a plain Golden (1.036 with the 3937 config)
	function N.goldenLuckyFactor()
		local lucky = N.goldenLucky()
		if not lucky then
			return 1
		end
		local base = N.tierPower(1000, "Golden")
		local v, rest = 0, 1
		for _, l in ipairs(lucky) do
			v += l.p * N.tierPower(1000, l.tier)
			rest -= l.p
		end
		return (v + math.max(rest, 0) * base) / base
	end
	function N.craftPaths()
		local now = os.clock()
		if now - PathCache.at < 10 then
			return PathCache.list
		end
		local list = {}
		local copies = 1
		local golden = N.machineCfg and N.machineCfg("Golden")
		if golden then
			copies *= (N.craftNeedSure and N.craftNeedSure("Golden")) or 6
			table.insert(list, { tier = "Golden", copies = copies, lucky = N.goldenLucky() })
			local diamond = N.machineCfg("Diamond")
			if diamond then
				copies *= (N.craftNeedSure("Diamond")) or 5
				table.insert(list, { tier = "Diamond", copies = copies })
				local shiny = N.machineCfg("Shiny")
				if shiny then
					local pods = math.clamp(math.floor(optionNumber("RainbowCount", 5)), tonumber(shiny.MinPets) or 2, 5)
					copies *= pods
					table.insert(list, { tier = "Shiny", copies = copies })
				end
			end
		end
		local bonus = N.goldenBonus and N.goldenBonus() or 1
		if bonus > 1 and list[1] and list[1].tier == "Golden" then
			list[1].bonus = bonus
		end
		PathCache.at, PathCache.list = now, list
		return list
	end
	-- strategy.md item 6: the Golden craft achievements (3687 L381364-381400: 5 / 200 / 500 / 1000 goldens crafted ->
	-- Achievements.Multipliers.GoldenLuck cumulative x1.05 / x1.05 / x1.6 / x1.7) permanently raise the golden hatch rate
	-- (a golden is x3 power). While the milestone is not reached, value a golden craft a little above its bare x3 pet so
	-- the planner keeps crafting goldens toward x1.7 golden luck. Read-only numbers for the Machines status + a log line.
	local GoldenTiers = { { 5, 1.05 }, { 200, 1.05 }, { 500, 1.6 }, { 1000, 1.7 } }
	function N.goldenMilestone()
		local crafts = tonumber(N.sub(N.sub(N.data(), "Achievements"), "Progress").GoldenCrafts) or 0
		for _, t in ipairs(GoldenTiers) do
			if crafts < t[1] then
				return { crafts = crafts, nextAt = t[1], nextMult = t[2], active = true }
			end
		end
		return { crafts = crafts, nextAt = nil, nextMult = nil, active = false }
	end
	-- A bounded nudge (<= +20 %) so the audited egg/coin math is not distorted; it only tilts which hatched copy the
	-- planner would rather turn into a golden while the milestone is open, strongest near the x1.6 / x1.7 tiers.
	function N.goldenBonus()
		local m = N.goldenMilestone()
		if not m.active or not m.nextMult then
			return 1
		end
		return 1 + math.clamp((m.nextMult - 1) * 0.25, 0, 0.2)
	end
	local GoldenLogged = ""
	function N.goldenMilestoneLog()
		local m = N.goldenMilestone()
		local key = m.active and (m.nextAt .. "") or "done"
		if key ~= GoldenLogged then
			GoldenLogged = key
			if m.active then
				log(string.format("CRAFT goldens %d/%d (next: golden luck x%.2g)", m.crafts, m.nextAt, m.nextMult))
			else
				log(string.format("CRAFT goldens %d/1000 (golden luck milestone complete)", m.crafts))
			end
		end
	end
	-- True when the eggs win the coins (or no rebirth runs at all); false = rebirths first, eggs from the surplus.
	-- Re-evaluated every 2 s; a flip is logged once as PLAN coins.
	local Split = { at = -1e9, eggsFirst = true, text = "" }
	function N.splitReset()
		Split.at = -1e9
	end
	function N.eggsFirst()
		local now = os.clock()
		if now - Split.at < 2 then
			return Split.eggsFirst
		end
		Split.at = now
		local egg = N.Hatch.target or Plan.egg
		local rebirthing = (N.planner() or on("AutoRebirth")) and N.rebirthMode() ~= "deduct"
		local eggsFirst, key, text = true, "", ""
		if rebirthing and egg then
			local e, r = N.eggGainPerCoin(egg), N.rebirthGainPerCoin()
			-- eggs that cost under 1 % of the income while hatching flat out (price of a top hatch per hatch window) delay
			-- the rebirth by under 1 %: they are never held, whatever they add (sim: the Index Hunter's Basic eggs at
			-- 200 coins next to 1e13/s were starved behind button 9)
			local top = N.hatchTop()
			local cheap = N.eggCost(egg, top) <= N.income() * math.max(N.hatchWindow(N.Hatch.speed, top), 0.5) * 0.01
			-- 20 % hysteresis: the side that holds the coins keeps them until the other one is clearly better
			if r <= 0 or cheap then
				eggsFirst = true
			elseif Split.eggsFirst then
				eggsFirst = e >= r * 0.8
			else
				eggsFirst = e >= r * 1.2
			end
			key = (if eggsFirst then "eggs" else "rebirths") .. "|" .. egg
			text = string.format("%s (one coin: %s egg %.3g, rebirth %.3g of the income%s)", if eggsFirst then "eggs first, rebirths on the side" else "rebirths first, eggs from the surplus", egg, e, r, if cheap then "; the eggs cost under 1 % of it" else "")
		elseif egg then
			key, text = "eggs|none", "eggs first (no rebirth runs)"
		end
		if key ~= Split.text and N.planner() then
			Split.text = key
			log("PLAN coins: " .. text)
		end
		Split.eggsFirst = eggsFirst
		return eggsFirst
	end
	-- Coins the hatch may spend now: everything when the eggs win; otherwise only what the biggest affordable rebirth
	-- button leaves over (the reset would eat it anyway).
	function N.hatchBudget()
		local coins = N.coins()
		if N.eggsFirst() then
			return coins
		end
		-- coins under a button the rebirth can still convert are savings, not surplus (live 10:21: Crystal x3 bought from
		-- the coins that button 10 was collecting; live 11:30: a hatch sent at the target price made the press wait for
		-- the hatch answer and the next overshoot fed the next hatch, waste 16-33 %). Only the overshoot above the biggest
		-- unlocked button (or the Max mode's button) is free: no button converts it, the reset would eat it.
		local top = if N.rebirthMaxOnly() then N.rebirthMaxButton() else N.rebirthOptions()
		return math.max(coins - N.rebirthPrice(top), 0)
	end
	-- Coins kept for the hatch loop in a game version where a rebirth only takes its price (deduct mode). In reset mode
	-- the eggs cost a sliver of a second of income and need no reserve (live_findings 18).
	function N.hatchReserve(planner)
		if not N.hatchWanted() then
			return 0
		end
		local egg = N.Hatch.target or Plan.egg
		if not egg then
			return 0
		end
		local top = N.hatchTop()
		local cost = N.eggCost(egg, top)
		if cost >= math.huge then
			return 0
		end
		if not planner then
			return cost
		end
		local window = math.max(N.hatchWindow(N.Hatch.speed, top), 0.5)
		if N.income() * window >= cost then
			return cost
		end
		return cost * 2
	end
	-- The next zone or island is a permanent step: the planner saves for it (rebirths wait) only when it is worth something
	-- (N.unlockValue) and the income reaches its price within 2 minutes.
	-- In reset mode every rebirth wipes the coins, so a saving holds the rebirths: it is set only when the coins arrive
	-- within 2 minutes AND the unlock trip may run by then (no coins piling up behind the 5 minute trip gap), and it is
	-- dropped when the coins sat there 30 s without the trip.
	function N.planSaving()
		if not N.planner() then
			Plan.saving = nil
			return
		end
		local pick = nil
		for _, u in ipairs(N.nextUnlocks()) do
			if (N.Unlock.refused[u.name] or 0) < os.clock() and N.unlockValue(u) > u.price / math.max(N.income(), 1e-9) then
				pick = u
				break
			end
		end
		if not pick then
			Plan.saving = nil
			return
		end
		-- R2-5 (live: "save for zone Forest (1M coins, 0s) ... rebirths wait" next to 13-20 Qi/s): a step that costs less than
		-- 10 s of income is no saving; its trip runs as soon as the scheduler allows (unlock trips skip the trip gap) and the
		-- rebirths go on
		if pick.price <= N.income() * 10 then
			Plan.saving = nil
			return
		end
		local coins = N.coins()
		local eta = math.max(pick.price - coins, 0) / math.max(N.income(), 1e-9)
		local tripWait = (if N.hatchWanted() then 300 else 30) - (os.clock() - N.Sched.lastOptionalEnd)
		if eta <= 120 and tripWait <= eta + 5 then
			if not Plan.saving or Plan.saving.name ~= pick.name then
				Plan.saving = { name = pick.name, price = pick.price, since = os.clock() }
				planLog("save", string.format("save for %s %s (%s coins, %s) while tapping and hatching; rebirths wait", pick.kind, pick.name, formatNumber(pick.price), N.longTime(eta)), 600, 60)
			end
			if coins >= pick.price then
				Plan.saving.readyAt = Plan.saving.readyAt or os.clock()
				if os.clock() - Plan.saving.readyAt > 30 then
					N.Unlock.refused[pick.name] = os.clock() + 600
					planLog("save drop", "idle reason=saving for " .. pick.name .. " dropped: the trip did not run within 30 s", 600, 60)
					Plan.saving = nil
				end
			end
		else
			Plan.saving = nil
		end
	end

	-- ===== The trip scheduler (B4; live 5, 15, 18). Hatching + tapping are the main loop; world events and the storage-full
	-- craft keep priority (they expire / hatching is blocked anyway). Every other trip is OPTIONAL: one at a time, at least
	-- 5 minutes of hatching between two of them (30 s when nothing hatches), a hard cap per trip, and with the planner only
	-- when its value beats what it costs. Units: seconds of current income ("is"). Cost = cap x (the tap income the trip
	-- loses + h), h = the value of one second of hatching = the measured growth of the equipped power x 24 h x the hatch
	-- share (0.5 is/s until 10 minutes of samples exist). =====
	N.Sched = { lastOptionalEnd = os.clock() - 240, powers = {}, incomes = {}, h = 0.5, chosen = nil, last = "", nextText = "" }
	local Sched = N.Sched
	-- R7-2: how fast the income grows (relative, per second) over the last 5-15 minutes (one sample a minute, 15 kept); nil
	-- while less than 5 minutes are sampled. The tap chests pay their taps at the CURRENT tap value and then rest 6 hours:
	-- while the income grows faster than 1 / the rest, opening later pays more than the delay costs (a fresh account grows
	-- ~1000x in its first hour); on a grown account (slow growth) the chest is opened the moment it is ready.
	function N.incomeGrowth()
		local now = os.clock()
		local list = Sched.incomes
		local last = list[#list]
		if not last or now - last.t >= 60 then
			local v = N.income()
			if N.finite(v) and v > 0 then
				table.insert(list, { t = now, v = v })
				if #list > 15 then
					table.remove(list, 1)
				end
			end
		end
		local first, newest = list[1], list[#list]
		if not first or newest.t - first.t < 300 then
			return nil
		end
		return math.log(newest.v / first.v) / (newest.t - first.t)
	end
	-- h = income-seconds one second of hatching is worth: the equipped power (income follows it) grows by g per second of
	-- hatching, a gain that lasts the rest of the 24 h horizon (on average half of it). REV-10: measured, no fixed hatch
	-- share any more (0.5 until 10 minutes of samples exist).
	function N.hatchValue()
		local now = os.clock()
		local list = Sched.powers
		local last = list[#list]
		if not last or now - last.t >= 60 then
			local p = N.equippedPower()
			if p > 0 then
				table.insert(list, { t = now, p = p })
				if #list > 40 then
					table.remove(list, 1)
				end
			end
		end
		if #list >= 10 then
			local first, newest = list[1], list[#list]
			local growth = math.max(newest.p / math.max(first.p, 1) - 1, 0) / math.max(newest.t - first.t, 1)
			Sched.h = math.clamp(growth * 43200, 0.02, 20)
		end
		return Sched.h
	end
	-- The share of the tap income a trip away from the farming spot loses (TapFormula.GetLocationMultiplier: the island's
	-- multiplier while on an island, else the zone's).
	local function locationLoss(toZone)
		local island = N.islandInfo(N.currentIsland())
		local here = tonumber(island and island.Multiplier) or tonumber(N.tableOr(N.zoneInfo(N.currentZone())).Multiplier) or 1
		local there = tonumber(N.tableOr(N.zoneInfo(toZone or "Spawn")).Multiplier) or 1
		return math.clamp(1 - there / math.max(here, 1), 0, 1)
	end
	-- The same for a trip to an island (its own multiplier) or to the main map (the Spawn zone's).
	local function lossTo(island)
		if island == nil or N.islandInfo(island) == nil then
			return locationLoss("Spawn")
		end
		local cur = N.islandInfo(N.currentIsland())
		local here = tonumber(cur and cur.Multiplier) or tonumber(N.tableOr(N.zoneInfo(N.currentZone())).Multiplier) or 1
		local there = tonumber(N.islandInfo(island).Multiplier) or 1
		return math.clamp(1 - there / math.max(here, 1), 0, 1)
	end
	N.lossTo = lossTo
	-- REV-4: the honey recipes are worth what their output does now (N.itemValue: XP to the coin team, +10 Levels, the 2x
	-- Coins treat while fewer than a day of them are in stock); the old fixed table outranked every tap chest.
	local function honeyValue(key)
		return N.itemValue(key)
	end
	-- What a potion is worth now (p05_xtra N.boostValue: Coins on the tap share, Luck through the power per hatch, Gems at
	-- the gem income x N.gemWorth).
	function N.potionValue(name)
		return N.boostValue(name)
	end
	local potionValue = N.potionValue
	-- REV-10: the gems' exchange rate in income-seconds per gem. The gem sinks (a potion brew every 300 s in each of 3
	-- slots at the machine's price; the next skill / gem upgrade) are filled best value first by the gems on hand plus a
	-- day of gem income; the first sink they cannot fill sets the price of a gem. When every sink is covered the gems are
	-- abundant and a gem is worth 0 (any positive use pays: live, 605B gems and 128B gems/h).
	local GemCache = { at = -1e9, v = 0 }
	function N.gemWorth()
		if os.clock() - GemCache.at < 10 then
			return GemCache.v
		end
		local sinks = {}
		local price1 = math.huge
		local machine = N.tableOr(N.W.Machine)
		if type(machine.GetPrice) == "function" then
			local okP, p = pcall(machine.GetPrice, 1, N.rebirths())
			price1 = if okP and N.finite(p) and p > 0 then p else math.huge
		end
		if price1 < math.huge then
			table.insert(sinks, { v = potionValue("Coins Potion I") / price1, demand = 3 * 288 * price1 })
		end
		for _, o in ipairs(N.upgradeOptions()) do
			if o.cost > 0 then
				table.insert(sinks, { v = o.value * 86400 / o.cost, demand = o.cost })
			end
		end
		table.sort(sinks, function(a, b)
			return a.v > b.v
		end)
		local supply = N.gems() + (Plan.gemRate or 0) * 86400
		local v = 0
		for _, s in ipairs(sinks) do
			if supply < s.demand then
				v = s.v
				break
			end
			supply -= s.demand
		end
		GemCache.at, GemCache.v = os.clock(), v
		return v
	end
	-- R3-3 (the owner switched the planner off after 53B gems of potion packs in one trip): a gem buy of 2 % of the gems or
	-- more (and at least 1M) is announced in Up next and the log 10 s before it happens; with a budget on the Upgrades tab a
	-- buy above it waits for the owner's OK (one prompt, remembered 30 min). Returns true when the buy may go now.
	N.GemPlan = { list = {}, approved = {}, declined = {} }
	function N.gemGate(key, gems, text)
		if not N.finite(gems) or gems <= 0 then
			return true
		end
		local now = os.clock()
		local budget = optionNumber("GemBudget", 0)
		if budget > 0 and gems > budget then
			if (N.GemPlan.approved[key] or 0) <= now then
				-- an unanswered prompt counts as "not now" after a minute
				if N.GemPlan.asking and now - (N.GemPlan.askAt or now) > 60 then
					N.GemPlan.declined[N.GemPlan.asking] = now + 1800
					N.GemPlan.asking = nil
				end
				if (N.GemPlan.declined[key] or 0) <= now and not N.GemPlan.asking and Library.ShowConfirmPrompt then
					N.GemPlan.asking = key
					N.GemPlan.askAt = now
					log(string.format("GEM ask %s (over your budget of %s gems)", text, formatNumber(budget)))
					pcall(Library.ShowConfirmPrompt, Library, {
						Title = "Big gem buy",
						Text = "Corvus wants to buy " .. text .. ". That is more than your budget of " .. formatNumber(budget) .. " gems.",
						ConfirmText = "Buy",
						CancelText = "Not now",
						OnConfirm = function()
							N.GemPlan.approved[key] = os.clock() + 1800
							N.GemPlan.asking = nil
							log("GEM approved " .. key)
						end,
						OnCancel = function()
							N.GemPlan.declined[key] = os.clock() + 1800
							N.GemPlan.asking = nil
							log("GEM declined " .. key .. " (asked again in 30 min)")
						end,
					})
				end
				N.GemPlan.waiting = { key = key, text = text .. " (waits for your OK)", at = now }
				return false
			end
		end
		if gems < 1e6 or gems < N.gems() * 0.02 then
			return true
		end
		local entry = N.GemPlan.list[key]
		if not entry or now - entry.at > 120 then
			entry = { at = now, text = text }
			N.GemPlan.list[key] = entry
			log(string.format("%s buy %s in 10 s (%.1f %% of your gems)", if N.planner() then "PLAN" else "GEM", text, gems / math.max(N.gems(), 1) * 100))
		end
		if now - entry.at >= 10 then
			N.GemPlan.list[key] = nil
			return true
		end
		return false
	end
	-- The announcement line for Up next.
	function N.gemPlanText()
		local now = os.clock()
		local best
		for _, e in pairs(N.GemPlan.list) do
			if now - e.at < 10 and (not best or e.at < best.at) then
				best = e
			end
		end
		if best then
			return string.format("buying %s in %ds", best.text, math.max(math.ceil(10 - (now - best.at)), 0))
		end
		local w = N.GemPlan.waiting
		if w and now - w.at < 30 then
			return "wants to buy " .. w.text
		end
		return nil
	end
	-- REV-10: the game's multiplier windows (GlobalEventSchedule / weathers, read from workspace Event_<X>_Active and
	-- _EndsAt): while one runs (and ends within 10 minutes) the optional trips wait, the hatching and tapping it multiplies
	-- go on. Time-limited world events and the storage-full craft are not optional and still run.
	local Windows = {
		Luck = "x3 luck",
		Mythic = "x5 mythic",
		Galaxy = "Galaxy mutations",
		LuckySkies = "x2 luck",
		BlessedWinds = "faster hatching",
		WindyDay = "faster hatching",
		AuroraBorealis = "rainbow chance",
		RainbowFrenzy = "rainbow chance",
		GoldenHour = "x2 golden",
		EggSurge = "+1 egg per hatch",
		PhantomFog = "x2 secret",
		BloodRain = "x5 mythic",
		RebirthTide = "x2 rebirths",
		SunnyFortune = "x2 gems",
		EnchantedWorld = "x2 enchant luck",
		RelicShower = "x3 mastery XP",
	}
	-- strategy.md item 4: windows the planner should ACT in (not only pause). The action is run through the feature's own
	-- toggle; everything is logged `PLAN weather <name>: <action>`.
	local WeatherAction = {
		EnchantedWorld = "enchant", -- roll enchants now (x2 rare enchant luck, 50 % crystal kept)
		RelicShower = "enchant", -- golden crafts + enchant rolls earn x3 mastery XP
		RebirthTide = "rebirth totem", -- place Totem of Rebirths (x1.15 x the x2 window)
		SunnyFortune = "gems potion", -- drink Gems potions (handled in drinkStep)
		EggSurge = "storage room", -- keep a free slot for the +1 egg (handled in hatchCount)
	}
	function N.weatherAction(win)
		return WeatherAction[win]
	end
	function N.windowActive()
		for name, what in pairs(Windows) do
			if N.eventActive(name) then
				local ends = tonumber(workspace:GetAttribute("Event_" .. name .. "_EndsAt"))
				local left = if ends then ends - N.serverTime() else 60
				if left > 0 and left <= 600 then
					return name, what, left
				end
			end
		end
		return nil
	end
	-- Every optional trip with work right now: name, value (is), cap (s), tap loss share, run function. R3-4/REV-15: built
	-- at most every 10 s (and after every trip), it reads every system's state.
	local OptCache = { at = -1e9, list = nil, gen = -1 }
	function N.tripOptions(fresh)
		if not fresh and OptCache.list and os.clock() - OptCache.at < 10 and OptCache.gen == N.Trip.gen then
			return OptCache.list
		end
		local planner = N.planner()
		local out = {}
		local function add(name, value, cap, loss, run, wanted, island)
			table.insert(out, { name = name, value = value, cap = cap, loss = loss, run = run, wanted = wanted, island = island })
			return out[#out]
		end
		local upList, upValue = nil, 0
		if N.does("AutoGemUpgrades") and (N.Spend.refused["upgrade trip"] or 0) < os.clock() then
			upList, upValue = N.upgradeTripWanted(planner)
		end
		if upList then
			add("upgrades", upValue * 86400, 20, locationLoss("Winter"), N.upgradeTrip, on("AutoGemUpgrades"))
		end
		local wantZone, wantIsland = N.does("AutoUnlockZones"), N.does("AutoUnlockIslands")
		if wantZone or wantIsland then
			for _, u in ipairs(N.nextUnlocks()) do
				-- affordable now, or within 10 s of income (the unlock trip holds the rebirths and waits for the coins, R2-5)
				if ((u.kind == "zone" and wantZone) or (u.kind == "island" and wantIsland)) and (u.price <= N.coins() or u.price <= N.income() * 10) and (N.Unlock.refused[u.name] or 0) < os.clock() then
					local value = N.unlockValue(u) - u.price / math.max(N.income(), 1e-9)
					if value > 0 or not planner then
						add("unlock " .. u.name, value, 15, locationLoss(u.from), function()
							return N.unlockTrip(u)
						end, (u.kind == "zone" and on("AutoUnlockZones")) or (u.kind == "island" and on("AutoUnlockIslands")))
						break
					end
				end
			end
		end
		if N.does("AutoHoneyPot") and os.clock() - N.Honey.tripAt > 300 then
			local ready, crafts = N.honeyPlan()
			if #ready + #crafts > 0 then
				-- REV-4: finished slots at what they hold, new crafts at what their output does now
				local value = 0
				local slots = N.honeySlots()
				for _, i in ipairs(ready) do
					local s = slots[i] or slots[tostring(i)]
					if type(s) == "table" then
						value += honeyValue(tostring(s.Key)) * (tonumber(s.Amount) or 1)
					end
				end
				for _, c in ipairs(crafts) do
					value += honeyValue(c.key) * c.amount
				end
				add("honey", value, 15, locationLoss("Spawn"), N.honeyTrip, on("AutoHoneyPot"), "Spawn")
			end
		end
		if N.does("AutoPotionMachine") and os.clock() - (N.World.at.potionTrip or -1e9) > 600 then
			local work = N.potionWork()
			if work then
				-- REV-10: every brew and pack at its potion's value minus its gems at N.gemWorth; a merge at what the Potion II
				-- adds over the three Potion I it takes
				local gw = N.gemWorth()
				local value = 0
				local claimSlots = N.sub(N.sub(N.data(), "PotionMachine"), "Slots")
				if work.claim then
					for _, s in pairs(claimSlots) do
						if type(s) == "table" and (tonumber(s.ReadyAt) or math.huge) <= os.time() then
							value += potionValue(tostring(s.Name or "Coins Potion I"))
						end
					end
				end
				for _, b in ipairs(work.brew) do
					value += potionValue(b.potion) - (work.price1 or 0) * gw
				end
				for _, n in ipairs(work.buy) do
					value += potionValue("Coins Potion I") * n
				end
				value -= (work.gems or 0) * gw - #work.brew * (work.price1 or 0) * gw
				for _, c in ipairs(work.craft) do
					local recipe = N.tableOr(N.tableOr(N.tableOr(N.W.Craft).ByOutput)[c.output])
					value += math.max(potionValue(c.output) - (tonumber(recipe.Required) or 3) * potionValue(tostring(recipe.Input or "Coins Potion I")), 0) * c.amount
				end
				local t = add("potions", value, 15, locationLoss("Spawn"), N.potionTrip, on("AutoPotionMachine"), "Spawn")
				-- R3-3: the gems the visit spends, for the announcement
				t.gems = work.gems or 0
				local packs = {}
				for _, n in ipairs(work.buy) do
					table.insert(packs, tostring(n))
				end
				t.gemText = string.format("%s%s for %s gems", if #packs > 0 then "potion pack " .. table.concat(packs, "/") else "", if #work.brew > 0 then (if #packs > 0 then " and " else "") .. #work.brew .. " brews" else "", formatNumber(t.gems))
			end
		end
		-- R13 (OWNER_RULES 21 + 24): finished brews and Honey Pot treats are FREE claims (the gems and ingredients went in
		-- when they started), so while Auto Potion Machine / Auto Honey Pot are off the planner and Auto Claim Finished
		-- Crafts still collect them: a visit that only claims (no buy, brew or new craft).
		if not on("AutoHoneyPot") and N.does("AutoClaimMachines") and os.clock() - N.Honey.tripAt > 300 then
			local ready = N.honeyPlan(true)
			if #ready > 0 then
				local value = 0
				local slots = N.honeySlots()
				for _, i in ipairs(ready) do
					local s = slots[i] or slots[tostring(i)]
					if type(s) == "table" then
						value += honeyValue(tostring(s.Key)) * (tonumber(s.Amount) or 1)
					end
				end
				add("honey", value, 15, locationLoss("Spawn"), function()
					return N.honeyTrip(true)
				end, on("AutoClaimMachines"), "Spawn")
			end
		end
		if not on("AutoPotionMachine") and N.does("AutoClaimMachines") and os.clock() - (N.World.at.potionTrip or -1e9) > 600 then
			local work = N.potionWork(true)
			if work then
				local value = 0
				for _, s in pairs(N.sub(N.sub(N.data(), "PotionMachine"), "Slots")) do
					if type(s) == "table" and (tonumber(s.ReadyAt) or math.huge) <= os.time() then
						value += potionValue(tostring(s.Name or "Coins Potion I"))
					end
				end
				add("potions", value, 15, locationLoss("Spawn"), function()
					return N.potionTrip(true)
				end, on("AutoClaimMachines"), "Spawn")
			end
		end
		-- R13: the enchanter's Claim answered "visit the machine": one short visit to the Enchant point (Shadow Realm)
		if N.EnchantHold and N.EnchantHold.visit and N.does("AutoClaimMachines") and N.enchantHeldDone() and os.clock() - (N.EnchantHold.tripAt or -1e9) > 600 then
			-- the held pet is out of the team until it is back: its power share of the income for a day at most
			local share = if N.equippedPower() > 0 then N.petPower(N.enchantHeldPet()) / N.equippedPower() else 0
			add("enchanter claim", math.max(share, 0.01) * 86400, 15, lossTo("Shadow Realm"), N.enchantClaimTrip, on("AutoClaimMachines"), "Shadow Realm")
		end
		-- Feedback round 2026-11-02 (Discord: "won't dig / pet defense"): the shrine, Pet Defense, the mine, the dig and Memory
		-- Match are no optional trips any more. They have their own Main slot (p11 minigame slot): each runs the moment the game
		-- has it up, not after the 5-minute hatch gap and the value/cost pick that kept them waiting for hours.
		-- B15-B28: tap chests, breakables, Shiny Stars, Boingo, quest tasks, enchant, dig, Memory Match (p05_xtra)
		if N.xtraOptions then
			N.xtraOptions(add, lossTo)
		end
		local h = N.hatchValue()
		for _, t in ipairs(out) do
			t.cost = t.cap * (t.loss + h)
		end
		OptCache.at, OptCache.list, OptCache.gen = os.clock(), out, N.Trip.gen
		return out
	end
	-- The arbiter asks this between hatches. Returns the trip to run now, or nil.
	function N.pickTrip()
		local planner = N.planner()
		local options = N.tripOptions()
		if #options == 0 then
			Sched.nextText = ""
			return nil
		end
		-- REV-10 / strategy.md item 4: a multiplier window is running. Most windows pause the optional trips (the hatching and
		-- tapping they multiply go on). But Enchanted World (x2 enchant luck, 50 % crystal kept) and Relic Shower (x3 mastery
		-- XP on golden crafts + enchant rolls) are a CUE to roll enchants NOW: the enchant trip is allowed and preferred then.
		local win, what, left = N.windowActive()
		if win then
			local action = N.weatherAction(win)
			if action == "enchant" then
				for _, t in ipairs(options) do
					if t.name == "enchant" and ((not planner and t.wanted) or t.value > 0) then
						planLog("weather", string.format("weather %s: roll enchants now (%s, %s left)", win, what, N.longTime(left)), 300, 0)
						Sched.nextText = ""
						return t
					end
				end
			end
			if action then
				planLog("weather", string.format("weather %s: %s (%s, %s left)", win, action, what, N.longTime(left)), 600, 0)
			end
			Sched.nextText = string.format("trips wait for the %s window (%s, %s left)", win, what, N.longTime(left))
			planLog("idle window", string.format("idle reason=%s window (%s) runs %s more: trips wait, hatching and tapping go on", win, what, N.longTime(left)), 600, 300)
			return nil
		end
		-- Builder M (owner 2026-10-12, alt: EggsOpened +5 in 20 s, every trip pulled the character off the egg): the
		-- hatch comes first. While the egg can hatch (room in the storage) the optional trips (these, the tap chests and
		-- Boingo, p11) share one 5-minute gap and each must pay more than the hatching it costs (t.cost); the unlocks and
		-- the upgrade station (one-off errands that pay for good) do not wait.
		local gap = if N.hatchWanted() then 300 else 30
		local wait = gap - (os.clock() - Sched.lastOptionalEnd)
		local best, bestRatio = nil, -math.huge
		for _, t in ipairs(options) do
			local ratio = t.value / math.max(t.cost, 1)
			local worth = (not planner and t.wanted) or t.value > t.cost
			-- R2-5: a zone or island unlock and the gem upgrade station are one-off 15-20 s errands that pay for good (each level
			-- is bought once): they do not wait for the trip gap (the station at most every 10 minutes, so the levels come in
			-- batches while the gems grow)
			if worth and (string.sub(t.name, 1, 6) == "unlock" or (t.name == "upgrades" and os.clock() - (N.Spend.tripAt or -1e9) > 600)) then
				Sched.nextText = ""
				return t
			end
			if worth and ratio > bestRatio then
				best, bestRatio = t, ratio
			elseif planner and not worth then
				-- one line per side system and half hour (the numbers move every check; live 9: no status spam)
				planLog("idle " .. t.name, string.format("idle reason=%s not worth the trip (value %d is, cost %d is)", t.name, math.floor(t.value), math.floor(t.cost)), 1800, 1800)
			end
		end
		if not best then
			Sched.nextText = ""
			return nil
		end
		if wait > 0 then
			-- REV-17: "trip X in Y" (the Main panel prefixes it with "Next")
			Sched.nextText = string.format("trip %s in %s", best.name, N.longTime(wait))
			return nil
		end
		-- R3-3: a visit that spends a big share of the gems is announced 10 s ahead
		if (best.gems or 0) > 0 and not N.gemGate(best.name, best.gems, best.gemText or best.name) then
			Sched.nextText = N.gemPlanText() or ""
			return nil
		end
		Sched.nextText = ""
		return best
	end
	-- Runs one trip picked by N.pickTrip and keeps the gap and the log.
	function N.runTrip(t)
		if planLog then
			planLog("trip " .. t.name, string.format("trip %s value=%dis cost=%dis cap=%ds", t.name, math.floor(t.value), math.floor(t.cost), t.cap), 300, 0)
		end
		log(string.format("TRIP %s cost=%ds", t.name, t.cap))
		local started = os.clock()
		-- REV-1: whatever happens inside, the trip is ended (N.guardTrip logs the error and releases the locks)
		local ok, err = N.guardTrip(t.name, t.run)
		-- The zone chain (B2): Forest -> Winter -> the Winter upgrade station is one errand; once a link worked the next
		-- one that pays runs at once instead of waiting another 5 minutes (at most 3 links, 60 s).
		if ok and err ~= false and (string.sub(t.name, 1, 6) == "unlock" or t.name == "upgrades") then
			for _ = 1, 3 do
				if os.clock() - started > 60 then
					break
				end
				if N.probeState("upgrade_remote") == "untested" and N.does("AutoGemUpgrades") then
					N.spendStep(N.planner(), false, true)
				end
				local nextTrip = nil
				for _, o in ipairs(N.tripOptions()) do
					if (string.sub(o.name, 1, 6) == "unlock" or o.name == "upgrades") and o.value > o.cost then
						nextTrip = o
						break
					end
				end
				if not nextTrip then
					break
				end
				planLog("trip " .. nextTrip.name, string.format("trip %s value=%dis cost=%dis (chained after %s)", nextTrip.name, math.floor(nextTrip.value), math.floor(nextTrip.cost), t.name), 300, 0)
				local okNext, result = N.guardTrip(nextTrip.name, nextTrip.run)
				if not okNext or result == false or result == 0 then
					break
				end
				t = nextTrip
			end
		end
		-- Same-island extras (B4 + B15-B28): what else has work on the island the trip ended on runs right away (no second
		-- travel), at most 3 of them and 60 s, each only while it pays more than the hatching it costs there.
		if ok then
			local island = N.currentIsland()
			local extrasAt = os.clock()
			local ran = { [t.name] = true }
			for _ = 1, 3 do
				if os.clock() - extrasAt > 60 or not alive() then
					break
				end
				local pick = nil
				for _, o in ipairs(N.tripOptions()) do
					local here = o.island == island or (o.island == "Spawn" and N.islandInfo(island) == nil)
					-- R4-3: the potion machine stands on the main map: a trip that is already there finishes the machine visit
					-- (claim, buy, brew) before going back, whatever the multiplier window (it waits only NEW trips)
					local onSpot = o.name == "potions" and o.value > 0
					if here and not ran[o.name] and o.cap <= 45 and ((not N.planner() and o.wanted) or onSpot or o.value > o.cap * N.hatchValue() * 0.5) and ((o.gems or 0) <= 0 or N.gemGate(o.name, o.gems, o.gemText or o.name)) then
						pick = o
						break
					end
				end
				if not pick then
					break
				end
				ran[pick.name] = true
				planLog("extra " .. pick.name, string.format("trip %s value=%dis while on %s (after %s)", pick.name, math.floor(pick.value), island, t.name), 300, 0)
				N.guardTrip(pick.name, pick.run)
				if pick.name == "potions" then
					N.potionTripDone()
				end
			end
		end
		if os.clock() - started > 2 then
			Sched.lastOptionalEnd = os.clock()
		end
		if t.name == "potions" then
			N.potionTripDone()
		end
		Sched.last = string.format("%s %.0fs", t.name, os.clock() - started)
	end
	function N.planTick()
		N.sampleRates()
		N.planSaving()
		local egg, why = N.pickEgg()
		N.Hatch.target, N.Hatch.targetWhy = egg, why
		local top = N.hatchTop()
		-- REV-9: PLAN lines are decisions only, logged when the decision changes (the hatching / rebirths follow at once);
		-- the equip decisions are logged by N.equipStep / N.fillTeam right before they act, the hatch value is no decision
		if N.planner() then
			if egg then
				planLog("egg", string.format("hatch %s x%d (%s power per egg, %s)", egg, top, formatNumber(N.eggValue(egg)), why), math.huge, 20)
			else
				planLog("egg", "idle reason=" .. tostring(why) .. " (tapping goes on)", math.huge, 120)
			end
			if N.does("AutoRebirth") and N.Reb.target and Plan.rebTarget ~= N.Reb.target then
				Plan.rebTarget = N.Reb.target
				planLog("rebirth target", string.format("rebirth on button %d the moment the coins reach its price (now %s, %s of income)", N.Reb.target, formatNumber(N.rebirthPrice(N.Reb.target)), N.longTime(N.rebirthPrice(N.Reb.target) / math.max(N.income(), 1e-9))), 0, 0)
			end
		end
		local n, limit = N.storage()
		Plan.say = string.format("Coins %s (+%s/s), gems %s, rebirths %s", formatNumber(N.coins()), formatNumber(N.income()), formatNumber(N.gems()), formatNumber(N.rebirths()))
		Plan.why = string.format("%s, storage %d/%d%s%s", if egg then "hatching " .. egg .. " x" .. top else "no egg to hatch", n, limit, if Plan.saving then ", saving for " .. Plan.saving.name else "", if on("SecretHunt") and N.Secret then " | SECRET " .. N.Secret.last else "")
		Plan.spendText = N.Spend.last
	end
	-- Main "Up next": what the enabled toggles (or the planner) do next, in plain words.
	function N.upNext()
		local out = {}
		if N.does("AutoTap") then
			table.insert(out, string.format("Tap every %.3g s%s", N.Tap.interval, if N.autoClickerOn() then " + the Auto Clicker" else (if N.hasAutoClicker() then "" else " (Auto Clicker: 20 gems in the skill tree)")))
		end
		if N.hatchWanted() then
			table.insert(out, "Hatch: " .. N.hatchStatusText(true))
		end
		if on("SecretHunt") and N.Secret then
			table.insert(out, "Secret Hunt: " .. N.Secret.last)
		end
		-- G1 (3937): a hatched Secret the hub could not release yet
		local secretWaits = N.secretPendingText and N.secretPendingText()
		if secretWaits then
			table.insert(out, "Secret: " .. secretWaits)
		end
		if on("IndexHunter") and not on("SecretHunt") then
			local hunt = N.Index and N.Index.target
			table.insert(out, if hunt then string.format("Index Hunter: %s egg, %s, %d variant%s left (~%s)", hunt.egg, tostring(N.Index.pet or "-"), hunt.new, if hunt.new == 1 then "" else "s", N.longTime(hunt.eta)) else "Index Hunter: nothing left to find right now")
		end
		if N.does("AutoRebirth") then
			table.insert(out, "Rebirth " .. N.rebirthPlanText(true))
		end
		-- R3-3: a big gem buy, 10 s before it happens
		local gemLine = N.gemPlanText()
		if gemLine then
			table.insert(out, (string.gsub(gemLine, "^%l", string.upper)))
		end
		for _, m in ipairs(N.Machines) do
			if N.machineOn(m) then
				local when = if on(m.toggle) then optionText(m.when, "Storage full") else "Storage full"
				local state = if N.craftDue(m) then "crafting on the next trip" elseif when == "Storage full" and N.storageHeld() then "crafts every 10 min (the game's delete list keeps the storage from filling)" elseif when == "Storage full" then "crafts when the storage is full" else "crafts every ready set"
				if m.key == "Shiny" then
					-- REV-17: the Rainbow machine has pods (ready to claim) and sets (to start), said apart
					local ready = #N.readyPods()
					local sets = math.min(#N.craftSets(m), math.max(N.podRoom(), 0))
					if ready > 0 or sets > 0 then
						local parts = {}
						if ready > 0 then
							table.insert(parts, string.format("%d pod%s to claim", ready, if ready == 1 then "" else "s"))
						end
						if sets > 0 then
							table.insert(parts, string.format("%d set%s to start", sets, if sets == 1 then "" else "s"))
						end
						table.insert(out, string.format("%s machine: %s (%s)", m.label, table.concat(parts, ", "), state))
					end
				else
					local n = N.craftableCount(m)
					if n > 0 then
						-- R2-4: "(storage full)" read as if the storage were full at 297/345
						table.insert(out, string.format("%s machine: %d set%s ready (%s)", m.label, n, if n == 1 then "" else "s", state))
					end
				end
			end
		end
		if on("AutoEquip") then
			table.insert(out, if N.levelFarming() then "Equip the level team (" .. formatNumber(optionNumber("XPMinPower", 600000)) .. "+ power, lowest level first)" else "Keep the best power team equipped (built pet by pet)")
		elseif N.planner() then
			-- R13: the planner alone never changes the team; it only says what Auto Equip would add
			local better = tonumber(N.Equip.better) or 0
			table.insert(out, "Fill empty pet slots only (your own team is kept" .. (if better > 0 then string.format("; Auto Equip would add %s power", formatNumber(better)) else "") .. ")")
		end
		-- R13: the pet the game's Auto Enchant holds, until it is back
		if N.enchantHeldPet and N.enchantHeldPet() then
			table.insert(out, if N.enchantHeldDone() then (if N.does("AutoClaimMachines") then "Enchanter: taking your pet back (" .. tostring(N.EnchantHold.last ~= "" and N.EnchantHold.last or "free claim") .. ")" else "Enchanter: your pet waits there (Auto Claim Finished Crafts takes it back)") else "Enchanter: the game's Auto Enchant is rolling your pet")
		end
		if (N.does("AutoSkillTree") or N.does("AutoGemUpgrades")) and N.Spend.pick then
			table.insert(out, string.format("Buy %s for %s gems", N.Spend.pick.name, formatNumber(N.Spend.pick.cost)))
		end
		if N.xtraUpNext then
			for _, line in ipairs(N.xtraUpNext()) do
				table.insert(out, line)
			end
		end
		if Sched.nextText ~= "" and not (gemLine and string.find(Sched.nextText, "buy", 1, true)) then
			local text = Sched.nextText
			table.insert(out, if string.sub(text, 1, 5) == "trip " then "Next " .. text else (string.gsub(text, "^%l", string.upper)))
		end
		-- competitors' "TP to the best island": taps carry the multiplier of the island the player stands on
		-- (TapFormula.GetLocationMultiplier 3097 L387736-387745); the egg island is where the hub stands.
		local best, bestName = 1, nil
		for name, info in pairs(N.tableOr(N.G.Islands.Islands)) do
			if type(info) == "table" and N.islandUnlocked(name) and (tonumber(info.Multiplier) or 1) > best then
				best, bestName = tonumber(info.Multiplier) or 1, name
			end
		end
		local egg = N.Hatch.target
		if bestName and egg and N.hatchWanted() and N.eggIsland(egg) ~= bestName then
			table.insert(out, string.format("Taps here x%s, %s has x%s (hatching keeps you at the %s egg)", tostring(tonumber(N.tableOr(N.islandInfo(N.eggIsland(egg))).Multiplier) or 1), bestName, tostring(best), egg))
		end
		return out
	end
end
