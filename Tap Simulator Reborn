	-- Fog all stack with the scheduled Luck and Mythic windows).
	local LuckWindows = { "Luck", "Mythic", "PhantomFog", "LuckySkies", "BlessedWinds", "WindyDay", "BloodRain", "Acid" }
	function N.luckWindowNow()
