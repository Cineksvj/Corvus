	local Due = {}
	local function due(key, seconds)
		local now = os.clock()
		if now >= (Due[key] or 0) then
			Due[key] = now + seconds
			return true
		end
		return false
	end
	N.due = due
	-- tests and the manual console: run a paced step now
	function N.dueReset(key)
		Due[key] = nil
	end
	local function ok(result)
		return type(result) == "table" and (result.Success == true or result.Accepted == true)
	end
	-- ===== Rewards (one toggle): offline coins (OfflineRewardsService.RF.Claim, dump 137300), the offline hatch recap
	-- (RF.AcknowledgeHatches(Id), 186466), quests (QuestService.RF.ClaimQuest {Quest}, 209541; AutoClaim quests are
	-- claimed by the server), the pet index (PetIndexService.RE.ClaimAllRequested, 201071, only when
	-- PetIndexCatalog.Claimables has something), weekly leaderboard rewards (LeaderboardService.RF.GetPendingRewards /
	-- ClaimReward(LeaderboardId), 131340-131356) and owned gifts (GiftService.RF.OpenGift {Gift, Amount}, 162164). =====
	N.Reward = { log = {}, failed = {}, last = "" }
	local function note(text)
		Session.claims += 1
		table.insert(N.Reward.log, 1, text)
		if #N.Reward.log > 4 then
			table.remove(N.Reward.log)
		end
		N.Reward.last = text
		log("CLAIM", text)
	end
	-- R13 (OWNER_RULES 24, owner 2026-10-13: "a hub log line is not proof"): every claim below logs success only when the
	-- game state confirms it (the server's answer AND the data field / the claimable list changed); otherwise
	-- `CLAIM <what> FAILED answer=<the server's reply>` and the claim is tried again later.
	local function failed(what, answer, extra)
		log(string.format("CLAIM %s FAILED answer=%s%s", what, brief(answer), extra or ""))
	end
	N.claimFailed = failed
	-- Each claim is its own toggle (owner rule); every function below is one of them.
	-- Offline coins: only a real grant (OfflineRewardsConfig.IsGrant, the game's own Claim check bc 31871-31910), counted
	-- when the server says Success and the grant is gone from Offline.Pending. The hatch recap: the game's own client
	-- acknowledges with RF.AcknowledgeHatches(Id) and counts it done when the answer is true or the recap is gone
	-- (bc 64618-64644); the hub does the same.
	local function offlineGrant(pending)
		local isGrant = N.G.OfflineCfg and N.G.OfflineCfg.IsGrant
		if type(isGrant) == "function" then
			local okG, yes = pcall(isGrant, pending)
			if okG then
				return yes == true
			end
		end
		return type(pending) == "table"
	end
	N.offlineGrant = offlineGrant
	function N.offlineStep()
		local offline = N.sub(N.data(), "Offline")
		local pending = offline.Pending
		if offlineGrant(pending) and due("offline", 30) then
			local grantedAt = type(pending) == "table" and pending.GrantedAt or nil
			local coins = type(pending) == "table" and tonumber(pending.Coins) or nil
			local result = invoke("OfflineRewardsService.RF.Claim")
			local gone = waitFor(function()
				local p = N.sub(N.data(), "Offline").Pending
				return not offlineGrant(p) or (type(p) == "table" and p.GrantedAt ~= grantedAt)
			end, 3)
			if ok(result) and gone then
				note("offline coins ok" .. (if coins then " +" .. formatNumber(coins) else ""))
			else
				failed("offline coins", result, if ok(result) then " (the grant is still pending)" else "")
			end
		end
		local hp = offline.HatchPending
		if type(hp) == "table" and hp.Id ~= nil and due("ackHatch", 30) then
			local result = invoke("OfflineRewardsService.RF.AcknowledgeHatches", hp.Id)
			local gone = waitFor(function()
				local now = N.sub(N.data(), "Offline").HatchPending
				return type(now) ~= "table" or now.Id ~= hp.Id
			end, 3)
			if gone or result == true then
				note("offline hatch recap ok (" .. tostring(hp.Hatched or "?") .. " eggs)")
			else
				failed("offline hatch recap", result)
			end
		end
	end
	-- R6-2: what the server writes into Data.Quests, followed every few seconds: a new id = the server handed a quest out
	-- (`QUEST accepted <id> (<source>)`: a starter quest, the sequel of a claimed one or the island's own), an Amount change
	-- = `QUEST progress <id> n/m`, an AutoClaim quest the server claimed = `QUEST claimed <id> +<reward> (auto)`. The first
	-- look only learns what is there. The reward in plain words: QuestConfig Reward = { "Clicks" | "Gems" | "Rebirths",
	-- "Currency", amount } (3097 L388430-388553; "Clicks" are coins, QuestController L209107).
	N.QuestWatch = { known = nil, session = 0, at = -1e9 }
	function N.questRewardText(def)
		local reward = N.tableOr(N.tableOr(def).Reward)
		local what = if reward[1] == "Clicks" then "coins" else string.lower(tostring(reward[1] or "reward"))
		return formatNumber(tonumber(reward[3]) or 0) .. " " .. what
	end
	local function questSource(id)
		local defs = N.tableOr(N.G.Quests.Definitions)
		for pid, d in pairs(defs) do
			if type(d) == "table" and d.Sequel == id then
				return "the sequel of " .. tostring(pid)
			end
		end
		local d = defs[id]
		if type(d) == "table" and type(d.AssignOnIsland) == "string" then
			return d.AssignOnIsland .. " hands it out"
		end
		if table.find(N.tableOr(N.G.Quests.Initial), id) then
			return "a starter quest"
		end
		return "from the server"
	end
	function N.questWatch(force)
		local data = N.data()
		if not data or (not force and os.clock() - N.QuestWatch.at < 3) then
			return
		end
		local W = N.QuestWatch
		W.at = os.clock()
		local defs = N.tableOr(N.G.Quests.Definitions)
		local first = W.known == nil
		W.known = W.known or {}
		for id, q in pairs(N.sub(data, "Quests")) do
			if type(q) == "table" then
				local key = tostring(id)
				local def = N.tableOr(defs[id])
				local goal = tonumber(def.Goal) or 1
				local amount = math.min(tonumber(q.Amount) or 0, goal)
				local seen = W.known[key]
				if not seen then
					W.known[key] = { amount = amount, claimed = q.Claimed == true }
					if not first and q.Claimed ~= true then
						log(string.format("QUEST accepted %s (%s): %s %d/%d", key, questSource(id), tostring(def.Description or "?"), amount, goal))
					end
				else
					if amount ~= seen.amount and q.Claimed ~= true then
						seen.amount = amount
						log(string.format("QUEST progress %s %d/%d", key, amount, goal))
					end
					if q.Claimed == true and not seen.claimed then
						seen.claimed = true
						if def.AutoClaim == true then
							W.session += 1
							log(string.format("QUEST claimed %s +%s (auto)", key, N.questRewardText(def)))
						end
					end
				end
			end
		end
	end
	-- Claims every finished quest the server does not claim by itself (non-AutoClaim, shown by QuestVisibility.IsShown).
	-- `force` skips the 15 s pacing (the quest-task trip claims the moment its quest is done, so the sequel comes at once).
	function N.claimQuests(force)
		local data = N.data()
		if not data or not (force or due("quests", 15)) then
			return 0
		end
		N.questWatch(true)
		local claimed = 0
		local defs = N.tableOr(N.G.Quests.Definitions)
		for id, q in pairs(N.sub(data, "Quests")) do
			local def = defs[id]
			if type(def) == "table" and type(q) == "table" and def.AutoClaim ~= true and q.Claimed ~= true and (q.Completed == true or (tonumber(q.Amount) or 0) >= (tonumber(def.Goal) or math.huge)) and (N.Reward.failed[id] or 0) < os.clock() then
				local shown = true
				if type(N.G.QuestVisibility.IsShown) == "function" then
					local okShown, yes = pcall(N.G.QuestVisibility.IsShown, data, id)
					shown = not okShown or yes == true
				end
				if shown then
					if ok(invoke("QuestService.RF.ClaimQuest", { Quest = tostring(id) })) then
						claimed += 1
						Session.claims += 1
						N.QuestWatch.session += 1
						local seen = N.QuestWatch.known and N.QuestWatch.known[tostring(id)]
						if seen then
							seen.claimed = true
						end
						N.Reward.last = "quest " .. tostring(id)
						table.insert(N.Reward.log, 1, N.Reward.last)
						if #N.Reward.log > 4 then
							table.remove(N.Reward.log)
						end
						log(string.format("QUEST claimed %s +%s", tostring(id), N.questRewardText(def)))
					else
						N.Reward.failed[id] = os.clock() + 600
					end
				end
			end
		end
		if claimed > 0 then
			-- the sequel the server hands out for a claimed quest (live it arrives with the next replica update: the next
			-- look 3 s later logs it)
			N.questWatch(true)
		end
		return claimed
	end
	function N.questStep()
		N.questWatch()
		N.claimQuests(false)
	end
	-- R13 (OWNER_RULES 24): the index claims are counted by the game's own list, PetIndexCatalog.Claimables(Data.Pets)
	-- (3937 bc 240176-240201: one pet in one tier = Pets.IndexPetRewards["<name>_<tier>"], an egg page per tier =
	-- Pets.IndexRewards[egg][tier], the Secrets page), before and after. Claim All first (the CLAIM ALL button, 3687
	-- L206832-206841); what is still listed 4 s later goes through the game's own single claims, one call per egg page
	-- (RewardClaimRequested(page)) and per pet tier (PetRewardClaimRequested(name, tier)), at most 40 per pass. The server's
	-- RewardClaimResult {Success, Reason} (bc 75770-75780) is the answer in the FAILED line; a refused item rests 30 min.
	N.IndexClaim = { result = nil, at = -1e9, rest = {}, total = 0 }
	N.onEvent("PetIndexService.RE.RewardClaimResult", function(p)
		if type(p) == "table" then
			N.IndexClaim.result, N.IndexClaim.at = p, os.clock()
		end
	end)
	local function indexClaimables()
		if type(N.G.Index.Claimables) ~= "function" then
			return nil
		end
		local okList, list = pcall(N.G.Index.Claimables, N.sub(N.data(), "Pets"))
		return if okList and type(list) == "table" then list else nil
	end
	N.indexClaimables = indexClaimables
	local function claimKey(c)
		if type(c) == "table" then
			return tostring(c.Kind) .. " " .. tostring(c.Name) .. (if c.Tier and c.Tier ~= "Normal" then " " .. tostring(c.Tier) else "")
		end
		return tostring(c)
	end
	function N.indexClaimable(kind, name, tier)
		for _, c in ipairs(indexClaimables() or {}) do
			if type(c) == "table" and c.Kind == kind and c.Name == name and (tier == nil or c.Tier == tier) then
				return true
			end
		end
		return false
	end
	function N.indexStep()
		if not due("index", 60) then
			return
		end
		local before = indexClaimables()
		if not before or #before == 0 then
			return
		end
		local IC = N.IndexClaim
		local fresh = 0
		for _, c in ipairs(before) do
			if (IC.rest[claimKey(c)] or -1e9) < os.clock() then
				fresh += 1
			end
		end
		if fresh == 0 then
			return
		end
		local n0 = #before
		local sentAt = os.clock()
		local via = "Claim All"
		fire("PetIndexService.RE.ClaimAllRequested")
		waitFor(function()
			local now = indexClaimables()
			return now ~= nil and #now < n0
		end, 4)
		local left = indexClaimables() or before
		if #left > 0 then
			-- what Claim All left: the game's own single claims (one call per egg page, one per pet tier)
			local sent, pages = 0, {}
			for _, c in ipairs(left) do
				if sent >= 40 or not alive() then
					break
				end
				local key = claimKey(c)
				if type(c) == "table" and (IC.rest[key] or -1e9) < os.clock() then
					if c.Kind == "Egg" and type(c.Name) == "string" and not pages[c.Name] then
						pages[c.Name] = true
						if fire("PetIndexService.RE.RewardClaimRequested", c.Name) then
							sent += 1
						end
						task.wait(0.3)
					elseif c.Kind == "Pet" and type(c.Name) == "string" and type(c.Tier) == "string" then
						if fire("PetIndexService.RE.PetRewardClaimRequested", c.Name, c.Tier) then
							sent += 1
						end
						task.wait(0.3)
					end
				end
			end
			if sent > 0 then
				via = string.format("Claim All + %d single claim%s", sent, if sent == 1 then "" else "s")
				local n1 = #left
				waitFor(function()
					local now = indexClaimables()
					return now ~= nil and #now < n1
				end, 4)
				left = indexClaimables() or left
			end
		end
		local got = n0 - #left
		if got > 0 then
			IC.total += got
			note(string.format("pet index ok: %d of %d rewards claimed (%s)", got, n0, via))
		end
		if #left > 0 then
			local r = IC.result
			local answer = if r and IC.at >= sentAt then (r.Reason or r) else "no answer"
			local names = {}
			for i = 1, math.min(#left, 4) do
				table.insert(names, claimKey(left[i]))
			end
			failed("pet index", answer, string.format(" left=%d (%s%s)", #left, table.concat(names, ", "), if #left > 4 then ", ..." else ""))
			for _, c in ipairs(left) do
				IC.rest[claimKey(c)] = os.clock() + 1800
			end
		end
	end
	-- strategy.md item 11: log the Pet Power leaderboard placement once per session (read-only; the game's own HUD fires
	-- GetPlacement("PetPower"), 3687 L136224). Settles the owned-vs-equipped question (if Score tracks all owned pets, keep
	-- the storage full of the strongest; the planner change is only informational for now).
	N.LbRankLogged = false
	function N.lbRankStep()
		if N.LbRankLogged then
			return
		end
		N.LbRankLogged = true
		local placement = invoke("LeaderboardService.RF.GetPlacement", "PetPower")
		if type(placement) == "table" then
			local rank = tonumber(placement.Rank or placement.Placement or placement.Position)
			local score = tonumber(placement.Score or placement.Value or placement.Power)
