		cardSkin(card, 12)
		do local sc = Instance.new("UIScale"); sc.Scale = Library.UIScale or 1; sc.Parent = card end
		Library:Padding(16, 16, 16, 16).Parent = card
		Library:List(Enum.FillDirection.Vertical, 10, "left").Parent = card
