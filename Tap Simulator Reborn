	-- ----- Balloon Luck
	function N.balloonState()
		local d = N.data()
		local Fm = N.G.BalloonLuckFormula
		if type(d) ~= "table" or type(Fm.LevelOf) ~= "function" or type(Fm.AirOf) ~= "function" or type(Fm.Cost) ~= "function" then
			return nil
		end
		local okL, level = pcall(Fm.LevelOf, d)
		local okA, air = pcall(Fm.AirOf, d)
		if not (okL and okA and type(level) == "number" and type(air) == "number") then
			return nil
		end
		local okC, cost = pcall(Fm.Cost, level + 1)
		return { level = level, air = air, cost = if okC and type(cost) == "number" then cost else nil, max = tonumber(N.G.BalloonLuck.MaxLevel) or 20 }
	end
	function N.balloonReady()
		if N.remote("BalloonLuckService.RF.Inflate") == nil or os.clock() - HV.balloonFailAt < 600 then
			return false
		end
		local st = N.balloonState()
		return st ~= nil and st.cost ~= nil and st.air >= st.cost
	end
	function N.balloonTrip()
		local egg = N.G.BalloonLuck.Egg or "30M Visits"
		N.tripBegin("balloon")
		waitFor(function()
			return not N.Hatch.inFlight
		end, 4)
		N.loopStatus("Main", "Inflating the Balloon Luck egg")
		local done = 0
		if N.travel(N.eggIsland(egg)) then
			local pos = N.eggPos(egg)
			if pos then
				N.teleport(pos + Vector3.new(0, 3, 8), 0.5)
			end
			for _ = 1, tonumber(N.G.BalloonLuck.MaxLevel) or 20 do
				local st = N.balloonState()
				if not (st and st.cost and st.air >= st.cost) then
					break
				end
				local before = st.level
				local r = N.pacedInvoke("BalloonLuckService.RF.Inflate")
				if not ok(r) then
					HV.balloonFailAt = os.clock()
					HV.last = "balloon refused: " .. reasonOf(r)
					log("BALLOON inflate refused:", reasonOf(r))
					break
				end
				done += 1
				HV.inflates += 1
				waitFor(function()
					local s = N.balloonState()
					return s ~= nil and s.level > before
				end, 2)
				local after = N.balloonState()
				HV.last = string.format("balloon inflated to level %d", if after then after.level else before + 1)
				log("BALLOON inflated", "level", if after then after.level else before + 1)
			end
		end
		N.tripEnd()
		return done
	end
	function N.heavenText()
		local lines = {}
		local readyAt = N.luckyEggReadyAt()
		local d = N.data()
		local boosts = type(d) == "table" and type(d.ActiveBoosts) == "table" and d.ActiveBoosts
		local left = boosts and tonumber(boosts[luckyCfg().Boost or "Lucky Eggs"]) or 0
		table.insert(lines, string.format("Lucky Egg Machine: %s%s", if readyAt <= serverNow() then "ready" else "ready in " .. N.longTime(readyAt - serverNow()), if left > 0 then ", Lucky Eggs on for " .. N.longTime(left) else ""))
		local st = N.balloonState()
		if st then
			table.insert(lines, string.format("Balloon Luck: level %d / %d, air %s%s", st.level, st.max, formatNumber(st.air), if st.cost then " / " .. formatNumber(st.cost) .. " for the next level" else " (maxed)"))
		else
			table.insert(lines, "Balloon Luck: no data yet")
		end
		table.insert(lines, string.format("Session: %d machine starts, %d inflates", HV.luckyEggs, HV.inflates))
		if HV.last ~= "" then
			table.insert(lines, "Last: " .. HV.last)
		end
		return table.concat(lines, "\n")
	end

