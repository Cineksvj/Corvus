	-- Ends the running trip for a higher group: the Main turn is cancelled and a fresh one starts (the restart path of
	-- N.restartLoop without its PROBLEM line and 30 s guard), the trip's locks and a half-done move are released.
	function N.preemptMain(group, trip)
		local body = LoopBody.Main
		if not body then
			return false
		end
		local old = LoopThread.Main
		N.Priority.preemptAt = os.clock()
		-- the cancel comes first: a Main turn that sits in an engine call cannot be cancelled (task.cancel throws), and a
		-- turn that lived on would move the character under the new one; the watch asks again in 15 s
		if old and old ~= coroutine.running() and not pcall(task.cancel, old) then
			log(string.format("PRIORITY %s waits: the %s trip is inside an engine call", group, tostring(trip)))
			return false
		end
		log(string.format("TRIP %s ended for %s: it stands higher in the Priority list (%ds into the trip)", tostring(trip), group, math.floor(os.clock() - (N.Trip.since or os.clock()))))
		N.Priority.preempts += 1
		N.Priority.last = tostring(trip) .. " gave way to " .. string.lower(group)
		N.Priority.pending, N.Priority.pendingAt = group, os.clock()
		if N.Trip.active then
			N.Trip.cutting = true
			N.tripEnd()
		end
		N.PetLock.craft = false
		if N.Hide and N.Hide.on and N.stopHiding then
			pcall(N.stopHiding)
		end
		N.moveReset("the " .. tostring(trip) .. " trip gave way to " .. string.lower(group))
		table.clear(N.InvokeBusy)
		N.Hatch.inFlight = false
		N.Hatch.nextAt = 0
		ChoreAt.minigames, ChoreAt.trip = nil, nil
		loop("Main", body)
		return true
	end
	function N.priorityWatch()
		local T, P = N.Trip, N.Priority
		-- a cut made for a group that then started no trip of its own (its slot bailed out): that group does not cut again
		-- for 2 minutes, so a trip is never cut twice for nothing
		if P.pending ~= nil and os.clock() - P.pendingAt > 5 then
			P.deny[P.pending] = os.clock()
			log(string.format("PRIORITY %s asked for the cut but started no trip: it does not cut again for 2 min", P.pending))
			P.pending = nil
		end
		if not (T.active and T.group) or os.clock() - T.since < 3 or os.clock() - P.preemptAt < 15 then
			return false
		end
		if next(N.InvokeBusy) ~= nil then
			return false -- never in the middle of a server call
		end
		for _, name in ipairs(N.priorityOrder()) do
			if name == T.group then
				return false
			end
			local g = Groups[name]
			if g and os.clock() - (P.deny[name] or -1e9) > 120 then
				local ok, due = pcall(g.due)
				if ok and due then
					return N.preemptMain(name, T.name)
				end
			end
		end
		return false
	end
