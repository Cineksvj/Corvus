	end
	function N.godlyCount()
		return N.itemCount(N.godlyItemName())
	end
	function N.godlyWanted()
		if not on("UseGodlyHatches") or N.godlyCount() < 1 then
			return false
		end
		if N.luckWindowNow then
			local live = N.luckWindowNow()
			if live then
				return true
			end
		end
		return N.eventActive ~= nil and (N.eventActive("Luck") or N.eventActive("Mythic")) == true
	end
	-- G4 (3937 code pass): the server holds one hatch request for HatchAnimationConfig.ShortestReveal(speed, count) (bc
	-- 238857-238866) = a fixed part (card stagger, receipts, poof, card exit, fade) + a part that shrinks with hatch speed
	-- (x8: 1.805 + 3.126 / speed s). The measured Held of the answers decides the split: the fixed part from the formula,
	-- the rest of the measured hold is what speed shortens; without a measurement the formula alone.
	-- N.hatchSpeedGain(x) = the relative gain in eggs per second from x more hatch speed (+10 % speed = +2.7 % to +4.2 %
	-- eggs, not +10 %); every Hatch Speed source (skill nodes, gem upgrade, relics, the Hatch Speed totem) uses it.
	local function holdMedian()
		local list = {}
		for _, v in ipairs(N.Hatch.holds or {}) do
			if N.finite(v) and v > 0 then
				table.insert(list, v)
			end
		end
		if #list == 0 then
			return nil
		end
		table.sort(list)
		return list[math.ceil(#list / 2)]
	end
	function N.hatchHold()
		local count = math.max(tonumber(N.Hatch.count) or (if N.hasX8() then 8 else 3), 1)
		local speed = tonumber(N.Hatch.speed) or 1
		if not N.finite(speed) or speed <= 0 then
			speed = 1
		end
		local fixed, total
		local fn = N.G.HatchAnim.ShortestReveal
		if type(fn) == "function" then
			local okF, f = pcall(fn, 1e6, count)
			local okT, t = pcall(fn, speed, count)
			if okF and okT and N.finite(f) and N.finite(t) and t > f and f > 0 then
				fixed, total = f, t
			end
		end
		if not fixed then
			fixed = 1 + 0.115 * (count - 1)
			total = fixed + 3.126 / speed
		end
		local measured = holdMedian()
		local cycle = if measured and measured > fixed + 0.05 then measured else total
		return fixed, cycle - fixed, cycle, speed, measured ~= nil and measured > fixed + 0.05
	end
	function N.hatchSpeedGain(x)
		x = tonumber(x) or 0
		if not N.finite(x) or x <= 0 then
			return 0
		end
		local fixed, var, cycle = N.hatchHold()
		local after = fixed + var / (1 + x)
		return if after > 0 then cycle / after - 1 else 0
	end
	N.onEvent("EggService.RE.EggHatchResult", function(r)
		if type(r) ~= "table" or r.Success ~= true or type(r.Pets) ~= "table" then
			return
		end
		for _, pet in ipairs(r.Pets) do
			if type(pet) == "table" and type(pet.Id) == "string" and type(pet.Rarity) == "string" and string.match(pet.Rarity, "^Secret") ~= nil and not SR.pending[pet.Id] then
				SR.pending[pet.Id] = os.clock()
				log(string.format("SECRET hatched %s id=%s egg=%s rarity=%s%s", tostring(pet.Name), pet.Id, tostring(r.Egg), pet.Rarity, if pet.AutoDeleted == true then " (auto-deleted)" else ""))
				task.spawn(N.secretRelease, pet)
			end
		end
		if r.Godly == true then
			log(string.format("HATCH godly egg=%s left=%s", tostring(r.Egg), tostring(r.GodlyLeft or N.godlyCount())))
		end
		-- the hold split, measured: once after 3 answers, then hourly
		if #(N.Hatch.holds or {}) >= 3 and due("holdFit", 3600) then
			local fixed, var, cycle, speed, measured = N.hatchHold()
			log(string.format("HATCH hold fit fixed=%.2f var=%.2f/speed held=%.2f speed=%.2f share=%.2f (+10%% speed = +%.1f%% eggs, %s)", fixed, var * speed, cycle, speed, var / cycle, N.hatchSpeedGain(0.1) * 100, if measured then "measured" else "formula"))
		end
	end)

	function N.upgradeValue(name, level)
		if name == "ClickMultiplier" then
			return (1 + (level + 1) / 20) / (1 + level / 20) - 1
		elseif name == "HatchSpeed" then
			-- G4 (3937): the eggs this speed step adds, through the server's hatch hold (N.hatchSpeedGain), not 1:1
			return N.hatchSpeedGain((1 + (level + 1) / 15) / (1 + level / 15) - 1) * N.hatchWeight()
		elseif name == "CriticalChance" then
			-- strategy.md item 1: value the extra crit chance by the FULL crit power P (achievements x mastery x enchant),
			-- not the old 10 x (1 + skill) that ignored the mastery and enchant stack
			local P = N.critStats().P
			local p0, p1 = critChance(level), critChance(level + 1)
			return (p1 - p0) * (P - 1) / (1 + p0 * (P - 1)) * (1 - autoShare())
		elseif name == "AutoClickerSpeed" then
			-- the server admits one tap per 0.1 s across both lanes: a faster Auto Clicker only fills gaps
			return autoShare() * 0.02
		end
		return 0
	end
	function N.upgradeRequirement(name, level)
		if type(N.G.Upgrades.GetRetainedRequirement) == "function" then
			local okZ, z = pcall(N.G.Upgrades.GetRetainedRequirement, name, level)
			if okZ and type(z) == "string" then
				return z
			end
		end
		return nil
	end
	-- Every next level that exists, with its gems, value and the zone it waits for (nil = buyable now).
	function N.upgradeLevels()
		local out = {}
		local data = N.data()
		if not data or type(N.G.Upgrades.GetPrice) ~= "function" then
			return out
		end
		local levels = N.sub(data, "Upgrades")
		for name, def in pairs(N.tableOr(N.G.Upgrades.Definitions)) do
			if type(def) == "table" and def.SkillTreeNode == nil and name ~= "Teleport" and (N.Spend.refused["upgrade " .. name] or 0) < os.clock() then
				local level = math.floor(tonumber(levels[name]) or 0)
				local total = tonumber(def.LaunchTotal) or 0
				if level < total then
					local okP, price = pcall(N.G.Upgrades.GetPrice, name, level + 1)
					local value = N.upgradeValue(name, level)
					if okP and type(price) == "number" and value > 0 then
						local zone = N.upgradeRequirement(name, level)
						-- REV-2: when PROBE upgrade_zone_gate showed the zone is only a client gate, a zone-gated level is buyable
						local gated = zone and not N.zoneUnlocked(zone) and N.probeState("upgrade_zone_gate") ~= "accepted"
						table.insert(out, { kind = "upgrade", name = name, cost = price, value = value, level = level + 1, zone = if gated then zone else nil, gate = if zone and not N.zoneUnlocked(zone) then zone else nil })
					end
				end
			end
		end
		return out
	end
	function N.upgradeOptions()
		local out = {}
		for _, o in ipairs(N.upgradeLevels()) do
			if o.zone == nil then
				table.insert(out, o)
			end
		end
		return out
	end
	-- UI-2: what the Upgrades panel says when every next level waits for a zone.
	N.ZonesAbsentText = "Zones are not in this game version yet; the game keeps these upgrades locked"
	function N.upgradeLockText()
		local zones = {}
		for _, o in ipairs(N.upgradeLevels()) do
			if o.zone and not table.find(zones, o.zone) then
				table.insert(zones, o.zone)
			end
		end
		if #zones == 0 then
			return nil
		end
		-- R5-1 / R6-4: the map sweep found no zone in this game version
		if N.zonesAbsent and N.zonesAbsent() then
			return N.ZonesAbsentText
		end
		local first = zones[1]
		for _, u in ipairs(N.nextUnlocks()) do
			if u.kind == "zone" then
				first = u.name
				break
			end
		end
		local wait = (N.Unlock.refused[first] or 0) - os.clock()
		return string.format("Locked: unlock the %s zone first (%s)", first, if wait > 0 then "next try in " .. N.longTime(wait) elseif N.does("AutoUnlockZones") then "Auto Unlock Zones is on it" else "turn on Auto Unlock Zones")
	end
	-- REV-2 PROBE upgrade_zone_gate: is the zone requirement checked by the server at all? One purchase of the best gated
	-- level the gems pay for, from where the player stands; Success = the zone is only a client gate (every gated level is
	-- buyable from now on), a zone answer = rejected (the zones first), a distance answer = the station decides (state
	-- "station": the next try is made standing in the Winter Upgrades point when its spot is known). Once per game version.
	function N.zoneGateProbe(planner)
		local state = N.probeState("upgrade_zone_gate")
		if state == "accepted" or state == "rejected" then
			return false
		end
		local gems = N.gems()
		local pick
		for _, o in ipairs(N.upgradeLevels()) do
			if o.zone and o.cost <= gems and (not pick or o.value / o.cost > pick.value / pick.cost) then
				pick = o
			end
		end
		if not pick then
			return false
		end
		if state == "station" then
			local point = N.upgradePoint()
			if not point or not N.insidePoint(point) then
				return false
			end
		end
		local before = math.floor(tonumber(N.sub(N.data(), "Upgrades")[pick.name]) or 0)
		local result = invoke("UpgradeService.RF.Purchase", { Name = pick.name })
		local reason = string.lower(tostring(type(result) == "table" and (result.Reason or result.Error or result.Message) or "no answer"))
		if ok(result) then
			N.probeResult("upgrade_zone_gate", "accepted", string.format("gain=%s %d->%d without the %s zone", pick.name, before, before + 1, pick.zone), "accepted")
			log(string.format("UPGRADE %s %d->%d gems=%s value=+%.2f%%", pick.name, before, before + 1, formatNumber(pick.cost), pick.value * 100))
			Session.buys += 1
			return true
		end
		if string.find(reason, "zone", 1, true) or string.find(reason, "lock", 1, true) or string.find(reason, "require", 1, true) then
			N.probeResult("upgrade_zone_gate", "rejected", "gain=0 (" .. reason .. "): the " .. pick.zone .. " zone first", "rejected")
		elseif state ~= "station" and (string.find(reason, "far", 1, true) or string.find(reason, "near", 1, true)) then
			N.probeResult("upgrade_zone_gate", "station", "gain=? (" .. reason .. "): decided at the Winter Upgrades point", "station")
		else
			N.probeResult("upgrade_zone_gate", "rejected", "gain=0 (" .. reason .. ")", "rejected")
		end
		return false
	end
	-- Plain toggle: the cheapest affordable thing. Planner: the best value per gem; when the best one overall is not
	-- affordable yet but the gem income reaches it within 15 minutes, the gems wait for it (farming goes on meanwhile).
	function N.pickSpend(planner, wantSkill, wantUpgrade)
		local gems = N.gems()
		local options = if wantSkill then N.skillOptions() else {}
		if wantUpgrade then
			for _, o in ipairs(N.upgradeOptions()) do
				table.insert(options, o)
			end
		end
		local best, bestAll
		for _, o in ipairs(options) do
			o.score = if o.cost <= 0 then math.huge else o.value / o.cost
			if planner then
				if o.value > 0 and (not bestAll or o.score > bestAll.score) then
					bestAll = o
				end
				if o.cost <= gems and o.value > 0 and (not best or o.score > best.score) then
					best = o
				end
			elseif o.cost <= gems and (not best or o.cost < best.cost) then
				best = o
			end
		end
		if planner and bestAll and best ~= bestAll and bestAll.cost > gems then
			local rate = N.Plan and N.Plan.gemRate or 0
			if rate > 0 and (bestAll.cost - gems) / rate < 900 then
				N.Spend.pick = bestAll
				return nil, bestAll
			end
		end
		N.Spend.pick = best
		return best
	end
	-- The upgrades that need the Winter station trip right now (remote purchase answered with a distance reason).
	function N.upgradeTripWanted(planner)
		-- REV-2: the zone-gate probe answered with a distance: one station visit decides it (Winter itself may be locked)
		local gateAtStation = N.probeState("upgrade_zone_gate") == "station"
		if gateAtStation then
			local gems = N.gems()
			for _, o in ipairs(N.upgradeLevels()) do
				if o.zone and o.cost <= gems then
					return { o }, o.value
				end
			end
		end
		if N.probeState("upgrade_remote") ~= "rejected" or not N.zoneUnlocked("Winter") then
			return nil
		end
		local gems = N.gems()
		local list = {}
		for _, o in ipairs(N.upgradeOptions()) do
			if o.cost <= gems then
				table.insert(list, o)
			end
		end
		if #list == 0 then
			return nil
		end
		table.sort(list, function(a, b)
			return a.value / a.cost > b.value / b.cost
		end)
		local value = 0
		for _, o in ipairs(list) do
			value += o.value
		end
		return list, value
	end
	local function distanceReason(result)
		local reason = string.lower(tostring(type(result) == "table" and (result.Reason or result.Error or result.Message) or ""))
		return string.find(reason, "far", 1, true) ~= nil or string.find(reason, "near", 1, true) ~= nil or string.find(reason, "range", 1, true) ~= nil or string.find(reason, "distance", 1, true) ~= nil
	end
	local function buyUpgrade(o, planner)
		local before = math.floor(tonumber(N.sub(N.data(), "Upgrades")[o.name]) or 0)
		local result = invoke("UpgradeService.RF.Purchase", { Name = o.name })
		if ok(result) then
			Session.buys += 1
			N.Spend.last = string.format("upgrade %s %d -> %d for %s gems", o.name, before, before + 1, formatNumber(o.cost))
			log(string.format("UPGRADE %s %d->%d gems=%s value=+%.2f%%", o.name, before, before + 1, formatNumber(o.cost), o.value * 100))
			if N.Events.bought then
				pcall(N.Events.bought, o.name, o.cost)
			end
			return true, result
		end
		return false, result
	end
	function N.spendStep(planner, wantSkill, wantUpgrade)
		if wantUpgrade and N.zoneGateProbe(planner) then
			return true
		end
		local remote = N.probeState("upgrade_remote")
		local pick, waitingFor = N.pickSpend(planner, wantSkill, wantUpgrade and remote ~= "rejected")
		if not pick then
			if waitingFor then
				N.Spend.last = string.format("saving gems for %s (%s gems) while farming", waitingFor.name, formatNumber(waitingFor.cost))
			end
			return false
		end
		local text = string.format("%s %s for %s gems (value %.3f)", if pick.kind == "skill" then "skill" else "upgrade", pick.name, formatNumber(pick.cost), pick.value)
		-- R3-3: a big gem buy is announced 10 s ahead (and waits for the owner's OK above his budget)
		if N.gemGate and not N.gemGate("spend " .. pick.name, pick.cost, string.format("%s %s for %s gems (+%.2f %% income)", if pick.kind == "skill" then "skill" else "upgrade", pick.name, formatNumber(pick.cost), pick.value * 100)) then
			return false
		end
		if planner and N.planLog then
			N.planLog("spend " .. pick.name, "buy " .. text, 600, 0)
		end
		if pick.kind == "upgrade" then
			local okBuy, result = buyUpgrade(pick, planner)
			if okBuy then
				if remote == "untested" then
					N.probeResult("upgrade_remote", "accepted", "gain=no trip (bought " .. pick.name .. " from " .. N.currentIsland() .. ")", "accepted")
				end
				return true
			end
			if distanceReason(result) then
				if remote ~= "rejected" then
					N.probeResult("upgrade_remote", "rejected", "gain=0 (" .. brief(result) .. "), upgrades go through the Winter station", "rejected")
				end
				N.Spend.last = "upgrades wait for the trip to the Winter station"
				return false
			end
			N.Spend.refused["upgrade " .. pick.name] = os.clock() + 600
			N.Spend.last = pick.name .. " refused (" .. tostring(type(result) == "table" and (result.Reason or result.Message) or "no answer") .. ")"
			log("BUY refused", text, brief(result))
			return false
		end
		local result = invoke("SkillTreeService.RF.Unlock", { Name = pick.name })
		if ok(result) then
			Session.buys += 1
			N.Spend.last = "bought " .. text
			log("BUY", text)
			if N.Events.bought then
				pcall(N.Events.bought, pick.name, pick.cost)
			end
			return true
		end
		N.Spend.refused[pick.kind .. " " .. pick.name] = os.clock() + 600
		N.Spend.last = pick.name .. " refused (" .. tostring(type(result) == "table" and (result.Reason or result.Message) or "no answer") .. ")"
		log("BUY refused", text, brief(result))
		return false
	end
	-- The Upgrades InteractionPoint of the Winter zone (attribute Island = "Winter").
	function N.upgradePoint()
		for _, p in ipairs(game:GetService("CollectionService"):GetTagged("InteractionPoint")) do
			if p.Name == "Upgrades" and p:GetAttribute("Island") == "Winter" and p:IsDescendantOf(workspace) then
				return p
			end
		end
		return nil
	end
	-- One trip: Teleport menu to Winter, stand in the Upgrades point, buy every affordable level by value per gem (at most
	-- 40 calls), back to the egg through the arbiter. Hard cap 30 s.
	function N.upgradeTrip()
		local list = N.upgradeTripWanted(true)
		if not list then
			return 0
		end
		-- R3-3: the batch is announced 10 s ahead when it is a big share of the gems
		local total = 0
		for _, o in ipairs(list) do
			total += o.cost
		end
		if N.gemGate and not N.gemGate("upgrades", total, string.format("gem upgrades %s for %s gems", list[1].name, formatNumber(total))) then
			return 0
		end
		N.tripBegin("upgrades")
		local started = os.clock()
		N.loopStatus("Main", "buying gem upgrades at the Winter station")
		local bought = 0
		-- REV-2: with Winter still locked the station is reached by its spot (learned or found on the main map), not the menu
		local there = if N.zoneUnlocked("Winter") then N.travel("Winter") else N.travel("Spawn")
		if there then
			local point = N.findStreamed("UpgradeStation", N.upgradePoint, 5, not N.zoneUnlocked("Winter"))
			if point then
				local pos = N.posOf(point)
				N.teleport(pos + Vector3.new(0, 1, 0), 0.4)
				if N.probeState("upgrade_zone_gate") == "station" and N.zoneGateProbe(true) then
					bought += 1
				end
				local calls = 0
				while calls < 40 and os.clock() - started < 30 and alive() do
					local options = N.upgradeOptions()
					table.sort(options, function(a, b)
						return a.value / a.cost > b.value / b.cost
					end)
					local o = options[1]
					if not o or o.cost > N.gems() then
						break
					end
					calls += 1
					local okBuy, result = buyUpgrade(o, true)
					if okBuy then
						bought += 1
					else
						N.Spend.refused["upgrade " .. o.name] = os.clock() + 600
						log("UPGRADE", o.name, "refused at the station:", brief(result))
					end
					task.wait(0.15)
				end
			else
				log("UPGRADE station not found in the Winter zone")
				N.Spend.refused["upgrade trip"] = os.clock() + 1800
			end
		end
		N.Spend.tripAt = os.clock()
		N.tripEnd()
		return bought
	end

	-- ===== Islands and zones (G5-9, B2): the client sends IslandService.RE.IslandUnlockRequested / WorldService.RE.
	-- ZoneUnlockRequested {Action="Purchase", ...} only from the confirm dialog of a server-sent IslandPortalEncountered /
	-- PortalEncountered {Action="Purchase"} (3097 L128349-128366, L160644-160665): the player has to stand in the portal
	-- (Workspace.Portals.Portals.<PortalName>.Portal, Workspace.Zones.Portals.<Zone>.Portal.Portal, L128243-128268,
	-- L160422-160442). A blind purchase did nothing live. Coins only. Value (G5-3): the location multiplier of a zone counts
	-- 0 while the account farms on an island (TapFormula.GetLocationMultiplier L387736-387745 takes the island's); a zone is
	-- worth the gem upgrades it opens (Winter: Click Multiplier 1-5 ...), an island its multiplier on the taps. =====
	N.Unlock = { last = "", refused = {}, encounter = nil }
	N.onEvent("IslandService.RE.IslandPortalEncountered", function(p)
		if type(p) == "table" and (p.Action == "Purchase" or p.Action == "Blocked") then
			N.Unlock.encounter = { island = p.Island, action = p.Action, reason = p.Reason, price = tonumber(p.Price), at = os.clock() }
		end
	end)
	-- R3-5: the zone price the server names in the encounter is the one logged (the config said 1M, the Forest egg 2M)
	N.onEvent("WorldService.RE.PortalEncountered", function(p)
		if type(p) == "table" and (p.Action == "Purchase" or p.Action == "Blocked") then
			N.Unlock.encounter = { zone = p.Zone, action = p.Action, reason = p.Reason, price = tonumber(p.Price), at = os.clock() }
		end
	end)
	function N.nextUnlocks()
		local out = {}
		local islands = {}
		for name, info in pairs(N.tableOr(N.G.Islands.Islands)) do
			if type(info) == "table" then
				table.insert(islands, { name = name, order = tonumber(info.Order) or 99, price = tonumber(info.Price) or math.huge, portal = info.PortalName, mult = tonumber(info.Multiplier) or 1 })
			end
		end
		table.sort(islands, function(a, b)
			return a.order < b.order
		end)
		for _, i in ipairs(islands) do
			if not N.islandUnlocked(i.name) then
				table.insert(out, { kind = "island", name = i.name, price = i.price, portal = i.portal, mult = i.mult })
				break
			end
		end
		local zones = {}
		for name, info in pairs(N.tableOr(N.G.Progression.Zones)) do
			if type(info) == "table" and name ~= "Spawn" then
				table.insert(zones, { name = name, order = tonumber(info.Order) or 99, price = tonumber(info.Price) or math.huge, mult = tonumber(info.Multiplier) or 1 })
			end
		end
		table.sort(zones, function(a, b)
			return a.order < b.order
		end)
		local prev = "Spawn"
		-- R5-1: no zone is offered when a full map sweep of this game version found none (PROBE zone_portals=absent)
		if N.zonesAbsent and N.zonesAbsent() then
			zones = {}
		end
		for _, z in ipairs(zones) do
			if not N.zoneUnlocked(z.name) then
				table.insert(out, { kind = "zone", name = z.name, price = z.price, mult = z.mult, from = prev })
				break
			end
			prev = z.name
		end
		table.sort(out, function(a, b)
			return a.price < b.price
		end)
		return out
	end
	-- The value of an unlock in seconds of income over 24 h (the planner's horizon).
	function N.unlockValue(u)
		if u.kind == "island" then
			local cur = N.tableOr(N.islandInfo(N.currentIsland()))
			local best = 1
			for name, info in pairs(N.tableOr(N.G.Islands.Islands)) do
				if type(info) == "table" and N.islandUnlocked(name) then
					best = math.max(best, tonumber(info.Multiplier) or 1)
				end
			end
			best = math.max(best, tonumber(cur.Multiplier) or 1)
			return math.max(u.mult / best - 1, 0) * 86400
		end
		-- a zone: the gem upgrades it (and the zones after it) open, as long as the gems pay for the first level
		local value = 0
		local gems = N.gems()
		local order = N.tableOr(N.tableOr(N.G.Progression.Zones)[u.name]).Order or 99
		for _, o in ipairs(N.upgradeLevels()) do
			if o.zone and o.cost <= gems then
				local zo = N.tableOr(N.tableOr(N.G.Progression.Zones)[o.zone]).Order or 99
				if zo >= order then
					value += o.value
				end
			end
		end
		-- the location multiplier counts only while the account farms in the zones (no island egg)
		if not N.islandInfo(N.eggIsland(N.Hatch.target or "")) and not N.islandInfo(N.currentIsland()) then
			value += math.max(u.mult - 1, 0) * 0.1
		end
		return value * 86400
	end
	local function unlocked(u)
		return if u.kind == "island" then N.islandUnlocked(u.name) else N.zoneUnlocked(u.name)
	end
	local function purchase(u)
		if u.kind == "island" then
			return fire("IslandService.RE.IslandUnlockRequested", { Action = "Purchase", Island = u.name })
		end
		return fire("WorldService.RE.ZoneUnlockRequested", { Action = "Purchase", Zone = u.name })
	end
	-- The touch part of the portal: the BasePart named Portal inside the portal Model (3097 getForwardPortal
	-- L160227-160242, getVisiblePortalPart L160244-160258). Only a BasePart counts: live R2-9/R2-12 the zone containers
	-- exist but are EMPTY until streamed in, and the old fallback returned the empty folder ("result=no portal" at once).
	local function portalPart(u)
		local model
		if u.kind == "island" then
			local portals = workspace:FindFirstChild("Portals")
			portals = portals and portals:FindFirstChild("Portals")
			model = portals and portals:FindFirstChild(u.portal or u.name)
		else
			local zones = workspace:FindFirstChild("Zones")
			local portals = zones and zones:FindFirstChild("Portals")
			local z = portals and portals:FindFirstChild(u.name)
			model = z and z:FindFirstChild("Portal")
		end
		if not model then
			return nil
		end
		if model:IsA("BasePart") then
			return model
		end
		local inner = model:FindFirstChild("Portal")
		if inner and inner:IsA("BasePart") then
			return inner
		end
		return nil
	end
	-- One unlock trip: to the map the portal stands on, into the portal, wait for the encounter, buy, confirm.
	function N.unlockTrip(u)
		if not u or unlocked(u) or (N.Unlock.refused[u.name] or 0) > os.clock() then
			return false
		end
		-- R5-1 (live: the second trip at 111 s went to the Spawn only to log "no portal on the map"): a zone whose portal is
		-- not known waits for the sweep's verdict without a trip
		if u.kind == "zone" and not N.place("ZonePortal" .. string.gsub(u.name, "%W", "")) then
			local absent = N.zonesAbsent and N.zonesAbsent()
			local missAt = N.ZoneSweep and N.ZoneSweep.missAt
			if absent or (missAt and os.clock() - missAt < 3600) then
				N.Unlock.refused[u.name] = if absent then math.huge else missAt + 3600
				N.Unlock.last = if absent then "" else u.name .. ": portal not found on the map, next search in " .. N.longTime(math.max(missAt + 3600 - os.clock(), 0))
				return false
			end
		end
		N.tripBegin("unlock")
		local started = os.clock()
		N.loopStatus("Main", "unlocking the " .. u.name .. " " .. u.kind)
		local result = "no portal"
		local encounterAt = nil
		local portalAt = nil
		if N.travel(if u.kind == "zone" then (u.from or "Spawn") else "Spawn") then
			-- streamed in near the player after the travel; a spot found once is remembered (Corvus/TAPSIM_places.txt); with
			-- no known spot the main map's landmarks are streamed one after another until the portal shows up (R3-2/R3-5)
			local placeKey = (if u.kind == "zone" then "ZonePortal" else "IslandPortal") .. string.gsub(u.name, "%W", "")
			local part = nil
			if u.kind == "zone" and not N.place(placeKey) then
				-- R4-1: no spot known for this zone's portal: it may have streamed in after the travel (the next zone's portal
				-- stands in the zone before it); else the background map sweep looks for it while the hub hatches on
				part = waitFor(function()
					return portalPart(u) ~= nil
				end, 1.5) and portalPart(u)
				if part then
					N.learnPlace(placeKey, N.posOf(part))
				else
					local state = N.zoneSweepStart(u.name)
					if state == "found" then
						part = N.findStreamed(placeKey, function()
							return portalPart(u)
						end, 3, false)
					else
						result = if state == "searching" then "searching (map sweep running)" else "no portal on the map (next sweep in 60 min)"
					end
				end
			else
				part = N.findStreamed(placeKey, function()
					return portalPart(u)
				end, 3, u.kind ~= "zone")
			end
			local pos = part and N.posOf(part)
			portalAt = pos
			if pos then
				N.Unlock.encounter = nil
				N.teleport(pos, 0.2)
				local function seen()
					return N.Unlock.encounter ~= nil or unlocked(u)
				end
				-- the server notices the player in the portal by touch: if it stays quiet, step through the portal twice
				if not waitFor(seen, 1.5) then
					N.portalNudge(pos)
				end
				if waitFor(seen, 1.5) then
					encounterAt = os.clock() - started
				end
				local enc = N.Unlock.encounter
				if unlocked(u) then
					result = "ok"
				elseif enc and enc.action == "Blocked" then
					result = "blocked (" .. tostring(enc.reason or "unlock the previous one first") .. ")"
				else
					-- the rebirths wait while this trip runs (p03 rebirthTick): the coins for the price come back within seconds
					local need = math.max(u.price, (enc and enc.price) or 0)
					if N.coins() < need then
						waitFor(function()
							return N.coins() >= need
						end, 15)
					end
					purchase(u)
					result = if waitFor(function()
						return unlocked(u)
					end, 4) then "ok" else (if enc then "refused" else "no encounter")
				end
			end
		end
		local encPrice = N.Unlock.encounter and N.Unlock.encounter.price
		log(string.format("UNLOCK %s %s portal=%s encounter=%s result=%s price=%s%s", u.kind, u.name, if portalAt then brief(portalAt) else "not found", if encounterAt then string.format("%.1fs", encounterAt) else "none", result, formatNumber(encPrice or u.price), if encPrice and encPrice ~= u.price then " (config " .. formatNumber(u.price) .. ")" else ""))
		N.tripEnd()
		if result == "ok" then
			Session.unlocks += 1
			N.Unlock.last = "unlocked " .. u.name
			N.incomeSpend(u.price)
			if N.Events.bought then
				pcall(N.Events.bought, u.name, u.price)
			end
			return true
		end
		if string.sub(result, 1, 9) == "searching" then
			-- R4-1: the sweep clears this as soon as the portal streams in (N.notePortal); its cap is 90 s
			N.Unlock.refused[u.name] = os.clock() + 95
			N.Unlock.last = u.name .. ": searching the map for its portal (up to 90 s)"
		elseif string.sub(result, 1, 20) == "no portal on the map" and N.ZoneSweep and N.ZoneSweep.missAt then
			N.Unlock.refused[u.name] = N.ZoneSweep.missAt + 3600
			N.Unlock.last = u.name .. ": portal not found on the map, next search in " .. N.longTime(math.max(N.ZoneSweep.missAt + 3600 - os.clock(), 0))
		else
			N.Unlock.refused[u.name] = os.clock() + 900
			N.Unlock.last = u.name .. ": " .. result .. ", next try in 15 min"
		end
		return false
	end
	-- Plain toggles (Auto Unlock Zones / Islands, no planner): the next one as soon as the coins pay for it.
	function N.unlockStep(budget, why, wantZone, wantIsland)
		for _, u in ipairs(N.nextUnlocks()) do
			if ((u.kind == "zone" and wantZone) or (u.kind == "island" and wantIsland)) and u.price <= budget and (N.Unlock.refused[u.name] or 0) < os.clock() then
				return N.unlockTrip(u)
			end
		end
		return false
	end
end
do
	-- ===== Third and fourth gem pass (blatant.md "Third pass" / "Fourth pass"): potions, world events, the daily mine,
