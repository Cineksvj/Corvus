				n += 1
			end
			table.insert(parts, string.format("%s [%d post%s]", maskUrl(hook.url), n, if n == 1 then "" else "s"))
		end
		return #list .. " webhook" .. (if #list == 1 then "" else "s") .. (if #parts > 0 then ": " .. table.concat(parts, ", ") else "")
	end
	local function statusText(hooks)
		if not hookOn() then
			return "Post to Discord is off: nothing leaves the game"
		elseif #hooks == 0 then
			return "No webhook URL yet: paste one above and pick its posts"
		end
		local queued = 0
		for _, q in pairs(Hook.queues) do
			queued += #q
		end
		return string.format("%d webhook%s on  \u{00B7}  sent %d  \u{00B7}  queued %d  \u{00B7}  dropped %d  \u{00B7}  failed %d", #hooks, if #hooks == 1 then "" else "s", Hook.sent, queued, Hook.dropped, Hook.failed)
	end
	-- one tick every 2.5 s: route, poll, report, cards, then one message per URL
	local function sendTick()
		local hooks = if hookOn() then N.webhooks() else {}
		if #hooks == 0 then
			if next(Hook.queues) then
				table.clear(Hook.queues)
			end
			Hook.lastLine = #Log.lines
			Hook.rebirths = nil
			table.clear(Hook.balance)
			table.clear(Hook.stock)
			Hook.reportAt = os.clock()
			if Labels.Webhook then
				Labels.Webhook:SetText(statusText(hooks))
			end
			return
		end
		local live = {}
		for _, hook in ipairs(hooks) do
			live[hook.url] = true
		end
		for url in pairs(Hook.queues) do
			if not live[url] then
				Hook.queues[url] = nil
			end
		end
		local now = os.clock()
		for sig, at in pairs(Hook.recent) do
			if now - at > 120 then
				Hook.recent[sig] = nil
			end
		end
		routeNewLines()
		pollState()
		local every = (Options.WebhookReport and tonumber(Options.WebhookReport.Value) or 0) * 60
		if every > 0 and now - Hook.reportAt >= every then
			Hook.reportAt = now
			N.post("report", reportEmbed("\u{2726}  Farm report"))
		end
		for _, hook in ipairs(hooks) do
			if hook.events and hook.events.card then
				pcall(cardTick, hook.url)
			end
			local q = Hook.queues[hook.url]
			if q and #q > 0 and (Hook.hold[hook.url] or 0) <= now then
				local batch = {}
				for i = 1, math.min(5, #q) do
					batch[i] = q[i]
				end
				local ok, code, body = Hook.send(hook.url, message(batch))
				if ok then
					for _ = 1, #batch do
						table.remove(q, 1)
					end
					Hook.sent += #batch
					Hook.tries[hook.url] = nil
				elseif code == 429 then
					local wait = tonumber(type(body) == "table" and body.retry_after) or 5
					Hook.hold[hook.url] = now + math.clamp(wait, 1, 60)
				elseif (code == 0 or code >= 500) and (Hook.tries[hook.url] or 0) < 3 then
					-- no answer or Discord down: three tries 30 s apart, then the batch is dropped
					Hook.tries[hook.url] = (Hook.tries[hook.url] or 0) + 1
					Hook.hold[hook.url] = now + 30
				else
					for _ = 1, #batch do
						table.remove(q, 1)
					end
					Hook.failed += #batch
					Hook.tries[hook.url] = nil
