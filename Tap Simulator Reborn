	-- the log lines logged since the last tick, each through the routing table
	local function routeNewLines()
		local lines = Log.lines
		if #lines < Hook.lastLine then
			Hook.lastLine = math.max(Hook.lastLine - 501, 0) -- the log just trimmed its first 501 lines
		end
		for i = Hook.lastLine + 1, #lines do
			local text = string.match(lines[i], "^%[%s*[%d%.]+%]%s(.*)$")
			if text then
				local key = routeLine(text)
				if key then
					N.post(key, lineEmbed(key, text))
				end
			end
		end
		Hook.lastLine = #lines
	end
	-- rebirths, balance drops and the egg stock are read from the data, not from the log
	local function pollState()
		local now = os.clock()
		local reb = N.rebirths()
		local rebirthed = false
		if Hook.rebirths == nil or reb < Hook.rebirths then
			Hook.rebirths = reb
		elseif reb > Hook.rebirths then
			rebirthed = true
			N.post("rebirth", {
				title = "\u{2726}  Rebirth " .. formatNumber(reb),
				description = string.format("**%s** rebirth%s now (+%d). Coins **%s**, gems **%s**.", formatNumber(reb), if reb == 1 then "" else "s", reb - Hook.rebirths, formatNumber(N.coins()), formatNumber(N.gems())),
				color = 15844367,
				fields = { { name = "Player", value = playerField(), inline = true } },
			})
			Hook.rebirths = reb
		end
		local B = Hook.balance
		local coins, gems = N.coins(), N.gems()
		if rebirthed then
			table.clear(B) -- a rebirth spends the coins on purpose
		end
		table.insert(B, { at = now, coins = coins, gems = gems })
		while #B > 0 and now - B[1].at > 60 do
			table.remove(B, 1)
		end
		local peakCoins, peakGems = 0, 0
		for _, s in ipairs(B) do
			peakCoins = math.max(peakCoins, s.coins)
			peakGems = math.max(peakGems, s.gems)
		end
		if (peakCoins >= 1000 and coins < peakCoins * 0.5) or (peakGems >= 100 and gems < peakGems * 0.5) then
			local what = if coins < peakCoins * 0.5 then string.format("Coins **%s** -> **%s**", formatNumber(peakCoins), formatNumber(coins)) else string.format("Gems **%s** -> **%s**", formatNumber(peakGems), formatNumber(gems))
			if N.post("balance_drop", {
					title = "\u{2726}  Balance drop",
					description = what .. " within a minute.",
					color = 15158332,
					fields = { { name = "Player", value = playerField(), inline = true } },
				}) > 0 then
				table.clear(B)
			end
		end
		local egg = Options.HatchEgg and Options.HatchEgg.Value
		if egg == nil or egg == "Best (Smart)" then
			egg = N.Hatch and N.Hatch.egg
		end
		if type(egg) == "string" and N.eggStock then
			local s = N.eggStock(egg)
			if s and type(s.Left) == "number" then
				local prev = Hook.stock[egg]
				if prev ~= nil and prev ~= s.Left then
					N.post("egg_stock", {
						title = "\u{2726}  Egg stock",
						description = string.format("**%s** egg: **%s** left%s.", egg, formatNumber(s.Left), if s.Left <= 0 then " (out of stock)" else ""),
						color = 1752220,
						fields = { { name = "Player", value = playerField(), inline = true } },
					})
				end
				Hook.stock[egg] = s.Left
			end
		end
	end
	-- Live stats card per webhook: one Discord message (POST ?wait=true gives its id) edited in place every 2 minutes.
	local function cardTick(url)
		local card = Hook.cards[url]
		if not card then
			card = { id = nil, at = -1e9 }
			Hook.cards[url] = card
		end
		if os.clock() - card.at < 120 then
			return false
		end
		card.at = os.clock()
		local embed = reportEmbed("\u{2726}  Live stats")
		embed.author = { name = GameName }
		embed.footer = { text = "Corvus  \u{00B7}  " .. GameName .. "  \u{00B7}  updates every 2 min" }
		embed.timestamp = DateTime.now():ToIsoDate()
		local body = HttpService:JSONEncode(message({ embed }))
		if card.id then
			local response = httpRequest({ Url = url .. "/messages/" .. card.id, Method = "PATCH", Headers = { ["Content-Type"] = "application/json" }, Body = body })
			local code = response and tonumber(response.StatusCode) or 0
			if code >= 200 and code < 300 then
