	-- whose price the income reaches fastest per unit of power; the expensive egg wins only when its power pays for the wait.
	function N.affordableEgg()
		local coins = N.coins()
		local income = math.max(N.income(), 1e-9)
		local window = math.max(N.hatchWindow(N.Hatch.speed, 1), 0.5)
		local pick, pickRate = nil, -1
		for _, egg in ipairs(N.eggList()) do
			if N.eggUnlocked(egg) and not lockedRecently(egg) then
				local cost = N.eggCost(egg, 1)
				local gain = N.eggMarginal(egg)
