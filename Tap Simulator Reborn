	local function validWebhook(url)
		return type(url) == "string"
			and (
					url:find("^https://discord%.com/api/webhooks/")
					or url:find("^https://discordapp%.com/api/webhooks/")
					or url:find("^https://canary%.discord%.com/api/webhooks/")
