	end
	-- The index eggs, cheapest first (the game's page order breaks ties).
	local function eggsByPrice()
		local list = {}
		for i, egg in ipairs(indexEggs()) do
			if N.validEgg(egg) then
				table.insert(list, { egg = egg, i = i, price = tonumber(N.eggCfg(egg).Price) or 0 })
			end
		end
		table.sort(list, function(a, b)
			if a.price == b.price then
				return a.i < b.i
			end
			return a.price < b.price
		end)
		return list
	end
	-- The egg a pet comes from (PetIndexCatalog.PetEgg, 3518 L407214; else the egg configs).
	function N.petEgg(name)
		local fn = N.G.Index and N.G.Index.PetEgg
		if type(fn) == "function" then
			local ok, egg = pcall(fn, name)
			if ok and type(egg) == "string" then
				return egg
			end
		end
		for _, egg in ipairs(indexEggs()) do
			local cfg = N.eggCfg(egg)
			if cfg and ((type(cfg.Pets) == "table" and cfg.Pets[name] ~= nil) or (type(cfg.Secrets) == "table" and cfg.Secrets[name] ~= nil)) then
				return egg
			end
		end
		return nil
	end
	function N.indexIsSecret(name)
		for _, egg in ipairs(indexEggs()) do
			local cfg = N.eggCfg(egg)
			if cfg and type(cfg.Secrets) == "table" and cfg.Secrets[name] ~= nil then
				return true
			end
		end
		return false
	end
	-- Variants found / all variants of the index pages (every egg pet x 4 tiers), the numbers come from the game's configs.
	function N.indexCounts()
		local found, total, seen = 0, 0, {}
		for _, egg in ipairs(indexEggs()) do
			local cfg = N.eggCfg(egg)
			for name in pairs(N.tableOr(cfg and cfg.Pets)) do
				if not seen[name] then
					seen[name] = true
					for _, tier in ipairs(Tiers) do
						total += 1
						if N.indexVariantFound(name, tier) then
							found += 1
						end
					end
				end
			end
		end
		return found, total
	end
	-- Usable copies per pet and tier (never equipped, level team, locked, frozen or protected pets: the machines skip them).
	local function copies()
		local keep, protect = N.keepSet(), N.protectedNames()
		local out = {}
		for id, pet in pairs(N.owned()) do
			if type(pet) == "table" and type(pet.Name) == "string" and pet.Locked ~= true and pet.Frozen == nil and not keep[id] and not protect[pet.Name] then
				local c = out[pet.Name]
				if not c then
					c = { Normal = 0, Golden = 0, Diamond = 0, Shiny = 0 }
					out[pet.Name] = c
				end
				local t = pet.Tier or "Normal"
				c[t] = (c[t] or 0) + 1
			end
		end
		return out
	end
	local function pendingRainbows()
		local out = {}
		for _, entry in pairs(N.pods()) do
			if type(entry) == "table" and type(entry.Name) == "string" then
				out[entry.Name] = true
			end
		end
		return out
	end
	-- Copies per craft: Golden and Diamond at their sure count, Rainbow the machine's count option.
	function N.indexRecipe()
		local g = N.craftNeedSure("Golden") or 6
		local d = N.craftNeedSure("Diamond") or 5
		local s = N.craftCount(N.Machines[3]) or 5
		return g, d, s
	end
	-- Normal copies still to hatch for the missing variants of one pet (the copies owned count as material).
	local function toHatch(name, c, missing)
		local g, d, s = N.indexRecipe()
		c = c or { Normal = 0, Golden = 0, Diamond = 0, Shiny = 0 }
		local need = 0
		for _, tier in ipairs(missing) do
			need = math.max(need, if tier == "Normal" then 1 elseif tier == "Golden" then g elseif tier == "Diamond" then g * d else g * d * s)
		end
		local have = c.Normal + c.Golden * g + c.Diamond * g * d
		return math.max(0, need - have)
	end
	local function skipped(pet)
		local untilAt = I.skip[pet]
		return untilAt ~= nil and os.clock() < untilAt
	end
	-- Per egg (cheapest first): the pets with variants to find, one entry per pet, most likely first. The first egg with
	-- work is the hunt (egg by egg); it waits when that egg is not affordable yet.
	function N.indexPlan(fresh)
		if not fresh and I.plan and os.clock() - I.planAt < 10 then
			return I.plan
		end
		I.planAt = os.clock()
		local H = N.Hatch
		local top = N.hatchTop()
		local measured = tonumber(H.rate) or 0
		local timeRate = if measured > 0 then measured / 60 else top / math.max(N.hatchWindow(H.speed, top), 0.5)
		local here = N.currentIsland()
		local income, coins = N.income(), N.coins()
		local minP, secrets = N.indexOdds()
		local own, pods = copies(), pendingRainbows()
		local fRar, fVar = N.indexFilter()
		local tiers = Tiers
		if fVar then
			tiers = {}
			for _, t in ipairs(Tiers) do
				if fVar[t] then
					table.insert(tiers, t)
				end
			end
		end
		local function rarityOk(pet)
			return fRar == nil or fRar[N.rarityOf({ Name = pet })] == true
		end
		local plan = { best = nil, all = {}, blocked = 0, left = 0 }
		for _, e in ipairs(eggsByPrice()) do
			local egg = e.egg
			if N.eggUnlocked(egg) and os.clock() - (H.locked[egg] or -1e9) >= 120 then
				local cfg = N.eggCfg(egg)
				local total = 0
				for _, w in pairs(N.tableOr(cfg.Pets)) do
					total += tonumber(w) or 0
				end
				local targets = {}
				local function add(pet, p, tiers)
					local missing, pending = {}, false
					for _, tier in ipairs(tiers) do
						if not N.indexVariantFound(pet, tier) then
							if tier == "Shiny" and pods[pet] then
								pending = true
							else
								table.insert(missing, tier)
							end
						end
					end
					if #missing > 0 or pending then
						local need = toHatch(pet, own[pet], missing)
						table.insert(targets, { pet = pet, p = p, missing = missing, pending = pending, need = need, hatch = need / p })
					end
				end
				if total > 0 then
					for pet, w in pairs(N.tableOr(cfg.Pets)) do
						local p = (tonumber(w) or 0) / total
						if p >= minP and not skipped(pet) and rarityOk(pet) then
							add(tostring(pet), p, tiers)
						end
					end
				end
				if secrets then
					for pet, oneIn in pairs(N.tableOr(cfg.Secrets)) do
						local p = 1 / math.max(tonumber(oneIn) or math.huge, 1)
						if p >= minP and not skipped(pet) and rarityOk(pet) and (fVar == nil or fVar.Normal) then
							add(tostring(pet), p, { "Normal" })
						end
					end
				end
				if #targets > 0 then
					-- one pet at a time: pets with something to make before pets that only wait for a Rainbow pod
					table.sort(targets, function(a, b)
						local wa, wb = #a.missing > 0, #b.missing > 0
						if wa ~= wb then
							return wa
						end
						if a.p == b.p then
							return a.pet < b.pet
						end
						return a.p > b.p
					end)
					local variants, hatches = 0, 0
					for _, t in ipairs(targets) do
						variants += #t.missing + (if t.pending then 1 else 0)
						hatches = math.max(hatches, t.hatch)
					end
					plan.left += variants
					local perPet = N.eggCost(egg, top) / math.max(top, 1)
					local cost = perPet * hatches
					-- the coins on hand pay for the whole hunt, or the income pays for the pets as they hatch
					local rate = if perPet <= 0 or coins >= cost then timeRate else math.min(timeRate, income / perPet)
					local entry = { egg = egg, new = variants, targets = targets, hatches = hatches, cost = cost, rate = rate }
					if rate > 0 and N.finite(hatches) then
						entry.eta = hatches / rate + (if N.eggIsland(egg) == here then 0 else 8)
					else
						entry.eta = math.huge
						entry.blocked = true
						plan.blocked += 1
					end
					table.insert(plan.all, entry)
				end
			end
		end
		-- egg by egg: the cheapest egg with work; a more expensive egg never jumps the queue
		local first = plan.all[1]
		if first and not first.blocked then
			plan.best = first
		end
		I.plan = plan
		I.needs = nil
		return plan
	end
	local function variantWords(t)
		local words = {}
		for _, tier in ipairs(t.missing) do
			table.insert(words, TierWord[tier])
		end
		if t.pending then
			table.insert(words, "rainbow in the pod")
		end
		return table.concat(words, ", ")
	end
	local function names(targets, n)
		local out = {}
		for i = 1, math.min(n, #targets) do
			local t = targets[i]
			table.insert(out, string.format("%s 1 in %s (%s)", t.pet, formatNumber(math.floor(1 / t.p + 0.5)), variantWords(t)))
		end
		if #targets > n then
			table.insert(out, "+" .. (#targets - n) .. " more")
		end
		return table.concat(out, ", ")
	end
	local function collectorText()
		local tier = N.collectorNext()
		local found, total = N.indexCounts()
		local variants = string.format(", variants %d/%d", found, total)
		if not tier then
			return string.format("%d unique pets%s", N.uniquePets(), variants)
		end
		return string.format("%d/%d unique pets for %s%s", N.uniquePets(), tonumber(tier.Amount) or 0, tostring(tier.Title or "the next Collector badge"), variants)
	end
	N.indexCollectorText = collectorText
	-- The egg the hunt hatches now (nil = off, done or not affordable). The first pet of its list is the one being finished;
	-- over its time limit it waits 1 h and the next pet goes first.
	function N.indexTarget()
		if not on("IndexHunter") then
			return nil
		end
		local plan = N.indexPlan()
		local pick = plan.best
		-- a rebirth empties the coins for a moment: the hunted egg stays for up to 3 minutes instead of flipping to the
		-- dropdown's egg and back
		if pick then
			I.blockedSince = nil
		elseif I.target and plan.all[1] and plan.all[1].egg == I.target.egg then
			I.blockedSince = I.blockedSince or os.clock()
			if os.clock() - I.blockedSince < 180 then
				pick = I.target
			end
		end
		if pick then
			if not I.target or I.target.egg ~= pick.egg then
				if I.target then
					log(string.format("INDEX egg %s done or paused, next egg %s", I.target.egg, pick.egg))
				end
				if not I.filterLogged then
					I.filterLogged = true
					log("INDEX hunt filter " .. N.indexFilterText())
				end
				log(string.format("INDEX hunt egg=%s new=%d eta=%ds hatches=%s coins=%s (%s; %s)", pick.egg, pick.new, math.min(math.floor(pick.eta), 1e9), formatNumber(math.floor(pick.hatches)), formatNumber(pick.cost), names(pick.targets, 4), collectorText()))
			end
			local cur = pick.targets[1]
			if cur and #cur.missing > 0 then
				if I.pet ~= cur.pet then
					I.pet = cur.pet
					I.petSince = os.clock()
					I.petLimit = math.max(900, 3 * cur.hatch / math.max(pick.rate, 1e-6) + 120)
					log(string.format("INDEX pet %s: %s to go, ~%s normal copies to hatch (limit %s)", cur.pet, variantWords(cur), formatNumber(math.ceil(cur.need)), N.longTime(I.petLimit)))
				elseif os.clock() - I.petSince > I.petLimit then
					I.skip[cur.pet] = os.clock() + 3600
					log(string.format("INDEX skip %s for 1 h after %s (%s still missing), next pet", cur.pet, N.longTime(os.clock() - I.petSince), variantWords(cur)))
					I.pet = nil
					I.plan = nil
				end
			end
			I.target = pick
			I.doneLogged, I.waitLogged = false, false
			return pick
		end
		I.target = nil
		I.pet = nil
		if plan.left == 0 and not I.doneLogged then
			I.doneLogged = true
			log(string.format("INDEX done: every variant up to %s is found on the eggs you can open (%s)", select(3, N.indexOdds()), collectorText()))
		elseif plan.left > 0 and not I.waitLogged then
			I.waitLogged = true
			log(string.format("INDEX waits: %d variant%s left on eggs the coins do not pay for yet", plan.left, if plan.left == 1 then "" else "s"))
		end
		return nil
	end
	-- The hunted egg's pets each machine works on (nil = none): Golden for a missing Golden, Diamond or Rainbow, Diamond
	-- for a missing Diamond or Rainbow, Rainbow for a missing Rainbow (and its pods to claim).
	function N.indexNeeds(m)
		if not on("IndexHunter") then
			return nil
		end
		if I.needs and os.clock() - I.needsAt < 2 then
			return I.needs[m.key]
		end
		local out = {}
		local t = I.target or N.indexPlan().best
		if t then
			for _, x in ipairs(t.targets) do
				local miss = {}
				for _, tier in ipairs(x.missing) do
					miss[tier] = true
				end
				local function put(key)
					out[key] = out[key] or {}
					out[key][x.pet] = true
				end
				if miss.Golden or miss.Diamond or miss.Shiny then
					put("Golden")
				end
				if miss.Diamond or miss.Shiny then
					put("Diamond")
				end
				if miss.Shiny or x.pending then
					put("Shiny")
				end
			end
		end
		I.needs, I.needsAt = out, os.clock()
		return out[m.key]
	end
	-- Auto Delete Junk keeps: every variant the index has not counted, and the hunted egg's pets while the hunt runs.
	function N.indexKeeps(name, tier)
		if not N.indexVariantFound(name, tier or "Normal") then
			return true
		end
		if on("IndexHunter") then
			local t = I.target or N.indexPlan().best
			if t then
				for _, x in ipairs(t.targets) do
					if x.pet == name then
						return true
					end
				end
			end
		end
		return false
	end
	-- `INDEX <variant> <pet> found (...)` for every variant the index gains (the first look only learns what is there).
	function N.indexWatch()
		local all = {}
		for name in pairs(discovered()) do
			all[name] = true
		end
		for _, egg in ipairs(indexEggs()) do
			local cfg = N.eggCfg(egg)
			for name in pairs(N.tableOr(cfg and cfg.Pets)) do
				all[name] = true
			end
		end
		local first = I.known == nil
		I.known = I.known or {}
		local new = 0
		for name in pairs(all) do
			for _, tier in ipairs(Tiers) do
				local key = tostring(name) .. "_" .. tier
				if not I.known[key] and N.indexVariantFound(name, tier) then
					I.known[key] = true
					if not first then
