			tabBar.Position = UDim2.new(0, PAD, 0, HEADER_H)
			tabBar.Size = UDim2.new(1, -PAD * 2, 0, TAB_BAR_H)
			local dh = header:FindFirstChild("DragHandle_Header")
			if dh then dh.Size = UDim2.new(0.5, 0, 1, 0) end
		end
	end
