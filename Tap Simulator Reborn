	function N.raffleStep()
		if not N.due("raffle", 3600) or N.probeState("raffle_view") == "rejected" then
			return
		end
		local view = invoke("RaffleService.RF.GetRaffleView")
		if type(view) ~= "table" then
			if N.probeState("raffle_view") == "untested" then
				N.probeResult("raffle_view", "rejected", "gain=0 (no view)")
			end
			return
		end
		local keys = {}
		for k in pairs(view) do
			table.insert(keys, tostring(k))
		end
		table.sort(keys)
		if N.probeState("raffle_view") == "untested" then
			N.probeResult("raffle_view", "accepted", "gain=keys " .. table.concat(keys, ","))
		end
		-- R13 (live 3983: GetRaffleView -> {available=false, mine={}, raffles={}, recentWinners={}}; the raffle menu is lazy
		-- content, no 3937 client call to copy): the open raffles are the entries of `raffles`; one is entered only when it
		-- says outright that an entry is free and `mine` does not list it yet, and counted only on the server's Success.
		-- An open raffle without a free entry is logged once a day with its fields (never tickets for Robux or tokens).
		local entries = {}
		if type(view.raffles) == "table" then
			for k, r in pairs(view.raffles) do
				if type(r) == "table" then
					table.insert(entries, { key = k, r = r })
				end
			end
		elseif view.Id ~= nil or view.RaffleId ~= nil then
			table.insert(entries, { key = view.Id or view.RaffleId, r = view })
		end
		if view.available == false or #entries == 0 then
			N.World.last.raffle = "no raffle open"
			return
		end
		local mine = N.tableOr(view.mine)
		for _, e in ipairs(entries) do
			local r = e.r
			local id = r.Id or r.RaffleId or r.id or (if type(e.key) == "string" then e.key else nil)
			local cost = tonumber(r.Cost or r.TicketCost or r.Price or r.cost or r.price)
			local free = r.Free == true or r.free == true or (tonumber(r.FreeEntries) or 0) > 0 or cost == 0
			local entered = r.Entered == true or r.entered == true or (id ~= nil and mine[id] ~= nil)
			if type(id) == "string" and free and not entered and N.due("raffleEnter " .. id, 86400) then
				N.RaffleToken = id
				local result = invoke("RaffleService.RF.EnterRaffle", id, 1)
				N.RaffleToken = nil
				if ok(result) then
					note("raffle", "entered " .. id .. " ok")
				else
					log("CLAIM raffle " .. id .. " FAILED answer=" .. brief(result))
				end
			elseif not free and N.due("raffleShape", 86400) then
				log("RAFFLE open without a free entry (not entered): " .. brief(r))
			end
		end
	end
