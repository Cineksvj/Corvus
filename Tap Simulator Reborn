	function N.learnPlace(key, pos)
		if type(key) ~= "string" or typeof(pos) ~= "Vector3" then
			return
		end
		local old = Places[key]
		if old and (old - pos).Magnitude < 2 then
			return
		end
		Places[key] = pos
		local lines = {}
		for k, p in pairs(Places) do
			table.insert(lines, string.format("%s=%.1f,%.1f,%.1f", k, p.X, p.Y, p.Z))
		end
		table.sort(lines)
		pcall(function()
