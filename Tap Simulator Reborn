do
	-- ===== Memory guard (owner 2026-10-12 "NAPRAW TEN PAMIEC LEAKAGE"). Live getgc on the alt: 99K closures from the
	-- game's ReplicatedStorage.NumberSlots line 620 (3518 dump L373665) growing ~37/s and never freed: every change of a
	-- HUD counter animates each digit with a Tween whose Completed connection is never disconnected and whose Tween
	-- instance is never destroyed (cancelled by _finishSlot, or completed), so Tween + closure + reel labels stay alive
	-- for the whole session (Lua heap +300-700 MB/h, FPS 60 -> 23 after 40 min). The hub patches the module's own table
	-- (it returns a plain table, L374074): a cancelled tween is destroyed right after the cancel, a completed one right
	-- after its callback; the game's visuals are untouched. Measured live: +249 closures in 90 s instead of +3700. =====
	N.MemGuard = { on = false, destroyed = 0, swept = 0, loggedAt = -1e9 }
	local function patchNumberSlots()
		local ok, NS = pcall(function()
			return require(game:GetService("ReplicatedStorage"):WaitForChild("NumberSlots", 5))
		end)
		if not ok or type(NS) ~= "table" or type(NS._finishSlot) ~= "function" or type(NS._animateSlot) ~= "function" then
			return false
		end
		if getgenv().CorvusNSPatch then
			N.MemGuard.on = true
			return true
		end
		local origFinish, origAnimate = NS._finishSlot, NS._animateSlot
		NS._finishSlot = function(self, slot)
			local tw = type(slot) == "table" and slot._tween
			origFinish(self, slot)
			if tw then
				N.MemGuard.destroyed += 1
				pcall(tw.Destroy, tw)
			end
		end
		NS._animateSlot = function(self, slot, ...)
			origAnimate(self, slot, ...)
			local tw = type(slot) == "table" and slot._tween
			if tw then
				tw.Completed:Once(function()
					task.defer(function()
						if slot._tween ~= tw then
							N.MemGuard.destroyed += 1
							pcall(tw.Destroy, tw)
						end
					end)
				end)
			end
		end
		getgenv().CorvusNSPatch = true
		table.insert(N.Restore, function()
			NS._finishSlot, NS._animateSlot = origFinish, origAnimate
			getgenv().CorvusNSPatch = nil
		end)
		N.MemGuard.on = true
		return true
	end
	-- Parentless Tweens that are no longer playing (the ones leaked before the patch, and any other module's) are
	-- destroyed once at start and every 10 minutes; needs the executor's getnilinstances (skipped without it).
	function N.memSweep()
		local fn = getnilinstances
		if type(fn) ~= "function" then
			return 0
		end
		local ok, list = pcall(fn)
		if not ok or type(list) ~= "table" then
			return 0
		end
		local n = 0
		for _, inst in ipairs(list) do
			if typeof(inst) == "Instance" and inst.ClassName == "Tween" and inst.Parent == nil then
				local st = inst.PlaybackState
				if st ~= Enum.PlaybackState.Playing and st ~= Enum.PlaybackState.Delayed then
					n += 1
					pcall(inst.Destroy, inst)
				end
			end
		end
		N.MemGuard.swept += n
		return n
	end
	task.spawn(function()
		local ok = patchNumberSlots()
		local swept = N.memSweep()
		log(string.format("MEM guard NumberSlots patch=%s, stale tweens destroyed at start=%d", if ok then "on" else "off (module not found)", swept))
		while alive() do
			task.wait(600)
			local n = N.memSweep()
			-- one line per 30 minutes (the hub's log buffer is bounded; the PERF line carries the heap every 30 s)
			if os.clock() - N.MemGuard.loggedAt >= 1800 then
				N.MemGuard.loggedAt = os.clock()
				log(string.format("MEM guard tweens destroyed=%d (session), swept now=%d, lua=%dMB", N.MemGuard.destroyed, n, math.floor(gcinfo() / 1024)))
			end
		end
	end)
end
