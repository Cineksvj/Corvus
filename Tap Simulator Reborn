			if center then
				N.teleport(center + Vector3.new(0, 3, 0), 0.3)
				N.Bridge.lowered, N.Bridge.lost = false, 0
				fire("BridgeService.RE.EngageChanged", { Engaged = true })
				local lost = 0
				while os.clock() - started < 40 and alive() and not N.levelingUnlocked() and not N.Bridge.lowered do
					if not N.does("AutoTap") then
