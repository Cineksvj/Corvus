	function N.priorityOrder()
		local order, seen = {}, {}
		for i = 1, #GroupNames do
			local o = Options["Priority" .. i]
			local v = o and o.Value
			if type(v) == "string" and table.find(GroupNames, v) and not seen[v] then
				seen[v] = true
				table.insert(order, v)
			end
		end
		for _, name in ipairs(GroupNames) do
			if not seen[name] then
				seen[name] = true
				table.insert(order, name)
			end
		end
		return order
	end
	function N.priorityText()
		return "Order: " .. table.concat(N.priorityOrder(), " > ") .. (if N.Priority.last then "  \u{00B7}  last: " .. N.Priority.last else "")
