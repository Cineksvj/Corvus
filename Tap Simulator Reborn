					local result = invoke("WorldService.RF.Travel", { Zone = "Spawn", Source = "Menu" })
					ok, why = type(result) == "table" and result.Success == true, reasonOf(result)
				elseif rung == "heightbar" then
					local result = invoke("IslandService.RF.Travel", { Island = "Spawn", Source = "Menu" })
					ok, why = type(result) == "table" and result.Success == true, reasonOf(result)
				else
					ok, why = portalHome(from)
				end
				if ok then
					arrivedMain(from)
					waitFor(function()
						return rawIsland() ~= from or from == "Spawn"
					end, 1)
					local took = os.clock() - started
					if known ~= rung then
						N.probeResult("travel_spawn", "accepted", string.format("gain=%s %.2fs", rung, took), rung)
					end
					N.Travel.last = "on the main map (" .. rung .. ")"
					log(string.format("TRAVEL Spawn ok via=%s %.2fs island=%s zone=%s", rung, took, tostring(LocalPlayer:GetAttribute("CurrentIsland")), N.currentZone()))
					return true
				end
				log("TRAVEL Spawn via=" .. rung .. " refused: " .. tostring(why))
			end
		end
		return travelFailed("Spawn")
	end
	-- A zone of the main map (Forest, Winter, Desert) by the Teleport menu, once it is unlocked.
	function N.travelZone(zone)
		if zone == nil or zone == "Spawn" then
			return N.travelSpawn()
		end
		if not N.zoneUnlocked(zone) then
			return false
		end
		local from = N.currentIsland()
		if from == "Spawn" and N.currentZone() == zone then
			return true
		end
		gapWait()
		local result = invoke("WorldService.RF.Travel", { Zone = zone, Source = "Menu" })
		if type(result) == "table" and result.Success == true then
			arrivedMain(from)
			waitFor(function()
				return N.currentZone() == zone
			end, 2)
			N.Travel.last = "in the " .. zone .. " zone"
			log("TRAVEL", zone, "ok via=menu")
			return true
		end
		log("TRAVEL", zone, "refused:", reasonOf(result))
		return travelFailed(zone)
	end
	function N.travel(island)
		island = island or "Spawn"
		if island == "Spawn" then
			return N.travelSpawn()
		end
		if N.zoneInfo(island) ~= nil and N.islandInfo(island) == nil then
			return N.travelZone(island)
		end
		if N.currentIsland() == island then
			return true
		end
		if not N.islandUnlocked(island) then
			return false
		end
		for attempt = 1, 3 do
			gapWait()
			local result = invoke("IslandService.RF.Travel", { Island = island, Source = "Menu" })
			if waitFor(function()
				return rawIsland() == island
			end, 4) then
				N.Travel.mainFrom = nil
				N.Travel.fails = 0
				N.Travel.last = "arrived on " .. island
				log("TRAVEL", island, "ok")
				waitFor(function()
					local f = N.islandFolder(island)
					return f ~= nil and #f:GetChildren() > 0
				end, 3)
				return true
			end
			local reason = reasonOf(result)
			log("TRAVEL", island, "try", attempt, "not there yet", reason)
			if not (string.find(string.lower(reason), "fast", 1, true) or string.find(string.lower(reason), "wait", 1, true) or reason == "RateLimited" or reason == "") then
				break
			end
		end
		return travelFailed(island)
	end
end
