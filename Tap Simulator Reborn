	-- empty for 10 minutes): the machine services get one call per 0.5 s per service and one retry 1 s after a RateLimited.
	local PaceAt = {}
	local function rateLimited(r)
		return type(r) == "table" and (r.Error == "RateLimited" or r.Reason == "RateLimited")
	end
	N.rateLimited = rateLimited
	function N.pacedInvoke(name, ...)
		local service = string.match(name, "^(%w+)%.") or name
		local gap = 0.5 - (os.clock() - (PaceAt[service] or -1e9))
		if gap > 0 then
			task.wait(gap)
		end
		PaceAt[service] = os.clock()
		local packed = table.pack(invoke(name, ...))
		if rateLimited(packed[1]) then
			task.wait(1)
			PaceAt[service] = os.clock()
			log("PACE", name, "answered RateLimited, one retry after 1 s")
			packed = table.pack(invoke(name, ...))
		end
		return table.unpack(packed, 1, packed.n)
	end
	-- One connection per game event, handlers by remote path. Handlers must not yield.
	N.Handlers = {}
	N.Bound = {}
	function N.dispatch(name, ...)
		local list = N.Handlers[name]
		if not list then
			return
		end
		for _, fn in ipairs(list) do
			local ok, err = pcall(fn, ...)
			if not ok then
				log("ERROR", "event " .. tostring(name), tostring(err))
			end
		end
	end
	local function bind(name)
		if N.Bound[name] then
			return true
		end
		local remote = N.remote(name)
		if remote and remote:IsA("RemoteEvent") then
			N.Bound[name] = true
			Library:GiveSignal(remote.OnClientEvent:Connect(function(...)
				if alive() then
					N.dispatch(name, ...)
				end
			end))
			return true
		end
		return false
	end
	function N.onEvent(name, fn)
		N.Handlers[name] = N.Handlers[name] or {}
		table.insert(N.Handlers[name], fn)
		if not bind(name) then
			task.spawn(function()
				local waited = 0
				while not bind(name) and waited < 30 do
					waited += task.wait(1) or 1
				end
			end)
		end
	end
	function waitFor(check, seconds)
		local waited = 0
		while waited < seconds do
			if check() then
				return true
			end
			waited += task.wait(0.05) or 0.05
		end
		return check() and true or false
	end
	local function safeRequire(path)
		local result, done = nil, false
		task.spawn(function()
			local ok, value = pcall(function()
				local node = ReplicatedStorage
				for part in path:gmatch("[^%.]+") do
					node = node:WaitForChild(part, 8)
				end
				return require(node)
			end)
			result = ok and value or nil
			done = true
		end)
		local waited = 0
		while not done and waited < 12 do
			waited += task.wait(0.05) or 0.05
		end
		if result == nil then
			log("REQUIRE failed", path)
		end
		return result
	end
	N.safeRequire = safeRequire
	function N.tableOr(value)
		return if type(value) == "table" then value else {}
