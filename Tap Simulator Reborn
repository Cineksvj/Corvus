						new += 1
						log(string.format("INDEX %s %s found (%s)", TierWord[tier], tostring(name), collectorText()))
					end
				end
			end
		end
		if new > 0 then
			I.plan = nil
			I.needs = nil
		end
		return new
	end
	-- Rewards panel (Index Hunter box).
	function N.indexText()
		local lines = { "Unique pets <b>" .. collectorText() .. "</b>" }
		local plan = N.indexPlan()
		local t = if on("IndexHunter") then I.target else plan.best
		if t then
			table.insert(lines, string.format("%s %s egg (%d variants left, ~%s): %s", if on("IndexHunter") then "Hunting at the" else "Next: the", t.egg, t.new, N.longTime(t.eta), names(t.targets, 3)))
