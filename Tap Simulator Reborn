			DoesWrap = true,
		})
		local Ranks = { "1st", "2nd", "3rd", "4th", "5th" }
		local Prev = table.clone(N.PriorityDefault)
		local Swapping = false
		for i = 1, 5 do
			PriorityBox:AddDropdown("Priority" .. i, {
				Text = Ranks[i],
