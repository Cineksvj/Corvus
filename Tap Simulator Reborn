		-- Nav pill = tab-wide stop / resume. OFF click: remember which toggles of this tab
		-- are ON and switch them all off. ON click: switch exactly that remembered set back
		-- on (falls back to the toggles the user had on earlier this session).
		tab.Toggles = {}
		local function anyOn()
			for _, t in ipairs(tab.Toggles) do if t.Value then return true end end
			return false
		end
		function tab:_refreshNavPill()
			-- Setup tabs (Info / Settings) carry housekeeping toggles, not automations: no pill.
			-- Owner 2026-10-20: no switches beside the tab names at all (nor the compact on-dots);
			-- StopAll / Resume stay as API for hubs and the Stop everything button.
			if self.OnDot then self.OnDot.Visible = false end
			self.NavPill.Visible = false
		end
		function tab:_registerToggle(t)
			table.insert(self.Toggles, t)
			self:_refreshNavPill()
		end
		function tab:_onToggleChanged()
			self:_refreshNavPill()
		end
		function tab:StopAll()
			local remembered = {}
			Library._batchSuppress = true
			for _, t in ipairs(self.Toggles) do
				if t.Value then
					table.insert(remembered, t)
					pcall(function() t:SetValue(false) end)
				end
			end
			Library._batchSuppress = false
			if #remembered > 0 then self._resume = remembered end
			self:_refreshNavPill()
		end
		function tab:Resume()
			local set = self._resume
			if not set or #set == 0 then
				set = {}
				local userOn = rawget(Library, "_userOn") or {}
				for _, t in ipairs(self.Toggles) do
					if type(t.Idx) == "string" and userOn[t.Idx] then table.insert(set, t) end
				end
			end
			Library._batchSuppress = true
			for _, t in ipairs(set) do pcall(function() t:SetValue(true) end) end
			Library._batchSuppress = false
			self:_refreshNavPill()
		end
		primaryDot.MouseButton1Click:Connect(function()
			if anyOn() then tab:StopAll() else tab:Resume() end
		end)

		-- owner 2026-11-01 ("tab icons rotate on hover and click instead of scaling"): the icon
