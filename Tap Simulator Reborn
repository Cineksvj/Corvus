	local H = N.Hatch
	-- The reveal the server waits for: HatchAnimationConfig.RevealSeconds with the hype speed-up the game gives to
	-- hatches less than 10 s apart (dump 309254-309258, 374672-374687).
	function N.hatchWindow(speed, pets)
		speed = math.max(tonumber(speed) or 1, 0.1)
		pets = math.max(tonumber(pets) or 1, 1)
		local m = 1 / speed * (1 - 0.25)
		local fn = N.G.HatchAnim.RevealSeconds
		if type(fn) == "function" then
			local ok, s = pcall(fn, m, 4, 0, 1.4 * m, pets)
			if ok and N.finite(s) and s > 0 then
				return s
			end
		end
		return 2.7233 * m + math.max(0.045 * m, 0.03) + (pets - 1) * 0.08 + 1.4 * m + 0.3
	end
	function N.hatchTop()
		return if N.hasX8() then 8 else 3
	end
	-- The biggest of 8 / 3 / 1 that the pass allows, the free storage takes and the coins pay for.
	function N.hatchCount(egg)
		local top = N.hatchTop()
		local n, limit = N.storage()
		local free = limit - n
		local coins = N.coins()
		-- Owner 2026-10-12: when a coin buys more income as a rebirth, the hatch spends only the surplus (N.hatchBudget)
		local budget = if N.hatchBudget then N.hatchBudget() else coins
		-- strategy.md item 4: Egg Surge adds +1 egg per request (GlobalEventFormula.GetExtraHatches), so the storage must
		-- have room for the count PLUS the extra or the hatch is refused StorageFull
		local extra = 0
		local gef = N.G.GlobalEvent
		if type(gef) == "table" and type(gef.GetExtraHatches) == "function" then
			local okE, e = pcall(gef.GetExtraHatches)
			if okE and N.finite(e) then
				extra = math.max(math.floor(e), 0)
			end
		end
		local why = "storage full"
		for _, c in ipairs({ 8, 3, 1 }) do
			if c <= top and c + extra <= free then
				local cost = N.eggCost(egg, c)
				if cost <= budget then
					return c
				end
				why = if cost <= coins then "rebirths first" else "not enough coins"
			end
		end
		return 0, why
	end
	-- Full = a top-count hatch no longer fits; the server's StorageFull answer counts for 3 s (the replica lags a moment
	-- behind a craft or a delete). Live 8: the old 20 s latch kept "storage full" up at 267/345.
	function N.storageFull()
		local n, limit = N.storage()
		return limit - n < N.hatchTop() or os.clock() - H.storageFullAt < 3
	end
	-- Pets hatched in the last 60 s of wall time (the panel's eggs/min; trips count as time).
	function N.hatchRecentRate()
		local now = os.clock()
		local pets = 0
		for i = #H.recent, 1, -1 do
			local r = H.recent[i]
			if now - r.t > 60 then
				table.remove(H.recent, i)
			else
				pets += r.pets
			end
		end
		H.recentRate = pets
		return pets
	end
	-- What the hatch loop is doing right now, in plain words (B7: never a stale "Waiting" line).
	function N.hatchStatusText(withRate)
		if not N.hatchWanted() then
			return "off"
		end
		local egg = H.target
		if not egg then
			return "no unlocked egg"
		end
		if N.Trip.active then
			return "paused for the " .. N.Trip.name .. " trip" .. (if withRate then " (" .. math.floor(os.clock() - N.Trip.since) .. " s)" else "")
		end
		local n, limit = N.storage()
		if limit - n < 1 or (limit - n < N.hatchTop() and N.hatchCount(egg) < 1) then
			local due = N.dueMachines and #N.dueMachines() > 0
			return string.format("storage full%s: %s", if withRate then string.format(" (%d/%d)", n, limit) else "", if due then "craft trip next" elseif on("AutoDelete") then "deleting junk next" else "turn on a machine or Auto Delete Junk")
		end
		if not N.atEgg(egg) then
			return "going to the " .. egg .. " egg"
		end
		-- R5-4: the status says so while a teleport holds the hatch (it used to say "hatching" while nothing was sent)
		if N.Move.busy and os.clock() - N.Move.at > 2 then
			return "at the " .. egg .. " egg, waiting for the teleport to finish"
		end
		local count, why = N.hatchCount(egg)
		if count < 1 and why == "not enough coins" and os.clock() - ((N.Reb and N.Reb.at) or -1e9) < 1.5 then
			-- R4-5: the coins are at zero for a tick after a rebirth press, the hatching goes on at once
			count = N.hatchTop()
		end
		if count < 1 then
			-- Owner 2026-10-12: no "not enough coins" spam; the taps keep earning while the hatch waits for the price.
			if why == "not enough coins" then
				return if N.eggsFirst and not N.eggsFirst() then "rebirths first: " .. egg .. " eggs from the coins above the rebirth button" else "saving for the " .. egg .. " egg (tapping meanwhile)"
			end
			if why == "rebirths first" then
				return "rebirths first: " .. egg .. " eggs from the coins above the rebirth button"
			end
			return egg .. ": " .. tostring(why)
		end
		if withRate then
			return string.format("hatching %s x%d, %d eggs/min", egg, count, N.hatchRecentRate())
		end
		return string.format("hatching %s x%d", egg, count)
	end
	-- ===== Where the egg is: Workspace.Eggs.<Egg> (the game's EggController reads the same folder); the client hatches
	-- within 10 studs of the egg (nearestEgg, dump 184922), the server answers TooFar beyond its own limit. =====
	function N.eggModel(egg)
		local folder = workspace:FindFirstChild("Eggs")
		return folder and folder:FindFirstChild(egg)
	end
	function N.eggPos(egg)
		local model = N.eggModel(egg)
		if not model then
			return nil
		end
		local ok, cf = pcall(function()
			return model:GetPivot()
		end)
		return if ok and cf then cf.Position else nil
	end
	function N.eggStand(egg)
		local model = N.eggModel(egg)
		if not model then
			return nil
		end
		local ok, cf = pcall(function()
			return model:GetPivot()
		end)
		if not ok or not cf then
			return nil
		end
		local look = cf.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.1 then
			flat = Vector3.new(0, 0, -1)
		end
		-- 5 studs in front of the egg; one step closer after every TooFar answer (live 24: one TooFar after a travel).
		return cf.Position + flat.Unit * H.standDist + Vector3.new(0, 2, 0)
	end
	function N.eggIsland(egg)
		local cfg = N.eggCfg(egg)
		return (cfg and cfg.Island) or "Spawn"
	end
	-- forHatch: also 0.3 s after the last teleport (REV-14), so a request never races the new position to the server.
	function N.atEgg(egg, forHatch)
		if N.currentIsland() ~= N.eggIsland(egg) then
			return false
		end
		local here, pos = N.myPos(), N.eggPos(egg)
		local near = here ~= nil and pos ~= nil and (here - pos).Magnitude <= 8.5 and os.clock() - H.tooFarAt > 1
		if near and forHatch then
			return N.settled()
		end
		return near
	end
	-- R5-4: every way back to the egg ends with a line (travel refused, no egg model, too far after the teleport); three
	-- misses in a row = `PROBLEM hatch cannot reach the egg` (once per 5 minutes) instead of silence.
	H.reach = { fails = 0, problemAt = -1e9, why = "" }
	function N.goToEgg(egg)
		N.loopStatus("Main", "Going to the " .. egg .. " egg")
		local started = os.clock()
		local island = N.eggIsland(egg)
		local why = nil
		if not N.travel(island) then
			why = "travel to " .. island .. " failed (" .. tostring(N.Travel.last) .. ")"
		else
			local stand = N.eggStand(egg)
			if not stand then
				waitFor(function()
					return N.eggStand(egg) ~= nil
				end, 6)
				stand = N.eggStand(egg)
			end
			if not stand then
				log("EGG model not found", egg, "on", N.currentIsland())
				why = "no " .. egg .. " egg model on " .. tostring(N.currentIsland())
			else
				N.teleport(stand, 0.3)
				H.tooFarAt = -1e9
				if N.atEgg(egg) then
					log(string.format("EGG at %s ok %.1fs", egg, os.clock() - started))
					H.reach.fails, H.reach.why = 0, ""
					return true
				end
				local here, pos = N.myPos(), N.eggPos(egg)
				why = string.format("not close enough after the teleport (%s studs, island %s)", if here and pos then string.format("%.0f", (here - pos).Magnitude) else "?", tostring(N.currentIsland()))
				log("EGG at", egg, "not close enough")
			end
		end
		H.reach.fails += 1
		H.reach.why = why
		log(string.format("EGG %s not reached (try %d, %.1fs): %s", egg, H.reach.fails, os.clock() - started, why))
		if H.reach.fails >= 3 and os.clock() - H.reach.problemAt > 300 then
			H.reach.problemAt = os.clock()
			logProblem("hatch cannot reach the egg " .. egg .. ": " .. why)
		end
		return false
	end
	-- Pacing (blatant.md second pass, PROBE hatch_pace): "instant" = the next request right after each answer (the server
	-- holds it until its window ends); "ahead" = the next request window - rtt before the window ends (the game's own
	-- watchAhead). Two minutes of each are measured once per game version; the faster one stays.
	function N.hatchMode()
		if H.mode then
			return H.mode
		end
		local state = N.probeState("hatch_pace")
		if state == "instant" or state == "ahead" then
			H.mode = state
			return state
		end
		if not H.trial then
			H.trial = { phase = "instant", active = 0, pets = 0, held = 0, n = 0, results = {} }
		end
		return H.trial.phase
	end
	local function trialNote(pets, gap, held)
		local t = H.trial
		if not t or H.mode then
			return
		end
		t.active += gap
		t.pets += pets
		t.held += held
		t.n += 1
		if t.active >= 120 then
			t.results[t.phase] = { rate = t.pets / t.active * 60, held = t.held / math.max(t.n, 1), window = H.window }
			if t.phase == "instant" then
				t.phase, t.active, t.pets, t.held, t.n = "ahead", 0, 0, 0, 0
			else
				local a, b = t.results.instant, t.results.ahead
				local best = if a.rate >= b.rate then "instant" else "ahead"
				local win = t.results[best]
				N.probeResult(
					"hatch_pace",
					"accepted",
					string.format("gain=%.1f eggs/min held=%.2fs window=%.2fs mode=%s (instant %.1f, ahead %.1f)", win.rate, win.held, win.window, best, a.rate, b.rate),
					best
				)
				H.mode = best
				H.trial = nil
			end
		end
	end
	local function median(list)
		if #list == 0 then
			return 0
		end
		local copy = table.clone(list)
		table.sort(copy)
		return copy[math.ceil(#copy / 2)]
	end
	local function push(list, v)
		table.insert(list, v)
		if #list > 6 then
			table.remove(list, 1)
		end
	end
	N.onEvent("EggService.RE.EggHatchResult", function(r)
		if type(r) ~= "table" or not H.inFlight then
			return
		end
		if r.Seq ~= nil and r.Seq ~= H.seq then
			return
		end
		H.inFlight = false
		local now = os.clock()
		local held = tonumber(r.Held) or 0
		if not N.finite(held) then
			held = 0
		end
		held = math.clamp(held, 0, 30)
		local rtt = math.clamp(now - H.sentAt - held, 0, 2)
		push(H.rtts, rtt)
		push(H.holds, held)
		if r.Success == true then
			local pets = if type(r.Pets) == "table" then #r.Pets else H.count
			H.ok += 1
			H.pets += pets
			Session.hatched += pets
			Session.requests += 1
			local gap = now - (if H.lastResultAt > 0 then H.lastResultAt else H.sentAt)
			H.lastResultAt = now
			H.lastOkAt = now
			H.speed = tonumber(r.Speed) or H.speed
			if not N.finite(H.speed) then
				H.speed = 1
			end
			table.insert(H.recent, { t = now, pets = pets })
			if #H.recent > 400 then
				table.remove(H.recent, 1)
			end
			if N.incomeSpend and H.egg then
				N.incomeSpend(N.eggCost(H.egg, pets))
			end
			H.window = N.hatchWindow(H.speed, pets)
			if gap < 15 then
				H.minute.pets += pets
				H.minute.active += gap
				trialNote(pets, gap, held)
			end
			if N.hatchMode() == "ahead" then
				H.lead = math.clamp(median(H.rtts) + 0.1, 0.1, 1)
				H.nextAt = now + math.max(H.window - H.lead - rtt, 0)
			else
				H.nextAt = now
			end
			if N.Events.hatched then
				pcall(N.Events.hatched, r)
			end
			-- Builder M: the first answer after a start is logged at once (the summary below comes once a minute)
			if not H.firstLogged then
				H.firstLogged = true
				log(string.format("HATCH n=%d first answer egg=%s count=%d after %.1fs", pets, tostring(H.egg), H.count, os.clock() - Session.started))
			end
			if now - H.minute.at >= 60 then
				H.rate = if H.minute.active > 0 then H.minute.pets / H.minute.active * 60 else 0
				log(string.format("HATCH n=%d speed=%.2f egg=%s count=%d eggs/min=%.1f held=%.2f rtt=%.2f window=%.2f mode=%s cancelled=%d limited=%d", pets, H.speed, tostring(H.egg), H.count, H.rate, median(H.holds), median(H.rtts), H.window, N.hatchMode(), H.cancelled, H.limited))
				H.minute = { at = now, pets = 0, active = 0 }
			end
			return
		end
		local err = tostring(r.Error or "?")
		if err == "Cancelled" then
			H.cancelled += 1
			H.nextAt = now + 0.1
			if H.mode == "ahead" then
				H.lead = math.max(H.lead - 0.15, 0.05)
			end
		elseif err == "RateLimited" then
			H.limited += 1
			H.nextAt = now + 0.4
		elseif err == "StorageFull" then
			H.storageFullAt = now
			H.nextAt = now + 1
			log("HATCH storage full", "needed", tostring(r.Needed))
		elseif err == "NotEnoughCoins" then
			H.poorAt = now
			H.nextAt = now + 1
		elseif err == "TooFar" then
			H.tooFarAt = now
			H.nextAt = now + 0.5
			H.standDist = math.max(H.standDist - 1.5, 1.5)
			log(string.format("HATCH TooFar: back to the egg, standing %.1f studs from it", H.standDist))
		elseif err == "IslandLocked" then
			H.locked[tostring(r.Egg or H.egg)] = now
			H.nextAt = now + 1
			log("HATCH island locked for", tostring(r.Egg or H.egg))
		else
			H.other += 1
			H.nextAt = now + 2
			log("HATCH error", err)
		end
	end)
	-- R6-3: the Index Hunter hatches by itself while it has an egg to hunt (its own toggle, never the planner's)
	function N.hatchWanted()
		return N.does("AutoHatch") or (on("IndexHunter") and N.indexTarget ~= nil and N.indexTarget() ~= nil)
	end
	function N.stopHatchSession()
		if H.session then
			H.session = nil
			fire("EggService.RE.StopOfflineHatch")
		end
	end
	-- One step of the hatch loop: sends the next request when none is open and the pacing allows it. The main loop keeps
	-- the character at the egg; this never moves it.
	function N.hatchStep(egg)
		if H.inFlight then
			if os.clock() - H.sentAt > 12 then
				H.inFlight = false
				H.lost += 1
				log("HATCH no answer in 12 s (request lost), sending again")
			end
			return "waiting"
		end
		if os.clock() < H.nextAt then
			return "pacing"
		end
		if not egg then
			return "no egg"
		end
		if not N.atEgg(egg, true) then
			return "away"
		end
		-- R4-5: a hatch sent in the first 0.2 s after a rebirth press would be paid from the coins the reset just took (the
		-- replica shows them a tick longer)
		local rebAt = (N.Reb and N.Reb.at) or -1e9
		if os.clock() - rebAt < 0.2 then
			H.nextAt = rebAt + 0.2
			return "after rebirth"
		end
		local count, why = N.hatchCount(egg)
		if count < 1 then
			H.idleWhy = why
			if why == "storage full" then
				H.nextAt = os.clock() + 0.5
			elseif os.clock() - ((N.Reb and N.Reb.at) or -1e9) < 0.5 then
				-- R4-5 (live 325 s: `HATCH now: Void: not enough coins` right after a rebirth press): the coins read zero until the
				-- next tap lands after the reset; for 0.5 s after a press the hatch looks again every 0.05 s and says nothing
				H.idleWhy = ""
				H.nextAt = os.clock() + 0.05
				return "after rebirth"
			else
				-- Live 26: right after a rebirth reset the coins are 0 for a moment; the eggs cost a sliver of a second of
				-- income, so the next try waits only as long as the income needs (0.05-0.5 s), never a fixed pause.
				H.poorAt = os.clock()
				local need = N.eggCost(egg, math.min(N.hatchTop(), 8)) - N.coins()
				local income = N.income and N.income() or 0
				H.nextAt = os.clock() + (if income > 0 then math.clamp(need / income, 0.05, 0.5) else 0.5)
			end
			return why
		end
		if H.session and H.session ~= egg then
			N.stopHatchSession()
		end
		H.seq += 1
		H.inFlight = true
		H.sentAt = os.clock()
		H.egg = egg
		H.count = count
		H.idleWhy = ""
		H.session = egg
		-- G7 (3937): Use Godly Hatches (its own toggle) spends one Godly Hatch per request on this same egg while a Luck or
		-- Mythic window is live: {Egg, Count=1, Auto=false, Godly=true, Seq} like the game's own Godly mode (bc 62696-62706)
		local args = { Egg = egg, Count = count, Auto = true, Seq = H.seq }
		if N.godlyWanted and N.godlyWanted() then
			args = { Egg = egg, Count = 1, Auto = false, Godly = true, Seq = H.seq }
			H.count = 1
			N.GodlyToken = H.seq
		end
		local sent = fire("EggService.RE.EggHatchRequested", args)
		N.GodlyToken = nil
		if not sent then
			H.inFlight = false
			H.nextAt = os.clock() + 0.5
			return "not sent"
		end
		return "sent"
	end
	-- The game's HatchRenderer plays a reveal for every answer, also for ours. While Auto Hatch runs the reveal is skipped
	-- the way the renderer's own failure path ends a hatch (4021 L3152: the "finished" callback called at once), so the
	-- answers never pile up behind animations. N.revealWrap builds the wrapper (the tests feed it a fake Play): the
	-- callback is looked up among the arguments (its place may move between builds); a call without one, a callback that
	-- errors, or a renderer asked again and again inside one frame (a build whose hatch queue waits for the reveal to
	-- yield) gets the real reveal, never a silent return - a hatch the game never sees finished stalls its queue and the
	-- queue's loop with it (Discord 2026-11-02, "if i activate the auto hatch game freeze", game 4066 on a 4021 build).
	-- Every call yields one frame before it finishes or falls through: a hatch queue that loops on "finished" inside one
	-- frame (a build whose Play is expected to yield) gets its frame from the skip too. Restored on unload.
	N.Restore = {}
	N.Reveal = { skipped = 0, passed = 0, broken = false, lastFrame = -1, burst = 0 }
	function N.revealWrap(realPlay)
		return function(self, ...)
			local R = N.Reveal
			R.burst = if Perf.frames == R.lastFrame then R.burst + 1 else 0
			R.lastFrame = Perf.frames
			if alive() and N.hatchWanted() and not N.Manual.revealOn and not R.broken then
				if R.burst >= 8 then
					if not R.burstLogged then
						R.burstLogged = true
						logProblem("REVEAL the game asked for 8 reveals inside one frame: the real reveal plays until it yields")
					end
					task.wait()
				else
					local done = nil
					for i = 1, select("#", ...) do
						if type((select(i, ...))) == "function" then
							done = (select(i, ...))
							break
						end
					end
					if done then
						task.wait() -- the frame a reveal would have taken
						local ok, err = pcall(done)
						if ok then
							R.skipped += 1
							return
						end
						R.broken = true
						logProblem("REVEAL the game's hatch-finished call failed, the reveal plays from now on: " .. tostring(err))
					elseif not R.noDoneLogged then
						R.noDoneLogged = true
						log("REVEAL no finished callback among the renderer's arguments (new build?), the reveal plays")
					end
				end
			end
			R.passed += 1
			return realPlay(self, ...)
		end
	end
	do
		local renderer = N.safeRequire("Modules.Client.Pets.HatchRenderer")
		if type(renderer) == "table" and type(renderer.Play) == "function" and not table.isfrozen(renderer) then
			local realPlay = renderer.Play
			renderer.Play = N.revealWrap(realPlay)
			table.insert(N.Restore, function()
				renderer.Play = realPlay
			end)
		end
	end

	-- ===== Settings the hatch loop needs (SettingsService.RF.UpdateSetting {Name, Value}, dump 226517; SettingsConfig
	-- 361893-361990): HatchAnimation 3 (Off), EggLuck on (luck is ignored when off, 372598), GamepassPerks on, HideClicks. =====
	N.SettingsDone = false
	function N.applySettings(force)
		if N.SettingsDone and not force then
			return
		end
		N.SettingsDone = true
		pcall(function()
			workspace:SetAttribute("HatchAnimation", 3)
		end)
		local current = N.sub(N.data(), "Settings")
		for _, s in ipairs({ { "HatchAnimation", 3 }, { "EggLuck", true }, { "GamepassPerks", true }, { "HideClicks", true } }) do
			if current[s[1]] ~= s[2] or force then
				invoke("SettingsService.RF.UpdateSetting", { Name = s[1], Value = s[2] })
				log("SETTING", s[1] .. "=" .. tostring(s[2]))
			end
		end
		-- strategy.md item 12: a disabled gamepass silently removes x8 / luck rolls / storage / secret luck
		-- (GamepassPerks.Has 3687 L92393-92398); DisabledGamepasses is a list (ProfileTemplate L385957 = {}). Clear it so
		-- every owned perk is on. Never lists a pass to disable; only clears.
		local disabled = current.DisabledGamepasses
		local anyDisabled = type(disabled) == "table" and next(disabled) ~= nil
		if anyDisabled or force then
			invoke("SettingsService.RF.UpdateSetting", { Name = "DisabledGamepasses", Value = {} })
		end
		log("SETTINGS", "gamepass perks on, none disabled" .. (anyDisabled and " (cleared the disabled list)" or ""))
	end

	-- ===== Rebirth (B3, G5-1; live_findings 4, 14, 17, 21b): RebirthService.RE.RebirthRequested {Index} or, with the "Auto
	-- Rebirth" node, {Auto=true, Index} like the game's own Auto loop (3097 L139085, L139731-139754). Button i gives
	-- 5^(i-1) rebirths for RebirthConfig.GetPrice(amount, R) = round(80 x amount) x 10 x (1 + 0.21875 R): the price per
	-- rebirth is the same on every button. A rebirth RESETS the coins (PROBE rebirth_coins = reset), so the only loss is
	-- what sits above the price when the press lands = income x reaction time. The game's Auto polls every 0.1 s with a
	-- 1.5 s gap and threw away 50-70 % live. Corvus reacts to the coin replica (DataController:ListenToPaths + a 0.1 s
	-- poll) and presses the target button k: the lowest cost = reaction waste + gap pile-up + the time the coins wait before
	-- they turn into rebirths; among the buttons inside max(2 %, best) the smallest (more presses = more pet XP and rebirth
	-- gems). A windfall (mine shop coins, ducks) waits for the next bigger button when it is close, else it presses the
	-- biggest button it pays for. =====
	N.Reb = {
		at = -1e9,
		mode = nil,
		last = "",
		target = nil,
		react = 0.15,
		gap = 1.5,
		inFlight = false,
		waitFor = nil,
		waitText = "",
		logAt = -1e9,
		loggedButton = nil,
		minute = { at = os.clock(), presses = 0, gained = 0, waste = 0 },
		wasteAvg = 0,
		cadenceProbe = false,
		-- REV-8: reaction samples of the last 10 target presses (not the first press after the start, none during or
		-- right after a trip), the reaction is their median
		reacts = {},
		presses = 0,
		-- REV-10: pet levels the equipped team gains within 2 s of a press (PetTrainingResult), and their value in is
		xpPresses = 0,
		xpLevels = 0,
		xpIs = 0,
	}
	local Reb = N.Reb
	function N.hasAutoRebirth()
		local data = N.data()
		local fn = N.G.Skill.HasAutoRebirth
		if not data or type(fn) ~= "function" then
			return false
		end
		local ok, yes = pcall(fn, data)
		return ok and yes == true
	end
	function N.rebirthOptions()
		local data = N.data()
		local raw = tonumber(N.sub(data, "Upgrades").RebirthButtons) or 0
		local fn = N.G.RebirthButtons.GetOptionCount
		if type(fn) == "function" then
			local ok, n = pcall(fn, raw, "Main")
			if ok and type(n) == "number" then
				return math.clamp(math.floor(n), 1, 14)
			end
		end
		return math.clamp(1 + math.floor(raw), 1, 14)
	end
	function N.rebirthAmount(i)
		local fn = N.G.Rebirth.GetAmountFromIndex
		if type(fn) == "function" then
			local ok, n = pcall(fn, i)
			if ok and type(n) == "number" then
				return n
			end
		end
		return 5 ^ (i - 1)
	end
	function N.rebirthPrice(i)
		local amount = N.rebirthAmount(i)
		local fn = N.G.Rebirth.GetPrice
		if type(fn) == "function" then
			local ok, n = pcall(fn, amount, N.rebirths())
			if ok and type(n) == "number" then
				return n
			end
		end
		-- fallback = the 3937 formula for R >= 2 (bc 243325-243344: (R - 1) in the growth term)
		local r = N.rebirths()
		return math.floor(amount * 80 + 0.5) * 10 * ((if r >= 2 then r - 1 else r) * 0.21875 + 1)
	end
	function N.bestRebirth(budget)
		for i = N.rebirthOptions(), 1, -1 do
			if N.rebirthPrice(i) <= budget then
				return i
			end
		end
		return nil
	end
	function N.rebirthMode()
		if N.Reb.mode then
			return N.Reb.mode
		end
		local state = N.probeState("rebirth_coins")
		if state == "reset" or state == "deduct" then
			N.Reb.mode = state
		end
		return N.Reb.mode or "unknown"
	end
	-- Relative growth of the rebirth count per second at this income (rebirths bought per second / rebirths owned).
	function N.rebirthGrowth(income)
		local perRebirth = N.rebirthPrice(1) / math.max(N.rebirthAmount(1), 1)
		return income / math.max(perRebirth, 1) / math.max(N.rebirths(), 1)
	end
	-- Share of the income button k loses: coins above the price when the press lands, coins piling up when presses are
	-- limited by the gap, and the coins waiting T/2 on average before they turn into rebirths (T = price / income).
	-- Returns the total cost, T (seconds of income the button costs) and the reset waste alone.
	function N.rebirthCost(k, income)
		local price = N.rebirthPrice(k)
		if income <= 0 or price <= 0 then
			return math.huge, math.huge, math.huge
		end
		local T = price / income
		local waste = Reb.react / (T + Reb.react)
		if T < Reb.gap then
			waste += 1 - T / Reb.gap
		end
		-- the pet XP every press gives (measured levels per press x their value) counts for the smaller, more frequent button
		local xp = (Reb.xpIs or 0) / math.max(T, Reb.gap)
		return waste + math.min(N.rebirthGrowth(income) * T / 2, 1) - xp, T, waste
	end
	-- The target: only buttons whose reset waste stays at or under 2 % (owner rule), among them the lowest total cost,
	-- then the smallest one inside max(2 %, that cost) (more presses = more pet XP and rebirth gems).
	-- R4-4 (live 20:52: the target drifted to button 12 with 4-6 s cycles at 1.2-1.8 % waste): a button under 10 s of
	-- income counts only while its waste stays at or under 1 %, so the cycles stay at 10 s or more unless they lose
	-- almost nothing.
	local function rebirthEligible(e)
		return e.waste <= 0.02 and (e.T >= 10 or e.waste <= 0.01)
	end
	N.rebirthEligible = rebirthEligible
	function N.rebirthTarget()
		local income = N.income()
		local n = N.rebirthOptions()
		if income <= 0 then
			return 1, math.huge
		end
		local list, minWaste, minWasteK = {}, math.huge, n
		for k = 1, n do
			local c, T, w = N.rebirthCost(k, income)
			list[k] = { cost = c, waste = w, T = T }
			if w < minWaste then
				minWaste, minWasteK = w, k
			end
		end
		local best, bestCost = nil, math.huge
		for k = 1, n do
			if rebirthEligible(list[k]) and list[k].cost < bestCost then
				best, bestCost = k, list[k].cost
			end
		end
		if not best then
			return minWasteK, list[minWasteK].cost
		end
		local limit = math.max(0.02, bestCost)
		for k = 1, best do
			if rebirthEligible(list[k]) and list[k].cost <= limit then
				return k, list[k].cost
			end
		end
		return best, bestCost
	end
	-- Owner 2026-10-11: Farm > Rebirth > "Rebirth button": Smart (lowest loss) = the target logic above (default);
	-- Max button only = always the biggest unlocked button, pressed the moment the coins reach its price, whatever the loss.
	-- The planner follows the player's pick and never changes it.
	function N.rebirthMaxOnly()
		return optionText("RebirthMode", "Smart (lowest loss)") == "Max button only"
	end
	-- "Max button only": the biggest unlocked button whose price the coins plus 10 minutes of income reach (button 1 at
	-- the least), so a top button an hour away never holds every coin in silence.
	function N.rebirthMaxButton()
		local n = N.rebirthOptions()
		local reach = N.coins() + math.max(N.income(), 0) * 600
		for i = n, 1, -1 do
			if N.rebirthPrice(i) <= reach then
				return i
			end
		end
		return 1
	end
	-- What the Rebirth panel and Up next show: the target button, its price and when the coins reach it.
	function N.rebirthPlanText(short)
		if N.rebirthMaxOnly() then
			local top = N.rebirthMaxButton()
			local price = N.rebirthPrice(top)
			local income = N.income()
			local eta = if income > 0 then math.max(price - N.coins(), 0) / income else math.huge
			return string.format("max button %d (+%s) at %s, %s", top, formatNumber(N.rebirthAmount(top)), formatNumber(price), if eta <= 0.2 then "now" else "in " .. N.longTime(eta))
		end
		if N.rebirthMode() == "deduct" then
			local i = N.bestRebirth(N.coins() - N.hatchReserve(N.planner()))
			return if i then string.format("button %d now (+%s)", i, formatNumber(N.rebirthAmount(i))) else "button 1 at " .. formatNumber(N.rebirthPrice(1))
		end
		-- UI-4: the first line is the TARGET (the button the next press goes to), the biggest button only second
		local k = Reb.target or N.rebirthTarget()
		local income = N.income()
		local function line(i)
			local price = N.rebirthPrice(i)
			local eta = if income > 0 then math.max(price - N.coins(), 0) / income else math.huge
			return string.format("button %d (+%s) at %s, %s", i, formatNumber(N.rebirthAmount(i)), formatNumber(price), if eta <= 0.2 then "now" else "in " .. N.longTime(eta))
		end
		local text = line(k)
		if short then
			return text
		end
		local top = N.rebirthOptions()
		if top ~= k then
			text ..= "\nBiggest: " .. line(top)
		end
		if Reb.waitText ~= "" then
			text ..= "\n" .. Reb.waitText
		end
		return text
	end
	local function confirm(i, price, coins0, reb0, why)
		local done = waitFor(function()
			return N.rebirths() > reb0
		end, 3)
		local gained = N.rebirths() - reb0
		local coins1 = N.coins()
		if done then
			Session.rebirthsGained += gained
			Reb.minute.gained += gained
			if N.Reb.mode == nil and coins0 - price > 1000 then
				local mode = if coins1 < (coins0 - price) * 0.5 then "reset" else "deduct"
				N.Reb.mode = mode
				if N.probeState("rebirth_coins") ~= mode then
					N.probeResult("rebirth_coins", "accepted", "gain=" .. mode .. " (coins " .. formatNumber(coins0) .. " -> " .. formatNumber(coins1) .. ", price " .. formatNumber(price) .. ")", mode)
				end
			end
			Reb.last = string.format("button %d: +%s rebirths for %s (%s)", i, formatNumber(gained), formatNumber(price), why)
		else
			Reb.last = "button " .. i .. ": no answer"
			log("REBIRTH button=" .. i .. " no change within 3 s")
		end
		return done
	end
	-- PROBE rebirth_cadence (G5-1): right after a confirmed target press, button 1 (the price of one rebirth) 0.5 s later;
	-- accepted = the count rose again, then presses may follow 0.5 s apart; else the game's own 1.5 s gap stays.
	local function cadenceProbe()
		Reb.cadenceProbe = true
		task.wait(0.5)
		local reb0 = N.rebirths()
		local price = N.rebirthPrice(1)
		if N.coins() < price then
			Reb.cadenceProbe = false
			return
		end
		fire("RebirthService.RE.RebirthRequested", { Index = 1 })
		local ok = waitFor(function()
			return N.rebirths() > reb0
		end, 1.5)
		N.probeResult("rebirth_cadence", if ok then "accepted" else "rejected", string.format("gain=%.1fs gap (the game's own Auto waits 1.5 s)", if ok then 0.5 else 1.5), if ok then "0.5" else "1.5")
		Reb.gap = if ok then 0.5 else 1.5
		Reb.at = os.clock()
		Reb.cadenceProbe = false
	end
	function N.rebirthPress(i, coins0, why)
		local price, amount = N.rebirthPrice(i), N.rebirthAmount(i)
		-- read before the press: pressing the newest button unlocks the next one (RebirthResult UnlockedButtonAmount)
		local topButton = N.rebirthOptions()
		local reb0 = N.rebirths()
		local args = if N.hasAutoRebirth() then { Auto = true, Index = i } else { Index = i }
		if not fire("RebirthService.RE.RebirthRequested", args) then
			return false
		end
		Reb.at = os.clock()
		Reb.inFlight = true
		Session.rebirthClicks += 1
		Reb.xpPresses += 1
		Reb.xpUntil = os.clock() + 2
		if Reb.xpPresses % 10 == 0 and N.levelValue then
			Reb.xpIs = Reb.xpLevels / Reb.xpPresses * N.levelValue(1)
		end
		local income = N.income()
		local ping = 0.05
		pcall(function()
			ping = math.clamp(LocalPlayer:GetNetworkPing(), 0, 1)
		end)
		-- coins above the price when we pressed, plus what the income adds while the press travels to the server
		local lateCoins = income * ping / 2
		local waste = (math.max(coins0 - price, 0) + lateCoins) / math.max(coins0 + lateCoins, 1)
		-- R2-2: the biggest button pressed with more coins than it takes: no button converts more, so that surplus is
		-- unavoidable, not policy waste (kept out of the loss figures, logged as such).
		local unavoidable = i == topButton and waste > 0.02
		if why == "target" and not unavoidable then
			-- REV-8: the reaction time is learned from the target presses only (a windfall's surplus is no reaction), never
			-- from the first press after the start (coins piled up before the hub ran) or a press during / right after a
			-- trip; the median of the last 10
			Reb.presses += 1
			if income > 0 and Reb.presses > 1 and not N.Trip.active and os.clock() - (N.Trip.endedAt or -1e9) > 3 then
				table.insert(Reb.reacts, (math.max(coins0 - price, 0) + lateCoins) / income)
				if #Reb.reacts > 10 then
					table.remove(Reb.reacts, 1)
				end
				if #Reb.reacts >= 3 then
					Reb.react = math.clamp(N.median(Reb.reacts), 0.03, 2)
				end
			end
			Reb.wasteAvg = Reb.wasteAvg * 0.9 + waste * 0.1
			Reb.targetPresses = (Reb.targetPresses or 0) + 1
			Reb.targetWaste = (Reb.targetWaste or 0) + waste
		end
		Reb.minute.presses += 1
		if unavoidable then
			Reb.minute.unavoidable = (Reb.minute.unavoidable or 0) + 1
		else
			Reb.minute.counted = (Reb.minute.counted or 0) + 1
			Reb.minute.waste += waste
		end
		local now = os.clock()
		local nextK = N.rebirthTarget()
		local nextEta = if income > 0 then N.rebirthPrice(nextK) / income else math.huge
		if i ~= Reb.loggedButton or why ~= "target" or now - Reb.logAt >= 30 then
			Reb.logAt, Reb.loggedButton = now, i
			local lossText = if unavoidable then string.format("unavoidable: max button (%.1f%% above the price)", waste * 100) else string.format("waste=%.1f%%", waste * 100)
			if why == "max" then
				log(string.format("REBIRTH button=%d mode=max amount=%s price=%s coins=%s %s", i, formatNumber(amount), formatNumber(price), formatNumber(coins0), lossText))
			else
				log(string.format("REBIRTH button=%d amount=%s price=%s coins=%s %s next=%d eta=%s (%s)", i, formatNumber(amount), formatNumber(price), formatNumber(coins0), lossText, nextK, N.longTime(nextEta), why))
			end
		end
		if unavoidable then
			Reb.last = string.format("button %d (max): %s above the price, unavoidable", i, formatNumber(math.max(coins0 - price, 0)))
		end
		task.spawn(function()
			local done = confirm(i, price, coins0, reb0, why)
			Reb.inFlight = false
			if done and why == "target" and not Reb.cadenceProbe and N.probeState("rebirth_cadence") == "untested" and N.rebirthMode() ~= "deduct" then
				cadenceProbe()
			end
		end)
		return true
	end
	-- Builder M: a held rebirth says why in the log (`REBIRTH waits: <why>` at most every 2 minutes, when the reason changes)
	function N.rebirthWaitLog()
		local now = os.clock()
		-- a changed reason at most once a minute (the holds alternate with the hatch answers), the same one every 5 min
		if (Reb.waitText ~= Reb.waitLogged and now - (Reb.waitLogAt or -1e9) >= 60) or now - (Reb.waitLogAt or -1e9) >= 300 then
			Reb.waitLogged, Reb.waitLogAt = Reb.waitText, now
			log("REBIRTH " .. Reb.waitText .. " | coins " .. formatNumber(N.coins()) .. ", button " .. tostring(Reb.target or N.rebirthTarget()) .. " at " .. formatNumber(N.rebirthPrice(Reb.target or N.rebirthTarget())))
		end
	end
	-- Builder M (alt 2026-10-12: a hand-fired {Index = 9} changed nothing): the server's answer RebirthResult (3518 L1839)
	-- is logged when it refuses, with its reason, at most every 30 s
	if N.onEvent then
		N.onEvent("RebirthService.RE.RebirthResult", function(r)
			if type(r) == "table" and r.Success == false and os.clock() - (Reb.failLogAt or -1e9) >= 30 then
				Reb.failLogAt = os.clock()
				log("REBIRTH refused by the server: " .. tostring(r.Reason or r.Error or "?") .. " " .. brief(r))
			end
		end)
	end
	-- One check of the rebirth watcher (every coin change and every 0.1 s while Auto Rebirth or the planner runs).
	function N.rebirthTick()
		if Reb.inFlight or Reb.cadenceProbe then
			-- 2026-10-12 (alt: coins above button 11 for minutes, no press, no line): every silent hold says why
			Reb.waitText = if Reb.inFlight then "waits: the last press has no answer yet" else "waits: the cadence probe"
			N.rebirthWaitLog()
			return false
		end
		local now = os.clock()
		if now - Reb.at < Reb.gap then
			return false
		end
		local coins = N.coins()
		if N.rebirthMaxOnly() then
			-- "Max button only": the biggest unlocked button as soon as the coins reach its price (no target, no windfall
			-- wait); only an unlock trip that is buying with the coins right now holds it
			if N.Trip.active and string.sub(N.Trip.name, 1, 6) == "unlock" then
				Reb.waitText = "waits: the unlock trip is buying"
				return false
			end
			-- 2026-10-12 (alt: "Max button only" waited in silence for button 13 = an hour of income while the hatches ate
			-- the coins): the max button is the biggest one the income reaches within 10 minutes, and the wait is logged
			local top = N.rebirthMaxButton()
			Reb.target, Reb.waitFor = top, nil
			if coins < N.rebirthPrice(top) then
				Reb.waitText = "waits: coins under the max button"
				N.rebirthWaitLog()
				return false
			end
			Reb.waitText = ""
			return N.rebirthPress(top, coins, "max")
		end
		if N.rebirthMode() == "deduct" then
			-- A game version where a rebirth only takes the price: the biggest button the coins above the next hatch pay for.
			local i = N.bestRebirth(coins - N.hatchReserve(N.planner()))
			if i then
				return N.rebirthPress(i, coins, "deduct")
			end
			return false
		end
		-- The planner saving for an unlock: no reset until it is bought (the unlock is a permanent multiplier); the saving
		-- itself is only set while the trip can run by the time the coins are there (N.planSaving).
		if N.planner() and N.Plan and N.Plan.saving then
			Reb.waitText = "waits: saving coins for " .. N.Plan.saving.name
			N.rebirthWaitLog()
			return false
		end
		-- R2-5: an unlock trip buys with coins: no reset while it runs (it takes 5-15 s)
		if N.Trip.active and string.sub(N.Trip.name, 1, 6) == "unlock" then
			Reb.waitText = "waits: the unlock trip is buying"
			return false
		end
		-- Eggs first while they are expensive (a young account: the next hatch costs more than 20 s of income, so a reset
		-- would starve the pets that multiply every tap). On the owner's account an x8 Void costs 0.0003 s of income and
		-- this never holds; a hatch answer still in flight is waited for only when the eggs cost half a second or more.
		-- Builder M (alt 2026-10-12 08:55: Auto Rebirth on, Void x3 > 20 s of income, 80 minutes without one press): the
		-- player's own Auto Rebirth toggle presses; "eggs first" is the Smart Planner's rule only when Auto Rebirth is off.
		if N.hatchWanted() and N.Hatch.target and not N.Trip.active then
			local eggCost = N.eggCost(N.Hatch.target, N.hatchTop())
			local income = N.income()
			-- Owner 2026-10-12: the hold follows the per-coin math (N.eggsFirst), not the toggle: a fresh account where a pet
			-- adds more income per coin than a rebirth hatches first; an account where the rebirth wins never holds.
			if (if N.eggsFirst then N.eggsFirst() else not on("AutoRebirth")) and eggCost < math.huge and eggCost > income * 20 and coins < eggCost * 2 and not N.storageFull() then
				Reb.waitText = "waits: eggs first (the next hatch costs " .. N.longTime(eggCost / math.max(income, 1e-9)) .. " of income)"
				N.rebirthWaitLog()
				return false
			end
			if N.Hatch.inFlight and eggCost > income * 0.5 then
				Reb.waitText = "waits: a hatch answer is in flight"
				N.rebirthWaitLog()
				return false
			end
		end
		-- R2-8 (live 18:01-18:06: late presses of an old target, a press below the target): the target is chosen right after
		-- a press and then HELD until the coins reach it, so the press fires within one replica update of the threshold. While
		-- waiting it is chosen again only on a deadline: the wait became more than 4 planned cycles (the income collapsed) or
		-- the button is no longer offered; logged as "REBIRTH target a -> b (deadline ...)".
		local k = Reb.target
		if not k or k > N.rebirthOptions() then
			k = N.rebirthTarget()
			local income = N.income()
			Reb.target, Reb.targetAt, Reb.planned = k, now, if income > 0 then N.rebirthPrice(k) / income else math.huge
		end
		local price = N.rebirthPrice(k)
		if coins < price then
			local income = N.income()
			local eta = if income > 0 then (price - coins) / income else math.huge
			if now - (Reb.targetAt or now) > 5 and eta < math.huge and eta > math.max(4 * (Reb.planned or 0), 30) then
				local k2 = N.rebirthTarget()
				if k2 ~= k then
					log(string.format("REBIRTH target %d -> %d (deadline: %s to go, planned %s)", k, k2, N.longTime(eta), N.longTime(Reb.planned or 0)))
					Reb.target, Reb.targetAt, Reb.planned = k2, now, N.rebirthPrice(k2) / income
				else
					Reb.targetAt, Reb.planned = now, N.rebirthPrice(k) / income
				end
			end
			if Reb.waitFor == nil then
				Reb.waitText = "waits: coins under the target button"
				N.rebirthWaitLog()
			end
			return false
		end
		local press, why = k, "target"
		if coins > price * 1.5 then
			-- A windfall: pressing the biggest button it pays for now loses the coins above that price; waiting for the next
			-- button the coins do not reach yet converts all of it, at the cost of turning them into rebirths later
			-- (growth x ETA). Wait when that is the smaller loss (at most 10 minutes).
			local income = N.income()
			local n = N.rebirthOptions()
			local j = N.bestRebirth(coins) or k
			local lossNow = (coins - N.rebirthPrice(j)) / math.max(coins, 1)
			if j < n then
				local pm = N.rebirthPrice(j + 1)
				local eta = if income > 0 then (pm - coins) / income else math.huge
				local delayCost = N.rebirthGrowth(income) * eta
				if eta <= 600 and delayCost < lossNow then
					if Reb.waitFor ~= j + 1 then
						Reb.waitFor = j + 1
						log(string.format("REBIRTH wait button=%d eta=%ds (windfall %s, pressing button %d now would lose %d%%)", j + 1, math.ceil(eta), formatNumber(coins), j, math.floor(lossNow * 100 + 0.5)))
					end
					Reb.waitText = string.format("waits for button %d (windfall), %s", j + 1, N.longTime(eta))
					return false
				end
			end
			press, why = j, "windfall"
		end
		Reb.waitFor = nil
		Reb.waitText = ""
		-- the next target is chosen with the coins back at zero
		Reb.target = nil
		return N.rebirthPress(press, coins, why)
	end
	-- Once a minute: rebirths per second, the average loss per press and the target.
	function N.rebirthMinute()
		local m = Reb.minute
		local now = os.clock()
		if now - m.at < 60 then
			return
		end
		if m.presses > 0 then
			-- the loss of the policy only: presses on the max button with a surplus are counted apart (R2-2)
			log(string.format("REBIRTH rate=%s/s waste=%.1f%% presses=%d unavoidable=%d button=%d gap=%.1fs", formatNumber(m.gained / (now - m.at)), m.waste / math.max(m.counted or 0, 1) * 100, m.presses, m.unavoidable or 0, Reb.target or 0, Reb.gap))
		end
		Reb.minute = { at = now, presses = 0, gained = 0, waste = 0, counted = 0, unavoidable = 0 }
	end
	-- Old entry point (Craft now / tests): press the biggest button a budget pays for, once.
	function N.rebirthStep(budget, why)
		if os.clock() - Reb.at < Reb.gap or Reb.inFlight then
			return false
		end
		local i = N.bestRebirth(budget)
		if not i then
			return false
		end
		local reb0 = N.rebirths()
		if not N.rebirthPress(i, N.coins(), why or "budget") then
			return false
		end
		return waitFor(function()
			return N.rebirths() > reb0
		end, 3)
	end
	do
		local gap = tonumber(N.probeState("rebirth_cadence"))
		if gap and gap >= 0.3 and gap <= 1.5 then
			Reb.gap = gap
		end
	end

	-- ===== Equip: PetService.RE.PetActionRequested {Action="EquipBest", Mode="Clicks"} (dump 191330) or
	-- {Action="Equip"|"Unequip", PetId} (191349, 191362). "Best power" = the team with the most coin power; "Level
	-- farming" (owner rule) = the most valuable pets (power >= the threshold) with the LOWEST level first, so they level
	-- up for the Pet Power leaderboard. The level team is never crafted or deleted.
	-- REV-3 (live: `EQUIP best 9.2M -> 7.73M (best possible 9.53M)`): the game's Equip Best sorts by its own rule, so the hub
	-- builds the best team itself, pet by pet (Unequip / Equip by id); Equip Best (one call) is used only while PROBE
	-- equip_best_game shows it reaches the hub's own sum. Without Auto Equip the hub never touches the owner's own team: the
	-- Smart Planner only fills EMPTY slots and later swaps only the pets it put there itself (Corvus/TAPSIM_team.txt). =====
	N.Equip = { at = -1e9, bestAt = -1e9, backoff = 0, team = {}, last = "", mode = "", placed = nil }
	local TeamFile = "Corvus/TAPSIM_team.txt"
	local function placedSet()
		if N.Equip.placed then
			return N.Equip.placed
		end
		N.Equip.placed = {}
		local ok, text = pcall(function()
			return if isfile(TeamFile) then readfile(TeamFile) else nil
		end)
		if ok and type(text) == "string" then
			for id in string.gmatch(text, "[^\n]+") do
				N.Equip.placed[id] = true
			end
		end
		return N.Equip.placed
	end
	local function savePlaced()
		local lines = {}
		for id in pairs(placedSet()) do
			table.insert(lines, id)
		end
		table.sort(lines)
		pcall(function()
			if makefolder and isfolder and not isfolder("Corvus") then
				makefolder("Corvus")
			end
			writefile(TeamFile, table.concat(lines, "\n"))
		end)
	end
	N.placedSet = placedSet
	function N.equippedPower()
		local total = 0
		local powers = N.powers()
		for id in pairs(N.equippedSet()) do
			total += tonumber(powers[id]) or 0
		end
		return total
	end
	-- The strongest `slots` pets (default: every equip slot), leaving out the `skip` set.
	-- G5 (3937 code pass): the game's Equip Best (Shared.Pets.PetBest, bc 239293-239833) now scores enchants, Celestial
	-- Bond and Resonance, so its team can beat the hub's power-only pick in coins. Measured first: after each Equip Best
	-- the game's team and the hub's pick are priced by the game's own PetBest.TeamValue(owned, ids, "Clicks") (power x the
	-- team's Taps multiplier, 239351-239357, 239821-239830) and logged at most every 10 min; the decision stays power-based
	-- until the live numbers are in (live_findings Round 12).
	local PetBest = nil
	local CompareAt = -1e9
	function N.teamValue(ids)
		if PetBest == nil then
			PetBest = false
			pcall(function()
				local sharedFolder = ReplicatedStorage:FindFirstChild("Shared")
				local inst = sharedFolder and sharedFolder:FindFirstChild("Pets")
				inst = inst and inst:FindFirstChild("PetBest")
				if inst and inst:IsA("ModuleScript") then
					local mod = require(inst)
					if type(mod) == "table" then
						PetBest = mod
					end
				end
			end)
		end
		if type(PetBest) ~= "table" or type(PetBest.TeamValue) ~= "function" then
			return nil
		end
		local list = {}
		for k, v in pairs(ids or {}) do
			if type(k) == "string" and v == true then
				table.insert(list, k)
			elseif type(v) == "string" then
				table.insert(list, v)
			end
		end
		table.sort(list)
		local ok, value = pcall(PetBest.TeamValue, N.owned(), list, "Clicks")
		return if ok and N.finite(value) then value else nil
	end
	function N.equipBestCompare(own)
		if os.clock() - CompareAt < 600 then
			return
		end
		local theirs = N.teamValue(N.equippedSet())
		local mine = N.teamValue(own)
		if theirs and mine and mine > 0 then
			CompareAt = os.clock()
			log(string.format("EQUIP best game=%s own=%s diff=%+.1f%%", formatNumber(theirs), formatNumber(mine), (theirs / mine - 1) * 100))
		end
	end
	function N.bestTeam(slots, skip)
		local list = {}
		-- R13: the pet the game's enchanter holds is not available (the game's own Equip Best leaves it out, bc 66706-66726)
		local held = N.enchantHeldPet and N.enchantHeldPet()
		for id, power in pairs(N.powers()) do
			local pet = N.owned()[id]
			if type(pet) == "table" and pet.Frozen == nil and id ~= held and not (skip and skip[id]) then
				table.insert(list, { id = id, power = tonumber(power) or 0 })
			end
		end
		table.sort(list, function(a, b)
			if a.power == b.power then
				return a.id < b.id
			end
			return a.power > b.power
		end)
		local team, sum = {}, 0
		for i = 1, math.min(slots or N.equipLimit(), #list) do
			team[list[i].id] = true
			sum += list[i].power
		end
		return team, sum
	end
	-- Puts exactly `team` on (pets in `keep` stay as they are): unequips first, then equips, 0.25 s apart like the game.
	function N.swapTeam(team, keep)
		local have = N.equippedSet()
		local swaps = 0
		for id in pairs(have) do
			if not team[id] and not (keep and keep[id]) then
				fire("PetService.RE.PetActionRequested", { Action = "Unequip", PetId = id })
				swaps += 1
				task.wait(0.25)
			end
		end
		for id in pairs(team) do
			if not have[id] and N.ownsPet(id) then
				fire("PetService.RE.PetActionRequested", { Action = "Equip", PetId = id })
				swaps += 1
				Session.equips += 1
				task.wait(0.25)
			end
		end
		return swaps
	end
	function N.levelTeam()
		local threshold = optionNumber("XPMinPower", 600000)
		local list = {}
		for id, power in pairs(N.powers()) do
			local pet = N.owned()[id]
			if type(pet) == "table" and pet.Frozen == nil and (tonumber(power) or 0) >= threshold and (tonumber(pet.Level) or 1) < N.maxLevel(pet) then
				table.insert(list, { id = id, power = tonumber(power) or 0, level = tonumber(pet.Level) or 1 })
			end
		end
		table.sort(list, function(a, b)
			if a.level ~= b.level then
				return a.level < b.level
			end
			if a.power ~= b.power then
				return a.power > b.power
			end
			return a.id < b.id
		end)
		local team, n = {}, 0
		for i = 1, math.min(N.equipLimit(), #list) do
			team[list[i].id] = true
			n += 1
		end
		return team, n, #list
	end
	function N.levelFarming()
		return optionText("EquipMode", "Best power") == "Level farming"
	end
	-- Pets the hub never crafts or deletes: equipped, the level team, locked, frozen, protected.
	-- R13 (3937): also every pet of the game's saved teams (Data.PetTeams, the game's own CraftAllPlan.Kept bc 237226-237241
	-- and Clean Up bc 183646-183658) and the pet the game's enchanter holds (EnchantHeldPet, Clean Up bc 183659-183661,
	-- Equip Best bc 66706-66726).
	function N.keepSet()
		local keep = N.equippedSet()
		for id in pairs(N.Equip.team) do
			keep[id] = true
		end
		for _, team in pairs(N.sub(N.data() or {}, "PetTeams")) do
			if type(team) == "table" then
				for _, id in pairs(team) do
					if type(id) == "string" then
						keep[id] = true
					end
				end
			end
		end
		local held = N.enchantHeldPet and N.enchantHeldPet()
		if held then
			keep[held] = true
		end
		return keep
	end
	-- Remote-only, so it runs during trips too (live 7: the level team waited 10 minutes for trips that never ended); only a
	-- craft trip's pet lock holds it (petChore in p11).
	-- R13 (OWNER_RULES 21 + the lead's mission 2026-10-13: "the planner alone never changes the team"): with Auto Equip off
	-- the Smart Planner only fills EMPTY slots and later swaps only the pets it put there itself (Corvus/TAPSIM_team.txt,
	-- REV-3); every pet the player equipped (before or while the hub runs) stays exactly where it is. Builder M's
	-- "best team in every slot not equipped by hand during this session" swapped a team equipped before the hub started and
	-- is gone. A better team waits for Auto Equip (Status and Up next say how much it would add). Auto Equip on = the whole
	-- team, as before.
	function N.fillTeam()
		local E = N.Equip
		local equipped = N.equippedSet()
		local placed = placedSet()
		local fixed, nFixed = {}, 0
		local changed = false
		for id in pairs(placed) do
			if not equipped[id] then
				-- unequipped since (by the player or the game): no longer the hub's slot
				placed[id] = nil
				changed = true
			end
		end
		for id in pairs(equipped) do
			if not placed[id] then
				fixed[id] = true
				nFixed += 1
			end
		end
		if changed then
			savePlaced()
		end
		local free = N.equipLimit() - nFixed
		E.mode = "fill"
		-- what Auto Equip would add (shown, never done by the planner alone)
		local _, bestAll = N.bestTeam()
		local have = N.equippedPower()
		E.better = if bestAll > have * 1.002 + 0.5 then bestAll - have else 0
		if free <= 0 then
			E.last = string.format("Your team stays as you set it (Auto Equip off)%s", if E.better > 0 then string.format("; Auto Equip would add %s power", formatNumber(E.better)) else "")
			return false
		end
		local skip = table.clone(fixed)
		local held = N.enchantHeldPet and N.enchantHeldPet()
		if held then
			skip[held] = true
		end
		local team, sum = N.bestTeam(free, skip)
		local mine, count = 0, 0
		for id in pairs(placed) do
			if equipped[id] then
				mine += N.petPower(id)
				count += 1
			end
		end
		E.last = string.format("Smart Planner: fills %d free slot%s (%s of %s)%s", free, if free == 1 then "" else "s", formatNumber(mine), formatNumber(sum), if nFixed > 0 then string.format(", your %d pet%s stay", nFixed, if nFixed == 1 then "" else "s") else "")
		if not (sum > mine * 1.002 + 0.5 or (count < free and sum > mine)) or os.clock() - E.bestAt < 5 then
			return false
		end
		E.bestAt = os.clock()
		if N.planLog then
			N.planLog("equip fill", string.format("fill %d free slot%s with the best power pets (+%s power), your %d pet%s stay", free, if free == 1 then "" else "s", formatNumber(sum - mine), nFixed, if nFixed == 1 then "" else "s"), 600, 30)
		end
		local swaps = N.swapTeam(team, fixed)
		-- the hub's slots = what it put on now (confirmed by the replica)
		waitFor(function()
			local now = N.equippedSet()
			for id in pairs(team) do
				if not now[id] then
					return false
				end
			end
			return true
		end, 3)
		local now = N.equippedSet()
		table.clear(placed)
		local nOn = 0
		for id in pairs(team) do
			if now[id] then
				placed[id] = true
				nOn += 1
			end
		end
		savePlaced()
		log(string.format("EQUIP filled %d free slot%s: %s -> %s (%d of yours kept, %d swaps, %d on)", free, if free == 1 then "" else "s", formatNumber(mine), formatNumber(sum), nFixed, swaps, nOn))
		return swaps > 0
	end
	-- Builder M (owner 2026-10-12): Auto Delete Junk deletes only after the team is the best one: the equipped pets (minus
	-- the ones equipped by hand while the planner runs without Auto Equip) reach the top-N power sum of the allowed pets;
	-- Auto Equip "Level farming" = its level team is on.
	-- The egg can hatch now: hatching is on and the storage has room for at least one pet.
	function N.hatchHasRoom()
		if not N.hatchWanted() or not N.Hatch.target then
			return false
		end
		local n, limit = N.storage()
		return limit > 0 and n < limit
	end
	-- Builder M: the tap chests and Boingo share the optional trips' gap while the egg has room (p06 pickTrip)
	function N.optionalGapOk()
		if not N.hatchHasRoom() then
			return true
		end
		return os.clock() - (N.Sched and N.Sched.lastOptionalEnd or -1e9) >= 300
	end
	function N.optionalDone()
		if N.Sched then
			N.Sched.lastOptionalEnd = os.clock()
		end
	end
	function N.teamIsBest()
		local equipped = N.equippedSet()
		if on("AutoEquip") and N.levelFarming() and next(N.Equip.team) ~= nil then
			for id in pairs(N.Equip.team) do
				if not equipped[id] then
					return false, "the level team is not on yet"
				end
			end
			return true, "level team on"
		end
		-- R13: without Auto Equip every pet the player equipped is his (only the hub's own filled slots count here)
		local fixed, nFixed = {}, 0
		if not on("AutoEquip") then
			local placed = placedSet()
			for id in pairs(equipped) do
				if not placed[id] then
					fixed[id] = true
					nFixed += 1
				end
			end
		end
		local _, sum = N.bestTeam(N.equipLimit() - nFixed, fixed)
		local have = 0
		for id in pairs(equipped) do
			if not fixed[id] then
				have += N.petPower(id)
			end
		end
		if have >= sum * 0.999 - 0.5 then
			return true, "best team on"
		end
		return false, string.format("equipped %s of the best %s", formatNumber(have), formatNumber(sum))
	end
	function N.equipStep(fillOnly)
		if os.clock() < N.Equip.backoff then
			return false
		end
		if fillOnly then
			return N.fillTeam()
		end
		-- Auto Equip on: the whole team is the hub's to set (the record of filled slots is not needed any more)
		if next(placedSet()) ~= nil then
			table.clear(placedSet())
			savePlaced()
		end
		if N.levelFarming() then
			local team, n, candidates = N.levelTeam()
			if n > 0 then
				N.Equip.team = team
				N.Equip.mode = "level"
				local swaps = N.swapTeam(team)
				N.Equip.last = string.format("Level farming: %d pets worth %s+ (lowest level first), %d candidates", n, formatNumber(optionNumber("XPMinPower", 600000)), candidates)
				if swaps > 0 then
					log("EQUIP level team", n, "pets", "candidates", candidates)
				end
				return swaps > 0
			end
			N.Equip.team = {}
			N.Equip.last = "Level farming: no pet worth " .. formatNumber(optionNumber("XPMinPower", 600000)) .. "+ below its max level, using the best team"
		else
			N.Equip.team = {}
		end
		N.Equip.mode = "best"
		local team, bestSum = N.bestTeam()
		local have = N.equippedPower()
		local count = 0
		for _ in pairs(N.equippedSet()) do
			count += 1
		end
		if not N.levelFarming() then
			N.Equip.last = string.format("Best power: equipped %s of %s possible", formatNumber(have), formatNumber(bestSum))
		end
		if not (bestSum > have * 1.002 + 0.5 or (count < N.equipLimit() and bestSum > have)) then
			return false
		end
		if os.clock() - N.Equip.bestAt < 5 then
			return false
		end
		N.Equip.bestAt = os.clock()
		if N.planLog then
			N.planLog("equip best", string.format("equip the best power team (%s -> %s)", formatNumber(have), formatNumber(bestSum)), 600, 30)
		end
		local state = N.probeState("equip_best_game")
		if state ~= "rejected" then
			-- one call when the game's own Equip Best reaches the same sum
			fire("PetService.RE.PetActionRequested", { Action = "EquipBest", Mode = "Clicks" })
			Session.equips += 1
			waitFor(function()
				return N.equippedPower() >= bestSum * 0.999
			end, 3)
			local after = N.equippedPower()
			N.equipBestCompare(team)
			if after >= bestSum * 0.999 then
				if state == "untested" then
					N.probeResult("equip_best_game", "accepted", string.format("gain=one call (the game's Equip Best reached %s)", formatNumber(after)))
				end
				log("EQUIP best", formatNumber(have), "->", formatNumber(after))
				return true
			end
			if state == "untested" then
				N.probeResult("equip_best_game", "rejected", string.format("gain=%s by pet id vs %s from the game's Equip Best", formatNumber(bestSum), formatNumber(after)))
			end
		end
		local before = N.equippedPower()
		local swaps = N.swapTeam(team)
		waitFor(function()
			return N.equippedPower() >= bestSum * 0.999
		end, 2)
		local now = N.equippedPower()
		log(string.format("EQUIP team %s (was %s, %d swaps)", formatNumber(now), formatNumber(math.min(have, before)), swaps))
		if now < bestSum * 0.99 then
			-- a pet the server refused (locked in a trade, enchanter): try again in a minute
			N.Equip.backoff = os.clock() + 60
		end
		return swaps > 0
	end
