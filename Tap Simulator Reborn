		local afk = { Jump = false, JumpEvery = 30, LastJump = os.clock(), Move = false, LastMove = os.clock() }
		local afkBox = tab:AddLeftGroupbox("Anti AFK", "coffee")
		local engine = rawget(Library, "AntiAfk")
		afkBox:AddToggle("CorvusAntiAFK", {
			Text = "Anti AFK",
