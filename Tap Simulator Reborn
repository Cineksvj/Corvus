	function N.income()
		local measured = tonumber(N.Income and N.Income.rate) or 0
		if measured > 0 and (N.Income.counted or 0) >= 3 then
			-- a rise shows in the last 5 s before the 60 s window catches up
			return math.max(measured, tonumber(N.Income.fast) or 0)
		end
