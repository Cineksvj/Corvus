			-- the hub did not announce (REV-11): left out
			-- five such samples within 3 s are a new income level (a big rebirth, a new pet): the window starts afresh
			local lump = I.rate > 0 and (I.counted or 0) >= 3 and gain > I.rate * math.max(now - I.lastT, 0.1) * 50
			if lump then
				if now - (I.lumpLast or -1e9) > 3 then
					I.lumpRun, I.lumpGain, I.lumpDt = 0, 0, 0
				end
				I.lumpLast = now
				I.lumpRun = (I.lumpRun or 0) + 1
				I.lumpGain = (I.lumpGain or 0) + gain
				I.lumpDt = (I.lumpDt or 0) + (now - I.lastT)
				if I.lumpRun >= 5 then
					-- the new level: the window starts from these samples
					table.clear(I.buckets)
					I.buckets[math.floor(now)] = { gain = I.lumpGain - gain, dt = math.max(I.lumpDt - (now - I.lastT), 0.1) }
					I.rate = I.lumpGain / math.max(I.lumpDt, 0.1)
					I.counted = 3
					I.lumpRun, I.lumpGain, I.lumpDt = 0, 0, 0
					lump = false
				end
			end
			if lump then
				I.lumps = (I.lumps or 0) + 1
			elseif gain >= -0.01 * math.max(I.lastCoins, 0) then
				local sec = math.floor(now)
				local b = I.buckets[sec]
				if not b then
					b = { gain = 0, dt = 0 }
					I.buckets[sec] = b
				end
				b.gain += gain
				b.dt += now - I.lastT
			end
		end
		I.spent = 0
		I.lastT, I.lastCoins, I.lastReb = now, coins, reb
		local sec = math.floor(now)
		if sec ~= I.sec then
			I.sec = sec
			local gain, dt = 0, 0
			for key, b in pairs(I.buckets) do
				if key < sec - 60 then
					I.buckets[key] = nil
				else
					gain += b.gain
					dt += b.dt
				end
			end
			I.counted = dt
			if dt >= 3 then
				I.rate = gain / dt
			end
			-- the last 5 seconds too: a rise (a big rebirth, a new pet) shows at once, so the rebirth target never lags
			-- behind a higher income (coins piling up past the target are lost by the reset)
			local g5, d5 = 0, 0
			for key, b in pairs(I.buckets) do
				if key >= sec - 5 then
					g5 += b.gain
					d5 += b.dt
				end
			end
			I.fast = if d5 >= 2 then g5 / d5 else 0
		end
		if now - I.logAt >= 60 and I.rate > 0 then
			I.logAt = now
			log(string.format("INCOME %s/s (taps %s/s) taps %.1f/s auto %.1f/s counted %ds of 60", formatNumber(I.rate), formatNumber(Tap.coinRate), Tap.rate, Tap.autoRate, math.floor(I.counted)))
		end
	end

	-- ===== Hatching: EggService.RE.EggHatchRequested {Egg, Count, Auto, Seq} (dump 184145-184162); answer EggHatchResult
	-- {Success, Pets, Seq, Held, Speed, Error}. blatant.md second pass F1: exactly one request in flight; the server holds
	-- an early request (Held) and answers Cancelled / RateLimited when it comes too early; Count only 1, 3 or 8 (8 needs
	-- the owned x8Egg pass or an Octo Incubator boost; never more). Auto=true registers the game's own auto-hatch session
	-- (offline hatching at 1/4 speed when you leave). =====
	N.Hatch = {
		seq = 0,
		inFlight = false,
		sentAt = 0,
		nextAt = 0,
		egg = nil,
		count = 0,
		speed = 1,
		window = 4,
		lead = 0.3,
		rtts = {},
		holds = {},
		ok = 0,
		pets = 0,
		cancelled = 0,
		limited = 0,
		lost = 0,
		other = 0,
		lastOkAt = os.clock(),
		lastResultAt = 0,
		minute = { at = os.clock(), pets = 0, active = 0 },
		rate = 0,
		storageFullAt = -1e9,
		poorAt = -1e9,
		tooFarAt = -1e9,
		locked = {},
		idleWhy = "",
		mode = nil,
		trial = nil,
		lastLogAt = -1e9,
