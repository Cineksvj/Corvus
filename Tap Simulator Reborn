					TextYAlignment = Enum.TextYAlignment.Center,
					TextTruncate = Enum.TextTruncate.AtEnd,
					ZIndex = row.ZIndex + 1,
					Parent = row,
				})
				if not isHere then
					local pill = Library:New("TextLabel", {
						Name = "Play",
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, -8, 0.5, 0),
						Size = UDim2.new(0, 56, 0, 24),
						BackgroundColor3 = Colors.moon,
						BorderSizePixel = 0,
						Text = "Play",
						FontFace = Fonts.InterMed or Fonts.Inter,
						TextSize = 12,
						TextColor3 = Colors.window,
						ZIndex = row.ZIndex + 1,
						Parent = row,
					})
					Library:New("UICorner", { CornerRadius = UDim.new(0, 6), Parent = pill })
					local function give(conn)
						if type(Library.GiveSignal) == "function" then pcall(Library.GiveSignal, Library, conn) end
					end
					give(row.MouseEnter:Connect(function() row.BackgroundColor3 = Colors.wellHover end))
					give(row.MouseLeave:Connect(function() row.BackgroundColor3 = Colors.well end))
					give(row.MouseButton1Click:Connect(function()
						Library:Confirm({
							Title = "Play " .. tostring(entry.Name) .. "?",
							Text = "Corvus queues itself and starts again in the new game.",
