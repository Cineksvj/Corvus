	-- the game's own rule first (FusionPools.Eligible), else a Secret that is not excluded
	local function eligible(pet)
		local fn = N.G.FusionPools.Eligible
		if type(fn) == "function" then
			local ok, yes = pcall(fn, pet)
			if ok then
				return yes == true
			end
		end
		return isSecret(pet) and N.tableOr(N.G.Fusion.ExcludedPets)[pet.Name] ~= true
	end
	local function fuelOf(pets)
		local fn = N.G.FusionOdds.Fuel
		if type(fn) == "function" then
			local ok, fuel = pcall(fn, pets)
			if ok and type(fuel) == "number" then
				return fuel
			end
		end
		return #pets
	end
	function N.fusionSizeOf(pets)
		local fuel = fuelOf(pets)
		local fn = N.G.FusionOdds.Size
		if type(fn) == "function" then
			local ok, size = pcall(fn, fuel)
			if ok and type(size) == "table" and type(size.Name) == "string" then
				return size.Name, tonumber(size.Seconds) or 5400
			end
		end
		return "Small", 5400
	end
	function N.fusionCost(sizeName)
		local cost = N.tableOr(N.G.Fusion.Cost)[sizeName]
		return tonumber(cost) or 50000
	end
	-- The four Secrets to fuse: spare copies only (count minus Copies to keep, locked and kept pets never counted), the
	-- species with the most spares first (4 of one species = x1.25 fuel), the weakest copies of it; else the weakest
	-- spares across species. nil = nothing to fuse (with the reason).
	function N.fusionPlan()
		local need = N.fusionInputs()
		local keepN = math.max(math.floor(optionNumber("FusionKeep", 1)), 0)
		local keep = N.keepSet()
		local protect = N.protectedNames()
		local groups, secrets = {}, 0
		for id, pet in pairs(N.owned()) do
			if type(pet) == "table" and isSecret(pet) then
				secrets += 1
				local valued = N.petValued(pet)
				if eligible(pet) and not keep[id] and pet.Locked ~= true and not protect[pet.Name] and (valued == nil or valued == "Secret") then
					groups[pet.Name] = groups[pet.Name] or {}
					table.insert(groups[pet.Name], { id = id, pet = pet, power = N.petPower(id) })
				end
			end
		end
		if secrets == 0 then
			return nil, "no Secret pets"
		end
		local spares = {}
		local bestName, bestN
		for name, list in pairs(groups) do
			table.sort(list, function(a, b)
				if a.power ~= b.power then
					return a.power < b.power
				end
				return a.id < b.id
			end)
			local n = #list - keepN
			for i = 1, n do
				table.insert(spares, list[i])
			end
			if n >= need and (not bestN or n > bestN or (n == bestN and name < bestName)) then
				bestName, bestN = name, n
			end
		end
		local picked = {}
		if bestName then
			for i = 1, need do
				table.insert(picked, groups[bestName][i])
			end
		else
			table.sort(spares, function(a, b)
				if a.power ~= b.power then
					return a.power < b.power
				end
				return a.id < b.id
			end)
			if #spares < need then
				return nil, string.format("%d spare Secret%s, %d needed (keeping %d of each)", #spares, if #spares == 1 then "" else "s", need, keepN)
			end
			for i = 1, need do
				table.insert(picked, spares[i])
			end
		end
		local ids, pets, names = {}, {}, {}
		for _, entry in ipairs(picked) do
			table.insert(ids, entry.id)
			table.insert(pets, entry.pet)
			table.insert(names, tostring(entry.pet.Name))
		end
		local size, seconds = N.fusionSizeOf(pets)
		return { ids = ids, pets = pets, names = names, size = size, seconds = seconds, cost = N.fusionCost(size), matched = bestName ~= nil }
	end
	local function reasonOf(result)
		return tostring(type(result) == "table" and (result.Reason or result.Error) or (if result == nil then "no answer" else result))
	end
	local function farAnswer(result)
		local reason = string.lower(reasonOf(result))
		return string.find(reason, "near", 1, true) ~= nil or string.find(reason, "far", 1, true) ~= nil or string.find(reason, "visit", 1, true) ~= nil or string.find(reason, "machine", 1, true) ~= nil or string.find(reason, "distance", 1, true) ~= nil
	end
	-- ----- Start -----
	function N.fusionStartDue()
		if not on("AutoFusion") or N.fusionSlot() ~= nil or os.clock() - FU.failAt < 600 or N.PetLock.chore then
			return false
		end
		if not N.fusionOpen() then
			FU.last = "the Fusion machine is not open yet"
			return false
		end
		local plan, why = N.fusionPlan()
		if not plan then
			FU.last = why or "nothing to fuse"
			return false
		end
		if N.gems() < plan.cost then
			FU.last = string.format("%s Fusion Egg costs %s Gems, you have %s", plan.size, formatNumber(plan.cost), formatNumber(N.gems()))
			return false
		end
		return true
	end
	local function startOnce(plan)
		N.FusionToken = plan.ids
		local result = invoke("FusionService.RF.Start", { PetIds = plan.ids, Lucky = false, Unlock = false })
		N.FusionToken = nil
		return result
	end
	-- Fuses one planned set: remote first, at the Fusion point when the server asks for it; "ok" only when the slot
	-- appeared and the four pets left the save (the game state, not the answer alone).
	function N.fusionStart()
		local plan = N.fusionPlan()
		if not plan or N.fusionSlot() ~= nil then
			return false
		end
		if N.gemGate and not N.gemGate("fusion", plan.cost, string.format("fuse 4 Secrets (%s) for %s gems", table.concat(plan.names, ", "), formatNumber(plan.cost))) then
			return false
		end
		local gems0 = N.gems()
		N.PetLock.craft = true
		local result = startOnce(plan)
		local ok = type(result) == "table" and result.Success == true
		if not ok and farAnswer(result) then
			local part = N.goToPoint("Fusion")
			if part then
				result = startOnce(plan)
				ok = type(result) == "table" and result.Success == true
			else
				log("FUSION start FAILED answer=the Fusion point was not found (next try in 10 min)")
			end
		end
		N.PetLock.craft = false
		local function gone()
			local owned = N.owned()
			for _, id in ipairs(plan.ids) do
				if owned[id] ~= nil then
					return false
				end
			end
			return N.fusionSlot() ~= nil
		end
		if ok and waitFor(gone, 3) then
			FU.started += 1
			local slot = N.fusionSlot() or {}
			FU.last = string.format("%s Fusion Egg started (%s), ready in %s", tostring(slot.Size or plan.size), table.concat(plan.names, ", "), N.longTime(math.max((tonumber(slot.EndTime) or N.serverTime() + plan.seconds) - N.serverTime(), 0)))
			log(string.format("FUSION start ok size=%s pets=%s gems %s -> %s ready in %s", tostring(slot.Size or plan.size), table.concat(plan.names, "|"), formatNumber(gems0), formatNumber(N.gems()), N.longTime(math.max((tonumber(slot.EndTime) or 0) - N.serverTime(), 0))))
			return true
		end
		FU.failAt = os.clock()
		FU.last = "fusion refused: " .. reasonOf(result)
		log(string.format("FUSION start FAILED answer=%s success=%s slot=%s (next try in 10 min)", reasonOf(result), tostring(ok), tostring(N.fusionSlot() ~= nil)))
		return false
	end
	function N.fusionStartTrip()
		N.tripBegin("fusion", 90)
		N.loopStatus("Main", "fusing 4 spare Secrets at the Fusion machine")
		local done = if N.fusionStart() then 1 else 0
		N.tripEnd()
		return done
	end
	-- ----- Claim -----
	function N.fusionReady()
		local slot = N.fusionSlot()
		return slot ~= nil and (tonumber(slot.EndTime) or math.huge) <= N.serverTime()
	end
	function N.fusionClaimDue()
		return N.fusionReady() and os.clock() - FU.claimFailAt >= 120
	end
	-- Hatches the finished Fusion Egg: remote first, at the machine when asked; ok = the slot is empty and the pet exists.
	function N.fusionClaim()
		if not N.fusionReady() then
			return false
		end
		local before = N.storage()
		local result = invoke("FusionService.RF.Claim")
		local ok = type(result) == "table" and result.Success == true
		if not ok and farAnswer(result) then
			local part = N.goToPoint("Fusion")
			if part then
				result = invoke("FusionService.RF.Claim")
				ok = type(result) == "table" and result.Success == true
			else
				log("CLAIM fusion egg FAILED answer=the Fusion point was not found (next try in 2 min)")
			end
		end
		local function hatched()
			return N.fusionSlot() == nil and N.storage() > before
		end
		if ok and waitFor(hatched, 3) then
			FU.claimed += 1
			local pet = type(result) == "table" and type(result.Pet) == "table" and result.Pet or {}
			local text = string.format("%s%s (%s pool)", tostring(pet.Name or "a Secret"), if pet.Mutation then " " .. tostring(pet.Mutation) else "", tostring(type(result) == "table" and result.Pool or "?"))
			FU.last = "Fusion Egg hatched: " .. text
			log(string.format("FUSION claim ok pet=%s tier=%s rarity=%s pool=%s storage %d -> %d", tostring(pet.Name), tostring(pet.Tier), tostring(pet.Rarity), tostring(type(result) == "table" and result.Pool), before, N.storage()))
			Session.claims += 1
			return true
		end
		FU.claimFailAt = os.clock()
		if N.claimFailed then
			N.claimFailed("fusion egg", result, string.format(" slot=%s storage %d -> %d", tostring(N.fusionSlot() ~= nil), before, N.storage()))
		end
		return false
	end
	function N.fusionClaimTrip()
		N.tripBegin("fusion claim", 60)
		N.loopStatus("Main", "hatching the finished Fusion Egg")
		local done = if N.fusionClaim() then 1 else 0
		N.tripEnd()
		return done
	end
	function N.fusionText()
		local slot = N.fusionSlot()
		local head
		if slot then
			local left = (tonumber(slot.EndTime) or 0) - N.serverTime()
			head = string.format("%s Fusion Egg in the machine: %s", tostring(slot.Size or "?"), if left <= 0 then "<b>ready to hatch</b>" else "ready in " .. N.longTime(left))
		else
			local plan, why = N.fusionPlan()
			head = if plan then string.format("Next fuse: %s (%s egg, %s Gems%s)", table.concat(plan.names, ", "), plan.size, formatNumber(plan.cost), if plan.matched then ", matched x1.25 fuel" else "") else "Nothing to fuse: " .. tostring(why)
		end
		return string.format("%s\nFused <b>%d</b>  \u{00B7}  hatched <b>%d</b>%s", head, FU.started, FU.claimed, if FU.last ~= "" then "\nLast: " .. FU.last else "")
	end
end
