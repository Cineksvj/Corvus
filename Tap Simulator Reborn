		end
	end
	N.onEvent("ColosseumService.RE.WaveDefenseOpponentSpawned", function(p)
		Arena.progressAt = os.clock()
		if type(p) == "table" and p.Id ~= nil then
			Arena.opponents[tostring(p.Id)] = { id = p.Id, arrival = tonumber(p.ArrivalTime) or math.huge, spawn = tonumber(p.SpawnTime) or 0, ability = p.Ability, shield = p.Shield }
