	local function reelRod(id)
		local got = 0
		for _ = 1, tonumber(cfg().MaxHooked) or 3 do
			local r = N.pacedInvoke("FishingService.RF.Reel", id)
			if not ok(r) then
				log("FISH reel", id, "refused:", reasonOf(r))
				break
			end
			got += 1
			F.reels += 1
			if type(r.Ring) == "table" then
				local c = type(cfg().Rings) == "table" and cfg().Rings[r.Ring.Name]
				F.last = "a Fishing Ring came up: " .. tostring(if type(c) == "table" and c.Name then c.Name else r.Ring.Name or "ring")
			end
			if (tonumber(r.Left) or 0) <= 0 or r.Stowed == true then
				break
			end
		end
		if got > 0 then
			log("FISH reeled", id, "x" .. got)
		end
		return got
	end
	local function castRod(spot, pond, model, c)
		local bait = N.pickBait()
		if bait == nil then
			return 0
		end
		local from = standPos(model, c.slot)
		if from then
			N.teleport(from + Vector3.new(0, 3, 0), 0.3)
		end
		local load = math.min(tonumber(N.baitCounts()[bait]) or 0, tonumber(cfg().Cast and cfg().Cast.Load) or 10)
		if load <= 0 then
			return 0
		end
		local x, z, t, zone = castPoint(spot, pond, from or N.myPos())
		local r = N.pacedInvoke("FishingService.RF.Cast", c.id, bait, load, { X = x, Z = z, T = t })
		if ok(r) then
			F.casts += 1
			F.last = string.format("cast %s with %d %s%s", c.id, load, bait, if zone then " into the " .. zone .. " zone" else "")
			log("FISH cast", c.id, bait, "x" .. load, if zone then "zone=" .. zone else "zone=none")
			return 1
		end
		log("FISH cast", c.id, bait, "refused:", reasonOf(r))
		return 0
	end
	local function collectBowl()
		local r = N.pacedInvoke("FishingService.RF.Collect")
		if ok(r) then
			local n = 0
			for _, v in pairs(type(r.Fish) == "table" and r.Fish or {}) do
				n += math.max(tonumber(v) or 0, 0)
			end
			F.collected += n
			F.last = string.format("bowl emptied: %d fish", n)
			log("FISH bowl collected", n, brief(r.Fish))
			return 1
		end
		log("FISH bowl refused:", reasonOf(r))
		return 0
	end
	-- Buys the cheapest Gems offer for bait when the bag is empty: Worms10 (permanent) or a rotating offer with stock
	-- left; never an event-currency offer, never above the gem budget from Upgrades (0 = no limit).
	local function buyBait(f)
		local S = sim()
		local data = N.data()
		if type(S.ShopOffers) ~= "function" or type(S.ShopWindow) ~= "function" or type(data) ~= "table" then
			return 0
		end
		local window = S.ShopWindow(serverNow())
		local okO, offers = pcall(S.ShopOffers, window, nil)
		if not okO or type(offers) ~= "table" then
			return 0
		end
		local price = N.G.MineRewards.Price
		local budget = tonumber(Options.GemBudget and Options.GemBudget.Value) or 0
		local best, bestCost = nil, math.huge
		for _, offer in ipairs(offers) do
			if type(offer) == "table" and offer.Currency == nil and type(offer.Taps) == "number" and type(price) == "function" then
				local okP, cost = pcall(price, data, offer.Taps)
				local left = 1
				if type(S.ShopLeft) == "function" and type(offer.Stock) == "number" then
					local okL, n = pcall(S.ShopLeft, f.Shop, window, offer)
					left = if okL and type(n) == "number" then n else 1
				end
				if okP and type(cost) == "number" and left > 0 and cost < bestCost then
					best, bestCost = offer, cost
				end
			end
		end
		if best == nil then
			return 0
		end
		if bestCost > N.gems() then
			F.last = string.format("no bait: %s costs %s gems, you have %s", tostring(best.Id), formatNumber(bestCost), formatNumber(N.gems()))
			F.buyFailAt = os.clock()
			return 0
		end
		if budget > 0 and bestCost > budget then
			F.last = string.format("no bait: %s costs %s gems, above your gem budget", tostring(best.Id), formatNumber(bestCost))
			F.buyFailAt = os.clock()
			return 0
		end
		local r = N.pacedInvoke("FishingService.RF.Buy", best.Id)
		if ok(r) then
			F.bought += 1
			Session.buys += 1
			F.last = string.format("bought %s x%s for %s gems", tostring(r.Bait or best.Bait), tostring(r.Amount or best.Amount), formatNumber(bestCost))
			log("FISH bought", best.Id, "gems", bestCost)
			waitFor(function()
				return N.pickBait() ~= nil
			end, 2)
			return 1
		end
		F.buyFailAt = os.clock()
		log("FISH buy", best.Id, "refused:", reasonOf(r))
		return 0
	end
	-- The trip: Heaven, the stands, then ring -> gift -> reel -> stow empty rods -> buy bait -> cast -> empty the bowl.
	function N.fishingTrip()
		local work = N.fishingWork()
		local spot = N.fishSpot()
		if work == nil or spot == nil then
			return 0
		end
		N.tripBegin("fishing")
		F.tripAt = os.clock()
		waitFor(function()
			return not N.Hatch.inFlight
		end, 4)
		N.loopStatus("Main", "Fishing at " .. tostring(spot.Name or spot.Id))
		local done = 0
		if N.travel(spot.Island or "Heaven") then
			local model = N.fishSpotModel(spot)
			local pond = pondOf(model)
			if model and pond then
				local stand = standPos(model, 1)
				if stand then
					N.teleport(stand + Vector3.new(0, 3, 0), 0.5)
				end
				local f = fishData() or {}
				if work.ring then
					done += ringStep(f)
				end
				if work.gift then
					done += giftStep()
				end
				for _, c in ipairs(work.reel) do
					local from = standPos(model, c.slot)
					if from then
						N.teleport(from + Vector3.new(0, 3, 0), 0.3)
					end
					done += reelRod(c.id)
				end
				for _, c in ipairs(work.remove) do
					local r = N.pacedInvoke("FishingService.RF.Remove", c.id)
					log("FISH stowed", c.id, if ok(r) then "ok" else "refused: " .. reasonOf(r))
					if ok(r) then
						table.insert(work.cast, c)
					end
				end
				if work.buy or (#work.cast > 0 and N.pickBait() == nil and Toggles.FishBuyBait and Toggles.FishBuyBait.Value) then
					done += buyBait(fishData() or {})
				end
				for _, c in ipairs(work.cast) do
					done += castRod(spot, pond, model, c)
				end
				if work.collect then
					done += collectBowl()
				end
			else
				F.last = "fishing spot not found on " .. tostring(spot.Island or "Heaven")
				log("FISH spot model not found", tostring(spot.Id))
			end
		else
			F.last = "could not travel to " .. tostring(spot.Island or "Heaven")
		end
		N.tripEnd()
		return done
	end
	N.onEvent("FishingService.RE.Caught", function(p)
		F.caught += 1
		F.lastCatch = if type(p) == "table" then tostring(p.Name or p.Key or p.Catch or p.Fish or brief(p)) else tostring(p)
	end)
	function N.fishingText()
		local f = fishData()
		local spot = N.fishSpot()
		if f == nil then
			return "No fishing data yet"
		end
		if spot == nil then
			return "Heaven Falls opens with the Heaven island (Auto Unlock Islands)"
		end
		local rods = type(f.Rods) == "table" and f.Rods or {}
		local out, hooked, waiting = 0, 0, 0
		for _, rod in pairs(rods) do
			out += 1
			if hookedCount(rod) > 0 then
				hooked += 1
			elseif (tonumber(rod.Left) or 0) > 0 then
				waiting += 1
			end
		end
		local baits = {}
		local counts = N.baitCounts()
		for _, b in ipairs(N.baitList()) do
			local n = tonumber(counts[b.key]) or 0
			if n > 0 then
				table.insert(baits, string.format("%s x%d", b.name, n))
			end
		end
		local bowl = bowlSize()
		return string.format("Rods %d / %d out, %d with a bite, %d waiting\nBait: %s\nBowl: %s\nSession: %d casts, %d reels, %d fish collected%s%s", out, N.rodLimit(), hooked, waiting, if #baits > 0 then table.concat(baits, ", ") else "none (the daily Lucky Worm is free, the shop sells bait for Gems)", if bowl > 0 then string.format("%d / %d", bowlCount(f), bowl) else "no bowl yet (Fishing mastery)", F.casts, F.reels, F.collected, if F.lastCatch ~= "" then "\nLast catch: " .. F.lastCatch else "", if F.last ~= "" then "\nLast: " .. F.last else "")
	end

