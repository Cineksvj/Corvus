						hub += seconds
						table.insert(parts, key .. " " .. math.floor(seconds * 1000) .. "ms")
					end
					table.sort(parts)
					local ping, memory, lua, instances = "?", "?", nil, "?"
					local memMb, luaMb = nil, nil
					pcall(function()
						ping = tostring(math.floor(LocalPlayer:GetNetworkPing() * 1000))
					end)
					pcall(function()
						memMb = game:GetService("Stats"):GetTotalMemoryUsageMb()
						memory = tostring(math.floor(memMb))
					end)
					pcall(function()
						luaMb = gcinfo() / 1024
						lua = string.format("%d", math.floor(luaMb))
					end)
					pcall(function()
						instances = tostring(math.floor(game:GetService("Stats"):GetMemoryUsageMbForTag(Enum.DeveloperMemoryTag.Instances)))
					end)
					-- R3-4 / REV-15: the memory growth per hour from the first minute on, measured against the sample 10 minutes
					-- back (or the oldest one while there is no such sample yet; 30 s windows alone were noise)
					Perf.memSamples = Perf.memSamples or {}
					local samples = Perf.memSamples
					if memMb then
						table.insert(samples, { at = os.clock(), mem = memMb, lua = luaMb })
						if #samples > 24 then
							table.remove(samples, 1)
						end
					end
					local ref
					for i = #samples, 1, -1 do
						if os.clock() - samples[i].at >= 600 then
							ref = samples[i]
							break
						end
					end
					ref = ref or samples[1]
					local spanMem = if ref then os.clock() - ref.at else 0
					local hours = spanMem / 3600
					local memPerHour = if ref and memMb and spanMem >= 55 then string.format("%+d", math.floor((memMb - ref.mem) / hours)) else nil
					local luaPerHour = if ref and ref.lua and luaMb and spanMem >= 55 then string.format("%+d", math.floor((luaMb - ref.lua) / hours)) else nil
					Perf.last = { fps = if Perf.time > 0 then Perf.frames / Perf.time else 0, worst = Perf.worst, hitches = Perf.hitches, freezes = Perf.freezes, hub = hub, span = span, ping = ping, memory = memory, memPerHour = memPerHour, lua = lua, luaPerHour = luaPerHour, instances = instances, memSpan = if spanMem >= 55 then spanMem else nil }
					log("PERF", Debug.perfText(), "|", table.concat(parts, ", "))
					Perf.frames, Perf.time, Perf.worst, Perf.hitches, Perf.freezes = 0, 0, 0, 0, 0
					table.clear(Perf.work)
					flushLog(false)
				end
				if os.clock() - versionAt >= 600 then
