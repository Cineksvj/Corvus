	function N.sweepFor(key, finder, cap)
		local started = os.clock()
		local points, seen = {}, {}
		local function add(pos)
			if typeof(pos) == "Vector3" then
				local k = string.format("%d:%d:%d", pos.X // 100, pos.Y // 100, pos.Z // 100)
				if not seen[k] then
					seen[k] = true
					table.insert(points, pos)
				end
			end
		end
		local map = workspace:FindFirstChild("Map1")
		if map then
			for _, c in ipairs(map:GetChildren()) do
				add(N.posOf(c))
			end
		end
		for _, p in ipairs(Landmarks) do
			add(p)
		end
		local here = N.myPos() or Landmarks[1]
		table.sort(points, function(a, b)
			return (a - here).Magnitude < (b - here).Magnitude
		end)
		for i, pos in ipairs(points) do
			if os.clock() - started > (cap or 15) or not alive() then
				break
			end
			N.streamAround(pos, 1)
			local inst = waitFor(function()
				return finder() ~= nil
			end, 0.3) and finder()
			if not inst and i % 3 == 0 then
				N.blink(pos + Vector3.new(0, 4, 0))
				inst = waitFor(function()
					return finder() ~= nil
				end, 0.5) and finder()
			end
			if inst then
				log(string.format("PLACE %s found near landmark %d of %d after %.1fs", key, i, #points, os.clock() - started))
				return inst
			end
		end
		log(string.format("PLACE %s not found near %d landmarks (%.0fs)", key, #points, os.clock() - started))
		return nil
	end
	-- Finds an instance that may not be streamed in yet: as it is, then after asking the server to stream its known spot,
	-- then standing at that spot; with no known spot and `sweep` (main-map things) the landmark sweep. Learns the spot.
	function N.findStreamed(key, finder, wait, sweep)
		local inst = finder()
		if not inst then
			local pos = Places[key]
			if pos then
				N.streamAround(pos)
				inst = waitFor(function()
					return finder() ~= nil
				end, 2) and finder()
				if not inst then
					N.teleport(pos + Vector3.new(0, 4, 0), 0.3)
					inst = waitFor(function()
						return finder() ~= nil
					end, wait or 5) and finder()
				end
			else
				inst = waitFor(function()
					return finder() ~= nil
				end, if sweep then math.min(wait or 5, 1.5) else (wait or 5)) and finder()
				if not inst and sweep then
					inst = N.sweepFor(key, finder, 15)
				end
			end
		end
		if inst then
			N.learnPlace(key, N.posOf(N.standPart(inst) or inst))
		end
		return inst or nil
	end
	-- The BasePart to stand at: the part itself, a child named like the model, or the first part inside (a model's own
	-- pivot can sit far from what it shows: live, the potion trip landed out of reach).
	function N.standPart(inst)
		if not inst then
			return nil
		end
		if inst:IsA("BasePart") then
			return inst
		end
		local named = inst:FindFirstChild(inst.Name, true)
		if named and named:IsA("BasePart") then
			return named
		end
		return inst:FindFirstChildWhichIsA("BasePart", true)
	end

