	-- ===== The daily mine (B13, G5-7; live 11, 13). Its real value is the daily shop (MiningService.RF.DailyBuy(offerId),
	-- DailyShop 3097 L368736-368984: 3 rotating offers + the permanent Gem Shard, each with a Stock per day, priced in mining
	-- coins = Data.Mining.Coins): the worst-case shop costs 59,000 coins a day and the owner holds 671k. So: the shop is
	-- bought remote-only first (PROBE mine_shop_remote), else in one short trip (Crystal Cave -> Enter() inside the portal
	-- box -> DailyBuy -> Leave()); digging only while the balance does not cover today's shop (hard cap 3 min), or the full
	-- milestone run when "Dig for milestones" is on (cap 10 min). Gem offers first (Hoard > Geode > Cluster > Shard), then
	-- the coin offers (their coins land as a windfall the rebirth watcher turns into the next bigger button). Hits(Id, X, Y,
	-- Z) on exposed blocks the pickaxe breaks (the ore map from the game's own MiningConfig), pets mine along. =====
	N.Mine = { lastAt = -1e9, state = nil, hits = 0, broken = 0, throttled = 0, last = "", milestone = 0, shopAt = -1e9 }
	local Mine = N.Mine
	N.onEvent("MiningService.RE.MineReward", function(p)
		if type(p) == "table" and tonumber(p.Milestone) then
			Mine.milestone = math.max(Mine.milestone, p.Milestone)
		end
	end)
	local GemRank = { GemHoard = 1, GemGeode = 2, GemCluster = 3, GemShard = 4, ClickVault = 5, ClickChest = 6, ClickSack = 7, ClickPouch = 8 }
	-- Today's offers that still have stock, best first, and what they cost together.
	function N.mineShopToday()
		local mining = N.sub(N.data(), "Mining")
		local balance = tonumber(mining.Coins) or 0
		local out, need = {}, 0
		if type(W.Daily.Offers) ~= "function" or type(W.Daily.Day) ~= "function" then
			return out, need, balance, 0
		end
		local okDay, day = pcall(W.Daily.Day, N.serverTime())
		day = if okDay and type(day) == "number" then day else 0
		local okOffers, offers = pcall(W.Daily.Offers, day)
		if not okOffers or type(offers) ~= "table" then
			return out, need, balance, day
		end
		for _, o in ipairs(offers) do
			if type(o) == "table" and (o.Kind == "Gems" or o.Kind == "Clicks") and type(o.Id) == "string" then
				local left = 1
				if type(W.Daily.Left) == "function" then
					local okLeft, n = pcall(W.Daily.Left, mining.DailyShop, day, o)
					left = if okLeft and type(n) == "number" and n < math.huge then n else 1
				end
				if left > 0 then
					table.insert(out, { offer = o, left = left })
					need += left * (tonumber(o.Price) or 0)
				end
			end
		end
		table.sort(out, function(a, b)
			return (GemRank[a.offer.Id] or 9) < (GemRank[b.offer.Id] or 9)
		end)
		return out, need, balance, day
	end
	function N.mineDue()
		if not N.islandUnlocked("Crystal Cave") or os.clock() - Mine.lastAt < 600 then
			return false
		end
		local list = N.mineShopToday()
		return #list > 0 or on("MineMilestones")
	end
	-- REV-10: what today's remaining offers are worth in income-seconds: coin offers by MineRewards.Amount (the game's own
	-- price of an offer's Taps at the mine island, 3097 L369653-369714) over the income, gem offers at N.gemWorth.
	function N.mineShopValue(list)
		local data = N.data()
		local value = 0
		for _, item in ipairs(list) do
			local o = item.offer
			local amount = 0
			if data and type(W.MineRewards.Amount) == "function" then
				local okA, a = pcall(W.MineRewards.Amount, data, o.Kind, tonumber(o.Taps) or 0)
				amount = if okA and N.finite(a) then a else 0
			end
			if amount <= 0 and o.Kind == "Clicks" and N.passiveTap then
				amount = (tonumber(o.Taps) or 0) * N.passiveTap()
			end
			local v = if o.Kind == "Gems" then amount * (if N.gemWorth then N.gemWorth() else 0) else N.incomeSeconds(amount)
			value += v * (tonumber(item.left) or 1)
		end
		return value
	end
	-- UI-6: when the hub goes to the shop next.
	function N.mineNextText()
		if not N.islandUnlocked("Crystal Cave") then
			return "Needs Crystal Cave"
		end
		local list, _, _, day = N.mineShopToday()
		if #list == 0 then
			local left = ((tonumber(day) or 0) + 1) * 86400 - N.serverTime()
			return "Today's shop is bought; the next shop day starts in " .. N.longTime(left)
		end
		local wait = Mine.lastAt + 600 - os.clock()
		return "Next shop visit " .. (if wait > 0 then "in " .. N.longTime(wait) else "on the next free trip slot")
	end
	-- Buys what the balance pays for, best first; true when everything affordable was bought.
	local function buyShop(list, balance, day)
		local bought, parts = 0, {}
		for _, item in ipairs(list) do
			local o = item.offer
			for _ = 1, item.left do
				if balance < (tonumber(o.Price) or math.huge) then
					break
				end
				local r = invoke("MiningService.RF.DailyBuy", o.Id)
				if type(r) ~= "table" or r.Error then
					return bought, parts, r
				end
				bought += 1
				balance -= tonumber(o.Price) or 0
				if type(r.Balance) == "number" then
					balance = r.Balance
				end
				local got = type(r.Bought) == "table" and r.Bought or {}
				table.insert(parts, string.format("%s %s %s", o.Id, formatNumber(tonumber(got.Amount) or 0), string.lower(tostring(got.Kind or o.Kind))))
				if o.Kind == "Clicks" then
					-- the coins are a windfall, not income
					N.incomeWindfall(tonumber(got.Amount) or 0)
				end
				task.wait(0.15)
			end
		end
		return bought, parts, nil
	end
	local function frontier(area, removed)
		local w, _, d = W.Mining.Dimensions(area)
		local out = {}
		for x = 0, w - 1 do
			for z = 0, d - 1 do
				local key = W.Mining.Key(x, 0, z)
				if not removed[key] then
					out[key] = Vector3.new(x, 0, z)
				end
			end
		end
		for key in pairs(removed) do
			local a, b, c = string.match(key, "^(%d+):(%d+):(%d+)$")
			local x, y, z = tonumber(a), tonumber(b), tonumber(c)
			if x then
				for _, v in ipairs(W.Mining.Neighbors) do
					local nx, ny, nz = x + v.X, y + v.Y, z + v.Z
					if W.Mining.Valid(area, nx, ny, nz) then
						local k = W.Mining.Key(nx, ny, nz)
						if not removed[k] and not out[k] then
							out[k] = Vector3.new(nx, ny, nz)
						end
					end
				end
			end
		end
		return out
	end
	local function bestCell(area, state, cells, here)
		local tool = W.Mining.Tools[state.Tool] or W.Mining.Tools[1]
		local best, bestScore, bestFar, bestFarScore = nil, -1, nil, -1
		for key, cell in pairs(cells) do
			local okOre, ore, stats = pcall(W.Mining.Ore, state.Seed, cell.X, cell.Y, cell.Z)
			if okOre and type(stats) == "table" and (tonumber(stats.pickaxeRequirement) or 0) <= (tool.Power or 0) then
				local score = (tonumber(stats.value) or 1) / math.max(tonumber(stats.health) or 1, 1)
				local pos = W.Mining.Position(area, cell.X, cell.Y, cell.Z)
				local dist = (pos - here).Magnitude
				if dist <= (tool.Range or 20) - 1 then
					if score > bestScore then
						best, bestScore = { key = key, cell = cell, pos = pos, ore = ore }, score
					end
				elseif score - dist * 0.001 > bestFarScore then
					bestFar, bestFarScore = { key = key, cell = cell, pos = pos, ore = ore }, score - dist * 0.001
				end
			end
		end
		return best, bestFar
	end
	function N.validMineCell(x, y, z)
		return N.isInt(x, 0, 4000) and N.isInt(y, 0, 100) and N.isInt(z, 0, 4000)
	end
	local function dig(state, stopAt, need)
		local area = waitFor(function()
			return W.MineWorld.Marker() ~= nil
		end, 6) and W.MineWorld.Marker()
		if not area or type(W.MineSave.Decode) ~= "function" then
			return state
		end
		local w, h, d = W.Mining.Dimensions(area)
		local removed = W.MineSave.Decode(state.Removed or "", w, h, d)
		local cells = frontier(area, removed)
		local cadence = if N.probeState("mine_rate") == "accepted" then 1 / 12 else nil
		local trial = { sent = 0, throttled = 0, at = os.clock() }
		local moves = 0
		N.loopStatus("Main", "digging in the mine")
		while os.clock() < stopAt and alive() and N.does("AutoMine") do
			if need and (tonumber(state.Balance) or 0) >= need then
				break
			end
			if not need and Mine.milestone >= 4 then
				break
			end
			local root = N.root()
			if not root then
				break
			end
			local target, far = bestCell(area, state, cells, root.Position)
			if not target and far and moves < 150 then
				moves += 1
				N.teleport(far.pos + Vector3.new(0, 4, 0), 0.2)
				continue
			end
			if not target then
				break
			end
			local tool = W.Mining.Tools[state.Tool] or W.Mining.Tools[1] or { Interval = 0.45 }
			local result = invoke("MiningService.RF.Hit", state.Id, target.cell.X, target.cell.Y, target.cell.Z)
			Mine.hits += 1
			trial.sent += 1
			if type(result) == "table" then
				if result.Throttled then
					Mine.throttled += 1
					trial.throttled += 1
				elseif result.Error then
					cells[target.key] = nil
				else
					if type(result.State) == "table" then
						state = result.State
						Mine.state = state
					end
					if result.Broken then
						Mine.broken += 1
						removed[result.Key or target.key] = true
						cells[target.key] = nil
						for _, v in ipairs(W.Mining.Neighbors) do
							local nx, ny, nz = target.cell.X + v.X, target.cell.Y + v.Y, target.cell.Z + v.Z
							if W.Mining.Valid(area, nx, ny, nz) then
								local k = W.Mining.Key(nx, ny, nz)
								if not removed[k] then
									cells[k] = Vector3.new(nx, ny, nz)
								end
							end
						end
						if type(result.Drop) == "table" and result.Drop.Id ~= nil then
							invoke("MiningService.RF.CollectDrop", state.Id, result.Drop.Id)
						end
					end
				end
			end
			if (tonumber(state.Count) or 0) >= (tonumber(state.Capacity) or math.huge) then
				invoke("MiningService.RF.Surface", "Sell")
				task.wait(1)
				local sold = invoke("MiningService.RF.Sell")
				if type(sold) == "table" and type(sold.State) == "table" then
					state = sold.State
				elseif type(sold) == "table" and sold.Count then
					state = sold
				end
				note("mine", "sold the bag")
			end
			-- mine_rate probe: 30 hits at 12/s once per game version; kept when under 10 % are Throttled.
			if N.probeState("mine_rate") == "untested" and trial.sent >= 30 then
				local rejected = trial.throttled / trial.sent > 0.1
				N.probeResult("mine_rate", if rejected then "rejected" else "accepted", string.format("gain=%.1f hits/s throttled=%d/%d", trial.sent / math.max(os.clock() - trial.at, 0.1), trial.throttled, trial.sent))
				cadence = if rejected then nil else 1 / 12
			end
			local pace = cadence or (if N.probeState("mine_rate") == "untested" then 1 / 12 else tool.Interval or 0.45)
			task.wait(pace)
		end
		return state
	end
	function N.mineTrip()
		Mine.lastAt = os.clock()
		local list, need, balance, day = N.mineShopToday()
		local milestones = on("MineMilestones")
		local digNeeded = balance < need
		log(string.format("MINE shop need=%s balance=%s dig=%s offers=%d day=%d", formatNumber(need), formatNumber(balance), if milestones then "milestones" elseif digNeeded then "yes" else "no", #list, day))
		-- Rung 1: the shop by remote, from wherever the player stands.
		if not digNeeded and not milestones and #list > 0 and N.probeState("mine_shop_remote") ~= "rejected" then
			local bought, parts, err = buyShop(list, balance, day)
			if bought > 0 or not err then
				if N.probeState("mine_shop_remote") == "untested" and bought > 0 then
					N.probeResult("mine_shop_remote", "accepted", "gain=no trip (" .. table.concat(parts, ", ") .. ")", "accepted")
				end
				Mine.shopAt = os.clock()
				Mine.last = "daily shop: " .. (if #parts > 0 then table.concat(parts, ", ") else "nothing affordable")
				log("MINE shop day=" .. day .. " bought " .. (if #parts > 0 then table.concat(parts, ", ") else "nothing") .. " (remote)")
				return bought
			end
			N.probeResult("mine_shop_remote", "rejected", "gain=0 (" .. brief(err) .. "), the shop goes through the mine", "rejected")
		end
		if #list == 0 and not milestones then
			return 0
		end
		local portal = W.MineWorld.Portal and W.MineWorld.Portal()
		N.tripBegin("mine", if milestones then 650 elseif digNeeded then 230 else 60)
		N.incomeHold(if milestones then 650 elseif digNeeded then 230 else 60)
		N.loopStatus("Main", "going to the mine")
		if not portal and N.travel("Crystal Cave") then
			portal = waitFor(function()
				return W.MineWorld.Portal() ~= nil
			end, 5) and W.MineWorld.Portal()
		end
		if not portal then
			note("mine", "portal not found on Crystal Cave")
			N.tripEnd()
			return 0
		end
		N.teleport(portal.Position, 0.5)
		local state = invoke("MiningService.RF.Enter")
		if type(state) ~= "table" or state.Error or not state.Id then
			note("mine", "Enter refused: " .. brief(state))
			N.tripEnd()
			return 0
		end
		Mine.state = state
		local hits0, broken0 = Mine.hits, Mine.broken
		if milestones then
			state = dig(state, os.clock() + 600, nil)
		elseif digNeeded then
			state = dig(state, os.clock() + 180, need)
		end
		-- R2-1 (live 18:01 "Visit the Daily Shop by the mine."): the shop sells only on its pad inside the mine,
		-- MiningWorld.Part("Daily") = workspace.MineArea.MiningFacilities.Daily (3097 L370667-370679; the client opens the
		-- shop while OnPad(Daily, 1), L174498-174509).
		local pad = type(W.MineWorld.Part) == "function" and W.MineWorld.Part("Daily")
		if not pad then
			local area = workspace:FindFirstChild("MineArea")
			local facilities = area and area:FindFirstChild("MiningFacilities")
			pad = facilities and facilities:FindFirstChild("Daily")
		end
		if pad and pad:IsA("BasePart") then
			N.teleport(pad.Position + Vector3.new(0, pad.Size.Y / 2 + 3, 0), 0.3)
		else
			log("MINE daily shop pad not found, buying from where the mine put us")
		end
		local bought, parts, err = buyShop(list, tonumber(state.Balance) or balance, day)
		if err then
			log("MINE shop refused:", brief(err))
		end
		invoke("MiningService.RF.Leave")
		Mine.shopAt = os.clock()
		Mine.last = string.format("%d hits, %d blocks, shop: %s", Mine.hits - hits0, Mine.broken - broken0, if #parts > 0 then table.concat(parts, ", ") else "nothing affordable")
		log("MINE shop day=" .. day .. " bought " .. (if #parts > 0 then table.concat(parts, ", ") else "nothing") .. string.format(" (trip, %d hits, %.0fs)", Mine.hits - hits0, os.clock() - N.Trip.since))
		N.tripEnd()
		return bought
	end
	function N.validDailyOffer(id)
		return type(id) == "string" and N.tableOr(W.Daily.ById)[id] ~= nil
	end

	-- ===== Pet Defense (B12, G5-5; live 6, 19). ColosseumService: StartWaveDefense() inside the entrance
	-- (ColosseumWorld.GetEntrance), AttackOpponent(id) / CriticalAttackOpponent(id), ReturnFromArena(),
	-- ClaimMinigameReward("keep"|"replace"). The shared ColosseumRun (3097 L367430-367491) rejects a normal attack sooner
	-- than ClickCooldown 0.2 - grace 0.08 = 0.12 s after the last ACCEPTED one (server clock), an attack on an opponent that
	-- already arrived, and attacks while an upgrade offer is open; a critical needs charge 100 (+7 per accepted hit, +12 per
	-- defeat) and 4 s since the last one, and does not touch the normal lane: it runs in parallel. Cadence adaptive from
	-- 0.13 s (+0.01 after an unexplained rejection, -0.005 after 50 accepted in a row, floor 0.121, cap 0.16); PROBE
	-- colosseum_cadence logs the accepted rate once 200 attacks were sent. Target: the opponent that arrives first. The run is
	-- planned only while a better relic can come out of it (RelicTierWeights at the best wave, L371911-371945, relic boosts
	-- ColosseumRelicConfig L366818-366917, current relic Data.Colosseum.Relic); the reward replaces the relic only when it
	-- scores higher. Afterwards the wave HUD is closed (L33354-33370). OpponentReachedEnd and the absent
	-- ChooseColosseumUpgrade are never sent. =====
	N.Arena = { active = false, opponents = {}, charge = 0, lastCrit = -1e9, waves = 0, last = "", nextAt = 0, offerAt = nil, cadence = 0.13, waveLogged = false, progressAt = 0 }
	local Arena = N.Arena
	local WaveCfg = N.tableOr(N.safeRequire("Shared.Minigames.WaveDefenseConfig"))
	local RelicCfg = N.tableOr(N.safeRequire("Shared.Minigames.ColosseumRelicConfig"))
	do
		local saved = tonumber(N.probeState("colosseum_cadence"))
