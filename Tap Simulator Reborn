		log("WORLD", key, text)
	end
	local function eventActive(name)
		return workspace:GetAttribute("Event_" .. name .. "_Active") == true
	end
	N.eventActive = eventActive
	-- strategy.md items 3+4: the windows during which the luck / secret-luck items (potions, totems, Acid dial) should go up
	-- now, because they multiply every luck and secret band (Lucky Skies / Blessed Winds / Windy Day / Blood Rain / Phantom
	-- Fog all stack with the scheduled Luck and Mythic windows).
	local LuckWindows = { "Luck", "Mythic", "PhantomFog", "LuckySkies", "BlessedWinds", "WindyDay", "BloodRain", "Acid" }
	function N.luckWindowNow()
		for _, name in ipairs(LuckWindows) do
			if eventActive(name) then
				return true, name
			end
		end
		return false
	end

	-- ===== Potions (BoostConfig 364892-365018; owned in Data.Boosts[name], running in Data.ActiveBoosts[name] seconds):
	-- BoostService.RF.Use(name) (162087). Coins I + II add (+65 %), Luck I + II (+30 % luck), Gems I + II (+125 % rebirth
	-- gems); the Octo Incubator gives x8 hatches for 15 min. The planner keeps the Luck potions for the game's Luck / Mythic
	-- windows (Event_Luck_Active, every 600 s for 60 s) when the next one starts within 10 minutes. =====
	local function owned(name)
		local v = N.sub(N.data(), "Boosts")[name]
		return if type(v) == "number" and v >= 1 then math.floor(v) else 0
	end
	local function running(name)
		local v = N.sub(N.data(), "ActiveBoosts")[name]
		return type(v) == "number" and v > 5
	end
	-- B16: a potion is drunk again when 30 s or less are left (drinking adds its time, BoostService.RF.Use answers TimeLeft),
	-- so Coins I + II never run out.
	local function runningLong(name)
		local v = N.sub(N.data(), "ActiveBoosts")[name]
		return type(v) == "number" and v > 30
	end
	N.potionOwned, N.potionRunning = owned, running
	function N.validPotion(name)
		local defs = N.tableOr(W.Boosts.Definitions)
		local def = type(name) == "string" and defs[name]
		return type(def) == "table" and (def.Type == "Coins" or def.Type == "Luck" or def.Type == "Gems" or def.Type == "OctoHatch") and owned(name) >= 1
	end
	function N.drinkStep()
		local wanted = {}
		if N.does("AutoTap") then
			table.insert(wanted, "Coins Potion I")
			table.insert(wanted, "Coins Potion II")
		end
		if N.hatchWanted() then
			local nextLuck = tonumber(workspace:GetAttribute("Event_Luck_NextStartAt"))
			-- strategy.md items 3+4: pop the luck potions now when any luck/secret window is live (they multiply the bands);
			-- only hold them (planner) when none is live and a scheduled Luck window starts within 10 min
			local holdForEvent = N.planner() and not N.luckWindowNow() and nextLuck and nextLuck - N.serverTime() < 600
			if not holdForEvent then
				table.insert(wanted, "Luck Potion I")
				table.insert(wanted, "Luck Potion II")
			end
			if not N.hasX8() then
				table.insert(wanted, "Octo Incubator")
			end
		end
		-- strategy.md item 4: Sunny Fortune doubles rebirth gems, so drink the Gems potions during it even without Auto Rebirth
		if N.does("AutoRebirth") or eventActive("SunnyFortune") then
			table.insert(wanted, "Gems Potion I")
			table.insert(wanted, "Gems Potion II")
		end
		for _, name in ipairs(wanted) do
			if owned(name) >= 1 and not runningLong(name) and os.clock() - (N.World.at["drink " .. name] or -1e9) > 60 then
				local result = invoke("BoostService.RF.Use", name)
				if ok(result) then
