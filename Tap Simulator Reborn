	-- in the Logbook). Portrait keeps the tab bar as its own row under the topbar.
	local LAND_LEFT_W = 96
	local LAND_RIGHT_W = WIN_BTN * 4 + 8 * 3
	local touchLandscape = nil
	applyTouchRows = function(landscape)
		if not touch then return end
		landscape = landscape == true
		if touchLandscape == landscape then return end
		touchLandscape = landscape
		local barH = landscape and 0 or TAB_BAR_H
		content.Size = UDim2.new(1, -(SIDEBAR_W + PAD * 2), 1, -(HEADER_H + barH + BOTTOM_H + PAD * 2))
		content.Position = UDim2.new(0, SIDEBAR_W + PAD, 0, HEADER_H + barH + PAD)
