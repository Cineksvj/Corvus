		local circle = model and model:FindFirstChild("Circle")
		if circle and circle:IsA("BasePart") then
			return circle.Position + Vector3.new(0, 3, 0)
		end
		local part = model and N.standPart(model)
		return part and part.Position + Vector3.new(0, 3, 4)
	end
	function N.potionTripDone()
		-- a visit that ended on TooFar is tried again in a minute, not in 10
		N.World.at.potionTrip = os.clock() - (if N.World.potionRetry then 540 else 0)
		N.World.potionRetry = false
	end
	-- One visit's calls (or the remote try): every call counts only when the server says Success; 0.5 s between calls and
	-- one retry after RateLimited (REV-7, N.pacedInvoke); TooFar or a second RateLimited ends the visit.
	local function machineCalls(work, remote)
		local stop, far = false, false
		local function call(name, ...)
			if stop then
				return nil
			end
			local result = N.pacedInvoke(name, ...)
			if type(result) == "table" and (result.Error == "TooFar" or N.rateLimited(result)) then
				stop = true
				far = result.Error == "TooFar"
				if not (remote and far) then
					log("POTION machine stopped:", tostring(result.Error or result.Reason))
				end
			end
			return if ok(result) then result else nil
		end
		local r = { done = 0, claimed = nil, bought = 0, brewed = 0, merged = 0 }
		r.claimed = work.claim and call("PotionMachineService.RF.ClaimAll") or nil
		if r.claimed then
			-- R13 (OWNER_RULES 24): counted when no finished slot is left in Data.PotionMachine.Slots
			local cleared = waitFor(function()
				local now = os.time()
				for _, s in pairs(N.sub(N.sub(N.data(), "PotionMachine"), "Slots")) do
					if type(s) == "table" and tonumber(s.ReadyAt) and s.ReadyAt <= now then
						return false
					end
				end
				return true
			end, 2)
			if cleared then
				r.done += 1
				log(string.format("POTION claimed %s brewed potions ok", tostring(r.claimed.Amount or "?")))
			else
				log("CLAIM potion brews FAILED answer=" .. brief(r.claimed) .. " (a finished slot is still there)")
				r.claimed = nil
			end
		elseif work.claim and not stop then
			log("CLAIM potion brews FAILED answer=no Success from ClaimAll")
		end
		for _, n in ipairs(work.buy) do
			local result = call("PotionMachineService.RF.Buy", n)
			if result then
				r.done += 1
				r.bought += 1
				log(string.format("POTION machine bought pack of %d -> %s", n, brief(result.Rewards or result)))
			end
		end
		for _, b in ipairs(work.brew) do
			if call("PotionMachineService.RF.Brew", b.potion, b.slot) then
				r.done += 1
				r.brewed += 1
				log(string.format("POTION brew %s slot %d/%d", b.potion, b.slot, tonumber(W.Brew.SlotCount) or 3))
			end
		end
		if r.brewed > 0 then
			log(string.format("POTION brewed %s x%d price %s gems", work.brew[1].potion, r.brewed, formatNumber((work.price1 or 0) * r.brewed)))
		end
		for _, c in ipairs(work.craft) do
			if call("PotionMachineService.RF.Craft", c.output, c.amount) then
				r.done += 1
				r.merged += 1
				log(string.format("POTION merge %s x%d", c.output, c.amount))
			end
		end
		return r, far
	end
	-- UI-7: the machine in plain words (what brews and when it is ready, what the last visit did).
	function N.potionMachineText()
		local slots = N.sub(N.sub(N.data(), "PotionMachine"), "Slots")
		local now = os.time()
		local names, ready, soonest = {}, 0, math.huge
		for i = 1, tonumber(W.Brew.SlotCount) or 3 do
			local s = slots[tostring(i)]
			if type(s) == "table" then
				local at = tonumber(s.ReadyAt) or 0
				if at <= now then
					ready += 1
				else
					soonest = math.min(soonest, at - now)
					local name = tostring(s.Name or s.Potion or "potion")
					names[name] = (names[name] or 0) + 1
				end
			end
		end
		local parts = {}
		for name, n in pairs(names) do
			table.insert(parts, name .. (if n > 1 then " x" .. n else ""))
		end
		table.sort(parts)
		local text = if #parts > 0 then "brewing " .. table.concat(parts, ", ") .. " (ready in " .. N.longTime(soonest) .. ")" else "no brew running"
		if ready > 0 then
			text ..= string.format(", %d ready to claim", ready)
		end
		local last = N.World.last.potionMachine
		return text .. (if last then "\nLast visit: " .. last else "")
	end
	local function visitText(r, how)
		local parts = {}
		if r.claimed then
			table.insert(parts, "claimed the brews")
		end
		if r.bought > 0 then
			table.insert(parts, string.format("bought %d pack%s", r.bought, if r.bought == 1 then "" else "s"))
		end
		if r.brewed > 0 then
			table.insert(parts, string.format("started %d brew%s", r.brewed, if r.brewed == 1 then "" else "s"))
		end
		if r.merged > 0 then
			table.insert(parts, string.format("merged %d", r.merged))
		end
		return (if #parts > 0 then table.concat(parts, ", ") else "nothing to do") .. " (" .. how .. ")"
	end
	function N.potionTrip(claimOnly)
		claimOnly = claimOnly == true
		local work = N.potionWork(claimOnly)
		if not work then
			return 0
		end
		-- REV-13 PROBE potion_buy_far: the calls from where the player stands; accepted = the machine needs no trip
		local state = N.probeState("potion_buy_far")
		if state ~= "rejected" then
			local r, far = machineCalls(work, true)
			if r.done > 0 then
				if state == "untested" then
					N.probeResult("potion_buy_far", "accepted", "gain=no trip (" .. visitText(r, "remote") .. ")")
				end
				N.World.last.potionMachine = visitText(r, "from where you stand")
				return r.done
			end
			if far and state == "untested" then
				N.probeResult("potion_buy_far", "rejected", "gain=0 (TooFar): the machine is visited")
			end
		end
		N.tripBegin("potions")
		waitFor(function()
			return not N.Hatch.inFlight
		end, 4)
		N.loopStatus("Main", "at the potion machine")
		local done = 0
		if N.travel("Spawn") then
			-- R2-10/R2-12: the machine streams in near (-353.6, -519.5, -4732); R4-3: the stand is the middle of its Circle
			local model = N.findStreamed("PotionMachine", potionMachine, 5, true)
			local stand = model and (waitFor(function()
				return model:FindFirstChild("Circle") ~= nil
			end, 1) or true) and potionStand(model)
			if stand then
				N.teleport(stand, 0.4)
				local r, far = machineCalls(work, false)
				if far then
					-- R4-3: stand on the Circle once more and finish the visit (claim, buy, brew) before going back
					N.teleport(potionStand(model) or stand, 0.8)
					local again = N.potionWork(claimOnly)
					if again then
						local r2
						r2, far = machineCalls(again, false)
						r.done += r2.done
						r.claimed = r.claimed or r2.claimed
						r.bought += r2.bought
						r.brewed += r2.brewed
						r.merged += r2.merged
					end
				end
				done = r.done
				N.World.potionRetry = far and done == 0
				N.World.last.potionMachine = visitText(r, "at the machine")
				if far then
					log(string.format("POTION machine still TooFar standing at %s (Circle %s), next try in 1 min", brief(N.myPos() or stand), if model:FindFirstChild("Circle") then "yes" else "no"))
				end
			else
				log("POTION machine not found near the spawn")
			end
		end
		N.tripEnd()
		return done
	end

	-- ===== World events (WorldEventConfig 90580-90993, GlobalEventSchedule 90356-90387) =====
	-- Balloons (BalloonPartyService.RE.Hit(Uid), HitRange 150, 0.1 s per balloon) and pigs (PigsCouldFlyService.RE.Hit(Uid),
	-- HitRange 120, 0.5 s per pig) fly around the player: hit by uid from the event loop, no movement. probes
	-- balloon_parallel / pig_instant: several balloons in the same 0.1 s window, a pig hit right after it launches.
	N.Sky = { balloons = {}, pigs = {}, popped = 0, caught = 0, parallelSeen = false, pigFast = 0 }
	local Sky = N.Sky
	-- R7-1: the launch records end with their flight also while Auto Balloons / Auto Pigs are off (skyStep prunes them only
	-- while the toggle runs; the game launches them all day)
	local function pruneSky(list, maxAge)
		local now = os.clock()
		for uid, b in pairs(list) do
			if now - b.at > maxAge then
				list[uid] = nil
			end
		end
	end
	N.onEvent("BalloonPartyService.RE.Launched", function(p)
		if type(p) == "table" and type(p.Uid) == "string" and not string.find(p.Uid, "[\128-\255]") then
			pruneSky(Sky.balloons, 27)
			Sky.balloons[p.Uid] = { at = os.clock(), last = -1e9, hits = 0 }
		end
	end)
	N.onEvent("BalloonPartyService.RE.Popped", function(uid)
		if type(uid) == "table" then
			uid = uid.Uid
		end
		if Sky.balloons[uid] then
			Sky.balloons[uid] = nil
			Sky.popped += 1
		end
	end)
	N.onEvent("PigsCouldFlyService.RE.Launched", function(p)
		if type(p) == "table" and type(p.Uid) == "string" and not string.find(p.Uid, "[\128-\255]") then
			pruneSky(Sky.pigs, 42)
			Sky.pigs[p.Uid] = { at = os.clock(), last = -1e9 }
		end
	end)
	N.onEvent("PigsCouldFlyService.RE.Caught", function(uid, userId)
		if type(uid) == "table" then
			uid, userId = uid.Uid, uid.UserId
		end
		local pig = Sky.pigs[uid]
		if pig then
			Sky.pigs[uid] = nil
			if userId == LocalPlayer.UserId then
				Sky.caught += 1
				if N.probeState("pig_instant") == "untested" then
					if os.clock() - pig.at < 1 then
						N.probeResult("pig_instant", "accepted", string.format("gain=caught %.1fs after launch", os.clock() - pig.at))
					elseif (pig.firstHitAt or 9) < 1 and (pig.hits or 0) >= 2 then
						-- the first hit (under 1 s after the launch) did not count, a later one did
						N.probeResult("pig_instant", "rejected", string.format("gain=0 (caught on hit %d, %.1fs after launch)", pig.hits, os.clock() - pig.at))
					end
				end
			end
		end
	end)
	N.onEvent("PigsCouldFlyService.RE.Retired", function(uid)
		if type(uid) == "table" then
			uid = uid.Uid
		end
		Sky.pigs[uid] = nil
	end)
	function N.knownBalloon(uid)
		return type(uid) == "string" and Sky.balloons[uid] ~= nil
	end
	function N.knownPig(uid)
		return type(uid) == "string" and Sky.pigs[uid] ~= nil
	end
	-- One pass of the sky collectors (called every 0.1 s by the event loop); at most 20 hits a pass (flood limit 40/s).
	function N.skyStep()
		local now = os.clock()
		local sent = 0
		if N.does("AutoBalloons") then
			local sameWindow = 0
			-- REV-13 fallback: when several balloons hit in the same 0.1 s window did not pop (balloon_parallel rejected), one
			-- balloon per window
			local perWindow = if N.probeState("balloon_parallel") == "rejected" then 1 else 20
			for uid, b in pairs(Sky.balloons) do
				if now - b.at > 27 then
					Sky.balloons[uid] = nil
				elseif now - b.last >= 0.1 and sent < perWindow then
					b.last = now
					b.hits += 1
					sent += 1
					sameWindow += 1
					fire("BalloonPartyService.RE.Hit", uid)
				end
			end
			if sameWindow >= 2 and not Sky.parallelSeen then
				Sky.parallelSeen = true
				Sky.parallelAt = now
				Sky.poppedBefore = Sky.popped
			end
			if Sky.parallelAt and now - Sky.parallelAt > 10 and N.probeState("balloon_parallel") == "untested" then
				local gain = Sky.popped - (Sky.poppedBefore or 0)
				N.probeResult("balloon_parallel", if gain >= 2 then "accepted" else "rejected", "gain=" .. gain .. " balloons in 10 s")
				Sky.parallelAt = nil
			end
		end
		if N.does("AutoPigs") then
			-- REV-13: pig_instant rejected (a hit right after the launch did not catch the pig, a later one did): the first hit
			-- waits 1 s after the launch
			local firstAfter = if N.probeState("pig_instant") == "rejected" then 1 else 0
			for uid, pig in pairs(Sky.pigs) do
				if now - pig.at > 42 then
					Sky.pigs[uid] = nil
				elseif now - pig.last >= 0.5 and now - pig.at >= firstAfter and sent < 20 then
					pig.last = now
					pig.hits = (pig.hits or 0) + 1
					if pig.hits == 1 then
						pig.firstHitAt = now - pig.at
					end
					sent += 1
					fire("PigsCouldFlyService.RE.Hit", uid)
				end
			end
		end
		return sent
	end
	-- Cloud Rain (every 1800 s for 120 s): 36 pickups (WorldEventConfig CloudRain MaxPickups 36, PickupSize 6, HoverHeight
	-- 5, 3097 L90320-90350) tagged CloudRainPickup (attributes Uid, Kind) on the cloud pieces of CloudRoute, CloudGeneration
	-- and the islands, collected by touch on the server; RF.GetCollected() lists mine (CloudRain controller 246210-246325).
	-- REV-6 (live `WORLD cloudRain 7 pickups in 2s`): with StreamingEnabled only the pickups near the character exist on the
	-- client, so the trip collects what it sees (nearest first, CFrame onto each), then sweeps the cloud route (streamed
	-- cloud pieces, then the column above the spawn up to the highest island) and collects what streams in, until the
	-- event ends or every pickup is mine. PROBE cloud_touch_all: one touch per pickup counts (accepted) or each needs the
	-- step-through fallback (rejected: every pickup is stepped through from four sides).
	N.Cloud = { mine = {}, got = 0, events = {}, total = tonumber(N.tableOr(W.Events.Cloud).MaxPickups) or 36 }
	N.onEvent("CloudRainService.RE.Collected", function(uid, info)
		if type(uid) == "string" then
			if not N.Cloud.mine[uid] then
				N.Cloud.mineCount = (N.Cloud.mineCount or 0) + 1
			end
			N.Cloud.mine[uid] = true
			N.Cloud.got += 1
			if type(info) == "table" and N.finite(tonumber(info.Coins)) then
				N.incomeWindfall(tonumber(info.Coins))
			end
		end
	end)
	local CollectionService = game:GetService("CollectionService")
	function N.cloudPickups(skip)
		local out = {}
		for _, p in ipairs(CollectionService:GetTagged("CloudRainPickup")) do
			local uid = p:GetAttribute("Uid")
			if p:IsA("BasePart") and type(uid) == "string" and not N.Cloud.mine[uid] and not (skip and skip[uid]) then
				table.insert(out, p)
			end
		end
		return out
	end
	local function cloudKey()
		return tostring(workspace:GetAttribute("Event_CloudRain_EndsAt") or workspace:GetAttribute("Event_CloudRain_NextStartAt") or "now")
	end
	-- Something to collect: pickups in sight, or a running Cloud Rain this trip has not finished.
	function N.cloudDue()
		local st = N.Cloud.events[cloudKey()]
		if #N.cloudPickups(st and st.skip) > 0 then
			return true
		end
		return eventActive("CloudRain") and not (st and st.done)
	end
	-- Where the pickups can be: the cloud pieces that are streamed in (one point per 150 studs), then a column from the
	-- spawn up to the highest island known, every 300 studs; nearest first.
	local function cloudSweepPoints()
		local pts, seen = {}, {}
		local function add(pos)
			if typeof(pos) ~= "Vector3" then
				return
			end
			local key = string.format("%d:%d:%d", pos.X // 150, pos.Y // 150, pos.Z // 150)
			if not seen[key] then
				seen[key] = true
				table.insert(pts, pos)
			end
		end
		for _, rootName in ipairs({ "CloudRoute", "CloudGeneration" }) do
			local folder = workspace:FindFirstChild(rootName)
			if folder then
				local n = 0
				for _, d in ipairs(folder:GetDescendants()) do
					if d:IsA("BasePart") and not CollectionService:HasTag(d, "CloudRainPickup") then
						add(d.Position + Vector3.new(0, 5, 0))
						n += 1
						if n > 400 then
							break
						end
					end
				end
			end
		end
		local base = (N.place and N.place("HubSpawn")) or Vector3.new(-50.1, -515.9, -1868.6)
		local top = base.Y + 8200
		for _, key in ipairs({ "TapChestDesert", "TapChestSkyIsland" }) do
			local p = N.place and N.place(key)
			if p then
				top = math.max(top, p.Y + 300)
			end
		end
		for y = base.Y + 300, top, 300 do
			add(Vector3.new(base.X, y, base.Z))
		end
		local here = N.myPos() or base
		table.sort(pts, function(a, b)
			return (a - here).Magnitude < (b - here).Magnitude
		end)
		return pts
	end
	N.cloudSweepPoints = cloudSweepPoints
	function N.cloudTrip()
		local key = cloudKey()
		local st = N.Cloud.events[key]
		if not st then
			st = { got = 0, seen = {}, skip = {}, done = false, synced = false }
			N.Cloud.events[key] = st
			-- one record per event (the last few kept)
			local n = 0
			for _ in pairs(N.Cloud.events) do
				n += 1
			end
			if n > 6 then
				table.clear(N.Cloud.events)
				N.Cloud.events[key] = st
			end
			-- R7-1: the uids of the older events go too (36 an event, every 30 minutes, never needed again)
			if (N.Cloud.mineCount or 0) > 300 then
				table.clear(N.Cloud.mine)
				N.Cloud.mineCount = 0
			end
		end
		if not N.cloudDue() then
			return 0
		end
		N.tripBegin("cloud rain")
		N.incomeHold(120)
		N.loopStatus("Main", "collecting Cloud Rain pickups")
		if not st.synced then
			st.synced = true
			local mine = invoke("CloudRainService.RF.GetCollected")
			if type(mine) == "table" then
				for _, uid in ipairs(mine) do
					N.Cloud.mine[tostring(uid)] = true
				end
			end
		end
		local got0 = N.Cloud.got
		local started = os.clock()
		local fast = N.probeState("cloud_touch_all") ~= "rejected"
		local touched, firstTry = 0, 0
		-- R5-3 (live: `PROBLEM trip cloud rain over cap (140s, cap 110s)`): the trip ends by itself 8 s before its cap, counted
		-- from the trip start (the GetCollected call included), and says so; every step inside is bounded (streamAround)
		local deadline = N.Trip.since + math.min((N.Trip.cap or 110) - 8, 100)
		local capped = false
		local function inTime()
			if os.clock() >= deadline then
				capped = true
				return false
			end
			return alive()
		end
		local function collectVisible()
			while inTime() do
				local list = N.cloudPickups(st.skip)
				if #list == 0 then
					return
				end
				local here = N.myPos()
				local p = list[1]
				if here then
					local best = math.huge
					for _, x in ipairs(list) do
						local d = (x.Position - here).Magnitude
						if d < best then
							p, best = x, d
						end
					end
				end
				local uid = p:GetAttribute("Uid")
				st.seen[uid] = true
				touched += 1
				N.blink(p.Position + Vector3.new(0, 1, 0))
				local got = waitFor(function()
					return N.Cloud.mine[uid] == true
				end, if fast then 0.6 else 0.3)
				if got then
					firstTry += 1
				else
					-- the fallback: step through the pickup from four sides, then give it up for this event
					N.portalNudge(p.Position)
					got = waitFor(function()
						return N.Cloud.mine[uid] == true
					end, 0.6)
					if not got then
						st.skip[uid] = true
					end
				end
			end
		end
		collectVisible()
		local swept = 0
		for _, pos in ipairs(cloudSweepPoints()) do
			if not inTime() or (not eventActive("CloudRain") and #N.cloudPickups(st.skip) == 0 and swept > 0) then
				break
			end
			if st.got + (N.Cloud.got - got0) >= N.Cloud.total then
				break
			end
			swept += 1
			N.streamAround(pos, 1)
			N.blink(pos)
			waitFor(function()
				return #N.cloudPickups(st.skip) > 0
			end, 0.6)
			collectVisible()
		end
		local got = N.Cloud.got - got0
		st.got += got
		local seen = 0
		for _ in pairs(st.seen) do
			seen += 1
		end
		st.done = st.got >= N.Cloud.total or not eventActive("CloudRain") or not inTime()
		if capped then
			note("cloudRain", string.format("%d/%d pickups, cap reached (%d this trip, %d seen, %d sweep points, %.0fs)", st.got, N.Cloud.total, got, seen, swept, os.clock() - N.Trip.since))
		else
			note("cloudRain", string.format("%d/%d (%d this trip, %d seen, %d sweep points, %.0fs)", st.got, N.Cloud.total, got, seen, swept, os.clock() - started))
		end
		if N.probeState("cloud_touch_all") == "untested" and touched >= 10 then
			N.probeResult("cloud_touch_all", if firstTry >= touched * 0.8 then "accepted" else "rejected", string.format("gain=%d/%d pickups on the first touch", firstTry, touched))
		end
		N.tripEnd()
		return got
	end
	-- Meteors (MeteorShowerService.RE.Incoming(id, position, kind, start, travel), lands at start + travel) and the
	-- Mystery Egg (EggDropService.RE.Incoming(id, island, position, start, travel); RF.Travel() = the game's free teleport
	-- to it; 60 hits per player) are breakables: taps within 14 studs hit them (BreakableConfig TapRange 14).
	N.Rocks = { list = {}, eggs = {}, meteorPaid = 0, meteorCoins = 0, eggPaid = 0, eggCoins = 0, eggAt = -1e9, meteorAt = -1e9 }
	-- R13 (OWNER_RULES 24): a hit is not a reward. The server pays a broken rock / the cracked Mystery Egg with
	-- MeteorShowerService.RE.Rewarded({Coins, Gems, Tier, Item}) (MeteorShowerEffects bc 159295-159336) and
	-- EggDropService.RE.Rewarded({Coins}, drop) (EggDropEffects bc 144129-144151); the trips count those, not their taps.
	N.onEvent("MeteorShowerService.RE.Rewarded", function(p)
		if type(p) == "table" then
			N.Rocks.meteorPaid += 1
			N.Rocks.meteorCoins += tonumber(p.Coins) or 0
			N.Rocks.meteorAt = os.clock()
		end
	end)
	N.onEvent("EggDropService.RE.Rewarded", function(p)
		if type(p) == "table" then
			N.Rocks.eggPaid += 1
			N.Rocks.eggCoins += tonumber(p.Coins) or 0
			N.Rocks.eggAt = os.clock()
		end
	end)
	N.onEvent("MeteorShowerService.RE.Incoming", function(id, pos, kind, start, travel)
		if typeof(pos) == "Vector3" and type(start) == "number" and type(travel) == "number" then
			table.insert(N.Rocks.list, { id = tostring(id), pos = pos, kind = tostring(kind), landAt = start + travel, at = os.clock() })
