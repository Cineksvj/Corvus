	-- a Main turn outside the trips), never the Status text (live: "Stuck for 10 minutes on: collecting Cloud Rain
	-- pickups" 7 minutes after that trip had been ended).
	local StuckWatch = { at = -1e9, tapSince = nil }
	function N.stuckCheck()
		local now = os.clock()
		if not anyAutoOn() or N.Manual.running or N.Trip.active then
			return nil
		end
		local H = N.Hatch
		local what = nil
		if N.does("AutoTap") then
			StuckWatch.tapSince = StuckWatch.tapSince or now
		else
			StuckWatch.tapSince = nil
		end
		local hatchQuiet = now - math.max(H.lastOkAt, HatchWatch.since or now, N.Trip.endedAt)
		local tapQuiet = if StuckWatch.tapSince then now - math.max(N.Tap.resultAt or -1e9, StuckWatch.tapSince, N.Trip.endedAt) else 0
		local mainQuiet = now - (N.LoopBeat.Main or now)
		if N.hatchWanted() and H.target and not N.storageFull() and N.hatchCount(H.target) > 0 and hatchQuiet > 600 then
			what = "no hatch for " .. N.longTime(hatchQuiet)
		elseif StuckWatch.tapSince and not N.tapBlocked() and tapQuiet > 600 then
			what = "no tap answer for " .. N.longTime(tapQuiet)
		elseif mainQuiet > 600 then
			what = "no Main loop turn for " .. N.longTime(mainQuiet)
		end
		if what and now - StuckWatch.at > 600 then
			StuckWatch.at = now
			logProblem("Stuck for 10 minutes: " .. what .. " (now: " .. tostring(Status) .. ")")
		end
		return what
	end
