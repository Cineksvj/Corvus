-- Old names stay so widgets keep working; the values swap to the new direction.
local Palette = {
    RavenVoid      = Color3.fromHex("#101114"),   -- window backdrop
    Surface        = Color3.fromHex("#1A1C21"),   -- panel / groupbox fill
    RavenSlate     = Color3.fromHex("#23262C"),   -- well
    RavenAsh       = Color3.fromHex("#2A2E35"),   -- well hover
    RavenOutline   = Color3.fromHex("#2D3139"),   -- hairline
    SilverSmoke    = Color3.fromHex("#8A8F99"),   -- secondary text
    SilverBrushed  = Color3.fromHex("#6A6F78"),   -- muted
    SilverMoon     = Color3.fromHex("#FFFFFF"),   -- bright
    SilverInk      = Color3.fromHex("#F2F3F5"),   -- body text
    DiscordWhisper = Color3.fromHex("#4ADE80"),   -- bottom-bar emerald dot
    SignalGreen    = Color3.fromHex("#D5D8DE"),   -- "live" delta uses the silver accent
    SignalAmber    = Color3.fromHex("#D5D8DE"),   -- current-marker on charts: same accent
    SignalRed      = Color3.fromHex("#F87171"),
    Accent         = Color3.fromHex("#D5D8DE"),   -- silver
    AccentHi       = Color3.fromHex("#F2F3F5"),
    AccentDim      = Color3.fromHex("#9AA0AA"),
}

-- metal: white -> cool silver gradient for the hero numeral; still mostly flat.
local MetalSequence = ColorSequence.new({
    ColorSequenceKeypoint.new(0.00, Color3.fromHex("#FFFFFF")),
    ColorSequenceKeypoint.new(1.00, Color3.fromHex("#C9CDD4")),
})

local function themeMetal()
    local T = rawget(_G, "CorvusLibrary") or rawget(_G, "Library")
    if T and T.Theme and T.Theme.Metal then
        return T.Theme.Metal
    end
    return MetalSequence
end

local function themeColor(name, fallback)
    local T = rawget(_G, "CorvusLibrary") or rawget(_G, "Library")
    if T and T.Theme and T.Theme[name] then
        return T.Theme[name]
    end
    return fallback
end

-- ------------------------------------------------------------
-- Font helpers (Michroma for display, BuilderSans for UI, RobotoMono for digits)
-- Pre-build Font instances once; falling back to Enum fonts if missing.
-- ------------------------------------------------------------
local function safeFont(assetId, weight, style)
    local ok, result = pcall(function()
        return Font.new(assetId, weight or Enum.FontWeight.Regular, style or Enum.FontStyle.Normal)
    end)
    if ok and result then return result end
    return Font.fromEnum(Enum.Font.Gotham)
end

-- Farm 2026-10-20: one family (BuilderSans). The old Oswald / Michroma / Mono names stay
-- as aliases so the widget code below needs no changes; they all point at BuilderSans weights.
local Fonts = {
    Oswald       = safeFont("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Medium),
    OswaldMed    = safeFont("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold),
    OswaldBold   = safeFont("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold),
    BuilderReg   = safeFont("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Regular),
    BuilderMed   = safeFont("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Medium),
    BuilderBold  = safeFont("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold),
