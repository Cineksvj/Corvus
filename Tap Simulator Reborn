				end
			end
		end
	end
	-- R13: the game's own item menu opens ONE gift per call (GiftController:Open(k, 1), bc 52533-52535); a batch the server
	-- refuses falls back to one at a time for that gift (remembered for the session). Counted on the server's Success AND
	-- the gift count going down.
	N.GiftSingle = {}
	function N.giftStep()
		if due("gifts", 20) then
			for name in pairs(N.tableOr(N.G.Gifts.Pools)) do
				local count = N.itemCount(name)
				-- The Release Gift opens only at its release time (OriginalItemCatalog UnlocksAt, 366458-366464).
				local def = N.tableOr(N.G.Items)[name]
				local unlocksAt = type(def) == "table" and tonumber(def.UnlocksAt) or 0
				if count > 0 and type(name) == "string" and not string.find(name, "[\128-\255]") and N.serverTime() >= unlocksAt then
					local amount = if N.GiftSingle[name] then 1 else math.min(count, 25)
					local result = invoke("GiftService.RF.OpenGift", { Gift = name, Amount = amount })
					if not ok(result) and amount > 1 then
						N.GiftSingle[name] = true
						log(string.format("GIFT %s x%d refused (%s): one at a time like the game's own menu", name, amount, brief(result)))
						amount = 1
						result = invoke("GiftService.RF.OpenGift", { Gift = name, Amount = 1 })
					end
					-- a gift can roll another of itself (GiftConfig pools), so a count that stays + the prize in the answer
					-- also counts
					local fewer = ok(result) and (waitFor(function()
						return N.itemCount(name) < count
					end, 3) or type(result.Rewards) == "table" or result.Reward ~= nil or type(result.Items) == "table")
					if fewer then
						Session.claims += 1
						N.Reward.last = "opened " .. amount .. " x " .. name
						table.insert(N.Reward.log, 1, N.Reward.last)
						if #N.Reward.log > 4 then
							table.remove(N.Reward.log)
						end
						log(string.format("GIFT opened %s x%d ok -> %s", name, amount, brief(result.Rewards or result.Reward or result.Items or result)))
					else
						failed("gift " .. name, result, if ok(result) then " (the gift count did not go down)" else "")
					end
					break
				elseif count > 0 and unlocksAt > N.serverTime() and due("giftWait " .. tostring(name), 3600) then
					-- B26: the Release Gift opens at its release time (UnlocksAt 1792177200, 3097 L366138)
					log(string.format("GIFT %s x%d waits for its release in %s", tostring(name), count, N.longTime(unlocksAt - N.serverTime())))
				end
			end
		end
	end
	function N.giftPool(name)
		return type(name) == "string" and N.tableOr(N.G.Gifts.Pools)[name] ~= nil
	end

	-- ===== Lucky Duck: LuckyDuckyService.RE.Spawn {Id} -> RF.Claim(Id) after the 0.3 s minimum reaction, inside its 10 s
	-- lifetime (LuckyDuckyConfig 363512-363533). Probe luckyducky_nudge (blatant.md #3): after 1 h of playtime the game's own
	-- client asks for a duck with RF.Nudge(why, {Signs, Score}) once per 900 s; Corvus sends the same call on that cooldown
	-- and keeps it only when a duck spawns within 20 s (a real player's maximum, never faster). =====
	N.NudgeWhys = { Menu = true, Focus = true, Lull = true, Return = true, Fade = true }
	N.Duck = { pending = nil, nudgeAt = os.clock() - 600, expect = 0, misses = 0, wins = 0, last = "" }
	local Duck = N.Duck
	N.onEvent("LuckyDuckyService.RE.Spawn", function(p)
		if type(p) == "table" and type(p.Id) == "string" then
			Duck.pending = { id = p.Id, at = os.clock() }
			if os.clock() < Duck.expect then
				Duck.wins += 1
				Duck.expect = 0
				Duck.misses = 0
				if N.probeState("luckyducky_nudge") == "untested" then
					N.probeResult("luckyducky_nudge", "accepted", "gain=+1 duck/900s reward=" .. p.Id)
				end
			end
		end
	end)
	function N.duckStep()
		local pend = Duck.pending
		if pend and os.clock() - pend.at >= 0.5 then
			Duck.pending = nil
			if os.clock() - pend.at <= 9 then
				-- the duck's coins are a windfall, not income (REV-11)
				N.incomeHold(3)
				local result = invoke("LuckyDuckyService.RF.Claim", pend.id)
				-- R13: caught only on the server's Success (the game's own duck: Success ~= true = "The ducky got away!",
				-- LuckyDuckyController bc 28385-28411)
				if ok(result) then
					Session.ducks += 1
					Duck.last = "caught a duck" .. (if type(result) == "table" and result.Reward then " (" .. tostring(result.Reward) .. ")" else "")
					log("DUCK claimed ok", pend.id, brief(result))
				else
					Duck.last = "a duck got away (" .. brief(if type(result) == "table" then result.Reason or result else result) .. ")"
					failed("lucky duck " .. tostring(pend.id), result)
				end
			end
		end
	end
	-- The nudge probe is its own toggle (Ask For Extra Ducks).
	function N.nudgeStep()
		if Duck.expect > 0 and os.clock() > Duck.expect then
			Duck.expect = 0
			Duck.misses += 1
			if Duck.misses >= 2 and N.probeState("luckyducky_nudge") == "untested" then
				N.probeResult("luckyducky_nudge", "rejected", "gain=0 (no duck after 2 nudges)")
			end
		end
		local playtime = tonumber(N.sub(N.data(), "Meta").Playtime) or 0
		if N.probeState("luckyducky_nudge") ~= "rejected" and playtime >= 3600 and os.clock() - Duck.nudgeAt >= 905 then
			Duck.nudgeAt = os.clock()
			Duck.expect = os.clock() + 20
			-- blatant.md P4-9.1: the score is computed by the client (Threshold 50) and the game's own Auto Clicker cuts it x0.35,
			-- so an AFK player never reaches it. Sent like a player who opened the leave menu: reason Menu (the server's
			-- Nudges list: Menu/Focus/Lull/Return/Fade), signs LeavePrompt + Menu + EscKey, score 83.
			invoke("LuckyDuckyService.RF.Nudge", "Menu", { Signs = { "LeavePrompt", "Menu", "EscKey" }, Score = 83 })
			log("DUCK nudge sent (game cooldown 900 s)")
		end
	end

	-- ===== Treats and XP: ItemService.RF.UseOnPet {Item, PetId, Amount} (dump 165651). XP per call =
	-- TreatXP.Get = XP x modifier x round(Amount x Level^0.1) (367057): one call with every treat (batch) gives up to +70 %.
	-- Pets level only after the bridge (PetLevelConfig.LevelingUnlocked, 381175). Golden Treat applies the Golden tier
	-- (x3 power) and goes on the strongest Normal pet; +10 Levels on the strongest pet with 10 levels of headroom; the
	-- 2x Coins and 2x Pet XP treats (1 h) are kept active. ElectricShard is a mutation item and is never fed as XP. =====
	N.TreatItems = {
		RegularTreat = true,
		BagOfTreats = true,
		ExoticShard = true,
		SecretFruit = true,
		DragonFruit = true,
		GoldenApple = true,
		RainbowStrawberry = true,
		PetLevels10 = true,
		PetXP3x = true,
		PetClicks2x = true,
	}
	local XPOrder = { "ExoticShard", "SecretFruit", "RainbowStrawberry", "DragonFruit", "GoldenApple", "BagOfTreats", "RegularTreat" }
	N.Treat = { last = "", backoff = {} }
	function N.treatActive(name)
		local v = N.sub(N.sub(N.data(), "Items"), "ActiveTreats")[name]
		if type(v) ~= "number" or v <= 0 then
			return false
		end
		return v < 1e6 or v > N.serverTime()
	end
	local function useOn(item, id, amount, why, quiet)
		if (N.Treat.backoff[item] or 0) > os.clock() then
			return false
		end
		local result = invoke("ItemService.RF.UseOnPet", { Item = item, PetId = id, Amount = amount })
		if ok(result) then
			Session.treats += amount
			N.Treat.last = string.format("%s x%d on %s%s", item, amount, tostring((N.owned()[id] or {}).Name or id), if result.LevelsGained then " (+" .. tostring(result.LevelsGained) .. " levels)" else "")
			if not quiet then
				log("TREAT", item, "x" .. amount, "pet", tostring((N.owned()[id] or {}).Name), why or "", "->", brief(result))
			end
			if item ~= "PetLevels10" and item ~= "GoldenTreat" and item ~= "PetXP3x" and item ~= "PetClicks2x" and N.probeState("treat_batch") == "untested" and amount >= 2 then
				N.probeResult("treat_batch", "accepted", "gain=round(" .. amount .. " x Level^0.1) units in one call, xp=" .. tostring(result.Amount or "?"))
			end
			return true, result
		end
		N.Treat.backoff[item] = os.clock() + 600
		log("TREAT", item, "refused", brief(result))
		return false, result
	end
	-- G5-6 (blatant.md pass 5): XP per call = XP x modifier x round(Amount x Level^0.1) (TreatXP.Get 3097 L366732-366738).
	-- The rounding favours small calls from level 58 (one treat counts as 2 there, a batch of N as ~1.5-1.7 N): per pet the
	-- Amount with the most units per treat is picked (1..10 or the whole batch; ties go to the bigger Amount = fewer calls).
	function N.treatChunk(level, count)
		local k = math.max(tonumber(level) or 1, 1) ^ 0.1
		local best, bestEff = count, math.round(count * k) / math.max(count, 1)
		for a = math.min(count, 10), 1, -1 do
			local eff = math.round(a * k) / a
			if eff > bestEff + 1e-9 then
				best, bestEff = a, eff
			end
		end
		return best, bestEff, math.round(count * k) / math.max(count, 1)
	end
	-- XP targets: the level team (Level farming), else the equipped pets, strongest first; pets at max level are skipped.
	local function targets()
		local list = {}
		local pool = if next(N.Equip.team) then N.Equip.team else N.equippedSet()
		for id in pairs(pool) do
			local pet = N.owned()[id]
			if type(pet) == "table" and (tonumber(pet.Level) or 1) < N.maxLevel(pet) then
				table.insert(list, { id = id, pet = pet, power = N.petPower(id) })
			end
		end
		table.sort(list, function(a, b)
			return a.power > b.power
		end)
		return list
	end
	-- Two toggles: 2x Coins treat, XP treats (+10 Levels, 2x Pet XP, every XP treat in batches). The Golden Treat is a
	-- removed item in 3097 (ItemBehaviorConfig GoldenTreat Availability "Removed", L365545-365551): no control for it.
	function N.coinTreatStep()
		local any = next(N.equippedSet())
		if any and N.itemCount("PetClicks2x") > 0 and not N.treatActive("PetClicks2x") then
			useOn("PetClicks2x", any, 1, "2x coins for 1 h")
		end
	end
	function N.xpTreatStep()
		if not next(N.equippedSet()) then
			N.Treat.last = "no pet equipped"
			return
		end
		if not N.levelingUnlocked() then
			N.Treat.last = "XP treats wait: pets level up after the bridge is lowered"
			return
		end
		local list = targets()
		if #list == 0 then
			N.Treat.last = "every XP target is at its max level"
			return
		end
		if N.levelFarming() and N.itemCount("PetXP3x") > 0 and not N.treatActive("PetXP3x") then
			useOn("PetXP3x", list[1].id, 1, "2x pet XP for 1 h")
		end
		-- R3-1 (live `TREAT PetLevels10 refused {Error=SingleUseOnly}` with Amount=6): +10 Levels is single use per call, so
		-- one call per pet and step of 10 levels (strongest pet with room first), 0.12 s apart, at most 10 calls a pass
		local levels10 = N.itemCount("PetLevels10")
		if levels10 > 0 and (N.Treat.backoff.PetLevels10 or 0) <= os.clock() then
			local calls = 0
			for _, t in ipairs(list) do
				while levels10 > 0 and calls < 10 and alive() do
					local pet = N.owned()[t.id]
					local level = tonumber(type(pet) == "table" and pet.Level) or 1
					if type(pet) ~= "table" or N.maxLevel(pet) - level < 10 then
						break
					end
					local okUse = useOn("PetLevels10", t.id, 1, "+10 levels", true)
					calls += 1
					if not okUse then
						break
					end
					levels10 -= 1
					log(string.format("TREAT PetLevels10 pet %s +10 levels (level %d -> %d)", tostring(pet.Name), level, math.min(level + 10, N.maxLevel(pet))))
					waitFor(function()
						local p = N.owned()[t.id]
						return type(p) ~= "table" or (tonumber(p.Level) or 1) > level
					end, 1)
					task.wait(0.12)
				end
				if levels10 <= 0 or calls >= 10 then
					break
				end
			end
		end
		local defs = N.tableOr(N.G.Items)
		for _, item in ipairs(XPOrder) do
			local count = N.itemCount(item)
			local def = defs[item]
			if count > 0 and type(def) == "table" and tonumber(def.XP) then
				-- The pet this treat helps most: its modifier (Secret, Flying, Golden, Rainbow) first, then the strongest.
				local best, bestScore = nil, -1
				for _, t in ipairs(list) do
					local mod = 1
					if type(N.G.TreatXP.GetModifier) == "function" then
						local okMod, m = pcall(N.G.TreatXP.GetModifier, def, t.pet)
						mod = if okMod and type(m) == "number" then m else 1
					end
					local score = mod * 1e12 + t.power
					if score > bestScore then
						best, bestScore = t, score
					end
				end
				if best then
					local amount = count
					if type(N.G.TreatXP.GetAmountFor) == "function" and type(N.G.TreatXP.GetXPToLevel) == "function" then
						local okNeed, need = pcall(function()
							return N.G.TreatXP.GetAmountFor(def, best.pet, N.G.TreatXP.GetXPToLevel(best.pet, N.maxLevel(best.pet)))
						end)
						if okNeed and type(need) == "number" and need >= 1 then
							amount = math.min(count, math.ceil(need))
						end
					end
					local level = tonumber(best.pet.Level) or 1
					local chunk, eff, batchEff = N.treatChunk(level, amount)
					if chunk >= amount or N.probeState("treat_round") == "rejected" then
						useOn(item, best.id, amount, "batch")
					else
						-- Small calls (at most 40 per pass, 0.12 s apart; the game's own client guard is 0.1 s).
						local mod = 1
						if type(N.G.TreatXP.GetModifier) == "function" then
							local okMod, m = pcall(N.G.TreatXP.GetModifier, def, best.pet)
							mod = if okMod and type(m) == "number" then m else 1
						end
						local left, calls, xp, units = amount, 0, 0, 0
						while left > 0 and calls < 40 and alive() do
							-- the best Amount moves with the level the pet just reached
							local a = math.min(N.treatChunk(level, left), left)
							local okUse, result = useOn(item, best.id, a, "round", true)
							if not okUse then
								break
							end
							calls += 1
							left -= a
							local got = tonumber(result.Amount) or 0
							xp += got
							units += math.round(a * math.max(level, 1) ^ 0.1)
							if N.probeState("treat_round") == "untested" then
								local expected = (tonumber(def.XP) or 0) * mod * math.round(a * math.max(level, 1) ^ 0.1)
								local accepted = expected > 0 and got >= expected * 0.99
								N.probeResult("treat_round", if accepted then "accepted" else "rejected", string.format("gain=+%d%% vs batch (level %d, %d per call, xp %s, expected %s)", math.floor((eff / batchEff - 1) * 100 + 0.5), level, a, tostring(got), tostring(expected)))
								if not accepted then
									break
								end
							end
							level = tonumber(result.Level) or level
							if level >= N.maxLevel(best.pet) then
								break
							end
							task.wait(0.12)
						end
						log(string.format("TREAT %s x%d pet %s in %d calls of %d (rounding) xp=%s units=%d, now level %d", item, amount - left, tostring(best.pet.Name), calls, chunk, formatNumber(xp), units, level))
					end
				end
			end
		end
	end

	-- ===== Honey Pot (Workspace.Map1.HoneyPotArea.HoneyPotMachine, HoneyPotConfig 365401: 3 slots, max 100, server
	-- Range 25): HoneyPotService.RF.Craft(recipeKey, amount), RF.Claim(slot) (163742, 164042). Claims finished slots and
	-- fills free ones with what the ingredients you own make, XP first (+10 Levels, Secret Fruit, Rainbow Strawberry ...). =====
	-- B15 (3097 HoneyPotConfig L365116-365268): PetClicks2x (3 CloudPuff, 30 s) first until a day of 2x Coins treats is in
	-- stock (N.TargetClickTreats, every one = an hour of x3 tap coins), then +10 Levels, then the XP recipes with what is
	-- left (the CloudPuff the 2x Coins treats still need stays reserved).
	local XPRecipes = { "SecretFruit", "RainbowStrawberry", "DragonFruit", "GoldenApple", "PetXP3x", "BagOfTreats" }
	local Ingredients = { "CloudPuff", "PumpkinSeeds", "GlowSpore", "CactusFruit", "CrystalShard", "VoidEssence" }
	-- Inputs as the 3097 config has them ({ {Kind, Key, Amount}, ... }) or as a plain map.
	local function recipeInputs(recipe)
		local out = {}
		for k, v in pairs(N.tableOr(recipe.Inputs)) do
			if type(v) == "table" and type(v.Key) == "string" then
				out[v.Key] = (out[v.Key] or 0) + (tonumber(v.Amount) or 1)
			elseif type(k) == "string" and type(v) == "number" then
				out[k] = (out[k] or 0) + v
			end
		end
		return out
	end
	local function craftable(recipe, inv)
		local n = 100
		for key, amount in pairs(recipeInputs(recipe)) do
			n = math.min(n, math.floor((inv[key] or 0) / math.max(amount, 1)))
		end
		return math.max(n, 0)
	end
	N.Honey = { last = "", tripAt = -1e9 }
	function N.honeyRecipe(key)
		local byKey = N.tableOr(N.G.HoneyPot.ByKey)
		return if type(key) == "string" then byKey[key] else nil
	end
	function N.honeySlots()
		return N.sub(N.sub(N.data(), "HoneyPot"), "Slots")
	end
	-- R13 claimOnly: the finished slots only (a free claim: the ingredients went in when the craft started), no new craft.
	function N.honeyPlan(claimOnly)
		local data = N.data()
		if not data then
			return {}, {}
		end
		local now = N.serverTime()
		local ready, used = {}, 0
		local slotCount = tonumber(N.G.HoneyPot.SlotCount) or 3
		for i = 1, slotCount do
			local slot = N.honeySlots()[i] or N.honeySlots()[tostring(i)]
			if type(slot) == "table" then
				used += 1
				if type(N.G.HoneyPot.Progress) == "function" then
					local okP, made = pcall(N.G.HoneyPot.Progress, slot, now)
					if okP and type(made) == "number" and made >= (tonumber(slot.Amount) or 1) then
						table.insert(ready, i)
					end
				end
			end
		end
		local crafts = {}
		if claimOnly then
			return ready, crafts
		end
		local free = slotCount - used + #ready
		local inv = {}
		for _, key in ipairs(Ingredients) do
			inv[key] = N.itemCount(key)
		end
		local function add(key, amount)
			local recipe = N.honeyRecipe(key)
			if free <= 0 or not recipe or amount < 1 then
				return 0
			end
			amount = math.min(math.floor(amount), 100)
			table.insert(crafts, { key = key, amount = amount })
			free -= 1
			for item, n in pairs(recipeInputs(recipe)) do
				inv[item] = (inv[item] or 0) - n * amount
			end
			return amount
		end
		local stock = if N.clickTreatStock then N.clickTreatStock() else N.itemCount("PetClicks2x")
		local need = math.max(0, math.ceil((N.TargetClickTreats or 24) - stock))
		local click = N.honeyRecipe("PetClicks2x")
		local made = if click and need > 0 then add("PetClicks2x", math.min(craftable(click, inv), need)) else 0
		local levels = N.honeyRecipe("PetLevels10")
		if levels then
			add("PetLevels10", craftable(levels, inv))
		end
		-- the CloudPuff the 2x Coins treats still need is not spent on XP
		inv.CloudPuff = math.max((inv.CloudPuff or 0) - 3 * math.max(need - made, 0), 0)
		for _, key in ipairs(XPRecipes) do
			local recipe = N.honeyRecipe(key)
			if recipe then
				add(key, craftable(recipe, inv))
			end
		end
		return ready, crafts
	end
	function N.honeyMachine()
		local map = workspace:FindFirstChild("Map1")
		if not map then
			return nil
		end
		if type(N.G.HoneyPot.FindMachine) == "function" then
			local okF, m = pcall(N.G.HoneyPot.FindMachine, map)
			if okF and m then
				return m
			end
		end
		local area = map:FindFirstChild("HoneyPotArea")
		return area and area:FindFirstChild("HoneyPotMachine")
	end
	function N.honeyTrip(claimOnly)
		claimOnly = claimOnly == true
		local ready, crafts = N.honeyPlan(claimOnly)
		if #ready == 0 and #crafts == 0 then
			return 0
		end
		N.tripBegin("honey")
		N.Honey.tripAt = os.clock()
		waitFor(function()
			return not N.Hatch.inFlight
		end, 4)
		N.loopStatus("Main", if claimOnly then "Honey Pot: claiming the finished treats" else "Honey Pot: claiming and crafting treats")
		local done = 0
		if N.travel("Spawn") then
			local machine = N.honeyMachine()
			local okPivot, pivot = pcall(function()
				return machine and machine:GetPivot()
			end)
			if okPivot and pivot then
				N.teleport(pivot.Position + Vector3.new(0, 3, 8), 0.5)
				-- REV-7: 0.5 s between calls, one retry after RateLimited (N.pacedInvoke)
				for _, slot in ipairs(ready) do
					local result = N.pacedInvoke("HoneyPotService.RF.Claim", slot)
					-- R13 (OWNER_RULES 24): counted when the slot is empty (or holds a new craft) afterwards
					local cleared = ok(result) and waitFor(function()
						local s = N.honeySlots()[slot] or N.honeySlots()[tostring(slot)]
						if type(s) ~= "table" then
							return true
						end
						local okP, made = pcall(N.G.HoneyPot.Progress, s, N.serverTime())
						return not (okP and type(made) == "number" and made >= (tonumber(s.Amount) or 1))
					end, 2)
					if cleared then
						done += 1
						log("HONEY claimed slot", slot, "ok")
					else
						log("CLAIM honey slot " .. tostring(slot) .. " FAILED answer=" .. brief(result))
					end
				end
				for _, c in ipairs(crafts) do
					local result = N.pacedInvoke("HoneyPotService.RF.Craft", c.key, c.amount)
					if ok(result) then
						done += 1
						N.Honey.last = "brewing " .. c.amount .. " x " .. c.key
						log(string.format("HONEY craft %s x%d slot %s", c.key, c.amount, tostring(result.Slot or "?")))
					else
						log("HONEY craft", c.key, "refused:", brief(result))
					end
				end
			else
				N.Honey.last = "Honey Pot not found on the main map"
				log("HONEY machine not found")
			end
		end
		N.tripEnd()
		return done
	end

	-- ===== Gem spending: the skill tree (SkillTreeService.RF.Unlock {Name}, dump 144822; a node needs its parent node and
	-- its RequiredIsland, price SkillTreeFormula.GetPrice) and the gem upgrades (UpgradeService.RF.Purchase {Name}, 160250;
	-- price UpgradeConfig.GetPrice(name, level + 1) gems, LaunchTotal levels, Forest/Winter needed first). =====
	N.Spend = { last = "", refused = {}, pick = nil }
	local SkillWeight = {
		TapPower = 1,
		PetPower = 1,
		CriticalTapChance = 0.8,
		CriticalTapDamage = 0.1,
		AutoClickPower = 0,
		AutoClickCritical = 0,
		AutoClickSpeed = 0,
		RebirthGems = 0.3,
		EggLuck = 0.6,
		GoldenChance = 0.6,
		RainbowChance = 0.6,
		HatchSpeed = 0.8,
		PetXPGain = 0.1,
		EnchantLuck = 0.05,
	}
	local function autoShare()
		local tap = N.Tap
		local total = tap.rate + tap.autoRate
		return if total > 0 then tap.autoRate / total else 0.3
	end
	local function skillBonus(kind)
		local fn = N.G.Skill.GetBonus
		local data = N.data()
		if type(fn) == "function" and data then
			local okB, b = pcall(fn, data, kind)
			if okB and type(b) == "number" then
				return b
			end
		end
		return 0
	end
	-- Relative progress per node: coin streams count 1, hatch speed / luck a little less, XP more while Level farming.
	function N.skillValue(def)
		if type(def) ~= "table" then
			return 0
		end
		local kind = def.Type
		local v = tonumber(def.Value) or 0
		if kind == nil then
			if def.Name == "Auto Clicker" then
				return 0.5
			elseif def.Name == "Auto Rebirth" then
				return 0.02
			end
			return 0.01
		end
		local w = SkillWeight[kind] or 0.05
		if kind == "AutoClickPower" or kind == "AutoClickCritical" or kind == "AutoClickSpeed" then
			w = autoShare()
		elseif kind == "PetXPGain" and N.levelFarming() then
			w = 0.6
		elseif kind == "HatchSpeed" and N.hatchWeight then
			-- REV-10: hatch speed at h, egg luck by the power it adds per hatch at h; G4 (3937): only the speed-dependent
			-- part of the server's hatch hold shrinks, so +x speed is worth N.hatchSpeedGain(x) eggs, not x
			local rel = v / (1 + skillBonus(kind))
			return if rel > 0 then N.hatchSpeedGain(rel) * N.hatchWeight() else 0
		elseif kind == "EggLuck" and v > 0 and N.luckGain then
			w = N.luckGain(v) / v * N.hatchWeight()
		end
		return w * v / (1 + skillBonus(kind))
	end
	local function walkTree(node, out)
		if type(node) ~= "table" then
			return
		end
		if type(node.Name) == "string" then
			table.insert(out, node.Name)
		end
		for _, dir in ipairs({ "N", "S", "NE", "NW", "SE", "SW" }) do
			walkTree(node[dir], out)
		end
	end
	local function unlockedSkills()
		return N.sub(N.sub(N.data(), "SkillTree"), "Unlocked")
	end
	local function categoryOpen(tree)
		if tree == "Origin" then
			return true
		end
		local names = {}
		walkTree(N.G.SkillTree.Origin, names)
		local unlocked = unlockedSkills()
		for _, name in ipairs(names) do
			local node = N.skillNode(name)
			if node and type(node.Data) == "table" and node.Data.Category == true and node.Data.Tree == tree and unlocked[name] == true then
				return true
			end
		end
		return false
	end
	local function parentOpen(node)
		if node.Parent == nil then
			return true
		end
		local parent = N.skillNode(node.Parent)
		if not parent then
			return false
		end
		if type(parent.Data) == "table" and parent.Data.Origin == true then
			return categoryOpen(parent.Tree)
		end
		return unlockedSkills()[node.Parent] == true
	end
	function N.skillOptions()
		local out = {}
		local data = N.data()
		if not data then
			return out
		end
		local unlocked = unlockedSkills()
		local names = {}
		for _, root in pairs(N.tableOr(N.G.SkillTree)) do
			walkTree(root, names)
		end
		for _, name in ipairs(names) do
			local node = N.skillNode(name)
			if node and type(node.Data) == "table" and node.Data.Origin ~= true and unlocked[name] ~= true and parentOpen(node) and (N.Spend.refused["skill " .. name] or 0) < os.clock() then
				local island = node.Data.RequiredIsland
				if island == nil or N.islandUnlocked(island) then
					local cost = math.huge
					if type(N.G.Skill.GetPrice) == "function" then
						local okP, p = pcall(N.G.Skill.GetPrice, data, name)
						cost = if okP and type(p) == "number" then p else math.huge
					end
					if cost < math.huge then
						table.insert(out, { kind = "skill", name = name, cost = cost, value = N.skillValue(node.Data) })
					end
				end
			end
		end
		return out
	end
	-- ===== Gem upgrades (B2): UpgradeService.RF.Purchase {Name} (3097 L159919-159934), price UpgradeConfig.GetPrice(name,
	-- level + 1) = round(level^Exponent x BasePrice / 10) x 10 gems, LaunchTotal levels (UpgradeConfig L387786-387933). The
	-- next level of each needs the zone GetRetainedRequirement names (ClickMultiplier and HatchSpeed levels 1-5, Critical
	-- Chance and Auto Click Speed 1-2 need Winter; L387924-387933), and the game sells them at the Upgrades InteractionPoint
	-- of the Winter zone (UpgradeController retainedUpgradePoint L159788-159797). Effects (L387752, L269644-269693,
	-- L269900-269902): Click Multiplier x(1 + L/20) on every tap (level 20 = double coins), Hatch Speed x(1 + L/15), Critical
	-- Chance 1/(20 - L). Each level is valued as the share of income (or hatch speed) it adds, the planner buys by value
	-- per gem. PROBE upgrade_remote: the first purchase is tried from where the player stands; a distance answer sends every
	-- later purchase through the Winter trip. =====
	local function critChance(level)
		return 1 / math.max(20 - level, 1) + skillBonus("CriticalTapChance")
	end
	-- REV-10: one second of hatching is worth h income-seconds (p06 N.hatchValue: the measured growth of the equipped power;
	-- income follows the equipped power) instead of the old fixed hatch share 0.3; luck counts through how much more power
	-- an egg gives per hatch with the extra luck (N.luckGain: the rare pets' weights scaled like the extra luck rolls).
	function N.hatchWeight()
		return if N.hatchValue then N.hatchValue() else 0.5
	end
	-- strategy.md item 3: the relative gain in expected pet power per hatch from +x luck rolls, through the game's own
	-- best-of-n bands (N.eggExpected in p06 uses HatchLuck.Odds). The old approximation scaled weights by (1 + x) and never
	-- valued a whole extra roll; this prices a friend / Luck2 / a potion correctly. Cache keyed by egg + x + the current n
	-- (potions and totems move n all day); kept to 200 entries.
	local LuckCache = {}
	function N.luckGain(x)
		x = tonumber(x) or 0
		local egg = N.Hatch.target or "Void"
		local cfg = N.eggCfg(egg)
		if not cfg or x <= 0 then
			return 0
		end
		local n = if N.luckRolls then N.luckRolls() else 1
		local key = string.format("%s:%.3f:%.2f", egg, x, n)
		if LuckCache[key] then
			return LuckCache[key]
		end
		local g = 0
		if N.eggExpected then
			local a = N.eggExpected(egg, n)
			local b = N.eggExpected(egg, n + x)
			g = if a > 0 then b / a - 1 else 0
		end
		LuckCache.n = (LuckCache.n or 0) + 1
		if LuckCache.n > 200 then
			table.clear(LuckCache)
			LuckCache.n = 1
		end
		LuckCache[key] = math.max(g, 0)
		return LuckCache[key]
	end
	-- ===== strategy.md item 1 (the crit stack): the game's own crit power P and crit chance p (ProfileStats.CritPower /
	-- CritChance, 3687 L293787-293824, from the component formulas in N.G), with the live TapResult measurement taking over
	-- when it exists (it also catches recharge-based crits). M = 1 + p(P-1) = the average manual-tap multiplier. The planner
	-- weights every CritPower source by p x P / M x the manual share of the income (strategy: the old 0.05 was ~15x too low). =====
	local CritCache = { at = -1e9, v = nil }
	function N.critStats()
		if CritCache.v and os.clock() - CritCache.at < 2 then
			return CritCache.v
		end
		local data = N.data()
		local p, P = 0, 10
		if data then
			pcall(function()
				local ach = N.sub(N.sub(data, "Achievements"), "Multipliers")
				local base = tonumber(ach.CriticalPower) or 1
				local tapDmg, masteryCP, enchCP = 1, 1, 1
				if type(N.G.Skill.GetMultiplier) == "function" then
					local o, m = pcall(N.G.Skill.GetMultiplier, data, "CriticalTapDamage")
					if o and N.finite(m) then tapDmg = m end
				end
				if type(N.G.Mastery.GetMultiplier) == "function" then
					local o, m = pcall(N.G.Mastery.GetMultiplier, data, "CriticalPower")
					if o and N.finite(m) then masteryCP = m end
				end
				if type(N.G.Enchant.GetCritPower) == "function" then
					local o, m = pcall(N.G.Enchant.GetCritPower, data)
					if o and N.finite(m) then enchCP = m end
				end
				P = math.max(base, 1) * 10 * tapDmg * masteryCP * enchCP
				local cc = tonumber(N.sub(data, "Upgrades").CriticalChance) or 0
				local pc = 1 / math.max(20 - cc, 1)
				if type(N.G.Skill.GetBonus) == "function" then
					local o, b = pcall(N.G.Skill.GetBonus, data, "CriticalTapChance")
					if o and N.finite(b) then pc += b end
				end
				if type(N.G.Mastery.GetBonus) == "function" then
					local o, b = pcall(N.G.Mastery.GetBonus, data, "CriticalChance")
					if o and N.finite(b) then pc += b end
				end
				if type(N.G.Enchant.GetStatMultiplier) == "function" then
					local o, b = pcall(N.G.Enchant.GetStatMultiplier, data, "CritChance")
					if o and N.finite(b) then pc += (b - 1) end
				end
				p = math.clamp(pc, 0, 1)
			end)
		end
		-- the measured share overrides the formula once taps have been seen (recharge crits, hidden multipliers)
		if N.Tap.critSeen and N.Tap.critShare > 0 then
			p = N.Tap.critShare
			if N.Tap.critPower > 1 then
				P = N.Tap.critPower
			end
		end
		if not N.finite(P) or P < 1 then
			P = 10
		end
		local M = 1 + p * math.max(P - 1, 0)
		CritCache.at = os.clock()
		CritCache.v = { p = p, P = P, M = M }
		return CritCache.v
	end
	-- The planner weight of +1.0 of a CritPower stat, as a share of income (strategy: p x P / M x manual share, ~0.6 live).
	function N.critWeight()
		local s = N.critStats()
		local manualShare = 0.8
		local income = N.income and N.income() or 0
		if income > 0 then
			local manual = (tonumber(N.Tap.rate) or 0) * (tonumber(N.Tap.amountManual) or 0)
			if manual > 0 then
				manualShare = math.clamp(manual / income, 0.1, 1)
			end
		end
		local w = if s.M > 0 then s.p * s.P / s.M * manualShare else 0.6
		return math.clamp(w, 0.3, 3)
	end
	-- The crit-upgrade road for the TAP line / Stats: the Clicking mastery L80 (+200% crit power) ETA at the live tap pace
	-- (ExpPerAction 1, XPBase 4300, XPExponent 0.6; Data.Mastery.Categories.Clicking) and the next CriticalChance gem level.
	function N.critETA()
		local data = N.data()
		if not data then
			return ""
		end
		local parts = {}
		local cat = N.sub(N.sub(N.sub(data, "Mastery"), "Categories"), "Clicking")
		local level = math.floor(tonumber(cat.Level) or 0)
		local xp = tonumber(cat.XP) or 0
		if level < 80 then
			local need = 0
			for k = level + 1, 80 do
				need += math.floor(4300 * k ^ 0.6)
			end
			need = math.max(need - xp, 0)
			local rate = (tonumber(N.Tap.rate) or 0) + (tonumber(N.Tap.autoRate) or 0)
			table.insert(parts, string.format("Clicking mastery L%d->L80 (+200%% crit) in %s taps%s", level, formatNumber(need), if rate > 0 then " ~" .. N.longTime(need / rate) else ""))
		else
			table.insert(parts, string.format("Clicking mastery L%d (L80 crit done)", level))
		end
		if type(N.G.Upgrades.GetPrice) == "function" then
			local lvl = math.floor(tonumber(N.sub(data, "Upgrades").CriticalChance) or 0)
			local total = tonumber(N.tableOr(N.tableOr(N.G.Upgrades.Definitions).CriticalChance).LaunchTotal) or 0
			if lvl < total then
				local okP, price = pcall(N.G.Upgrades.GetPrice, "CriticalChance", lvl + 1)
				if okP and N.finite(price) then
					table.insert(parts, string.format("CriticalChance %d->%d costs %s gems", lvl, lvl + 1, formatNumber(price)))
				end
			end
		end
		return table.concat(parts, "; ")
	end

	-- ===== strategy.md item 2 (secret pity/drought) and item 3 (luck = roll count). =====
	-- The live luck roll count n (ProfileStats.Luck, 3687 L293896): EggLuckFormula.Total(data, {Shrine, Clan, Totem}) x the
	-- weather luck multiplier, capped at MaxLuckRolls. The pool valuation uses the best-of-n bands, so a whole extra roll is
	-- valued correctly (the old N.luckGain scaled weights by (1+x) and never saw a roll).
	function N.luckRolls()
		local data = N.data()
		local el = N.G.EggLuck
		if not data or type(el) ~= "table" or type(el.Total) ~= "function" then
			return 1
		end
		local attrs = { Shrine = 1, Clan = 0, Totem = 1 }
		pcall(function()
			local tl = LocalPlayer:GetAttribute("TotemLuckBoost")
			if type(tl) == "number" and tl == tl then
				attrs.Totem = tl
			end
			local cl = LocalPlayer:GetAttribute("ClanLuckBonus")
			if type(cl) == "number" and cl == cl then
				attrs.Clan = cl
			end
		end)
		local okT, total = pcall(el.Total, data, attrs)
		if not okT or not N.finite(total) then
			return 1
		end
		local mult = 1
		local ge = N.G.GlobalEvent
		if type(ge) == "table" and type(ge.GetLuckMultiplier) == "function" then
			local okM, m = pcall(ge.GetLuckMultiplier)
			if okM and N.finite(m) and m > 0 then
				mult = m
			end
		end
		local cap = tonumber(N.tableOr(N.G.HatchRules).MaxLuckRolls) or 250
		return math.clamp(total * mult, 1, cap)
	end
	-- The secret drought and pity for an egg (SecretHatchFormula.GetDrought + HatchRulesConfig.GetPityBoost), for the log and
	-- the Status line. Returns droughtSeconds, pityMultiplier.
	function N.secretState(egg)
		local data = N.data()
		local secret = N.G.Secret
		if not data or type(secret) ~= "table" or type(secret.GetDrought) ~= "function" then
			return 0, 1
		end
		local okD, drought = pcall(secret.GetDrought, N.sub(data, "Eggs"), egg)
		drought = if okD and N.finite(drought) then math.max(drought, 0) else 0
		local pity = 1
		local hr = N.G.HatchRules
		if type(hr) == "table" and type(hr.GetPityBoost) == "function" then
			local okP, b = pcall(hr.GetPityBoost, drought)
			if okP and N.finite(b) then
				pity = b
			end
		end
		return drought, pity
	end
	N.Secret = { last = "" }
	-- The egg the secret hunt watches: the hatch target, else the dropdown pick (Void by default).
	function N.secretEgg()
		local egg = N.Hatch.target
		if type(egg) == "string" and N.validEgg(egg) then
			return egg
		end
		local choice = optionText("HatchEgg", "Void")
		return if choice ~= "Best (Smart)" and N.validEgg(choice) then choice else "Void"
	end
	function N.secretStatus()
		local egg = N.secretEgg()
		local drought, pity = N.secretState(egg)
		local n = if N.luckRolls then N.luckRolls() else 1
		return string.format("%s: drought %s, pity +%d%%, luck n=%.2f", egg, N.longTime(drought), math.floor((pity - 1) * 100 + 0.5), n)
	end
	-- Its own toggle (Secret Hunt): logs the drought/pity line every 5 min and keeps it in Status. No remote, no exploit.
	function N.secretStep()
		if not on("SecretHunt") then
			return
		end
		local egg = N.secretEgg()
		local drought, pity = N.secretState(egg)
		local n = if N.luckRolls then N.luckRolls() else 1
		N.Secret.last = N.secretStatus()
		if due("secretLine", 300) then
			log(string.format("SECRET drought/pity egg=%s drought=%s pity=+%d%% rolls=%.2f", egg, N.longTime(drought), math.floor((pity - 1) * 100 + 0.5), n))
		end
	end

	-- ===== G1 secret_release (blatant.md "3937 code pass" G1; bc lines in notes.md "Remotes on 3937"). A hatched Secret is
	-- shown by the game's SecretHatchRenderer (Modules.Client.Pets.SecretHatchRenderer, bc 212183-213006) on a "Hold to
	-- Reveal" screen (stage AwaitingHold, HatchScreen attribute TS2SecretHatchStage, 212842-212848); only when that reveal
	-- ends does the client report it (revealSecret 63733-63747: SecretAnimationCompleted {PetId} then SecretRevealSeen
	-- {PetId}), and the game's own queue waits behind it (63771-63808). AFK this held the owner's Forsaken Knight for 1 h 40
	-- min (live_findings Round 11). While the hub hatches by itself, 2 s after our own hatch answer names a pet whose Rarity
	-- starts with "Secret": (1) the game's own hold is started the way its offline renderer does it (BeginHold, 199964-199967
	-- and 212687-212722), so the game reports the reveal itself; (2) if the pet is still not released 20 s later, the hub
	-- sends those two calls once with the pet's real Id (probe secret_release, remembered per PlaceVersion; rejected = step 1
	-- only from then on). Never for other pets, never a guessed id, never twice for one id. With the reveal left on for
	-- manual play (N.Manual.revealOn) or the hub not hatching, the player holds it himself and Status says so. =====
	local SR = { pending = {}, armed = {}, done = {}, renderer = nil }
	N.SecretRelease = SR
	-- the last Secret the hub could not release: shown in Up next until the game hands it over
	SR.lastPending = nil
	function N.secretPendingText()
		local p = SR.lastPending
		if p and N.secretReleased(p.id) then
			SR.lastPending = nil
			p = nil
		end
		return if p then p.name .. " waits for Hold to Reveal on the hatch screen" else nil
	end
	function N.secretArmed(id)
		return type(id) == "string" and SR.armed[id] == true
	end
	local function secretRenderer()
		if type(SR.renderer) ~= "table" then
			pcall(function()
				local inst = ReplicatedStorage:FindFirstChild("Modules")
				inst = inst and inst:FindFirstChild("Client")
				inst = inst and inst:FindFirstChild("Pets")
				inst = inst and inst:FindFirstChild("SecretHatchRenderer")
				if inst and inst:IsA("ModuleScript") then
					local mod = require(inst)
					if type(mod) == "table" then
						SR.renderer = mod
					end
				end
			end)
		end
		return if type(SR.renderer) == "table" then SR.renderer else nil
	end
	-- Is the game's secret screen waiting on "Hold to Reveal" for this pet? (GetDebugState 212985-213004, else the
	-- HatchScreen attributes the renderer sets)
	function N.secretAwaitingHold(name)
		local r = secretRenderer()
		if r and type(r.GetDebugState) == "function" then
			local ok, st = pcall(r.GetDebugState, r)
			if ok and type(st) == "table" then
				return st.Stage == "AwaitingHold" and (st.Pet == nil or st.Pet == name)
			end
		end
		local gui = LocalPlayer:FindFirstChild("PlayerGui")
		local screen = gui and gui:FindFirstChild("HatchScreen")
		if screen then
			return screen:GetAttribute("TS2SecretHatchStage") == "AwaitingHold" and screen:GetAttribute("TS2SecretHatchPet") == name
		end
		return false
	end
	local function unseen(id)
		for _, v in pairs(N.sub(N.sub(N.data(), "Eggs"), "UnseenSecrets")) do
			if type(v) == "table" and v.Id == id then
				return true
			end
		end
		return false
	end
	-- Released = the pet sits in the storage and the game no longer lists it as an unseen secret (Eggs.UnseenSecrets,
	-- replayed at login only for owned pets, 64702-64721).
	function N.secretReleased(id)
		return N.ownsPet(id) and not unseen(id)
	end
	-- the hub releases only while it hatches by itself with the reveal hidden (Auto Hatch, the planner or the Index Hunter)
	function N.secretAutoRelease()
		return N.hatchWanted() and not (N.Manual and N.Manual.revealOn)
	end
	function N.secretRelease(pet)
		local id, name = pet.Id, tostring(pet.Name)
		local t0 = os.clock()
		task.wait(2)
		if not alive() then
			return
		end
		if N.secretReleased(id) and not N.secretAwaitingHold(name) then
			SR.pending[id] = nil
			log(string.format("SECRET owned %s id=%s after %.0fs, nothing to release", name, id, os.clock() - t0))
			return
		end
		if not N.secretAutoRelease() then
			SR.lastPending = { id = id, name = name }
			log("SECRET pending reveal", name, "id=" .. id, "(the hub is not hatching: hold to reveal it on the screen)")
			return
		end
		local via = nil
		if N.secretAwaitingHold(name) then
			local r = secretRenderer()
			if r and type(r.BeginHold) == "function" and pcall(r.BeginHold, r) then
				via = "hold"
				log("SECRET hold started", name, "id=" .. id, "(the game's own Hold to Reveal)")
				waitFor(function()
					return N.secretReleased(id) and not N.secretAwaitingHold(name)
				end, 20)
			end
		end
		if not N.secretReleased(id) and pet.AutoDeleted ~= true and not SR.done[id] and N.probeState("secret_release") ~= "rejected" then
			SR.done[id] = true
			SR.armed[id] = true
			local sentA = fire("EggService.RE.SecretAnimationCompleted", { PetId = id })
			local sentB = fire("EggService.RE.SecretRevealSeen", { PetId = id })
			SR.armed[id] = nil
			if sentA or sentB then
				via = "remote"
				waitFor(function()
					return N.secretReleased(id)
				end, 10)
			end
		end
		local secs = os.clock() - t0
		if N.secretReleased(id) then
			SR.pending[id] = nil
			if SR.lastPending and SR.lastPending.id == id then
				SR.lastPending = nil
			end
			log(string.format("SECRET released pet=%s name=%s via=%s after=%.1fs", id, name, via or "game", secs))
			if via == "remote" and N.probeState("secret_release") == "untested" then
				N.probeResult("secret_release", "accepted", string.format("gain=owned_after=%.1fs", secs))
			end
		else
			SR.lastPending = { id = id, name = name }
			log("SECRET pending reveal", name, "id=" .. id, string.format("after %.0fs (via=%s)", secs, tostring(via or "none")))
			if via == "remote" and N.probeState("secret_release") == "untested" then
				N.probeResult("secret_release", "rejected", "gain=0")
			end
		end
	end
	-- ===== R13 Secret lock (OWNER_RULES 23, owner 2026-10-12 CAPS: a Secret pet is never deleted, crafted, fused or
	-- rerolled, and the hub locks it in the game when it can). The game's own lock button: PetService.RE.PetActionRequested
	-- {Action="ToggleLock", PetId} (Inventory bc 67575-67578, quick actions 68742-68745). ToggleLock FLIPS the lock, so the
	-- hub sends it once, only for an owned Secret whose Locked is not true, and counts it only when the replica shows
	-- Locked = true; without that it waits 10 minutes before it may ask again (a second flip would unlock it). Every Secret
	-- it has seen locked is remembered (Corvus/TAPSIM_locked.txt): a Secret the player unlocks himself stays unlocked. =====
	do
		local Lock = { done = nil, armed = {}, waitUntil = {}, n = 0 }
		N.SecretLock = Lock
		local LockFile = "Corvus/TAPSIM_locked.txt"
		local function loadDone()
			if Lock.done then
				return
			end
			Lock.done = {}
			local okR, text = pcall(function()
				return if isfile and isfile(LockFile) then readfile(LockFile) else ""
			end)
			if okR and type(text) == "string" then
				for id in string.gmatch(text, "[^\r\n]+") do
					Lock.done[id] = true
				end
			end
		end
		local function saveDone()
			local ids = {}
			for id in pairs(Lock.done) do
				table.insert(ids, id)
			end
			table.sort(ids)
			pcall(function()
				if makefolder and isfolder and not isfolder("Corvus") then
					makefolder("Corvus")
				end
				if writefile then
					writefile(LockFile, table.concat(ids, "\n"))
				end
			end)
		end
		function N.lockArmed(id)
			return type(id) == "string" and Lock.armed[id] == true
		end
		local function isSecret(pet)
			return type(pet) == "table" and string.match(tostring(N.rarityOf(pet) or ""), "^Secret") ~= nil
		end
		function N.secretLockStep()
			loadDone()
			local changed = false
			local target = nil
			for id, pet in pairs(N.owned()) do
				if isSecret(pet) then
					if pet.Locked == true then
						if not Lock.done[id] then
							Lock.done[id] = true
							changed = true
						end
					elseif not Lock.done[id] and (Lock.waitUntil[id] or -1e9) < os.clock() and not target then
						target = id
					end
				end
			end
			if changed then
				saveDone()
			end
			if not target then
				return false
			end
			local pet = N.owned()[target]
			local name = tostring(type(pet) == "table" and pet.Name or target)
			Lock.armed[target] = true
			local sent = fire("PetService.RE.PetActionRequested", { Action = "ToggleLock", PetId = target })
			Lock.armed[target] = nil
			Lock.waitUntil[target] = os.clock() + 600
			if not sent then
				return false
			end
			local locked = waitFor(function()
				local p = N.owned()[target]
				return type(p) == "table" and p.Locked == true
			end, 5)
			if locked then
				Lock.done[target] = true
				Lock.n += 1
				saveDone()
				log(string.format("SECRET locked %s ok (id=%s, OWNER_RULES 23)", name, target))
			else
				log(string.format("SECRET lock %s FAILED answer=Locked is still %s 5 s later (no second flip for 10 min)", name, tostring(N.tableOr(N.owned()[target]).Locked)))
			end
			return locked
		end
	end
	-- ===== R13: the pet the game's own Auto Enchant holds in the enchanter (3937: player attributes EnchantHeldPet and
	-- EnchantHeldState, EnchantController bc 65340-65359). When its run is over (state "Done", the game's own Claimable rule
	-- bc 191917-191918) the window shows Claim instead of Enchant and EnchantService.RF.Claim() gives the pet back, on the
	-- team when it was equipped (EnchantWindow claim() bc 192974-193013). A free claim (nothing is used up): the planner and
	-- Auto Claim Finished Crafts take it. Refused for distance = one short visit to the Enchant point (p06 trip options).
	-- While a pet is held, every pet action of the hub leaves it alone (N.keepSet, N.bestTeam). =====
	N.EnchantHold = { visit = false, last = "" }
	function N.enchantHeldPet()
		local id = LocalPlayer:GetAttribute("EnchantHeldPet")
		return if type(id) == "string" and id ~= "" then id else nil
	end
	function N.enchantHeldDone()
		return N.enchantHeldPet() ~= nil and LocalPlayer:GetAttribute("EnchantHeldState") == "Done"
	end
	function N.enchantClaim()
		local id = N.enchantHeldPet()
		if not id or not N.enchantHeldDone() then
			return false
		end
		local pet = N.owned()[id]
		local name = tostring(type(pet) == "table" and (pet.Nickname or pet.Name) or id)
		local result = invoke("EnchantService.RF.Claim")
		local back = waitFor(function()
			return N.enchantHeldPet() ~= id
		end, 3)
		if ok(result) and back then
			N.EnchantHold.visit = false
			N.EnchantHold.last = name .. " is back" .. (if type(result) == "table" and result.Equipped then " on your team" else "")
			note("enchanter ok: " .. N.EnchantHold.last)
			return true
		end
		local reason = type(result) == "table" and tostring(result.Reason or result.Error or "") or ""
		N.EnchantHold.visit = reason == "VisitEnchantMachine" or reason == "TooFar"
		N.EnchantHold.last = name .. " still in the enchanter (" .. (if reason ~= "" then reason else "no answer") .. ")"
		failed("enchanter pet " .. name, result, if N.EnchantHold.visit then " (a visit to the Enchant point comes next)" else "")
		return false
	end
	function N.enchantClaimStep()
		if not N.enchantHeldDone() or N.EnchantHold.visit or not due("enchantClaim", 30) then
			return false
		end
		return N.enchantClaim()
	end
	-- the visit (a trip option of p06 once the remote Claim asked for the machine): stand in the Enchant point, claim, back
	function N.enchantClaimTrip()
		N.EnchantHold.tripAt = os.clock()
		if not N.enchantHeldDone() then
			N.EnchantHold.visit = false
			return 0
		end
		N.tripBegin("enchanter claim")
		N.loopStatus("Main", "taking your pet back from the enchanter")
		local done = 0
		local part = N.goToPoint and N.goToPoint("Enchant", "Shadow Realm")
		if part then
			done = if N.enchantClaim() then 1 else 0
		else
			log("CLAIM enchanter pet FAILED answer=the Enchant point was not found (next try in 10 min)")
		end
		N.tripEnd()
		return done
	end
	-- ===== R13 (OWNER_RULES 24, the second method next to the claims' own answers): what the GAME still lists as claimable,
	-- read from the replica with the game's own rules (the same fields verify_probe.lua reads): the index list
	-- (PetIndexCatalog.Claimables), finished quests (QuestVisibility), the offline grant and recap, openable gifts, ready
	-- tap chests, finished brews / Honey Pot slots / Rainbow pods, the enchanter's held pet, Secrets without the lock and a
	-- pending Pet Defense reward. `STATE claimable ...` every 10 minutes (and in the Rewards panel); anything above 0 that
	-- stays while its toggle runs is a claim that failed. =====
	function N.claimState()
		local data = N.data()
		if not data then
			return nil
		end
		local s = { index = #(N.indexClaimables and N.indexClaimables() or {}), quests = 0, offline = 0, recap = 0, gifts = 0, chests = 0, brews = 0, honey = 0, pods = 0, enchanter = 0, secrets = 0, defense = 0 }
		local defs = N.tableOr(N.G.Quests.Definitions)
		for id, q in pairs(N.sub(data, "Quests")) do
			local def = defs[id]
			if type(def) == "table" and type(q) == "table" and def.AutoClaim ~= true and q.Claimed ~= true and (q.Completed == true or (tonumber(q.Amount) or 0) >= (tonumber(def.Goal) or math.huge)) then
				local shown = true
				if type(N.G.QuestVisibility.IsShown) == "function" then
					local okS, yes = pcall(N.G.QuestVisibility.IsShown, data, id)
					shown = not okS or yes == true
				end
				if shown then
					s.quests += 1
				end
			end
		end
		local off = N.sub(data, "Offline")
		s.offline = if offlineGrant(off.Pending) then 1 else 0
		s.recap = if type(off.HatchPending) == "table" and off.HatchPending.Id ~= nil then 1 else 0
		for name in pairs(N.tableOr(N.G.Gifts.Pools)) do
			local def = N.tableOr(N.G.Items)[name]
			if N.itemCount(name) > 0 and N.serverTime() >= (type(def) == "table" and tonumber(def.UnlocksAt) or 0) then
				s.gifts += N.itemCount(name)
			end
		end
		if N.tapChestsDue then
			local okC, list = pcall(N.tapChestsDue, nil, true)
			s.chests = if okC and type(list) == "table" then #list else 0
		end
		local now = os.time()
		for _, slot in pairs(N.sub(N.sub(data, "PotionMachine"), "Slots")) do
			if type(slot) == "table" and tonumber(slot.ReadyAt) and slot.ReadyAt <= now then
				s.brews += 1
			end
		end
		s.honey = #(N.honeyPlan(true))
		s.pods = if N.readyPods then #N.readyPods() else 0
		s.enchanter = if N.enchantHeldDone() then 1 else 0
		for _, pet in pairs(N.owned()) do
			if type(pet) == "table" and pet.Locked ~= true and string.match(tostring(N.rarityOf(pet) or ""), "^Secret") ~= nil then
				s.secrets += 1
			end
		end
		s.defense = if N.sub(data, "Colosseum").PendingReward ~= nil then 1 else 0
		return s
	end
	function N.claimStateText(s)
		s = s or N.claimState()
		if not s then
			return "?"
		end
		return string.format("index=%d quests=%d offline=%d recap=%d gifts=%d chests=%d brews=%d honey=%d pods=%d enchanter=%d secrets_unlocked=%d defense_reward=%d", s.index, s.quests, s.offline, s.recap, s.gifts, s.chests, s.brews, s.honey, s.pods, s.enchanter, s.secrets, s.defense)
	end
	function N.claimStateStep()
		if due("claimState", 600) then
			log("STATE claimable " .. N.claimStateText())
		end
	end
	-- G7 Godly Hatch (bc 62696-62731, GodlyHatchConfig 238682: x100 luck, max x1000, secret rolls x10): its own toggle only
	-- (OWNER_RULES 21: it uses an item up); the hatch loop sends one {Count=1, Godly=true, Auto=false} on the egg it is
	-- hatching (no egg switch, the secret window stays) while a Luck/Mythic window is live.
	local GodlyCfg = nil
	function N.godlyItemName()
		if GodlyCfg == nil then
			GodlyCfg = false
			pcall(function()
				local sharedFolder = ReplicatedStorage:FindFirstChild("Shared")
				local inst = sharedFolder and sharedFolder:FindFirstChild("Pets")
				inst = inst and inst:FindFirstChild("GodlyHatchConfig")
				if inst and inst:IsA("ModuleScript") then
					local mod = require(inst)
					if type(mod) == "table" then
						GodlyCfg = mod
					end
				end
			end)
		end
		return if type(GodlyCfg) == "table" and type(GodlyCfg.ItemName) == "string" then GodlyCfg.ItemName else "Godly Hatch"
	end
	function N.godlyCount()
		return N.itemCount(N.godlyItemName())
	end
	function N.godlyWanted()
		if not on("UseGodlyHatches") or N.godlyCount() < 1 then
			return false
		end
		if N.luckWindowNow then
			local live = N.luckWindowNow()
			if live then
				return true
			end
		end
		return N.eventActive ~= nil and (N.eventActive("Luck") or N.eventActive("Mythic")) == true
	end
	-- G4 (3937 code pass): the server holds one hatch request for HatchAnimationConfig.ShortestReveal(speed, count) (bc
	-- 238857-238866) = a fixed part (card stagger, receipts, poof, card exit, fade) + a part that shrinks with hatch speed
	-- (x8: 1.805 + 3.126 / speed s). The measured Held of the answers decides the split: the fixed part from the formula,
	-- the rest of the measured hold is what speed shortens; without a measurement the formula alone.
	-- N.hatchSpeedGain(x) = the relative gain in eggs per second from x more hatch speed (+10 % speed = +2.7 % to +4.2 %
	-- eggs, not +10 %); every Hatch Speed source (skill nodes, gem upgrade, relics, the Hatch Speed totem) uses it.
	local function holdMedian()
		local list = {}
		for _, v in ipairs(N.Hatch.holds or {}) do
			if N.finite(v) and v > 0 then
				table.insert(list, v)
			end
		end
		if #list == 0 then
			return nil
		end
		table.sort(list)
		return list[math.ceil(#list / 2)]
	end
	function N.hatchHold()
		local count = math.max(tonumber(N.Hatch.count) or (if N.hasX8() then 8 else 3), 1)
		local speed = tonumber(N.Hatch.speed) or 1
		if not N.finite(speed) or speed <= 0 then
			speed = 1
		end
		local fixed, total
		local fn = N.G.HatchAnim.ShortestReveal
		if type(fn) == "function" then
			local okF, f = pcall(fn, 1e6, count)
			local okT, t = pcall(fn, speed, count)
			if okF and okT and N.finite(f) and N.finite(t) and t > f and f > 0 then
				fixed, total = f, t
			end
		end
		if not fixed then
			fixed = 1 + 0.115 * (count - 1)
			total = fixed + 3.126 / speed
		end
		local measured = holdMedian()
		local cycle = if measured and measured > fixed + 0.05 then measured else total
		return fixed, cycle - fixed, cycle, speed, measured ~= nil and measured > fixed + 0.05
	end
	function N.hatchSpeedGain(x)
		x = tonumber(x) or 0
		if not N.finite(x) or x <= 0 then
			return 0
		end
		local fixed, var, cycle = N.hatchHold()
		local after = fixed + var / (1 + x)
		return if after > 0 then cycle / after - 1 else 0
	end
	N.onEvent("EggService.RE.EggHatchResult", function(r)
		if type(r) ~= "table" or r.Success ~= true or type(r.Pets) ~= "table" then
			return
		end
		for _, pet in ipairs(r.Pets) do
			if type(pet) == "table" and type(pet.Id) == "string" and type(pet.Rarity) == "string" and string.match(pet.Rarity, "^Secret") ~= nil and not SR.pending[pet.Id] then
				SR.pending[pet.Id] = os.clock()
				log(string.format("SECRET hatched %s id=%s egg=%s rarity=%s%s", tostring(pet.Name), pet.Id, tostring(r.Egg), pet.Rarity, if pet.AutoDeleted == true then " (auto-deleted)" else ""))
				task.spawn(N.secretRelease, pet)
			end
		end
		if r.Godly == true then
			log(string.format("HATCH godly egg=%s left=%s", tostring(r.Egg), tostring(r.GodlyLeft or N.godlyCount())))
		end
		-- the hold split, measured: once after 3 answers, then hourly
		if #(N.Hatch.holds or {}) >= 3 and due("holdFit", 3600) then
			local fixed, var, cycle, speed, measured = N.hatchHold()
			log(string.format("HATCH hold fit fixed=%.2f var=%.2f/speed held=%.2f speed=%.2f share=%.2f (+10%% speed = +%.1f%% eggs, %s)", fixed, var * speed, cycle, speed, var / cycle, N.hatchSpeedGain(0.1) * 100, if measured then "measured" else "formula"))
		end
	end)

	function N.upgradeValue(name, level)
		if name == "ClickMultiplier" then
			return (1 + (level + 1) / 20) / (1 + level / 20) - 1
		elseif name == "HatchSpeed" then
			-- G4 (3937): the eggs this speed step adds, through the server's hatch hold (N.hatchSpeedGain), not 1:1
			return N.hatchSpeedGain((1 + (level + 1) / 15) / (1 + level / 15) - 1) * N.hatchWeight()
		elseif name == "CriticalChance" then
			-- strategy.md item 1: value the extra crit chance by the FULL crit power P (achievements x mastery x enchant),
			-- not the old 10 x (1 + skill) that ignored the mastery and enchant stack
			local P = N.critStats().P
			local p0, p1 = critChance(level), critChance(level + 1)
			return (p1 - p0) * (P - 1) / (1 + p0 * (P - 1)) * (1 - autoShare())
		elseif name == "AutoClickerSpeed" then
			-- the server admits one tap per 0.1 s across both lanes: a faster Auto Clicker only fills gaps
			return autoShare() * 0.02
		end
		return 0
	end
	function N.upgradeRequirement(name, level)
		if type(N.G.Upgrades.GetRetainedRequirement) == "function" then
			local okZ, z = pcall(N.G.Upgrades.GetRetainedRequirement, name, level)
			if okZ and type(z) == "string" then
				return z
			end
		end
		return nil
	end
	-- Every next level that exists, with its gems, value and the zone it waits for (nil = buyable now).
	function N.upgradeLevels()
		local out = {}
		local data = N.data()
		if not data or type(N.G.Upgrades.GetPrice) ~= "function" then
			return out
		end
		local levels = N.sub(data, "Upgrades")
		for name, def in pairs(N.tableOr(N.G.Upgrades.Definitions)) do
			if type(def) == "table" and def.SkillTreeNode == nil and name ~= "Teleport" and (N.Spend.refused["upgrade " .. name] or 0) < os.clock() then
				local level = math.floor(tonumber(levels[name]) or 0)
				local total = tonumber(def.LaunchTotal) or 0
				if level < total then
					local okP, price = pcall(N.G.Upgrades.GetPrice, name, level + 1)
					local value = N.upgradeValue(name, level)
					if okP and type(price) == "number" and value > 0 then
						local zone = N.upgradeRequirement(name, level)
						-- REV-2: when PROBE upgrade_zone_gate showed the zone is only a client gate, a zone-gated level is buyable
						local gated = zone and not N.zoneUnlocked(zone) and N.probeState("upgrade_zone_gate") ~= "accepted"
						table.insert(out, { kind = "upgrade", name = name, cost = price, value = value, level = level + 1, zone = if gated then zone else nil, gate = if zone and not N.zoneUnlocked(zone) then zone else nil })
					end
				end
			end
		end
		return out
	end
	function N.upgradeOptions()
		local out = {}
		for _, o in ipairs(N.upgradeLevels()) do
			if o.zone == nil then
				table.insert(out, o)
			end
		end
		return out
	end
	-- UI-2: what the Upgrades panel says when every next level waits for a zone.
	N.ZonesAbsentText = "Zones are not in this game version yet; the game keeps these upgrades locked"
	function N.upgradeLockText()
		local zones = {}
		for _, o in ipairs(N.upgradeLevels()) do
			if o.zone and not table.find(zones, o.zone) then
				table.insert(zones, o.zone)
			end
		end
		if #zones == 0 then
			return nil
		end
		-- R5-1 / R6-4: the map sweep found no zone in this game version
		if N.zonesAbsent and N.zonesAbsent() then
			return N.ZonesAbsentText
		end
		local first = zones[1]
		for _, u in ipairs(N.nextUnlocks()) do
			if u.kind == "zone" then
				first = u.name
				break
			end
		end
		local wait = (N.Unlock.refused[first] or 0) - os.clock()
		return string.format("Locked: unlock the %s zone first (%s)", first, if wait > 0 then "next try in " .. N.longTime(wait) elseif N.does("AutoUnlockZones") then "Auto Unlock Zones is on it" else "turn on Auto Unlock Zones")
	end
	-- REV-2 PROBE upgrade_zone_gate: is the zone requirement checked by the server at all? One purchase of the best gated
	-- level the gems pay for, from where the player stands; Success = the zone is only a client gate (every gated level is
	-- buyable from now on), a zone answer = rejected (the zones first), a distance answer = the station decides (state
	-- "station": the next try is made standing in the Winter Upgrades point when its spot is known). Once per game version.
	function N.zoneGateProbe(planner)
		local state = N.probeState("upgrade_zone_gate")
		if state == "accepted" or state == "rejected" then
			return false
		end
		local gems = N.gems()
		local pick
		for _, o in ipairs(N.upgradeLevels()) do
			if o.zone and o.cost <= gems and (not pick or o.value / o.cost > pick.value / pick.cost) then
				pick = o
			end
		end
		if not pick then
			return false
		end
		if state == "station" then
			local point = N.upgradePoint()
			if not point or not N.insidePoint(point) then
				return false
			end
		end
		local before = math.floor(tonumber(N.sub(N.data(), "Upgrades")[pick.name]) or 0)
		local result = invoke("UpgradeService.RF.Purchase", { Name = pick.name })
		local reason = string.lower(tostring(type(result) == "table" and (result.Reason or result.Error or result.Message) or "no answer"))
		if ok(result) then
			N.probeResult("upgrade_zone_gate", "accepted", string.format("gain=%s %d->%d without the %s zone", pick.name, before, before + 1, pick.zone), "accepted")
			log(string.format("UPGRADE %s %d->%d gems=%s value=+%.2f%%", pick.name, before, before + 1, formatNumber(pick.cost), pick.value * 100))
			Session.buys += 1
			return true
		end
		if string.find(reason, "zone", 1, true) or string.find(reason, "lock", 1, true) or string.find(reason, "require", 1, true) then
			N.probeResult("upgrade_zone_gate", "rejected", "gain=0 (" .. reason .. "): the " .. pick.zone .. " zone first", "rejected")
		elseif state ~= "station" and (string.find(reason, "far", 1, true) or string.find(reason, "near", 1, true)) then
			N.probeResult("upgrade_zone_gate", "station", "gain=? (" .. reason .. "): decided at the Winter Upgrades point", "station")
		else
			N.probeResult("upgrade_zone_gate", "rejected", "gain=0 (" .. reason .. ")", "rejected")
		end
		return false
	end
	-- Plain toggle: the cheapest affordable thing. Planner: the best value per gem; when the best one overall is not
	-- affordable yet but the gem income reaches it within 15 minutes, the gems wait for it (farming goes on meanwhile).
	function N.pickSpend(planner, wantSkill, wantUpgrade)
		local gems = N.gems()
		local options = if wantSkill then N.skillOptions() else {}
		if wantUpgrade then
			for _, o in ipairs(N.upgradeOptions()) do
				table.insert(options, o)
			end
		end
		local best, bestAll
		for _, o in ipairs(options) do
			o.score = if o.cost <= 0 then math.huge else o.value / o.cost
			if planner then
				if o.value > 0 and (not bestAll or o.score > bestAll.score) then
					bestAll = o
				end
				if o.cost <= gems and o.value > 0 and (not best or o.score > best.score) then
					best = o
				end
			elseif o.cost <= gems and (not best or o.cost < best.cost) then
				best = o
			end
		end
		if planner and bestAll and best ~= bestAll and bestAll.cost > gems then
			local rate = N.Plan and N.Plan.gemRate or 0
			if rate > 0 and (bestAll.cost - gems) / rate < 900 then
				N.Spend.pick = bestAll
				return nil, bestAll
			end
		end
		N.Spend.pick = best
		return best
	end
	-- The upgrades that need the Winter station trip right now (remote purchase answered with a distance reason).
	function N.upgradeTripWanted(planner)
		-- REV-2: the zone-gate probe answered with a distance: one station visit decides it (Winter itself may be locked)
		local gateAtStation = N.probeState("upgrade_zone_gate") == "station"
		if gateAtStation then
			local gems = N.gems()
			for _, o in ipairs(N.upgradeLevels()) do
				if o.zone and o.cost <= gems then
					return { o }, o.value
				end
			end
		end
		if N.probeState("upgrade_remote") ~= "rejected" or not N.zoneUnlocked("Winter") then
			return nil
		end
		local gems = N.gems()
		local list = {}
		for _, o in ipairs(N.upgradeOptions()) do
			if o.cost <= gems then
				table.insert(list, o)
			end
		end
		if #list == 0 then
			return nil
		end
		table.sort(list, function(a, b)
			return a.value / a.cost > b.value / b.cost
		end)
		local value = 0
		for _, o in ipairs(list) do
			value += o.value
		end
		return list, value
	end
	local function distanceReason(result)
		local reason = string.lower(tostring(type(result) == "table" and (result.Reason or result.Error or result.Message) or ""))
		return string.find(reason, "far", 1, true) ~= nil or string.find(reason, "near", 1, true) ~= nil or string.find(reason, "range", 1, true) ~= nil or string.find(reason, "distance", 1, true) ~= nil
	end
	local function buyUpgrade(o, planner)
		local before = math.floor(tonumber(N.sub(N.data(), "Upgrades")[o.name]) or 0)
		local result = invoke("UpgradeService.RF.Purchase", { Name = o.name })
		if ok(result) then
			Session.buys += 1
			N.Spend.last = string.format("upgrade %s %d -> %d for %s gems", o.name, before, before + 1, formatNumber(o.cost))
			log(string.format("UPGRADE %s %d->%d gems=%s value=+%.2f%%", o.name, before, before + 1, formatNumber(o.cost), o.value * 100))
			if N.Events.bought then
				pcall(N.Events.bought, o.name, o.cost)
			end
			return true, result
		end
		return false, result
	end
	function N.spendStep(planner, wantSkill, wantUpgrade)
		if wantUpgrade and N.zoneGateProbe(planner) then
			return true
		end
		local remote = N.probeState("upgrade_remote")
		local pick, waitingFor = N.pickSpend(planner, wantSkill, wantUpgrade and remote ~= "rejected")
		if not pick then
			if waitingFor then
				N.Spend.last = string.format("saving gems for %s (%s gems) while farming", waitingFor.name, formatNumber(waitingFor.cost))
			end
			return false
		end
		local text = string.format("%s %s for %s gems (value %.3f)", if pick.kind == "skill" then "skill" else "upgrade", pick.name, formatNumber(pick.cost), pick.value)
		-- R3-3: a big gem buy is announced 10 s ahead (and waits for the owner's OK above his budget)
		if N.gemGate and not N.gemGate("spend " .. pick.name, pick.cost, string.format("%s %s for %s gems (+%.2f %% income)", if pick.kind == "skill" then "skill" else "upgrade", pick.name, formatNumber(pick.cost), pick.value * 100)) then
			return false
		end
		if planner and N.planLog then
			N.planLog("spend " .. pick.name, "buy " .. text, 600, 0)
		end
		if pick.kind == "upgrade" then
			local okBuy, result = buyUpgrade(pick, planner)
			if okBuy then
				if remote == "untested" then
					N.probeResult("upgrade_remote", "accepted", "gain=no trip (bought " .. pick.name .. " from " .. N.currentIsland() .. ")", "accepted")
				end
				return true
			end
			if distanceReason(result) then
				if remote ~= "rejected" then
					N.probeResult("upgrade_remote", "rejected", "gain=0 (" .. brief(result) .. "), upgrades go through the Winter station", "rejected")
				end
				N.Spend.last = "upgrades wait for the trip to the Winter station"
				return false
			end
			N.Spend.refused["upgrade " .. pick.name] = os.clock() + 600
			N.Spend.last = pick.name .. " refused (" .. tostring(type(result) == "table" and (result.Reason or result.Message) or "no answer") .. ")"
			log("BUY refused", text, brief(result))
			return false
		end
		local result = invoke("SkillTreeService.RF.Unlock", { Name = pick.name })
		if ok(result) then
			Session.buys += 1
			N.Spend.last = "bought " .. text
			log("BUY", text)
			if N.Events.bought then
				pcall(N.Events.bought, pick.name, pick.cost)
			end
			return true
		end
		N.Spend.refused[pick.kind .. " " .. pick.name] = os.clock() + 600
		N.Spend.last = pick.name .. " refused (" .. tostring(type(result) == "table" and (result.Reason or result.Message) or "no answer") .. ")"
		log("BUY refused", text, brief(result))
		return false
	end
	-- The Upgrades InteractionPoint of the Winter zone (attribute Island = "Winter").
	function N.upgradePoint()
		for _, p in ipairs(game:GetService("CollectionService"):GetTagged("InteractionPoint")) do
			if p.Name == "Upgrades" and p:GetAttribute("Island") == "Winter" and p:IsDescendantOf(workspace) then
				return p
			end
		end
		return nil
	end
	-- One trip: Teleport menu to Winter, stand in the Upgrades point, buy every affordable level by value per gem (at most
	-- 40 calls), back to the egg through the arbiter. Hard cap 30 s.
	function N.upgradeTrip()
		local list = N.upgradeTripWanted(true)
		if not list then
			return 0
		end
		-- R3-3: the batch is announced 10 s ahead when it is a big share of the gems
		local total = 0
		for _, o in ipairs(list) do
			total += o.cost
		end
		if N.gemGate and not N.gemGate("upgrades", total, string.format("gem upgrades %s for %s gems", list[1].name, formatNumber(total))) then
			return 0
		end
		N.tripBegin("upgrades")
		local started = os.clock()
		N.loopStatus("Main", "buying gem upgrades at the Winter station")
		local bought = 0
		-- REV-2: with Winter still locked the station is reached by its spot (learned or found on the main map), not the menu
		local there = if N.zoneUnlocked("Winter") then N.travel("Winter") else N.travel("Spawn")
		if there then
			local point = N.findStreamed("UpgradeStation", N.upgradePoint, 5, not N.zoneUnlocked("Winter"))
			if point then
				local pos = N.posOf(point)
				N.teleport(pos + Vector3.new(0, 1, 0), 0.4)
				if N.probeState("upgrade_zone_gate") == "station" and N.zoneGateProbe(true) then
					bought += 1
				end
				local calls = 0
				while calls < 40 and os.clock() - started < 30 and alive() do
					local options = N.upgradeOptions()
					table.sort(options, function(a, b)
						return a.value / a.cost > b.value / b.cost
					end)
					local o = options[1]
					if not o or o.cost > N.gems() then
						break
					end
					calls += 1
					local okBuy, result = buyUpgrade(o, true)
					if okBuy then
						bought += 1
					else
						N.Spend.refused["upgrade " .. o.name] = os.clock() + 600
						log("UPGRADE", o.name, "refused at the station:", brief(result))
					end
					task.wait(0.15)
				end
			else
				log("UPGRADE station not found in the Winter zone")
				N.Spend.refused["upgrade trip"] = os.clock() + 1800
			end
		end
		N.Spend.tripAt = os.clock()
		N.tripEnd()
		return bought
	end

	-- ===== Islands and zones (G5-9, B2): the client sends IslandService.RE.IslandUnlockRequested / WorldService.RE.
	-- ZoneUnlockRequested {Action="Purchase", ...} only from the confirm dialog of a server-sent IslandPortalEncountered /
	-- PortalEncountered {Action="Purchase"} (3097 L128349-128366, L160644-160665): the player has to stand in the portal
	-- (Workspace.Portals.Portals.<PortalName>.Portal, Workspace.Zones.Portals.<Zone>.Portal.Portal, L128243-128268,
	-- L160422-160442). A blind purchase did nothing live. Coins only. Value (G5-3): the location multiplier of a zone counts
	-- 0 while the account farms on an island (TapFormula.GetLocationMultiplier L387736-387745 takes the island's); a zone is
	-- worth the gem upgrades it opens (Winter: Click Multiplier 1-5 ...), an island its multiplier on the taps. =====
	N.Unlock = { last = "", refused = {}, encounter = nil }
	N.onEvent("IslandService.RE.IslandPortalEncountered", function(p)
		if type(p) == "table" and (p.Action == "Purchase" or p.Action == "Blocked") then
			N.Unlock.encounter = { island = p.Island, action = p.Action, reason = p.Reason, price = tonumber(p.Price), at = os.clock() }
		end
	end)
	-- R3-5: the zone price the server names in the encounter is the one logged (the config said 1M, the Forest egg 2M)
	N.onEvent("WorldService.RE.PortalEncountered", function(p)
		if type(p) == "table" and (p.Action == "Purchase" or p.Action == "Blocked") then
			N.Unlock.encounter = { zone = p.Zone, action = p.Action, reason = p.Reason, price = tonumber(p.Price), at = os.clock() }
		end
	end)
	function N.nextUnlocks()
		local out = {}
		local islands = {}
		for name, info in pairs(N.tableOr(N.G.Islands.Islands)) do
			if type(info) == "table" then
				table.insert(islands, { name = name, order = tonumber(info.Order) or 99, price = tonumber(info.Price) or math.huge, portal = info.PortalName, mult = tonumber(info.Multiplier) or 1 })
			end
		end
		table.sort(islands, function(a, b)
			return a.order < b.order
		end)
		for _, i in ipairs(islands) do
			if not N.islandUnlocked(i.name) then
				table.insert(out, { kind = "island", name = i.name, price = i.price, portal = i.portal, mult = i.mult })
				break
			end
		end
		local zones = {}
		for name, info in pairs(N.tableOr(N.G.Progression.Zones)) do
			if type(info) == "table" and name ~= "Spawn" then
				table.insert(zones, { name = name, order = tonumber(info.Order) or 99, price = tonumber(info.Price) or math.huge, mult = tonumber(info.Multiplier) or 1 })
			end
		end
		table.sort(zones, function(a, b)
			return a.order < b.order
		end)
		local prev = "Spawn"
		-- R5-1: no zone is offered when a full map sweep of this game version found none (PROBE zone_portals=absent)
		if N.zonesAbsent and N.zonesAbsent() then
			zones = {}
		end
		for _, z in ipairs(zones) do
			if not N.zoneUnlocked(z.name) then
				table.insert(out, { kind = "zone", name = z.name, price = z.price, mult = z.mult, from = prev })
				break
			end
			prev = z.name
		end
		table.sort(out, function(a, b)
			return a.price < b.price
		end)
		return out
	end
	-- The value of an unlock in seconds of income over 24 h (the planner's horizon).
	function N.unlockValue(u)
		if u.kind == "island" then
			local cur = N.tableOr(N.islandInfo(N.currentIsland()))
			local best = 1
			for name, info in pairs(N.tableOr(N.G.Islands.Islands)) do
				if type(info) == "table" and N.islandUnlocked(name) then
					best = math.max(best, tonumber(info.Multiplier) or 1)
				end
			end
			best = math.max(best, tonumber(cur.Multiplier) or 1)
			return math.max(u.mult / best - 1, 0) * 86400
		end
		-- a zone: the gem upgrades it (and the zones after it) open, as long as the gems pay for the first level
		local value = 0
		local gems = N.gems()
		local order = N.tableOr(N.tableOr(N.G.Progression.Zones)[u.name]).Order or 99
		for _, o in ipairs(N.upgradeLevels()) do
			if o.zone and o.cost <= gems then
				local zo = N.tableOr(N.tableOr(N.G.Progression.Zones)[o.zone]).Order or 99
				if zo >= order then
					value += o.value
				end
			end
		end
		-- the location multiplier counts only while the account farms in the zones (no island egg)
		if not N.islandInfo(N.eggIsland(N.Hatch.target or "")) and not N.islandInfo(N.currentIsland()) then
			value += math.max(u.mult - 1, 0) * 0.1
		end
		return value * 86400
	end
	local function unlocked(u)
		return if u.kind == "island" then N.islandUnlocked(u.name) else N.zoneUnlocked(u.name)
	end
	local function purchase(u)
		if u.kind == "island" then
			return fire("IslandService.RE.IslandUnlockRequested", { Action = "Purchase", Island = u.name })
		end
		return fire("WorldService.RE.ZoneUnlockRequested", { Action = "Purchase", Zone = u.name })
	end
	-- The touch part of the portal: the BasePart named Portal inside the portal Model (3097 getForwardPortal
	-- L160227-160242, getVisiblePortalPart L160244-160258). Only a BasePart counts: live R2-9/R2-12 the zone containers
	-- exist but are EMPTY until streamed in, and the old fallback returned the empty folder ("result=no portal" at once).
	local function portalPart(u)
		local model
		if u.kind == "island" then
			local portals = workspace:FindFirstChild("Portals")
			portals = portals and portals:FindFirstChild("Portals")
			model = portals and portals:FindFirstChild(u.portal or u.name)
		else
			local zones = workspace:FindFirstChild("Zones")
			local portals = zones and zones:FindFirstChild("Portals")
			local z = portals and portals:FindFirstChild(u.name)
			model = z and z:FindFirstChild("Portal")
		end
		if not model then
			return nil
		end
		if model:IsA("BasePart") then
			return model
		end
		local inner = model:FindFirstChild("Portal")
		if inner and inner:IsA("BasePart") then
			return inner
		end
		return nil
	end
	-- One unlock trip: to the map the portal stands on, into the portal, wait for the encounter, buy, confirm.
	function N.unlockTrip(u)
		if not u or unlocked(u) or (N.Unlock.refused[u.name] or 0) > os.clock() then
			return false
		end
		-- R5-1 (live: the second trip at 111 s went to the Spawn only to log "no portal on the map"): a zone whose portal is
		-- not known waits for the sweep's verdict without a trip
		if u.kind == "zone" and not N.place("ZonePortal" .. string.gsub(u.name, "%W", "")) then
			local absent = N.zonesAbsent and N.zonesAbsent()
			local missAt = N.ZoneSweep and N.ZoneSweep.missAt
			if absent or (missAt and os.clock() - missAt < 3600) then
				N.Unlock.refused[u.name] = if absent then math.huge else missAt + 3600
				N.Unlock.last = if absent then "" else u.name .. ": portal not found on the map, next search in " .. N.longTime(math.max(missAt + 3600 - os.clock(), 0))
				return false
			end
		end
		N.tripBegin("unlock")
		local started = os.clock()
		N.loopStatus("Main", "unlocking the " .. u.name .. " " .. u.kind)
		local result = "no portal"
		local encounterAt = nil
		local portalAt = nil
		if N.travel(if u.kind == "zone" then (u.from or "Spawn") else "Spawn") then
			-- streamed in near the player after the travel; a spot found once is remembered (Corvus/TAPSIM_places.txt); with
			-- no known spot the main map's landmarks are streamed one after another until the portal shows up (R3-2/R3-5)
			local placeKey = (if u.kind == "zone" then "ZonePortal" else "IslandPortal") .. string.gsub(u.name, "%W", "")
			local part = nil
			if u.kind == "zone" and not N.place(placeKey) then
				-- R4-1: no spot known for this zone's portal: it may have streamed in after the travel (the next zone's portal
				-- stands in the zone before it); else the background map sweep looks for it while the hub hatches on
				part = waitFor(function()
					return portalPart(u) ~= nil
				end, 1.5) and portalPart(u)
				if part then
					N.learnPlace(placeKey, N.posOf(part))
				else
					local state = N.zoneSweepStart(u.name)
					if state == "found" then
						part = N.findStreamed(placeKey, function()
							return portalPart(u)
						end, 3, false)
					else
						result = if state == "searching" then "searching (map sweep running)" else "no portal on the map (next sweep in 60 min)"
					end
				end
			else
				part = N.findStreamed(placeKey, function()
					return portalPart(u)
				end, 3, u.kind ~= "zone")
			end
			local pos = part and N.posOf(part)
			portalAt = pos
			if pos then
				N.Unlock.encounter = nil
				N.teleport(pos, 0.2)
				local function seen()
					return N.Unlock.encounter ~= nil or unlocked(u)
				end
				-- the server notices the player in the portal by touch: if it stays quiet, step through the portal twice
				if not waitFor(seen, 1.5) then
					N.portalNudge(pos)
				end
				if waitFor(seen, 1.5) then
					encounterAt = os.clock() - started
				end
				local enc = N.Unlock.encounter
				if unlocked(u) then
					result = "ok"
				elseif enc and enc.action == "Blocked" then
					result = "blocked (" .. tostring(enc.reason or "unlock the previous one first") .. ")"
				else
					-- the rebirths wait while this trip runs (p03 rebirthTick): the coins for the price come back within seconds
					local need = math.max(u.price, (enc and enc.price) or 0)
					if N.coins() < need then
						waitFor(function()
							return N.coins() >= need
						end, 15)
					end
					purchase(u)
					result = if waitFor(function()
						return unlocked(u)
					end, 4) then "ok" else (if enc then "refused" else "no encounter")
				end
			end
		end
		local encPrice = N.Unlock.encounter and N.Unlock.encounter.price
		log(string.format("UNLOCK %s %s portal=%s encounter=%s result=%s price=%s%s", u.kind, u.name, if portalAt then brief(portalAt) else "not found", if encounterAt then string.format("%.1fs", encounterAt) else "none", result, formatNumber(encPrice or u.price), if encPrice and encPrice ~= u.price then " (config " .. formatNumber(u.price) .. ")" else ""))
		N.tripEnd()
		if result == "ok" then
			Session.unlocks += 1
			N.Unlock.last = "unlocked " .. u.name
			N.incomeSpend(u.price)
			if N.Events.bought then
				pcall(N.Events.bought, u.name, u.price)
			end
			return true
		end
		if string.sub(result, 1, 9) == "searching" then
			-- R4-1: the sweep clears this as soon as the portal streams in (N.notePortal); its cap is 90 s
			N.Unlock.refused[u.name] = os.clock() + 95
			N.Unlock.last = u.name .. ": searching the map for its portal (up to 90 s)"
		elseif string.sub(result, 1, 20) == "no portal on the map" and N.ZoneSweep and N.ZoneSweep.missAt then
			N.Unlock.refused[u.name] = N.ZoneSweep.missAt + 3600
			N.Unlock.last = u.name .. ": portal not found on the map, next search in " .. N.longTime(math.max(N.ZoneSweep.missAt + 3600 - os.clock(), 0))
		else
			N.Unlock.refused[u.name] = os.clock() + 900
			N.Unlock.last = u.name .. ": " .. result .. ", next try in 15 min"
		end
		return false
	end
	-- Plain toggles (Auto Unlock Zones / Islands, no planner): the next one as soon as the coins pay for it.
	function N.unlockStep(budget, why, wantZone, wantIsland)
		for _, u in ipairs(N.nextUnlocks()) do
			if ((u.kind == "zone" and wantZone) or (u.kind == "island" and wantIsland)) and u.price <= budget and (N.Unlock.refused[u.name] or 0) < os.clock() then
				return N.unlockTrip(u)
			end
		end
		return false
	end
end
