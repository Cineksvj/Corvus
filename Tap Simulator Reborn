	-- ok, status code, decoded body (Discord's 429 carries retry_after)
	local function postWebhook(url, payload)
		if not validWebhook(url) then
			return false, 0, nil
		end
		local response = httpRequest({
			Url = url,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(payload),
		})
		local code = response and tonumber(response.StatusCode) or 0
		local body
		if type(response) == "table" and type(response.Body) == "string" then
			local okD, data = pcall(HttpService.JSONDecode, HttpService, response.Body)
			if okD and type(data) == "table" then
