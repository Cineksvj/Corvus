	local function onlyKeys(t, keys)
		if type(t) ~= "table" then
			return false
		end
		for k in pairs(t) do
			if not keys[k] then
				return false
			end
		end
		return true
	end
	local function unique(list, max)
		if type(list) ~= "table" or #list == 0 or #list > max then
			return false
		end
		local seen = {}
		for _, id in ipairs(list) do
			if not isStr(id) or seen[id] then
				return false
			end
			seen[id] = true
		end
		return true
	end
