	-- The potion machine (Workspace.Map1.PotionMachine, "Walk up to the potion machine first"): Buy(1|3|10) on its
	-- cooldowns (Data.PotionMachine.Cooldown1/3/10, os.time), Brew(potion, slot) in free slots (3 x 300 s at the Buy(1)
	-- price), ClaimAll when a slot is ready, Craft(output, n) = 3 x Potion I -> Potion II. Gems above the reserve only.
	-- R13 claimOnly: the finished brews only (a free claim, the gems went in when they started): no buy, brew or merge.
	function N.potionWork(claimOnly)
		local data = N.data()
		if not data then
			return nil
		end
		if claimOnly then
			local now = os.time()
			for _, s in pairs(N.sub(N.sub(data, "PotionMachine"), "Slots")) do
				if type(s) == "table" and tonumber(s.ReadyAt) and s.ReadyAt <= now then
					return { claim = true, brew = {}, buy = {}, craft = {}, gems = 0, price1 = 0, claimOnly = true }
				end
			end
			return nil
		end
		local pm = N.sub(data, "PotionMachine")
		local slots = N.sub(pm, "Slots")
		local now = os.time()
		local work = { claim = false, brew = {}, buy = {}, craft = {} }
		local free = {}
		for i = 1, tonumber(W.Brew.SlotCount) or 3 do
			local s = slots[tostring(i)]
			if type(s) == "table" then
				if tonumber(s.ReadyAt) and s.ReadyAt <= now then
					work.claim = true
				end
			else
				table.insert(free, i)
			end
		end
		local reserve = if N.planner() and N.Spend.pick then N.Spend.pick.cost else 0
		local gems = N.gems() - reserve
		local rebirths = N.rebirths()
		local price1 = math.huge
		if type(W.Machine.GetPrice) == "function" then
			local okP, p = pcall(W.Machine.GetPrice, 1, rebirths)
			price1 = if okP and type(p) == "number" then p else math.huge
		end
		-- B16: the brew slots make Coins Potion I (3 of them merge into a Coins Potion II, +50 % coins)
		local brewList = N.tableOr(W.Brew.Potions)
		local pick = "Coins Potion I"
		if not table.find(brewList, pick) then
			pick = brewList[1]
		end
		work.price1 = price1
		work.gems = 0
		for _, slot in ipairs(free) do
			if pick and gems >= price1 then
				table.insert(work.brew, { potion = pick, slot = slot })
				gems -= price1
				work.gems += price1
			end
		end
		for _, n in ipairs({ 1, 3, 10 }) do
			local cd = tonumber(pm["Cooldown" .. n]) or 0
			if cd - now <= 0 and type(W.Machine.GetPrice) == "function" then
				local okP, p = pcall(W.Machine.GetPrice, n, rebirths)
				if okP and type(p) == "number" and gems >= p then
