	-- at its next check of the generation).
	N.LoopBeat = {}
	local LoopGen, LoopBody, LoopThread = {}, {}, {}
	local function loop(name, body)
		LoopGen[name] = (LoopGen[name] or 0) + 1
		LoopBody[name] = body
		local myGen = LoopGen[name]
		N.LoopBeat[name] = os.clock()
		LoopThread[name] = task.spawn(function()
			while alive() and LoopGen[name] == myGen do
				N.LoopBeat[name] = os.clock()
				local started = os.clock()
				local gen = N.Trip.gen
				local ok, err = xpcall(body, debug.traceback)
				if not ok then
					N.loopStatus(name, "error: " .. reportError(name, err))
					-- REV-1: an error that escaped a trip in this loop never leaves the trip open
					if name == "Main" and N.Trip.active and N.Trip.gen ~= gen then
						log("TRIP " .. tostring(N.Trip.name) .. " ended after the Main loop error")
						N.tripEnd()
						N.PetLock.craft = false
					end
					task.wait(1)
				elseif os.clock() == started then
					-- A body that returned without yielding: give the game a frame.
					task.wait()
				end
			end
		end)
	end
	local RestartAt = {}
	function N.restartLoop(name, why)
		local body = LoopBody[name]
		if not body or os.clock() - (RestartAt[name] or -1e9) < 30 then
			return false
		end
		RestartAt[name] = os.clock()
		local old = LoopThread[name]
		logProblem(string.format("%s loop hung %ds in: %s (%s), restarted", name, math.floor(os.clock() - (N.LoopBeat[name] or os.clock())), tostring(if name == "Main" then Status else N.LoopStatus[name]), tostring(why)))
		if old and old ~= coroutine.running() then
			pcall(task.cancel, old)
		end
