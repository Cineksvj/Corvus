			N.loopStatus("Main", "running your Craft now")
			task.wait(0.3)
			return
		end
		if N.Trip.active then
			task.wait(0.3)
			return
		end
		if not N.alive() then
			N.loopStatus("Main", "waiting for the character")
			task.wait(0.5)
			return
		end
		-- Priority: the groups in the player's order; the first with something to do runs, the lower ones wait this turn.
		for _, name in ipairs(N.priorityOrder()) do
			local g = Groups[name]
			if g and groupRun(name, g.run) then
