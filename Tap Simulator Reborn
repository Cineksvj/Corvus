		local done = 0
		if N.travel("Spawn") then
			-- R2-10/R2-12: the machine streams in near (-353.6, -519.5, -4732); R4-3: the stand is the middle of its Circle
			local model = N.findStreamed("PotionMachine", potionMachine, 5, true)
			local stand = model and (waitFor(function()
				return model:FindFirstChild("Circle") ~= nil
			end, 1) or true) and potionStand(model)
			if stand then
				N.teleport(stand, 0.4)
				local r, far = machineCalls(work, false)
				if far then
					-- R4-3: stand on the Circle once more and finish the visit (claim, buy, brew) before going back
					N.teleport(potionStand(model) or stand, 0.8)
					local again = N.potionWork(claimOnly)
					if again then
						local r2
						r2, far = machineCalls(again, false)
						r.done += r2.done
						r.claimed = r.claimed or r2.claimed
						r.bought += r2.bought
						r.brewed += r2.brewed
						r.merged += r2.merged
					end
				end
				done = r.done
				N.World.potionRetry = far and done == 0
				N.World.last.potionMachine = visitText(r, "at the machine")
				if far then
					log(string.format("POTION machine still TooFar standing at %s (Circle %s), next try in 1 min", brief(N.myPos() or stand), if model:FindFirstChild("Circle") then "yes" else "no"))
				end
			else
				log("POTION machine not found near the spawn")
			end
		end
		N.tripEnd()
		return done
	end

	-- ===== World events (WorldEventConfig 90580-90993, GlobalEventSchedule 90356-90387) =====
	-- Balloons (BalloonPartyService.RE.Hit(Uid), HitRange 150, 0.1 s per balloon) and pigs (PigsCouldFlyService.RE.Hit(Uid),
	-- HitRange 120, 0.5 s per pig) fly around the player: hit by uid from the event loop, no movement. probes
	-- balloon_parallel / pig_instant: several balloons in the same 0.1 s window, a pig hit right after it launches.
	N.Sky = { balloons = {}, pigs = {}, popped = 0, caught = 0, parallelSeen = false, pigFast = 0 }
	local Sky = N.Sky
	-- R7-1: the launch records end with their flight also while Auto Balloons / Auto Pigs are off (skyStep prunes them only
	-- while the toggle runs; the game launches them all day)
	local function pruneSky(list, maxAge)
		local now = os.clock()
		for uid, b in pairs(list) do
			if now - b.at > maxAge then
				list[uid] = nil
			end
		end
	end
	N.onEvent("BalloonPartyService.RE.Launched", function(p)
		if type(p) == "table" and type(p.Uid) == "string" and not string.find(p.Uid, "[\128-\255]") then
			pruneSky(Sky.balloons, 27)
			Sky.balloons[p.Uid] = { at = os.clock(), last = -1e9, hits = 0 }
		end
	end)
	N.onEvent("BalloonPartyService.RE.Popped", function(uid)
		if type(uid) == "table" then
			uid = uid.Uid
		end
		if Sky.balloons[uid] then
			Sky.balloons[uid] = nil
			Sky.popped += 1
		end
	end)
	N.onEvent("PigsCouldFlyService.RE.Launched", function(p)
		if type(p) == "table" and type(p.Uid) == "string" and not string.find(p.Uid, "[\128-\255]") then
			pruneSky(Sky.pigs, 42)
			Sky.pigs[p.Uid] = { at = os.clock(), last = -1e9 }
		end
	end)
	N.onEvent("PigsCouldFlyService.RE.Caught", function(uid, userId)
		if type(uid) == "table" then
			uid, userId = uid.Uid, uid.UserId
		end
		local pig = Sky.pigs[uid]
		if pig then
			Sky.pigs[uid] = nil
			if userId == LocalPlayer.UserId then
				Sky.caught += 1
				if N.probeState("pig_instant") == "untested" then
					if os.clock() - pig.at < 1 then
						N.probeResult("pig_instant", "accepted", string.format("gain=caught %.1fs after launch", os.clock() - pig.at))
					elseif (pig.firstHitAt or 9) < 1 and (pig.hits or 0) >= 2 then
						-- the first hit (under 1 s after the launch) did not count, a later one did
						N.probeResult("pig_instant", "rejected", string.format("gain=0 (caught on hit %d, %.1fs after launch)", pig.hits, os.clock() - pig.at))
					end
				end
			end
		end
	end)
	N.onEvent("PigsCouldFlyService.RE.Retired", function(uid)
		if type(uid) == "table" then
			uid = uid.Uid
		end
		Sky.pigs[uid] = nil
	end)
	function N.knownBalloon(uid)
		return type(uid) == "string" and Sky.balloons[uid] ~= nil
	end
	function N.knownPig(uid)
		return type(uid) == "string" and Sky.pigs[uid] ~= nil
	end
	-- One pass of the sky collectors (called every 0.1 s by the event loop); at most 20 hits a pass (flood limit 40/s).
	function N.skyStep()
		local now = os.clock()
		local sent = 0
		if N.does("AutoBalloons") then
			local sameWindow = 0
			-- REV-13 fallback: when several balloons hit in the same 0.1 s window did not pop (balloon_parallel rejected), one
			-- balloon per window
			local perWindow = if N.probeState("balloon_parallel") == "rejected" then 1 else 20
			for uid, b in pairs(Sky.balloons) do
				if now - b.at > 27 then
					Sky.balloons[uid] = nil
				elseif now - b.last >= 0.1 and sent < perWindow then
					b.last = now
					b.hits += 1
					sent += 1
					sameWindow += 1
					fire("BalloonPartyService.RE.Hit", uid)
				end
			end
			if sameWindow >= 2 and not Sky.parallelSeen then
				Sky.parallelSeen = true
				Sky.parallelAt = now
				Sky.poppedBefore = Sky.popped
			end
			if Sky.parallelAt and now - Sky.parallelAt > 10 and N.probeState("balloon_parallel") == "untested" then
				local gain = Sky.popped - (Sky.poppedBefore or 0)
				N.probeResult("balloon_parallel", if gain >= 2 then "accepted" else "rejected", "gain=" .. gain .. " balloons in 10 s")
				Sky.parallelAt = nil
			end
		end
		if N.does("AutoPigs") then
			-- REV-13: pig_instant rejected (a hit right after the launch did not catch the pig, a later one did): the first hit
			-- waits 1 s after the launch
			local firstAfter = if N.probeState("pig_instant") == "rejected" then 1 else 0
			for uid, pig in pairs(Sky.pigs) do
				if now - pig.at > 42 then
					Sky.pigs[uid] = nil
				elseif now - pig.last >= 0.5 and now - pig.at >= firstAfter and sent < 20 then
					pig.last = now
					pig.hits = (pig.hits or 0) + 1
					if pig.hits == 1 then
						pig.firstHitAt = now - pig.at
					end
					sent += 1
					fire("PigsCouldFlyService.RE.Hit", uid)
				end
			end
		end
		return sent
	end
	-- Cloud Rain (every 1800 s for 120 s): 36 pickups (WorldEventConfig CloudRain MaxPickups 36, PickupSize 6, HoverHeight
	-- 5, 3097 L90320-90350) tagged CloudRainPickup (attributes Uid, Kind) on the cloud pieces of CloudRoute, CloudGeneration
	-- and the islands, collected by touch on the server; RF.GetCollected() lists mine (CloudRain controller 246210-246325).
	-- REV-6 (live `WORLD cloudRain 7 pickups in 2s`): with StreamingEnabled only the pickups near the character exist on the
	-- client, so the trip collects what it sees (nearest first, CFrame onto each), then sweeps the cloud route (streamed
	-- cloud pieces, then the column above the spawn up to the highest island) and collects what streams in, until the
	-- event ends or every pickup is mine. PROBE cloud_touch_all: one touch per pickup counts (accepted) or each needs the
	-- step-through fallback (rejected: every pickup is stepped through from four sides).
	N.Cloud = { mine = {}, got = 0, events = {}, total = tonumber(N.tableOr(W.Events.Cloud).MaxPickups) or 36 }
	N.onEvent("CloudRainService.RE.Collected", function(uid, info)
		if type(uid) == "string" then
			if not N.Cloud.mine[uid] then
				N.Cloud.mineCount = (N.Cloud.mineCount or 0) + 1
			end
			N.Cloud.mine[uid] = true
			N.Cloud.got += 1
			if type(info) == "table" and N.finite(tonumber(info.Coins)) then
				N.incomeWindfall(tonumber(info.Coins))
			end
		end
	end)
	local CollectionService = game:GetService("CollectionService")
	function N.cloudPickups(skip)
		local out = {}
		for _, p in ipairs(CollectionService:GetTagged("CloudRainPickup")) do
			local uid = p:GetAttribute("Uid")
			if p:IsA("BasePart") and type(uid) == "string" and not N.Cloud.mine[uid] and not (skip and skip[uid]) then
				table.insert(out, p)
			end
		end
		return out
	end
	local function cloudKey()
		return tostring(workspace:GetAttribute("Event_CloudRain_EndsAt") or workspace:GetAttribute("Event_CloudRain_NextStartAt") or "now")
	end
	-- Something to collect: pickups in sight, or a running Cloud Rain this trip has not finished.
	function N.cloudDue()
		local st = N.Cloud.events[cloudKey()]
		if #N.cloudPickups(st and st.skip) > 0 then
			return true
		end
		return eventActive("CloudRain") and not (st and st.done)
	end
	-- Where the pickups can be: the cloud pieces that are streamed in (one point per 150 studs), then a column from the
	-- spawn up to the highest island known, every 300 studs; nearest first.
	local function cloudSweepPoints()
		local pts, seen = {}, {}
		local function add(pos)
			if typeof(pos) ~= "Vector3" then
				return
			end
			local key = string.format("%d:%d:%d", pos.X // 150, pos.Y // 150, pos.Z // 150)
			if not seen[key] then
				seen[key] = true
				table.insert(pts, pos)
			end
		end
		for _, rootName in ipairs({ "CloudRoute", "CloudGeneration" }) do
			local folder = workspace:FindFirstChild(rootName)
			if folder then
				local n = 0
				for _, d in ipairs(folder:GetDescendants()) do
					if d:IsA("BasePart") and not CollectionService:HasTag(d, "CloudRainPickup") then
						add(d.Position + Vector3.new(0, 5, 0))
						n += 1
						if n > 400 then
							break
						end
					end
				end
			end
		end
		local base = (N.place and N.place("HubSpawn")) or Vector3.new(-50.1, -515.9, -1868.6)
		local top = base.Y + 8200
		for _, key in ipairs({ "TapChestDesert", "TapChestSkyIsland" }) do
			local p = N.place and N.place(key)
			if p then
				top = math.max(top, p.Y + 300)
			end
		end
		for y = base.Y + 300, top, 300 do
			add(Vector3.new(base.X, y, base.Z))
		end
		local here = N.myPos() or base
		table.sort(pts, function(a, b)
			return (a - here).Magnitude < (b - here).Magnitude
		end)
		return pts
	end
	N.cloudSweepPoints = cloudSweepPoints
	function N.cloudTrip()
		local key = cloudKey()
		local st = N.Cloud.events[key]
		if not st then
			st = { got = 0, seen = {}, skip = {}, done = false, synced = false }
			N.Cloud.events[key] = st
			-- one record per event (the last few kept)
			local n = 0
			for _ in pairs(N.Cloud.events) do
				n += 1
			end
			if n > 6 then
				table.clear(N.Cloud.events)
				N.Cloud.events[key] = st
			end
			-- R7-1: the uids of the older events go too (36 an event, every 30 minutes, never needed again)
			if (N.Cloud.mineCount or 0) > 300 then
				table.clear(N.Cloud.mine)
				N.Cloud.mineCount = 0
			end
		end
		if not N.cloudDue() then
			return 0
		end
		N.tripBegin("cloud rain")
		N.incomeHold(120)
		N.loopStatus("Main", "collecting Cloud Rain pickups")
		if not st.synced then
			st.synced = true
			local mine = invoke("CloudRainService.RF.GetCollected")
			if type(mine) == "table" then
				for _, uid in ipairs(mine) do
					N.Cloud.mine[tostring(uid)] = true
				end
			end
		end
		local got0 = N.Cloud.got
		local started = os.clock()
		local fast = N.probeState("cloud_touch_all") ~= "rejected"
		local touched, firstTry = 0, 0
		-- R5-3 (live: `PROBLEM trip cloud rain over cap (140s, cap 110s)`): the trip ends by itself 8 s before its cap, counted
		-- from the trip start (the GetCollected call included), and says so; every step inside is bounded (streamAround)
		local deadline = N.Trip.since + math.min((N.Trip.cap or 110) - 8, 100)
		local capped = false
		local function inTime()
			if os.clock() >= deadline then
				capped = true
				return false
			end
			return alive()
		end
		local function collectVisible()
			while inTime() do
				local list = N.cloudPickups(st.skip)
				if #list == 0 then
					return
				end
				local here = N.myPos()
				local p = list[1]
				if here then
					local best = math.huge
					for _, x in ipairs(list) do
						local d = (x.Position - here).Magnitude
						if d < best then
							p, best = x, d
						end
					end
				end
				local uid = p:GetAttribute("Uid")
				st.seen[uid] = true
				touched += 1
				N.blink(p.Position + Vector3.new(0, 1, 0))
				local got = waitFor(function()
					return N.Cloud.mine[uid] == true
				end, if fast then 0.6 else 0.3)
				if got then
					firstTry += 1
				else
					-- the fallback: step through the pickup from four sides, then give it up for this event
					N.portalNudge(p.Position)
					got = waitFor(function()
						return N.Cloud.mine[uid] == true
					end, 0.6)
					if not got then
						st.skip[uid] = true
					end
				end
			end
		end
		collectVisible()
		local swept = 0
		for _, pos in ipairs(cloudSweepPoints()) do
			if not inTime() or (not eventActive("CloudRain") and #N.cloudPickups(st.skip) == 0 and swept > 0) then
				break
			end
			if st.got + (N.Cloud.got - got0) >= N.Cloud.total then
				break
			end
			swept += 1
			N.streamAround(pos, 1)
			N.blink(pos)
			waitFor(function()
				return #N.cloudPickups(st.skip) > 0
			end, 0.6)
			collectVisible()
		end
		local got = N.Cloud.got - got0
		st.got += got
		local seen = 0
		for _ in pairs(st.seen) do
			seen += 1
		end
		st.done = st.got >= N.Cloud.total or not eventActive("CloudRain") or not inTime()
		if capped then
			note("cloudRain", string.format("%d/%d pickups, cap reached (%d this trip, %d seen, %d sweep points, %.0fs)", st.got, N.Cloud.total, got, seen, swept, os.clock() - N.Trip.since))
		else
			note("cloudRain", string.format("%d/%d (%d this trip, %d seen, %d sweep points, %.0fs)", st.got, N.Cloud.total, got, seen, swept, os.clock() - started))
		end
		if N.probeState("cloud_touch_all") == "untested" and touched >= 10 then
			N.probeResult("cloud_touch_all", if firstTry >= touched * 0.8 then "accepted" else "rejected", string.format("gain=%d/%d pickups on the first touch", firstTry, touched))
		end
		N.tripEnd()
		return got
	end
	-- Meteors (MeteorShowerService.RE.Incoming(id, position, kind, start, travel), lands at start + travel) and the
	-- Mystery Egg (EggDropService.RE.Incoming(id, island, position, start, travel); RF.Travel() = the game's free teleport
	-- to it; 60 hits per player) are breakables: taps within 14 studs hit them (BreakableConfig TapRange 14).
	N.Rocks = { list = {}, eggs = {}, meteorPaid = 0, meteorCoins = 0, eggPaid = 0, eggCoins = 0, eggAt = -1e9, meteorAt = -1e9 }
	-- R13 (OWNER_RULES 24): a hit is not a reward. The server pays a broken rock / the cracked Mystery Egg with
	-- MeteorShowerService.RE.Rewarded({Coins, Gems, Tier, Item}) (MeteorShowerEffects bc 159295-159336) and
	-- EggDropService.RE.Rewarded({Coins}, drop) (EggDropEffects bc 144129-144151); the trips count those, not their taps.
	N.onEvent("MeteorShowerService.RE.Rewarded", function(p)
		if type(p) == "table" then
			N.Rocks.meteorPaid += 1
			N.Rocks.meteorCoins += tonumber(p.Coins) or 0
			N.Rocks.meteorAt = os.clock()
		end
	end)
	N.onEvent("EggDropService.RE.Rewarded", function(p)
		if type(p) == "table" then
			N.Rocks.eggPaid += 1
			N.Rocks.eggCoins += tonumber(p.Coins) or 0
			N.Rocks.eggAt = os.clock()
		end
	end)
	N.onEvent("MeteorShowerService.RE.Incoming", function(id, pos, kind, start, travel)
		if typeof(pos) == "Vector3" and type(start) == "number" and type(travel) == "number" then
			table.insert(N.Rocks.list, { id = tostring(id), pos = pos, kind = tostring(kind), landAt = start + travel, at = os.clock() })
			if #N.Rocks.list > 40 then
				table.remove(N.Rocks.list, 1)
			end
		end
	end)
	N.onEvent("EggDropService.RE.Incoming", function(id, island, pos, start, travel)
		if typeof(pos) == "Vector3" and type(start) == "number" and type(travel) == "number" then
			table.insert(N.Rocks.eggs, { id = tostring(id), island = island, pos = pos, landAt = start + travel, at = os.clock() })
			if #N.Rocks.eggs > 5 then
				table.remove(N.Rocks.eggs, 1)
			end
		end
	end)
	local function landed(list, life)
		local now = N.serverTime()
		local out = {}
		for i = #list, 1, -1 do
			local r = list[i]
			if now > r.landAt + life then
				table.remove(list, i)
			elseif now >= r.landAt then
				table.insert(out, r)
			end
		end
		return out
	end
	N.landed = landed
	-- Stand next to the breakable and let the taps hit it; the tap loop taps when Auto Tap runs, else this trip taps.
	local function tapAt(pos, taps)
		local root = N.root()
		if not root then
			return
		end
		N.teleport(pos + Vector3.new(4, 3, 0), 0.2)
		for _ = 1, taps do
			if not N.does("AutoTap") then
				N.tapOnce()
			end
			task.wait(0.11)
		end
	end
	function N.meteorTrip()
		local rocks = landed(N.Rocks.list, 45)
		if #rocks == 0 then
			return 0
		end
		N.tripBegin("meteors")
		N.incomeHold(70)
		N.loopStatus("Main", "breaking meteors")
		table.sort(rocks, function(a, b)
			return (a.kind == "Golden" and 0 or 1) < (b.kind == "Golden" and 0 or 1)
		end)
		local paid0, coins0 = N.Rocks.meteorPaid, N.Rocks.meteorCoins
		for _, r in ipairs(rocks) do
			tapAt(r.pos, if r.kind == "Golden" then 12 else 9)
			local i = table.find(N.Rocks.list, r)
			if i then
				table.remove(N.Rocks.list, i)
			end
		end
		waitFor(function()
			return N.Rocks.meteorPaid - paid0 >= #rocks
		end, 2)
		local paid = N.Rocks.meteorPaid - paid0
		if paid > 0 then
			note("meteors", string.format("ok: %d of %d rocks paid +%s coins", paid, #rocks, formatNumber(N.Rocks.meteorCoins - coins0)))
		else
			N.World.last.meteors = string.format("%d rocks hit, no reward", #rocks)
			log(string.format("CLAIM meteors FAILED answer=no MeteorShowerService.RE.Rewarded for %d rock%s hit", #rocks, if #rocks == 1 then "" else "s"))
		end
		N.tripEnd()
		return paid
	end
	function N.mysteryEggTrip()
		local eggs = landed(N.Rocks.eggs, 240)
		if #eggs == 0 then
			return 0
		end
		local egg = eggs[1]
		N.tripBegin("mystery egg")
		N.incomeHold(70)
		N.loopStatus("Main", "hitting the Mystery Egg")
		local travelled = ok(invoke("EggDropService.RF.Travel"))
		if not travelled then
			N.travel(if type(egg.island) == "string" and N.islandInfo(egg.island) then egg.island else "Spawn")
		end
		local paid0, coins0 = N.Rocks.eggPaid, N.Rocks.eggCoins
		tapAt(egg.pos, 62)
		local i = table.find(N.Rocks.eggs, egg)
		if i then
			table.remove(N.Rocks.eggs, i)
		end
		local paid = waitFor(function()
			return N.Rocks.eggPaid > paid0
		end, 3)
		if paid then
			note("mysteryEgg", string.format("ok: cracked, +%s coins (%s)", formatNumber(N.Rocks.eggCoins - coins0), if travelled then "server travel" else "teleport"))
		else
			N.World.last.mysteryEgg = "62 hits, no reward yet"
			log("CLAIM mystery egg FAILED answer=no EggDropService.RE.Rewarded after 62 hits (" .. (if travelled then "server travel" else "teleport") .. ")")
		end
		N.tripEnd()
		return if paid then 1 else 0
	end
	-- Lucky block bursts: models tagged LuckyBlockEventServer, LuckyBlockEventService.RE.CollectRequested(Name) within
	-- Scale x 7 studs, every 0.25 s until Opened (LuckyBlockEventController 21593-21598).
	function N.luckyBlocks()
		local out = {}
		for _, m in ipairs(CollectionService:GetTagged("LuckyBlockEventServer")) do
			if m:GetAttribute("Opened") ~= true and type(m.Name) == "string" and not string.find(m.Name, "[\128-\255]") then
				table.insert(out, m)
			end
		end
		return out
	end
	function N.knownLuckyBlock(name)
		for _, m in ipairs(N.luckyBlocks()) do
			if m.Name == name then
				return true
			end
		end
		return false
	end
	function N.luckyBlockTrip()
		local blocks = N.luckyBlocks()
		if #blocks == 0 then
			return 0
		end
		N.tripBegin("lucky blocks")
		N.incomeHold(80)
		N.loopStatus("Main", "opening lucky blocks")
		local opened = 0
		local started = os.clock()
		for _, m in ipairs(blocks) do
			if os.clock() - started > 60 or not alive() then
				break
			end
			local okPivot, pivot = pcall(function()
				return m:GetPivot()
			end)
			if okPivot and pivot then
				N.teleport(pivot.Position + Vector3.new(3, 2, 0), 0.1)
				for _ = 1, 8 do
					if m:GetAttribute("Opened") == true or not m.Parent then
						break
					end
					fire("LuckyBlockEventService.RE.CollectRequested", m.Name)
					task.wait(0.26)
				end
				if m:GetAttribute("Opened") == true then
					opened += 1
				end
			end
		end
		note("luckyBlocks", opened .. "/" .. #blocks .. " opened")
		N.tripEnd()
		return opened
	end

	-- ===== The daily mine (B13, G5-7; live 11, 13). Its real value is the daily shop (MiningService.RF.DailyBuy(offerId),
	-- DailyShop 3097 L368736-368984: 3 rotating offers + the permanent Gem Shard, each with a Stock per day, priced in mining
	-- coins = Data.Mining.Coins): the worst-case shop costs 59,000 coins a day and the owner holds 671k. So: the shop is
	-- bought remote-only first (PROBE mine_shop_remote), else in one short trip (Crystal Cave -> Enter() inside the portal
	-- box -> DailyBuy -> Leave()); digging only while the balance does not cover today's shop (hard cap 3 min), or the full
	-- milestone run when "Dig for milestones" is on (cap 10 min). Gem offers first (Hoard > Geode > Cluster > Shard), then
	-- the coin offers (their coins land as a windfall the rebirth watcher turns into the next bigger button). Hits(Id, X, Y,
	-- Z) on exposed blocks the pickaxe breaks (the ore map from the game's own MiningConfig), pets mine along. =====
	N.Mine = { lastAt = -1e9, state = nil, hits = 0, broken = 0, throttled = 0, last = "", milestone = 0, shopAt = -1e9 }
	local Mine = N.Mine
	N.onEvent("MiningService.RE.MineReward", function(p)
		if type(p) == "table" and tonumber(p.Milestone) then
			Mine.milestone = math.max(Mine.milestone, p.Milestone)
		end
	end)
	local GemRank = { GemHoard = 1, GemGeode = 2, GemCluster = 3, GemShard = 4, ClickVault = 5, ClickChest = 6, ClickSack = 7, ClickPouch = 8 }
	-- Today's offers that still have stock, best first, and what they cost together.
	function N.mineShopToday()
		local mining = N.sub(N.data(), "Mining")
		local balance = tonumber(mining.Coins) or 0
		local out, need = {}, 0
		if type(W.Daily.Offers) ~= "function" or type(W.Daily.Day) ~= "function" then
			return out, need, balance, 0
		end
		local okDay, day = pcall(W.Daily.Day, N.serverTime())
		day = if okDay and type(day) == "number" then day else 0
		local okOffers, offers = pcall(W.Daily.Offers, day)
		if not okOffers or type(offers) ~= "table" then
			return out, need, balance, day
		end
		for _, o in ipairs(offers) do
			if type(o) == "table" and (o.Kind == "Gems" or o.Kind == "Clicks") and type(o.Id) == "string" then
				local left = 1
				if type(W.Daily.Left) == "function" then
					local okLeft, n = pcall(W.Daily.Left, mining.DailyShop, day, o)
					left = if okLeft and type(n) == "number" and n < math.huge then n else 1
				end
				if left > 0 then
					table.insert(out, { offer = o, left = left })
					need += left * (tonumber(o.Price) or 0)
				end
			end
		end
		table.sort(out, function(a, b)
			return (GemRank[a.offer.Id] or 9) < (GemRank[b.offer.Id] or 9)
		end)
		return out, need, balance, day
	end
	function N.mineDue()
		if not N.islandUnlocked("Crystal Cave") or os.clock() - Mine.lastAt < 600 then
			return false
		end
		local list = N.mineShopToday()
		return #list > 0 or on("MineMilestones")
	end
	-- REV-10: what today's remaining offers are worth in income-seconds: coin offers by MineRewards.Amount (the game's own
	-- price of an offer's Taps at the mine island, 3097 L369653-369714) over the income, gem offers at N.gemWorth.
	function N.mineShopValue(list)
		local data = N.data()
		local value = 0
		for _, item in ipairs(list) do
			local o = item.offer
			local amount = 0
			if data and type(W.MineRewards.Amount) == "function" then
				local okA, a = pcall(W.MineRewards.Amount, data, o.Kind, tonumber(o.Taps) or 0)
				amount = if okA and N.finite(a) then a else 0
			end
			if amount <= 0 and o.Kind == "Clicks" and N.passiveTap then
				amount = (tonumber(o.Taps) or 0) * N.passiveTap()
			end
			local v = if o.Kind == "Gems" then amount * (if N.gemWorth then N.gemWorth() else 0) else N.incomeSeconds(amount)
			value += v * (tonumber(item.left) or 1)
		end
		return value
	end
	-- UI-6: when the hub goes to the shop next.
	function N.mineNextText()
		if not N.islandUnlocked("Crystal Cave") then
			return "Needs Crystal Cave"
		end
		local list, _, _, day = N.mineShopToday()
		if #list == 0 then
			local left = ((tonumber(day) or 0) + 1) * 86400 - N.serverTime()
			return "Today's shop is bought; the next shop day starts in " .. N.longTime(left)
		end
		local wait = Mine.lastAt + 600 - os.clock()
		return "Next shop visit " .. (if wait > 0 then "in " .. N.longTime(wait) else "on the next free trip slot")
	end
	-- Buys what the balance pays for, best first; true when everything affordable was bought.
	local function buyShop(list, balance, day)
		local bought, parts = 0, {}
		for _, item in ipairs(list) do
			local o = item.offer
			for _ = 1, item.left do
				if balance < (tonumber(o.Price) or math.huge) then
					break
				end
				local r = invoke("MiningService.RF.DailyBuy", o.Id)
				if type(r) ~= "table" or r.Error then
					return bought, parts, r
				end
				bought += 1
				balance -= tonumber(o.Price) or 0
				if type(r.Balance) == "number" then
					balance = r.Balance
				end
				local got = type(r.Bought) == "table" and r.Bought or {}
				table.insert(parts, string.format("%s %s %s", o.Id, formatNumber(tonumber(got.Amount) or 0), string.lower(tostring(got.Kind or o.Kind))))
				if o.Kind == "Clicks" then
					-- the coins are a windfall, not income
					N.incomeWindfall(tonumber(got.Amount) or 0)
				end
				task.wait(0.15)
			end
		end
		return bought, parts, nil
	end
	local function frontier(area, removed)
		local w, _, d = W.Mining.Dimensions(area)
		local out = {}
		for x = 0, w - 1 do
			for z = 0, d - 1 do
				local key = W.Mining.Key(x, 0, z)
				if not removed[key] then
					out[key] = Vector3.new(x, 0, z)
				end
			end
		end
		for key in pairs(removed) do
			local a, b, c = string.match(key, "^(%d+):(%d+):(%d+)$")
			local x, y, z = tonumber(a), tonumber(b), tonumber(c)
			if x then
				for _, v in ipairs(W.Mining.Neighbors) do
					local nx, ny, nz = x + v.X, y + v.Y, z + v.Z
					if W.Mining.Valid(area, nx, ny, nz) then
						local k = W.Mining.Key(nx, ny, nz)
						if not removed[k] and not out[k] then
							out[k] = Vector3.new(nx, ny, nz)
						end
					end
				end
			end
		end
		return out
	end
	local function bestCell(area, state, cells, here)
		local tool = W.Mining.Tools[state.Tool] or W.Mining.Tools[1]
		local best, bestScore, bestFar, bestFarScore = nil, -1, nil, -1
		for key, cell in pairs(cells) do
			local okOre, ore, stats = pcall(W.Mining.Ore, state.Seed, cell.X, cell.Y, cell.Z)
			if okOre and type(stats) == "table" and (tonumber(stats.pickaxeRequirement) or 0) <= (tool.Power or 0) then
				local score = (tonumber(stats.value) or 1) / math.max(tonumber(stats.health) or 1, 1)
				local pos = W.Mining.Position(area, cell.X, cell.Y, cell.Z)
				local dist = (pos - here).Magnitude
				if dist <= (tool.Range or 20) - 1 then
					if score > bestScore then
						best, bestScore = { key = key, cell = cell, pos = pos, ore = ore }, score
					end
				elseif score - dist * 0.001 > bestFarScore then
					bestFar, bestFarScore = { key = key, cell = cell, pos = pos, ore = ore }, score - dist * 0.001
				end
			end
		end
		return best, bestFar
	end
	function N.validMineCell(x, y, z)
		return N.isInt(x, 0, 4000) and N.isInt(y, 0, 100) and N.isInt(z, 0, 4000)
	end
	local function dig(state, stopAt, need)
		local area = waitFor(function()
			return W.MineWorld.Marker() ~= nil
		end, 6) and W.MineWorld.Marker()
		if not area or type(W.MineSave.Decode) ~= "function" then
			return state
		end
		local w, h, d = W.Mining.Dimensions(area)
		local removed = W.MineSave.Decode(state.Removed or "", w, h, d)
		local cells = frontier(area, removed)
		local cadence = if N.probeState("mine_rate") == "accepted" then 1 / 12 else nil
		local trial = { sent = 0, throttled = 0, at = os.clock() }
		local moves = 0
		N.loopStatus("Main", "digging in the mine")
		while os.clock() < stopAt and alive() and N.does("AutoMine") do
			if need and (tonumber(state.Balance) or 0) >= need then
				break
			end
			if not need and Mine.milestone >= 4 then
				break
			end
			local root = N.root()
			if not root then
				break
			end
			local target, far = bestCell(area, state, cells, root.Position)
			if not target and far and moves < 150 then
				moves += 1
				N.teleport(far.pos + Vector3.new(0, 4, 0), 0.2)
				continue
			end
			if not target then
				break
			end
			local tool = W.Mining.Tools[state.Tool] or W.Mining.Tools[1] or { Interval = 0.45 }
			local result = invoke("MiningService.RF.Hit", state.Id, target.cell.X, target.cell.Y, target.cell.Z)
			Mine.hits += 1
			trial.sent += 1
			if type(result) == "table" then
				if result.Throttled then
					Mine.throttled += 1
					trial.throttled += 1
				elseif result.Error then
					cells[target.key] = nil
				else
					if type(result.State) == "table" then
						state = result.State
						Mine.state = state
					end
					if result.Broken then
						Mine.broken += 1
						removed[result.Key or target.key] = true
						cells[target.key] = nil
						for _, v in ipairs(W.Mining.Neighbors) do
							local nx, ny, nz = target.cell.X + v.X, target.cell.Y + v.Y, target.cell.Z + v.Z
							if W.Mining.Valid(area, nx, ny, nz) then
								local k = W.Mining.Key(nx, ny, nz)
								if not removed[k] then
									cells[k] = Vector3.new(nx, ny, nz)
								end
							end
						end
						if type(result.Drop) == "table" and result.Drop.Id ~= nil then
							invoke("MiningService.RF.CollectDrop", state.Id, result.Drop.Id)
						end
					end
				end
			end
			if (tonumber(state.Count) or 0) >= (tonumber(state.Capacity) or math.huge) then
				invoke("MiningService.RF.Surface", "Sell")
				task.wait(1)
				local sold = invoke("MiningService.RF.Sell")
				if type(sold) == "table" and type(sold.State) == "table" then
					state = sold.State
				elseif type(sold) == "table" and sold.Count then
					state = sold
				end
				note("mine", "sold the bag")
			end
			-- mine_rate probe: 30 hits at 12/s once per game version; kept when under 10 % are Throttled.
			if N.probeState("mine_rate") == "untested" and trial.sent >= 30 then
				local rejected = trial.throttled / trial.sent > 0.1
				N.probeResult("mine_rate", if rejected then "rejected" else "accepted", string.format("gain=%.1f hits/s throttled=%d/%d", trial.sent / math.max(os.clock() - trial.at, 0.1), trial.throttled, trial.sent))
				cadence = if rejected then nil else 1 / 12
			end
			local pace = cadence or (if N.probeState("mine_rate") == "untested" then 1 / 12 else tool.Interval or 0.45)
			task.wait(pace)
		end
		return state
	end
	function N.mineTrip()
		Mine.lastAt = os.clock()
		local list, need, balance, day = N.mineShopToday()
		local milestones = on("MineMilestones")
		local digNeeded = balance < need
		log(string.format("MINE shop need=%s balance=%s dig=%s offers=%d day=%d", formatNumber(need), formatNumber(balance), if milestones then "milestones" elseif digNeeded then "yes" else "no", #list, day))
		-- Rung 1: the shop by remote, from wherever the player stands.
		if not digNeeded and not milestones and #list > 0 and N.probeState("mine_shop_remote") ~= "rejected" then
			local bought, parts, err = buyShop(list, balance, day)
			if bought > 0 or not err then
				if N.probeState("mine_shop_remote") == "untested" and bought > 0 then
					N.probeResult("mine_shop_remote", "accepted", "gain=no trip (" .. table.concat(parts, ", ") .. ")", "accepted")
				end
				Mine.shopAt = os.clock()
				Mine.last = "daily shop: " .. (if #parts > 0 then table.concat(parts, ", ") else "nothing affordable")
				log("MINE shop day=" .. day .. " bought " .. (if #parts > 0 then table.concat(parts, ", ") else "nothing") .. " (remote)")
				return bought
			end
			N.probeResult("mine_shop_remote", "rejected", "gain=0 (" .. brief(err) .. "), the shop goes through the mine", "rejected")
		end
		if #list == 0 and not milestones then
			return 0
		end
		local portal = W.MineWorld.Portal and W.MineWorld.Portal()
		N.tripBegin("mine", if milestones then 650 elseif digNeeded then 230 else 60)
		N.incomeHold(if milestones then 650 elseif digNeeded then 230 else 60)
		N.loopStatus("Main", "going to the mine")
		if not portal and N.travel("Crystal Cave") then
			portal = waitFor(function()
				return W.MineWorld.Portal() ~= nil
			end, 5) and W.MineWorld.Portal()
		end
		if not portal then
			note("mine", "portal not found on Crystal Cave")
			N.tripEnd()
			return 0
		end
		N.teleport(portal.Position, 0.5)
		local state = invoke("MiningService.RF.Enter")
		if type(state) ~= "table" or state.Error or not state.Id then
			note("mine", "Enter refused: " .. brief(state))
			N.tripEnd()
			return 0
		end
		Mine.state = state
		local hits0, broken0 = Mine.hits, Mine.broken
		if milestones then
			state = dig(state, os.clock() + 600, nil)
		elseif digNeeded then
			state = dig(state, os.clock() + 180, need)
		end
		-- R2-1 (live 18:01 "Visit the Daily Shop by the mine."): the shop sells only on its pad inside the mine,
		-- MiningWorld.Part("Daily") = workspace.MineArea.MiningFacilities.Daily (3097 L370667-370679; the client opens the
		-- shop while OnPad(Daily, 1), L174498-174509).
		local pad = type(W.MineWorld.Part) == "function" and W.MineWorld.Part("Daily")
		if not pad then
			local area = workspace:FindFirstChild("MineArea")
			local facilities = area and area:FindFirstChild("MiningFacilities")
			pad = facilities and facilities:FindFirstChild("Daily")
		end
		if pad and pad:IsA("BasePart") then
			N.teleport(pad.Position + Vector3.new(0, pad.Size.Y / 2 + 3, 0), 0.3)
		else
			log("MINE daily shop pad not found, buying from where the mine put us")
		end
		local bought, parts, err = buyShop(list, tonumber(state.Balance) or balance, day)
		if err then
			log("MINE shop refused:", brief(err))
		end
		invoke("MiningService.RF.Leave")
		Mine.shopAt = os.clock()
		Mine.last = string.format("%d hits, %d blocks, shop: %s", Mine.hits - hits0, Mine.broken - broken0, if #parts > 0 then table.concat(parts, ", ") else "nothing affordable")
		log("MINE shop day=" .. day .. " bought " .. (if #parts > 0 then table.concat(parts, ", ") else "nothing") .. string.format(" (trip, %d hits, %.0fs)", Mine.hits - hits0, os.clock() - N.Trip.since))
		N.tripEnd()
		return bought
	end
	function N.validDailyOffer(id)
		return type(id) == "string" and N.tableOr(W.Daily.ById)[id] ~= nil
	end

	-- ===== Pet Defense (B12, G5-5; live 6, 19). ColosseumService: StartWaveDefense() inside the entrance
	-- (ColosseumWorld.GetEntrance), AttackOpponent(id) / CriticalAttackOpponent(id), ReturnFromArena(),
	-- ClaimMinigameReward("keep"|"replace"). The shared ColosseumRun (3097 L367430-367491) rejects a normal attack sooner
	-- than ClickCooldown 0.2 - grace 0.08 = 0.12 s after the last ACCEPTED one (server clock), an attack on an opponent that
	-- already arrived, and attacks while an upgrade offer is open; a critical needs charge 100 (+7 per accepted hit, +12 per
	-- defeat) and 4 s since the last one, and does not touch the normal lane: it runs in parallel. Cadence adaptive from
	-- 0.13 s (+0.01 after an unexplained rejection, -0.005 after 50 accepted in a row, floor 0.121, cap 0.16); PROBE
	-- colosseum_cadence logs the accepted rate once 200 attacks were sent. Target: the opponent that arrives first. The run is
	-- planned only while a better relic can come out of it (RelicTierWeights at the best wave, L371911-371945, relic boosts
