	-- ----- giveaways: the free entry only
	function N.giveawaysOn()
		return ReplicatedStorage:GetAttribute(N.G.Giveaway.OnAttribute or "TS2GiveawaysOn") == true
	end
	local function enteredIn(g, d)
		local entries = type(d) == "table" and type(d.Giveaways) == "table" and type(d.Giveaways.Entries) == "table" and d.Giveaways.Entries
		if entries and type(entries[g.Id]) == "table" then
			return true
		end
		for _, e in pairs(type(g.Entrants) == "table" and g.Entrants or {}) do
			if type(e) == "table" and e.UserId == LocalPlayer.UserId then
				return true
			end
		end
		return false
	end
	function N.giveawayStep()
		if os.clock() - GV.checkedAt < 120 then
			return
		end
		GV.checkedAt = os.clock()
		if N.remote("GiveawayService.RF.Enter") == nil or N.remote("GiveawayService.RF.GetState") == nil or not N.giveawaysOn() then
			return
		end
		local state = invoke("GiveawayService.RF.GetState")
		if type(state) ~= "table" or type(state.Giveaways) ~= "table" then
			return
		end
		local now = tonumber(state.Now) or serverNow()
		local d = N.data()
		local open = 0
		local target = nil
		for _, g in pairs(state.Giveaways) do
			if type(g) == "table" and g.Id ~= nil and g.Outcome == nil and (tonumber(g.EndsAt) == nil or tonumber(g.EndsAt) > now) then
				open += 1
				if target == nil and g.HostUserId ~= LocalPlayer.UserId and not GV.skip[g.Id] and not enteredIn(g, d) then
					target = g
				end
			end
		end
		GV.open = open
		if target == nil then
			return
		end
		local r = invoke("GiveawayService.RF.Enter", { Id = target.Id, Tickets = 0 })
		if type(r) == "table" and r.Ok == true then
			GV.entered += 1
			GV.last = "entered giveaway " .. tostring(target.Id) .. " (free entry)"
			log("GIVEAWAY entered", tostring(target.Id), "host", tostring(target.HostUserId))
		else
			local reason = if type(r) == "table" then tostring(r.Reason or "refused") else tostring(r)
			if reason ~= "Busy" then
				GV.skip[target.Id] = true
			end
			GV.last = "giveaway " .. tostring(target.Id) .. " refused: " .. reason
			log("GIVEAWAY", tostring(target.Id), "refused:", reason)
		end
	end
	function N.giveawayText()
		local d = N.data()
		local won = type(d) == "table" and type(d.Giveaways) == "table" and type(d.Giveaways.Won) == "table" and d.Giveaways.Won or {}
		local wins = 0
		for _ in pairs(won) do
			wins += 1
		end
		return string.format("Giveaways %s: %d open, entered %d this session%s%s", if N.giveawaysOn() then "on" else "paused by the game", GV.open, GV.entered, if wins > 0 then string.format(", %d win%s to collect in the game's menu", wins, if wins == 1 then "" else "s") else "", if GV.last ~= "" then "\nLast: " .. GV.last else "")
	end
