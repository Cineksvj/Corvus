end
function N.tripEnd()
	if N.Trip.active then
		table.insert(N.Trip.log, { name = N.Trip.name, from = N.Trip.since, to = os.clock() })
		if #N.Trip.log > 200 then
			table.remove(N.Trip.log, 1)
		end
		N.Trip.endedAt = os.clock()
	end
