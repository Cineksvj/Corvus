				if not N.Trip.active and not N.Manual.running and os.clock() - (N.LoopBeat.Main or os.clock()) > 180 then
					N.restartLoop("Main", "no Main turn for 3 minutes outside the trips")
				end
				N.stuckCheck()
			end)
		end
	end)
