	N.Events.hatched = function(r)
		if not (hookOn() and type(r) == "table" and type(r.Pets) == "table") then
			return
		end
		local groups, order = {}, {}
		for _, pet in ipairs(r.Pets) do
			if type(pet) == "table" then
				local rarity, tier = tostring(pet.Rarity or ""), tostring(pet.Tier or "Normal")
				local keys = {}
				if string.sub(rarity, 1, 6) == "Secret" then
					table.insert(keys, "hatch_secret")
				end
				if rarity == "Legendary" or rarity == "Mythical" or rarity == "Mythic" or rarity == "Godly" or rarity == "Exclusive" then
					table.insert(keys, "hatch_rare")
				end
				if tier ~= "Normal" and tier ~= "" then
					table.insert(keys, "hatch_tier")
				end
				if pet.Mutation ~= nil then
					table.insert(keys, "hatch_mutation")
				end
				if #keys > 0 then
					local id = tostring(pet.Name) .. "|" .. tier .. "|" .. rarity .. "|" .. tostring(pet.Mutation or "")
					local g = groups[id]
					if not g then
						g = { pet = pet, keys = keys, rarity = rarity, tier = tier, count = 0 }
						groups[id] = g
						table.insert(order, id)
					end
					g.count += 1
				end
			end
		end
		for _, id in ipairs(order) do
			local g = groups[id]
			local name = tostring(g.pet.Name or "?")
			local what = (if g.tier ~= "Normal" then g.tier .. " " else "") .. name
			local extra = if g.pet.Mutation ~= nil then ", " .. tostring(g.pet.Mutation) .. " mutation" else ""
			N.post(g.keys, {
				title = "\u{2726}  Hatched " .. name .. (if g.count > 1 then " x" .. g.count else ""),
				description = "**" .. what .. "** (" .. (if g.rarity ~= "" then g.rarity else "?") .. extra .. ") from the " .. tostring(r.Egg or N.Hatch.egg) .. " egg.",
				color = EventByKey[g.keys[1]].Color,
				fields = { { name = "Player", value = playerField(), inline = true } },
			})
		end
	end
