			table.insert(lines, "Every variant up to " .. select(3, N.indexOdds()) .. " is found on the eggs you can open")
		else
			table.insert(lines, string.format("%d variant%s left on eggs the coins do not pay for yet", plan.left, if plan.left == 1 then "" else "s"))
		end
		table.insert(lines, string.format("Found this session %d", I.found))
		return table.concat(lines, "\n")
	end
