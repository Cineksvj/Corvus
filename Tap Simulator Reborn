			local gamesBox = tab:AddLeftGroupbox("Supported games", "gamepad-2")
			gamesBox:AddLabel({ Text = '<font color="#9AA0AA">Every game Corvus runs in. Play takes you there and starts the hub again.</font>', DoesWrap = true })
			-- a game's icon is a universe thumbnail; the universe id of another place comes from the
			-- public places API once and is kept
			local universeIds = rawget(Library, "_universeIds") or {}
			rawset(Library, "_universeIds", universeIds)
			local function universeOf(entry)
				local placeId = tonumber(entry.PlaceId) or 0
				local known = tonumber(entry.UniverseId)
				if known and known > 0 then
					universeIds[placeId] = known
					return known
				end
				if universeIds[placeId] then return universeIds[placeId] end
				local okG, gid = pcall(function() return game.PlaceId == placeId and tonumber(game.GameId) or nil end)
				if okG and gid and gid > 0 then
					universeIds[placeId] = gid
					return gid
				end
				local okB, body = pcall(game.HttpGet, game, string.format("https://apis.roblox.com/universes/v1/places/%d/universe", placeId))
				local id = okB and type(body) == "string" and tonumber(body:match('"universeId"%s*:%s*(%d+)')) or nil
				if id then universeIds[placeId] = id end
				return id
			end
			local function playGame(entry)
				pcall(function()
					local queue = queue_on_teleport or queueonteleport or (typeof(syn) == "table" and syn.queue_on_teleport)
					if type(queue) == "function" and type(loader) == "string" and loader ~= "" then
						queue("if not game:IsLoaded() then game.Loaded:Wait() end " .. loader)
					end
				end)
				if type(Library.CorvusLog) == "function" then
					pcall(Library.CorvusLog, Library, string.format("PLAY %s (%s)", tostring(entry.Name), tostring(entry.PlaceId)))
				end
				Library:Notify("Teleporting to " .. tostring(entry.Name), 4)
				local okT, err = pcall(function() game:GetService("TeleportService"):Teleport(tonumber(entry.PlaceId), LocalPlayer) end)
				if not okT then Library:Notify("Teleport failed: " .. tostring(err), 5) end
			end
			for _, entry in ipairs(games) do
				local placeId = tonumber(entry.PlaceId) or 0
				local isHere = placeId == game.PlaceId
				local row = Library:New("TextButton", {
					Name = "Game_" .. tostring(entry.Name),
					BackgroundColor3 = Colors.well,
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = "",
					Size = UDim2.new(1, 0, 0, 56),
					LayoutOrder = gamesBox:_next(),
					Parent = gamesBox.Body,
				})
				Library:New("UICorner", { CornerRadius = UDim.new(0, 6), Parent = row })
				local edge = Library:Stroke(Colors.wellEdge, 1, 0)
				edge.Parent = row
				-- the gamepad glyph is the fallback; the game's picture sits on its own layer above it
				-- and takes over once it has loaded (owner 2026-11-02 "miniaturki gier, nie ikona pada";
				-- the old single ImageLabel lost the picture to the lucide flush)
				local icon = Library:New("ImageLabel", {
					Name = "Icon",
					BackgroundColor3 = Colors.window,
					BorderSizePixel = 0,
					Position = UDim2.new(0, 6, 0, 6),
					Size = UDim2.new(0, 44, 0, 44),
					Image = "",
					ImageColor3 = Colors.glyph,
					ScaleType = Enum.ScaleType.Fit,
					ZIndex = row.ZIndex + 1,
					Parent = row,
				})
				Library:New("UICorner", { CornerRadius = UDim.new(0, 8), Parent = icon })
				Library:New("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = icon })
				local pic = Library:New("ImageLabel", {
					Name = "Picture",
					BackgroundColor3 = Colors.window,
					BorderSizePixel = 0,
					Position = UDim2.new(0, 6, 0, 6),
					Size = UDim2.new(0, 44, 0, 44),
					Image = "",
					ScaleType = Enum.ScaleType.Crop,
					-- rendered from the start over the glyph, with no background: the engine only
					-- fetches (and flips IsLoaded for) an ImageLabel it draws, so a hidden or fully
					-- transparent one kept the gamepad glyph for ever (live 2026-11-02 on the alt,
					-- PreloadAsync did not help). Unloaded, it draws nothing and the glyph shows through.
					BackgroundTransparency = 1,
					Visible = true,
					ZIndex = row.ZIndex + 2,
					Parent = row,
				})
				Library:New("UICorner", { CornerRadius = UDim.new(0, 8), Parent = pic })
				local function showPicture(url)
					if not pic.Parent or type(url) ~= "string" or url == "" then return end
					local function reveal()
						pic.BackgroundTransparency = 0
						icon.Visible = false
					end
					pic.Image = url
					local loaded = true
					pcall(function() loaded = pic.IsLoaded ~= false end)
					if loaded then
						reveal()
					else
						pcall(function()
							local conn
							conn = pic:GetPropertyChangedSignal("IsLoaded"):Connect(function()
								if pic.IsLoaded then
									reveal()
									conn:Disconnect()
								end
							end)
						end)
					end
				end
				pcall(Library.ApplyLucideIcon, Library, icon, "gamepad-2")
				if type(entry.Icon) == "string" and entry.Icon ~= "" then
					showPicture(entry.Icon)
				else
					task.spawn(function()
						local uid = universeOf(entry)
						if uid then showPicture(string.format("rbxthumb://type=GameIcon&id=%d&w=150&h=150", uid)) end
					end)
				end
				Library:New("TextLabel", {
					Name = "Title",
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 58, 0, 10),
					Size = UDim2.new(1, -128, 0, 18),
