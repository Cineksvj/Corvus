	-- at most ~8 s (stream 5.5 s + ground 2 s + restore), so a busy flag older than 15 s is stale and is cleared here.
	function N.moveReset(why)
		local M = N.Move
		if M.anchored then
			local root = N.root()
			pcall(function()
				if root then
					root.Anchored = false
				end
			end)
