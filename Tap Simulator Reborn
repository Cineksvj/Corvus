	N.Sent = { count = 0, byName = {} }
	local function allowed(list, name, ...)
		local rule = list[name]
		if rule == true then
			return select("#", ...) == 0
		end
		if type(rule) == "function" then
			local ok, yes = pcall(rule, ...)
			return ok and yes == true
		end
		return false
	end
	local function guard(list, name, ...)
		if not allowed(list, name, ...) then
			log("BLOCKED", name, ...)
			return false
		end
		local ok, why = N.argsSafe(...)
		if not ok then
			log("BLOCKED", name, "argument check:", why)
			logProblem("An argument for " .. name .. " failed the safety check (" .. tostring(why) .. "), it was not sent")
			return false
		end
		return true
	end
	function fire(name, ...)
		if not guard(FireAllowed, name, ...) then
			return false
		end
		local remote = N.remote(name)
		if not (remote and remote:IsA("RemoteEvent")) then
			log("NO REMOTE", name)
			return false
		end
		if not takeToken(name) then
			return false
		end
		local args = table.pack(...)
		local ok, err = pcall(function()
			remote:FireServer(table.unpack(args, 1, args.n))
		end)
		N.Sent.count += 1
		N.Sent.byName[name] = (N.Sent.byName[name] or 0) + 1
		if not Quiet[name] or not ok then
			log("SEND", name, if args.n > 0 then brief(args[1]) else "", if ok then "" else "failed: " .. tostring(err))
		end
		return ok
	end
	-- RemoteFunctions with a time limit (a stuck server call never freezes a loop). Returns every result value. Two loops
	-- never call the same RemoteFunction at the same time: the second one waits for the first answer.
	local Busy = {}
	N.InvokeBusy = Busy
	function invoke(name, ...)
		if not guard(InvokeAllowed, name, ...) then
			return nil
		end
		local remote = N.remote(name)
		if not (remote and remote:IsA("RemoteFunction")) then
			log("NO REMOTE", name)
			return nil
		end
		local queued = 0
		while Busy[name] and queued < 10 do
			queued += task.wait(0.05) or 0.05
		end
		if not takeToken(name) then
			return nil
		end
		Busy[name] = true
		local args = table.pack(...)
		local done, ok, result = false, false, nil
		task.spawn(function()
			result = table.pack(pcall(function()
				return remote:InvokeServer(table.unpack(args, 1, args.n))
			end))
			ok = result[1] == true
			done = true
		end)
		local waited = 0
		while not done and waited < 10 do
			waited += task.wait(0.05) or 0.05
		end
		Busy[name] = nil
		N.Sent.count += 1
		N.Sent.byName[name] = (N.Sent.byName[name] or 0) + 1
		if not done then
			log("INVOKE timeout", name)
			return nil
		end
		if not Quiet[name] or not ok then
			log("INVOKE", name, if args.n > 0 then brief(args[1]) else "", "->", if ok then brief(result[2]) else "failed: " .. tostring(result[2]))
		end
		if not ok then
			return nil
		end
		return table.unpack(result, 2, result.n)
	end
