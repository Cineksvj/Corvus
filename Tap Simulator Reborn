	-- R5-4 (d): the hatch watchdog (monitor, every 5 s). Auto Hatch on, no trip, room in the storage, coins for a hatch and
	-- no hatch answer for 90 s = `HATCH stalled: <state>`; the hatch state machine starts over (request, pacing, TooFar,
	-- stand distance, a stale teleport flag, the 10 s retry of the way to the egg) and a Main loop without a turn for 30 s
	-- is restarted (only the Main loop moves the character to the egg).
	local HatchWatch = { since = nil, at = -1e9 }
	function N.hatchWatchdog()
		local H = N.Hatch
		local now = os.clock()
		if not N.hatchWanted() or N.Manual.running then
			HatchWatch.since = nil
			return false
		end
		HatchWatch.since = HatchWatch.since or now
		if N.Trip.active or not H.target or N.storageFull() or N.hatchCount(H.target) < 1 then
			return false
		end
		local quiet = now - math.max(H.lastOkAt, HatchWatch.since, N.Trip.endedAt, HatchWatch.at)
		if quiet < 90 then
			return false
		end
		HatchWatch.at = now
		local here, pos = N.myPos(), N.eggPos(H.target)
		local mainAge = now - (N.LoopBeat.Main or now)
		log(string.format(
			"HATCH stalled: no hatch for %ds | egg %s on %s, here %s (%s studs), at egg %s, teleport busy %s, request open %s, next in %.1fs, last why %q | Main %q (turn %ds old)",
			math.floor(quiet),
			tostring(H.target),
			tostring(N.eggIsland(H.target)),
			tostring(N.currentIsland()),
			if here and pos then string.format("%.0f", (here - pos).Magnitude) else "?",
			tostring(N.atEgg(H.target)),
			tostring(N.Move.busy),
			tostring(H.inFlight),
			H.nextAt - now,
			tostring(H.idleWhy),
			tostring(Status),
			math.floor(mainAge)
		))
		H.inFlight = false
		H.nextAt = 0
		H.tooFarAt = -1e9
		H.standDist = 5
		EggFailAt = -1e9
		if N.Move.busy then
			N.moveReset("the hatch stalled")
		end
		if mainAge > 30 then
			N.restartLoop("Main", string.format("the hatch stalled and the Main loop had no turn for %d s", math.floor(mainAge)))
		end
		return true
	end
