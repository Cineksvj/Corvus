	N.onEvent("ColosseumService.RE.WaveDefenseOpponentDefeated", function(p)
		Arena.progressAt = os.clock()
		local id = if type(p) == "table" then p.OpponentId else p
		if id ~= nil and Arena.opponents[tostring(id)] then
			Arena.opponents[tostring(id)] = nil
			Arena.charge = math.min(Arena.charge + 12, 100)
		end
		-- 2026-11-01: a defeated pet can leave a drop ({Id, Kind, ExpiresAt}); collected while the hub plays the arena
		if type(p) == "table" and type(p.Drop) == "table" and N.collectDrop and N.does("AutoPetDefense") then
			N.collectDrop(p.Drop)
		end
	end)
	N.onEvent("ColosseumService.RE.WaveDefenseHeartLost", function(p)
		Arena.progressAt = os.clock()
		if type(p) == "table" and p.OpponentId ~= nil then
			Arena.opponents[tostring(p.OpponentId)] = nil
		end
	end)
	N.onEvent("ColosseumService.RE.WaveDefenseWaveComplete", function(p)
		Arena.progressAt = os.clock()
		if type(p) == "table" then
			Arena.waves = math.max(Arena.waves, tonumber(p.WaveCompleted) or 0)
			if Arena.active and Arena.waves % 5 == 0 then
				log("ARENA wave=" .. Arena.waves .. " t=" .. string.format("%.0f", os.clock() - (Arena.startedAt or os.clock())) .. "s hearts=" .. tostring(p.Hearts))
			end
			local offers = {}
			if type(p.Offers) == "table" then
				for _, o in ipairs(p.Offers) do
					table.insert(offers, if type(o) == "table" then tostring(o.Name or o.Id or "?") else tostring(o))
				end
			end
			if #offers > 0 then
				Arena.offerAt = os.clock()
			end
			-- G5-5: the raw payload once per run (what the server sends after waves 3/6/9...).
			if not Arena.waveLogged and (#offers > 0 or Arena.waves >= 3) then
				Arena.waveLogged = true
				log("ARENA wave=" .. Arena.waves .. " offers=" .. (if #offers > 0 then table.concat(offers, ",") else "-") .. " next_in=" .. tostring(p.NextWaveIn or p.BreakTime or "?") .. " payload=" .. brief(p))
			end
		end
	end)
	N.onEvent("ColosseumService.RE.WaveDefenseWaveStarting", function(p)
		Arena.progressAt = os.clock()
		-- the real client reads the whole spawn list of the wave here (PendingSpawns), so do we
		if type(p) == "table" and type(p.PendingSpawns) == "table" then
			for _, s in ipairs(p.PendingSpawns) do
				if type(s) == "table" and s.Id ~= nil and not Arena.opponents[tostring(s.Id)] then
					Arena.opponents[tostring(s.Id)] = { id = s.Id, arrival = tonumber(s.ArrivalTime) or math.huge, spawn = tonumber(s.SpawnTime) or 0, ability = s.Ability, shield = s.Shield }
				end
			end
		end
		if Arena.offerAt and N.probeState("colosseum_offers") == "untested" then
			N.probeResult("colosseum_offers", "accepted", "gain=the run goes on after the offers (wave " .. Arena.waves .. ")")
		end
		Arena.offerAt = nil
	end)
	N.onEvent("ColosseumService.RE.WaveDefenseGameOver", function(p)
		Arena.active = false
		Arena.result = p
	end)
	function N.knownOpponent(id)
		return id ~= nil and Arena.opponents[tostring(id)] ~= nil
	end
	-- What a relic adds, as a share of income: Click Multiplier and Rebirth Multiplier 1:1, Critical Chance through the
	-- crit damage on the manual taps, Hatch Speed and Secret Luck through the hatch share, Walkspeed nothing.
	function N.relicScore(boosts)
		local score = 0
		for _, b in ipairs(N.tableOr(boosts)) do
			local v = tonumber(type(b) == "table" and b.Value) or 0
			local kind = type(b) == "table" and b.Type
			if kind == "ClickMultiplier" or kind == "RebirthMultiplier" then
				score += v
			elseif kind == "CriticalPower" then
				-- strategy.md item 1: a +CriticalPower defense relic is worth the live crit weight on the manual income
				score += v * (if N.critWeight then N.critWeight() else 0.6)
			elseif kind == "CriticalChance" then
				score += v * 9 / (1 + 0.1 * 9) * 0.8
			elseif kind == "HatchSpeed" then
				-- REV-10: hatch speed at h (the measured value of a second of hatching), luck by the power it adds per hatch
				-- G4 (3937): +v speed = N.hatchSpeedGain(v) more eggs (the fixed part of the server's hold does not shrink)
				score += N.hatchSpeedGain(v) * N.hatchWeight()
			elseif kind == "SecretLuck" or kind == "Luck" then
				score += N.luckGain(v) * N.hatchWeight()
			end
		end
		return score
	end
	function N.currentRelic()
		local relic = N.sub(N.sub(N.data(), "Colosseum"), "Relic")
		return relic, N.relicScore(relic.Boosts)
	end
	-- Expected gain of one run in seconds of income over 24 h: the relics the best wave rolls (deterministic sample of the
	-- boost ranges), minus the current relic where they are worse.
	-- REV-10: the extra rewards of a run from the game's own pool (WaveDefenseConfig.ExtraRewardPool, 3097 L371946-371981;
	-- RollExtraRewards draws 1-3 of the entries open at that wave, L372026-372085), each at its item value now.
	function N.defenseExtras(wave)
		local total, sum = 0, 0
		for _, e in ipairs(N.tableOr(WaveCfg.ExtraRewardPool)) do
			if type(e) == "table" and (tonumber(e.MinWave) or 1) <= wave then
				local w = tonumber(e.Weight) or 0
				local amount = if type(e.Amount) == "table" then ((tonumber(e.Amount[1]) or 1) + (tonumber(e.Amount[2]) or 1)) / 2 else (tonumber(e.Amount) or 1)
				local v = 0
				if e.Name == "Gems" then
					v = (wave + 1) * 0.45 * (if N.gemWorth then N.gemWorth() else 0)
				elseif N.itemValue then
					v = N.itemValue(tostring(e.Name)) * amount
				end
				total += w
				sum += w * v
			end
		end
		return if total > 0 then 2 * sum / total else 0
	end
	function N.defenseValue()
		-- REV-5 (live: `pet defense not worth the trip (value 118 is, cost 165 is)` every session): the wave the runs really
		-- reach (the last run's waves, remembered per game version) instead of BestWave alone (it stayed <= 5 while the hub's
		-- runs reached 12-13)
		local best = tonumber(N.sub(N.sub(N.data(), "Colosseum"), "BestWave")) or 0
		local measured = tonumber(N.probeState("defense_waves")) or 0
		local wave = math.max(best, measured, 5)
		local weights
		for _, tier in ipairs(N.tableOr(WaveCfg.RelicTierWeights)) do
			if type(tier) == "table" and type(tier.Waves) == "table" and wave >= (tier.Waves[1] or 0) and wave <= (tier.Waves[2] or math.huge) then
				weights = tier.Weights
			end
		end
		local relics = N.tableOr(N.tableOr(N.tableOr(RelicCfg.Slots).ColloseumRelic).Relics)
		if type(weights) ~= "table" or next(relics) == nil then
			return N.defenseExtras(wave), wave
		end
		local held, current = N.currentRelic()
		-- R6-5: the Smart Planner alone keeps the relic the player holds, so a run is worth only its extras then
		if next(held) ~= nil and not on("AutoPetDefense") then
			return N.defenseExtras(wave), wave
		end
		local total, gain = 0, 0
		for name, w in pairs(weights) do
			local cfg = relics[name]
			if type(cfg) == "table" then
				-- five evenly spread rolls of every range (low, mid ... high)
				for step = 0, 4 do
					local f = step / 4
					local boosts = {}
					for _, b in ipairs(N.tableOr(cfg.Boosts)) do
						local lo = type(b.Value) == "table" and b.Value[1] or b.Value
						local hi = type(b.Value) == "table" and b.Value[2] or b.Value
						local v = (tonumber(lo) or 0) + ((tonumber(hi) or 0) - (tonumber(lo) or 0)) * f
						table.insert(boosts, { Type = b.Type, Value = v * (tonumber(b.Chance) or 1) })
					end
					gain += (tonumber(w) or 0) * math.max(N.relicScore(boosts) - current, 0)
					total += tonumber(w) or 0
				end
			end
		end
		return (if total > 0 then gain / total else 0) * 86400 + N.defenseExtras(wave), wave
	end
	function N.defenseDue()
		local cd = tonumber(N.sub(N.sub(N.data(), "Colosseum"), "Cooldown")) or 0
		return os.clock() >= Arena.nextAt and N.serverTime() >= cd + 1800 and type(W.Colosseum.GetEntrance) == "function"
	end
	local function target(now)
		local best
		for _, o in pairs(Arena.opponents) do
			if o.spawn <= now and o.arrival > now and o.ability ~= "Escort" and (not best or o.arrival < best.arrival) then
				best = o
			end
		end
		return best
	end
	local function closeArenaHud()
		pcall(function()
			local gui = LocalPlayer:FindFirstChild("PlayerGui")
			local wave = gui and gui:FindFirstChild("WaveDefense")
			if wave then
				local hud = wave:FindFirstChild("WaveHUD")
				if hud then
					hud.Visible = false
				end
				wave.Enabled = false
				log("DEFENSE closed HUD")
			end
		end)
	end
	N.closeArenaHud = closeArenaHud
	function N.defenseTrip()
		Arena.nextAt = os.clock() + 300
		local okE, entrance = pcall(W.Colosseum.GetEntrance)
		if not okE or not entrance then
			return 0
		end
		N.tripBegin("pet defense")
		N.loopStatus("Main", "starting Pet Defense")
		local at = N.posOf(entrance)
		if at then
			N.teleport(at + Vector3.new(0, 3, 0), 0.5)
		end
		table.clear(Arena.opponents)
		Arena.charge, Arena.lastCrit, Arena.waves, Arena.result, Arena.offerAt, Arena.waveLogged = 0, -1e9, 0, nil, nil, false
		local start = invoke("ColosseumService.RF.StartWaveDefense")
		-- live 4020 (2026-10-17): {Error="Step onto the Pet Defense entrance."} right after the teleport; the server had
		-- not seen the character inside the entrance yet. Step in again and ask twice more, 1 s apart.
		for _ = 1, 2 do
			if not (type(start) == "table" and type(start.Error) == "string" and string.find(start.Error, "entrance", 1, true)) then
				break
			end
			if at then
				N.teleport(at + Vector3.new(0, 1, 0), 0.3)
			end
			task.wait(1)
			start = invoke("ColosseumService.RF.StartWaveDefense")
		end
		-- 3933: a run whose reward was never claimed (hub reloaded or teleported mid-run) blocks every new start with
		-- {Error="Claim your previous reward first.", RewardData={NewRelic, WaveReached, ...}}. Claim it by the same rule as
		-- after a run (replace only a weaker relic; the Smart Planner alone swaps none), then start once more.
		if type(start) == "table" and type(start.RewardData) == "table" and type(start.RewardData.NewRelic) == "table" then
			local pendingRelic = start.RewardData.NewRelic
			local relic, cur = N.currentRelic()
			local newScore = N.relicScore(pendingRelic.Boosts)
			local choice = if newScore > cur or next(relic) == nil then "replace" else "keep"
			if choice == "replace" and next(relic) ~= nil and not on("AutoPetDefense") then
				choice = "keep"
			end
			local claimed = invoke("ColosseumService.RF.ClaimMinigameReward", choice)
			log("DEFENSE claimed the pending reward first", "wave", tostring(start.RewardData.WaveReached), "relic", tostring(pendingRelic.Name), choice, brief(claimed))
			task.wait(0.5)
			start = invoke("ColosseumService.RF.StartWaveDefense")
		end
		if type(start) ~= "table" or start.OnCooldown or start.Error then
			Arena.nextAt = os.clock() + math.max(tonumber(type(start) == "table" and start.Remaining) or 300, 60)
			note("defense", "not started: " .. brief(start))
			-- the entrance opened the game's Pet Defense screen: never leave it on screen (owner 2026-10-17)
			pcall(closeArenaHud)
			N.tripEnd()
			return 0
		end
		for _, s in ipairs(N.tableOr(start.PendingSpawns)) do
			if type(s) == "table" and s.Id ~= nil then
				Arena.opponents[tostring(s.Id)] = { id = s.Id, arrival = tonumber(s.ArrivalTime) or math.huge, spawn = tonumber(s.SpawnTime) or 0, ability = s.Ability }
			end
		end
		Arena.active = true
		Arena.startedAt = os.clock()
		Arena.progressAt = os.clock()
		-- Relic quality is decided by the wave reached (RelicTierWeights: Gold/Platinum/Diamond from wave 30). Live 4006: both
		-- runs hit the old 420 s cap at wave 29 (one wave short of the tier) and lost 7 minutes of hatching each. Stop as soon as
		-- the next tier boundary (first tier start >= 20, fallback 30) is cleared, hard cap 600 s.
		local goalWave = 30
		for _, tier in ipairs(N.tableOr(WaveCfg.RelicTierWeights)) do
			if type(tier) == "table" and type(tier.Waves) == "table" and (tonumber(tier.Waves[1]) or 0) >= 20 then
				goalWave = tonumber(tier.Waves[1])
				break
			end
		end
		local stopAt = os.clock() + 600
		local attacks, accepted, crits, critHits, streak, side = 0, 0, 0, 0, 0, 1
		local inFlight, critFlight, critMiss = 0, false, 0
		local nextAttack, lastStep = os.clock(), os.clock()
		N.loopStatus("Main", "Pet Defense: attacking")
		while Arena.active and os.clock() < stopAt and alive() do
			if Arena.waves >= goalWave and not Arena.offerAt then
				log("DEFENSE goal wave " .. goalWave .. " cleared after " .. string.format("%.0f", os.clock() - Arena.startedAt) .. "s")
				break
			end
			if os.clock() - Arena.progressAt > 60 then
				log("DEFENSE stalled wave=" .. Arena.waves .. " reason=no payload 60 s")
				break
			end
			if Arena.offerAt and os.clock() - Arena.offerAt > 6 then
				-- The run waits on an upgrade offer that this game version cannot answer: end it, the relic is kept.
				if N.probeState("colosseum_offers") == "untested" then
					N.probeResult("colosseum_offers", "rejected", "gain=0 (no next wave after the offers, ended at wave " .. Arena.waves .. ")")
				end
				invoke("ColosseumService.RF.EndWaveDefense")
				break
			end
			local now = N.serverTime()
			local o = target(now)
			-- The critical lane: independent of the normal lane, the moment the charge is full and 4 s passed. REV-13 PROBE
			-- colosseum_crit: the first answered critical = accepted; three unanswered in a row = rejected (the lane stays off).
			if o and not critFlight and Arena.charge >= 100 and os.clock() - Arena.lastCrit >= 4.05 and N.probeState("colosseum_crit") ~= "rejected" then
				local c = o
				for _, x in pairs(Arena.opponents) do
					if x.spawn <= now and x.arrival > now and not x.shield and (c.shield or x.arrival < c.arrival) then
						c = x
					end
				end
				critFlight = true
				crits += 1
				task.spawn(function()
					local r = invoke("ColosseumService.RF.CriticalAttackOpponent", c.id)
					critFlight = false
					if type(r) == "table" then
						critHits += 1
						critMiss = 0
						if N.probeState("colosseum_crit") == "untested" then
							N.probeResult("colosseum_crit", "accepted", string.format("gain=a x10 hit every 4 s (health left %s, pushed back to %s)", tostring(r.Health or "?"), tostring(r.NewArrivalTime or "-")))
						end
						Arena.charge = 0
						Arena.lastCrit = os.clock()
						if tonumber(r.NewArrivalTime) then
							c.arrival = r.NewArrivalTime
						end
						if r.Defeated then
							Arena.opponents[tostring(c.id)] = nil
						end
					else
						Arena.lastCrit = os.clock() - 3
						critMiss += 1
						if critMiss >= 3 and N.probeState("colosseum_crit") == "untested" then
							N.probeResult("colosseum_crit", "rejected", "gain=0 (three criticals at full charge unanswered), the normal lane only")
						end
					end
				end)
			end
			-- The normal lane at the adaptive cadence, at most two in flight.
			if o and inFlight < 2 and os.clock() >= nextAttack and not Arena.offerAt then
				inFlight += 1
				attacks += 1
				nextAttack = os.clock() + Arena.cadence
				task.spawn(function()
					local r = invoke("ColosseumService.RF.AttackOpponent", o.id)
					inFlight -= 1
					if type(r) == "table" then
						accepted += 1
						Arena.progressAt = os.clock()
						streak += 1
						Arena.charge = math.min(Arena.charge + 7, 100)
						if tonumber(r.NewArrivalTime) then
							o.arrival = r.NewArrivalTime
						end
						if r.Defeated then
							Arena.opponents[tostring(o.id)] = nil
						end
						if streak >= 50 then
							streak = 0
							Arena.cadence = math.max(Arena.cadence - 0.005, 0.121)
						end
					elseif Arena.active and not Arena.offerAt and o.arrival > N.serverTime() then
						streak = 0
						Arena.cadence = math.min(Arena.cadence + 0.01, 0.16)
					end
				end)
			end
			-- Hazard step: Kraken / Medusa put a hazard where the player stood 2.5 s earlier.
			if os.clock() - lastStep > 2 then
				for _, x in pairs(Arena.opponents) do
					if x.ability == "Kraken" or x.ability == "Medusa" then
						local root = N.root()
						if root then
							pcall(function()
								root.CFrame = root.CFrame + Vector3.new(15 * side, 0, 0)
							end)
							side = -side
						end
						break
					end
				end
				lastStep = os.clock()
			end
			task.wait(0.02)
		end
		local state = N.probeState("colosseum_cadence")
		if attacks >= 200 and tonumber(state) == nil then
			local share = accepted / math.max(attacks, 1)
			N.probeResult("colosseum_cadence", if share >= 0.97 then "accepted" else "rejected", string.format("gain=%.1f attacks/s at=%.3f (%d/%d accepted, criticals %d/%d)", accepted / math.max(os.clock() - Arena.startedAt, 1), Arena.cadence, accepted, attacks, critHits, crits), string.format("%.3f", Arena.cadence))
		end
		-- End the run on the server (it builds the reward then; the old cap path skipped this and the reward showed up only at
		-- the next start as "Claim your previous reward first"), give the GameOver event a moment, then leave the arena.
		if Arena.active then
			invoke("ColosseumService.RF.EndWaveDefense")
			waitFor(function()
				return not Arena.active
			end, 2)
		end
		Arena.active = false
		invoke("ColosseumService.RF.ReturnFromArena")
		-- The reward: replace the relic only when the new one scores higher.
		local pending = waitFor(function()
			return type(N.sub(N.sub(N.data(), "Colosseum"), "PendingReward").NewRelic) == "table"
		end, 5) and N.sub(N.sub(N.data(), "Colosseum"), "PendingReward")
		local choice, newScore, oldScore, relicName = "keep", 0, 0, "?"
		if pending then
			local relic, cur = N.currentRelic()
			oldScore = cur
			newScore = N.relicScore(pending.NewRelic.Boosts)
			relicName = tostring(pending.NewRelic.Name)
			choice = if newScore > oldScore or next(relic) == nil then "replace" else "keep"
			-- R6-5 (OWNER_RULES 21): the Smart Planner alone never swaps a relic the player holds; with Auto Pet Defense on
			-- the better relic replaces it (the toggle says so)
			if choice == "replace" and next(relic) ~= nil and not on("AutoPetDefense") then
				choice = "keep"
				relicName = relicName .. " (kept yours: the Smart Planner alone swaps no relic)"
			end
		else
			-- REV-5: no reward data in the replica: replace only when no Pet Defense relic is held (Data.Colosseum.Relic, the
			-- slot the reward goes to; the mastery relic is a different slot)
			local held = N.sub(N.sub(N.data(), "Colosseum"), "Relic")
			choice = if next(held) == nil then "replace" else "keep"
		end
		invoke("ColosseumService.RF.ClaimMinigameReward", choice)
		local boostText = {}
		for _, b in ipairs(N.tableOr(pending and pending.NewRelic.Boosts)) do
			if type(b) == "table" then
				table.insert(boostText, string.format("%s %s", tostring(b.Type), if (tonumber(b.Value) or 0) < 1 then math.floor((tonumber(b.Value) or 0) * 100 + 0.5) .. "%" else tostring(b.Value)))
			end
		end
		log(string.format("DEFENSE wave %d relic %s %s -> %s (score %.3f vs %.3f) attacks %d/%d at %.3fs criticals %d/%d", Arena.waves, relicName, table.concat(boostText, " "), choice, newScore, oldScore, accepted, attacks, Arena.cadence, critHits, crits))
		task.wait(0.5)
		closeArenaHud()
		Arena.last = string.format("%d waves, %d/%d attacks, relic %s (%s)", Arena.waves, accepted, attacks, relicName, choice)
		note("defense", Arena.last)
		-- REV-5: the wave this account's runs reach is what the next run is priced at
		if Arena.waves > 0 then
			local old = tonumber(N.probeState("defense_waves"))
			N.probeSet("defense_waves", tostring(if old then math.floor((old + Arena.waves) / 2 + 0.5) else Arena.waves))
		end
		Arena.nextAt = os.clock() + 1800
		N.tripEnd()
		return Arena.waves
	end

	-- ===== Shrine (Ts2Islands.Autumn.Shrine, ShrineService.RF.Choose(key), UseDistance 45): one blessing, chosen once;
	-- the tier grows with time (x1.1 / x1.25 / x1.5 after 0 / 600 / 1500 s), so it is never re-chosen while it runs. =====
	N.ShrineKeys = { Luck = true, Golden = true, AutoClicker = true }
	-- REV-10: what the blessing is worth (tier 3 = x1.5 after 25 min, kept while the account stays): Luck by the power +50 %
	-- luck adds per hatch (N.luckGain) at h; Golden by +50 % of the 1-in-20 golden roll (a golden is x3 power: +5 % power per
	-- hatch) at h; the Auto Clicker by the auto lane's share of the tap coins (the server admits one tap per 0.1 s across
	-- both lanes, so a faster auto lane only fills the manual lane's gaps).
