	-- R7-1 (owner's 8.7 h run of build E: `lua 2752MB`, the Lua heap from ~50 MB to 2.75 GB): every 10 minutes one MEM line
	-- with the Lua heap and a census of the hub's OWN tables (walked from N, Session, Log, Perf, UIQueue and the UI library;
	-- the game's modules and save are left out): the 5 biggest by entries and the 3 that grew most since the last line. A
	-- leak in the hub names itself; a flat hub next to a growing heap points at the game (the Roblox memory tags follow).
	N.Mem = { prev = nil, at = nil, lua = nil, last = nil }
	local function pathKey(k)
		if type(k) == "number" then
			return "[]"
		end
		if type(k) == "string" and #k <= 24 and string.match(k, "^[%a_][%w_]*$") then
			return "." .. k
		end
		return ".*"
	end
	function N.memCensus()
		local seen, rows = {}, {}
		local function skip(t)
			if type(t) == "table" then
				seen[t] = true
			end
		end
		-- the census's own memory (the last report's paths)
		skip(N.Mem)
		-- the game's own tables: its modules (N.G, N.W, N.X hold the required modules) and the save with its first levels
		for _, group in ipairs({ N.G, N.W, N.X }) do
			if type(group) == "table" then
				for _, m in pairs(group) do
					skip(m)
				end
			end
		end
		local data = N.data()
		if type(data) == "table" then
			skip(data)
			for _, v in pairs(data) do
				if type(v) == "table" then
					skip(v)
					for _, w in pairs(v) do
						skip(w)
					end
				end
			end
		end
		local tables, entries, budget = 0, 0, 60000
		local function walk(t, path, depth)
			seen[t] = true
			budget -= 1
			tables += 1
			local n = 0
			for k, v in pairs(t) do
				n += 1
				if type(v) == "table" and not seen[v] and depth < 10 and budget > 0 then
					walk(v, path .. pathKey(k), depth + 1)
				end
			end
			entries += n
			local row = rows[path]
			if row then
				row.n += n
				row.t += 1
			else
				rows[path] = { n = n, t = 1 }
			end
		end
		for _, root in ipairs({ { "N", N }, { "Session", Session }, { "Log", Log }, { "Perf", Perf }, { "UIQueue", UIQueue }, { "Library", Library } }) do
			if type(root[2]) == "table" and not seen[root[2]] then
				walk(root[2], root[1], 0)
			end
		end
		return { rows = rows, tables = tables, entries = entries, capped = budget <= 0 }
	end
	function N.memReport()
		local c = N.memCensus()
		local list = {}
		for path, row in pairs(c.rows) do
			table.insert(list, { path = path, n = row.n, t = row.t })
		end
		table.sort(list, function(a, b)
			return a.n > b.n
		end)
		local top = {}
		for i = 1, math.min(5, #list) do
			local r = list[i]
			table.insert(top, string.format("%s=%d%s", r.path, r.n, if r.t > 1 then "/" .. r.t .. "t" else ""))
		end
		local grew = {}
		local prev = N.Mem.prev
		if prev then
			local deltas = {}
			for _, r in ipairs(list) do
				local d = r.n - (prev[r.path] or 0)
				if d > 0 then
					table.insert(deltas, { path = r.path, d = d })
				end
			end
			table.sort(deltas, function(a, b)
				return a.d > b.d
			end)
			for i = 1, math.min(3, #deltas) do
				table.insert(grew, string.format("%s+%d", deltas[i].path, deltas[i].d))
			end
		end
		-- the next comparison: every path pattern (bounded, a few hundred strings: array keys share one "[]" pattern)
		local keep = {}
		for _, r in ipairs(list) do
			keep[r.path] = r.n
		end
		N.Mem.prev = keep
		local lua = nil
		pcall(function()
			lua = gcinfo() / 1024
		end)
		local rate = ""
		if lua and N.Mem.lua and N.Mem.at and os.clock() - N.Mem.at > 60 then
			rate = string.format(" (%+d MB/h)", math.floor((lua - N.Mem.lua) / ((os.clock() - N.Mem.at) / 3600)))
		end
		N.Mem.lua, N.Mem.at = lua, os.clock()
		local tags = {}
		pcall(function()
			local stats = game:GetService("Stats")
			for _, pair in ipairs({ { "luaheap", "LuaHeap" }, { "signals", "Signals" }, { "gui", "Gui" }, { "inst", "Instances" } }) do
				local ok, mb = pcall(function()
					return stats:GetMemoryUsageMbForTag(Enum.DeveloperMemoryTag[pair[2]])
				end)
				if ok and type(mb) == "number" then
					table.insert(tags, string.format("%s=%d", pair[1], math.floor(mb)))
				end
			end
		end)
		local owned = 0
		for _ in pairs(N.owned and N.owned() or {}) do
			owned += 1
		end
		-- the game's screen objects (a GUI that piles up shows here, next to the Roblox "gui" MB)
		local guiCount = "?"
		pcall(function()
			local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
			if pg then
				guiCount = tostring(#pg:GetDescendants())
			end
		end)
		N.Mem.last = { lua = lua, tables = c.tables, entries = c.entries, top = if list[1] then list[1].path .. "=" .. list[1].n else "-" }
		-- ~ bytes: 40 per entry and 56 per table header, an estimate for "hub or game" at a glance
		log(string.format(
			"MEM lua=%sMB%s hub=%d entries/%d tables (~%.1fMB)%s top: %s%s | roblox MB %s | owned pets %d, PlayerGui objects %s",
			if lua then tostring(math.floor(lua)) else "?",
			rate,
			c.entries,
			c.tables,
			(c.entries * 40 + c.tables * 56) / 1048576,
			if c.capped then " (census capped)" else "",
			table.concat(top, ", "),
			if #grew > 0 then " | grew: " .. table.concat(grew, ", ") else "",
			if #tags > 0 then table.concat(tags, " ") else "?",
			owned,
			guiCount
		))
	end
