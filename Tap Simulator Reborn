					N.World.last.potions = "drank " .. name
					-- R2-6: when the next one goes in (30 s before this one runs out)
					local def = N.tableOr(N.tableOr(W.Boosts.Definitions)[name])
					local left = tonumber(result.TimeLeft) or tonumber(def.Duration) or 0
					log(string.format("POTION drank %s (next in %s)", name, N.longTime(math.max(left - 30, 0))))
					return true
				else
					N.World.at["drink " .. name] = os.clock()
					log("POTION", name, "refused:", brief(result))
					return false
				end
			end
		end
		-- one line every 5 minutes with what runs
		if N.due("potionActive", 300) then
			local parts = {}
			for _, name in ipairs({ "Coins Potion I", "Coins Potion II", "Luck Potion I", "Luck Potion II", "Gems Potion I", "Gems Potion II" }) do
				local left = tonumber(N.sub(N.data(), "ActiveBoosts")[name])
