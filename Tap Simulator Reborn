	-- R5-4 (live 22:07 and 21:53: the character stood at the island's arrival point, `TRAVEL Shadow Realm ok` and then
	-- nothing from the Main loop for 13+ minutes; the Cloud Rain trip ran 40 s past its own 100 s limit and never came
	-- back): RequestStreamAroundAsync did not come back on Potassium, its own timeout did not end it, and the caller (the
	-- teleport, the cloud sweep) waited for good. The request now runs in its own thread and the caller waits at most the
	-- timeout + 0.5 s; while an earlier request is still out, new ones are skipped for 60 s (a jammed queue is not fed).
	N.Stream = { out = 0, stuck = 0, stuckAt = -1e9, hung = 0, skipped = 0, logAt = -1e9 }
	function N.streamAround(pos, timeout)
		local St = N.Stream
		timeout = math.clamp(tonumber(timeout) or 5, 0.2, 5)
		if typeof(pos) ~= "Vector3" then
			return false
		end
		if St.stuck > 0 and (os.clock() - St.stuckAt < 60 or St.hung >= 20) then
			St.skipped += 1
			return false
		end
		local done, late = false, false
		St.out += 1
		task.spawn(function()
			pcall(function()
				LocalPlayer:RequestStreamAroundAsync(pos, timeout)
			end)
			done = true
			St.out -= 1
			if late then
				St.stuck = math.max(St.stuck - 1, 0)
			end
		end)
		local waited = 0
		while not done and waited < timeout + 0.5 do
			waited += task.wait(0.05) or 0.05
		end
		if done then
			return true
		end
		late = true
		St.stuck += 1
		St.hung += 1
		St.stuckAt = os.clock()
		if os.clock() - St.logAt > 60 then
			St.logAt = os.clock()
			log(string.format("STREAM request at %s gave no answer in %.1fs (%d so far), moving on", brief(pos), waited, St.hung))
		end
		return false
	end
