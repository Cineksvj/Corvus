function N.tripWatchdog()
	local T = N.Trip
	if T.active and os.clock() - T.since > (T.cap or 120) + 30 then
		local name = tostring(T.name)
		logProblem(string.format("trip %s over cap (%ds, cap %ds), ended", name, math.floor(os.clock() - T.since), T.cap or 120))
		-- R5-4: the whole trip state goes back (pet lock, hidden menus, a teleport left half done, the hatch pacing, the
		-- status); the monitor restarts the Main loop when it does not come back by itself (p11)
		N.tripEnd()
