	function N.loopStatus(loop, text)
		if N.LoopStatus[loop] ~= text then
			N.LoopStatus[loop] = text
			local key = loop .. text
			if not LoopSeen[key] then
				LoopSeenCount += 1
				if LoopSeenCount > 300 then
					table.clear(LoopSeen)
					LoopSeenCount = 0
				end
			end
			-- inside a trip the trip's own lines (CRAFT, TRAVEL, UNLOCK, MINE, DEFENSE ...) tell the story
			local inTrip = N.Trip ~= nil and N.Trip.active
			if Logged[loop] and not inTrip and os.clock() - (LoopSeen[key] or -1e9) > 120 then
				LoopSeen[key] = os.clock()
				log(string.upper(loop) .. " now: " .. text)
			end
		end
