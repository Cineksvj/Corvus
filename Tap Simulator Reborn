	-- Owner 2026-10-11: Stop Everything remembers the toggles it switched off (memory + Corvus/TAPSIM_lastrun.json) and
	-- Resume Last Setup switches exactly those back on, also after a restart. After Stop Everything the library's config
	-- auto save is held (it would store the stopped setup in the autoload config) until the player changes a saved control
	-- himself, resumes or loads a config. The hold uses the library's own pause (Library.ConfigLoadFailed = the autoload
	-- name: AutoSaveNow skips that config) and puts the previous values back when it ends.
	local LastRunFile = "Corvus/TAPSIM_lastrun.json"
	N.LastRun = nil
	N.SaveHold = { on = false }
	local function autoloadName()
		local ok, name = pcall(function()
			return SaveManager:GetAutoloadConfig()
		end)
		return if ok and type(name) == "string" and name ~= "" then name else "none"
	end
	local function knownToggle(name)
		return table.find(N.AllAutoToggles, name) ~= nil
	end
	local function writeLastRun(names)
		local quoted = {}
		for _, name in ipairs(names) do
			table.insert(quoted, '"' .. name .. '"')
		end
		pcall(function()
			if makefolder and isfolder and not isfolder("Corvus") then
				makefolder("Corvus")
			end
			writefile(LastRunFile, string.format('{"at":%d,"toggles":[%s]}', os.time(), table.concat(quoted, ",")))
		end)
	end
	local function readLastRun()
		local ok, text = pcall(function()
			return if isfile(LastRunFile) then readfile(LastRunFile) else nil
		end)
		if not ok or type(text) ~= "string" then
			return nil
		end
		local list = string.match(text, '"toggles"%s*:%s*%[(.-)%]')
		if not list then
			return nil
		end
		local names = {}
		for name in string.gmatch(list, '"([%w_]+)"') do
			if knownToggle(name) and not table.find(names, name) then
				table.insert(names, name)
			end
		end
		return { at = tonumber(string.match(text, '"at"%s*:%s*(%d+)')) or 0, toggles = names }
	end
	-- Controls the config does not store (library settings, Quick Start copies) never end the hold.
	function N.notSaved(name)
		local ignore = (SaveManager and SaveManager.Ignore) or {}
		return type(name) ~= "string" or ignore[name] == true or name == "MenuKeybind" or string.find(name, "^SaveManager") ~= nil or string.find(name, "^Corvus") ~= nil or string.find(name, "^ThemeManager") ~= nil or string.sub(name, 1, 2) == "QS"
	end
	function N.releaseAutosave(why)
		local hold = N.SaveHold
		if not hold.on then
			return false
		end
		hold.on = false
		if Library.ConfigLoadFailed == hold.name then
			Library.ConfigLoadFailed = hold.prevFailed
		end
		Library.ConfigAutoSavePaused = hold.prevPaused
		log("CONFIG auto save on again (" .. tostring(why) .. ")")
		return true
	end
	function N.holdAutosave()
		local hold = N.SaveHold
		if not hold.on then
			hold.on = true
			hold.prevFailed = Library.ConfigLoadFailed
			hold.prevPaused = Library.ConfigAutoSavePaused
			-- the library's own "auto save paused" line is about a config that failed to load; the hold logs its own
			Library.ConfigAutoSavePaused = true
			hold.token = {}
			local token = hold.token
			-- follows a new autoload pick ("Autoload this" / "Clear autoload") while held; a config loaded meanwhile
			-- (the library clears the pause on a good load) ends the hold
			task.spawn(function()
				while hold.on and hold.token == token and alive() do
					task.wait(2)
					if not (hold.on and hold.token == token) then
						break
					end
					if Library.ConfigLoadFailed ~= hold.name then
						N.releaseAutosave("a config was loaded")
						break
					end
					local name = autoloadName()
					if name ~= hold.name then
						hold.name = name
						Library.ConfigLoadFailed = name
					end
				end
			end)
		end
		hold.name = autoloadName()
		Library.ConfigLoadFailed = hold.name
		log("CONFIG auto save held after Stop Everything (" .. hold.name .. " keeps the running setup until you change a control or resume)")
	end
	-- A change the player made himself (menu, Quick Bar, a mirror, a command, the wizard) ends the hold.
	function N.noteUserChange(name)
		if not N.SaveHold.on or N.quiet or N.notSaved(name) then
			return
		end
		local src = N.changeSource
		if src == nil or src == "ui" or src == "command" or src == "wizard" then
			N.releaseAutosave("CLICK " .. name)
		end
	end
	function N.stopAll()
		local off = {}
		N.quiet = true
		for _, name in ipairs(N.AllAutoToggles) do
			local toggle = Toggles[name]
			if toggle and toggle.Value then
				toggle:SetValue(false)
				table.insert(off, name)
			end
		end
		N.quiet = false
		N.stopHatchSession()
		-- pressing it again with everything off keeps the last setup to resume
		if #off > 0 then
			N.LastRun = { at = os.time(), toggles = off }
			writeLastRun(off)
			N.holdAutosave()
		end
		log("STOP everything off=" .. (if #off > 0 then table.concat(off, ",") else "-"))
		notify("Corvus", if #off > 0 then "Everything is off. Resume Last Setup turns it back on" else "Everything is off", 3)
	end
	function N.lastRunNames()
		local saved = N.LastRun or readLastRun()
		if saved and #saved.toggles > 0 then
			N.LastRun = saved
			return saved.toggles
		end
		return nil
	end
	function N.resumeLast()
		local names = N.lastRunNames()
		if not names then
			log("RESUME nothing saved")
			notify("Corvus", "Nothing to resume", 3)
			return false
		end
		N.releaseAutosave("Resume Last Setup")
		local want = {}
		for _, name in ipairs(names) do
			local toggle = Toggles[name]
			if toggle and not toggle.Value then
				table.insert(want, name)
			end
		end
		if #want > 0 then
			-- like a click: the CLICK lines say by=resume
			N.setToggles(want, { "on" }, "resume")
		end
		if N.syncMirrors then
			pcall(N.syncMirrors, "after Resume Last Setup")
		end
		log("RESUME toggles=" .. (if #want > 0 then table.concat(want, ",") else "-") .. (if #want < #names then " already on=" .. (#names - #want) else ""))
		notify("Corvus", if #want > 0 then string.format("%d toggles back on", #want) else "Your last setup is already on", 3)
		return true
	end
	function N.loadAutoload()
		local name = autoloadName()
		if name == "none" then
			log("CONFIG load skipped, no autoload config (button)")
			notify("Corvus", "No autoload config yet. Pick one in Settings > Configs > Autoload this", 4)
			return false
		end
		local before = N.changeSource
		N.changeSource = "config"
		local ok, success, err = pcall(function()
			return SaveManager:Load(name)
		end)
		N.changeSource = before
		if ok and success then
			N.releaseAutosave("config loaded")
			if N.syncMirrors then
				pcall(N.syncMirrors, "after Load Autoload Config")
			end
			log("CONFIG loaded " .. name .. " (button)")
			notify("Config loaded", name, 3)
			return true
		end
		local why = tostring(if ok then err else success)
		log("CONFIG not loaded " .. name .. " (button): " .. why)
		notify("Config not loaded", why, 4)
		return false
	end
	-- Unload: every game function the hub wrapped (hatch reveal skip, machine screens, HUD hides) goes back to the game's.
	INSTANCE.cleanup = function()
		for _, fn in ipairs(N.Restore) do
			pcall(fn)
		end
		table.clear(N.Restore)
	end
