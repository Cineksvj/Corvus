		if tickerHit then tickerHit.Size = landscape and UDim2.new(0, LAND_LEFT_W, 1, 0) or UDim2.new(0.55, 0, 1, 0) end
		if landscape then
			headerLeft.Size = UDim2.new(0, LAND_LEFT_W, 1, 0)
			headerRight.Size = UDim2.new(0, LAND_RIGHT_W, 1, 0)
			headerRight.Position = UDim2.new(1, -LAND_RIGHT_W, 0, 0)
			tabBar.Parent = header
			tabBar.ZIndex = 3
			tabBar.Position = UDim2.new(0, LAND_LEFT_W + 10, 0, 0)
			tabBar.Size = UDim2.new(1, -(LAND_LEFT_W + 10 + LAND_RIGHT_W + 10), 1, 0)
			-- the header drag handle (ZIndex 6, left half) sat over the first tab words here, so
			-- a tap on Main / Farm / Animals started a drag instead (Discord, phones, 2026-11-02:
			-- "only the last 3 tabs can be clicked"); in this row it covers the state box only
			local dh = header:FindFirstChild("DragHandle_Header")
			if dh then dh.Size = UDim2.new(0, LAND_LEFT_W, 1, 0) end
		else
			headerLeft.Size = UDim2.new(0.55, 0, 1, 0)
			headerRight.Size = UDim2.new(0.5, 0, 1, 0)
			headerRight.Position = UDim2.new(0.5, 0, 0, 0)
			tabBar.Parent = main
