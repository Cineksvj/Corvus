	-- ===== Remotes: ReplicatedStorage.RemoteServices.<Service>.<RE|RF>.<Name> (sleitnick Comm) =====
	-- notes.md "Anticheat": every remote passes the server's validateInbound. A bad argument is an instant KICK
	-- ("Anti Cheat Reason"): only ASCII strings <= 255 bytes (all strings <= 32768 bytes), finite numbers, <= 32 arguments,
	-- <= 4096 values, depth <= 10, only nil/boolean/number/string/table/Vector3/CFrame/Instance. A flood is dropped
	-- (80 burst / 40 per s per remote, 240 / 120 per s in total). The hub checks all of it BEFORE sending and keeps its
	-- own buckets well under the server's. Only the remotes in the allow lists below are ever sent; the admin, tester,
	-- telemetry, reconnect, Robux and trading remotes (notes.md NOT SAFE list) are not in them.
	function N.remote(path)
		local node = ReplicatedStorage:FindFirstChild("RemoteServices")
		for part in string.gmatch(path, "[^%.]+") do
			node = node and node:FindFirstChild(part)
		end
		return node
	end
	local function finite(n)
		return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
	end
	N.finite = finite
	local function checkValue(v, depth, budget, seen)
		local kind = typeof(v)
		if kind == "nil" or kind == "boolean" or kind == "Instance" then
			return true
		elseif kind == "number" then
			if not finite(v) then
				return false, "non-finite number"
			end
			return true
		elseif kind == "string" then
			if #v > 255 then
				return false, "string too long"
			end
			if string.find(v, "[\128-\255]") then
				return false, "non-ASCII text"
			end
			budget.bytes += #v
			if budget.bytes > 32000 then
				return false, "string payload too large"
			end
			return true
		elseif kind == "Vector3" then
			return finite(v.X) and finite(v.Y) and finite(v.Z), "non-finite Vector3"
		elseif kind == "CFrame" then
			local p = v.Position
			return finite(p.X) and finite(p.Y) and finite(p.Z), "non-finite CFrame"
		elseif kind == "table" then
			if depth >= 9 then
				return false, "table nesting too deep"
			end
			if seen[v] then
				return false, "cyclic table"
			end
			seen[v] = true
			for k, x in pairs(v) do
				budget.values += 2
				if budget.values > 4000 then
					return false, "too many values"
				end
				local ok, why = checkValue(k, depth + 1, budget, seen)
				if not ok then
					return false, why
				end
				ok, why = checkValue(x, depth + 1, budget, seen)
				if not ok then
					return false, why
				end
			end
			seen[v] = nil
			return true
		end
		return false, "unsupported " .. kind
	end
	function N.argsSafe(...)
		local n = select("#", ...)
		if n > 30 then
			return false, "too many arguments"
		end
		local budget, seen = { bytes = 0, values = 0 }, {}
		for i = 1, n do
			local ok, why = checkValue((select(i, ...)), 0, budget, seen)
			if not ok then
				return false, why
			end
		end
		return true
	end
	-- Own flood buckets: per remote 60 burst / 30 per s, all remotes 180 / 90 per s (the server drops above 80/40 and 240/120).
	local Buckets, Total = {}, { tokens = 180, at = os.clock() }
	local FloodLogAt = {}
	local function takeToken(name)
		local now = os.clock()
		local b = Buckets[name]
		if not b then
			b = { tokens = 60, at = now }
			Buckets[name] = b
		end
		b.tokens = math.min(60, b.tokens + (now - b.at) * 30)
		b.at = now
		Total.tokens = math.min(180, Total.tokens + (now - Total.at) * 90)
		Total.at = now
		if b.tokens < 1 or Total.tokens < 1 then
			if now - (FloodLogAt[name] or -1e9) > 30 then
				FloodLogAt[name] = now
				log("FLOOD guard held back", name, "(the server drops calls above its own limit)")
			end
			return false
		end
		b.tokens -= 1
		Total.tokens -= 1
		return true
	end
	local function isStr(v)
		return type(v) == "string" and v ~= ""
	end
	local function isInt(v, lo, hi)
		return finite(v) and v % 1 == 0 and v >= (lo or -math.huge) and v <= (hi or math.huge)
	end
