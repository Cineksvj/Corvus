	function N.drawStats()
		local elapsed = math.max(os.clock() - Session.started, 1)
		local n, limit = N.storage()
		N.StatRows.Coins.set(formatNumber(N.coins()))
		N.StatRows.CoinGain.set("+" .. formatNumber(Session.tapCoins))
		N.StatRows.Income.set(formatNumber(N.income()) .. "/s")
		-- REV-17: what the account gained, from the replica (gem rises, rebirth count), not only the hub's own presses
		N.StatRows.Gems.set(formatNumber(N.gems()) .. " / +" .. formatNumber(Session.gemsGained or 0))
		N.StatRows.Rebirths.set(formatNumber(N.rebirths()) .. " / +" .. formatNumber(math.max(N.rebirths() - (Session.rebirthsStart or N.rebirths()), 0)))
		N.StatRows.Time.set(string.format("%dh %02dm", elapsed // 3600, (elapsed % 3600) // 60))
		N.StatRows.Taps.set(string.format("%.1f + %.1f auto", N.Tap.rate, N.Tap.autoRate))
		N.StatRows.Hatched.set(formatNumber(Session.hatched) .. string.format(" / %d", N.hatchRecentRate()))
		N.StatRows.Storage.set(n .. " / " .. limit)
		N.StatRows.Crafts.set(string.format("%d / %d / %d", Session.crafts.Golden or 0, Session.crafts.Diamond or 0, Session.crafts.Shiny or 0))
		N.StatRows.Deleted.set(formatNumber(Session.deleted))
		N.StatRows.Power.set(formatNumber(N.equippedPower()))
		N.StatRows.Levels.set(formatNumber(Session.levelUps) .. " / " .. formatNumber(Session.treats))
		N.StatRows.Claims.set(Session.claims .. " / " .. Session.ducks)
		N.StatRows.Buys.set(Session.buys .. " / " .. Session.unlocks)
		local c = N.Xtra.counts
		N.StatRows.Enchants.set(c.rolls .. " / " .. c.kept)
		N.StatRows.Explore.set(c.chests .. " / " .. c.stars .. " / " .. c.quests)
		N.StatRows.Minigames.set(c.breaks .. " / " .. c.digs .. " / " .. c.memory)
		N.StatRows.Fishing.set(N.Fish.casts .. " / " .. N.Fish.reels .. " / " .. N.Fish.collected)
		N.StatRows.Heaven.set(N.Heaven.luckyEggs .. " / " .. N.Heaven.inflates .. " / " .. N.Give.entered)
	end
