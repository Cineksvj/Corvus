	local function routeLine(text)
		local tag, rest = string.match(text, "^(%u+)%s*(.*)$")
		if not tag then
			return nil
		end
		if tag == "HATCH" then
			if string.find(rest, "storage full", 1, true) then
				return "storage"
			elseif string.find(rest, "speed=", 1, true) then
				return "hatch_minute"
			elseif string.sub(rest, 1, 2) == "n=" then
				return nil -- the first-answer line
			end
			return "hatch_stop"
		elseif tag == "FISH" then
			local verb = string.match(rest, "^(%a+)")
			if verb == "cast" or verb == "stowed" or verb == "spot" then
				return nil -- every cast would be a post
			end
		elseif tag == "CLAIM" then
			if string.find(rest, "index", 1, true) or string.find(rest, "milestone", 1, true) then
				return "milestone"
			end
		elseif tag == "MINE" and string.find(rest, "milestone", 1, true) then
			return "milestone"
		elseif tag == "DEFENSE" and rest == "closed HUD" then
			return nil
		elseif tag == "BUY" then
			-- the buy itself is posted by N.Events.bought with the price; only a refusal comes from the log
			return if string.find(rest, "refused", 1, true) then "buy" else nil
		end
		return TagRoute[tag]
	end
