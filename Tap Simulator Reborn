				if island == "Spawn" or N.islandUnlocked(island) then
					N.loopStatus("Main", "Looking for the " .. m.point .. " machine on " .. island)
					if N.travel(island) then
						local top = workspace:FindFirstChild(m.model)
						if top then
							local okPivot, pivot = pcall(function()
								return top:GetPivot()
							end)
							if okPivot and pivot then
								N.streamAround(pivot.Position)
							end
						end
						if waitFor(function()
							return N.findPoint(m.point) ~= nil
						end, 5) then
							part = N.findPoint(m.point)
							break
						end
					end
				end
			end
		end
		if not part then
			-- Builder M (alt 2026-10-12: `CRAFT Diamond machine not found` and a new 30 s trip every minute while the
			-- storage was full): the machine rests 15 minutes
			C.missing = C.missing or {}
			C.missing[m.key] = os.clock() + 900
			log("CRAFT", m.point, "machine not found on any unlocked island, skipped for 15 min")
			return nil
		end
		if C.missing then
			C.missing[m.key] = nil
		end
		if not N.insidePoint(part) then
			N.teleport(standOn(part), 0.6)
		end
		if not N.insidePoint(part) then
			N.teleport(part.Position, 0.6)
		end
		return part
	end
	N.onEvent("MachineService.RE.MachineCraftResult", function(r)
		if type(r) ~= "table" then
			return
		end
		C.results += 1
		C.result = r
		-- A craft the player made by hand (no hub trip running): that spot is where the server accepts this machine.
		if not N.Trip.active and r.Success == true and type(r.Machine) == "string" and N.root() then
			saveSpot(r.Machine, N.currentIsland(), N.myPos())
			log("CRAFT learned the " .. r.Machine .. " machine spot from a craft by hand")
		end
	end)
	local function craftRequest(args, machine)
		local seq = C.results
		if not fire("MachineService.RE.MachineCraftRequested", args) then
			return false, "not sent"
		end
		local got = waitFor(function()
			return C.results > seq and C.result ~= nil and C.result.Machine == machine
		end, 6)
		if not got then
			return false, "no answer"
		end
		local r = C.result
		if r.Success == true then
			return true, r
		end
		return false, tostring(r.Reason or r.Error or "refused")
	end
	-- machine_gap (blatant.md #6 / F10): the next craft goes out right after the answer and the replica update; a busy
	-- answer adds 0.25 s and retries the same set, a clean craft takes 0.1 s off (floor 0.2 s).
	local function noteGap(ok)
		if ok then
			C.gap = math.max(C.gap - 0.1, 0.2)
		else
			C.gap = math.min(C.gap + 0.25, 4)
		end
	end
	-- ===== G2 Craft All (3937 code pass; Goldens mastery level 4, MasteryConfig bc 241469-241472): one request
	-- {Machine, Action="CraftAll", Names} (sendCraftAll 71317-71347) makes up to 60 sure crafts with the server's own spare
	-- rule (Shared.Pets.CraftAllPlan 237217-237344: right tier, not locked/frozen/equipped/in a team, no mutation, enchant,
	-- signature, leaderboard serial, not Secret; the needed count = the first one at 100 %; heaviest, then highest level
	-- copies first). The hub's own protect list and level team are unknown to the server, so `Names` holds ONLY the species
	-- whose every server-spare copy the hub would craft anyway (owner rules 20/23) and whose consumed copies are exactly the
	-- ones the hub would take: all of them (count a multiple of the set size) or copies that do not differ in level/weight;
	-- at most 60 crafts per request. After the answer the storage is checked: a copy outside the plan gone = probe craftall
	-- rejected (remembered per PlaceVersion), the normal one-set crafting goes on. Only while "Craft All" (default off,
	-- untested) is on. G3 craftall_far: once craftall was accepted, the first Craft All of a session is sent from where
	-- the player stands; accepted = the Golden/Diamond trip is skipped whenever Craft All covers every set. =====
	local CraftAllMod = nil
	local function craftAllModule()
		if type(CraftAllMod) ~= "table" then
			pcall(function()
				local sharedFolder = ReplicatedStorage:FindFirstChild("Shared")
				local inst = sharedFolder and sharedFolder:FindFirstChild("Pets")
				inst = inst and inst:FindFirstChild("CraftAllPlan")
				if inst and inst:IsA("ModuleScript") then
					local mod = require(inst)
					if type(mod) == "table" then
						CraftAllMod = mod
					end
				end
			end)
		end
		return if type(CraftAllMod) == "table" then CraftAllMod else nil
	end
	C.allOff = {}
	function N.craftAllUsable(m)
		if m.key ~= "Golden" and m.key ~= "Diamond" then
			return false, "machine"
		end
		if not on("CraftAll") then
			return false, "Craft All is off"
		end
		if not N.machineOwn(m) then
			return false, "index crafting"
		end
		if N.probeState("craftall") == "rejected" then
			return false, "probe craftall rejected on this game version"
		end
		if (C.allOff[m.key] or 0) > os.clock() then
			return false, "resting after a refusal"
		end
		local data = N.data()
		local fn = N.G.Mastery.HasUnlock
		if not data or type(fn) ~= "function" then
			return false, "no mastery data"
		end
		local ok, yes = pcall(fn, data, "CraftAll")
		if not (ok and yes == true) then
			return false, "Goldens mastery level 4 not reached"
		end
		return true
	end
	-- The plan: {names = {...}, crafts = n, expected = {[name] = copies consumed}, ids = {consumed ids}} or nil, why.
	function N.craftAllPlan(m, spent)
		local usable, why = N.craftAllUsable(m)
		if not usable then
			return nil, why
		end
		local plan = craftAllModule()
		if not plan or type(plan.IsSpare) ~= "function" or type(plan.Kept) ~= "function" then
			return nil, "no CraftAllPlan module"
		end
		local cfg = N.machineCfg(m.key)
		local need, sure = N.craftCount(m)
		if not cfg or not need or not sure then
			return nil, "not a 100 % craft"
		end
		local data = N.data()
		local okK, kept = pcall(plan.Kept, data)
		if not okK or type(kept) ~= "table" then
			return nil, "kept list unreadable"
		end
		spent = spent or {}
		local hub = N.craftHubGroups(m, spent) or {}
		local hubIds = {}
		for name, list in pairs(hub) do
			for _, e in ipairs(list) do
				hubIds[e.id] = name
			end
		end
		local srv = {}
		for id, pet in pairs(N.owned()) do
			local okS, spare = pcall(plan.IsSpare, id, pet, cfg.SourceTier, kept)
			if okS and spare == true and not spent[id] and type(pet.Name) == "string" then
				srv[pet.Name] = srv[pet.Name] or {}
				table.insert(srv[pet.Name], { id = id, w = tonumber(pet.Weight) or 0, l = tonumber(pet.Level) or 1 })
			end
		end
		local names = {}
		for name in pairs(srv) do
			table.insert(names, name)
		end
		table.sort(names)
		local out = { names = {}, crafts = 0, expected = {}, ids = {}, skipped = 0 }
		local maxCrafts = tonumber(plan.MaxCrafts) or 60
		for _, name in ipairs(names) do
			local list = srv[name]
			local sets = math.floor(#list / need)
			if sets >= 1 then
				local inside = not string.find(name, "[\128-\255]") and #name <= 100
				for _, e in ipairs(list) do
					if hubIds[e.id] ~= name then
						inside = false
						break
					end
				end
				local same = true
				for _, e in ipairs(list) do
					if e.w ~= list[1].w or e.l ~= list[1].l then
						same = false
						break
					end
				end
				if inside and (#list % need == 0 or same) and out.crafts + sets <= maxCrafts then
					-- the server's own order (CraftAllPlan.Build 237303-237315): heaviest, then highest level, then id
					table.sort(list, function(a, b)
						if a.w ~= b.w then
							return a.w > b.w
						end
						if a.l ~= b.l then
							return a.l > b.l
						end
						return a.id < b.id
					end)
					table.insert(out.names, name)
					out.crafts += sets
					out.expected[name] = sets * need
					for i = 1, sets * need do
						table.insert(out.ids, list[i].id)
					end
				else
					out.skipped += sets
				end
			end
		end
		if #out.names == 0 then
			return nil, "no species fits Craft All"
		end
		return out
	end
	-- One Craft All request for the machine (the player at the machine, or anywhere when far=true). Returns crafts made.
	function N.craftAllRun(m, spent, far)
		local p, why = N.craftAllPlan(m, spent)
		if not p then
			return 0, why
		end
		-- the machine's source-tier copies before the request (copies an earlier craft of this trip used are left out:
		-- they leave the lagging replica by themselves)
		local tier = N.machineCfg(m.key).SourceTier
		local before = {}
		for id, pet in pairs(N.owned()) do
			if type(pet) == "table" and pet.Tier == tier and not spent[id] then
				before[id] = tostring(pet.Name)
			end
		end
		local t0 = os.clock()
		N.CraftToken = p.names
		local ok, info = craftRequest({ Machine = m.key, Action = "CraftAll", Names = p.names }, m.key)
		N.CraftToken = nil
		local elapsed = os.clock() - t0
		if not ok then
			local reason = string.lower(tostring(info))
			local nearCheck = string.find(reason, "near", 1, true) or string.find(reason, "far", 1, true)
			if far and nearCheck then
				N.probeResult("craftall_far", "rejected", "gain=0 reason=" .. tostring(info))
				return 0, "far refused"
			end
			local busy = string.find(reason, "busy", 1, true) or string.find(reason, "wait", 1, true) or reason == "no answer"
			C.allOff[m.key] = os.clock() + (if busy then 30 else 600)
			log("CRAFT all", m.key, "refused:", tostring(info), if busy then "(retry in 30 s)" else "(one set per request for 10 min)")
			if not busy and not nearCheck and N.probeState("craftall") == "untested" then
				N.probeResult("craftall", "rejected", "gain=0 reason=" .. tostring(info))
			end
			return 0, tostring(info)
		end
		for _, id in ipairs(p.ids) do
			spent[id] = true
		end
		N.closeRoll()
		-- the replica lags 1-3 s: wait until the planned copies are gone, then compare the storage with the plan
		waitFor(function()
			for _, id in ipairs(p.ids) do
				if N.ownsPet(id) then
					return false
				end
			end
			return true
		end, 4)
		local lost = {}
		local owned = N.owned()
		for id, name in pairs(before) do
			if owned[id] == nil then
				lost[name] = (lost[name] or 0) + 1
			end
		end
		local outside = 0
		for name, n in pairs(lost) do
			outside += math.max(n - (p.expected[name] or 0), 0)
		end
		local crafted = tonumber(type(info) == "table" and info.Crafted) or p.crafts
		local consumed = tonumber(type(info) == "table" and info.Consumed) or #p.ids
		local lucky = 0
		if type(info) == "table" and type(info.Pets) == "table" then
			for _, e in ipairs(info.Pets) do
				if type(e) == "table" and e.Lucky == true then
					lucky += tonumber(e.Count) or 0
				end
			end
		end
		Session.crafts[m.key] = (Session.crafts[m.key] or 0) + crafted
		C.last[m.key] = string.format("Craft All: %d crafts from %d copies (%d species)", crafted, consumed, #p.names)
		local saved = crafted * (C.gap + 0.3) - elapsed
		log(string.format("CRAFT all %s crafts=%d consumed=%d lucky=%d species=%d left to single crafts=%d in %.1fs%s", m.key, crafted, consumed, lucky, #p.names, p.skipped, elapsed, if far then " (from where the player stands)" else ""))
		if outside > 0 then
			logProblem(string.format("Craft All took %d pet%s outside the hub's plan; Craft All is off for this game version", outside, if outside == 1 then "" else "s"))
			N.probeResult("craftall", "rejected", string.format("gain=0 outside_plan=%d", outside))
			return crafted
		end
		if N.probeState("craftall") == "untested" then
			N.probeResult("craftall", "accepted", string.format("gain=%.1fs crafts=%d consumed=%d lucky=%d", saved, crafted, consumed, lucky))
		end
		if far and N.probeState("craftall_far") == "untested" then
			N.probeResult("craftall_far", "accepted", "gain=trip skipped")
		end
		return crafted
	end
	function N.craftMachine(m, stopAt)
		local key = m.key
		-- Owner's live lesson: the replica lags 1-3 s after a craft, so the pets a craft took stay in the data for a moment;
		-- the consumed ids of the whole trip are kept here and never picked again (no refusal, no blacklisted set).
		local spent = C.spent
		local claims = if key == "Shiny" then N.readyPods() else {}
		local sets = N.craftSets(m, spent)
		if key == "Shiny" then
			local room = N.podRoom() + #claims
			while #sets > room do
				table.remove(sets)
			end
		end
		if #sets == 0 and #claims == 0 then
			return 0
		end
		local done = 0
		-- G3: Craft All from where the player stands (once per session to probe it, always once accepted); when it covers
		-- every set of this machine the trip to it is skipped
		if key ~= "Shiny" and N.craftAllUsable(m) and N.probeState("craftall") == "accepted" then
			local farState = N.probeState("craftall_far")
			if farState == "accepted" or (farState == "untested" and not C.farTried) then
				C.farTried = true
				done += N.craftAllRun(m, spent, true)
				if done > 0 and #N.craftSets(m, spent) == 0 then
					return done
				end
			end
		end
		local part = N.goToMachine(m)
		if not part then
			return done
		end
		-- G2: Craft All at the machine first (every species that fits), then one set per request for the rest
		if key ~= "Shiny" and N.craftAllUsable(m) then
			done += N.craftAllRun(m, spent, false)
		end
		for _, craftId in ipairs(claims) do
			local ok, info = craftRequest({ Machine = "Shiny", Action = "Claim", CraftId = craftId }, "Shiny")
			if ok then
				Session.crafts.Claims += 1
				done += 1
				log("CRAFT claimed rainbow pod", craftId)
			else
				log("CRAFT claim refused", craftId, info)
			end
			task.wait(C.gap)
		end
		local retries = 0
		while os.clock() < stopAt and alive() do
			local nextSets = N.craftSets(m, spent)
			if key == "Shiny" and N.podRoom() < 1 then
				break
			end
			local set = nil
			for _, s in ipairs(nextSets) do
				if (C.skip[key .. s.name] or 0) < os.clock() then
					set = s
					break
				end
			end
			if not set then
				break
			end
			N.CraftToken = set.ids
			local args = if key == "Shiny" then { Machine = "Shiny", Action = "Start", PetIds = set.ids } else { Action = "Craft", Machine = key, PetIds = set.ids }
			local ok, info = craftRequest(args, key)
			N.CraftToken = nil
			if ok then
				retries = 0
				done += 1
				Session.crafts[key] = (Session.crafts[key] or 0) + 1
				for _, id in ipairs(set.ids) do
					spent[id] = true
				end
				-- Back to back (owner's live lesson): the next craft goes out right after the answer, no replica polling.
				noteGap(true)
				N.closeRoll()
				C.last[key] = string.format("%s x%d -> %s", set.name, #set.ids, if key == "Shiny" then "rainbow pod (" .. N.longTime(N.craftDuration(#set.ids)) .. ")" else (type(info) == "table" and info.Pet and tostring(info.Pet.Tier or "") or "done"))
				log("CRAFT", key, set.name, "x" .. #set.ids, "ok", "gap", string.format("%.2f", C.gap))
				task.wait(C.gap)
			else
				local reason = string.lower(tostring(info))
				log("CRAFT", key, set.name, "refused:", tostring(info))
				C.last[key] = set.name .. ": " .. tostring(info)
				local busy = string.find(reason, "busy", 1, true) or string.find(reason, "wait", 1, true) or string.find(reason, "pending", 1, true) or string.find(reason, "fast", 1, true) or reason == "no answer"
				-- A busy machine is only a pace answer: retry the same set a bit later (up to 12 times); anything else
				-- three times, then that set waits 2 minutes.
				retries += if busy then 0.25 else 1
				if retries > 3 then
					C.skip[key .. set.name] = os.clock() + 120
					retries = 0
				elseif string.find(reason, "near", 1, true) or string.find(reason, "far", 1, true) then
					N.teleport(part.Position, 0.8)
				elseif busy then
					noteGap(false)
					task.wait(C.gap)
				else
					C.skip[key .. set.name] = os.clock() + 120
				end
			end
		end
		if done > 0 then
			saveSpot(key, N.currentIsland(), N.myPos() or part.Position)
		end
		if C.gapProbe == nil and done >= 3 and N.probeState("machine_gap") == "untested" then
			C.gapProbe = true
			N.probeResult("machine_gap", "accepted", string.format("gain=%.1f crafts/min gap=%.2fs", 60 / math.max(C.gap + 0.5, 0.2), C.gap), tostring(math.floor(C.gap * 100) / 100))
		end
		return done
	end

	-- ===== Keep the machine screens closed while the hub crafts (client-only presentation): MenuController.Open is
	-- ignored for the crafting menus, the 3D stage / rig / cutscene / glow start as no-ops, and HUD hides are put back
	-- after the trip. The roll animation of the last craft runs a few seconds longer, so the block lifts 15 s later. =====
	N.Hide = { on = false, gen = 0, reasons = {} }
	local Hide = N.Hide
	local CraftMenus = { Golden = true, Diamond = true, CraftingRoll = true, RainbowFuse = true, RainbowMachine = true, RainbowCraft = true, GoldenBulk = true, DiamondOld = true }
	local MenuController = N.safeRequire("Controllers.UI.MenuController")
	local MachineController = N.safeRequire("Controllers.Pets.MachineController")
	local HudController = N.safeRequire("Controllers.UI.HudController")
	local function wrap(mod, name, fn)
		if type(mod) ~= "table" or type(mod[name]) ~= "function" or table.isfrozen(mod) then
			return
		end
		local real = mod[name]
		mod[name] = fn(real)
		table.insert(N.Restore, function()
			mod[name] = real
		end)
	end
	wrap(MenuController, "Open", function(real)
		return function(self, name, ...)
			if Hide.on and CraftMenus[name] then
				return nil
			end
			return real(self, name, ...)
		end
	end)
	wrap(HudController, "SetHudHidden", function(real)
		return function(self, hidden, reason, ...)
			if Hide.on and hidden then
				Hide.reasons[reason or "Gameplay"] = true
				return nil
			end
			return real(self, hidden, reason, ...)
		end
	end)
	-- 3933: the game streams its craft/cutscene modules on demand (LazyContentConfig.PetPresentationCode:
	-- GoldenMachineStage, DiamondCraftCutscene, ...), so they are missing at boot and arrive right before a craft plays.
	-- Each wrapper attaches the moment the module exists (now, or on ChildAdded of its folder); never a 12 s wait,
	-- never a "REQUIRE failed" line for a module the game simply has not sent yet.
	local function hideWrap(mod, fnames)
		for _, fname in ipairs(fnames) do
			wrap(mod, fname, function(real)
				return function(...)
					if Hide.on then
						return nil
					end
					return real(...)
				end
			end)
		end
	end
	local function lazyWrap(path, fnames)
		local parts = {}
		for part in path:gmatch("[^%.]+") do
			table.insert(parts, part)
		end
		local name = table.remove(parts)
		local folder = ReplicatedStorage
		for _, part in ipairs(parts) do
			folder = folder and folder:FindFirstChild(part)
		end
		if not folder then
			return
		end
		local attached = false
		local function attach(inst)
			if attached or not inst or inst.Name ~= name or not inst:IsA("ModuleScript") then
				return
			end
			local ok, mod = pcall(require, inst)
			if ok and type(mod) == "table" then
				attached = true
				hideWrap(mod, fnames)
				log("HIDE wrapper attached", name)
			end
		end
		attach(folder:FindFirstChild(name))
		if not attached then
			local conn
			conn = folder.ChildAdded:Connect(function(inst)
				task.defer(attach, inst)
			end)
			table.insert(N.Restore, function()
				if conn then
					conn:Disconnect()
				end
			end)
		end
	end
	for _, spec in ipairs({
		{ "Modules.Client.Pets.GoldenMachineStage", { "Begin", "Arm", "Resolve" } },
		{ "Modules.Client.Pets.DiamondMachineRig", { "Begin", "Arm", "Resolve" } },
		{ "Modules.Client.Pets.DiamondCraftCutscene", { "Begin" } },
		{ "Modules.Client.Common.ScreenGlow", { "Play" } },
	}) do
		lazyWrap(spec[1], spec[2])
	end
	local function closeMenus()
		if type(MenuController) == "table" and type(MenuController.Close) == "function" then
			for name in pairs(CraftMenus) do
				pcall(MenuController.Close, MenuController, name)
			end
		end
	end
	local function showHud()
		if type(HudController) == "table" and type(HudController.SetHudHidden) == "function" then
			for reason in pairs(Hide.reasons) do
				pcall(HudController.SetHudHidden, HudController, false, reason)
			end
		end
		Hide.reasons = {}
	end
	-- The "Crafted! ... Continue" roll screen (CraftingRoll): closed the game's own way, MachineController:ContinueRoll()
	-- (dump 194200, the Continue button's finishRoll) and MenuController:Close("CraftingRoll"); if the screen is still up,
	-- its Continue button is pressed. Runs after every craft and 0 / 1.5 / 4 s after the trip, so it never pops up later
	-- at the egg.
	function N.closeRoll()
		if type(MachineController) == "table" and type(MachineController.ContinueRoll) == "function" then
			pcall(MachineController.ContinueRoll, MachineController)
		end
		if type(MenuController) == "table" and type(MenuController.Close) == "function" then
			pcall(MenuController.Close, MenuController, "CraftingRoll")
		end
		pcall(function()
			local gui = LocalPlayer:FindFirstChild("PlayerGui")
			local roll = gui and gui:FindFirstChild("CraftingRoll")
			if roll and roll.Enabled and type(firesignal) == "function" then
				local button = roll.Menu.Continue.Button
				firesignal(button.Activated)
				log("CRAFT pressed the roll screen's Continue")
			end
		end)
	end
	function N.startHiding()
		Hide.gen += 1
		Hide.on = true
		closeMenus()
	end
	function N.stopHiding()
		Hide.gen += 1
		local gen = Hide.gen
		closeMenus()
		showHud()
		N.closeRoll()
		task.delay(1.5, N.closeRoll)
		task.delay(4, N.closeRoll)
		task.delay(15, function()
			if gen ~= Hide.gen then
				return
			end
			Hide.on = false
			N.closeRoll()
			closeMenus()
			showHud()
		end)
	end
	-- One trip for every machine that is due (or the one machine of a Craft now button), in the order Golden -> Diamond ->
	-- Rainbow, so the Goldens made first can go into Diamonds on the same trip. Hatching pauses (the answer in flight lands
	-- first), the pet list is locked against the chores, then the arbiter takes the character straight back to the egg.
	function N.craftTrip(reason, only)
		if N.Trip.active then
			log("CRAFT trip skipped: the " .. N.Trip.name .. " trip is still running")
			return 0
		end
		N.tripBegin("craft")
		waitFor(function()
			return not N.Hatch.inFlight and not N.PetLock.chore
		end, 5)
		N.PetLock.craft = true
		C.spent = {}
		local n0, limit = N.storage()
		local fullTrip = N.storageFull()
		C.starts[reason or ""] = (C.starts[reason or ""] or 0) + 1
		log("CRAFT trip start", reason or "", "storage", n0 .. "/" .. limit)
		N.startHiding()
		local total = 0
		local stopAt = os.clock() + 240
		for _, m in ipairs(N.Machines) do
			-- A machine joins the trip when it was asked by hand, when the storage was full at the start (then every machine
			-- that is on crafts everything it has), or when it is due by its own option (sets made earlier on this trip count).
			if (only and only == m) or (not only and N.machineOn(m) and not N.machineMissing(m) and N.craftableCount(m) > 0 and (fullTrip or N.craftDue(m))) then
				N.loopStatus("Main", "crafting at the " .. m.label .. " machine")
				local ok, n = pcall(N.craftMachine, m, stopAt)
				if ok then
					total += n
				else
					log("ERROR", "craft " .. m.key, tostring(n))
				end
			end
		end
		N.stopHiding()
		C.lastTripAt = os.clock()
		if total == 0 then
			C.tripFailAt = os.clock()
		end
		local n1 = N.storage()
		log("CRAFT trip done", "crafts", total, "storage", n1 .. "/" .. limit, "freed", n0 - n1, string.format("%.1fs", os.clock() - N.Trip.since))
		table.insert(C.trips, { from = N.Trip.since, to = os.clock() })
		if #C.trips > 50 then
			table.remove(C.trips, 1)
		end
		N.PetLock.craft = false
		N.tripEnd()
		N.Hatch.nextAt = 0
		return total
	end
	-- ===== Delete junk: PetService.RE.PetActionRequested {Action="Delete", PetIds (max 400), Batch} (PetDeleteRequest,
	-- dump 317967-318007; ~900 ids in one call would cross the 32 KB string rule and kick, so 400 is the hard cap). Only
	-- the rarities and tiers picked in the filters, lowest power first, never equipped / level team / locked / frozen /
	-- protected pets, never Secret, Godly or Exclusive pets, Diamond/Rainbow only when picked (2026-10-17), never a variant the Pet Index has not counted
	-- and never the Index Hunter's egg pets while it hunts (N.indexKeeps). Builder M (owner 2026-10-12 "Auto Delete Junk
	-- does not work"): it used to run only when the storage was full AND no machine had a set (live log 2026-10-12 05:16:
	-- storage 380/380, Auto Golden/Diamond on, a set always ready, `deleted 0`); now it deletes what matches the filters
	-- every 5 s while its toggle is on. =====
	N.Del = { batch = 0, last = "", at = -1e9 }
	local NeverRarity = { Godly = true, Leaderboard = true, Exclusive = true, ["Secret I"] = true, ["Secret II"] = true, ["Secret III"] = true, ["Secret X"] = true }
	local VoidKept = {}
	function N.deleteCandidates()
		local rarities, tiers = {}, {}
		for _, r in ipairs(picked(Options.DeleteRarities)) do
			rarities[r] = true
		end
		for _, t in ipairs(picked(Options.DeleteTiers)) do
			tiers[if t == "Rainbow" then "Shiny" else t] = true
		end
		local keep = N.keepSet()
		local protect = N.protectedNames()
		local powers = N.powers()
		-- R13: without Auto Equip the player's own team stays as he set it, so the pets that would make the best power team
		-- are never deleted either (he may still put them on); with Auto Equip the delete waits for that team (p11)
		if not on("AutoEquip") then
			for id in pairs(N.bestTeam()) do
				keep[id] = true
			end
		end
		local out = {}
		for id, pet in pairs(N.owned()) do
			-- R13 (OWNER_RULES 20/23, CleanUpRules.hasValue bc 183637-183640): never a pet with a mutation, an enchant, a
			-- nickname, a signature or a serial, never a Secret (N.petValued)
			if type(pet) == "table" and not keep[id] and pet.Locked ~= true and pet.Frozen == nil and not protect[pet.Name] and N.petValued(pet) == nil then
				local rarity = N.rarityOf(pet)
				local tier = pet.Tier or "Normal"
				local secret = string.match(tostring(rarity), "^Secret") ~= nil or (N.indexIsSecret ~= nil and N.indexIsSecret(pet.Name))
				local indexKeep = N.indexKeeps ~= nil and N.indexKeeps(pet.Name, tier)
				-- owner 2026-10-12: Mythical pets of the Void egg are the valuable ones: never deleted, left for the machines
				if rarities[rarity] and (rarity == "Mythical" or rarity == "Mythic") and N.petEgg and N.petEgg(pet.Name) == "Void" then
					indexKeep = true
					if not VoidKept[pet.Name] then
						VoidKept[pet.Name] = true
						log(string.format("DELETE skipped %s: Mythic from Void kept for craft", tostring(pet.Name)))
					end
				end
				if rarities[rarity] and tiers[tier] and not NeverRarity[rarity] and not secret and not indexKeep then
					table.insert(out, { id = id, power = tonumber(powers[id]) or 0, name = tostring(pet.Name), rarity = tostring(rarity), tier = tier })
				end
			end
		end
		table.sort(out, function(a, b)
			if a.power == b.power then
				return a.id < b.id
			end
			return a.power < b.power
		end)
		return out
	end
	-- Why a full storage has few pets to delete: one line per 5 minutes (the alt 2026-10-12 freed 1-2 pets every 5 s at
	-- 193/195 and the hatch ran x1).
	function N.deleteWhy()
		local rarities, tiers = {}, {}
		for _, r in ipairs(picked(Options.DeleteRarities)) do
			rarities[r] = true
		end
		for _, t in ipairs(picked(Options.DeleteTiers)) do
			tiers[if t == "Rainbow" then "Shiny" else t] = true
		end
		local keep, protect = N.keepSet(), N.protectedNames()
		local c = { kept = 0, locked = 0, protected = 0, rarity = 0, tier = 0, index = 0, void = 0, ok = 0 }
		for _, pet in pairs(N.owned()) do
			if type(pet) == "table" then
				local rarity, tier = N.rarityOf(pet), pet.Tier or "Normal"
				if pet.Locked == true or pet.Frozen ~= nil then
					c.locked += 1
				elseif protect[pet.Name] then
					c.protected += 1
				elseif not rarities[rarity] or NeverRarity[rarity] or string.match(tostring(rarity), "^Secret") then
					c.rarity += 1
				elseif not tiers[tier] then
					c.tier += 1
				else
					c.ok += 1
				end
			end
		end
		for id in pairs(keep) do
			if N.owned()[id] then
				c.kept += 1
			end
		end
		local n, limit = N.storage()
		return string.format("storage %d/%d, %d deletable; kept: team %d, locked %d, protected %d, rarity not picked %d, tier not picked %d (index / Void Mythical keeps are inside the deletable count)", n, limit, #N.deleteCandidates(), c.kept, c.locked, c.protected, c.rarity, c.tier)
	end
	function N.deleteJunk(want)
		local list = N.deleteCandidates()
		if #list == 0 then
			N.Del.last = "nothing matches the filters"
			return 0
		end
		local ids, groups, order = {}, {}, {}
		for i = 1, math.min(want, #list, 400) do
			local c = list[i]
			table.insert(ids, c.id)
			local key = c.name .. " (" .. c.rarity .. "/" .. c.tier .. ")"
			if not groups[key] then
				groups[key] = 0
				table.insert(order, key)
			end
			groups[key] += 1
		end
		local n0 = N.storage()
		N.Del.batch += 1
		N.DeleteToken = ids
		local ok = fire("PetService.RE.PetActionRequested", { Action = "Delete", PetIds = ids, Batch = N.Del.batch })
		N.DeleteToken = nil
		if not ok then
			return 0
		end
		waitFor(function()
			return N.storage() <= n0 - #ids
		end, 3)
		local freed = n0 - N.storage()
		Session.deleted += math.max(freed, 0)
		N.Del.at = os.clock()
		N.Del.last = string.format("deleted %d of %d junk pets", freed, #ids)
		for _, key in ipairs(order) do
			log(string.format("DELETE %s x%d", key, groups[key]))
		end
		log(string.format("DELETE batch %d: %d sent, %d freed, storage %d, deleted this session %d", N.Del.batch, #ids, freed, N.storage(), Session.deleted))
		return freed
	end

	-- ===== strategy.md item 9 (Offline mode): the game's own server delete-on-hatch list (EggService.RE.AutoDeleteRequested,
	-- EggController 3687 L189489-189492). While AutoOfflineDelete is on, the server auto-deletes, for the egg the hub
	-- hatches, the SAME junk species the Auto Delete Junk filters pick, so a long AFK / offline hatch session (an Auto
	-- session keeps hatching up to 10,000 eggs, OfflineHatchConfig) never stalls at the storage cap. Species keys only
	-- (AutoDeleteKey 3687 L400330: the name for Normal), from the egg's own pool via PetCfg rarity, never
	-- Secret/Godly/Exclusive/protected/index-kept and never a Mythical Void pet (kept for the machines). Off -> clear it. =====
	N.Offline = { egg = nil, keyText = nil }
	function N.offlineJunkKeys(egg)
		local cfg = N.eggCfg(egg)
		if type(cfg) ~= "table" or type(cfg.Pets) ~= "table" then
			return {}
		end
		local rarities = {}
		for _, r in ipairs(picked(Options.DeleteRarities)) do
			rarities[r] = true
		end
		local protect = N.protectedNames()
		local keys = {}
		for name in pairs(cfg.Pets) do
			if type(name) == "string" and not string.find(name, "[\128-\255]") then
				local pc = N.tableOr(N.G.PetCfg)[name]
				local rarity = (type(pc) == "table" and pc.Rarity) or "Common"
				local secret = string.match(tostring(rarity), "^Secret") ~= nil or (N.indexIsSecret and N.indexIsSecret(name))
				local mythicVoid = rarity == "Mythical" and N.petEgg and N.petEgg(name) == "Void"
				if rarities[rarity] and not NeverRarity[rarity] and not secret and not protect[name] and not mythicVoid and not (N.indexKeeps and N.indexKeeps(name, "Normal")) then
					table.insert(keys, name)
				end
			end
		end
		table.sort(keys)
		return keys
	end
	function N.offlineDeleteStep()
		if not N.does("AutoOfflineDelete") then
			if N.Offline.keyText ~= nil and N.Offline.keyText ~= "" then
				fire("EggService.RE.AutoDeleteRequested", { Egg = N.Offline.egg or "Void", Entries = {} })
				log("OFFLINE prep: server auto-delete list cleared (toggle off)")
			end
			N.Offline.egg, N.Offline.keyText = nil, nil
			return
		end
		-- the egg the hatch loop already settled on (never call N.pickEgg here: it has side effects and logs)
		local egg = N.Hatch.target or N.tableOr(N.Plan).egg or (Options.HatchEgg and Options.HatchEgg.Value)
		if type(egg) ~= "string" or egg == "Best (Smart)" or not N.validEgg(egg) then
			return
		end
		local keys = N.offlineJunkKeys(egg)
		local text = egg .. "|" .. table.concat(keys, ",")
		if text == N.Offline.keyText then
			return
		end
		N.Offline.egg, N.Offline.keyText = egg, text
		fire("EggService.RE.AutoDeleteRequested", { Egg = egg, Entries = keys })
		log(string.format("OFFLINE prep: %s server auto-delete %d junk species (10,000-egg offline budget)", egg, #keys))
	end
end
