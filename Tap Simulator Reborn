		if due("board", 900) then
			local pending = invoke("LeaderboardService.RF.GetPendingRewards")
			if type(pending) == "table" then
				-- the game's own claimPendingRewards (bc 27439-27484): pairs over the list, Success = claimed, Reason
				-- "StorageFull" + SlotsNeeded = free pet slots first
				for _, v in pairs(pending) do
					if type(v) == "table" and v.LeaderboardId ~= nil then
						local result = invoke("LeaderboardService.RF.ClaimReward", v.LeaderboardId)
						if ok(result) then
							note("leaderboard reward ok " .. tostring(v.LeaderboardId))
						else
							failed("leaderboard reward " .. tostring(v.LeaderboardId), result, if type(result) == "table" and result.Reason == "StorageFull" then string.format(" (needs %s free pet slots)", tostring(result.SlotsNeeded or 1)) else "")
						end
