	-- One post to every webhook that picked one of the keys. Returns how many queues took it.
	function N.post(keys, embed)
		if not hookOn() or type(embed) ~= "table" then
			return 0
		end
		if type(keys) == "string" then
			keys = { keys }
		end
		local now = os.clock()
		local gap = 60
		for _, key in ipairs(keys) do
			gap = math.max(gap, MinGap[key] or 0)
		end
		local sig = table.concat(keys, ",") .. "|" .. tostring(embed.title) .. "|" .. tostring(embed.description)
		if (Hook.recent[sig] or -1e9) > now - 60 then
			return 0
		end
		if gap > 60 and now - (Hook.lastKeyAt[keys[1]] or -1e9) < gap then
			return 0
		end
		Hook.recent[sig] = now
		Hook.lastKeyAt[keys[1]] = now
		decorate(embed)
		local n = 0
		for _, hook in ipairs(N.webhooks()) do
			if wants(hook, keys) then
				local q = Hook.queues[hook.url]
				if not q then
					q = {}
					Hook.queues[hook.url] = q
				end
				if #q < 30 then
					table.insert(q, embed)
					n += 1
				else
					Hook.dropped += 1
				end
			end
		end
		return n
	end
