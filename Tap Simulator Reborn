-- Runs a trip function like pcall; a trip it began is always ended, the pet lock and the machine screens are released.
function N.guardTrip(label, fn, ...)
	local gen = N.Trip.gen
	local res = table.pack(pcall(fn, ...))
	if not res[1] then
		log("ERROR", "trip " .. tostring(label), tostring(res[2]))
		logProblem("Trip " .. tostring(label) .. " stopped by an error: " .. string.sub(tostring(res[2]), 1, 120))
	end
	if N.Trip.active and N.Trip.gen ~= gen then
		log("TRIP " .. tostring(N.Trip.name) .. " ended by the guard" .. (if res[1] then "" else " after the error"))
		N.tripEnd()
	end
	if not res[1] then
		-- a craft trip that died between its lock and its release
		if N.PetLock then
			N.PetLock.craft = false
		end
		if N.Hide and N.Hide.on and N.stopHiding then
			pcall(N.stopHiding)
		end
	end
	return table.unpack(res, 1, res.n)
end
-- The watchdog (monitor loop, every 5 s): a trip 30 s over its cap is ended and reported once.
function N.tripWatchdog()
	local T = N.Trip
	if T.active and os.clock() - T.since > (T.cap or 120) + 30 then
		local name = tostring(T.name)
		logProblem(string.format("trip %s over cap (%ds, cap %ds), ended", name, math.floor(os.clock() - T.since), T.cap or 120))
		-- R5-4: the whole trip state goes back (pet lock, hidden menus, a teleport left half done, the hatch pacing, the
		-- status); the monitor restarts the Main loop when it does not come back by itself (p11)
		N.tripEnd()
		T.watchdogAt = os.clock()
		if N.PetLock then
			N.PetLock.craft = false
		end
		if N.Hide and N.Hide.on and N.stopHiding then
			pcall(N.stopHiding)
		end
		if N.moveReset then
			N.moveReset("the " .. name .. " trip was ended by the watchdog")
		end
		N.Hatch.inFlight = false
		N.Hatch.nextAt = 0
		N.loopStatus("Main", "back to the egg after the " .. name .. " trip")
		return true
	end
	return false
