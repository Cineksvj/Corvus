					local vp = Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
					local half = math.max(pill.AbsoluteSize.X, 60) / 2
					pill.Position = UDim2.new(0, math.clamp(startPosX + dx, half + 8, vp.X - half - 8), 0, pill.Position.Y.Offset)
