		if N.does("AutoTap") then
			N.loopStatus("Main", "tapping")
		elseif anyAutoOn() then
			N.loopStatus("Main", "running the remote chores")
		else
			N.loopStatus("Main", "idle")
		end
		task.wait(0.25)
	end)
	-- ===== Hatch loop: one request in flight, paced by the server's answers (never moves the character). =====
	-- Builder M (alt 2026-10-12 07:25, "no HATCH line for 3 minutes"): an egg is picked and the storage has room but no
	-- hatch answer came for 30 s = `HATCH idle: <why> | <state>` every 30 s (trip, Craft now, pet locks, request open, the
	-- way to the egg).
	local HatchIdle = { since = nil, at = -1e9 }
	local function hatchIdleLog()
		local H = N.Hatch
		local now = os.clock()
		HatchIdle.since = HatchIdle.since or now
		if not H.target or N.storageFull() or now - math.max(H.lastOkAt or -1e9, HatchIdle.since) < 30 or now - HatchIdle.at < 30 then
			return
		end
		HatchIdle.at = now
		local n, limit = N.storage()
		local why = if N.Manual.running then "Craft now runs" elseif N.Trip.active then "trip " .. tostring(N.Trip.name) elseif H.inFlight then "a request is open" elseif not N.atEgg(H.target) then "not at the egg" elseif N.hatchCount(H.target) < 1 then "no coins or room for one egg" else tostring(H.idleWhy or "waiting for the pace")
		log(string.format("HATCH idle: %s | egg %s, at egg %s, in flight %s, next in %.1fs, last answer %ds ago, pet lock craft %s chore %s, storage %d/%d", why, tostring(H.target), tostring(N.atEgg(H.target)), tostring(H.inFlight), (H.nextAt or 0) - now, math.floor(now - (H.lastOkAt or -1e9) > 1e8 and -1 or now - (H.lastOkAt or 0)), tostring(N.PetLock.craft), tostring(N.PetLock.chore), n, limit))
	end
	N.hatchIdleLog = hatchIdleLog
	loop("Hatch", function()
		if not N.hatchWanted() then
			HatchIdle.since = nil
			N.loopStatus("Hatch", "off")
			task.wait(0.3)
			return
		end
		-- the egg target right away (live: "no egg to hatch" for the first 2 s until the planner tick)
		if not N.Hatch.target then
			N.Hatch.target, N.Hatch.targetWhy = N.pickEgg()
		end
		hatchIdleLog()
		if N.Manual.running then
			task.wait(0.3)
			return
		end
		if N.Trip.active then
			N.loopStatus("Hatch", N.hatchStatusText(false))
			task.wait(0.2)
			return
		end
		N.hatchStep(N.Hatch.target)
		N.loopStatus("Hatch", N.hatchStatusText(false))
		task.wait(0.05)
	end)
	-- R5-4 (d): the hatch watchdog (monitor, every 5 s). Auto Hatch on, no trip, room in the storage, coins for a hatch and
	-- no hatch answer for 90 s = `HATCH stalled: <state>`; the hatch state machine starts over (request, pacing, TooFar,
	-- stand distance, a stale teleport flag, the 10 s retry of the way to the egg) and a Main loop without a turn for 30 s
	-- is restarted (only the Main loop moves the character to the egg).
	local HatchWatch = { since = nil, at = -1e9 }
	function N.hatchWatchdog()
		local H = N.Hatch
		local now = os.clock()
		if not N.hatchWanted() or N.Manual.running then
			HatchWatch.since = nil
			return false
