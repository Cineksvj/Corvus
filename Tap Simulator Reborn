	-- Main "Up next": what the enabled toggles (or the planner) do next, in plain words.
	function N.upNext()
		local out = {}
		if N.does("AutoTap") then
			table.insert(out, string.format("Tap every %.3g s%s", N.Tap.interval, if N.autoClickerOn() then " + the Auto Clicker" else (if N.hasAutoClicker() then "" else " (Auto Clicker: 20 gems in the skill tree)")))
		end
		if N.hatchWanted() then
			table.insert(out, "Hatch: " .. N.hatchStatusText(true))
		end
		if on("SecretHunt") and N.Secret then
			table.insert(out, "Secret Hunt: " .. N.Secret.last)
		end
		-- G1 (3937): a hatched Secret the hub could not release yet
		local secretWaits = N.secretPendingText and N.secretPendingText()
		if secretWaits then
			table.insert(out, "Secret: " .. secretWaits)
		end
		if on("IndexHunter") and not on("SecretHunt") then
			local hunt = N.Index and N.Index.target
			table.insert(out, if hunt then string.format("Index Hunter: %s egg, %s, %d variant%s left (~%s)", hunt.egg, tostring(N.Index.pet or "-"), hunt.new, if hunt.new == 1 then "" else "s", N.longTime(hunt.eta)) else "Index Hunter: nothing left to find right now")
		end
		if N.does("AutoRebirth") then
			table.insert(out, "Rebirth " .. N.rebirthPlanText(true))
		end
		-- R3-3: a big gem buy, 10 s before it happens
		local gemLine = N.gemPlanText()
		if gemLine then
			table.insert(out, (string.gsub(gemLine, "^%l", string.upper)))
		end
		for _, m in ipairs(N.Machines) do
			if N.machineOn(m) then
				local when = if on(m.toggle) then optionText(m.when, "Storage full") else "Storage full"
				local state = if N.craftDue(m) then "crafting on the next trip" elseif when == "Storage full" and N.storageHeld() then "crafts every 10 min (the game's delete list keeps the storage from filling)" elseif when == "Storage full" then "crafts when the storage is full" else "crafts every ready set"
				if m.key == "Shiny" then
					-- REV-17: the Rainbow machine has pods (ready to claim) and sets (to start), said apart
					local ready = #N.readyPods()
					local sets = math.min(#N.craftSets(m), math.max(N.podRoom(), 0))
					if ready > 0 or sets > 0 then
						local parts = {}
						if ready > 0 then
							table.insert(parts, string.format("%d pod%s to claim", ready, if ready == 1 then "" else "s"))
						end
						if sets > 0 then
							table.insert(parts, string.format("%d set%s to start", sets, if sets == 1 then "" else "s"))
						end
						table.insert(out, string.format("%s machine: %s (%s)", m.label, table.concat(parts, ", "), state))
					end
				else
					local n = N.craftableCount(m)
					if n > 0 then
						-- R2-4: "(storage full)" read as if the storage were full at 297/345
						table.insert(out, string.format("%s machine: %d set%s ready (%s)", m.label, n, if n == 1 then "" else "s", state))
					end
				end
			end
		end
		if on("AutoEquip") then
			table.insert(out, if N.levelFarming() then "Equip the level team (" .. formatNumber(optionNumber("XPMinPower", 600000)) .. "+ power, lowest level first)" else "Keep the best power team equipped (built pet by pet)")
		elseif N.planner() then
			-- R13: the planner alone never changes the team; it only says what Auto Equip would add
			local better = tonumber(N.Equip.better) or 0
			table.insert(out, "Fill empty pet slots only (your own team is kept" .. (if better > 0 then string.format("; Auto Equip would add %s power", formatNumber(better)) else "") .. ")")
		end
		-- R13: the pet the game's Auto Enchant holds, until it is back
		if N.enchantHeldPet and N.enchantHeldPet() then
			table.insert(out, if N.enchantHeldDone() then (if N.does("AutoClaimMachines") then "Enchanter: taking your pet back (" .. tostring(N.EnchantHold.last ~= "" and N.EnchantHold.last or "free claim") .. ")" else "Enchanter: your pet waits there (Auto Claim Finished Crafts takes it back)") else "Enchanter: the game's Auto Enchant is rolling your pet")
		end
		if (N.does("AutoSkillTree") or N.does("AutoGemUpgrades")) and N.Spend.pick then
			table.insert(out, string.format("Buy %s for %s gems", N.Spend.pick.name, formatNumber(N.Spend.pick.cost)))
		end
		if N.xtraUpNext then
			for _, line in ipairs(N.xtraUpNext()) do
				table.insert(out, line)
			end
		end
		if Sched.nextText ~= "" and not (gemLine and string.find(Sched.nextText, "buy", 1, true)) then
			local text = Sched.nextText
			table.insert(out, if string.sub(text, 1, 5) == "trip " then "Next " .. text else (string.gsub(text, "^%l", string.upper)))
		end
		-- competitors' "TP to the best island": taps carry the multiplier of the island the player stands on
		-- (TapFormula.GetLocationMultiplier 3097 L387736-387745); the egg island is where the hub stands.
		local best, bestName = 1, nil
		for name, info in pairs(N.tableOr(N.G.Islands.Islands)) do
			if type(info) == "table" and N.islandUnlocked(name) and (tonumber(info.Multiplier) or 1) > best then
				best, bestName = tonumber(info.Multiplier) or 1, name
			end
		end
		local egg = N.Hatch.target
		if bestName and egg and N.hatchWanted() and N.eggIsland(egg) ~= bestName then
			table.insert(out, string.format("Taps here x%s, %s has x%s (hatching keeps you at the %s egg)", tostring(tonumber(N.tableOr(N.islandInfo(N.eggIsland(egg))).Multiplier) or 1), bestName, tostring(best), egg))
		end
		return out
	end
