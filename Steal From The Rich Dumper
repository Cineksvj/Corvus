-- Tree helpers
local SKIP = {}
for _, c in ipairs({
	"Weld", "WeldConstraint", "Motor6D", "ManualWeld", "Attachment", "SpecialMesh", "SurfaceAppearance",
	"Decal", "Texture", "ParticleEmitter", "Beam", "Trail", "PointLight", "SpotLight", "SurfaceLight",
	"UICorner", "UIStroke", "UIGradient", "UIPadding", "UIListLayout", "UIGridLayout", "UIAspectRatioConstraint",
	"UIScale", "UISizeConstraint", "UITextSizeConstraint", "UIPageLayout", "UITableLayout", "UIFlexItem",
	"TouchTransmitter", "Humanoid", "HumanoidDescription", "Shirt", "Pants", "BodyColors", "Animator",
	"AlignPosition", "AlignOrientation", "NoCollisionConstraint", "Smoke", "Fire", "Sparkles", "Highlight",
}) do
	SKIP[c] = true
end

local function attrs(v)
	local ok, a = pcall(v.GetAttributes, v)
	if not ok or next(a) == nil then
		return ""
	end
	return " @" .. fmt(a)
end

local function extra(v, withPos)
	local s = ""
	pcall(function()
		if v:IsA("ValueBase") then
			s ..= " = " .. fmt(v.Value)
		elseif v:IsA("ProximityPrompt") then
			s ..= string.format(" action=%q object=%q hold=%.2f dist=%.0f enabled=%s", v.ActionText, v.ObjectText, v.HoldDuration, v.MaxActivationDistance, tostring(v.Enabled))
		elseif v:IsA("TextLabel") or v:IsA("TextButton") or v:IsA("TextBox") then
			if #v.Text > 0 and #v.Text < 80 then
				s ..= " text=" .. fmt(v.Text)
			end
		elseif v:IsA("GuiObject") and not v.Visible then
			s ..= " (hidden)"
		end
		if withPos then
			if v:IsA("BasePart") then
				s ..= " pos=" .. fmt(v.Position)
			elseif v:IsA("Model") then
				s ..= " pos=" .. fmt(v:GetPivot())
			end
		end
	end)
	return s .. attrs(v)
end

local function dumpTree(root, maxDepth, maxLines, withPos)
	w(fullName(root) .. " [" .. root.ClassName .. "]" .. attrs(root))
	local lines = 0
	local function rec(inst, remaining, indent)
		local groups, order = {}, {}
		for _, c in ipairs(inst:GetChildren()) do
			if not SKIP[c.ClassName] then
				local key = c.Name .. "\0" .. c.ClassName
				local g = groups[key]
				if g then
					g[#g + 1] = c
				else
					groups[key] = { c }
					order[#order + 1] = key
				end
			end
		end
		for i, key in ipairs(order) do
			if lines >= maxLines then
				w(indent .. "... line limit reached")
				return
			end
			if i > 100 then
				w(indent .. "... +" .. (#order - 100) .. " more child names")
				return
			end
			local g = groups[key]
			local c = g[1]
			local line = indent .. c.Name .. " [" .. c.ClassName .. "]"
			if #g > 1 then
				line ..= " x" .. #g
			end
			line ..= extra(c, withPos)
			local isChar = Players:GetPlayerFromCharacter(c) ~= nil
			if isChar then
				line ..= " (player character)"
			end
			w(line)
			lines += 1
			local nextRemaining = remaining - 1
			if c:IsA("Model") then
				nextRemaining = math.min(nextRemaining, 3)
			end
			if nextRemaining > 0 and not isChar then
				rec(c, nextRemaining, indent .. "  ")
			end
		end
	end
	rec(root, maxDepth, "  ")
end

