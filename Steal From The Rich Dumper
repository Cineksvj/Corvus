local DUMP_FILE = "Corvus_SFTR_dump.txt"
local SPY_FILE = "Corvus_SFTR_spy.txt"
local SPY_SECONDS = 600
local MAX_TOTAL = 24 * 1024 * 1024
local MAX_SCRIPT = 250 * 1024

local write = writefile
local decompileFn = decompile or (syn and syn.decompile) or nil
local checkcallerFn = checkcaller or function()
	return false
end
local wrapC = newcclosure or function(f)
	return f
end

local function notify(text, duration)
	print("[Corvus Dumper] " .. text)
	pcall(function()
		StarterGui:SetCore("SendNotification", { Title = "Corvus Dumper", Text = text, Duration = duration or 8 })
	end)
end

if not write then
	notify("Your executor has no writefile, cannot save the dump", 15)
	G.CorvusDumperRunning = nil
	return
end

local buf, total = {}, 0
local function w(line)
	if total > MAX_TOTAL then
		return
	end
	line = tostring(line)
	total += #line + 1
	buf[#buf + 1] = line
end
local function section(name)
	w("")
	w(string.rep("=", 80))
	w("== " .. name)
	w(string.rep("=", 80))
end
local function flushDump()
	pcall(write, DUMP_FILE, table.concat(buf, "\n"))
end

local FMT_MAX = 40
local function fmt(v, depth, seen)
	depth = depth or 0
	local t = typeof(v)
	if t == "string" then
		if #v > 300 then
			v = v:sub(1, 300) .. "..."
		end
		return string.format("%q", v)
	elseif t == "number" or t == "boolean" or t == "nil" then
		return tostring(v)
	elseif t == "Instance" then
		local ok, full = pcall(function()
			return v:GetFullName()
		end)
		return "<" .. v.ClassName .. "> " .. (ok and full or v.Name)
	elseif t == "Vector3" then
		return string.format("Vector3(%.1f, %.1f, %.1f)", v.X, v.Y, v.Z)
	elseif t == "CFrame" then
		local p = v.Position
		return string.format("CFrame(%.1f, %.1f, %.1f)", p.X, p.Y, p.Z)
	elseif t == "EnumItem" then
		return tostring(v)
	elseif t == "table" then
		seen = seen or {}
		if seen[v] then
			return "{<cycle>}"
		end
		if depth >= 5 then
			return "{...}"
		end
		seen[v] = true
		local parts, n = {}, 0
		for k, val in pairs(v) do
			n += 1
			if n > FMT_MAX then
				parts[#parts + 1] = "..."
				break
			end
			parts[#parts + 1] = "[" .. fmt(k, depth + 1, seen) .. "]=" .. fmt(val, depth + 1, seen)
		end
		seen[v] = nil
		return "{" .. table.concat(parts, ", ") .. "}"
	end
	return t .. "(" .. tostring(v) .. ")"
end

local function fullName(inst)
	local ok, full = pcall(function()
		return inst:GetFullName()
	end)
	return ok and full or tostring(inst)
end

local function withTimeout(fn, secs)
	local done, ok, res = false, false, nil
	task.spawn(function()
		ok, res = pcall(fn)
		done = true
	end)
	local waited = 0
	while not done and waited < secs do
		waited += task.wait(0.05)
	end
	if not done then
		return false, "timed out"
	end
	return ok, res
end

---------------------------------------------------------------------------
-- Remote spy (starts first so you can play while the dump is built)
---------------------------------------------------------------------------
local t0 = os.clock()
local spyLog, spyCount, spySeen = {}, {}, {}
local spyActive = true

local function record(dir, remote, method, args, caller)
	if not spyActive then
		return
	end
	local path = fullName(remote)
	local parts = {}
	for i = 1, args.n do
		parts[i] = fmt(args[i])
	end
	local argStr = table.concat(parts, ", ")
	local sig = dir .. path .. argStr
	if spySeen[sig] then
		return
	end
	local key = dir .. path
	spyCount[key] = (spyCount[key] or 0) + 1
	if spyCount[key] > (dir == "OUT" and 40 or 6) then
		return
	end
	spySeen[sig] = true
	local line = string.format("[%6.1fs] %s %s:%s(%s)", os.clock() - t0, dir, path, method, argStr)
	if caller then
		line ..= "   <- " .. caller
	end
	spyLog[#spyLog + 1] = line
end

local spyHooked = false
if hookmetamethod and getnamecallmethod then
	local ok = pcall(function()
		local old
		old = hookmetamethod(game, "__namecall", wrapC(function(self, ...)
			local method = getnamecallmethod()
			if (method == "FireServer" or method == "InvokeServer") and not checkcallerFn() then
				local caller
				if getcallingscript then
					local okc, cs = pcall(getcallingscript)
					if okc and cs then
						caller = fullName(cs)
					end
				end
				task.spawn(record, "OUT", self, method, table.pack(...), caller)
			end
			return old(self, ...)
		end))
	end)
	spyHooked = ok
end

local incomingConns = {}
local function watchIncoming(remote)
	if remote:IsA("RemoteEvent") and not remote:IsA("UnreliableRemoteEvent") then
		incomingConns[#incomingConns + 1] = remote.OnClientEvent:Connect(function(...)
			record("IN ", remote, "OnClientEvent", table.pack(...))
		end)
	end
end
for _, d in ipairs(game:GetDescendants()) do
	pcall(watchIncoming, d)
end
incomingConns[#incomingConns + 1] = game.DescendantAdded:Connect(function(d)
	pcall(watchIncoming, d)
end)

local function flushSpy(final)
	local head = {
		"Corvus remote spy - Steal From The Rich",
		"PlaceId " .. game.PlaceId .. "  hooked=" .. tostring(spyHooked) .. "  elapsed=" .. string.format("%.0fs", os.clock() - t0) .. (final and "  (finished)" or "  (running)"),
		"OUT = client -> server, IN = server -> client (first few per remote)",
		string.rep("-", 80),
	}
	pcall(write, SPY_FILE, table.concat(head, "\n") .. "\n" .. table.concat(spyLog, "\n"))
end

task.spawn(function()
	while os.clock() - t0 < SPY_SECONDS do
		task.wait(15)
		flushSpy(false)
	end
	spyActive = false
	for _, c in ipairs(incomingConns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	flushSpy(true)
	notify("Remote spy finished, " .. SPY_FILE .. " saved", 15)
	G.CorvusDumperRunning = nil
end)

notify(
	"Spy on for 10 min. Do each once: steal (each zone), sell held + all, place, open, equip best, buy +1 equip, upgrade plot, treadmill + upgrade, claim index, buy trail",
	25
)

