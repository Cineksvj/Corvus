-- Corvus dumper for Steal From The Rich
-- Saves two files in your executor's workspace folder:
--   Corvus_SFTR_dump.txt  remotes, game structure, player data, data modules, decompiled client scripts
--   Corvus_SFTR_spy.txt   every remote the game fires while you play (saved every 15s)
-- After running: do each action in the game once (see the notification), then upload both files.

local G = getgenv and getgenv() or shared
if G.CorvusDumperRunning then
	warn("[Corvus Dumper] already running")
	return
end
G.CorvusDumperRunning = true

