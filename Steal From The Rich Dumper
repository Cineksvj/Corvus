-- Scripts
local LIB = {}
for _, n in ipairs({
	"Promise", "Signal", "GoodSignal", "Janitor", "Trove", "Maid", "TableUtil", "Comm", "Roact", "React", "ReactRoblox",
	"Fusion", "Iris", "Rodux", "t", "Option", "Streamable", "Timer", "EnumList", "Sift", "Spring", "Zone", "ZonePlus",
	"ProfileService", "ProfileStore", "Cmdr", "TopbarPlus", "Icon", "Llama", "Net", "BridgeNet", "BridgeNet2", "Red",
	"ByteNet", "Warp", "Zap", "Replica", "ReplicaService", "ReplicaController", "Knit", "KnitClient", "KnitServer",
	"Loader", "Ser", "Symbol", "Input", "Shake", "Silo", "ChickynoidClient", "Quenty", "Nevermore", "Blend", "Flipper",
	"Otter", "RoactSpring", "Vide", "Charm", "Lapis", "DataStore2", "FastCast", "PartCache", "Octree", "Tween",
}) do
	LIB[n] = true
end
local SKIP_PATHS = { "_Index", "PlayerModule", "RbxCharacterSounds", "ChatScript", "BubbleChat", "ChatMain", "Freecam", "CoreGui", "CorePackages" }

local function skipScript(s)
	if LIB[s.Name] then
		return true
	end
	local full = fullName(s)
	for _, p in ipairs(SKIP_PATHS) do
		if full:find(p, 1, true) then
			return true
		end
	end
	return false
end

local scripts, have = {}, {}
local function add(s)
	if typeof(s) == "Instance" and not have[s] and (s:IsA("LocalScript") or s:IsA("ModuleScript") or (s:IsA("Script") and s.RunContext == Enum.RunContext.Client)) then
		have[s] = true
		if not skipScript(s) then
			scripts[#scripts + 1] = s
		end
	end
end
for _, root in ipairs({ ReplicatedStorage, ReplicatedFirst, LP:FindFirstChild("PlayerScripts"), LP:FindFirstChild("PlayerGui"), LP.Character, StarterPlayer, workspace }) do
	if root then
		for _, d in ipairs(root:GetDescendants()) do
			pcall(add, d)
		end
	end
end
local loaded = {}
if getloadedmodules then
	local ok, mods = pcall(getloadedmodules)
	if ok and mods then
		for _, m in ipairs(mods) do
			loaded[m] = true
			pcall(add, m)
		end
	end
end
if getrunningscripts then
	local ok, list = pcall(getrunningscripts)
	if ok and list then
		for _, s in ipairs(list) do
			pcall(add, s)
		end
	end
end

local KEYWORDS = { "steal", "sell", "plot", "treadmill", "trail", "index", "zone", "rarit", "config", "data", "controller", "service", "remote", "network", "shop", "upgrade", "equip", "brainrot", "item", "pet", "npc", "rich" }
local function priority(s)
	if s:IsA("LocalScript") or s:IsA("Script") then
		return 0
	end
	local lower = fullName(s):lower()
	for _, k in ipairs(KEYWORDS) do
		if lower:find(k, 1, true) then
			return 1
		end
	end
	return 2
end
table.sort(scripts, function(a, b)
	local pa, pb = priority(a), priority(b)
	if pa ~= pb then
		return pa < pb
	end
	return fullName(a) < fullName(b)
end)

section("SCRIPT INDEX (" .. #scripts .. ")")
for _, s in ipairs(scripts) do
	w(s.ClassName .. "  " .. fullName(s) .. (loaded[s] and "  (loaded)" or ""))
end

-- Data returned by already-loaded ModuleScripts (configs: zones, rarities, prices...)
section("MODULE DATA (require of already-loaded modules)")
FMT_MAX = 300
for _, s in ipairs(scripts) do
	if total > MAX_TOTAL * 0.4 then
		w("... module data limit reached")
		break
	end
	if s:IsA("ModuleScript") and (loaded[s] or (not getloadedmodules and priority(s) == 1)) then
		local ok, res = withTimeout(function()
			return require(s)
		end, 3)
		if ok and type(res) == "table" then
			local text = fmt(res)
			if #text > 60000 then
				text = text:sub(1, 60000) .. " ...(cut)"
			end
			w("-- " .. fullName(s))
			w(text)
		end
	end
end
FMT_MAX = 40
flushDump()

section("DECOMPILED SCRIPTS")
if not decompileFn then
	w("decompile is not available in this executor, skipped")
else
	local seenSrc, done = {}, 0
	for i, s in ipairs(scripts) do
		if total > MAX_TOTAL then
			w("... total size limit reached")
			break
		end
		local ok, src = withTimeout(function()
			return decompileFn(s)
		end, 12)
		w("")
		w("-------- " .. s.ClassName .. "  " .. fullName(s))
		if not ok or type(src) ~= "string" then
			w("-- decompile failed: " .. tostring(src))
		elseif seenSrc[src] then
			w("-- same source as " .. seenSrc[src])
		else
			seenSrc[src] = fullName(s)
			if #src > MAX_SCRIPT then
				src = src:sub(1, MAX_SCRIPT) .. "\n-- ...(cut)"
			end
			w(src)
		end
		done += 1
		if i % 25 == 0 then
			flushDump()
			notify("Decompiled " .. i .. "/" .. #scripts, 4)
		end
	end
end

section("END")
w(string.format("size %.2f MB", total / 1024 / 1024))
flushDump()
notify(DUMP_FILE .. " saved (" .. string.format("%.1f", total / 1024 / 1024) .. " MB). Spy keeps running, keep doing actions", 15)
